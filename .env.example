# ============================================================
# BINSIGHT — ENVIRONMENT TEMPLATE
# ============================================================

# ------------------------------------------------------------
# SITE
# ------------------------------------------------------------

PUBLIC_SITE_URL=https://binsight.id
PUBLIC_APP_NAME=BINSIGHT
PUBLIC_APP_DESCRIPTION=Badung Waste Intelligence Platform


# ------------------------------------------------------------
# FIREBASE WEB APP
# ------------------------------------------------------------
# These Firebase Web App values are intended for the client
# application. Do not place service-account private keys here.
# ------------------------------------------------------------

PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id


# ------------------------------------------------------------
# DEVELOPMENT
# ------------------------------------------------------------

PUBLIC_APP_ENV=development