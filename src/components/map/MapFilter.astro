---
import {
  ListFilter,
  MapPin,
  RotateCcw,
  Search,
} from "@lucide/astro";

import type {
  LocationType,
  Area,
} from "@lib/data/locations";

interface Props {
  areas?: Area[];
  selectedArea?: string;
  selectedType?: LocationType | "";
  search?: string;
  showSearch?: boolean;
  showArea?: boolean;
  showType?: boolean;
  compact?: boolean;
  class?: string;
}

const props = Astro.props as Props;

const areas = props.areas ?? [];
const selectedArea = props.selectedArea ?? "";
const selectedType = props.selectedType ?? "";
const search = props.search ?? "";
const showSearch = props.showSearch ?? true;
const showArea = props.showArea ?? true;
const showType = props.showType ?? true;
const compact = props.compact ?? false;
const className = props.class ?? "";

const activeAreas = areas.filter(
  (area) => area.status === "active",
);

const locationTypeOptions: Array<{
  value: LocationType;
  label: string;
}> = [
  {
    value: "collection-point",
    label: "Titik pengumpulan",
  },
  {
    value: "recycling-center",
    label: "Pusat daur ulang",
  },
  {
    value: "waste-bank",
    label: "Bank sampah",
  },
  {
    value: "processing-facility",
    label: "Fasilitas pengolahan",
  },
  {
    value: "drop-point",
    label: "Drop point",
  },
  {
    value: "other",
    label: "Lainnya",
  },
];

const filterId =
  "map-filter-" +
  Math.random()
    .toString(36)
    .slice(2, 10);
---

<form
  id={filterId}
  class:list={[
    "map-filter",
    compact ? "map-filter--compact" : "",
    className,
  ]}
  data-map-filter
  novalidate
>
  <div class="map-filter__heading">
    <div class="map-filter__heading-main">
      <span
        class="map-filter__title-icon"
        aria-hidden="true"
      >
        <ListFilter
          size={17}
          stroke-width={2}
        />
      </span>

      <div class="map-filter__title-copy">
        <span class="map-filter__eyebrow">
          FILTER PETA
        </span>

        <h2 class="map-filter__title">
          Filter peta
        </h2>

        {
          !compact && (
            <p class="map-filter__subtitle">
              Temukan lokasi pengelolaan berdasarkan area
              dan jenis.
            </p>
          )
        }
      </div>
    </div>

    <button
      type="button"
      class="map-filter__reset"
      data-map-filter-reset
      aria-label="Reset semua filter"
    >
      <RotateCcw
        size={14}
        stroke-width={2}
        aria-hidden="true"
      />

      {
        !compact && (
          <span>Reset</span>
        )
      }
    </button>
  </div>

  <div class="map-filter__fields">
    {
      showSearch && (
        <div class="map-filter__field map-filter__field--search">
          <label
            class="map-filter__label"
            for={`${filterId}-search`}
          >
            Cari
          </label>

          <div class="map-filter__control">
            <Search
              class="map-filter__control-icon"
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />

            <input
              id={`${filterId}-search`}
              class="map-filter__input"
              type="search"
              name="search"
              value={search}
              placeholder="Nama lokasi atau alamat..."
              autocomplete="off"
              spellcheck="false"
              data-map-filter-search
            />
          </div>
        </div>
      )
    }

    {
      showArea && (
        <div class="map-filter__field">
          <label
            class="map-filter__label"
            for={`${filterId}-area`}
          >
            Area
          </label>

          <div class="map-filter__control">
            <MapPin
              class="map-filter__control-icon"
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />

            <select
              id={`${filterId}-area`}
              class="map-filter__select"
              name="area"
              data-map-filter-area
            >
              <option
                value=""
                selected={selectedArea === ""}
              >
                Semua area
              </option>

              {
                activeAreas.map((area) => (
                  <option
                    value={area.id}
                    selected={selectedArea === area.id}
                  >
                    {area.name}
                  </option>
                ))
              }
            </select>

            <span
              class="map-filter__select-arrow"
              aria-hidden="true"
            />
          </div>
        </div>
      )
    }

    {
      showType && (
        <div class="map-filter__field">
          <label
            class="map-filter__label"
            for={`${filterId}-type`}
          >
            Jenis lokasi
          </label>

          <div class="map-filter__control">
            <ListFilter
              class="map-filter__control-icon"
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />

            <select
              id={`${filterId}-type`}
              class="map-filter__select"
              name="type"
              data-map-filter-type
            >
              <option
                value=""
                selected={selectedType === ""}
              >
                Semua jenis
              </option>

              {
                locationTypeOptions.map((option) => (
                  <option
                    value={option.value}
                    selected={selectedType === option.value}
                  >
                    {option.label}
                  </option>
                ))
              }
            </select>

            <span
              class="map-filter__select-arrow"
              aria-hidden="true"
            />
          </div>
        </div>
      )
    }
  </div>

  {
    !compact && (
      <div
        class="map-filter__footer"
        aria-live="polite"
      >
        <span
          class="map-filter__summary-icon"
          aria-hidden="true"
        >
          <MapPin
            size={13}
            stroke-width={2}
          />
        </span>

        <span data-map-filter-summary-text>
          Semua lokasi ditampilkan
        </span>
      </div>
    )
  }
</form>

<script>
  (() => {
    const script = document.currentScript;

    if (!script) {
      return;
    }

    const form = script.previousElementSibling;

    if (
      !(form instanceof HTMLFormElement) ||
      !form.hasAttribute("data-map-filter")
    ) {
      return;
    }

    if (form.dataset.initialized === "true") {
      return;
    }

    form.dataset.initialized = "true";

    const searchInput =
      form.querySelector<HTMLInputElement>(
        "[data-map-filter-search]",
      );

    const areaSelect =
      form.querySelector<HTMLSelectElement>(
        "[data-map-filter-area]",
      );

    const typeSelect =
      form.querySelector<HTMLSelectElement>(
        "[data-map-filter-type]",
      );

    const resetButton =
      form.querySelector<HTMLButtonElement>(
        "[data-map-filter-reset]",
      );

    const summary =
      form.querySelector<HTMLElement>(
        "[data-map-filter-summary-text]",
      );

    const normalize = (value: string) => {
      return value.trim();
    };

    const getState = () => {
      return {
        search: searchInput
          ? normalize(searchInput.value)
          : "",

        area: areaSelect
          ? normalize(areaSelect.value)
          : "",

        type: typeSelect
          ? normalize(typeSelect.value)
          : "",
      };
    };

    const updateSummary = () => {
      if (!summary) {
        return;
      }

      const state = getState();

      const count = [
        state.search,
        state.area,
        state.type,
      ].filter(Boolean).length;

      if (count === 0) {
        summary.textContent =
          "Semua lokasi ditampilkan";
        return;
      }

      if (count === 1) {
        summary.textContent =
          "1 filter aktif";
        return;
      }

      summary.textContent =
        `${count} filter aktif`;
    };

    const emit = () => {
      const state = getState();

      updateSummary();

      const event =
        new CustomEvent(
          "binsight-map-filter",
          {
            bubbles: true,
            detail: state,
          },
        );

      form.dispatchEvent(event);

      window.dispatchEvent(
        new CustomEvent(
          "binsight-map-filter",
          {
            detail: state,
          },
        ),
      );
    };

    searchInput?.addEventListener(
      "input",
      emit,
    );

    areaSelect?.addEventListener(
      "change",
      emit,
    );

    typeSelect?.addEventListener(
      "change",
      emit,
    );

    resetButton?.addEventListener(
      "click",
      () => {
        if (searchInput) {
          searchInput.value = "";
        }

        if (areaSelect) {
          areaSelect.value = "";
        }

        if (typeSelect) {
          typeSelect.value = "";
        }

        emit();
      },
    );

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        emit();
      },
    );

    updateSummary();
    emit();
  })();
</script>

<style>
  .map-filter,
  .map-filter *,
  .map-filter *::before,
  .map-filter *::after {
    box-sizing: border-box;
  }

  .map-filter {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --white: #fffef8;
    --muted: #6c7068;
    --warning: #ff6a00;
    --line-dark: rgba(255, 254, 248, 0.18);

    display: block;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    margin: 0;
    padding: 0;

    overflow: hidden;

    color: var(--white);
    background: transparent;

    font-family:
      "Inter",
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  /* HEADER --------------------------------------------------------------- */

  .map-filter__heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: start;

    gap: 0.65rem;

    width: 100%;
    min-width: 0;

    margin-bottom: 1rem;
  }

  .map-filter__heading-main {
    display: grid;

    grid-template-columns:
      2.5rem
      minmax(0, 1fr);

    align-items: start;

    gap: 0.65rem;

    min-width: 0;
  }

  .map-filter__title-icon {
    display: grid;

    width: 2.5rem;
    height: 2.5rem;

    place-items: center;

    color: var(--ink);
    background: var(--acid);

    border: 2px solid var(--ink);
  }

  .map-filter__title-copy {
    min-width: 0;
  }

  .map-filter__eyebrow {
    display: block;

    margin-bottom: 0.2rem;

    color: rgba(255, 254, 248, 0.45);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.43rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .map-filter__title {
    margin: 0;

    color: var(--white);

    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;

    font-size: 0.98rem;
    font-weight: 900;

    line-height: 1.02;
    letter-spacing: -0.04em;

    text-transform: uppercase;

    overflow-wrap: anywhere;
  }

  .map-filter__subtitle {
    margin: 0.35rem 0 0;

    color: rgba(255, 254, 248, 0.58);

    font-size: 0.56rem;
    line-height: 1.55;
  }

  /* RESET ---------------------------------------------------------------- */

  .map-filter__reset {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 0.35rem;

    flex: 0 0 auto;

    min-width: 2.25rem;
    min-height: 2.25rem;

    padding: 0 0.55rem;

    border: 2px solid var(--ink);

    background: var(--acid);
    color: var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.46rem;
    font-weight: 700;
    line-height: 1;

    letter-spacing: 0.04em;

    text-transform: uppercase;

    cursor: pointer;

    transition:
      transform 120ms ease,
      box-shadow 120ms ease,
      background 120ms ease;
  }

  .map-filter__reset:hover {
    background: var(--acid-soft);

    transform:
      translate(-2px, -2px);

    box-shadow:
      4px 4px 0 var(--warning);
  }

  .map-filter__reset svg {
    flex: 0 0 auto;
  }

  /* FIELDS ---------------------------------------------------------------- */

  .map-filter__fields {
    display: grid;

    grid-template-columns: 1fr;

    gap: 0.75rem;

    width: 100%;
    min-width: 0;
  }

  .map-filter__field {
    display: grid;

    gap: 0.35rem;

    width: 100%;
    min-width: 0;
  }

  .map-filter__label {
    display: block;

    margin: 0;

    color: var(--acid);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.46rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.2;

    text-transform: uppercase;
  }

  /* CONTROL --------------------------------------------------------------- */

  .map-filter__control {
    position: relative;

    display: flex;
    align-items: center;

    width: 100%;
    min-width: 0;
    min-height: 2.85rem;

    overflow: hidden;

    border: 2px solid var(--ink);

    background: var(--white);
    color: var(--ink);
  }

  .map-filter__control:focus-within {
    box-shadow:
      4px 4px 0 var(--acid);
  }

  .map-filter__control-icon {
    position: absolute;

    left: 0.7rem;

    z-index: 2;

    flex: 0 0 auto;

    color: var(--warning);

    pointer-events: none;
  }

  /* INPUT ----------------------------------------------------------------- */

  .map-filter__input {
    display: block;

    width: 100%;
    min-width: 0;
    min-height: 2.85rem;

    padding:
      0.55rem
      0.7rem
      0.55rem
      2.35rem;

    border: 0;
    outline: 0;

    background: var(--white);
    color: var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.54rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .map-filter__input::placeholder {
    color: #858a82;
    opacity: 1;
  }

  /* SELECT ---------------------------------------------------------------- */

  .map-filter__select {
    display: block;

    width: 100%;
    min-width: 0;
    min-height: 2.85rem;

    padding:
      0.55rem
      2.25rem
      0.55rem
      2.35rem;

    border: 0;
    outline: 0;

    background: var(--white);
    color: var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.54rem;
    font-weight: 700;
    line-height: 1.2;

    appearance: none;

    cursor: pointer;
  }

  .map-filter__select option {
    color: var(--ink);
    background: var(--white);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
  }

  .map-filter__select-arrow {
    position: absolute;

    top: 50%;
    right: 0.7rem;

    width: 0.45rem;
    height: 0.45rem;

    border-right:
      2px solid var(--ink);

    border-bottom:
      2px solid var(--ink);

    pointer-events: none;

    transform:
      translateY(-70%)
      rotate(45deg);
  }

  /* FOOTER ---------------------------------------------------------------- */

  .map-filter__footer {
    display: flex;

    align-items: center;

    gap: 0.5rem;

    width: 100%;
    min-width: 0;

    margin-top: 0.85rem;
    padding-top: 0.7rem;

    border-top:
      1px solid var(--line-dark);

    color: rgba(255, 254, 248, 0.58);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.45rem;
    font-weight: 700;

    line-height: 1.35;

    letter-spacing: 0.04em;

    text-transform: uppercase;
  }

  .map-filter__summary-icon {
    display: grid;

    width: 1.65rem;
    height: 1.65rem;

    flex: 0 0 1.65rem;

    place-items: center;

    border: 2px solid var(--ink);

    background: var(--acid);
    color: var(--ink);
  }

  .map-filter__summary-text {
    min-width: 0;

    overflow-wrap: anywhere;

    color: rgba(255, 254, 248, 0.62);
  }

  /* COMPACT --------------------------------------------------------------- */

  .map-filter--compact {
    padding: 0;
  }

  .map-filter--compact
    .map-filter__fields {
    gap: 0.55rem;
  }

  .map-filter--compact
    .map-filter__input,
  .map-filter--compact
    .map-filter__select,
  .map-filter--compact
    .map-filter__control {
    min-height: 2.6rem;
  }

  /* WIDE ------------------------------------------------------------------ */

  @media (min-width: 900px) {
    .map-filter:not(.map-filter--compact)
      .map-filter__fields {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

    .map-filter:not(.map-filter--compact)
      .map-filter__field--search {
      grid-column: 1 / -1;
    }
  }

  /* SIDEBAR SAFE ---------------------------------------------------------- */

  @media (min-width: 900px) and (max-width: 1250px) {
    .map-filter__fields {
      grid-template-columns: 1fr !important;
    }

    .map-filter__field--search {
      grid-column: auto !important;
    }
  }

  /* MOBILE ---------------------------------------------------------------- */

  @media (max-width: 640px) {
    .map-filter__fields {
      grid-template-columns: 1fr;
    }

    .map-filter__heading-main {
      grid-template-columns:
        2.25rem
        minmax(0, 1fr);
    }

    .map-filter__title-icon {
      width: 2.25rem;
      height: 2.25rem;
    }

    .map-filter__subtitle {
      display: none;
    }
  }

  /* SMALL ----------------------------------------------------------------- */

  @media (max-width: 380px) {
    .map-filter__heading {
      gap: 0.45rem;
    }

    .map-filter__heading-main {
      gap: 0.5rem;

      grid-template-columns:
        2.1rem
        minmax(0, 1fr);
    }

    .map-filter__title-icon {
      width: 2.1rem;
      height: 2.1rem;
    }

    .map-filter__title {
      font-size: 0.88rem;
    }

    .map-filter__input,
    .map-filter__select {
      font-size: 0.51rem;
    }

    .map-filter__control-icon {
      left: 0.6rem;
    }

    .map-filter__input {
      padding-left: 2.15rem;
    }

    .map-filter__select {
      padding-left: 2.15rem;
    }

    .map-filter__select-arrow {
      right: 0.6rem;
    }
  }

  /* ACCESSIBILITY --------------------------------------------------------- */

  .map-filter__reset:focus-visible,
  .map-filter__input:focus-visible,
  .map-filter__select:focus-visible {
    outline:
      3px solid var(--acid);

    outline-offset:
      3px;
  }

  /* REDUCED MOTION -------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .map-filter *,
    .map-filter *::before,
    .map-filter *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>