---
import {
  ListFilter,
  MapPin,
  RotateCcw,
  Search,
} from "@lucide/astro";

import type {
  LocationType,
  Area,
} from "@lib/data/locations";

interface Props {
  areas?: Area[];
  selectedArea?: string;
  selectedType?: LocationType | "";
  search?: string;
  showSearch?: boolean;
  showArea?: boolean;
  showType?: boolean;
  compact?: boolean;
  class?: string;
}

const {
  areas = [],
  selectedArea = "",
  selectedType = "",
  search = "",
  showSearch = true,
  showArea = true,
  showType = true,
  compact = false,
  class: className = "",
} = Astro.props;

const locationTypeOptions: Array<{
  value: LocationType;
  label: string;
}> = [
  {
    value: "collection-point",
    label: "Titik pengumpulan",
  },
  {
    value: "recycling-center",
    label: "Pusat daur ulang",
  },
  {
    value: "waste-bank",
    label: "Bank sampah",
  },
  {
    value: "processing-facility",
    label: "Fasilitas pengolahan",
  },
  {
    value: "drop-point",
    label: "Drop point",
  },
  {
    value: "other",
    label: "Lainnya",
  },
];

const activeAreas = areas.filter(
  (area) => area.status === "active",
);

const filterId = `map-filter-${Math.random()
  .toString(36)
  .slice(2, 10)}`;
---

<form
  id={filterId}
  class:list={[
    "map-filter",
    {
      "map-filter--compact": compact,
    },
    className,
  ]}
  data-map-filter
  novalidate
>
  <div class="map-filter__heading">
    <div class="map-filter__title-wrap">
      <span
        class="map-filter__title-icon"
        aria-hidden="true"
      >
        <ListFilter
          size={17}
          stroke-width={2}
        />
      </span>

      <div>
        <h2 class="map-filter__title">
          Filter peta
        </h2>

        <p class="map-filter__subtitle">
          Temukan lokasi pengelolaan berdasarkan area dan jenis.
        </p>
      </div>
    </div>

    <button
      type="button"
      class="map-filter__reset"
      data-map-filter-reset
      aria-label="Reset semua filter"
    >
      <RotateCcw
        size={14}
        stroke-width={2}
        aria-hidden="true"
      />
      <span>Reset</span>
    </button>
  </div>

  <div class="map-filter__fields">
    {
      showSearch && (
        <div class="map-filter__field map-filter__field--search">
          <label
            class="map-filter__label"
            for={`${filterId}-search`}
          >
            Cari
          </label>

          <div class="map-filter__input-wrap">
            <Search
              class="map-filter__input-icon"
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <input
              id={`${filterId}-search`}
              class="map-filter__input"
              type="search"
              name="search"
              value={search}
              placeholder="Nama lokasi, area, atau alamat..."
              autocomplete="off"
              spellcheck="false"
              data-map-filter-search
            />
          </div>
        </div>
      )
    }

    {
      showArea && (
        <div class="map-filter__field">
          <label
            class="map-filter__label"
            for={`${filterId}-area`}
          >
            Area
          </label>

          <div class="map-filter__select-wrap">
            <MapPin
              class="map-filter__select-icon"
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <select
              id={`${filterId}-area`}
              class="map-filter__select"
              name="area"
              data-map-filter-area
            >
              <option value="" selected={selectedArea === ""}>
                Semua area
              </option>

              {
                activeAreas.map(
                  (area) => (
                    <option
                      value={area.id}
                      selected={
                        selectedArea ===
                        area.id
                      }
                    >
                      {area.name}
                    </option>
                  ),
                )
              }
            </select>
          </div>
        </div>
      )
    }

    {
      showType && (
        <div class="map-filter__field">
          <label
            class="map-filter__label"
            for={`${filterId}-type`}
          >
            Jenis lokasi
          </label>

          <div class="map-filter__select-wrap">
            <ListFilter
              class="map-filter__select-icon"
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <select
              id={`${filterId}-type`}
              class="map-filter__select"
              name="type"
              data-map-filter-type
            >
              <option value="" selected={selectedType === ""}>
                Semua jenis
              </option>

              {
                locationTypeOptions.map(
                  (option) => (
                    <option
                      value={option.value}
                      selected={
                        selectedType ===
                        option.value
                      }
                    >
                      {option.label}
                    </option>
                  ),
                )
              }
            </select>
          </div>
        </div>
      )}
  </div>

  <div
    class="map-filter__footer"
    data-map-filter-summary
    aria-live="polite"
  >
    <span class="map-filter__summary-icon" aria-hidden="true">
      <MapPin
        size={14}
        stroke-width={1.9}
      />
    </span>

    <span data-map-filter-summary-text>
      Semua lokasi ditampilkan
    </span>
  </div>
</form>

<script is:inline>
  (() => {
    const form =
      document.currentScript
        ?.previousElementSibling;

    if (
      !(form instanceof HTMLFormElement) ||
      !form.matches(
        "[data-map-filter]",
      )
    ) {
      return;
    }

    if (
      form.dataset.initialized ===
      "true"
    ) {
      return;
    }

    form.dataset.initialized = "true";

    const searchInput =
      form.querySelector(
        "[data-map-filter-search]",
      );

    const areaSelect =
      form.querySelector(
        "[data-map-filter-area]",
      );

    const typeSelect =
      form.querySelector(
        "[data-map-filter-type]",
      );

    const resetButton =
      form.querySelector(
        "[data-map-filter-reset]",
      );

    const summary =
      form.querySelector(
        "[data-map-filter-summary-text]",
      );

    const normalizeValue = (
      value,
    ) =>
      typeof value === "string"
        ? value.trim()
        : "";

    const getFilterState = () => ({
      search:
        searchInput instanceof
        HTMLInputElement
          ? normalizeValue(
              searchInput.value,
            )
          : "",

      area:
        areaSelect instanceof
        HTMLSelectElement
          ? normalizeValue(
              areaSelect.value,
            )
          : "",

      type:
        typeSelect instanceof
        HTMLSelectElement
          ? normalizeValue(
              typeSelect.value,
            )
          : "",
    });

    const updateSummary = (
      state,
    ) => {
      if (
        !(summary instanceof
        HTMLElement)
      ) {
        return;
      }

      const activeCount =
        [
          state.search,
          state.area,
          state.type,
        ].filter(Boolean).length;

      if (activeCount === 0) {
        summary.textContent =
          "Semua lokasi ditampilkan";
        return;
      }

      if (
        activeCount === 1
      ) {
        summary.textContent =
          "1 filter aktif";
        return;
      }

      summary.textContent =
        `${activeCount} filter aktif`;
    };

    const emit = () => {
      const state =
        getFilterState();

      updateSummary(state);

      form.dispatchEvent(
        new CustomEvent(
          "binsight-map-filter",
          {
            bubbles: true,
            detail: {
              ...state,
            },
          },
        ),
      );

      window.dispatchEvent(
        new CustomEvent(
          "binsight-map-filter",
          {
            detail: {
              ...state,
            },
          },
        ),
      );
    };

    const handleInput = () => {
      emit();
    };

    searchInput?.addEventListener(
      "input",
      handleInput,
    );

    areaSelect?.addEventListener(
      "change",
      handleInput,
    );

    typeSelect?.addEventListener(
      "change",
      handleInput,
    );

    resetButton?.addEventListener(
      "click",
      () => {
        if (
          searchInput instanceof
          HTMLInputElement
        ) {
          searchInput.value = "";
        }

        if (
          areaSelect instanceof
          HTMLSelectElement
        ) {
          areaSelect.value = "";
        }

        if (
          typeSelect instanceof
          HTMLSelectElement
        ) {
          typeSelect.value = "";
        }

        emit();
      },
    );

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        emit();
      },
    );

    emit();
  })();
</script>

<style>
  .map-filter {
    width: 100%;
    min-width: 0;
    padding: 1rem 1.125rem;
    border: 1px solid
      var(--color-border, #e2e8f0);
    border-radius: 1rem;
    background: var(
      --color-surface,
      #ffffff
    );
    box-shadow:
      0 1px 2px
        rgb(15 23 42 / 0.03),
      0 8px 24px
        rgb(15 23 42 / 0.04);
  }

  .map-filter__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .map-filter__title-wrap {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .map-filter__title-icon {
    width: 2.15rem;
    height: 2.15rem;
    flex: 0 0 2.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.65rem;
    background: var(
      --color-primary-light,
      #dcfce7
    );
    color: var(
      --color-primary,
      #166534
    );
  }

  .map-filter__title {
    margin: 0;
    color: #0f172a;
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.35;
  }

  .map-filter__subtitle {
    margin: 0.2rem 0 0;
    color: #64748b;
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .map-filter__reset {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 0.55rem;
    border: 1px solid
      #e2e8f0;
    border-radius: 0.55rem;
    background: #ffffff;
    color: #64748b;
    font: inherit;
    font-size: 0.68rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .map-filter__reset:hover {
    border-color: #bbf7d0;
    background: #f0fdf4;
    color: #166534;
  }

  .map-filter__reset:focus-visible {
    outline: 3px solid
      rgb(37 99 235 / 0.18);
    outline-offset: 2px;
  }

  .map-filter__fields {
    display: grid;
    grid-template-columns:
      minmax(15rem, 1.5fr)
      repeat(2, minmax(10rem, 1fr));
    gap: 0.75rem;
  }

  .map-filter__field {
    min-width: 0;
  }

  .map-filter__label {
    display: block;
    margin-bottom: 0.35rem;
    color: #334155;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .map-filter__input-wrap,
  .map-filter__select-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .map-filter__input,
  .map-filter__select {
    width: 100%;
    min-height: 2.55rem;
    border: 1px solid
      #e2e8f0;
    border-radius: 0.65rem;
    background: #ffffff;
    color: #0f172a;
    font: inherit;
    font-size: 0.75rem;
    outline: 0;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .map-filter__input {
    padding:
      0 2.25rem
      0 2.25rem;
  }

  .map-filter__select {
    appearance: none;
    padding:
      0 2.25rem
      0 2.25rem;
    cursor: pointer;
  }

  .map-filter__input::placeholder {
    color: #94a3b8;
  }

  .map-filter__input:focus,
  .map-filter__select:focus {
    border-color: #166534;
    box-shadow:
      0 0 0 3px
        rgb(22 101 52 / 0.1);
  }

  .map-filter__input-icon,
  .map-filter__select-icon {
    position: absolute;
    z-index: 1;
    color: #94a3b8;
    pointer-events: none;
  }

  .map-filter__input-icon {
    left: 0.75rem;
  }

  .map-filter__select-icon {
    left: 0.75rem;
  }

  .map-filter__select-wrap::after {
    content: "";
    position: absolute;
    right: 0.75rem;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid
      #64748b;
    border-bottom: 1.5px solid
      #64748b;
    transform:
      rotate(45deg)
      translateY(-2px);
    pointer-events: none;
  }

  .map-filter__footer {
    min-height: 2rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid
      #f1f5f9;
    color: #64748b;
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .map-filter__summary-icon {
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 1.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.45rem;
    background: #f8fafc;
    color: #166534;
  }

  .map-filter--compact {
    padding: 0.8rem 0.9rem;
  }

  .map-filter--compact
    .map-filter__subtitle {
    display: none;
  }

  .map-filter--compact
    .map-filter__heading {
    margin-bottom: 0.75rem;
  }

  .map-filter--compact
    .map-filter__footer {
    display: none;
  }

  @media (max-width: 900px) {
    .map-filter__fields {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);
    }

    .map-filter__field--search {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .map-filter {
      padding: 0.9rem;
      border-radius: 0.875rem;
    }

    .map-filter__heading {
      align-items: center;
    }

    .map-filter__subtitle {
      display: none;
    }

    .map-filter__fields {
      grid-template-columns: 1fr;
    }

    .map-filter__field--search {
      grid-column: auto;
    }

    .map-filter__reset span {
      display: none;
    }

    .map-filter__reset {
      width: 2rem;
      min-width: 2rem;
      justify-content: center;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-filter__reset,
    .map-filter__input,
    .map-filter__select {
      transition: none;
    }
  }
</style>
