---
import {
  ListFilter,
  MapPin,
  RotateCcw,
  Search,
} from "@lucide/astro";

import type {
  LocationType,
  Area,
} from "@lib/data/locations";

interface Props {
  areas?: Area[];
  selectedArea?: string;
  selectedType?: LocationType | "";
  search?: string;
  showSearch?: boolean;
  showArea?: boolean;
  showType?: boolean;
  compact?: boolean;
  class?: string;
}

const {
  areas = [],
  selectedArea = "",
  selectedType = "",
  search = "",
  showSearch = true,
  showArea = true,
  showType = true,
  compact = false,
  class: className = "",
} = Astro.props;

const locationTypeOptions: Array<{
  value: LocationType;
  label: string;
}> = [
  {
    value: "collection-point",
    label: "Titik pengumpulan",
  },
  {
    value: "recycling-center",
    label: "Pusat daur ulang",
  },
  {
    value: "waste-bank",
    label: "Bank sampah",
  },
  {
    value: "processing-facility",
    label: "Fasilitas pengolahan",
  },
  {
    value: "drop-point",
    label: "Drop point",
  },
  {
    value: "other",
    label: "Lainnya",
  },
];

const activeAreas = areas.filter(
  (area) => area.status === "active",
);

const filterId = `map-filter-${Math.random()
  .toString(36)
  .slice(2, 10)}`;
---

<form
  id={filterId}
  class:list={[
    "map-filter",
    {
      "map-filter--compact": compact,
    },
    className,
  ]}
  data-map-filter
  novalidate
>
  <!-- =======================================================================
       HEADER
       ==================================================================== -->

  <div class="map-filter__heading">

    <div class="map-filter__title-wrap">

      <span
        class="map-filter__title-icon"
        aria-hidden="true"
      >
        <ListFilter
          size={17}
          stroke-width={2}
        />
      </span>

      <div class="map-filter__title-copy">

        <h2 class="map-filter__title">
          Filter peta
        </h2>

        <p class="map-filter__subtitle">
          Temukan lokasi pengelolaan berdasarkan
          area dan jenis.
        </p>

      </div>

    </div>


    <button
      type="button"
      class="map-filter__reset"
      data-map-filter-reset
      aria-label="Reset semua filter"
    >
      <RotateCcw
        size={14}
        stroke-width={2}
        aria-hidden="true"
      />

      <span>
        Reset
      </span>
    </button>

  </div>


  <!-- =======================================================================
       FIELDS
       ==================================================================== -->

  <div class="map-filter__fields">

    {
      showSearch && (
        <div class="map-filter__field map-filter__field--search">

          <label
            class="map-filter__label"
            for={`${filterId}-search`}
          >
            Cari
          </label>

          <div class="map-filter__input-wrap">

            <Search
              class="map-filter__input-icon"
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

            <input
              id={`${filterId}-search`}
              class="map-filter__input"
              type="search"
              name="search"
              value={search}
              placeholder="Nama lokasi, area, atau alamat..."
              autocomplete="off"
              spellcheck="false"
              data-map-filter-search
            />

          </div>

        </div>
      )
    }


    {
      showArea && (
        <div class="map-filter__field">

          <label
            class="map-filter__label"
            for={`${filterId}-area`}
          >
            Area
          </label>

          <div class="map-filter__select-wrap">

            <MapPin
              class="map-filter__select-icon"
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

            <select
              id={`${filterId}-area`}
              class="map-filter__select"
              name="area"
              data-map-filter-area
            >
              <option
                value=""
                selected={selectedArea === ""}
              >
                Semua area
              </option>

              {
                activeAreas.map(
                  (area) => (
                    <option
                      value={area.id}
                      selected={
                        selectedArea ===
                        area.id
                      }
                    >
                      {area.name}
                    </option>
                  ),
                )
              }
            </select>

          </div>

        </div>
      )
    }


    {
      showType && (
        <div class="map-filter__field">

          <label
            class="map-filter__label"
            for={`${filterId}-type`}
          >
            Jenis lokasi
          </label>

          <div class="map-filter__select-wrap">

            <ListFilter
              class="map-filter__select-icon"
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

            <select
              id={`${filterId}-type`}
              class="map-filter__select"
              name="type"
              data-map-filter-type
            >
              <option
                value=""
                selected={selectedType === ""}
              >
                Semua jenis
              </option>

              {
                locationTypeOptions.map(
                  (option) => (
                    <option
                      value={option.value}
                      selected={
                        selectedType ===
                        option.value
                      }
                    >
                      {option.label}
                    </option>
                  ),
                )
              }
            </select>

          </div>

        </div>
      )
    }

  </div>


  <!-- =======================================================================
       SUMMARY
       ==================================================================== -->

  <div
    class="map-filter__footer"
    data-map-filter-summary
    aria-live="polite"
  >

    <span
      class="map-filter__summary-icon"
      aria-hidden="true"
    >
      <MapPin
        size={14}
        stroke-width={2}
      />
    </span>

    <span data-map-filter-summary-text>
      Semua lokasi ditampilkan
    </span>

  </div>

</form>


<script is:inline>
  (() => {
    const form =
      document.currentScript
        ?.previousElementSibling;

    if (
      !(form instanceof HTMLFormElement) ||
      !form.matches(
        "[data-map-filter]",
      )
    ) {
      return;
    }

    if (
      form.dataset.initialized ===
      "true"
    ) {
      return;
    }

    form.dataset.initialized = "true";

    const searchInput =
      form.querySelector(
        "[data-map-filter-search]",
      );

    const areaSelect =
      form.querySelector(
        "[data-map-filter-area]",
      );

    const typeSelect =
      form.querySelector(
        "[data-map-filter-type]",
      );

    const resetButton =
      form.querySelector(
        "[data-map-filter-reset]",
      );

    const summary =
      form.querySelector(
        "[data-map-filter-summary-text]",
      );

    const normalizeValue = (
      value,
    ) =>
      typeof value === "string"
        ? value.trim()
        : "";

    const getFilterState = () => ({
      search:
        searchInput instanceof
        HTMLInputElement
          ? normalizeValue(
              searchInput.value,
            )
          : "",

      area:
        areaSelect instanceof
        HTMLSelectElement
          ? normalizeValue(
              areaSelect.value,
            )
          : "",

      type:
        typeSelect instanceof
        HTMLSelectElement
          ? normalizeValue(
              typeSelect.value,
            )
          : "",
    });

    const updateSummary = (
      state,
    ) => {
      if (
        !(summary instanceof
        HTMLElement)
      ) {
        return;
      }

      const activeCount =
        [
          state.search,
          state.area,
          state.type,
        ].filter(Boolean).length;

      if (activeCount === 0) {
        summary.textContent =
          "Semua lokasi ditampilkan";

        return;
      }

      if (activeCount === 1) {
        summary.textContent =
          "1 filter aktif";

        return;
      }

      summary.textContent =
        `${activeCount} filter aktif`;
    };

    const emit = () => {
      const state =
        getFilterState();

      updateSummary(state);

      form.dispatchEvent(
        new CustomEvent(
          "binsight-map-filter",
          {
            bubbles: true,
            detail: {
              ...state,
            },
          },
        ),
      );

      window.dispatchEvent(
        new CustomEvent(
          "binsight-map-filter",
          {
            detail: {
              ...state,
            },
          },
        ),
      );
    };

    searchInput?.addEventListener(
      "input",
      emit,
    );

    areaSelect?.addEventListener(
      "change",
      emit,
    );

    typeSelect?.addEventListener(
      "change",
      emit,
    );

    resetButton?.addEventListener(
      "click",
      () => {
        if (
          searchInput instanceof
          HTMLInputElement
        ) {
          searchInput.value = "";
        }

        if (
          areaSelect instanceof
          HTMLSelectElement
        ) {
          areaSelect.value = "";
        }

        if (
          typeSelect instanceof
          HTMLSelectElement
        ) {
          typeSelect.value = "";
        }

        emit();
      },
    );

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        emit();
      },
    );

    emit();
  })();
</script>


<style>
  /* ==========================================================================
     BINSIGHT MAP FILTER
     Shared visual language with homepage / map page
     ========================================================================== */

  .map-filter,
  .map-filter *,
  .map-filter *::before,
  .map-filter *::after {
    box-sizing: border-box;
  }

  .map-filter {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;

    --white: #fffef8;
    --muted: #6c7068;

    --warning: #ff6a00;

    width: 100%;
    min-width: 0;

    padding: 20px;

    color: var(--white) !important;

    background:
      linear-gradient(
        rgba(255, 255, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.035) 1px,
        transparent 1px
      ),
      var(--ink) !important;

    background-size: 24px 24px;

    border: 3px solid var(--ink);

    box-shadow: 7px 7px 0 var(--warning);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
  }


  /* ==========================================================================
     HEADER
     ========================================================================== */

  .map-filter__heading {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 20px;
  }

  .map-filter__title-wrap {
    display: flex;

    align-items: flex-start;

    gap: 12px;

    min-width: 0;
  }

  .map-filter__title-icon {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 46px;
    height: 46px;

    flex: 0 0 46px;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 2px solid var(--ink);

    box-shadow: 4px 4px 0 var(--warning);
  }

  .map-filter__title-icon svg {
    color: var(--ink) !important;

    stroke: var(--ink) !important;
  }

  .map-filter__title-copy {
    min-width: 0;
  }

  .map-filter__title {
    margin: 2px 0 0;

    color: var(--white) !important;

    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size: 20px;

    font-weight: 900;

    line-height: 0.95;

    letter-spacing: -0.055em;

    text-transform: uppercase;
  }

  .map-filter__subtitle {
    max-width: 560px;

    margin: 8px 0 0;

    color: #c4c8bd !important;

    font-size: 10px;

    line-height: 1.65;
  }


  /* ==========================================================================
     RESET
     ========================================================================== */

  .map-filter__reset {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    min-height: 38px;

    flex: 0 0 auto;

    padding: 0 11px;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 2px solid var(--ink);

    box-shadow: 4px 4px 0 var(--warning);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.07em;

    text-transform: uppercase;

    cursor: pointer;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .map-filter__reset span {
    color: var(--ink) !important;
  }

  .map-filter__reset svg {
    color: var(--ink) !important;

    stroke: var(--ink) !important;
  }

  .map-filter__reset:hover {
    color: var(--ink) !important;

    background: var(--acid-soft) !important;

    transform: translate(-2px, -2px);

    box-shadow: 6px 6px 0 var(--white);
  }


  /* ==========================================================================
     FIELDS
     ========================================================================== */

  .map-filter__fields {
    display: grid;

    grid-template-columns:
      minmax(15rem, 1.5fr)
      repeat(
        2,
        minmax(10rem, 1fr)
      );

    gap: 13px;
  }

  .map-filter__field {
    min-width: 0;
  }

  .map-filter__label {
    display: block;

    margin: 0 0 8px;

    color: var(--acid) !important;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  /* ==========================================================================
     INPUT / SELECT WRAPPERS
     ========================================================================== */

  .map-filter__input-wrap,
  .map-filter__select-wrap {
    position: relative;

    display: flex;

    align-items: center;

    min-width: 0;
  }


  /* ==========================================================================
     INPUT
     ========================================================================== */

  .map-filter__input {
    display: block;

    width: 100%;

    min-width: 0;

    min-height: 50px;

    padding:
      0
      42px
      0
      43px;

    color: var(--ink) !important;

    background: var(--white) !important;

    border: 3px solid var(--ink);

    border-radius: 0;

    outline: 0;

    box-shadow: 5px 5px 0 var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 9px;

    font-weight: 700;

    line-height: 1;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      border-color 120ms linear;
  }

  .map-filter__input::placeholder {
    color: #727970 !important;

    opacity: 1;
  }

  .map-filter__input:focus {
    border-color: var(--ink);

    transform: translate(-2px, -2px);

    box-shadow: 7px 7px 0 var(--acid);
  }

  .map-filter__input-icon {
    position: absolute;

    left: 15px;

    z-index: 2;

    color: var(--warning) !important;

    stroke: var(--warning) !important;

    pointer-events: none;
  }


  /* ==========================================================================
     SELECT
     ========================================================================== */

  .map-filter__select {
    display: block;

    width: 100%;

    min-width: 0;

    min-height: 50px;

    padding:
      0
      42px
      0
      43px;

    color: var(--ink) !important;

    background: var(--white) !important;

    border: 3px solid var(--ink);

    border-radius: 0;

    outline: 0;

    box-shadow: 5px 5px 0 var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 9px;

    font-weight: 700;

    line-height: 1;

    appearance: none;

    cursor: pointer;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      border-color 120ms linear;
  }

  .map-filter__select:focus {
    border-color: var(--ink);

    transform: translate(-2px, -2px);

    box-shadow: 7px 7px 0 var(--acid);
  }

  .map-filter__select-icon {
    position: absolute;

    left: 15px;

    z-index: 2;

    color: var(--warning) !important;

    stroke: var(--warning) !important;

    pointer-events: none;
  }

  .map-filter__select-wrap::after {
    position: absolute;

    right: 16px;

    width: 9px;
    height: 9px;

    content: "";

    border-right: 3px solid var(--ink);

    border-bottom: 3px solid var(--ink);

    transform:
      rotate(45deg)
      translateY(-3px);

    pointer-events: none;
  }


  /* ==========================================================================
     OPTION
     ========================================================================== */

  .map-filter__select option {
    color: var(--ink);

    background: var(--white);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
  }


  /* ==========================================================================
     FOOTER
     ========================================================================== */

  .map-filter__footer {
    display: flex;

    align-items: center;

    gap: 9px;

    min-height: 34px;

    margin-top: 17px;

    padding-top: 13px;

    color: #aeb5aa !important;

    border-top:
      2px solid
      rgba(
        255,
        255,
        255,
        0.16
      );

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    line-height: 1.3;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .map-filter__summary-icon {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 28px;
    height: 28px;

    flex: 0 0 28px;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 2px solid var(--ink);
  }

  .map-filter__summary-icon svg {
    color: var(--ink) !important;

    stroke: var(--ink) !important;
  }

  .map-filter__footer
    [data-map-filter-summary-text] {
    color: #aeb5aa !important;
  }


  /* ==========================================================================
     COMPACT
     ========================================================================== */

  .map-filter--compact {
    padding: 15px;
  }

  .map-filter--compact
    .map-filter__title {
    font-size: 17px;
  }

  .map-filter--compact
    .map-filter__title-icon {
    width: 40px;
    height: 40px;
    flex-basis: 40px;
  }

  .map-filter--compact
    .map-filter__heading {
    margin-bottom: 15px;
  }

  .map-filter--compact
    .map-filter__subtitle {
    display: none;
  }

  .map-filter--compact
    .map-filter__footer {
    display: none;
  }

  .map-filter--compact
    .map-filter__input,
  .map-filter--compact
    .map-filter__select {
    min-height: 46px;
  }


  /* ==========================================================================
     FOCUS
     ========================================================================== */

  .map-filter__reset:focus-visible,
  .map-filter__input:focus-visible,
  .map-filter__select:focus-visible {
    outline: 4px solid var(--acid);

    outline-offset: 4px;
  }


  /* ==========================================================================
     TABLET
     ========================================================================== */

  @media (max-width: 900px) {
    .map-filter__fields {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);
    }

    .map-filter__field--search {
      grid-column: 1 / -1;
    }
  }


  /* ==========================================================================
     MOBILE
     ========================================================================== */

  @media (max-width: 640px) {
    .map-filter {
      padding: 17px;
    }

    .map-filter__heading {
      align-items: flex-start;

      gap: 12px;

      margin-bottom: 17px;
    }

    .map-filter__title-wrap {
      gap: 10px;
    }

    .map-filter__title-icon {
      width: 42px;
      height: 42px;
      flex-basis: 42px;
    }

    .map-filter__title {
      font-size: 17px;
    }

    .map-filter__subtitle {
      display: none;
    }

    .map-filter__fields {
      grid-template-columns: 1fr;
    }

    .map-filter__field--search {
      grid-column: auto;
    }

    .map-filter__reset {
      width: 38px;
      min-width: 38px;

      padding: 0;
    }

    .map-filter__reset span {
      display: none;
    }

    .map-filter__input,
    .map-filter__select {
      min-height: 50px;
    }

    .map-filter__footer {
      margin-top: 15px;
      padding-top: 12px;
    }
  }


  /* ==========================================================================
     SMALL MOBILE
     ========================================================================== */

  @media (max-width: 430px) {
    .map-filter {
      padding: 15px;
    }

    .map-filter__heading {
      gap: 10px;
    }

    .map-filter__title-icon {
      width: 40px;
      height: 40px;
      flex-basis: 40px;
    }

    .map-filter__title {
      font-size: 16px;
    }

    .map-filter__label {
      font-size: 7px;
    }

    .map-filter__input,
    .map-filter__select {
      min-height: 48px;
      font-size: 8px;
    }

    .map-filter__input {
      padding-left: 39px;
    }

    .map-filter__select {
      padding-left: 39px;
    }

    .map-filter__input-icon,
    .map-filter__select-icon {
      left: 13px;
    }

    .map-filter__select-wrap::after {
      right: 13px;
    }
  }


  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */

  @media (prefers-reduced-motion: reduce) {
    .map-filter *,
    .map-filter *::before,
    .map-filter *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>