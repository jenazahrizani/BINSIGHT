---
import {
  Layers,
  LocateFixed,
  MapPin,
  Maximize2,
  Minus,
  Plus,
  RefreshCw,
} from "@lucide/astro";

import {
  getPublicLocations,
  type WasteLocation,
} from "@lib/data/locations";

export interface WasteMapLocation extends WasteLocation {}

interface Props {
  locations?: WasteMapLocation[];
  height?: string;
  showControls?: boolean;
  showLayerControl?: boolean;
  showLocateControl?: boolean;
  showFullscreenControl?: boolean;
  showLegend?: boolean;
  showSearch?: boolean;
  initialZoom?: number;
  minZoom?: number;
  maxZoom?: number;
  centerLat?: number;
  centerLng?: number;
  class?: string;
}

const {
  locations = getPublicLocations(),
  height = "520px",
  showControls = true,
  showLayerControl = true,
  showLocateControl = true,
  showFullscreenControl = true,
  showLegend = true,
  showSearch = true,
  initialZoom = 11,
  minZoom = 9,
  maxZoom = 18,
  centerLat = -8.55,
  centerLng = 115.18,
  class: className = "",
} = Astro.props;

const mapLocations = locations.filter(
  (location) =>
    location.status === "active" &&
    Number.isFinite(location.coordinates.lat) &&
    Number.isFinite(location.coordinates.lng),
);

const locationPayload = mapLocations.map((location) => ({
  id: location.id,
  slug: location.slug,
  name: location.name,
  description: location.description,
  address: location.address,
  areaId: location.areaId,
  areaName: location.areaName,
  type: location.type,
  coordinates: {
    lat: location.coordinates.lat,
    lng: location.coordinates.lng,
  },
}));

const mapId = `waste-map-${Math.random()
  .toString(36)
  .slice(2, 10)}`;
---

<div
  class:list={["waste-map", className]}
  data-waste-map
  data-map-id={mapId}
  data-locations={JSON.stringify(locationPayload)}
  data-center-lat={centerLat}
  data-center-lng={centerLng}
  data-initial-zoom={initialZoom}
  data-min-zoom={minZoom}
  data-max-zoom={maxZoom}
  style={`--waste-map-height: ${height};`}
>
  <div class="waste-map__stage">

    <div
      id={mapId}
      class="waste-map__canvas"
      aria-label="Peta lokasi pengelolaan sampah Kabupaten Badung"
    ></div>

    {
      showControls && (
        <div
          class="waste-map__controls"
          aria-label="Kontrol peta"
        >
          <button
            type="button"
            class="waste-map__control"
            data-map-zoom-in
            aria-label="Perbesar peta"
            title="Perbesar"
          >
            <Plus
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>

          <button
            type="button"
            class="waste-map__control"
            data-map-zoom-out
            aria-label="Perkecil peta"
            title="Perkecil"
          >
            <Minus
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>

          {
            showLocateControl && (
              <button
                type="button"
                class="waste-map__control"
                data-map-locate
                aria-label="Gunakan lokasi saya"
                title="Lokasi saya"
              >
                <LocateFixed
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </button>
            )
          }

          {
            showFullscreenControl && (
              <button
                type="button"
                class="waste-map__control"
                data-map-fullscreen
                aria-label="Tampilkan peta layar penuh"
                title="Layar penuh"
              >
                <Maximize2
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </button>
            )
          }

          {
            showLayerControl && (
              <button
                type="button"
                class="waste-map__control"
                data-map-fit
                aria-label="Tampilkan seluruh lokasi"
                title="Tampilkan semua lokasi"
              >
                <Layers
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </button>
            )
          }

          <button
            type="button"
            class="waste-map__control"
            data-map-refresh
            aria-label="Atur ulang peta"
            title="Atur ulang"
          >
            <RefreshCw
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>
      )
    }

    <div
      class="waste-map__status"
      aria-live="polite"
      data-map-status
    >
      Memuat peta...
    </div>

    {
      showLegend && (
        <div
          class="waste-map__legend"
          aria-label="Legenda peta"
        >
          <div class="waste-map__legend-title">
            Lokasi
          </div>

          <div class="waste-map__legend-item">
            <span
              class="waste-map__legend-marker"
              aria-hidden="true"
            ></span>

            <span>
              Titik pengelolaan
            </span>
          </div>
        </div>
      )
    }

    <noscript>
      <div class="waste-map__no-script">
        <strong>
          Peta membutuhkan JavaScript
        </strong>

        <p>
          Aktifkan JavaScript untuk melihat
          lokasi pengelolaan sampah pada peta.
        </p>
      </div>
    </noscript>

  </div>
</div>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  type MapLocationPayload = {
    id: string;
    slug: string;
    name: string;
    description?: string;
    address?: string;
    areaId?: string;
    areaName?: string;
    type?: string;
    coordinates: {
      lat: number;
      lng: number;
    };
  };

  type WasteMapRoot = HTMLElement & {
    __binsightWasteMapInitialized?: boolean;
  };

  const roots = Array.from(
    document.querySelectorAll<WasteMapRoot>(
      "[data-waste-map]",
    ),
  );

  const formatLocationType = (type: unknown) => {
    const labels: Record<string, string> = {
      "collection-point":
        "Titik pengumpulan",
      "recycling-center":
        "Pusat daur ulang",
      "waste-bank":
        "Bank sampah",
      "processing-facility":
        "Fasilitas pengolahan",
      "drop-point":
        "Drop point",
      other:
        "Lokasi pengelolaan",
    };

    return (
      labels[String(type ?? "")] ??
      "Lokasi pengelolaan"
    );
  };

  const escapeHtml = (value: unknown) => {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  };

  const createMarkerIcon = () => {
    return L.divIcon({
      className:
        "binsight-map-marker-wrapper",

      html: `
        <span
          class="binsight-map-marker"
          aria-hidden="true"
        >
          <span
            class="binsight-map-marker__dot"
          ></span>
        </span>
      `,

      iconSize: [28, 36],
      iconAnchor: [14, 35],
      popupAnchor: [0, -32],
    });
  };

  const initializeWasteMap = (
    root: WasteMapRoot,
  ) => {
    if (root.__binsightWasteMapInitialized) {
      return;
    }

    root.__binsightWasteMapInitialized = true;

    const canvas =
      root.querySelector<HTMLElement>(
        ".waste-map__canvas",
      );

    if (!canvas) {
      return;
    }

    const status =
      root.querySelector<HTMLElement>(
        "[data-map-status]",
      );

    const setStatus = (message: string) => {
      if (status) {
        status.textContent = message;
      }
    };

    const parseLocations =
      (): MapLocationPayload[] => {
        try {
          const raw =
            root.dataset.locations ?? "[]";

          const parsed = JSON.parse(raw);

          return Array.isArray(parsed)
            ? parsed
            : [];
        } catch {
          return [];
        }
      };

    const locations = parseLocations();

    const centerLat = Number(
      root.dataset.centerLat ?? "-8.55",
    );

    const centerLng = Number(
      root.dataset.centerLng ?? "115.18",
    );

    const initialZoom = Number(
      root.dataset.initialZoom ?? "11",
    );

    const minZoom = Number(
      root.dataset.minZoom ?? "9",
    );

    const maxZoom = Number(
      root.dataset.maxZoom ?? "18",
    );

    let map: L.Map | null = null;

    let markerLayer:
      | L.LayerGroup
      | null = null;

    const markerById = new Map<
      string,
      L.Marker
    >();

    const markerIcon = createMarkerIcon();

    const fitToLocations = () => {
      if (!map || locations.length === 0) {
        return;
      }

      const bounds = L.latLngBounds(
        locations.map(
          (location) =>
            [
              location.coordinates.lat,
              location.coordinates.lng,
            ] as L.LatLngTuple,
        ),
      );

      if (bounds.isValid()) {
        map.fitBounds(bounds, {
          padding: [32, 32],
          maxZoom: Math.min(
            initialZoom + 2,
            maxZoom,
          ),
          animate: false,
        });
      }
    };

    const resetMap = () => {
      if (!map) {
        return;
      }

      map.setView(
        [
          centerLat,
          centerLng,
        ],
        initialZoom,
        {
          animate: false,
        },
      );

      if (locations.length > 0) {
        fitToLocations();
      }
    };

    const openLocation = (
      location: MapLocationPayload,
    ) => {
      const marker =
        markerById.get(location.id);

      if (!marker || !map) {
        return;
      }

      marker.openPopup();

      map.panTo(
        [
          location.coordinates.lat,
          location.coordinates.lng,
        ],
        {
          animate: true,
        },
      );
    };

    try {
      setStatus(
        locations.length > 0
          ? "Memuat peta..."
          : "Tidak ada lokasi untuk ditampilkan.",
      );

      map = L.map(canvas, {
        center: [
          centerLat,
          centerLng,
        ],

        zoom: initialZoom,

        minZoom,
        maxZoom,

        zoomControl: false,

        attributionControl: true,
      });

      L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
          maxZoom,

          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors',
        },
      ).addTo(map);

      markerLayer =
        L.layerGroup().addTo(map);

      for (const location of locations) {
        const marker = L.marker(
          [
            location.coordinates.lat,
            location.coordinates.lng,
          ],
          {
            icon: markerIcon,
            title: location.name,
            alt: location.name,
          },
        );

        const popupContent = `
          <div
            class="binsight-map-popup"
          >
            <div
              class="binsight-map-popup__eyebrow"
            >
              ${escapeHtml(
                formatLocationType(
                  location.type,
                ),
              )}
            </div>

            <h3
              class="binsight-map-popup__title"
            >
              ${escapeHtml(
                location.name,
              )}
            </h3>

            <p
              class="binsight-map-popup__area"
            >
              ${escapeHtml(
                location.areaName,
              )}
            </p>

            <p
              class="binsight-map-popup__address"
            >
              ${escapeHtml(
                location.address,
              )}
            </p>

            <a
              class="binsight-map-popup__link"
              href="/map/${encodeURIComponent(
                String(
                  location.areaId ?? "",
                ),
              )}"
            >
              Lihat area

              <span aria-hidden="true">
                →
              </span>
            </a>
          </div>
        `;

        marker.bindPopup(
          popupContent,
          {
            maxWidth: 300,
            className:
              "binsight-leaflet-popup",
          },
        );

        markerLayer.addLayer(marker);

        markerById.set(
          location.id,
          marker,
        );
      }

      map.on(
        "zoomend moveend",
        () => {
          if (!map) {
            return;
          }

          const zoom = map.getZoom();

          setStatus(
            `${locations.length.toLocaleString(
              "id-ID",
            )} lokasi · zoom ${zoom}`,
          );
        },
      );

      const zoomIn =
        root.querySelector<HTMLButtonElement>(
          "[data-map-zoom-in]",
        );

      const zoomOut =
        root.querySelector<HTMLButtonElement>(
          "[data-map-zoom-out]",
        );

      const locateButton =
        root.querySelector<HTMLButtonElement>(
          "[data-map-locate]",
        );

      const fullscreenButton =
        root.querySelector<HTMLButtonElement>(
          "[data-map-fullscreen]",
        );

      const fitButton =
        root.querySelector<HTMLButtonElement>(
          "[data-map-fit]",
        );

      const refreshButton =
        root.querySelector<HTMLButtonElement>(
          "[data-map-refresh]",
        );

      zoomIn?.addEventListener(
        "click",
        () => {
          map?.zoomIn();
        },
      );

      zoomOut?.addEventListener(
        "click",
        () => {
          map?.zoomOut();
        },
      );

      locateButton?.addEventListener(
        "click",
        () => {
          if (!navigator.geolocation) {
            setStatus(
              "Browser tidak mendukung lokasi.",
            );

            return;
          }

          setStatus(
            "Mencari lokasi Anda...",
          );

          navigator.geolocation.getCurrentPosition(
            (position) => {
              if (!map) {
                return;
              }

              const lat =
                position.coords
                  .latitude;

              const lng =
                position.coords
                  .longitude;

              map.setView(
                [
                  lat,
                  lng,
                ],
                Math.max(
                  15,
                  initialZoom,
                ),
                {
                  animate: true,
                },
              );

              L.circleMarker(
                [
                  lat,
                  lng,
                ],
                {
                  radius: 7,

                  className:
                    "binsight-user-location",

                  color: "#ffffff",

                  weight: 3,

                  fillColor:
                    "#2563eb",

                  fillOpacity: 1,
                },
              ).addTo(map);

              setStatus(
                "Lokasi Anda ditampilkan di peta.",
              );
            },

            () => {
              setStatus(
                "Lokasi Anda tidak dapat diakses.",
              );
            },

            {
              enableHighAccuracy:
                true,

              timeout: 10000,

              maximumAge: 60000,
            },
          );
        },
      );

      fullscreenButton?.addEventListener(
        "click",
        async () => {
          try {
            if (
              !document.fullscreenElement
            ) {
              await root.requestFullscreen?.();
            } else {
              await document.exitFullscreen();
            }
          } catch {
            setStatus(
              "Mode layar penuh tidak tersedia.",
            );
          }
        },
      );

      fitButton?.addEventListener(
        "click",
        () => {
          fitToLocations();
        },
      );

      refreshButton?.addEventListener(
        "click",
        () => {
          map?.invalidateSize({
            pan: false,
            debounceMoveend: true,
          });

          resetMap();
        },
      );

      if (locations.length > 0) {
        fitToLocations();
      }

      requestAnimationFrame(() => {
        map?.invalidateSize();
      });

      setStatus(
        `${locations.length.toLocaleString(
          "id-ID",
        )} lokasi tersedia`,
      );
    } catch (error) {
      console.error(
        "[BINSIGHT] Failed to initialize map:",
        error,
      );

      setStatus(
        "Peta tidak dapat dimuat.",
      );

      canvas.innerHTML = `
        <div
          class="waste-map__error"
        >
          <div
            class="waste-map__error-icon"
          >
            !
          </div>

          <strong>
            Peta tidak tersedia
          </strong>

          <p>
            Leaflet gagal dimuat.
            Periksa instalasi dependency
            lalu coba muat ulang halaman.
          </p>

          <button
            type="button"
            class="waste-map__error-button"
            data-map-retry
          >
            Coba lagi
          </button>
        </div>
      `;

      canvas
        .querySelector<HTMLButtonElement>(
          "[data-map-retry]",
        )
        ?.addEventListener(
          "click",
          () => {
            window.location.reload();
          },
        );
    }
  };

  for (const root of roots) {
    initializeWasteMap(root);
  }
</script>

<style>
  .waste-map,
  .waste-map *,
  .waste-map *::before,
  .waste-map *::after {
    box-sizing: border-box;
  }

  .waste-map {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;

    --white: #fffef8;
    --muted: #6c7068;

    --warning: #ff6a00;

    position: relative;
    width: 100%;
    min-width: 0;
    overflow: hidden;

    color: var(--ink);
    background: var(--paper);

    border: 3px solid var(--ink);

    box-shadow:
      8px 8px 0 var(--warning);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .waste-map__stage {
    position: relative;

    width: 100%;
    min-height: 320px;
    height: var(--waste-map-height);

    overflow: hidden;

    background: #253021;
  }

  .waste-map__canvas {
    position: absolute;
    inset: 0;

    z-index: 0;

    width: 100%;
    height: 100%;

    background: #253021;
  }

  .waste-map__canvas :global(.leaflet-container) {
    width: 100%;
    height: 100%;

    background: #253021;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
  }

  .waste-map__canvas :global(.leaflet-control-attribution) {
    padding: 3px 5px;

    color: #4a5148;

    background:
      rgb(255 254 248 / 0.88);

    border-top: 2px solid var(--ink);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;
    font-weight: 700;
  }

  .waste-map__canvas :global(.leaflet-control-attribution a) {
    color: var(--ink);

    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .waste-map__controls {
    position: absolute;

    top: 16px;
    right: 16px;

    z-index: 1000;

    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .waste-map__control {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    padding: 0;

    color: var(--ink) !important;
    background: var(--acid) !important;

    border: 3px solid var(--ink);

    box-shadow:
      5px 5px 0 var(--warning);

    cursor: pointer;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .waste-map__control svg {
    color: var(--ink) !important;
    stroke: var(--ink) !important;
  }

  .waste-map__control:hover {
    color: var(--ink) !important;
    background: var(--acid-soft) !important;

    transform:
      translate(-2px, -2px);

    box-shadow:
      7px 7px 0 var(--ink);
  }

  .waste-map__status {
    position: absolute;

    left: 16px;
    bottom: 16px;

    z-index: 900;

    display: inline-flex;
    align-items: center;

    min-height: 30px;
    max-width: calc(100% - 32px);

    padding: 0 9px;

    color: var(--acid) !important;
    background: var(--ink) !important;

    border: 2px solid var(--white);

    box-shadow:
      4px 4px 0 var(--warning);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 900;
    line-height: 1;

    letter-spacing: 0.06em;
    text-transform: uppercase;

    white-space: nowrap;
  }

  .waste-map__legend {
    position: absolute;

    right: 16px;
    bottom: 16px;

    z-index: 900;

    min-width: 165px;

    padding: 11px;

    color: var(--white) !important;
    background: var(--ink) !important;

    border: 3px solid var(--white);

    box-shadow:
      5px 5px 0 var(--warning);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 900;
    line-height: 1.4;

    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .waste-map__legend-title {
    margin-bottom: 7px;
    padding-bottom: 7px;

    color: var(--acid) !important;

    border-bottom:
      2px solid
      var(--white);
  }

  .waste-map__legend-item {
    display: flex;
    align-items: center;
    gap: 7px;

    color: var(--white) !important;
  }

  .waste-map__legend-marker {
    width: 12px;
    height: 12px;

    flex: 0 0 12px;

    background: var(--acid);

    border: 3px solid var(--white);
  }

  :global(.binsight-map-marker-wrapper) {
    background: transparent !important;
    border: 0 !important;
  }

  :global(.binsight-map-marker) {
    position: relative;

    display: block;

    width: 28px;
    height: 36px;

    background: var(--acid);

    border:
      3px solid
      var(--ink);

    box-shadow:
      4px 4px 0
      var(--warning);

    transform:
      rotate(-45deg);
  }

  :global(.binsight-map-marker__dot) {
    position: absolute;

    top: 6px;
    left: 6px;

    width: 10px;
    height: 10px;

    background: var(--warning);

    border:
      2px solid
      var(--ink);
  }

  :global(.binsight-leaflet-popup .leaflet-popup-content-wrapper) {
    overflow: hidden;

    background: var(--white);

    border:
      3px solid
      var(--ink);

    border-radius: 0;

    box-shadow:
      7px 7px 0
      var(--warning);
  }

  :global(.binsight-leaflet-popup .leaflet-popup-tip) {
    background: var(--white);
  }

  :global(.binsight-leaflet-popup .leaflet-popup-content) {
    margin: 0;
  }

  :global(.binsight-map-popup) {
    min-width: 220px;

    padding: 15px;

    color: var(--ink);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
  }

  :global(.binsight-map-popup__eyebrow) {
    display: inline-block;

    margin-bottom: 9px;
    padding: 5px 7px;

    color: var(--ink);

    background: var(--acid);

    border:
      2px solid
      var(--ink);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;
    font-weight: 900;
