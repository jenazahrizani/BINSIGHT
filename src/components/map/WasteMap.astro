---
import {
  Layers,
  LocateFixed,
  MapPin,
  Maximize2,
  Minus,
  Plus,
  RefreshCw,
} from "@lucide/astro";

import {
  getPublicLocations,
  type WasteLocation,
} from "@lib/data/locations";

export interface WasteMapLocation extends WasteLocation {}

interface Props {
  locations?: WasteMapLocation[];
  height?: string;
  showControls?: boolean;
  showLayerControl?: boolean;
  showLocateControl?: boolean;
  showFullscreenControl?: boolean;
  showLegend?: boolean;

  /**
   * Deprecated.
   * Search is now handled by MapFilter.
   * Kept for backwards compatibility with existing callers.
   */
  showSearch?: boolean;

  initialZoom?: number;
  minZoom?: number;
  maxZoom?: number;
  centerLat?: number;
  centerLng?: number;
  class?: string;
}

const {
  locations = getPublicLocations(),
  height = "520px",
  showControls = true,
  showLayerControl = true,
  showLocateControl = true,
  showFullscreenControl = true,
  showLegend = true,
  showSearch: _showSearch = false,
  initialZoom = 11,
  minZoom = 9,
  maxZoom = 18,
  centerLat = -8.55,
  centerLng = 115.18,
  class: className = "",
} = Astro.props;

const mapLocations = locations.filter(
  (location) =>
    location.status === "active" &&
    Number.isFinite(location.coordinates.lat) &&
    Number.isFinite(location.coordinates.lng),
);

const locationPayload = mapLocations.map((location) => ({
  id: location.id,
  slug: location.slug,
  name: location.name,
  description: location.description,
  address: location.address,
  areaId: location.areaId,
  areaName: location.areaName,
  type: location.type,
  coordinates: {
    lat: location.coordinates.lat,
    lng: location.coordinates.lng,
  },
}));

const mapId = `waste-map-${Math.random()
  .toString(36)
  .slice(2, 10)}`;
---

<div
  class:list={["waste-map", className]}
  data-waste-map
  data-map-id={mapId}
  data-locations={JSON.stringify(locationPayload)}
  data-center-lat={centerLat}
  data-center-lng={centerLng}
  data-initial-zoom={initialZoom}
  data-min-zoom={minZoom}
  data-max-zoom={maxZoom}
  style={`--waste-map-height: ${height};`}
>
  <div class="waste-map__stage">

    <div
      id={mapId}
      class="waste-map__canvas"
      aria-label="Peta lokasi pengelolaan sampah Kabupaten Badung"
    ></div>

    {
      showControls && (
        <div
          class="waste-map__controls"
          aria-label="Kontrol peta"
        >
          <button
            type="button"
            class="waste-map__control"
            data-map-zoom-in
            aria-label="Perbesar peta"
            title="Perbesar"
          >
            <Plus
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>

          <button
            type="button"
            class="waste-map__control"
            data-map-zoom-out
            aria-label="Perkecil peta"
            title="Perkecil"
          >
            <Minus
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>

          {
            showLocateControl && (
              <button
                type="button"
                class="waste-map__control"
                data-map-locate
                aria-label="Gunakan lokasi saya"
                title="Lokasi saya"
              >
                <LocateFixed
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </button>
            )
          }

          {
            showFullscreenControl && (
              <button
                type="button"
                class="waste-map__control"
                data-map-fullscreen
                aria-label="Tampilkan peta layar penuh"
                title="Layar penuh"
              >
                <Maximize2
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </button>
            )
          }

          {
            showLayerControl && (
              <button
                type="button"
                class="waste-map__control"
                data-map-fit
                aria-label="Tampilkan seluruh lokasi"
                title="Tampilkan semua lokasi"
              >
                <Layers
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </button>
            )
          }

          <button
            type="button"
            class="waste-map__control"
            data-map-refresh
            aria-label="Atur ulang peta"
            title="Atur ulang"
          >
            <RefreshCw
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>
      )
    }

    <div
      class="waste-map__status"
      aria-live="polite"
      data-map-status
    >
      Memuat peta...
    </div>

    {
      showLegend && (
        <div
          class="waste-map__legend"
          aria-label="Legenda peta"
        >
          <div class="waste-map__legend-title">
            Lokasi
          </div>

          <div class="waste-map__legend-item">
            <span
              class="waste-map__legend-marker"
              aria-hidden="true"
            ></span>

            <span>
              Titik pengelolaan
            </span>
          </div>
        </div>
      )
    }

    <!--
      Keep OpenStreetMap attribution without showing
      the default Leaflet attribution watermark.
    -->
    <div
      class="waste-map__attribution"
      aria-label="Atribusi peta"
    >
      © OpenStreetMap
    </div>

    <noscript>
      <div class="waste-map__no-script">
        <strong>
          Peta membutuhkan JavaScript
        </strong>

        <p>
          Aktifkan JavaScript untuk melihat
          lokasi pengelolaan sampah pada peta.
        </p>
      </div>
    </noscript>

  </div>
</div>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  type MapLocationPayload = {
    id: string;
    slug: string;
    name: string;
    description?: string;
    address?: string;
    areaId?: string;
    areaName?: string;
    type?: string;
    coordinates: {
      lat: number;
      lng: number;
    };
  };

  type WasteMapRoot = HTMLElement & {
    __binsightWasteMapInitialized?: boolean;
  };

  type MapFilterDetail = {
    search?: string;
    query?: string;

    area?: string;
    selectedArea?: string;
    areaId?: string;

    type?: string;
    selectedType?: string;
  };

  const normalize = (value: unknown) =>
    String(value ?? "")
      .trim()
      .toLowerCase();

  const escapeHtml = (value: unknown) => {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  };

  const formatLocationType = (type: unknown) => {
    const labels: Record<string, string> = {
      "collection-point":
        "Titik pengumpulan",

      "recycling-center":
        "Pusat daur ulang",

      "waste-bank":
        "Bank sampah",

      "processing-facility":
        "Fasilitas pengolahan",

      "drop-point":
        "Drop point",

      other:
        "Lokasi pengelolaan",
    };

    return (
      labels[normalize(type)] ??
      "Lokasi pengelolaan"
    );
  };

  const createMarkerIcon = () => {
    return L.divIcon({
      className:
        "binsight-map-marker-wrapper",

      html: `
        <span
          class="binsight-map-marker"
          aria-hidden="true"
        >
          <span
            class="binsight-map-marker__dot"
          ></span>
        </span>
      `,

      iconSize: [28, 36],
      iconAnchor: [14, 35],
      popupAnchor: [0, -32],
    });
  };

  const initializeWasteMap = (
    root: WasteMapRoot,
  ) => {
    if (
      root.__binsightWasteMapInitialized
    ) {
      return;
    }

    root.__binsightWasteMapInitialized =
      true;

    const canvas =
      root.querySelector<HTMLElement>(
        ".waste-map__canvas",
      );

    if (!canvas) {
      return;
    }

    const status =
      root.querySelector<HTMLElement>(
        "[data-map-status]",
      );

    const setStatus = (
      message: string,
    ) => {
      if (status) {
        status.textContent = message;
      }
    };

    const parseLocations =
      (): MapLocationPayload[] => {
        try {
          const raw =
            root.dataset.locations ??
            "[]";

          const parsed =
            JSON.parse(raw);

          return Array.isArray(parsed)
            ? parsed
            : [];
        } catch {
          return [];
        }
      };

    const locations =
      parseLocations();

    const centerLat =
      Number(
        root.dataset.centerLat ??
          "-8.55",
      );

    const centerLng =
      Number(
        root.dataset.centerLng ??
          "115.18",
      );

    const initialZoom =
      Number(
        root.dataset.initialZoom ??
          "11",
      );

    const minZoom =
      Number(
        root.dataset.minZoom ??
          "9",
      );

    const maxZoom =
      Number(
        root.dataset.maxZoom ??
          "18",
      );

    let map:
      | L.Map
      | null = null;

    let markerLayer:
      | L.LayerGroup
      | null = null;

    let userLocationMarker:
      | L.CircleMarker
      | null = null;

    const markerById =
      new Map<
        string,
        L.Marker
      >();

    const markerIcon =
      createMarkerIcon();

    /*
     * Keep the current filter state inside the map.
     * MapFilter dispatches the event.
     */
    let currentFilter = {
      search: "",
      area: "",
      type: "",
    };

    const getAreaCandidates = (
      location: MapLocationPayload,
    ) => {
      return [
        location.areaId,
        location.areaName,
        location.slug,
      ]
        .filter(Boolean)
        .map(normalize);
    };

    const matchesFilters = (
      location: MapLocationPayload,
    ) => {
      const query =
        normalize(
          currentFilter.search,
        );

      const area =
        normalize(
          currentFilter.area,
        );

      const type =
        normalize(
          currentFilter.type,
        );

      if (query) {
        const haystack = [
          location.name,
          location.address,
          location.areaName,
          location.type,
          formatLocationType(
            location.type,
          ),
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();

        if (!haystack.includes(query)) {
          return false;
        }
      }

      if (area) {
        const areaCandidates =
          getAreaCandidates(location);

        if (
          !areaCandidates.includes(
            area,
          )
        ) {
          return false;
        }
      }

      if (type) {
        if (
          normalize(
            location.type,
          ) !== type
        ) {
          return false;
        }
      }

      return true;
    };

    const getVisibleLocations =
      () =>
        locations.filter(
          matchesFilters,
        );

    const updateStatus = (
      visibleLocations:
        MapLocationPayload[],
    ) => {
      if (!map) {
        return;
      }

      const zoom =
        map.getZoom();

      const total =
        locations.length;

      const visible =
        visibleLocations.length;

      if (
        currentFilter.search ||
        currentFilter.area ||
        currentFilter.type
      ) {
        setStatus(
          `${visible.toLocaleString(
            "id-ID",
          )} dari ${total.toLocaleString(
            "id-ID",
          )} lokasi · zoom ${zoom}`,
        );
      } else {
        setStatus(
          `${total.toLocaleString(
            "id-ID",
          )} lokasi tersedia · zoom ${zoom}`,
        );
      }
    };

    const renderMarkers = (
      options?: {
        fit?: boolean;
      },
    ) => {
      if (!map || !markerLayer) {
        return;
      }

      markerLayer.clearLayers();

      const visibleLocations =
        getVisibleLocations();

      for (
        const location of visibleLocations
      ) {
        const marker =
          markerById.get(
            location.id,
          );

        if (!marker) {
          continue;
        }

        markerLayer.addLayer(
          marker,
        );
      }

      updateStatus(
        visibleLocations,
      );

      if (
        options?.fit &&
        visibleLocations.length > 0
      ) {
        const bounds =
          L.latLngBounds(
            visibleLocations.map(
              (location) =>
                [
                  location.coordinates.lat,
                  location.coordinates.lng,
                ] as L.LatLngTuple,
            ),
          );

        if (bounds.isValid()) {
          map.fitBounds(
            bounds,
            {
              padding: [
                42,
                42,
              ],

              maxZoom:
                Math.min(
                  initialZoom + 2,
                  maxZoom,
                ),

              animate: false,
            },
          );
        }
      }

      if (
        options?.fit &&
        visibleLocations.length === 0
      ) {
        map.setView(
          [
            centerLat,
            centerLng,
          ],
          initialZoom,
          {
            animate: false,
          },
        );
      }
    };

    const fitToLocations = () => {
      renderMarkers({
        fit: true,
      });
    };

    const resetMap = () => {
      currentFilter = {
        search: "",
        area: "",
        type: "",
      };

      if (!map) {
        return;
      }

      map.setView(
        [
          centerLat,
          centerLng,
        ],
        initialZoom,
        {
          animate: false,
        },
      );

      renderMarkers({
        fit: true,
      });
    };

    const openLocation = (
      location: MapLocationPayload,
    ) => {
      const marker =
        markerById.get(
          location.id,
        );

      if (
        !marker ||
        !map
      ) {
        return;
      }

      marker.openPopup();

      map.panTo(
        [
          location.coordinates.lat,
          location.coordinates.lng,
        ],
        {
          animate: true,
        },
      );
    };

    try {
      setStatus(
        locations.length > 0
          ? "Memuat peta..."
          : "Tidak ada lokasi untuk ditampilkan.",
      );

      map = L.map(
        canvas,
        {
          center: [
            centerLat,
            centerLng,
          ],

          zoom: initialZoom,

          minZoom,
          maxZoom,

          zoomControl: false,

          /*
           * Disable Leaflet's default
           * "Leaflet | © OpenStreetMap"
           * attribution watermark.
           */
          attributionControl: false,

          scrollWheelZoom: true,
          doubleClickZoom: true,
          dragging: true,
          touchZoom: true,
          boxZoom: true,
          keyboard: true,
        },
      );

      L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
          maxZoom,

          /*
           * Attribution is rendered manually
           * in .waste-map__attribution.
           */
          attribution:
            "© OpenStreetMap contributors",
        },
      ).addTo(map);

      markerLayer =
        L.layerGroup().addTo(
          map,
        );

      /*
       * Create every marker once.
       * Filtering only changes what is inside
       * markerLayer, which is much faster.
       */
      for (
        const location of locations
      ) {
        const marker =
          L.marker(
            [
              location.coordinates.lat,
              location.coordinates.lng,
            ],
            {
              icon:
                markerIcon,

              title:
                location.name,

              alt:
                location.name,

              keyboard:
                true,
            },
          );

        const popupContent = `
          <div
            class="binsight-map-popup"
          >
            <div
              class="binsight-map-popup__eyebrow"
            >
              ${escapeHtml(
                formatLocationType(
                  location.type,
                ),
              )}
            </div>

            <h3
              class="binsight-map-popup__title"
            >
              ${escapeHtml(
                location.name,
              )}
            </h3>

            <p
              class="binsight-map-popup__area"
            >
              ${escapeHtml(
                location.areaName,
              )}
            </p>

            <p
              class="binsight-map-popup__address"
            >
              ${escapeHtml(
                location.address,
              )}
            </p>

            <a
              class="binsight-map-popup__link"
              href="/map/${encodeURIComponent(
                String(
                  location.areaId ??
                    "",
                ),
              )}"
            >
              Lihat area

              <span
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </div>
        `;

        marker.bindPopup(
          popupContent,
          {
            maxWidth: 300,

            className:
              "binsight-leaflet-popup",
          },
        );

        markerById.set(
          location.id,
          marker,
        );
      }

      /*
       * Initial marker render.
       */
      renderMarkers({
        fit: locations.length > 0,
      });

      /*
       * MAP EVENTS
       */
      map.on(
        "zoomend moveend",
        () => {
          updateStatus(
            getVisibleLocations(),
          );
        },
      );

      /*
       * CONTROL ELEMENTS
       */
      const zoomIn =
        root.querySelector<HTMLButtonElement>(
          "[data-map-zoom-in]",
        );

      const zoomOut =
        root.querySelector<HTMLButtonElement>(
          "[data-map-zoom-out]",
        );

      const locateButton =
        root.querySelector<HTMLButtonElement>(
          "[data-map-locate]",
        );

      const fullscreenButton =
        root.querySelector<HTMLButtonElement>(
          "[data-map-fullscreen]",
        );

      const fitButton =
        root.querySelector<HTMLButtonElement>(
          "[data-map-fit]",
        );

      const refreshButton =
        root.querySelector<HTMLButtonElement>(
          "[data-map-refresh]",
        );

      /*
       * ZOOM IN
       */
      zoomIn?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();
          event.stopPropagation();

          map?.zoomIn();
        },
      );

      /*
       * ZOOM OUT
       */
      zoomOut?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();
          event.stopPropagation();

          map?.zoomOut();
        },
      );

      /*
       * LOCATE USER
       */
      locateButton?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();
          event.stopPropagation();

          if (
            !navigator.geolocation
          ) {
            setStatus(
              "Browser tidak mendukung lokasi.",
            );

            return;
          }

          setStatus(
            "Mencari lokasi Anda...",
          );

          navigator.geolocation.getCurrentPosition(
            (position) => {
              if (!map) {
                return;
              }

              const lat =
                position.coords
                  .latitude;

              const lng =
                position.coords
                  .longitude;

              if (
                userLocationMarker
              ) {
                userLocationMarker.remove();
              }

              userLocationMarker =
                L.circleMarker(
                  [
                    lat,
                    lng,
                  ],
                  {
                    radius: 7,

                    className:
                      "binsight-user-location",

                    color:
                      "#ffffff",

                    weight: 3,

                    fillColor:
                      "#2563eb",

                    fillOpacity: 1,
                  },
                ).addTo(map);

              map.setView(
                [
                  lat,
                  lng,
                ],
                Math.max(
                  15,
                  initialZoom,
                ),
                {
                  animate: true,
                },
              );

              setStatus(
                "Lokasi Anda ditampilkan di peta.",
              );
            },

            () => {
              setStatus(
                "Lokasi Anda tidak dapat diakses.",
              );
            },

            {
              enableHighAccuracy:
                true,

              timeout:
                10000,

              maximumAge:
                60000,
            },
          );
        },
      );

      /*
       * FULLSCREEN
       */
      fullscreenButton?.addEventListener(
        "click",
        async (event) => {
          event.preventDefault();
          event.stopPropagation();

          try {
            if (
              document.fullscreenElement ===
              root
            ) {
              await document.exitFullscreen();
            } else {
              await root.requestFullscreen();
            }
          } catch (error) {
            console.error(
              "[BINSIGHT] Fullscreen error:",
              error,
            );

            setStatus(
              "Mode layar penuh tidak tersedia.",
            );
          }
        },
      );

      /*
       * Browser fullscreen changes
       * the actual map dimensions.
       * Leaflet must be told to recalculate.
       */
      const handleFullscreenChange =
        () => {
          window.setTimeout(
            () => {
              map?.invalidateSize({
                pan: false,
              });

              updateStatus(
                getVisibleLocations(),
              );
            },
            150,
          );
        };

      document.addEventListener(
        "fullscreenchange",
        handleFullscreenChange,
      );

      /*
       * FIT / SHOW FILTERED LOCATIONS
       */
      fitButton?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();
          event.stopPropagation();

          fitToLocations();
        },
      );

      /*
       * REFRESH MAP
       */
      refreshButton?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();
          event.stopPropagation();

          resetMap();

          window.setTimeout(
            () => {
              map?.invalidateSize({
                pan: false,
              });
            },
            50,
          );
        },
      );

      /*
       * MAP FILTER INTEGRATION
       *
       * Compatible with these possible
       * MapFilter detail names:
       * search / query
       * area / selectedArea / areaId
       * type / selectedType
       */
      const handleMapFilter =
        (
          event: Event,
        ) => {
          const customEvent =
            event as CustomEvent<MapFilterDetail>;

          const detail =
            customEvent.detail ??
            {};

          currentFilter = {
            search:
              String(
                detail.search ??
                  detail.query ??
                  "",
              ),

            area:
              String(
                detail.area ??
                  detail.selectedArea ??
                  detail.areaId ??
                  "",
              ),

            type:
              String(
                detail.type ??
                  detail.selectedType ??
                  "",
              ),
          };

          renderMarkers({
            fit: true,
          });
        };

      window.addEventListener(
        "binsight-map-filter",
        handleMapFilter,
      );

      document.addEventListener(
        "binsight-map-filter",
        handleMapFilter,
      );

      /*
       * Also support an explicit
       * reset event if MapFilter emits one.
       */
      const handleMapFilterReset =
        () => {
          resetMap();
        };

      window.addEventListener(
        "binsight-map-filter-reset",
        handleMapFilterReset,
      );

      document.addEventListener(
        "binsight-map-filter-reset",
        handleMapFilterReset,
      );

      /*
       * Ensure the map is correctly measured
       * after layout/paint.
       */
      requestAnimationFrame(() => {
        map?.invalidateSize({
          pan: false,
        });
      });

      window.setTimeout(() => {
        map?.invalidateSize({
          pan: false,
        });
      }, 200);

      setStatus(
        `${locations.length.toLocaleString(
          "id-ID",
        )} lokasi tersedia`,
      );

    } catch (error) {
      console.error(
        "[BINSIGHT] Failed to initialize map:",
        error,
      );

      setStatus(
        "Peta tidak dapat dimuat.",
      );

      canvas.innerHTML = `
        <div
          class="waste-map__error"
        >
          <div
            class="waste-map__error-icon"
          >
            !
          </div>

          <strong>
            Peta tidak tersedia
          </strong>

          <p>
            Leaflet gagal dimuat.
            Periksa instalasi dependency
            lalu coba muat ulang halaman.
          </p>

          <button
            type="button"
            class="waste-map__error-button"
            data-map-retry
          >
            Coba lagi
          </button>
