---
import {
  AlertTriangle,
  CheckCircle,
  ChevronRight,
  Clock3,
  ExternalLink,
  FileWarning,
  MapPin,
  ShieldAlert,
} from "@lucide/astro";

import {
  getReportPriorityLabel,
  getReportStatusLabel,
  getReportTypeLabel,
  type Report,
  type ReportPriority,
  type ReportStatus,
} from "@lib/data/reports";

interface Props {
  report: Report;
  hrefBase?: string;
  compact?: boolean;
  showDescription?: boolean;
  showLocation?: boolean;
  showPriority?: boolean;
  showStatus?: boolean;
  showType?: boolean;
  showLink?: boolean;
  class?: string;
}

const {
  report,
  hrefBase = "/reports",
  compact = false,
  showDescription = true,
  showLocation = true,
  showPriority = true,
  showStatus = true,
  showType = true,
  showLink = true,
  class: className = "",
} = Astro.props;

/* -------------------------------------------------------------------------- */
/* Normalized data                                                            */
/* -------------------------------------------------------------------------- */

const title =
  report.title.trim() ||
  "Laporan lingkungan";

const description =
  report.description.trim() ||
  "Tidak ada deskripsi laporan.";

const areaName =
  report.location.areaName.trim() ||
  "Area tidak diketahui";

const address =
  report.location.address.trim() ||
  "Lokasi tidak diketahui";

const statusLabel =
  getReportStatusLabel(
    report.status,
  );

const priorityLabel =
  getReportPriorityLabel(
    report.priority,
  );

const typeLabel =
  getReportTypeLabel(
    report.type,
  );

const reportHref =
  `${hrefBase}/${encodeURIComponent(
    report.id,
  )}`;

const statusClass =
  getStatusClass(report.status);

const priorityClass =
  getPriorityClass(
    report.priority,
  );

const hasDescription =
  Boolean(description);

const hasLocation =
  Boolean(
    areaName ||
      address,
  );

/* -------------------------------------------------------------------------- */
/* Helpers                                                                    */
/* -------------------------------------------------------------------------- */

function getStatusClass(
  status: ReportStatus,
): string {
  switch (status) {
    case "pending":
      return "report-marker__status--pending";

    case "verified":
      return "report-marker__status--verified";

    case "in-progress":
      return "report-marker__status--progress";

    case "resolved":
      return "report-marker__status--resolved";

    case "rejected":
      return "report-marker__status--rejected";
  }
}

function getPriorityClass(
  priority: ReportPriority,
): string {
  switch (priority) {
    case "low":
      return "report-marker__priority--low";

    case "medium":
      return "report-marker__priority--medium";

    case "high":
      return "report-marker__priority--high";
  }
}

function formatDate(
  value: string,
): string {
  const date =
    new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return "Tanggal tidak tersedia";
  }

  return new Intl.DateTimeFormat(
    "id-ID",
    {
      day: "2-digit",
      month: "short",
      year: "numeric",
    },
  ).format(date);
}
---

<article
  class:list={[
    "report-marker",
    {
      "report-marker--compact":
        compact,
      "report-marker--linked":
        showLink,
    },
    className,
  ]}
  data-report-marker
  data-report-id={report.id}
>
  <div class="report-marker__main">
    <div
      class:list={[
        "report-marker__icon",
        statusClass,
      ]}
      aria-hidden="true"
    >
      {
        report.status === "pending" && (
          <Clock3
            size={19}
            stroke-width={1.9}
          />
        )
      }

      {
        report.status === "verified" && (
          <CheckCircle
            size={19}
            stroke-width={1.9}
          />
        )
      }

      {
        report.status === "in-progress" && (
          <ShieldAlert
            size={19}
            stroke-width={1.9}
          />
        )
      }

      {
        report.status === "resolved" && (
          <CheckCircle
            size={19}
            stroke-width={1.9}
          />
        )
      }

      {
        report.status === "rejected" && (
          <FileWarning
            size={19}
            stroke-width={1.9}
          />
        )
      }
    </div>

    <div class="report-marker__content">
      <div class="report-marker__heading">
        <div class="report-marker__title-row">
          <h3 class="report-marker__title">
            {title}
          </h3>

          {
            showStatus && (
              <span
                class:list={[
                  "report-marker__status",
                  statusClass,
                ]}
              >
                {statusLabel}
              </span>
            )
          }
        </div>

        {
          showType && (
            <span class="report-marker__type">
              {typeLabel}
            </span>
          )
        }
      </div>

      {
        !compact &&
        showDescription &&
        hasDescription && (
          <p class="report-marker__description">
            {description}
          </p>
        )
      }

      {
        !compact &&
        showLocation &&
        hasLocation && (
          <div class="report-marker__location">
            <MapPin
              size={13}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <span>
              {
                areaName &&
                address
                  ? `${areaName} · ${address}`
                  : areaName ||
                    address
              }
            </span>
          </div>
        )
      }

      {
        !compact && (
          <div class="report-marker__meta">
            <span>
              {formatDate(
                report.createdAt,
              )}
            </span>

            {
              showPriority && (
                <>
                  <span
                    class="report-marker__separator"
                    aria-hidden="true"
                  >
                    •
                  </span>

                  <span
                    class:list={[
                      "report-marker__priority",
                      priorityClass,
                    ]}
                  >
                    {
                      report.priority ===
                        "high" && (
                        <AlertTriangle
                          size={12}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      )
                    }

                    {priorityLabel}
                  </span>
                </>
              )
            }
          </div>
        )
      }
    </div>

    {
      compact && showLink && (
        <ChevronRight
          class="report-marker__compact-chevron"
          size={17}
          stroke-width={1.8}
          aria-hidden="true"
        />
      )
    }
  </div>

  {
    showLink && (
      <a
        class="report-marker__link"
        href={reportHref}
        aria-label={`Lihat detail laporan ${title}`}
      >
        <span>
          Lihat laporan
        </span>

        <ExternalLink
          size={13}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </a>
    )
  }
</article>

<style>
  .report-marker {
    width: min(
      100%,
      25rem
    );
    min-width: 0;
    overflow: hidden;
    border: 1px solid
      var(--color-border, #e2e8f0);
    border-radius: 0.9rem;
    background: var(
      --color-surface,
      #ffffff
    );
    color: var(
      --color-text,
      #0f172a
    );
    box-shadow:
      0 2px 6px
        rgb(15 23 42 / 0.06),
      0 12px 28px
        rgb(15 23 42 / 0.08);
  }

  .report-marker--linked {
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .report-marker--linked:hover {
    border-color: #bfdbfe;
    box-shadow:
      0 3px 8px
        rgb(15 23 42 / 0.08),
      0 15px 32px
        rgb(15 23 42 / 0.1);
    transform: translateY(
      -1px
    );
  }

  .report-marker__main {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.85rem;
  }

  .report-marker__icon {
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 2.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid
      #e2e8f0;
    border-radius: 0.7rem;
    background: #f8fafc;
    color: #64748b;
  }

  .report-marker__icon.report-marker__status--pending {
    border-color: #fde68a;
    background: #fffbeb;
    color: #b45309;
  }

  .report-marker__icon.report-marker__status--verified {
    border-color: #bbf7d0;
    background: #f0fdf4;
    color: #15803d;
  }

  .report-marker__icon.report-marker__status--progress {
    border-color: #bfdbfe;
    background: #eff6ff;
    color: #2563eb;
  }

  .report-marker__icon.report-marker__status--resolved {
    border-color: #bbf7d0;
    background: #f0fdf4;
    color: #166534;
  }

  .report-marker__icon.report-marker__status--rejected {
    border-color: #fecaca;
    background: #fef2f2;
    color: #b91c1c;
  }

  .report-marker__content {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .report-marker__heading {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .report-marker__title-row {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .report-marker__title {
    min-width: 0;
    flex: 1;
    margin: 0;
    overflow: hidden;
    color: #0f172a;
    font-size: 0.8rem;
    font-weight: 750;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .report-marker__status {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.58rem;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
  }

  .report-marker__status--pending {
    background: #fffbeb;
    color: #a16207;
    border-color: #fde68a;
  }

  .report-marker__status--verified {
    background: #ecfdf5;
    color: #15803d;
    border-color: #bbf7d0;
  }

  .report-marker__status--progress {
    background: #eff6ff;
    color: #1d4ed8;
    border-color: #bfdbfe;
  }

  .report-marker__status--resolved {
    background: #f0fdf4;
    color: #166534;
    border-color: #bbf7d0;
  }

  .report-marker__status--rejected {
    background: #fef2f2;
    color: #b91c1c;
    border-color: #fecaca;
  }

  .report-marker__type {
    overflow: hidden;
    color: #64748b;
    font-size: 0.62rem;
    font-weight: 650;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .report-marker__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: #475569;
    font-size: 0.68rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .report-marker__location {
    display: flex;
    align-items: flex-start;
    gap: 0.3rem;
    color: #64748b;
    font-size: 0.63rem;
    line-height: 1.45;
  }

  .report-marker__location svg {
    flex: 0 0 auto;
    margin-top: 0.05rem;
    color: #2563eb;
  }

  .report-marker__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
    color: #94a3b8;
    font-size: 0.62rem;
    line-height: 1.35;
  }

  .report-marker__separator {
    color: #cbd5e1;
  }

  .report-marker__priority {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
  }

  .report-marker__priority--low {
    color: #64748b;
  }

  .report-marker__priority--medium {
    color: #b45309;
  }

  .report-marker__priority--high {
    color: #b91c1c;
  }

  .report-marker__compact-chevron {
    flex: 0 0 auto;
    align-self: center;
    color: #94a3b8;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .report-marker--linked:hover
    .report-marker__compact-chevron {
    color: #2563eb;
    transform: translateX(
      2px
    );
  }

  .report-marker__link {
    min-height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    border-top: 1px solid
      #f1f5f9;
    color: #2563eb;
    font-size: 0.67rem;
    font-weight: 750;
    line-height: 1.3;
    text-decoration: none;
  }

  .report-marker__link:hover {
    background: #f8fafc;
  }

  .report-marker__link:focus-visible {
    outline: 3px solid
      rgb(37 99 235 / 0.18);
    outline-offset: -2px;
  }

  .report-marker--compact
    .report-marker__main {
    align-items: center;
    padding: 0.7rem;
  }

  .report-marker--compact
    .report-marker__icon {
    width: 2.1rem;
    height: 2.1rem;
    flex-basis: 2.1rem;
  }

  @media (max-width: 480px) {
    .report-marker {
      width: min(
        100%,
        21rem
      );
    }

    .report-marker__main {
      padding: 0.75rem;
    }

    .report-marker__title-row {
      flex-direction: column;
      gap: 0.3rem;
    }

    .report-marker__status {
      align-self: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .report-marker--linked,
    .report-marker__compact-chevron {
      transition: none;
    }
  }
</style>
