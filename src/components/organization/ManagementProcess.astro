---
/**
 * ============================================================================
 * BINSIGHT — MANAGEMENT PROCESS
 * ============================================================================
 */

import {
  ArrowRight,
  Check,
  Recycle,
} from "@lucide/astro";

import type {
  OrganizationProcess,
} from "@lib/data/organizations";

interface Props {
  processes?: OrganizationProcess[];
  title?: string;
  description?: string;
  compact?: boolean;
}

const {
  processes = [],
  title = "Proses Pengelolaan",
  description = "Tahapan pengelolaan material dan persampahan yang dilakukan oleh organisasi.",
  compact = false,
} = Astro.props;

const sortedProcesses = [...processes].sort(
  (a, b) => a.order - b.order,
);

const getProcessIcon = (process: OrganizationProcess) => {
  const text = `${process.name} ${process.description}`.toLocaleLowerCase();

  if (
    text.includes("olah") ||
    text.includes("proses") ||
    text.includes("material") ||
    text.includes("recycle")
  ) {
    return Recycle;
  }

  return Check;
};
---

<section
  class:list={[
    "management-process",
    compact && "management-process--compact",
  ]}
  aria-labelledby="management-process-title"
>
  <div class="management-process__header">
    <div>
      <h2 id="management-process-title">
        {title}
      </h2>

      {description && (
        <p>
          {description}
        </p>
      )}
    </div>

    {sortedProcesses.length > 0 && (
      <span class="management-process__count">
        {sortedProcesses.length} tahapan
      </span>
    )}
  </div>

  {sortedProcesses.length === 0 ? (
    <div class="management-process__empty">
      <div class="management-process__empty-icon" aria-hidden="true">
        <Recycle size={20} stroke-width="1.8" />
      </div>

      <div>
        <strong>Informasi proses belum tersedia</strong>
        <p>
          Detail tahapan pengelolaan belum ditambahkan oleh organisasi.
        </p>
      </div>
    </div>
  ) : (
    <ol class="management-process__list">
      {sortedProcesses.map((process, index) => {
        const Icon = getProcessIcon(process);
        const isLast = index === sortedProcesses.length - 1;

        return (
          <li class="management-process__item">
            <div class="management-process__step">
              <div
                class="management-process__icon"
                aria-hidden="true"
              >
                <Icon size={20} stroke-width="1.8" />
              </div>

              {!isLast && (
                <div
                  class="management-process__connector"
                  aria-hidden="true"
                ></div>
              )}
            </div>

            <div class="management-process__content">
              <div class="management-process__meta">
                <span>
                  Tahap {process.order}
                </span>
              </div>

              <h3>
                {process.name}
              </h3>

              {process.description && (
                <p>
                  {process.description}
                </p>
              )}
            </div>

            {!compact && !isLast && (
              <div
                class="management-process__arrow"
                aria-hidden="true"
              >
                <ArrowRight size={16} stroke-width="1.8" />
              </div>
            )}
          </li>
        );
      })}
    </ol>
  )}
</section>

<style>
  .management-process {
    width: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }

  .management-process__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .management-process__header h2 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .management-process__header p {
    max-width: 680px;
    margin: 0.45rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .management-process__count {
    flex: 0 0 auto;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-background);
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .management-process__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .management-process__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    gap: 1rem;
    min-width: 0;
    padding: 0 0 1.35rem;
  }

  .management-process__item:last-child {
    padding-bottom: 0;
  }

  .management-process__step {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .management-process__icon {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--color-primary-light);
    border-radius: 0.85rem;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .management-process__connector {
    position: absolute;
    top: 2.75rem;
    bottom: -0.1rem;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: var(--color-border);
  }

  .management-process__content {
    min-width: 0;
    padding-top: 0.1rem;
  }

  .management-process__meta {
    margin-bottom: 0.25rem;
  }

  .management-process__meta span {
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .management-process__content h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .management-process__content p {
    margin: 0.35rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .management-process__arrow {
    display: flex;
    align-items: center;
    padding-top: 0.5rem;
    color: var(--color-text-secondary);
  }

  .management-process__empty {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
  }

  .management-process__empty-icon {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 2.35rem;
    place-items: center;
    border-radius: 0.7rem;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .management-process__empty strong {
    display: block;
    color: var(--color-text);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .management-process__empty p {
    margin: 0.25rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .management-process--compact {
    padding: 1.2rem;
  }

  .management-process--compact .management-process__header {
    margin-bottom: 1.15rem;
  }

  @media (max-width: 640px) {
    .management-process {
      padding: 1.15rem;
    }

    .management-process__header {
      flex-direction: column;
      gap: 0.8rem;
    }

    .management-process__item {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.8rem;
    }

    .management-process__arrow {
      display: none;
    }

    .management-process__icon {
      width: 2.5rem;
      height: 2.5rem;
    }

    .management-process__connector {
      top: 2.5rem;
    }
  }
</style>