---
import {
  ArrowRight,
  Boxes,
  CircleCheck,
  Cpu,
  Leaf,
  Package,
  Recycle,
  TriangleAlert,
} from "@lucide/astro";

import {
  WASTE_CATEGORY,
  type WasteCategory,
} from "@lib/constants/waste";

import type { WasteItem } from "@lib/data/waste";
import type { Organization } from "@lib/data/organizations";

interface Props {
  organization?: Organization;
  waste?: WasteItem[];
  title?: string;
  subtitle?: string;
  compact?: boolean;
  showDescription?: boolean;
  showCategory?: boolean;
  showLink?: boolean;
  hrefBase?: string;
  emptyMessage?: string;
  limit?: number;
  class?: string;
}

const {
  organization,
  waste = [],
  title = "Sampah yang Dikelola",
  subtitle =
    "Kategori sampah yang tercatat dikelola oleh organisasi ini.",
  compact = false,
  showDescription = true,
  showCategory = true,
  showLink = true,
  hrefBase = "/waste",
  emptyMessage =
    "Belum ada kategori sampah yang tercatat.",
  limit,
  class: className = "",
} = Astro.props;

/* -------------------------------------------------------------------------- */
/* Resolve waste data                                                         */
/* -------------------------------------------------------------------------- */

/*
 * The organization model stores waste IDs/slugs in `wasteManaged`.
 * The component therefore accepts a resolved `waste` array as the safest
 * rendering source. When an organization is provided without resolved
 * waste items, the component gracefully renders an empty state instead of
 * guessing or manufacturing waste records.
 */
const organizationWasteIds =
  organization?.wasteManaged ?? [];

const hasResolvedWaste =
  waste.length > 0;

const sourceWaste =
  hasResolvedWaste
    ? waste
    : organizationWasteIds.length > 0
      ? []
      : [];

const visibleWaste =
  typeof limit === "number"
    ? sourceWaste.slice(
        0,
        Math.max(
          0,
          Math.trunc(limit),
        ),
      )
    : sourceWaste;

const categoryMeta: Record<
  WasteCategory,
  {
    label: string;
    icon:
      | "organic"
      | "inorganic"
      | "hazardous"
      | "electronic"
      | "residual";
    description: string;
  }
> = {
  [WASTE_CATEGORY.ORGANIC]: {
    label: "Organik",
    icon: "organic",
    description:
      "Material sampah yang berasal dari bahan hayati.",
  },

  [WASTE_CATEGORY.INORGANIC]: {
    label: "Anorganik",
    icon: "inorganic",
    description:
      "Material non-organik yang dapat dipilah dan dimanfaatkan.",
  },

  [WASTE_CATEGORY.HAZARDOUS]: {
    label: "B3",
    icon: "hazardous",
    description:
      "Material yang memerlukan penanganan khusus.",
  },

  [WASTE_CATEGORY.ELECTRONIC]: {
    label: "Elektronik",
    icon: "electronic",
    description:
      "Perangkat elektronik yang membutuhkan jalur pengelolaan yang sesuai.",
  },

  [WASTE_CATEGORY.RESIDUAL]: {
    label: "Residu",
    icon: "residual",
    description:
      "Material yang tersisa setelah proses pemilahan.",
  },
};

function getMeta(
  category: WasteCategory,
) {
  return (
    categoryMeta[category] ?? {
      label: "Kategori lainnya",
      icon: "residual" as const,
      description:
        "Kategori sampah BINSIGHT.",
    }
  );
}
---

<section
  class:list={[
    "waste-managed",
    {
      "waste-managed--compact":
        compact,
    },
    className,
  ]}
  aria-labelledby="waste-managed-title"
  data-waste-managed
>
  <header class="waste-managed__header">
    <div class="waste-managed__title-wrap">
      <span
        class="waste-managed__title-icon"
        aria-hidden="true"
      >
        <Recycle
          size={18}
          stroke-width={2}
        />
      </span>

      <div>
        <h2
          id="waste-managed-title"
          class="waste-managed__title"
        >
          {title}
        </h2>

        {
          subtitle && (
            <p class="waste-managed__subtitle">
              {subtitle}
            </p>
          )
        }
      </div>
    </div>

    {
      visibleWaste.length > 0 && (
        <span class="waste-managed__count">
          {visibleWaste.length} kategori
        </span>
      )
    }
  </header>

  {
    visibleWaste.length > 0 ? (
      <div
        class="waste-managed__grid"
        role="list"
        aria-label="Kategori sampah yang dikelola"
      >
        {visibleWaste.map((item) => {
          const meta =
            getMeta(item.category);

          const href =
            `${hrefBase}/${encodeURIComponent(
              item.slug,
            )}`;

          return (
            <article
              class="waste-managed__item"
              role="listitem"
              data-waste-id={item.id}
              data-waste-category={
                item.category
              }
            >
              <div class="waste-managed__item-top">
                <span
                  class:list={[
                    "waste-managed__icon",
                    `waste-managed__icon--${meta.icon}`,
                  ]}
                  aria-hidden="true"
                >
                  {
                    meta.icon ===
                      "organic" && (
                      <Leaf
                        size={19}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    meta.icon ===
                      "inorganic" && (
                      <Recycle
                        size={19}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    meta.icon ===
                      "hazardous" && (
                      <TriangleAlert
                        size={19}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    meta.icon ===
                      "electronic" && (
                      <Cpu
                        size={19}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    meta.icon ===
                      "residual" && (
                      <Package
                        size={19}
                        stroke-width={1.9}
                      />
                    )
                  }
                </span>

                <span
                  class="waste-managed__check"
                  aria-label="Kategori tercatat"
                  title="Kategori tercatat"
                >
                  <CircleCheck
                    size={14}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </span>
              </div>

              <div class="waste-managed__content">
                <div class="waste-managed__name-row">
                  <h3 class="waste-managed__name">
                    {item.name}
                  </h3>

                  {
                    showCategory && (
                      <span class="waste-managed__category">
                        {meta.label}
                      </span>
                    )
                  }
                </div>

                {
                  showDescription && (
                    <p class="waste-managed__description">
                      {
                        item.shortDescription ||
                        meta.description
                      }
                    </p>
                  )
                }
              </div>

              {
                showLink && (
                  <a
                    class="waste-managed__link"
                    href={href}
                    aria-label={`Lihat informasi ${item.name}`}
                  >
                    <span>
                      Lihat detail
                    </span>

                    <ArrowRight
                      size={14}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </a>
                )
              }
            </article>
          );
        })}
      </div>
    ) : (
      <div
        class="waste-managed__empty"
        role="status"
      >
        <span
          class="waste-managed__empty-icon"
          aria-hidden="true"
        >
          <Boxes
            size={22}
            stroke-width={1.8}
          />
        </span>

        <div>
          <strong>
            Belum ada data sampah
          </strong>

          <p>
            {emptyMessage}
          </p>

          {
            organizationWasteIds.length > 0 &&
              !hasResolvedWaste && (
                <span class="waste-managed__empty-note">
                  Data kategori tersedia pada profil,
                  tetapi belum di-resolve menjadi
                  detail sampah.
                </span>
              )
          }
        </div>
      </div>
    )
  }

  {
    visibleWaste.length > 0 &&
    limit !== undefined &&
    sourceWaste.length > visibleWaste.length && (
      <footer class="waste-managed__footer">
        <span>
          Menampilkan{" "}
          {visibleWaste.length} dari{" "}
          {sourceWaste.length} kategori.
        </span>

        <a
          href={hrefBase}
          class="waste-managed__view-all"
        >
          Lihat semua
          <ArrowRight
            size={14}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </a>
      </footer>
    )
  }
</section>

<style>
  /* ==========================================================================
     BINSIGHT // WASTE MANAGED
     Brutalist editorial system aligned with the BINSIGHT homepage.
     ========================================================================== */

  .waste-managed {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --white: #fffef8;
    --muted: #6c7068;
    --warning: #ff6a00;

    position: relative;
    min-width: 0;
    overflow: visible;
    color: var(--ink);
    background:
      repeating-linear-gradient(
        135deg,
        rgba(9, 10, 8, 0.025) 0 1px,
        transparent 1px 9px
      ),
      var(--paper);
    border: 3px solid var(--ink);
    border-radius: 0;
    box-shadow: 9px 9px 0 var(--ink);
  }

  .waste-managed::after {
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 72px;
    height: 72px;
    content: "";
    pointer-events: none;
    background: var(--warning);
    border: 3px solid var(--ink);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 25% 80%);
  }

  /* --------------------------------------------------------------------------
     HEADER
     -------------------------------------------------------------------------- */

  .waste-managed__header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    background: var(--ink);
    color: var(--white);
    border-bottom: 4px solid var(--acid);
  }

  .waste-managed__title-wrap {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .waste-managed__title-icon {
    width: 2.8rem;
    height: 2.8rem;
    flex: 0 0 2.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    background: var(--acid);
    border: 3px solid var(--ink);
    border-radius: 0;
    box-shadow: 5px 5px 0 var(--warning);
    transform: rotate(-3deg);
  }

  .waste-managed__title {
    margin: 0;
    color: var(--white);
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .waste-managed__subtitle {
    max-width: 44rem;
    margin: 0.42rem 0 0;
    color: #c6c8c0;
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .waste-managed__count {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.35rem 0.55rem;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    border-radius: 0;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* --------------------------------------------------------------------------
     GRID / ITEMS
     -------------------------------------------------------------------------- */

  .waste-managed__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 1rem 1.1rem 1.1rem;
  }

  .waste-managed__item {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 0.9rem;
    overflow: hidden;
    color: var(--white);
    background: var(--ink-2);
    border: 3px solid var(--white);
    border-radius: 0;
    box-shadow: 5px 5px 0 var(--ink);
    transition:
      transform 120ms steps(2, end),
      background 120ms linear,
      color 120ms linear,
      box-shadow 120ms steps(2, end);
  }

  .waste-managed__item:hover {
    color: var(--ink);
    background: var(--acid);
    box-shadow: 8px 8px 0 var(--warning);
    transform: translate(-3px, -3px);
  }

  .waste-managed__item:nth-child(2n) {
    transform: translateY(8px);
  }

  .waste-managed__item:nth-child(2n):hover {
    transform: translate(-3px, 5px);
  }

  .waste-managed__item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .waste-managed__icon {
    width: 2.9rem;
    height: 2.9rem;
    flex: 0 0 2.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--acid);
    background: transparent;
    border: 2px solid var(--acid);
    border-radius: 0;
    transform: rotate(-3deg);
    transition:
      transform 120ms steps(2, end),
      color 120ms linear,
      border-color 120ms linear,
      background 120ms linear;
  }

  .waste-managed__item:hover .waste-managed__icon {
    color: var(--ink);
    background: var(--white);
    border-color: var(--ink);
    transform: rotate(4deg) scale(1.05);
  }

  .waste-managed__icon--organic,
  .waste-managed__icon--inorganic,
  .waste-managed__icon--hazardous,
  .waste-managed__icon--electronic,
  .waste-managed__icon--residual {
    color: var(--acid);
    background: transparent;
  }

  .waste-managed__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    border-radius: 0;
    box-shadow: 3px 3px 0 var(--warning);
  }

  .waste-managed__content {
    min-width: 0;
    margin-top: 0.9rem;
  }

  .waste-managed__name-row {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding-bottom: 0.7rem;
    border-bottom: 2px solid currentColor;
  }

  .waste-managed__name {
    min-width: 0;
    width: 100%;
    margin: 0;
    overflow: hidden;
    color: inherit;
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: 1rem;
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .waste-managed__category {
    display: inline-flex;
    align-items: center;
    min-height: 1.35rem;
    padding: 0.25rem 0.45rem;
    color: var(--acid);
    background: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 0;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .waste-managed__item:hover .waste-managed__category {
    color: var(--white);
    background: var(--ink);
  }

  .waste-managed__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.65rem 0 0;
    color: #c6c8c0;
    font-size: 0.68rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .waste-managed__item:hover .waste-managed__description {
    color: var(--ink);
  }

  /* --------------------------------------------------------------------------
     LINKS
     -------------------------------------------------------------------------- */

  .waste-managed__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.9rem;
    padding-top: 0.65rem;
    color: var(--acid);
    border-top: 2px solid currentColor;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
  }

  .waste-managed__item:hover .waste-managed__link {
    color: var(--ink);
  }

  .waste-managed__link svg,
  .waste-managed__view-all svg {
    transition: transform 120ms steps(2, end);
  }

  .waste-managed__link:hover svg,
  .waste-managed__view-all:hover svg {
    transform: translateX(4px);
  }

  .waste-managed__link:focus-visible,
  .waste-managed__view-all:focus-visible {
    outline: 3px solid var(--acid);
    outline-offset: 4px;
  }

  /* --------------------------------------------------------------------------
     EMPTY STATE
     -------------------------------------------------------------------------- */

  .waste-managed__empty {
    position: relative;
    z-index: 1;
    min-height: 12rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 2rem 1.2rem;
    color: var(--ink);
    background: var(--paper-2);
  }

  .waste-managed__empty-icon {
    width: 3.4rem;
    height: 3.4rem;
    flex: 0 0 3.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    background: var(--acid);
    border: 3px solid var(--ink);
    border-radius: 0;
    box-shadow: 5px 5px 0 var(--warning);
  }

  .waste-managed__empty strong {
    display: block;
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .waste-managed__empty p {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .waste-managed__empty-note {
    display: inline-block;
    margin-top: 0.55rem;
    padding: 5px 7px;
    color: var(--acid);
    background: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* --------------------------------------------------------------------------
     FOOTER
     -------------------------------------------------------------------------- */

  .waste-managed__footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    color: var(--white);
    background: var(--ink);
    border-top: 4px solid var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .waste-managed__view-all {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 6px 8px;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--warning);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* --------------------------------------------------------------------------
     COMPACT MODE
     -------------------------------------------------------------------------- */

  .waste-managed--compact .waste-managed__header {
    padding: 0.8rem 0.9rem;
  }

  .waste-managed--compact .waste-managed__title-icon {
    width: 2.35rem;
    height: 2.35rem;
    flex-basis: 2.35rem;
  }

  .waste-managed--compact .waste-managed__grid {
    grid-template-columns: 1fr;
    padding: 0.8rem 0.9rem 0.95rem;
  }

  .waste-managed--compact .waste-managed__item {
    padding: 0.75rem;
  }

  .waste-managed--compact .waste-managed__item:nth-child(2n) {
    transform: none;
  }

  .waste-managed--compact .waste-managed__item:nth-child(2n):hover,
  .waste-managed--compact .waste-managed__item:hover {
    transform: translate(-3px, -3px);
  }

  .waste-managed--compact .waste-managed__description {
    display: none;
  }

  .waste-managed--compact .waste-managed__link {
    margin-top: 0.65rem;
    padding-top: 0.5rem;
  }

  /* --------------------------------------------------------------------------
     RESPONSIVE
     -------------------------------------------------------------------------- */

  @media (max-width: 760px) {
    .waste-managed__grid {
      grid-template-columns: 1fr;
    }

    .waste-managed__item:nth-child(2n) {
      transform: none;
    }

    .waste-managed__item:nth-child(2n):hover,
    .waste-managed__item:hover {
      transform: translate(-3px, -3px);
    }
  }

  @media (max-width: 480px) {
    .waste-managed {
      box-shadow: 6px 6px 0 var(--ink);
    }

    .waste-managed::after {
      width: 54px;
      height: 54px;
    }

    .waste-managed__header {
      flex-direction: column;
      padding: 0.9rem;
    }

    .waste-managed__count {
      align-self: flex-start;
    }

    .waste-managed__grid {
      padding: 0.8rem;
    }

    .waste-managed__item {
      padding: 0.75rem;
      box-shadow: 4px 4px 0 var(--ink);
    }

    .waste-managed__footer {
      align-items: flex-start;
      flex-direction: column;
      padding: 0.8rem 0.9rem;
    }

    .waste-managed__view-all {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .waste-managed__item,
    .waste-managed__icon,
    .waste-managed__link svg,
    .waste-managed__view-all svg {
      transition: none;
    }
  }
</style>
