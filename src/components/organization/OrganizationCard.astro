---
import {
  Building2,
  ChevronRight,
  ExternalLink,
  MapPin,
  Recycle,
} from "@lucide/astro";

import type {
  Organization,
  OrganizationType,
} from "@lib/data/organizations";

interface Props {
  organization: Organization;
  href?: string;
  featured?: boolean;
}

const {
  organization,
  href = `/organizations/${organization.slug}`,
  featured = false,
} = Astro.props;

const getOrganizationTypeLabel = (
  type: OrganizationType,
): string => {
  switch (type) {
    case "government":
      return "Pemerintah";
    case "community":
      return "Komunitas";
    case "private":
      return "Swasta";
    case "social-enterprise":
      return "Social Enterprise";
    case "cooperative":
      return "Koperasi";
    case "educational":
      return "Pendidikan";
    case "nonprofit":
      return "Nirlaba";
    case "other":
    default:
      return "Lainnya";
  }
};

const organizationTypeLabel =
  getOrganizationTypeLabel(organization.type);

const visibleWaste = organization.wasteManaged.slice(0, 3);

const remainingWaste =
  Math.max(
    0,
    organization.wasteManaged.length -
      visibleWaste.length,
  );
---

<article
  class:list={[
    "organization-card",
    featured && "organization-card--featured",
  ]}
>
  <a
    href={href}
    class="organization-card__link"
    aria-label={`Lihat profil ${organization.name}`}
  >
    <div class="organization-card__media">
      <div class="organization-card__logo">
        {organization.logo ? (
          <img
            src={organization.logo}
            alt={`Logo ${organization.name}`}
            loading="lazy"
          />
        ) : (
          <Building2
            size={30}
            stroke-width="1.8"
            aria-hidden="true"
          />
        )}
      </div>

      <span class="organization-card__type">
        {organizationTypeLabel}
      </span>

      {featured && (
        <span class="organization-card__featured">
          Unggulan
        </span>
      )}
    </div>

    <div class="organization-card__body">
      <div class="organization-card__heading">
        <div class="organization-card__name">
          <h3>{organization.name}</h3>

          {organization.shortName && (
            <span>{organization.shortName}</span>
          )}
        </div>

        {organization.verified && (
          <span class="organization-card__verified">
            Terverifikasi
          </span>
        )}
      </div>

      <p class="organization-card__description">
        {organization.shortDescription ??
          organization.description}
      </p>

      <div class="organization-card__location">
        <MapPin
          size={16}
          stroke-width="1.8"
          aria-hidden="true"
        />
        <span>{organization.location.area}</span>
      </div>

      {organization.location.address && (
        <p class="organization-card__address">
          {organization.location.address}
        </p>
      )}

      {visibleWaste.length > 0 && (
        <div class="organization-card__waste">
          <div class="organization-card__waste-title">
            <Recycle
              size={15}
              stroke-width="1.8"
              aria-hidden="true"
            />
            <span>Sampah yang dikelola</span>
          </div>

          <div class="organization-card__tags">
            {visibleWaste.map((category) => (
              <span class="organization-card__tag">
                {category}
              </span>
            ))}

            {remainingWaste > 0 && (
              <span class="organization-card__tag organization-card__tag--muted">
                +{remainingWaste}
              </span>
            )}
          </div>
        </div>
      )}

      <div class="organization-card__footer">
        <span>Lihat profil organisasi</span>

        <ChevronRight
          size={17}
          stroke-width="1.8"
          aria-hidden="true"
        />
      </div>
    </div>
  </a>

  <a
    href={href}
    class="organization-card__external"
    aria-label={`Buka halaman ${organization.name}`}
  >
    <ExternalLink
      size={15}
      stroke-width="1.8"
      aria-hidden="true"
    />
  </a>
</article>

<style>
  /* ==========================================================================
     BINSIGHT // ORGANIZATION CARD
     Shared visual language:
     - Brutalist / editorial environmental intelligence
     - Hard edges, thick borders, offset shadows
     - Acid lime + black + paper + warning orange
     - Mono technical labels
     ========================================================================== */

  .organization-card {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --warning: #ff6a00;

    position: relative;
    height: 100%;
    overflow: visible;
    color: var(--ink);
    background: var(--white);
    border: 3px solid var(--ink);
    border-radius: 0;
    box-shadow: 8px 8px 0 var(--ink);
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .organization-card:hover {
    background: var(--acid);
    border-color: var(--ink);
    box-shadow: 12px 12px 0 var(--warning);
    transform: translate(-4px, -4px);
  }

  .organization-card:focus-within {
    outline: 4px solid var(--acid);
    outline-offset: 5px;
  }

  .organization-card--featured {
    box-shadow: 10px 10px 0 var(--warning);
  }

  .organization-card--featured::before {
    position: absolute;
    top: -10px;
    right: 16px;
    z-index: 3;
    width: 54px;
    height: 10px;
    content: "";
    background: var(--acid);
    border: 3px solid var(--ink);
    border-bottom: 0;
  }

  .organization-card__link {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* --------------------------------------------------------------------------
     MEDIA / IDENTITY
     -------------------------------------------------------------------------- */

  .organization-card__media {
    position: relative;
    display: grid;
    min-height: 11rem;
    place-items: center;
    padding: 1.5rem;
    overflow: hidden;
    background:
      linear-gradient(
        rgba(255, 255, 255, 0.05) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.05) 2px,
        transparent 2px
      ),
      var(--ink-2);
    background-size: 28px 28px;
    border-bottom: 3px solid var(--ink);
  }

  .organization-card__media::before {
    position: absolute;
    inset: 12px;
    content: "";
    pointer-events: none;
    border: 2px solid rgba(223, 255, 0, 0.45);
    transform: rotate(-2deg);
  }

  .organization-card:hover .organization-card__media {
    background:
      linear-gradient(
        rgba(9, 10, 8, 0.07) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(9, 10, 8, 0.07) 2px,
        transparent 2px
      ),
      var(--acid);
    background-size: 28px 28px;
  }

  .organization-card__logo {
    position: relative;
    z-index: 1;
    display: grid;
    width: 5.5rem;
    height: 5.5rem;
    place-items: center;
    overflow: hidden;
    color: var(--acid);
    background: var(--ink);
    border: 3px solid var(--white);
    border-radius: 0;
    box-shadow: 7px 7px 0 var(--warning);
    transform: rotate(-3deg);
    transition:
      transform 120ms steps(2, end),
      background 120ms linear,
      color 120ms linear;
  }

  .organization-card:hover .organization-card__logo {
    color: var(--ink);
    background: var(--white);
    transform: rotate(3deg) scale(1.04);
  }

  .organization-card__logo img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0.75rem;
    object-fit: contain;
    background: var(--white);
  }

  .organization-card__type,
  .organization-card__featured {
    position: absolute;
    top: 12px;
    z-index: 2;
    padding: 6px 8px;
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 0;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .organization-card__type {
    left: 12px;
    background: var(--white);
  }

  .organization-card__featured {
    right: 12px;
    background: var(--acid);
    box-shadow: 4px 4px 0 var(--warning);
  }

  /* --------------------------------------------------------------------------
     BODY / INFORMATION
     -------------------------------------------------------------------------- */

  .organization-card__body {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    padding: 1.15rem;
    background:
      repeating-linear-gradient(
        135deg,
        rgba(9, 10, 8, 0.025) 0 1px,
        transparent 1px 9px
      ),
      var(--white);
  }

  .organization-card:hover .organization-card__body {
    background:
      repeating-linear-gradient(
        135deg,
        rgba(9, 10, 8, 0.035) 0 1px,
        transparent 1px 9px
      ),
      var(--acid);
  }

  .organization-card__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.8rem;
    border-bottom: 3px solid var(--ink);
  }

  .organization-card__name {
    min-width: 0;
  }

  .organization-card__name h3 {
    margin: 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .organization-card__name span {
    display: inline-block;
    margin-top: 0.45rem;
    padding: 4px 6px;
    color: var(--acid);
    background: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .organization-card__verified {
    flex: 0 0 auto;
    padding: 5px 7px;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    border-radius: 0;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .organization-card__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.85rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .organization-card:hover .organization-card__description {
    color: var(--ink);
  }

  .organization-card__location {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    padding-top: 0.8rem;
    color: var(--ink);
    border-top: 2px solid var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .organization-card__location svg {
    flex: 0 0 auto;
    color: var(--warning);
  }

  .organization-card__address {
    margin: 0.4rem 0 0;
    padding-left: 21px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  /* --------------------------------------------------------------------------
     WASTE TAGS
     -------------------------------------------------------------------------- */

  .organization-card__waste {
    margin-top: 1rem;
    padding: 0.8rem;
    color: var(--ink);
    background: var(--paper-2);
    border: 2px solid var(--ink);
  }

  .organization-card:hover .organization-card__waste {
    background: var(--white);
  }

  .organization-card__waste-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.55rem;
    color: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .organization-card__waste-title svg {
    color: var(--warning);
  }

  .organization-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .organization-card__tag {
    padding: 5px 7px;
    color: var(--ink);
    background: var(--white);
    border: 2px solid var(--ink);
    border-radius: 0;
    font-size: 9px;
    font-weight: 800;
    line-height: 1.1;
  }

  .organization-card__tag--muted {
    color: var(--acid);
    background: var(--ink);
  }

  /* --------------------------------------------------------------------------
     FOOTER / ACTION
     -------------------------------------------------------------------------- */

  .organization-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--ink);
    border-top: 3px solid var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .organization-card__footer svg {
    transition: transform 120ms steps(2, end);
  }

  .organization-card:hover .organization-card__footer svg {
    transform: translateX(4px);
  }

  .organization-card__external {
    position: absolute;
    right: -8px;
    bottom: -8px;
    z-index: 4;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    color: var(--ink);
    background: var(--acid);
    border: 3px solid var(--ink);
    border-radius: 0;
    box-shadow: 4px 4px 0 var(--warning);
    opacity: 0;
    transform: rotate(3deg);
    transition:
      opacity 120ms linear,
      transform 120ms steps(2, end),
      background 120ms linear;
  }

  .organization-card:hover .organization-card__external,
  .organization-card:focus-within .organization-card__external {
    opacity: 1;
    transform: rotate(-3deg);
  }

  .organization-card__external:hover {
    background: var(--white);
    transform: rotate(0deg) scale(1.06);
  }

  /* --------------------------------------------------------------------------
     RESPONSIVE
     -------------------------------------------------------------------------- */

  @media (max-width: 640px) {
    .organization-card {
      box-shadow: 6px 6px 0 var(--ink);
    }

    .organization-card:hover {
      box-shadow: 9px 9px 0 var(--warning);
      transform: translate(-3px, -3px);
    }

    .organization-card__media {
      min-height: 9rem;
    }

    .organization-card__logo {
      width: 4.75rem;
      height: 4.75rem;
    }

    .organization-card__body {
      padding: 1rem;
    }

    .organization-card__heading {
      flex-direction: column;
      gap: 0.6rem;
    }

    .organization-card__name h3 {
      font-size: 1.25rem;
    }

    .organization-card__external {
      right: 8px;
      bottom: 8px;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .organization-card,
    .organization-card__logo,
    .organization-card__footer svg,
    .organization-card__external {
      transition: none;
    }
  }
</style>