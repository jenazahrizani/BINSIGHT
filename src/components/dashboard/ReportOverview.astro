---
import {
  AlertTriangle,
  BarChart3,
  CheckCircle,
  ChevronRight,
  CircleDot,
  Clock3,
  FileText,
  LoaderCircle,
  XCircle,
} from "@lucide/astro";

import {
  getReportCountByStatus,
  getRecentPublicReports,
  getReportStatusLabel,
  getReportPriorityLabel,
  getReportTypeLabel,
  type Report,
  type ReportStatus,
} from "@lib/data/reports";

interface Props {
  title?: string;
  subtitle?: string;
  reports?: Report[];
  limit?: number;
  showSummary?: boolean;
  showType?: boolean;
  showPriority?: boolean;
  showArea?: boolean;
  hrefBase?: string;
  emptyMessage?: string;
}

const {
  title = "Ikhtisar Laporan",
  subtitle =
    "Ringkasan laporan lingkungan terbaru yang tercatat dalam BINSIGHT.",
  reports,
  limit = 5,
  showSummary = true,
  showType = true,
  showPriority = true,
  showArea = true,
  hrefBase = "/reports",
  emptyMessage =
    "Belum ada laporan yang dapat ditampilkan.",
} = Astro.props;

/* -------------------------------------------------------------------------- */
/* Data                                                                       */
/* -------------------------------------------------------------------------- */

const sourceReports =
  reports ??
  getRecentPublicReports(
    Math.max(0, Math.trunc(limit)),
  );

const visibleReports =
  sourceReports.slice(
    0,
    Math.max(0, Math.trunc(limit)),
  );

const statusCounts =
  getReportCountByStatus();

const totalReports =
  Object.values(statusCounts).reduce(
    (total, count) =>
      total + count,
    0,
  );

const publicStatusCounts = {
  pending:
    statusCounts.pending,
  verified:
    statusCounts.verified,
  "in-progress":
    statusCounts["in-progress"],
  resolved:
    statusCounts.resolved,
};

const activeReportCount =
  publicStatusCounts.pending +
  publicStatusCounts.verified +
  publicStatusCounts["in-progress"];

const resolvedReportCount =
  publicStatusCounts.resolved;

const summaryItems: Array<{
  status: ReportStatus;
  label: string;
  count: number;
  tone:
    | "pending"
    | "verified"
    | "progress"
    | "resolved";
  icon:
    | "clock"
    | "check"
    | "progress"
    | "resolved";
}> = [
  {
    status: "pending",
    label: "Menunggu",
    count: publicStatusCounts.pending,
    tone: "pending",
    icon: "clock",
  },
  {
    status: "verified",
    label: "Terverifikasi",
    count: publicStatusCounts.verified,
    tone: "verified",
    icon: "check",
  },
  {
    status: "in-progress",
    label: "Dalam proses",
    count:
      publicStatusCounts["in-progress"],
    tone: "progress",
    icon: "progress",
  },
  {
    status: "resolved",
    label: "Selesai",
    count:
      publicStatusCounts.resolved,
    tone: "resolved",
    icon: "resolved",
  },
];

function formatCount(
  value: number,
): string {
  return value.toLocaleString(
    "id-ID",
  );
}

function formatDate(
  value: string,
): string {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "Tanggal tidak tersedia";
  }

  return new Intl.DateTimeFormat(
    "id-ID",
    {
      day: "2-digit",
      month: "short",
      year: "numeric",
    },
  ).format(date);
}

function getPriorityClass(
  priority: Report["priority"],
): string {
  return `report-overview__priority--${priority}`;
}

function getStatusClass(
  status: ReportStatus,
): string {
  switch (status) {
    case "pending":
      return "report-overview__status--pending";

    case "verified":
      return "report-overview__status--verified";

    case "in-progress":
      return "report-overview__status--progress";

    case "resolved":
      return "report-overview__status--resolved";

    case "rejected":
      return "report-overview__status--rejected";
  }
}
---

<section
  class="report-overview"
  aria-labelledby="report-overview-title"
>
  <header
    class="report-overview__header"
  >
    <div class="report-overview__heading">
      <div
        class="report-overview__title-row"
      >
        <span
          class="report-overview__title-icon"
          aria-hidden="true"
        >
          <BarChart3
            size={18}
            stroke-width={2}
          />
        </span>

        <div>
          <h2
            id="report-overview-title"
            class="report-overview__title"
          >
            {title}
          </h2>

          {
            subtitle && (
              <p class="report-overview__subtitle">
                {subtitle}
              </p>
            )
          }
        </div>
      </div>
    </div>

    <a
      class="report-overview__view-all"
      href={hrefBase}
    >
      Lihat semua
      <ChevronRight
        size={15}
        stroke-width={2}
        aria-hidden="true"
      />
    </a>
  </header>

  {
    showSummary && (
      <div
        class="report-overview__summary"
        aria-label="Ringkasan status laporan"
      >
        {
          summaryItems.map(
            ({
              status,
              label,
              count,
              tone,
              icon,
            }) => (
              <a
                class:list={[
                  "report-overview__summary-item",
                  `report-overview__summary-item--${tone}`,
                ]}
                href={`${hrefBase}?status=${status}`}
                aria-label={`${label}: ${formatCount(
                  count,
                )} laporan`}
              >
                <span
                  class="report-overview__summary-icon"
                  aria-hidden="true"
                >
                  {
                    icon === "clock" && (
                      <Clock3
                        size={16}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    icon === "check" && (
                      <CheckCircle
                        size={16}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    icon === "progress" && (
                      <LoaderCircle
                        size={16}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    icon === "resolved" && (
                      <CheckCircle
                        size={16}
                        stroke-width={1.9}
                      />
                    )
                  }
                </span>

                <span class="report-overview__summary-copy">
                  <span class="report-overview__summary-label">
                    {label}
                  </span>

                  <strong>
                    {formatCount(count)}
                  </strong>
                </span>
              </a>
            ),
          )
        }
      </div>
    )
  }

  {
    visibleReports.length > 0 ? (
      <div
        class="report-overview__list"
        role="list"
        aria-label="Laporan terbaru"
      >
        {visibleReports.map(
          (report) => (
            <article
              class="report-overview__item"
              role="listitem"
            >
              <a
                class="report-overview__item-link"
                href={`${hrefBase}/${report.id}`}
                aria-label={`Buka laporan ${report.title}`}
              >
                <span
                  class="report-overview__item-icon"
                  aria-hidden="true"
                >
                  {
                    report.status ===
                      "pending" && (
                      <Clock3
                        size={18}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    report.status ===
                      "verified" && (
                      <CheckCircle
                        size={18}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    report.status ===
                      "in-progress" && (
                      <LoaderCircle
                        size={18}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    report.status ===
                      "resolved" && (
                      <CheckCircle
                        size={18}
                        stroke-width={1.9}
                      />
                    )
                  }

                  {
                    report.status ===
                      "rejected" && (
                      <XCircle
                        size={18}
                        stroke-width={1.9}
                      />
                    )
                  }
                </span>

                <span class="report-overview__item-content">
                  <span class="report-overview__item-top">
                    <strong class="report-overview__item-title">
                      {report.title}
                    </strong>

                    <span
                      class:list={[
                        "report-overview__status",
                        getStatusClass(
                          report.status,
                        ),
                      ]}
                    >
                      {getReportStatusLabel(
                        report.status,
                      )}
                    </span>
                  </span>

                  <span class="report-overview__item-description">
                    {report.description}
                  </span>

                  <span class="report-overview__item-meta">
                    <span>
                      {formatDate(
                        report.createdAt,
                      )}
                    </span>

                    {
                      showType && (
                        <>
                          <span
                            class="report-overview__meta-separator"
                            aria-hidden="true"
                          >
                            •
                          </span>

                          <span>
                            {getReportTypeLabel(
                              report.type,
                            )}
                          </span>
                        </>
                      )
                    }

                    {
                      showArea && (
                        <>
                          <span
                            class="report-overview__meta-separator"
                            aria-hidden="true"
                          >
                            •
                          </span>

                          <span>
                            {report.location.areaName}
                          </span>
                        </>
                      )
                    }
                  </span>
                </span>

                <ChevronRight
                  class="report-overview__item-chevron"
                  size={17}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </a>

              {
                showPriority && (
                  <div class="report-overview__item-footer">
                    <span
                      class:list={[
                        "report-overview__priority",
                        getPriorityClass(
                          report.priority,
                        ),
                      ]}
                    >
                      {
                        report.priority ===
                          "high" && (
                          <AlertTriangle
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        )
                      }

                      {
                        report.priority ===
                          "medium" && (
                          <CircleDot
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        )
                      }

                      {
                        report.priority ===
                          "low" && (
                          <CircleDot
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        )
                      }

                      <span>
                        Prioritas{" "}
                        {getReportPriorityLabel(
                          report.priority,
                        )}
                      </span>
                    </span>
                  </div>
                )
              }
            </article>
          ),
        )}
      </div>
    ) : (
      <div
        class="report-overview__empty"
        role="status"
      >
        <span
          class="report-overview__empty-icon"
          aria-hidden="true"
        >
          <FileText
            size={22}
            stroke-width={1.8}
          />
        </span>

        <div>
          <strong>
            Belum ada laporan
          </strong>

          <p>
            {emptyMessage}
          </p>
        </div>
      </div>
    )
  }

  <footer
    class="report-overview__footer"
    aria-label="Ringkasan keseluruhan laporan"
  >
    <div class="report-overview__footer-stat">
      <span class="report-overview__footer-label">
        Total laporan
      </span>

      <strong>
        {formatCount(totalReports)}
      </strong>
    </div>

    <div class="report-overview__footer-stat">
      <span class="report-overview__footer-label">
        Aktif
      </span>

      <strong>
        {formatCount(activeReportCount)}
      </strong>
    </div>

    <div class="report-overview__footer-stat">
      <span class="report-overview__footer-label">
        Selesai
      </span>

      <strong>
        {formatCount(resolvedReportCount)}
      </strong>
    </div>
  </footer>
</section>

<style>
  .report-overview {
    min-width: 0;
    overflow: hidden;
    border: 1px solid
      var(--color-border, #e2e8f0);
    border-radius: 1rem;
    background: var(
      --color-surface,
      #ffffff
    );
    box-shadow:
      0 1px 2px
        rgb(15 23 42 / 0.03),
      0 8px 24px
        rgb(15 23 42 / 0.04);
  }

  .report-overview__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    border-bottom: 1px solid
      var(--color-border, #e2e8f0);
  }

  .report-overview__title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .report-overview__title-icon {
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.7rem;
    background: var(
      --color-primary-light,
      #dcfce7
    );
    color: var(
      --color-primary,
      #166534
    );
  }

  .report-overview__title {
    margin: 0;
    color: var(
      --color-text,
      #0f172a
    );
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .report-overview__subtitle {
    max-width: 44rem;
    margin: 0.25rem 0 0;
    color: var(
      --color-text-secondary,
      #64748b
    );
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .report-overview__view-all {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    color: var(
      --color-primary,
      #166534
    );
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .report-overview__view-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .report-overview__view-all:focus-visible {
    outline: 3px solid
      rgb(37 99 235 / 0.18);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .report-overview__summary {
    display: grid;
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid
      #f1f5f9;
  }

  .report-overview__summary-item {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.7rem;
    border: 1px solid
      #e2e8f0;
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
    background: #ffffff;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .report-overview__summary-item:hover {
    border-color: rgb(22 101 52 / 0.24);
    background: #f8fafc;
    transform: translateY(-1px);
  }

  .report-overview__summary-item:focus-visible {
    outline: 3px solid
      rgb(37 99 235 / 0.18);
    outline-offset: 2px;
  }

  .report-overview__summary-icon {
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.6rem;
  }

  .report-overview__summary-item--pending
    .report-overview__summary-icon {
    background: #fffbeb;
    color: #b45309;
  }

  .report-overview__summary-item--verified
    .report-overview__summary-icon {
    background: #ecfdf5;
    color: #15803d;
  }

  .report-overview__summary-item--progress
    .report-overview__summary-icon {
    background: #eff6ff;
    color: #2563eb;
  }

  .report-overview__summary-item--resolved
    .report-overview__summary-icon {
    background: #f0fdf4;
    color: #166534;
  }

  .report-overview__summary-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .report-overview__summary-label {
    overflow: hidden;
    color: #64748b;
    font-size: 0.6875rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .report-overview__summary-copy strong {
    color: #0f172a;
    font-size: 0.95rem;
    font-weight: 750;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .report-overview__list {
    display: flex;
    flex-direction: column;
  }

  .report-overview__item {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid
      #f1f5f9;
  }

  .report-overview__item:last-child {
    border-bottom: 0;
  }

  .report-overview__item-link {
    display: grid;
    grid-template-columns:
      auto
      minmax(0, 1fr)
      auto;
    align-items: start;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .report-overview__item-icon {
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.7rem;
    background: #f8fafc;
    color: var(
      --color-primary,
      #166534
    );
    border: 1px solid
      #e2e8f0;
  }

  .report-overview__item-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .report-overview__item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .report-overview__item-title {
    min-width: 0;
    overflow: hidden;
    color: #0f172a;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .report-overview__status {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .report-overview__status--pending {
    background: #fffbeb;
    color: #a16207;
    border-color: #fde68a;
  }

  .report-overview__status--verified {
    background: #ecfdf5;
    color: #15803d;
    border-color: #bbf7d0;
  }

  .report-overview__status--progress {
    background: #eff6ff;
    color: #1d4ed8;
    border-color: #bfdbfe;
  }

  .report-overview__status--resolved {
    background: #f0fdf4;
    color: #166534;
    border-color: #bbf7d0;
  }

  .report-overview__status--rejected {
    background: #fef2f2;
    color: #b91c1c;
    border-color: #fecaca;
  }

  .report-overview__item-description {
    display: -webkit-box;
    overflow: hidden;
    color: #64748b;
    font-size: 0.75rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .report-overview__item-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: #94a3b8;
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .report-overview__meta-separator {
    color: #cbd5e1;
  }

  .report-overview__item-chevron {
    margin-top: 0.35rem;
    color: #94a3b8;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .report-overview__item-link:hover
    .report-overview__item-chevron {
    color: var(
      --color-primary,
      #166534
    );
    transform: translateX(2px);
  }

  .report-overview__item-link:focus-visible {
    outline: 3px solid
      rgb(37 99 235 / 0.18);
    outline-offset: 3px;
    border-radius: 0.5rem;
  }

  .report-overview__item-footer {
    margin-top: 0.65rem;
    margin-left: 3rem;
  }

  .report-overview__priority {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.625rem;
    font-weight: 700;
  }

  .report-overview__priority--low {
    color: #64748b;
  }

  .report-overview__priority--medium {
    color: #b45309;
  }

  .report-overview__priority--high {
    color: #b91c1c;
  }

  .report-overview__empty {
    min-height: 13rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1.25rem;
    color: #64748b;
  }

  .report-overview__empty-icon {
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #94a3b8;
  }

  .report-overview__empty strong {
    display: block;
    color: #334155;
    font-size: 0.8125rem;
  }

  .report-overview__empty p {
    margin: 0.2rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .report-overview__footer {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    border-top: 1px solid
      var(--color-border, #e2e8f0);
    background: #fafafa;
  }

  .report-overview__footer-stat {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.875rem 1.25rem;
  }

  .report-overview__footer-stat
    + .report-overview__footer-stat {
    border-left: 1px solid
      var(--color-border, #e2e8f0);
  }

  .report-overview__footer-label {
    color: #64748b;
    font-size: 0.6875rem;
    line-height: 1.3;
  }

  .report-overview__footer-stat strong {
    color: #0f172a;
    font-size: 0.95rem;
    font-weight: 750;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .report-overview__summary {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .report-overview__header {
      padding: 1rem;
    }

    .report-overview__summary {
      padding: 0.875rem 1rem;
    }

    .report-overview__item {
      padding: 0.875rem 1rem;
    }

    .report-overview__item-top {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }

    .report-overview__status {
      align-self: flex-start;
    }

    .report-overview__item-footer {
      margin-left: 3rem;
    }

    .report-overview__footer-stat {
      padding-inline: 1rem;
    }
  }

  @media (max-width: 420px) {
    .report-overview__summary {
      grid-template-columns: 1fr;
    }

    .report-overview__item-description {
      -webkit-line-clamp: 3;
    }

    .report-overview__footer {
      grid-template-columns: 1fr;
