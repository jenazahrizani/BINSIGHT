---
/**
 * ============================================================================
 * BINSIGHT — RELATED ORGANIZATIONS
 * ============================================================================
 * Badung Waste Intelligence
 *
 * Menampilkan organisasi yang berkaitan dengan pengelolaan material / sampah.
 *
 * Prinsip:
 * - Tidak mengarang volume atau kapasitas pengelolaan.
 * - Hanya menampilkan informasi yang tersedia pada data organisasi.
 * - Tidak melakukan fetch Firebase.
 * - Dapat digunakan pada halaman detail waste.
 * - Responsive, accessible, dan ringan.
 * ============================================================================
 */

import {
  ArrowRight,
  Building2,
  Check,
  MapPin,
  Recycle,
} from "@lucide/astro";

import type {
  Organization,
} from "@lib/data/organizations";

interface Props {
  organizations: Organization[];
  title?: string;
  description?: string;
  limit?: number;
  compact?: boolean;
  emptyMessage?: string;
}

const {
  organizations,
  title = "Organisasi Terkait",
  description = "Organisasi yang tercatat memiliki keterkaitan dengan pengelolaan material atau kategori sampah ini.",
  limit = 4,
  compact = false,
  emptyMessage = "Belum ada organisasi terkait yang tersedia.",
} = Astro.props;

const normalizedLimit =
  Number.isFinite(limit) && limit > 0
    ? Math.floor(limit)
    : 4;

const visibleOrganizations =
  organizations
    .filter(
      (organization) =>
        organization.isPublic &&
        organization.verified &&
        organization.status === "verified",
    )
    .slice(0, normalizedLimit);

const getOrganizationTypeLabel = (
  type: Organization["type"],
): string => {
  switch (type) {
    case "government":
      return "Pemerintah";

    case "community":
      return "Komunitas";

    case "private":
      return "Swasta";

    case "social-enterprise":
      return "Social Enterprise";

    case "cooperative":
      return "Koperasi";

    case "educational":
      return "Pendidikan";

    case "nonprofit":
      return "Nirlaba";

    case "other":
    default:
      return "Lainnya";
  }
};
---

<section
  class:list={[
    "related-organizations",
    compact && "related-organizations--compact",
  ]}
  aria-labelledby="related-organizations-title"
>
  <header class="related-organizations__header">
    <div>
      <span class="related-organizations__eyebrow">
        Ekosistem BINSIGHT
      </span>

      <h2 id="related-organizations-title">
        {title}
      </h2>

      {description && (
        <p>
          {description}
        </p>
      )}
    </div>

    {visibleOrganizations.length > 0 && (
      <span class="related-organizations__count">
        {visibleOrganizations.length}
        {visibleOrganizations.length === 1
          ? " organisasi"
          : " organisasi"}
      </span>
    )}
  </header>

  {visibleOrganizations.length === 0 ? (
    <div class="related-organizations__empty">
      <div
        class="related-organizations__empty-icon"
        aria-hidden="true"
      >
        <Building2
          size={22}
          stroke-width="1.8"
        />
      </div>

      <div>
        <strong>
          Belum ada organisasi terkait
        </strong>

        <p>
          {emptyMessage}
        </p>
      </div>
    </div>
  ) : (
    <div class="related-organizations__grid">
      {visibleOrganizations.map((organization) => {
        const organizationTypeLabel =
          getOrganizationTypeLabel(
            organization.type,
          );

        const visibleWaste =
          organization.wasteManaged.slice(
            0,
            compact ? 2 : 3,
          );

        const remainingWaste =
          Math.max(
            0,
            organization.wasteManaged.length -
              visibleWaste.length,
          );

        return (
          <article
            class="related-organizations__card"
          >
            <a
              href={`/organizations/${organization.slug}`}
              class="related-organizations__card-link"
              aria-label={`Lihat profil ${organization.name}`}
            >
              <div class="related-organizations__card-top">
                <div class="related-organizations__logo">
                  {organization.logo ? (
                    <img
                      src={organization.logo}
                      alt={`Logo ${organization.name}`}
                      loading="lazy"
                    />
                  ) : (
                    <Building2
                      size={
                        compact ? 22 : 26
                      }
                      stroke-width="1.8"
                      aria-hidden="true"
                    />
                  )}
                </div>

                <div class="related-organizations__identity">
                  <span class="related-organizations__type">
                    {organizationTypeLabel}
                  </span>

                  <h3>
                    {organization.name}
                  </h3>

                  {organization.shortName && (
                    <span class="related-organizations__short-name">
                      {organization.shortName}
                    </span>
                  )}
                </div>

                <span
                  class="related-organizations__arrow"
                  aria-hidden="true"
                >
                  <ArrowRight
                    size={16}
                    stroke-width="1.8"
                  />
                </span>
              </div>

              <p class="related-organizations__description">
                {organization.shortDescription ??
                  organization.description}
              </p>

              <div class="related-organizations__location">
                <MapPin
                  size={15}
                  stroke-width="1.8"
                  aria-hidden="true"
                />

                <span>
                  {organization.location.area}
                </span>
              </div>

              {organization.location.address && (
                <p class="related-organizations__address">
                  {organization.location.address}
                </p>
              )}

              {visibleWaste.length > 0 && (
                <div class="related-organizations__waste">
                  <div class="related-organizations__waste-label">
                    <Recycle
                      size={14}
                      stroke-width="1.8"
                      aria-hidden="true"
                    />

                    <span>
                      Material dikelola
                    </span>
                  </div>

                  <div class="related-organizations__tags">
                    {visibleWaste.map(
                      (category) => (
                        <span class="related-organizations__tag">
                          <Check
                            size={11}
                            stroke-width="2"
                            aria-hidden="true"
                          />

                          {category}
                        </span>
                      ),
                    )}

                    {remainingWaste > 0 && (
                      <span class="related-organizations__tag related-organizations__tag--muted">
                        +{remainingWaste}
                      </span>
                    )}
                  </div>
                </div>
              )}

              <div class="related-organizations__footer">
                <span>
                  Lihat profil
                </span>

                <ArrowRight
                  size={15}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
              </div>
            </a>
          </article>
        );
      })}
    </div>
  )}
</section>

<style>
  .related-organizations {
    width: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }

  .related-organizations__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1.35rem;
  }

  .related-organizations__eyebrow {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-primary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-organizations__header h2 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.2rem;
    font-weight: 750;
    line-height: 1.3;
  }

  .related-organizations__header p {
    max-width: 720px;
    margin: 0.4rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .related-organizations__count {
    flex: 0 0 auto;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-background);
    color: var(--color-text-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .related-organizations__grid {
    display: grid;
    grid-template-columns: repeat(
      2,
      minmax(0, 1fr)
    );
    gap: 0.85rem;
  }

  .related-organizations__card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    transition:
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .related-organizations__card:hover {
    border-color: var(--color-primary-light);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .related-organizations__card-link {
    display: block;
    height: 100%;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .related-organizations__card-top {
    display: grid;
    grid-template-columns: 3.3rem minmax(0, 1fr) 2rem;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .related-organizations__logo {
    display: grid;
    width: 3.3rem;
    height: 3.3rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.8rem;
    background: var(--color-surface);
    color: var(--color-primary);
  }

  .related-organizations__logo img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0.45rem;
    object-fit: contain;
  }

  .related-organizations__identity {
    min-width: 0;
  }

  .related-organizations__type {
    display: inline-block;
    margin-bottom: 0.2rem;
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .related-organizations__identity h3 {
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .related-organizations__short-name {
    display: block;
    margin-top: 0.15rem;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .related-organizations__arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.55rem;
    background: var(--color-surface);
    color: var(--color-text-secondary);
    transition:
      color 160ms ease,
      background 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .related-organizations__card:hover
    .related-organizations__arrow {
    border-color: var(--color-primary-light);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    transform: translateX(2px);
  }

  .related-organizations__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.8rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .related-organizations__location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.8rem;
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .related-organizations__location svg {
    flex: 0 0 auto;
    color: var(--color-primary);
  }

  .related-organizations__address {
    margin: 0.25rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .related-organizations__waste {
    margin-top: 0.8rem;
  }

  .related-organizations__waste-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.4rem;
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .related-organizations__waste-label svg {
    color: var(--color-primary);
  }

  .related-organizations__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .related-organizations__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.28rem 0.45rem;
    border-radius: 0.4rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.64rem;
    font-weight: 600;
  }

  .related-organizations__tag svg {
    flex: 0 0 auto;
    color: var(--color-primary);
  }

  .related-organizations__tag--muted {
    color: var(--color-text-secondary);
  }

  .related-organizations__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .related-organizations__empty {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
  }

  .related-organizations__empty-icon {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    flex: 0 0 2.4rem;
    place-items: center;
    border-radius: 0.7rem;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .related-organizations__empty strong {
    display: block;
    color: var(--color-text);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .related-organizations__empty p {
    margin: 0.25rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .related-organizations--compact {
    padding: 1.15rem;
  }

  .related-organizations--compact
    .related-organizations__header {
    margin-bottom: 1rem;
  }

  .related-organizations--compact
    .related-organizations__grid {
    grid-template-columns: 1fr;
  }

  @media (max-width: 760px) {
    .related-organizations {
      padding: 1.15rem;
    }

    .related-organizations__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .related-organizations__header {
      flex-direction: column;
      gap: 0.7rem;
    }

    .related-organizations__card-top {
      grid-template-columns: 3rem minmax(0, 1fr) 1.9rem;
    }

    .related-organizations__logo {
      width: 3rem;
      height: 3rem;
    }
  }
</style>