---
/**
 * ============================================================================
 * BINSIGHT — WASTE CARD
 * ============================================================================
 * Badung Waste Intelligence
 *
 * Component untuk menampilkan ringkasan kategori / jenis sampah.
 *
 * Prinsip:
 * - Tidak mengarang data volume / tonase.
 * - Fokus pada identitas, kategori, karakteristik, dan deskripsi.
 * - Dapat digunakan di listing publik maupun halaman related data.
 * - Tidak bergantung pada Firebase.
 * ============================================================================
 */

import {
  ArrowRight,
  Check,
  Recycle,
} from "@lucide/astro";

interface WasteCardData {
  id: string;
  slug: string;
  name: string;
  description: string;
  shortDescription?: string;
  category: string;
  characteristics?: string[];
  image?: string;
  icon?: string;
  isPublic?: boolean;
  isFeatured?: boolean;
}

interface Props {
  waste: WasteCardData;
  href?: string;
  featured?: boolean;
  compact?: boolean;
  showCharacteristics?: boolean;
}

const {
  waste,
  href = `/waste/${waste.slug}`,
  featured = false,
  compact = false,
  showCharacteristics = true,
} = Astro.props;

const visibleCharacteristics =
  waste.characteristics?.slice(0, compact ? 2 : 3) ?? [];

const remainingCharacteristics =
  Math.max(
    0,
    (waste.characteristics?.length ?? 0) -
      visibleCharacteristics.length,
  );

const description =
  waste.shortDescription ??
  waste.description;

const isFeatured =
  featured || waste.isFeatured === true;
---

<article
  class:list={[
    "waste-card",
    compact && "waste-card--compact",
    isFeatured && "waste-card--featured",
  ]}
>
  <a
    href={href}
    class="waste-card__link"
    aria-label={`Lihat informasi ${waste.name}`}
  >
    <div class="waste-card__visual">
      {waste.image ? (
        <img
          src={waste.image}
          alt=""
          class="waste-card__image"
          loading="lazy"
        />
      ) : (
        <div
          class="waste-card__visual-placeholder"
          aria-hidden="true"
        >
          <Recycle
            size={36}
            stroke-width="1.7"
          />
        </div>
      )}

      <div class="waste-card__visual-overlay"></div>

      <span class="waste-card__category">
        {waste.category}
      </span>

      {isFeatured && (
        <span class="waste-card__featured">
          Unggulan
        </span>
      )}
    </div>

    <div class="waste-card__body">
      <div class="waste-card__heading">
        <div class="waste-card__title-group">
          <span class="waste-card__eyebrow">
            Jenis sampah
          </span>

          <h3>{waste.name}</h3>
        </div>

        <span
          class="waste-card__arrow"
          aria-hidden="true"
        >
          <ArrowRight
            size={17}
            stroke-width="1.8"
          />
        </span>
      </div>

      <p class="waste-card__description">
        {description}
      </p>

      {showCharacteristics &&
        visibleCharacteristics.length > 0 && (
          <div class="waste-card__characteristics">
            <div class="waste-card__section-label">
              <span>
                Karakteristik
              </span>
            </div>

            <div class="waste-card__tags">
              {visibleCharacteristics.map(
                (characteristic) => (
                  <span class="waste-card__tag">
                    <Check
                      size={12}
                      stroke-width="2"
                      aria-hidden="true"
                    />
                    {characteristic}
                  </span>
                ),
              )}

              {remainingCharacteristics > 0 && (
                <span class="waste-card__tag waste-card__tag--muted">
                  +{remainingCharacteristics}
                </span>
              )}
            </div>
          </div>
        )}

      <div class="waste-card__footer">
        <span>
          Lihat detail
        </span>

        <span
          class="waste-card__footer-icon"
          aria-hidden="true"
        >
          <ArrowRight
            size={16}
            stroke-width="1.8"
          />
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .waste-card {
    position: relative;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .waste-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .waste-card--featured {
    border-color: var(--color-primary-light);
  }

  .waste-card__link {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .waste-card__visual {
    position: relative;
    display: flex;
    min-height: 11rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 82% 18%,
        rgba(132, 204, 22, 0.28),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        var(--color-primary-dark),
        var(--color-primary)
      );
  }

  .waste-card__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .waste-card__visual-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.04) 0%,
        rgba(0, 0, 0, 0.14) 60%,
        rgba(0, 0, 0, 0.28) 100%
      );
  }

  .waste-card__visual-placeholder {
    position: relative;
    z-index: 1;
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    backdrop-filter: blur(8px);
  }

  .waste-card__category,
  .waste-card__featured {
    position: absolute;
    z-index: 2;
    top: 1rem;
    padding: 0.38rem 0.65rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 750;
    line-height: 1;
  }

  .waste-card__category {
    left: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-primary-dark);
  }

  .waste-card__featured {
    right: 1rem;
    background: var(--color-primary);
    color: #fff;
  }

  .waste-card__body {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    padding: 1.25rem;
  }

  .waste-card__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .waste-card__title-group {
    min-width: 0;
  }

  .waste-card__eyebrow {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-primary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .waste-card__title-group h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.05rem;
    font-weight: 750;
    line-height: 1.35;
  }

  .waste-card__arrow {
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    flex: 0 0 2.2rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    background: var(--color-background);
    color: var(--color-text-secondary);
    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .waste-card:hover .waste-card__arrow {
    border-color: var(--color-primary-light);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    transform: translateX(2px);
  }

  .waste-card__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.75rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.87rem;
    line-height: 1.62;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .waste-card__characteristics {
    margin-top: 1rem;
  }

  .waste-card__section-label {
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.73rem;
    font-weight: 700;
  }

  .waste-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .waste-card__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.5rem;
    border-radius: 0.45rem;
    background: var(--color-background);
    color: var(--color-text);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .waste-card__tag svg {
    flex: 0 0 auto;
    color: var(--color-primary);
  }

  .waste-card__tag--muted {
    color: var(--color-text-secondary);
  }

  .waste-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.1rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 750;
  }

  .waste-card__footer-icon {
    display: grid;
    width: 1.9rem;
    height: 1.9rem;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    transition: transform 160ms ease;
  }

  .waste-card:hover .waste-card__footer-icon {
    transform: translateX(3px);
  }

  .waste-card--compact .waste-card__visual {
    min-height: 8.5rem;
  }

  .waste-card--compact .waste-card__body {
    padding: 1rem;
  }

  .waste-card--compact .waste-card__description {
    -webkit-line-clamp: 2;
  }

  .waste-card--compact .waste-card__characteristics {
    margin-top: 0.75rem;
  }

  .waste-card--compact .waste-card__footer {
    padding-top: 0.9rem;
  }

  @media (max-width: 640px) {
    .waste-card__visual {
      min-height: 9.5rem;
    }

    .waste-card__body {
      padding: 1.1rem;
    }

    .waste-card__heading {
      gap: 0.6rem;
    }

    .waste-card__arrow {
      width: 2rem;
      height: 2rem;
      flex-basis: 2rem;
    }
  }
</style>