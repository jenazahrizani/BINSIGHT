---
/**
 * BINSIGHT â€” NAVBAR
 * --------------------------------------------------------------------------
 * Primary navigation for the public-facing BINSIGHT platform.
 *
 * Responsibilities:
 * - Brand / logo
 * - Primary navigation
 * - Explore dropdown
 * - Report CTA
 * - Mobile navigation
 * - Current route highlighting
 * - Accessible keyboard / screen-reader behavior
 *
 * Architecture:
 * - No external JS dependency
 * - No framework required
 * - Works directly inside Astro layouts
 * - Uses BINSIGHT global design tokens
 * --------------------------------------------------------------------------
 */

import { Menu, X, ChevronDown, Map, ChartColumn, Building2, Recycle, TriangleAlert, Info } from "@lucide/astro";

interface NavItem {
  label: string;
  href: string;
  icon?: any;
  exact?: boolean;
}

const pathname = Astro.url.pathname;

const primaryLinks: NavItem[] = [
  {
    label: "Beranda",
    href: "/",
    exact: true,
  },
  {
    label: "Peta",
    href: "/map",
    icon: Map,
  },
  {
    label: "Data",
    href: "/dashboard",
    icon: ChartColumn,
  },
  {
    label: "Organisasi",
    href: "/organizations",
    icon: Building2,
  },
];

const exploreItems: NavItem[] = [
  {
    label: "Jenis Sampah",
    href: "/waste",
    icon: Recycle,
  },
  {
    label: "Laporan Masyarakat",
    href: "/reports",
    icon: TriangleAlert,
  },
  {
    label: "Tentang BINSIGHT",
    href: "/company",
    icon: Info,
  },
];

function normalizePath(path: string) {
  if (path !== "/" && path.endsWith("/")) {
    return path.slice(0, -1);
  }

  return path;
}

function isActive(href: string, exact = false) {
  const currentPath = normalizePath(pathname);
  const targetPath = normalizePath(href);

  if (exact) {
    return currentPath === targetPath;
  }

  return (
    currentPath === targetPath ||
    currentPath.startsWith(`${targetPath}/`)
  );
}

const isExploreActive = exploreItems.some((item) =>
  isActive(item.href, item.href === "/company")
);
---

<nav
  class="navbar"
  data-navbar
  aria-label="Navigasi utama BINSIGHT"
>
  <div class="navbar__container">
    <a
      class="navbar__brand"
      href="/"
      aria-label="BINSIGHT â€” Badung Waste Intelligence, kembali ke beranda"
    >

      <span class="navbar__brand-copy">
        <span class="navbar__brand-name">BINSIGHT</span>
        <span class="navbar__brand-tagline">Badung Waste Intelligence</span>
      </span>
    </a>

    <div class="navbar__desktop">
      <div class="navbar__links" role="list">
        {
          primaryLinks.map((item) => {
            const active = isActive(item.href, item.exact);

            return (
              <a
                class:list={[
                  "navbar__link",
                  {
                    "navbar__link--active": active,
                  },
                ]}
                href={item.href}
                aria-current={active ? "page" : undefined}
              >
                {item.icon && (
                  <item.icon
                    size={17}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                )}

                <span>{item.label}</span>
              </a>
            );
          })
        }

        <div
          class:list={[
            "navbar__dropdown",
            {
              "navbar__dropdown--active": isExploreActive,
            },
          ]}
          data-navbar-dropdown
        >
          <button
            class:list={[
              "navbar__link",
              "navbar__dropdown-trigger",
              {
                "navbar__link--active": isExploreActive,
              },
            ]}
            type="button"
            aria-expanded="false"
            aria-controls="navbar-explore-menu"
            data-navbar-dropdown-trigger
          >
            <span>Eksplorasi</span>

            <ChevronDown
              class="navbar__dropdown-icon"
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>

          <div
            id="navbar-explore-menu"
            class="navbar__dropdown-menu"
            role="menu"
            aria-label="Eksplorasi BINSIGHT"
            data-navbar-dropdown-menu
          >
            <div class="navbar__dropdown-inner">
              {
                exploreItems.map((item) => {
                  const active = isActive(
                    item.href,
                    item.href === "/company"
                  );

                  return (
                    <a
                      class:list={[
                        "navbar__dropdown-item",
                        {
                          "navbar__dropdown-item--active": active,
                        },
                      ]}
                      href={item.href}
                      role="menuitem"
                      aria-current={active ? "page" : undefined}
                    >
                      <span class="navbar__dropdown-item-icon">
                        {item.icon && (
                          <item.icon
                            size={17}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        )}
                      </span>

                      <span class="navbar__dropdown-item-copy">
                        <strong>{item.label}</strong>

                        <small>
                          {
                            item.href === "/waste"
                              ? "Pelajari kategori dan pengelolaan sampah"
                              : item.href === "/reports"
                                ? "Pantau dan kirim laporan persampahan"
                                : "Kenali platform dan tujuan BINSIGHT"
                          }
                        </small>
                      </span>
                    </a>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>

      <div class="navbar__actions">
        <a class="navbar__report-button" href="/reports/create">
          <TriangleAlert
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>Laporkan</span>
        </a>
      </div>
    </div>

    <div class="navbar__mobile-actions">
      <a
        class="navbar__mobile-report"
        href="/reports/create"
        aria-label="Buat laporan persampahan"
      >
        <TriangleAlert
          size={18}
          stroke-width={2}
          aria-hidden="true"
        />
      </a>

      <button
        class="navbar__menu-toggle"
        type="button"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="navbar-mobile-menu"
        data-navbar-toggle
      >
        <Menu
          class="navbar__menu-icon navbar__menu-icon--open"
          size={23}
          stroke-width={2}
          aria-hidden="true"
        />

        <X
          class="navbar__menu-icon navbar__menu-icon--close"
          size={23}
          stroke-width={2}
          aria-hidden="true"
        />
      </button>
    </div>
  </div>

  <div
    id="navbar-mobile-menu"
    class="navbar__mobile-menu"
    data-navbar-mobile
    aria-hidden="true"
  >
    <div class="navbar__mobile-inner">
      <div class="navbar__mobile-primary">
        {
          primaryLinks.map((item) => {
            const active = isActive(item.href, item.exact);

            return (
              <a
                class:list={[
                  "navbar__mobile-link",
                  {
                    "navbar__mobile-link--active": active,
                  },
                ]}
                href={item.href}
                aria-current={active ? "page" : undefined}
              >
                <span class="navbar__mobile-link-icon">
                  {item.icon && (
                    <item.icon
                      size={19}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  )}
                </span>

                <span>{item.label}</span>
              </a>
            );
          })
        }
      </div>

      <div class="navbar__mobile-section">
        <p class="navbar__mobile-label">Eksplorasi</p>

        <div class="navbar__mobile-explore">
          {
            exploreItems.map((item) => {
              const active = isActive(
                item.href,
                item.href === "/company"
              );

              return (
                <a
                  class:list={[
                    "navbar__mobile-link",
                    {
                      "navbar__mobile-link--active": active,
                    },
                  ]}
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                >
                  <span class="navbar__mobile-link-icon">
                    {item.icon && (
                      <item.icon
                        size={19}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />
                    )}
                  </span>

                  <span>{item.label}</span>
                </a>
              );
            })
          }
        </div>
      </div>

      <div class="navbar__mobile-cta">
        <a
          class="navbar__mobile-report-button"
          href="/reports/create"
        >
          <span class="navbar__mobile-report-icon">
            <TriangleAlert
              size={19}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span>
            <strong>Laporkan Masalah</strong>
            <small>
              Bantu melaporkan persoalan persampahan di Badung
            </small>
          </span>
        </a>
      </div>

      <div class="navbar__mobile-footer">
        <span>BINSIGHT</span>
        <span>Badung Waste Intelligence</span>
      </div>
    </div>
  </div>
</nav>

<script>
  /**
   * BINSIGHT Navbar Controller
   *
   * Intentionally framework-free.
   * Handles:
   * - Mobile menu
   * - Dropdown
   * - Escape
   * - Outside click
   * - Scroll locking
   * - Keyboard accessibility
   */

  const navbar = document.querySelector<HTMLElement>("[data-navbar]");

  if (navbar) {
    const toggle =
      navbar.querySelector<HTMLButtonElement>(
        "[data-navbar-toggle]"
      );

    const mobileMenu =
      navbar.querySelector<HTMLElement>(
        "[data-navbar-mobile]"
      );

    const dropdown =
      navbar.querySelector<HTMLElement>(
        "[data-navbar-dropdown]"
      );

    const dropdownTrigger =
      navbar.querySelector<HTMLButtonElement>(
        "[data-navbar-dropdown-trigger]"
      );

    const dropdownMenu =
      navbar.querySelector<HTMLElement>(
        "[data-navbar-dropdown-menu]"
      );

    const openMobileMenu = () => {
      if (!toggle || !mobileMenu) return;

      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute(
        "aria-label",
        "Tutup menu navigasi"
      );

      mobileMenu.setAttribute("aria-hidden", "false");
      navbar.classList.add("navbar--mobile-open");

      document.documentElement.classList.add(
        "navbar-scroll-locked"
      );
      document.body.classList.add(
        "navbar-scroll-locked"
      );
    };

    const closeMobileMenu = () => {
      if (!toggle || !mobileMenu) return;

      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute(
        "aria-label",
        "Buka menu navigasi"
      );

      mobileMenu.setAttribute("aria-hidden", "true");
      navbar.classList.remove("navbar--mobile-open");

      document.documentElement.classList.remove(
        "navbar-scroll-locked"
      );
      document.body.classList.remove(
        "navbar-scroll-locked"
      );
    };

    const openDropdown = () => {
      if (!dropdown || !dropdownTrigger || !dropdownMenu) {
        return;
      }

      dropdown.classList.add("navbar__dropdown--open");

      dropdownTrigger.setAttribute(
        "aria-expanded",
        "true"
      );

      dropdownMenu.setAttribute("aria-hidden", "false");
    };

    const closeDropdown = () => {
      if (!dropdown || !dropdownTrigger || !dropdownMenu) {
        return;
      }

      dropdown.classList.remove("navbar__dropdown--open");

      dropdownTrigger.setAttribute(
        "aria-expanded",
        "false"
      );

      dropdownMenu.setAttribute("aria-hidden", "true");
    };

    const toggleDropdown = () => {
      if (!dropdown) return;

      const isOpen =
        dropdown.classList.contains(
          "navbar__dropdown--open"
        );

      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    };

    toggle?.addEventListener("click", () => {
      const expanded =
        toggle.getAttribute("aria-expanded") === "true";

      if (expanded) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    dropdownTrigger?.addEventListener(
      "click",
      toggleDropdown
    );

    dropdownTrigger?.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          openDropdown();

          const firstItem =
            dropdownMenu?.querySelector<HTMLElement>(
              '[role="menuitem"]'
            );

          firstItem?.focus();
        }

        if (event.key === "Escape") {
          event.preventDefault();
          closeDropdown();
          dropdownTrigger.focus();
        }
      }
    );

    dropdownMenu?.addEventListener(
      "keydown",
      (event) => {
        const items = Array.from(
          dropdownMenu.querySelectorAll<HTMLElement>(
            '[role="menuitem"]'
          )
        );

        if (!items.length) return;

        const currentIndex =
          items.indexOf(
            document.activeElement as HTMLElement
          );

        if (event.key === "ArrowDown") {
          event.preventDefault();

          const nextIndex =
            currentIndex < items.length - 1
              ? currentIndex + 1
              : 0;

          items[nextIndex]?.focus();
        }

        if (event.key === "ArrowUp") {
          event.preventDefault();

          const previousIndex =
            currentIndex > 0
              ? currentIndex - 1
              : items.length - 1;

          items[previousIndex]?.focus();
        }

        if (event.key === "Escape") {
          event.preventDefault();
          closeDropdown();
          dropdownTrigger?.focus();
        }

        if (event.key === "Tab") {
          closeDropdown();
        }
      }
    );

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Node)) return;

      if (
        dropdown &&
        !dropdown.contains(target)
      ) {
        closeDropdown();
      }

      if (
        navbar &&
        !navbar.contains(target)
      ) {
        closeMobileMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;

      closeDropdown();
      closeMobileMenu();
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMobileMenu();
      });
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 1024) {
        closeMobileMenu();
      }
    });

    let lastScrollY = window.scrollY;

    window.addEventListener(
      "scroll",
      () => {
        const currentScrollY = window.scrollY;

        if (currentScrollY > 12) {
          navbar.classList.add("navbar--scrolled");
        } else {
          navbar.classList.remove("navbar--scrolled");
        }

        if (
          currentScrollY > lastScrollY &&
          currentScrollY > 120 &&
          !navbar.classList.contains(
            "navbar--mobile-open"
          )
        ) {
          navbar.classList.add(
            "navbar--scroll-down"
          );
        } else {
          navbar.classList.remove(
            "navbar--scroll-down"
          );
        }

        lastScrollY = currentScrollY;
      },
      { passive: true }
    );
  }
</script>

<style>
  /* ========================================================================
     BINSIGHT NAVBAR — BRUTALIST / EDITORIAL SYSTEM
     Visual language aligned to the BINSIGHT homepage reference:
     dark ink, acid lime, hard borders, mono labels, strong hierarchy.
     ======================================================================== */

  .navbar {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --white: #fffef8;
    --muted: #6c7068;
    --warning: #ff6a00;

    position: sticky;
    top: 0;
    z-index: 900;
    width: 100%;
    color: var(--white);
    background: var(--ink);
    border-bottom: 4px solid var(--acid);
    box-shadow: 0 8px 0 rgba(0, 0, 0, 0.16);
    transition:
      transform 180ms steps(2, end),
      background-color 160ms linear,
      box-shadow 160ms linear,
      border-color 160ms linear;
    isolation: isolate;
  }

  .navbar::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: "";
    opacity: 0.18;
    background:
      linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .navbar--scrolled {
    background: rgba(9, 10, 8, 0.98);
    border-color: var(--acid);
    box-shadow: 0 10px 0 rgba(255, 106, 0, 0.18);
  }

  .navbar--scroll-down {
    transform: translateY(-100%);
  }

  .navbar--mobile-open {
    transform: translateY(0);
  }

  .navbar__container {
    width: min(1320px, calc(100% - 40px));
    min-height: 76px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .navbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
    flex-shrink: 0;
    color: var(--white);
    text-decoration: none;
  }

  .navbar__brand-mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background: var(--acid);
    border: 3px solid var(--white);
    box-shadow: 5px 5px 0 var(--warning);
  }

  .navbar__brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: contrast(1.05);
  }

  .navbar__brand-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .navbar__brand-name {
    color: var(--acid);
    font-family: Sora, Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 1.08rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .navbar__brand-tagline {
    margin-top: 5px;
    color: #c7c9c0;
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .navbar__desktop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    min-width: 0;
    gap: 24px;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-inline: auto;
  }

  .navbar__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 12px;
    color: #d9dbd3;
    background: transparent;
    border: 2px solid transparent;
    border-radius: 0;
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 120ms linear,
      background-color 120ms linear,
      border-color 120ms linear,
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }

  .navbar__link:hover {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--white);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--warning);
  }

  .navbar__link--active {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--white);
    box-shadow: 4px 4px 0 var(--warning);
  }

  .navbar__link--active::after {
    content: none;
  }

  .navbar__link:focus-visible,
  .navbar__report-button:focus-visible,
  .navbar__menu-toggle:focus-visible,
  .navbar__mobile-report:focus-visible,
  .navbar__dropdown-item:focus-visible,
  .navbar__mobile-link:focus-visible,
  .navbar__mobile-report-button:focus-visible {
    outline: 3px solid var(--acid);
    outline-offset: 3px;
  }

  .navbar__dropdown {
    position: relative;
  }

  .navbar__dropdown-trigger {
    padding-inline: 12px;
  }

  .navbar__dropdown-icon {
    flex-shrink: 0;
    transition: transform 120ms steps(2, end);
  }

  .navbar__dropdown--open .navbar__dropdown-icon {
    transform: rotate(180deg);
  }

  .navbar__dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    width: 350px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -6px);
    background: var(--ink-2);
    border: 3px solid var(--white);
    border-radius: 0;
    box-shadow: 9px 9px 0 var(--warning);
    transition:
      opacity 120ms linear,
      visibility 120ms linear,
      transform 120ms steps(2, end);
  }

  .navbar__dropdown-menu::before {
    content: "";
    position: absolute;
    top: -8px;
    left: 50%;
    width: 13px;
    height: 13px;
    background: var(--ink-2);
    border-top: 3px solid var(--white);
    border-left: 3px solid var(--white);
    transform: translateX(-50%) rotate(45deg);
  }

  .navbar__dropdown--open .navbar__dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .navbar__dropdown-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 5px;
    padding: 9px;
  }

  .navbar__dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    color: var(--white);
    background: transparent;
    border: 2px solid transparent;
    border-radius: 0;
    text-decoration: none;
    transition:
      background-color 120ms linear,
      color 120ms linear,
      transform 120ms steps(2, end),
      border-color 120ms linear;
  }

  .navbar__dropdown-item:hover,
  .navbar__dropdown-item--active {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--ink);
    transform: translate(-2px, -2px);
  }

  .navbar__dropdown-item-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--ink);
    background: var(--white);
    border: 2px solid var(--ink);
    border-radius: 0;
  }

  .navbar__dropdown-item-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .navbar__dropdown-item-copy strong {
    font-family: Sora, Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.76rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .navbar__dropdown-item-copy small {
    color: #aeb2a8;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.69rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .navbar__dropdown-item:hover .navbar__dropdown-item-copy small,
  .navbar__dropdown-item--active .navbar__dropdown-item-copy small {
    color: #30322d;
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar__report-button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 15px;
    color: var(--ink);
    background: var(--acid);
    border: 3px solid var(--ink);
    border-radius: 0;
    box-shadow: 6px 6px 0 var(--white);
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .navbar__report-button:hover {
