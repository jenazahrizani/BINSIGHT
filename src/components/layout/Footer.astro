---
/**
 * BINSIGHT â€” FOOTER
 * --------------------------------------------------------------------------
 * Global public footer for the BINSIGHT platform.
 *
 * Responsibilities:
 * - Brand identity
 * - Platform navigation
 * - Public resources
 * - Organization access
 * - Contact / location information
 * - Legal / platform status
 * - Responsive layout
 *
 * Architecture:
 * - Framework-free
 * - No external data dependency
 * - Safe to render from PublicLayout
 * - Uses global BINSIGHT design tokens
 * --------------------------------------------------------------------------
 */

import {
  ArrowUpRight,
  Building2,
  TriangleAlert,
  Globe,
  Users,
  Code,
  Mail,
  MapPin,
  Map,
  Recycle,
  ChartColumn,
  ShieldCheck,
} from "@lucide/astro";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const exploreLinks: FooterLink[] = [
  {
    label: "Peta Persampahan",
    href: "/map",
  },
  {
    label: "Dashboard Data",
    href: "/dashboard",
  },
  {
    label: "Organisasi",
    href: "/organizations",
  },
  {
    label: "Jenis Sampah",
    href: "/waste",
  },
];

const communityLinks: FooterLink[] = [
  {
    label: "Buat Laporan",
    href: "/reports/create",
  },
  {
    label: "Laporan Masyarakat",
    href: "/reports",
  },
  {
    label: "Tentang BINSIGHT",
    href: "/company",
  },
];

const organizationLinks: FooterLink[] = [
  {
    label: "Area Organisasi",
    href: "/organization",
  },
  {
    label: "Profil Organisasi",
    href: "/organization/profile",
  },
  {
    label: "Sampah yang Dikelola",
    href: "/organization/waste",
  },
  {
    label: "Proses Pengelolaan",
    href: "/organization/process",
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__main">
    <div class="footer__container">
      <div class="footer__top">
        <div class="footer__identity">
          <a
            href="/"
            class="footer__brand"
            aria-label="BINSIGHT â€” Badung Waste Intelligence"
          >

            <span class="footer__brand-copy">
              <span class="footer__brand-name">
                BINSIGHT
              </span>

              <span class="footer__brand-tagline">
                Badung Waste Intelligence
              </span>
            </span>
          </a>

          <p class="footer__description">
            Platform informasi, data, pemetaan, dan pelaporan
            persampahan untuk membangun ekosistem pengelolaan
            sampah yang lebih terhubung di Kabupaten Badung.
          </p>

          <div class="footer__location">
            <MapPin
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <span>Kabupaten Badung, Bali, Indonesia</span>
          </div>

          <div class="footer__socials" aria-label="Tautan media sosial">
            <a
              href="#"
              class="footer__social"
              aria-label="BINSIGHT di Instagram"
              title="Instagram"
            >
              <Globe
                size={17}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </a>

            <a
              href="#"
              class="footer__social"
              aria-label="BINSIGHT di LinkedIn"
              title="LinkedIn"
            >
              <Users
                size={17}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </a>

            <a
              href="#"
              class="footer__social"
              aria-label="BINSIGHT di GitHub"
              title="GitHub"
            >
              <Code
                size={17}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </a>
          </div>
        </div>

        <div class="footer__columns">
          <div class="footer__column">
            <h2 class="footer__heading">
              Eksplorasi
            </h2>

            <nav
              class="footer__links"
              aria-label="Navigasi eksplorasi"
            >
              {
                exploreLinks.map((link) => (
                  <a
                    href={link.href}
                    class="footer__link"
                  >
                    <span>{link.label}</span>

                    <ArrowUpRight
                      size={14}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />
                  </a>
                ))
              }
            </nav>
          </div>

          <div class="footer__column">
            <h2 class="footer__heading">
              Masyarakat
            </h2>

            <nav
              class="footer__links"
              aria-label="Navigasi masyarakat"
            >
              {
                communityLinks.map((link) => (
                  <a
                    href={link.href}
                    class="footer__link"
                  >
                    <span>{link.label}</span>

                    <ArrowUpRight
                      size={14}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />
                  </a>
                ))
              }
            </nav>
          </div>

          <div class="footer__column">
            <h2 class="footer__heading">
              Organisasi
            </h2>

            <nav
              class="footer__links"
              aria-label="Navigasi organisasi"
            >
              {
                organizationLinks.map((link) => (
                  <a
                    href={link.href}
                    class="footer__link"
                  >
                    <span>{link.label}</span>

                    <ArrowUpRight
                      size={14}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />
                  </a>
                ))
              }
            </nav>
          </div>
        </div>
      </div>

      <div class="footer__platform">
        <div class="footer__platform-header">
          <div>
            <p class="footer__eyebrow">
              BINSIGHT PLATFORM
            </p>

            <h2 class="footer__platform-title">
              Data yang lebih terhubung,
              pengelolaan yang lebih terlihat.
            </h2>
          </div>

          <a
            href="/map"
            class="footer__platform-link"
          >
            <span>Jelajahi peta</span>

            <ArrowUpRight
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>
        </div>

        <div class="footer__feature-grid">
          <a
            href="/map"
            class="footer__feature"
          >
            <span class="footer__feature-icon">
              <Map
                size={19}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </span>

            <span class="footer__feature-content">
              <strong>Pemetaan</strong>
              <small>
                Temukan organisasi dan informasi
                persampahan berdasarkan wilayah.
              </small>
            </span>
          </a>

          <a
            href="/dashboard"
            class="footer__feature"
          >
            <span class="footer__feature-icon">
              <ChartColumn
                size={19}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </span>

            <span class="footer__feature-content">
              <strong>Data</strong>
              <small>
                Pahami kondisi ekosistem melalui
                data yang tersedia.
              </small>
            </span>
          </a>

          <a
            href="/waste"
            class="footer__feature"
          >
            <span class="footer__feature-icon">
              <Recycle
                size={19}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </span>

            <span class="footer__feature-content">
              <strong>Edukasi</strong>
              <small>
                Pelajari kategori dan pengelolaan
                berbagai jenis sampah.
              </small>
            </span>
          </a>

          <a
            href="/reports/create"
            class="footer__feature"
          >
            <span class="footer__feature-icon">
              <TriangleAlert
                size={19}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </span>

            <span class="footer__feature-content">
              <strong>Pelaporan</strong>
              <small>
                Sampaikan persoalan persampahan
                untuk ditindaklanjuti.
              </small>
            </span>
          </a>
        </div>
      </div>

      <div class="footer__contact">
        <div class="footer__contact-item">
          <span class="footer__contact-icon">
            <Mail
              size={17}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <span class="footer__contact-copy">
            <span class="footer__contact-label">
              Email
            </span>

            <a href="mailto:info@binsight.id">
              info@binsight.id
            </a>
          </span>
        </div>

        <div class="footer__contact-item">
          <span class="footer__contact-icon">
            <Building2
              size={17}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <span class="footer__contact-copy">
            <span class="footer__contact-label">
              Platform
            </span>

            <span>
              Informasi & data persampahan Badung
            </span>
          </span>
        </div>

        <div class="footer__contact-item">
          <span class="footer__contact-icon">
            <ShieldCheck
              size={17}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <span class="footer__contact-copy">
            <span class="footer__contact-label">
              Status
            </span>

            <span>
              Informasi publik & terverifikasi
            </span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__container footer__bottom-inner">
      <p class="footer__copyright">
        Â© {currentYear}
        <strong>BINSIGHT</strong>.
        Badung Waste Intelligence.
      </p>

      <div class="footer__bottom-links">
        <a href="/company">
          Tentang
        </a>

        <span
          class="footer__bottom-separator"
          aria-hidden="true"
        >
          /
        </span>

        <a href="/company">
          Informasi Platform
        </a>
      </div>

      <p class="footer__version">
        BINSIGHT Platform
      </p>
    </div>
  </div>
</footer>

<style>
  /* ==========================================================================
     BINSIGHT // BRUTALIST FOOTER
     Matches the homepage reference:
     - dark / acid-lime visual system
     - hard edges, strong borders, offset shadows
     - editorial typography
     - mono utility labels
     - minimal rounded geometry
     ========================================================================== */

  .footer {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --white: #fffef8;
    --muted: #8e948b;
    --line: rgba(255, 254, 248, 0.18);
    --orange: #ff6a00;

    position: relative;
    isolation: isolate;
    margin-top: 0;
    overflow: hidden;
    color: var(--white);
    background: var(--ink);
    border-top: 8px solid var(--acid);
  }

  .footer::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: "";
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.45;
  }

  .footer::after {
    position: absolute;
    top: -110px;
    right: -90px;
    z-index: -1;
    width: 420px;
    height: 320px;
    content: "";
    background: var(--acid);
    clip-path: polygon(0 16%, 78% 0, 100% 72%, 28% 100%);
    opacity: 0.08;
    pointer-events: none;
  }

  .footer__main,
  .footer__platform,
  .footer__contact {
    position: relative;
  }

  .footer__main {
    border-top: 0;
  }

  .footer__container {
    width: min(1320px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* --------------------------------------------------------------------------
     TOP
     -------------------------------------------------------------------------- */

  .footer__top {
    display: grid;
    grid-template-columns: minmax(280px, 1.1fr) minmax(0, 1fr);
    gap: 70px;
    padding: 74px 0 56px;
  }

  .footer__identity {
    min-width: 0;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--white);
    text-decoration: none;
  }

  .footer__brand-mark {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    background: var(--acid);
    border: 3px solid var(--white);
    box-shadow: 7px 7px 0 var(--orange);
  }

  .footer__brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .footer__brand-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .footer__brand-name {
    color: var(--white);
    font-family: Sora, Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 1.3rem;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .footer__brand-tagline {
    margin-top: 7px;
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer__description {
    max-width: 530px;
    margin: 28px 0 20px;
    padding-left: 16px;
    color: #c7cbc2;
    border-left: 7px solid var(--acid);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.75;
  }

  .footer__location {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 9px;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--white);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer__location svg {
    flex-shrink: 0;
    color: var(--ink);
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
  }

  .footer__social {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    color: var(--white);
    background: transparent;
    border: 2px solid var(--white);
    border-radius: 0;
    text-decoration: none;
    transition:
      transform 120ms steps(2, end),
      color 120ms linear,
      background 120ms linear,
      box-shadow 120ms steps(2, end);
  }

  .footer__social:hover {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--ink);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--orange);
  }

  /* --------------------------------------------------------------------------
     LINK COLUMNS
     -------------------------------------------------------------------------- */

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .footer__column {
    min-width: 0;
  }

  .footer__heading {
    display: inline-block;
    margin: 0 0 18px;
    padding: 6px 8px;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .footer__links {
    display: grid;
    gap: 4px;
    border-top: 2px solid var(--white);
  }

  .footer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 42px;
    padding: 7px 0;
    color: #b7beb5;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
    transition:
      color 120ms linear,
      transform 120ms steps(2, end),
      padding 120ms steps(2, end);
  }

  .footer__link svg {
    flex: 0 0 auto;
    color: var(--acid);
    opacity: 0.75;
    transform: translate(-3px, 3px);
    transition:
      opacity 120ms linear,
      transform 120ms steps(2, end);
  }

  .footer__link:hover {
    color: var(--white);
    padding-left: 6px;
  }

  .footer__link:hover svg {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* --------------------------------------------------------------------------
     PLATFORM BLOCK
     -------------------------------------------------------------------------- */

  .footer__platform {
    padding: 38px 0 34px;
    border-top: 4px solid var(--white);
    border-bottom: 4px solid var(--white);
    background: var(--ink-2);
  }

  .footer__platform-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 28px;
  }

  .footer__eyebrow {
    display: inline-block;
    margin: 0 0 14px;
    padding: 6px 8px;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__platform-title {
    max-width: 760px;
    margin: 0;
    color: var(--white);
    font-family: Sora, Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(34px, 4.2vw, 62px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }

  .footer__platform-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 50px;
    padding: 0 16px;
    color: var(--ink);
    background: var(--acid);
    border: 3px solid var(--ink);
    box-shadow: 7px 7px 0 var(--white);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .footer__platform-link:hover {
    background: var(--acid-soft);
    transform: translate(-3px, -3px);
    box-shadow: 10px 10px 0 var(--orange);
  }

  .footer__feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 28px;
  }

  .footer__feature {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    padding: 16px;
    color: inherit;
    background: var(--ink-3);
    border: 3px solid var(--white);
    border-radius: 0;
    text-decoration: none;
    box-shadow: 5px 5px 0 var(--acid);
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .footer__feature:hover {
    background: #22261e;
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--orange);
  }

  .footer__feature-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    border-radius: 0;
  }

  .footer__feature-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .footer__feature-content strong {
    color: var(--white);
    font-family: Sora, Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .footer__feature-content small {
    color: #aab0a7;
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.55;
  }

  /* --------------------------------------------------------------------------
     CONTACT
     -------------------------------------------------------------------------- */

  .footer__contact {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    padding: 26px 0;
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
    padding: 13px;
    background: var(--ink-2);
    border: 2px solid var(--white);
  }

  .footer__contact-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    border-radius: 0;
  }

  .footer__contact-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .footer__contact-label {
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.56rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .footer__contact-copy > a,
  .footer__contact-copy > span:last-child {
    overflow: hidden;
    color: #d0d5cd;
    font-size: 0.7rem;
    font-weight: 650;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .footer__contact-copy > a {
    text-decoration: none;
    transition: color 120ms linear;
  }

  .footer__contact-copy > a:hover {
    color: var(--acid);
  }

  /* --------------------------------------------------------------------------
     BOTTOM BAR
     -------------------------------------------------------------------------- */

  .footer__bottom {
    border-top: 4px solid var(--acid);
    background: var(--ink);
  }

  .footer__bottom-inner {
    min-height: 60px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
  }

  .footer__copyright,
  .footer__version {
    margin: 0;
    color: #848b82;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer__copyright strong {
    color: var(--white);
    font-weight: 900;
  }

  .footer__bottom-links {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer__bottom-links a {
    color: var(--white);
    text-decoration: none;
    transition: color 120ms linear;
  }

  .footer__bottom-links a:hover {
    color: var(--acid);
  }

  .footer__bottom-separator {
    color: var(--orange);
  }

