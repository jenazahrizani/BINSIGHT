---
interface Props {
  label: string;
  name: string;

  id?: string;
  placeholder?: string;
  value?: string;

  autocomplete?: string;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;

  autofocus?: boolean;

  maxlength?: number;
  minlength?: number;

  inputmode?: "text" | "search" | "tel" | "url" | "email" | "none";

  error?: string;
  hint?: string;

  ariaLabel?: string;

  showToggle?: boolean;
}

const {
  label,
  name,

  id,
  placeholder = "Masukkan password",
  value = "",

  autocomplete = "current-password",
  required = false,
  disabled = false,
  readonly = false,

  autofocus = false,

  maxlength,
  minlength,

  inputmode = "text",

  error,
  hint,

  ariaLabel,

  showToggle = true,
} = Astro.props;

const inputId =
  id ??
  `auth-password-${name.replace(/[^a-zA-Z0-9_-]/g, "-")}`;

const errorId = `${inputId}-error`;
const hintId = `${inputId}-hint`;

const describedBy = [
  error ? errorId : null,
  !error && hint ? hintId : null,
]
  .filter(Boolean)
  .join(" ");

const hasError = Boolean(error);
---

<div
  class:list={[
    "auth-password",
    {
      "auth-password--error": hasError,
      "auth-password--disabled": disabled,
    },
  ]}
>
  <label
    class="auth-password__label"
    for={inputId}
  >
    <span class="auth-password__label-text">
      {label}
    </span>

    {required ? (
      <span
        class="auth-password__required"
        aria-hidden="true"
      >
        *
      </span>
    ) : null}
  </label>

  <div class="auth-password__field">
    <input
      id={inputId}
      class="auth-password__input"
      name={name}
      type="password"
      value={value}
      placeholder={placeholder}
      autocomplete={autocomplete}
      inputmode={inputmode}
      required={required}
      disabled={disabled}
      readonly={readonly}
      autofocus={autofocus}
      maxlength={maxlength}
      minlength={minlength}
      aria-label={ariaLabel}
      aria-invalid={hasError ? "true" : "false"}
      aria-describedby={describedBy || undefined}
      data-auth-password-input
    />

    {
      showToggle ? (
        <button
          class="auth-password__toggle"
          type="button"
          aria-label="Tampilkan password"
          aria-pressed="false"
          aria-controls={inputId}
          data-password-toggle
        >
          <span
            class="auth-password__toggle-icon auth-password__toggle-icon--show"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </span>

          <span
            class="auth-password__toggle-icon auth-password__toggle-icon--hide"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" />
              <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c5.5 0 9.5 7 9.5 7a16.14 16.14 0 0 1-2.11 2.89" />
              <path d="M6.61 6.61C3.87 8.36 2.5 12 2.5 12s4 7 9.5 7c1.61 0 3.06-.42 4.33-1.1" />
              <path d="m2 2 20 20" />
            </svg>
          </span>

          <span class="auth-password__toggle-text">
            Tampilkan
          </span>
        </button>
      ) : null
    }
  </div>

  {
    error ? (
      <p
        id={errorId}
        class="auth-password__message auth-password__message--error"
        role="alert"
      >
        <span
          class="auth-password__message-mark"
          aria-hidden="true"
        >
          !
        </span>

        <span>{error}</span>
      </p>
    ) : hint ? (
      <p
        id={hintId}
        class="auth-password__message auth-password__message--hint"
      >
        {hint}
      </p>
    ) : null
  }
</div>

<script>
  const initPasswordInputs = () => {
    const toggles =
      document.querySelectorAll<HTMLButtonElement>(
        "[data-password-toggle]",
      );

    toggles.forEach((toggle) => {
      if (toggle.dataset.passwordToggleBound === "true") {
        return;
      }

      const inputId = toggle.getAttribute("aria-controls");

      if (!inputId) {
        return;
      }

      const input =
        document.getElementById(
          inputId,
        ) as HTMLInputElement | null;

      if (!input) {
        return;
      }

      toggle.dataset.passwordToggleBound = "true";

      const showLabel = "Tampilkan password";
      const hideLabel = "Sembunyikan password";

      const showIcon =
        toggle.querySelector<HTMLElement>(
          ".auth-password__toggle-icon--show",
        );

      const hideIcon =
        toggle.querySelector<HTMLElement>(
          ".auth-password__toggle-icon--hide",
        );

      const toggleText =
        toggle.querySelector<HTMLElement>(
          ".auth-password__toggle-text",
        );

      const syncState = () => {
        const visible =
          input.type === "text";

        toggle.setAttribute(
          "aria-pressed",
          visible ? "true" : "false",
        );

        toggle.setAttribute(
          "aria-label",
          visible ? hideLabel : showLabel,
        );

        if (showIcon) {
          showIcon.hidden = visible;
        }

        if (hideIcon) {
          hideIcon.hidden = !visible;
        }

        if (toggleText) {
          toggleText.textContent = visible
            ? "Sembunyikan"
            : "Tampilkan";
        }
      };

      toggle.addEventListener("click", () => {
        const selectionStart =
          input.selectionStart;

        const selectionEnd =
          input.selectionEnd;

        input.type =
          input.type === "password"
            ? "text"
            : "password";

        syncState();

        input.focus();

        if (
          selectionStart !== null &&
          selectionEnd !== null
        ) {
          try {
            input.setSelectionRange(
              selectionStart,
              selectionEnd,
            );
          } catch {
            // Ignore browsers that do not support
            // selection ranges for the current input type.
          }
        }
      });

      syncState();
    });
  };

  initPasswordInputs();

  document.addEventListener(
    "astro:after-swap",
    initPasswordInputs,
  );
</script>

<style>
  .auth-password {
    --auth-password-ink: #090a08;
    --auth-password-paper: #f2f0e6;
    --auth-password-paper-2: #e4e1d4;
    --auth-password-paper-3: #cfcabd;
    --auth-password-white: #fffef8;
    --auth-password-acid: #dfff00;
    --auth-password-acid-soft: #efff70;
    --auth-password-orange: #ff6a00;
    --auth-password-muted: #6c7068;

    display: grid;
    gap: 8px;
    width: 100%;
    min-width: 0;
    color: var(--auth-password-ink);
  }

  /* ==========================================================
     LABEL
     ========================================================== */

  .auth-password__label {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    width: fit-content;
    margin: 0;
    color: var(--auth-password-ink);
    cursor: pointer;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.61rem;
    font-weight: 900;
    letter-spacing: 0.045em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .auth-password__required {
    color: var(--auth-password-orange);
    font-size: 0.72rem;
    font-weight: 900;
  }

  /* ==========================================================
     FIELD
     ========================================================== */

  .auth-password__field {
    position: relative;
    display: flex;
    width: 100%;
    min-width: 0;
  }

  .auth-password__input {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 49px;
    margin: 0;
    padding: 12px 94px 12px 13px;
    border: 2px solid var(--auth-password-ink);
    border-radius: 0;
    outline: 0;
    appearance: none;
    background: var(--auth-password-white);
    color: var(--auth-password-ink);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.35;
    box-shadow: 3px 3px 0 var(--auth-password-ink);
    transition:
      background 120ms ease,
      border-color 120ms ease,
      box-shadow 120ms ease,
      transform 120ms ease;
  }

  .auth-password__input::placeholder {
    color: #95988f;
    opacity: 1;
  }

  .auth-password__input:hover:not(:disabled):not(:focus) {
    background: var(--auth-password-paper);
  }

  .auth-password__input:focus {
    background: var(--auth-password-white);
    border-color: var(--auth-password-ink);
    box-shadow:
      3px 3px 0 var(--auth-password-ink),
      0 0 0 3px var(--auth-password-acid);
  }

  .auth-password__input:disabled {
    cursor: not-allowed;
    background: var(--auth-password-paper-2);
    color: #858980;
  }

  .auth-password__input[readonly] {
    background: var(--auth-password-paper);
    cursor: default;
  }

  .auth-password__input:-webkit-autofill,
  .auth-password__input:-webkit-autofill:hover,
  .auth-password__input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--auth-password-ink);
    -webkit-box-shadow:
      0 0 0 1000px var(--auth-password-white) inset,
      3px 3px 0 var(--auth-password-ink);
    transition: background-color 9999s ease-in-out 0s;
  }

  /* ==========================================================
     TOGGLE
     ========================================================== */

  .auth-password__toggle {
    position: absolute;
    top: 50%;
    right: 8px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 76px;
    min-height: 34px;
    padding: 6px 8px;
    border: 1px solid var(--auth-password-ink);
    border-radius: 0;
    outline: 0;
    transform: translateY(-50%);
    background: var(--auth-password-paper);
    color: var(--auth-password-ink);
    cursor: pointer;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.49rem;
    font-weight: 900;
    letter-spacing: 0.035em;
    line-height: 1;
    text-transform: uppercase;
    transition:
      background 120ms ease,
      color 120ms ease,
      transform 120ms ease;
  }

  .auth-password__toggle:hover {
    background: var(--auth-password-acid);
  }

  .auth-password__toggle:active {
    transform: translate(1px, calc(-50% + 1px));
  }

  .auth-password__toggle:focus-visible {
    background: var(--auth-password-acid);
    box-shadow:
      0 0 0 2px var(--auth-password-white),
      0 0 0 5px var(--auth-password-acid);
  }

  .auth-password__toggle:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .auth-password__toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
  }

  .auth-password__toggle-icon svg {
    display: block;
    width: 15px;
    height: 15px;
  }

  .auth-password__toggle-icon[hidden] {
    display: none;
  }

  .auth-password__toggle-text {
    white-space: nowrap;
  }

  /* ==========================================================
     ERROR / HINT
     ========================================================== */

  .auth-password__message {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin: 0;
    font-size: 0.61rem;
    line-height: 1.5;
  }

  .auth-password__message--hint {
    color: var(--auth-password-muted);
  }

  .auth-password__message--error {
    color: #9d2d00;
    font-weight: 700;
  }

  .auth-password__message-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    border: 1px solid var(--auth-password-ink);
    background: var(--auth-password-orange);
    color: var(--auth-password-white);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.5rem;
    font-weight: 900;
    line-height: 1;
  }

  /* ==========================================================
     ERROR STATE
     ========================================================== */

  .auth-password--error .auth-password__input {
    border-color: var(--auth-password-orange);
    box-shadow: 3px 3px 0 var(--auth-password-orange);
  }

  .auth-password--error .auth-password__input:focus {
    border-color: var(--auth-password-ink);
    box-shadow:
      3px 3px 0 var(--auth-password-orange),
      0 0 0 3px var(--auth-password-acid);
  }

  /* ==========================================================
     DISABLED STATE
     ========================================================== */

  .auth-password--disabled {
    opacity: 0.7;
  }

  .auth-password--disabled .auth-password__label {
    cursor: default;
  }

  /* ==========================================================
     MOBILE
     ========================================================== */

  @media (max-width: 600px) {
    .auth-password__input {
      min-height: 48px;
      padding-right: 88px;
    }

    .auth-password__toggle {
      right: 7px;
      min-width: 70px;
      min-height: 32px;
      padding-inline: 7px;
    }

    .auth-password__toggle-text {
      font-size: 0.46rem;
    }
  }

  @media (max-width: 380px) {
    .auth-password__input {
      padding-right: 49px;
    }

    .auth-password__toggle {
      min-width: 34px;
      width: 34px;
      padding: 0;
    }

    .auth-password__toggle-text {
      display: none;
    }
  }

  /* ==========================================================
     REDUCED MOTION
     ========================================================== */

  @media (prefers-reduced-motion: reduce) {
    .auth-password__input,
    .auth-password__toggle {
      transition: none;
    }
  }
</style>