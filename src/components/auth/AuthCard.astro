---
interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;

  actionLabel?: string;
  loadingLabel?: string;
  loading?: boolean;
  disabled?: boolean;

  error?: string;
  success?: string;

  formId?: string;
  method?: "get" | "post";
  action?: string;
  autocomplete?: string;

  footerText?: string;
  footerLabel?: string;
  footerHref?: string;

  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  description,
  eyebrow,

  actionLabel = "Masuk",
  loadingLabel = "Memproses...",
  loading = false,
  disabled = false,

  error,
  success,

  formId = "auth-form",
  method = "post",
  action,
  autocomplete = "on",

  footerText,
  footerLabel,
  footerHref,

  secondaryLabel,
  secondaryHref,
} = Astro.props;

const isSubmitDisabled = disabled || loading;
const hasHeader = Boolean(
  eyebrow || title || description,
);
const hasSecondaryLink = Boolean(
  secondaryLabel && secondaryHref,
);
---

<section
  class:list={[
    "auth-card",
    {
      "auth-card--loading": loading,
      "auth-card--disabled": disabled,
    },
  ]}
  aria-busy={loading ? "true" : undefined}
>
  {
    hasHeader ? (
      <header class="auth-card__header">
        {
          eyebrow ? (
            <div class="auth-card__eyebrow">
              <span
                class="auth-card__eyebrow-mark"
                aria-hidden="true"
              >
                /
              </span>

              <span>{eyebrow}</span>
            </div>
          ) : null
        }

        {
          title ? (
            <h2 class="auth-card__title">
              {title}
            </h2>
          ) : null
        }

        {
          description ? (
            <p class="auth-card__description">
              {description}
            </p>
          ) : null
        }
      </header>
    ) : null
  }

  {
    error ? (
      <div
        class="auth-card__notice auth-card__notice--error"
        role="alert"
        aria-live="assertive"
      >
        <span
          class="auth-card__notice-icon"
          aria-hidden="true"
        >
          !
        </span>

        <div class="auth-card__notice-content">
          <strong>Terjadi masalah</strong>

          <p>{error}</p>
        </div>
      </div>
    ) : null
  }

  {
    success ? (
      <div
        class="auth-card__notice auth-card__notice--success"
        role="status"
        aria-live="polite"
      >
        <span
          class="auth-card__notice-icon"
          aria-hidden="true"
        >
          ✓
        </span>

        <div class="auth-card__notice-content">
          <strong>Berhasil</strong>

          <p>{success}</p>
        </div>
      </div>
    ) : null
  }

  <form
    id={formId}
    class="auth-card__form"
    method={method}
    action={action}
    autocomplete={autocomplete}
    novalidate
    data-auth-form
  >
    <div class="auth-card__fields">
      <slot />
    </div>

    {
      hasSecondaryLink ? (
        <div class="auth-card__secondary-row">
          <a
            class="auth-card__secondary-link"
            href={secondaryHref}
          >
            <span>{secondaryLabel}</span>

            <span
              class="auth-card__secondary-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </div>
      ) : null
    }

    <button
      class="auth-card__submit"
      type="submit"
      disabled={isSubmitDisabled}
      aria-busy={loading ? "true" : undefined}
    >
      <span class="auth-card__submit-content">
        {
          loading ? (
            <>
              <span
                class="auth-card__spinner"
                aria-hidden="true"
              ></span>

              <span>{loadingLabel}</span>
            </>
          ) : (
            <>
              <span>{actionLabel}</span>

              <span
                class="auth-card__submit-arrow"
                aria-hidden="true"
              >
                →
              </span>
            </>
          )
        }
      </span>
    </button>
  </form>

  {
    footerText && footerLabel && footerHref ? (
      <footer class="auth-card__footer">
        <span>{footerText}</span>

        <a href={footerHref}>
          {footerLabel}
        </a>
      </footer>
    ) : null
  }
</section>

<script>
  const bindAuthForms = () => {
    const forms =
      document.querySelectorAll<HTMLFormElement>(
        "[data-auth-form]",
      );

    forms.forEach((form) => {
      if (form.dataset.authCardBound === "true") {
        return;
      }

      form.dataset.authCardBound = "true";

      form.addEventListener("submit", () => {
        const submit =
          form.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
          );

        if (!submit || submit.disabled) {
          return;
        }

        submit.dataset.submitting = "true";
      });
    });
  };

  bindAuthForms();

  document.addEventListener(
    "astro:after-swap",
    bindAuthForms,
  );
</script>

<style>
  .auth-card {
    --auth-ink: #090a08;
    --auth-paper: #f2f0e6;
    --auth-paper-2: #e4e1d4;
    --auth-paper-3: #cfcabd;
    --auth-white: #fffef8;
    --auth-acid: #dfff00;
    --auth-acid-soft: #efff70;
    --auth-orange: #ff6a00;
    --auth-green: #87b800;
    --auth-muted: #6c7068;

    position: relative;
    width: 100%;
    min-width: 0;
    color: var(--auth-ink);
  }

  /* ==========================================================
     HEADER
     ========================================================== */

  .auth-card__header {
    display: grid;
    gap: 8px;
    margin-bottom: 24px;
  }

  .auth-card__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--auth-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .auth-card__eyebrow-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    background: var(--auth-ink);
    color: var(--auth-acid);
    font-size: 0.68rem;
    font-weight: 900;
    line-height: 1;
  }

  .auth-card__title {
    margin: 0;
    color: var(--auth-ink);
    font-family:
      "Sora",
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(
      1.45rem,
      3vw,
      1.9rem
    );
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .auth-card__description {
    max-width: 500px;
    margin: 0;
    color: var(--auth-muted);
    font-size: 0.76rem;
    line-height: 1.7;
  }

  /* ==========================================================
     NOTICE
     ========================================================== */

  .auth-card__notice {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 18px;
    padding: 12px;
    border: 2px solid var(--auth-ink);
  }

  .auth-card__notice--error {
    background: #fff0eb;
  }

  .auth-card__notice--success {
    background: var(--auth-acid-soft);
  }

  .auth-card__notice-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    flex: 0 0 auto;
    border: 2px solid var(--auth-ink);
    background: var(--auth-orange);
    color: var(--auth-white);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.64rem;
    font-weight: 900;
    line-height: 1;
  }

  .auth-card__notice--success
    .auth-card__notice-icon {
    background: var(--auth-green);
  }

  .auth-card__notice-content {
    min-width: 0;
  }

  .auth-card__notice-content strong {
    display: block;
    color: var(--auth-ink);
    font-size: 0.7rem;
    font-weight: 850;
    line-height: 1.35;
  }

  .auth-card__notice-content p {
    margin: 3px 0 0;
    color: #5f625b;
    font-size: 0.65rem;
    line-height: 1.55;
  }

  /* ==========================================================
     FORM
     ========================================================== */

  .auth-card__form {
    display: block;
    width: 100%;
    margin: 0;
  }

  .auth-card__fields {
    display: grid;
    gap: 17px;
    min-width: 0;
  }

  /* ==========================================================
     SECONDARY ACTION
     ========================================================== */

  .auth-card__secondary-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 24px;
    margin-top: 3px;
  }

  .auth-card__secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 0;
    color: var(--auth-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.035em;
    line-height: 1.4;
    text-decoration: none;
    text-transform: uppercase;
  }

  .auth-card__secondary-link:hover {
    color: var(--auth-ink);
  }

  .auth-card__secondary-arrow {
    color: var(--auth-ink);
    font-size: 0.9rem;
    line-height: 1;
    transition:
      transform 120ms ease;
  }

  .auth-card__secondary-link:hover
    .auth-card__secondary-arrow {
    transform: translateX(2px);
  }

  .auth-card__secondary-link:focus-visible {
    outline: 3px solid var(--auth-acid);
    outline-offset: 3px;
  }

  /* ==========================================================
     PRIMARY SUBMIT
     ========================================================== */

  .auth-card__submit {
    display: block;
    width: 100%;
    min-height: 50px;
    margin-top: 13px;
    padding: 12px 15px;
    border: 2px solid var(--auth-ink);
    border-radius: 0;
    outline: 0;
    background: var(--auth-acid);
    color: var(--auth-ink);
    cursor: pointer;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--auth-ink);
    transition:
      transform 120ms ease,
      box-shadow 120ms ease,
      background 120ms ease;
  }

  .auth-card__submit:hover:not(:disabled) {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--auth-ink);
  }

  .auth-card__submit:active:not(:disabled) {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--auth-ink);
  }

  .auth-card__submit:focus-visible {
    box-shadow:
      4px 4px 0 var(--auth-ink),
      0 0 0 3px var(--auth-white),
      0 0 0 6px var(--auth-acid);
  }

  .auth-card__submit:disabled {
    cursor: not-allowed;
    background: var(--auth-paper-2);
    color: #8c9088;
    box-shadow: 2px 2px 0 var(--auth-muted);
  }

  .auth-card__submit-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .auth-card__submit-arrow {
    font-size: 1rem;
    line-height: 0.8;
  }

  /* ==========================================================
     LOADING
     ========================================================== */

  .auth-card__spinner {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    border: 2px solid rgba(9, 10, 8, 0.22);
    border-top-color: var(--auth-ink);
    border-radius: 50%;
    animation:
      auth-card-spin 650ms linear infinite;
  }

  @keyframes auth-card-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .auth-card--loading
    .auth-card__fields {
    opacity: 0.72;
    pointer-events: none;
  }

  .auth-card--disabled {
    opacity: 0.76;
  }

  /* ==========================================================
     FOOTER
     ========================================================== */

  .auth-card__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 20px;
    padding-top: 17px;
    border-top: 1px solid var(--auth-paper-3);
    color: var(--auth-muted);
    font-size: 0.66rem;
    line-height: 1.5;
    text-align: center;
  }

  .auth-card__footer a {
    color: var(--auth-ink);
    font-weight: 850;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .auth-card__footer a:hover {
    color: var(--auth-green);
  }

  .auth-card__footer a:focus-visible {
    outline: 3px solid var(--auth-acid);
    outline-offset: 3px;
  }

  /* ==========================================================
     RESPONSIVE
     ========================================================== */

  @media (max-width: 600px) {
    .auth-card__header {
      margin-bottom: 20px;
    }

    .auth-card__fields {
      gap: 15px;
    }

    .auth-card__secondary-row {
      justify-content: flex-start;
    }

    .auth-card__submit {
      min-height: 48px;
      margin-top: 13px;
    }

    .auth-card__footer {
      margin-top: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .auth-card__secondary-arrow,
    .auth-card__submit {
      transition: none;
    }

    .auth-card__spinner {
      animation: none;
    }
  }
</style>