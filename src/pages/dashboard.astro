---
/**
 * ============================================================================
 * BINSIGHT — DASHBOARD PAGE
 * ============================================================================
 * Badung Waste Intelligence
 *
 * Dashboard publik:
 * - Overview ekosistem
 * - Organisasi terverifikasi
 * - Distribusi kategori material
 * - Distribusi wilayah
 * - Akses cepat ke peta dan laporan
 *
 * Catatan:
 * - Tidak menggunakan metrik tonase / kilogram.
 * - Tidak membuat angka laporan tanpa sumber data.
 * - Menggunakan data layer yang sudah tersedia.
 * ============================================================================
 */

import {
  ArrowRight,
  Building2,
  ChartColumn,
  CircleAlert,
  FileText,
  Leaf,
  Map,
  MapPin,
  Recycle,
  ShieldCheck,
} from "@lucide/astro";

import DashboardLayout from "@layouts/DashboardLayout.astro";

import {
  getOrganizationCount,
  getOrganizationCountByType,
  getOrganizationsByArea,
  getOrganizationsByWaste,
  getOrganizationsGroupedByArea,
  getPublicOrganizations,
  getVerifiedOrganizationCount,
} from "@lib/data/organizations";

import {
  WASTE_CATEGORY,
} from "@lib/constants/waste";

const publicOrganizations =
  getPublicOrganizations();

const totalOrganizations =
  getOrganizationCount();

const verifiedOrganizations =
  getVerifiedOrganizationCount();

const groupedOrganizations =
  getOrganizationsGroupedByArea();

const organizationTypeCounts =
  getOrganizationCountByType();

const areaEntries =
  Object.entries(groupedOrganizations)
    .sort(
      (a, b) =>
        b[1].length - a[1].length,
    );

const wasteCategories = [
  {
    key: WASTE_CATEGORY.ORGANIC,
    label: "Organik",
    description:
      "Material organik yang tercatat dalam ekosistem BINSIGHT.",
    icon: Leaf,
  },
  {
    key: WASTE_CATEGORY.INORGANIC,
    label: "Anorganik",
    description:
      "Material anorganik yang tercatat dan dapat ditelusuri.",
    icon: Recycle,
  },
  {
    key: WASTE_CATEGORY.HAZARDOUS,
    label: "Bahan Berbahaya",
    description:
      "Material yang memerlukan perhatian dan penanganan khusus.",
    icon: CircleAlert,
  },
  {
    key: WASTE_CATEGORY.ELECTRONIC,
    label: "Elektronik",
    description:
      "Material elektronik yang tercatat dalam data persampahan.",
    icon: ChartColumn,
  },
  {
    key: WASTE_CATEGORY.RESIDUAL,
    label: "Residu",
    description:
      "Material sisa yang masuk kategori residu.",
    icon: ShieldCheck,
  },
].map((category) => ({
  ...category,
  organizationCount:
    getOrganizationsByWaste(category.key)
      .length,
}));

const organizationTypeLabels: Record<
  keyof typeof organizationTypeCounts,
  string
> = {
  government: "Pemerintah",
  community: "Komunitas",
  private: "Swasta",
  "social-enterprise": "Social Enterprise",
  cooperative: "Koperasi",
  educational: "Pendidikan",
  nonprofit: "Nirlaba",
  other: "Lainnya",
};

const typeEntries =
  Object.entries(
    organizationTypeCounts,
  )
    .map(([key, value]) => ({
      key:
        key as keyof typeof organizationTypeLabels,
      label:
        organizationTypeLabels[
          key as keyof typeof organizationTypeLabels
        ],
      value,
    }))
    .filter(
      (item) => item.value > 0,
    )
    .sort(
      (a, b) =>
        b.value - a.value,
    );

const topOrganizations =
  publicOrganizations.slice(0, 4);

const verifiedRate =
  totalOrganizations > 0
    ? Math.round(
        (verifiedOrganizations /
          publicOrganizations.length) *
          100,
      )
    : 0;
---

<DashboardLayout
  title="Dashboard BINSIGHT"
  description="Ringkasan ekosistem informasi persampahan Kabupaten Badung."
>
  <main class="dashboard-page">
    <!-- ================================================================== -->
    <!-- HEADER                                                             -->
    <!-- ================================================================== -->

    <section class="dashboard-hero">
      <div class="dashboard-container">
        <div class="dashboard-hero__content">
          <span class="dashboard-hero__eyebrow">
            Badung Waste Intelligence
          </span>

          <h1>
            Dashboard ekosistem
            persampahan Badung
          </h1>

          <p>
            Ringkasan informasi publik mengenai organisasi,
            kategori material, dan wilayah yang telah tercatat
            dalam BINSIGHT.
          </p>

          <div class="dashboard-hero__actions">
            <a
              href="/map"
              class="dashboard-button dashboard-button--primary"
            >
              <Map
                size={17}
                stroke-width="1.9"
                aria-hidden="true"
              />
              <span>Jelajahi peta</span>
              <ArrowRight
                size={16}
                stroke-width="1.9"
                aria-hidden="true"
              />
            </a>

            <a
              href="/organizations"
              class="dashboard-button dashboard-button--secondary"
            >
              <Building2
                size={17}
                stroke-width="1.9"
                aria-hidden="true"
              />
              <span>Lihat organisasi</span>
            </a>
          </div>
        </div>

        <div class="dashboard-hero__side">
          <div class="dashboard-hero__side-icon">
            <ChartColumn
              size={24}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </div>

          <span>
            Fokus data
          </span>

          <strong>
            Entitas & keterhubungan
          </strong>

          <p>
            BINSIGHT memprioritaskan informasi yang dapat
            ditelusuri tanpa menambahkan klaim volume yang
            belum tervalidasi.
          </p>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- OVERVIEW STATS                                                     -->
    <!-- ================================================================== -->

    <section class="dashboard-section">
      <div class="dashboard-container">
        <div class="section-heading">
          <span class="section-heading__eyebrow">
            Overview
          </span>

          <h2>
            Gambaran singkat ekosistem
          </h2>

          <p>
            Metrik berikut menghitung entitas yang tersedia
            pada data publik BINSIGHT.
          </p>
        </div>

        <div class="stats-grid">
          <article class="stat-card">
            <div class="stat-card__icon">
              <Building2
                size={21}
                stroke-width="1.8"
                aria-hidden="true"
              />
            </div>

            <span class="stat-card__label">
              Organisasi publik
            </span>

            <strong class="stat-card__value">
              {totalOrganizations}
            </strong>

            <span class="stat-card__detail">
              Terdaftar dan tersedia untuk publik
            </span>
          </article>

          <article class="stat-card">
            <div class="stat-card__icon">
              <ShieldCheck
                size={21}
                stroke-width="1.8"
                aria-hidden="true"
              />
            </div>

            <span class="stat-card__label">
              Organisasi terverifikasi
            </span>

            <strong class="stat-card__value">
              {verifiedOrganizations}
            </strong>

            <span class="stat-card__detail">
              Status verifikasi aktif
            </span>
          </article>

          <article class="stat-card">
            <div class="stat-card__icon">
              <MapPin
                size={21}
                stroke-width="1.8"
                aria-hidden="true"
              />
            </div>

            <span class="stat-card__label">
              Area dengan organisasi
            </span>

            <strong class="stat-card__value">
              {areaEntries.length}
            </strong>

            <span class="stat-card__detail">
              Area yang memiliki entitas publik
            </span>
          </article>

          <article class="stat-card">
            <div class="stat-card__icon">
              <Recycle
                size={21}
                stroke-width="1.8"
                aria-hidden="true"
              />
            </div>

            <span class="stat-card__label">
              Kategori material
            </span>

            <strong class="stat-card__value">
              {wasteCategories.length}
            </strong>

            <span class="stat-card__detail">
              Kategori utama dalam BINSIGHT
            </span>
          </article>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- MAIN ANALYTICS                                                      -->
    <!-- ================================================================== -->

    <section class="dashboard-section dashboard-section--soft">
      <div class="dashboard-container">
        <div class="analytics-grid">
          <!-- ORGANIZATIONS BY AREA -->
          <section class="panel">
            <header class="panel__header">
              <div>
                <span class="panel__eyebrow">
                  Wilayah
                </span>

                <h2>
                  Distribusi organisasi
                </h2>

                <p>
                  Persebaran organisasi publik berdasarkan
                  area yang tercatat.
                </p>
              </div>

              <a
                href="/organizations"
                class="panel__link"
              >
                Semua
                <ArrowRight
                  size={15}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
              </a>
            </header>

            {areaEntries.length > 0 ? (
              <div class="area-list">
                {areaEntries
                  .slice(0, 6)
                  .map(([area, organizations]) => {
                    const percentage =
                      totalOrganizations > 0
                        ? Math.round(
                            (organizations.length /
                              totalOrganizations) *
                              100,
                          )
                        : 0;

                    return (
                      <a
                        href={`/organizations?area=${encodeURIComponent(area)}`}
                        class="area-row"
                      >
                        <div class="area-row__top">
                          <div>
                            <strong>
                              {area}
                            </strong>

                            <span>
                              {organizations.length}
                              {organizations.length === 1
                                ? " organisasi"
                                : " organisasi"}
                            </span>
                          </div>

                          <b>
                            {percentage}%
                          </b>
                        </div>

                        <div class="area-row__bar">
                          <span
                            style={`width: ${percentage}%`}
                          ></span>
                        </div>
                      </a>
                    );
                  })}
              </div>
            ) : (
              <div class="panel__empty">
                Belum ada distribusi area yang tersedia.
              </div>
            )}
          </section>

          <!-- ORGANIZATIONS BY TYPE -->
          <section class="panel">
            <header class="panel__header">
              <div>
                <span class="panel__eyebrow">
                  Tipe organisasi
                </span>

                <h2>
                  Komposisi pengelola
                </h2>

                <p>
                  Kategori organisasi publik yang telah
                  tercatat.
                </p>
              </div>
            </header>

            {typeEntries.length > 0 ? (
              <div class="type-list">
                {typeEntries.map(
                  (item) => {
                    const percentage =
                      totalOrganizations > 0
                        ? Math.round(
                            (item.value /
                              totalOrganizations) *
                              100,
                          )
                        : 0;

                    return (
                      <div class="type-row">
                        <div class="type-row__label">
                          <span>
                            {item.label}
                          </span>

                          <strong>
                            {item.value}
                          </strong>
                        </div>

                        <div class="type-row__track">
                          <span
                            style={`width: ${percentage}%`}
                          ></span>
                        </div>
                      </div>
                    );
                  },
                )}
              </div>
            ) : (
              <div class="panel__empty">
                Belum ada data tipe organisasi.
              </div>
            )}

            <div class="panel__footnote">
              <ShieldCheck
                size={14}
                stroke-width="1.8"
                aria-hidden="true"
              />

              <span>
                Hanya organisasi publik yang terverifikasi
                yang dihitung pada tampilan ini.
              </span>
            </div>
          </section>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- WASTE CATEGORIES                                                    -->
    <!-- ================================================================== -->

    <section class="dashboard-section">
      <div class="dashboard-container">
        <div class="section-heading-row">
          <div class="section-heading">
            <span class="section-heading__eyebrow">
              Material
            </span>

            <h2>
              Kategori persampahan
            </h2>

            <p>
              Keterhubungan kategori material dengan organisasi
              publik yang mencatatnya sebagai material yang dikelola.
            </p>
          </div>

          <a
            href="/waste"
            class="section-link"
          >
            Jelajahi material
            <ArrowRight
              size={16}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </a>
        </div>

        <div class="waste-grid">
          {wasteCategories.map((category) => {
            const Icon = category.icon;

            return (
              <a
                href={`/waste?category=${encodeURIComponent(category.key)}`}
                class="waste-item"
              >
                <div class="waste-item__icon">
                  <Icon
                    size={22}
                    stroke-width="1.8"
                    aria-hidden="true"
                  />
                </div>

                <div class="waste-item__body">
                  <div class="waste-item__heading">
                    <h3>
                      {category.label}
                    </h3>

                    <ArrowRight
                      size={15}
                      stroke-width="1.8"
                      aria-hidden="true"
                    />
                  </div>

                  <p>
                    {category.description}
                  </p>

                  <span class="waste-item__count">
                    <strong>
                      {category.organizationCount}
                    </strong>

                    {category.organizationCount === 1
                      ? " organisasi terkait"
                      : " organisasi terkait"}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- FEATURED ORGANIZATIONS                                              -->
    <!-- ================================================================== -->

    <section class="dashboard-section dashboard-section--soft">
      <div class="dashboard-container">
        <div class="section-heading-row">
          <div class="section-heading">
            <span class="section-heading__eyebrow">
              Pengelola
            </span>

            <h2>
              Organisasi dalam ekosistem
            </h2>

            <p>
              Contoh organisasi publik yang dapat ditemukan
              melalui BINSIGHT.
            </p>
          </div>

          <a
            href="/organizations"
            class="section-link"
          >
            Lihat semua
            <ArrowRight
              size={16}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </a>
        </div>

        {topOrganizations.length > 0 ? (
          <div class="organization-list">
            {topOrganizations.map(
              (organization) => (
                <a
                  href={`/organizations/${organization.slug}`}
                  class="organization-row"
                >
                  <div class="organization-row__logo">
                    {organization.logo ? (
                      <img
                        src={organization.logo}
                        alt=""
                        loading="lazy"
                      />
                    ) : (
                      <Building2
                        size={22}
                        stroke-width="1.8"
                        aria-hidden="true"
                      />
                    )}
                  </div>

                  <div class="organization-row__body">
                    <div class="organization-row__top">
                      <h3>
                        {organization.name}
                      </h3>

                      {organization.verified && (
                        <span class="organization-row__verified">
                          <ShieldCheck
                            size={12}
                            stroke-width="2"
                            aria-hidden="true"
                          />
                          Terverifikasi
                        </span>
                      )}
                    </div>

                    <p>
                      {organization.shortDescription ??
                        organization.description}
                    </p>

                    <div class="organization-row__meta">
                      <span>
                        {organization.location.area}
                      </span>

                      <span>
                        {organization.wasteManaged.length}
                        kategori material
                      </span>
                    </div>
                  </div>

                  <ArrowRight
                    class="organization-row__arrow"
                    size={18}
                    stroke-width="1.8"
                    aria-hidden="true"
                  />
                </a>
              ),
            )}
          </div>
        ) : (
          <div class="panel__empty panel__empty--large">
            Belum ada organisasi publik yang tersedia.
          </div>
        )}
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- DATA NOTE                                                           -->
    <!-- ================================================================== -->

    <section class="dashboard-section">
      <div class="dashboard-container">
        <div class="data-note">
          <div class="data-note__icon">
            <CircleAlert
              size={21}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </div>

          <div class="data-note__content">
            <span class="section-heading__eyebrow">
              Catatan data
            </span>

            <h2>
              Dashboard ini tidak menampilkan angka volume
              yang belum tervalidasi
            </h2>

            <p>
              BINSIGHT menggunakan metrik berbasis entitas dan
              keterhubungan data. Informasi seperti tonase,
              kilogram, kapasitas, atau volume hanya layak
              ditampilkan ketika memiliki sumber data yang valid
              dan dapat dipertanggungjawabkan.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- ACTIONS                                                             -->
    <!-- ================================================================== -->

    <section class="dashboard-section dashboard-section--actions">
      <div class="dashboard-container">
        <div class="action-grid">
          <a
            href="/map"
            class="action-card action-card--primary"
          >
            <div class="action-card__icon">
              <Map
                size={24}
                stroke-width="1.8"
                aria-hidden="true"
              />
            </div>

            <div>
              <span class="action-card__eyebrow">
                MAP
              </span>

              <h2>
                Eksplorasi melalui peta
              </h2>

              <p>
                Hubungkan wilayah, lokasi, dan organisasi
                dalam konteks geografis Kabupaten Badung.
              </p>
            </div>

            <ArrowRight
              class="action-card__arrow"
              size={19}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </a>

          <a
            href="/reports/create"
            class="action-card"
          >
            <div class="action-card__icon">
              <FileText
                size={24}
                stroke-width="1.8"
                aria-hidden="true"
              />
            </div>

            <div>
              <span class="action-card__eyebrow">
                REPORT
              </span>

              <h2>
                Sampaikan laporan
              </h2>

              <p>
                Laporkan kondisi persampahan atau lingkungan
                yang perlu diperhatikan.
              </p>
            </div>

            <ArrowRight
              class="action-card__arrow"
              size={19}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</DashboardLayout>

<style>
  .dashboard-page {
    --dashboard-max-width: 1180px;
    width: 100%;
  }

  .dashboard-container {
    width: min(
      var(--dashboard-max-width),
      calc(100% - 2rem)
    );
    margin-inline: auto;
  }

  /* ========================================================================
     HERO
     ======================================================================== */

  .dashboard-hero {
    position: relative;
    overflow: hidden;
    padding: 4rem 0;
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(132, 204, 22, 0.12),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #f8fafc,
        #ffffff 58%,
        #f0fdf4
      );
    border-bottom: 1px solid var(--color-border);
  }

  .dashboard-hero::after {
    position: absolute;
    top: -8rem;
    right: 5%;
    width: 20rem;
    height: 20rem;
    border: 1px solid rgba(22, 101, 52, 0.05);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .dashboard-hero__content {
    position: relative;
    z-index: 1;
    max-width: 750px;
  }

  .dashboard-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    margin-bottom: 0.8rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-primary-light);
    border-radius: 999px;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .dashboard-hero h1 {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(
      2rem,
      4vw,
      3.35rem
    );
    font-weight: 850;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .dashboard-hero__content > p {
    max-width: 720px;
    margin: 1rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .dashboard-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.35rem;
  }

  .dashboard-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.68rem 0.9rem;
    border-radius: 0.7rem;
    font-size: 0.77rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .dashboard-button:hover {
    transform: translateY(-1px);
  }

  .dashboard-button--primary {
    border: 1px solid var(--color-primary);
    background: var(--color-primary);
    color: #fff;
  }

  .dashboard-button--primary:hover {
    border-color: var(--color-primary-dark);
    background: var(--color-primary-dark);
    box-shadow: var(--shadow-md);
  }

  .dashboard-button--secondary {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .dashboard-button--secondary:hover {
    border-color: var(--color-primary-light);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .dashboard-hero__side {
    display: none;
  }

  /* ========================================================================
     SECTIONS
     ======================================================================== */

  .dashboard-section {
    padding: 4rem 0;
  }

  .dashboard-section--soft {
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading__eyebrow {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--color-primary);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(
      1.5rem,
      3vw,
      2.1rem
    );
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .section-heading p {
    max-width: 720px;
    margin: 0.55rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .section-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .section-heading-row .section-heading {
    margin-bottom: 0;
  }

  .section-link,
  .panel__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: 0 0 auto;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 750;
    text-decoration: none;
  }

  .section-link:hover,
  .panel__link:hover {
    color: var(--color-primary-dark);
  }

  /* ========================================================================
     STATS
     ======================================================================== */

