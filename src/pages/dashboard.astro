---
/**
 * ============================================================================
 * BINSIGHT — DASHBOARD PAGE
 * ============================================================================
 * Badung Waste Intelligence
 *
 * Dashboard publik:
 * - Overview ekosistem
 * - Organisasi terverifikasi
 * - Distribusi kategori material
 * - Distribusi wilayah
 * - Akses cepat ke peta dan laporan
 *
 * Catatan:
 * - Tidak menggunakan metrik tonase / kilogram.
 * - Tidak membuat angka laporan tanpa sumber data.
 * - Menggunakan data layer yang sudah tersedia.
 * ============================================================================
 */

import {
  ArrowRight,
  Building2,
  ChartColumn,
  CircleAlert,
  FileText,
  Leaf,
  Map,
  MapPin,
  Recycle,
  ShieldCheck,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import {
  getOrganizationCount,
  getOrganizationCountByType,
  getOrganizationsByWaste,
  getOrganizationsGroupedByArea,
  getPublicOrganizations,
  getVerifiedOrganizationCount,
} from "@lib/data/organizations";

import { WASTE_CATEGORY } from "@lib/constants/waste";

const publicOrganizations = getPublicOrganizations();

const totalOrganizations = getOrganizationCount();

const verifiedOrganizations = getVerifiedOrganizationCount();

const groupedOrganizations = getOrganizationsGroupedByArea();

const organizationTypeCounts = getOrganizationCountByType();

const areaEntries = Object.entries(groupedOrganizations)
  .filter(([, organizations]) => organizations.length > 0)
  .sort((a, b) => b[1].length - a[1].length);

const wasteCategories = [
  {
    key: WASTE_CATEGORY.ORGANIC,
    label: "Organik",
    description:
      "Material organik yang tercatat dalam ekosistem BINSIGHT.",
    icon: Leaf,
  },
  {
    key: WASTE_CATEGORY.INORGANIC,
    label: "Anorganik",
    description:
      "Material anorganik yang tercatat dan dapat ditelusuri.",
    icon: Recycle,
  },
  {
    key: WASTE_CATEGORY.HAZARDOUS,
    label: "Bahan Berbahaya",
    description:
      "Material yang memerlukan perhatian dan penanganan khusus.",
    icon: CircleAlert,
  },
  {
    key: WASTE_CATEGORY.ELECTRONIC,
    label: "Elektronik",
    description:
      "Material elektronik yang tercatat dalam data persampahan.",
    icon: ChartColumn,
  },
  {
    key: WASTE_CATEGORY.RESIDUAL,
    label: "Residu",
    description:
      "Material sisa yang masuk kategori residu.",
    icon: ShieldCheck,
  },
].map((category) => ({
  ...category,
  organizationCount:
    getOrganizationsByWaste(category.key).length,
}));

const organizationTypeLabels: Record<
  keyof typeof organizationTypeCounts,
  string
> = {
  government: "Pemerintah",
  community: "Komunitas",
  private: "Swasta",
  "social-enterprise": "Social Enterprise",
  cooperative: "Koperasi",
  educational: "Pendidikan",
  nonprofit: "Nirlaba",
  other: "Lainnya",
};

const typeEntries = Object.entries(organizationTypeCounts)
  .map(([key, value]) => ({
    key:
      key as keyof typeof organizationTypeLabels,
    label:
      organizationTypeLabels[
        key as keyof typeof organizationTypeLabels
      ],
    value,
  }))
  .filter((item) => item.value > 0)
  .sort((a, b) => b.value - a.value);

const topOrganizations =
  publicOrganizations.slice(0, 4);
---

<PublicLayout
  title="Dashboard BINSIGHT"
  description="Ringkasan ekosistem informasi persampahan Kabupaten Badung."
>
  <main class="dashboard-page">
    <!-- ================================================================== -->
    <!-- HERO                                                               -->
    <!-- ================================================================== -->

    <section class="dashboard-hero">
      <div class="dashboard-container dashboard-hero__inner">
        <div class="dashboard-hero__main">
          <div class="dashboard-kicker">
            <span
              class="dashboard-kicker__dot"
              aria-hidden="true"
            ></span>

            BADUNG WASTE INTELLIGENCE
          </div>

          <h1>
            Dashboard
            <span>ekosistem</span>
            persampahan Badung.
          </h1>

          <p>
            Ringkasan informasi publik mengenai organisasi,
            kategori material, dan wilayah yang telah tercatat
            dalam BINSIGHT.
          </p>

          <div class="dashboard-hero__actions">
            <a
              href="/map"
              class="dashboard-button dashboard-button--primary"
            >
              <Map
                size={17}
                stroke-width="2"
                aria-hidden="true"
              />

              <span>Jelajahi peta</span>

              <ArrowRight
                size={17}
                stroke-width="2"
                aria-hidden="true"
              />
            </a>

            <a
              href="/organizations"
              class="dashboard-button dashboard-button--secondary"
            >
              <Building2
                size={17}
                stroke-width="2"
                aria-hidden="true"
              />

              <span>Lihat organisasi</span>
            </a>
          </div>
        </div>

        <aside class="dashboard-hero__side">
          <div class="dashboard-hero__side-head">
            <span class="dashboard-label">
              FOKUS DATA
            </span>

            <ChartColumn
              size={22}
              stroke-width="2"
              aria-hidden="true"
            />
          </div>

          <strong>
            Entitas &amp; keterhubungan
          </strong>

          <p>
            BINSIGHT memprioritaskan informasi yang
            dapat ditelusuri tanpa menambahkan klaim
            volume yang belum tervalidasi.
          </p>

          <div class="dashboard-hero__side-code">
            <span>DATA MODE</span>
            <strong>ENTITY / RELATION</strong>
          </div>
        </aside>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- OVERVIEW                                                           -->
    <!-- ================================================================== -->

    <section class="dashboard-section">
      <div class="dashboard-container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">
              01 / OVERVIEW
            </span>

            <h2>
              Gambaran singkat ekosistem
            </h2>
          </div>

          <p>
            Metrik berikut menghitung entitas yang tersedia
            pada data publik BINSIGHT.
          </p>
        </div>

        <div class="stats-grid">
          <article class="stat-card">
            <div class="stat-card__top">
              <span class="stat-card__index">01</span>

              <div class="stat-card__icon">
                <Building2
                  size={19}
                  stroke-width="2"
                  aria-hidden="true"
                />
              </div>
            </div>

            <span class="stat-card__label">
              ORGANISASI PUBLIK
            </span>

            <strong class="stat-card__value">
              {totalOrganizations}
            </strong>

            <span class="stat-card__detail">
              Terdaftar dan tersedia untuk publik
            </span>
          </article>

          <article class="stat-card stat-card--acid">
            <div class="stat-card__top">
              <span class="stat-card__index">02</span>

              <div class="stat-card__icon">
                <ShieldCheck
                  size={19}
                  stroke-width="2"
                  aria-hidden="true"
                />
              </div>
            </div>

            <span class="stat-card__label">
              ORGANISASI TERVERIFIKASI
            </span>

            <strong class="stat-card__value">
              {verifiedOrganizations}
            </strong>

            <span class="stat-card__detail">
              Status verifikasi aktif
            </span>
          </article>

          <article class="stat-card">
            <div class="stat-card__top">
              <span class="stat-card__index">03</span>

              <div class="stat-card__icon">
                <MapPin
                  size={19}
                  stroke-width="2"
                  aria-hidden="true"
                />
              </div>
            </div>

            <span class="stat-card__label">
              AREA DENGAN ORGANISASI
            </span>

            <strong class="stat-card__value">
              {areaEntries.length}
            </strong>

            <span class="stat-card__detail">
              Area yang memiliki entitas publik
            </span>
          </article>

          <article class="stat-card">
            <div class="stat-card__top">
              <span class="stat-card__index">04</span>

              <div class="stat-card__icon">
                <Recycle
                  size={19}
                  stroke-width="2"
                  aria-hidden="true"
                />
              </div>
            </div>

            <span class="stat-card__label">
              KATEGORI MATERIAL
            </span>

            <strong class="stat-card__value">
              {wasteCategories.length}
            </strong>

            <span class="stat-card__detail">
              Kategori utama dalam BINSIGHT
            </span>
          </article>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- ANALYTICS                                                          -->
    <!-- ================================================================== -->

    <section class="dashboard-section dashboard-section--dark">
      <div class="dashboard-container">
        <div class="section-heading section-heading--dark">
          <div>
            <span class="section-kicker section-kicker--acid">
              02 / DISTRIBUSI
            </span>

            <h2>
              Bagaimana ekosistem tersebar?
            </h2>
          </div>

          <p>
            Distribusi ini membantu membaca konsentrasi entitas
            tanpa mengubah data menjadi klaim volume.
          </p>
        </div>

        <div class="analytics-grid">
          <section class="panel">
            <header class="panel__header">
              <div>
                <span class="panel__eyebrow">
                  WILAYAH
                </span>

                <h3>
                  Distribusi organisasi
                </h3>

                <p>
                  Persebaran organisasi publik berdasarkan
                  area yang tercatat.
                </p>
              </div>

              <a
                href="/organizations"
                class="panel__link"
              >
                Semua

                <ArrowRight
                  size={15}
                  stroke-width="2"
                  aria-hidden="true"
                />
              </a>
            </header>

            {areaEntries.length > 0 ? (
              <div class="area-list">
                {areaEntries
                  .slice(0, 6)
                  .map(
                    ([area, organizations], index) => {
                      const percentage =
                        totalOrganizations > 0
                          ? Math.round(
                              (organizations.length /
                                totalOrganizations) *
                                100,
                            )
                          : 0;

                      return (
                        <a
                          href={`/organizations?area=${encodeURIComponent(area)}`}
                          class="area-row"
                        >
                          <div class="area-row__top">
                            <div class="area-row__name">
                              <strong>
                                <span class="area-row__number">
                                  {String(
                                    index + 1,
                                  ).padStart(2, "0")}
                                </span>

                                <span class="area-row__title">
                                  {area}
                                </span>
                              </strong>

                              <span class="area-row__count">
                                {organizations.length}{" "}
                                organisasi
                              </span>
                            </div>

                            <b>
                              {percentage}%
                            </b>
                          </div>

                          <div class="area-row__bar">
                            <span
                              style={`width: ${percentage}%`}
                            ></span>
                          </div>
                        </a>
                      );
                    },
                  )}
              </div>
            ) : (
              <div class="panel__empty">
                Belum ada distribusi area yang tersedia.
              </div>
            )}
          </section>

          <section class="panel">
            <header class="panel__header">
              <div>
                <span class="panel__eyebrow">
                  TIPE ORGANISASI
                </span>

                <h3>
                  Komposisi pengelola
                </h3>

                <p>
                  Kategori organisasi publik yang telah
                  tercatat dalam data.
                </p>
              </div>
            </header>

            {typeEntries.length > 0 ? (
              <div class="type-list">
                {typeEntries.map(
                  (item, index) => {
                    const percentage =
                      totalOrganizations > 0
                        ? Math.round(
                            (item.value /
                              totalOrganizations) *
                              100,
                          )
                        : 0;

                    return (
                      <div class="type-row">
                        <div class="type-row__label">
                          <span>
                            <em>
                              {String(
                                index + 1,
                              ).padStart(
                                2,
                                "0",
                              )}
                            </em>

                            {item.label}
                          </span>

                          <strong>
                            {item.value}
                          </strong>
                        </div>

                        <div class="type-row__track">
                          <span
                            style={`width: ${percentage}%`}
                          ></span>
                        </div>

                        <div class="type-row__meta">
                          {percentage}%
                        </div>
                      </div>
                    );
                  },
                )}
              </div>
            ) : (
              <div class="panel__empty">
                Belum ada data tipe organisasi.
              </div>
            )}

            <div class="panel__footnote">
              <ShieldCheck
                size={14}
                stroke-width="2"
                aria-hidden="true"
              />

              <span>
                Angka tipe mengikuti data organisasi yang
                tersedia pada data layer publik.
              </span>
            </div>
          </section>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- MATERIAL                                                           -->
    <!-- ================================================================== -->

    <section class="dashboard-section">
      <div class="dashboard-container">
        <div class="section-heading-row">
          <div class="section-heading">
            <span class="section-kicker">
              03 / MATERIAL
            </span>

            <h2>
              Kategori persampahan
            </h2>

            <p>
              Keterhubungan kategori material dengan organisasi
              publik yang mencatatnya sebagai material yang dikelola.
            </p>
          </div>

          <a
            href="/waste"
            class="section-link"
          >
            Jelajahi material

            <ArrowRight
              size={16}
              stroke-width="2"
              aria-hidden="true"
            />
          </a>
        </div>

        <div class="waste-grid">
          {wasteCategories.map(
            (category, index) => {
              const Icon = category.icon;

              return (
                <a
                  href={`/waste?category=${encodeURIComponent(category.key)}`}
                  class="waste-item"
                >
                  <div class="waste-item__top">
                    <span>
                      {String(index + 1).padStart(
                        2,
                        "0",
                      )}
                    </span>

                    <div class="waste-item__icon">
                      <Icon
                        size={21}
                        stroke-width="2"
                        aria-hidden="true"
                      />
                    </div>
                  </div>

                  <div class="waste-item__body">
                    <div class="waste-item__heading">
                      <h3>
                        {category.label}
                      </h3>

                      <ArrowRight
                        size={15}
                        stroke-width="2"
                        aria-hidden="true"
                      />
                    </div>

                    <p>
                      {category.description}
                    </p>

                    <span class="waste-item__count">
                      <strong>
                        {category.organizationCount}
                      </strong>{" "}
                      organisasi terkait
                    </span>
                  </div>
                </a>
              );
            },
          )}
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- ORGANIZATIONS                                                      -->
    <!-- ================================================================== -->

    <section class="dashboard-section dashboard-section--paper">
      <div class="dashboard-container">
        <div class="section-heading-row">
          <div class="section-heading">
            <span class="section-kicker">
              04 / PENGELOLA
            </span>

            <h2>
              Organisasi dalam ekosistem
            </h2>

            <p>
              Contoh organisasi publik yang dapat ditemukan
              melalui BINSIGHT.
            </p>
          </div>

          <a
            href="/organizations"
            class="section-link"
          >
            Lihat semua

            <ArrowRight
              size={16}
              stroke-width="2"
              aria-hidden="true"
            />
          </a>
        </div>

        {topOrganizations.length > 0 ? (
          <div class="organization-list">
            {topOrganizations.map(
              (organization, index) => (
                <a
                  href={`/organizations/${organization.slug}`}
                  class="organization-row"
                >
                  <span class="organization-row__index">
                    {String(index + 1).padStart(
                      2,
                      "0",
                    )}
                  </span>

                  <div class="organization-row__logo">
                    {organization.logo ? (
                      <img
                        src={organization.logo}
                        alt=""
                        loading="lazy"
                      />
                    ) : (
                      <Building2
                        size={21}
                        stroke-width="2"
                        aria-hidden="true"
                      />
                    )}
                  </div>

                  <div class="organization-row__body">
                    <div class="organization-row__top">
                      <h3>
                        {organization.name}
                      </h3>

                      {organization.verified && (
                        <span class="organization-row__verified">
                          <ShieldCheck
                            size={11}
                            stroke-width="2.2"
                            aria-hidden="true"
                          />

                          Terverifikasi
                        </span>
                      )}
                    </div>

                    <p>
                      {organization.shortDescription ??
                        organization.description}
                    </p>

                    <div class="organization-row__meta">
                      <span>
                        {organization.location.area}
                      </span>

                      <span>
                        {organization.wasteManaged.length}{" "}
                        kategori material
                      </span>
                    </div>
                  </div>

                  <ArrowRight
                    class="organization-row__arrow"
                    size={18}
                    stroke-width="2"
                    aria-hidden="true"
                  />
                </a>
              ),
            )}
          </div>
        ) : (
          <div class="panel__empty panel__empty--large panel__empty--light">
            Belum ada organisasi publik yang tersedia.
          </div>
        )}
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- DATA NOTE                                                          -->
    <!-- ================================================================== -->

    <section class="dashboard-section">
      <div class="dashboard-container">
        <div class="data-note">
          <div class="data-note__side">
            <span class="data-note__code">
              DATA / NOTE
            </span>

            <div class="data-note__icon">
              <CircleAlert
                size={22}
                stroke-width="2"
                aria-hidden="true"
              />
            </div>
          </div>

          <div class="data-note__content">
            <h2>
              Dashboard ini tidak menampilkan angka volume
              yang belum tervalidasi.
            </h2>

            <p>
              BINSIGHT menggunakan metrik berbasis entitas
              dan keterhubungan data. Informasi seperti tonase,
              kilogram, kapasitas, atau volume hanya layak
              ditampilkan ketika memiliki sumber data yang valid
              dan dapat dipertanggungjawabkan.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- ACTIONS                                                            -->
    <!-- ================================================================== -->

    <section class="dashboard-section dashboard-section--actions">
      <div class="dashboard-container">
        <div class="action-grid">
          <a
            href="/map"
            class="action-card action-card--primary"
          >
            <div class="action-card__top">
              <span>MAP / 01</span>

              <Map
                size={21}
                stroke-width="2"
                aria-hidden="true"
              />
            </div>

            <div class="action-card__body">
              <h2>
                Eksplorasi melalui peta
              </h2>

              <p>
                Hubungkan wilayah, lokasi, dan organisasi
                dalam konteks geografis Kabupaten Badung.
              </p>
            </div>

            <ArrowRight
              class="action-card__arrow"
              size={20}
              stroke-width="2"
              aria-hidden="true"
            />
          </a>

          <a
            href="/reports/create"
            class="action-card"
          >
            <div class="action-card__top">
              <span>REPORT / 02</span>

              <FileText
                size={21}
                stroke-width="2"
                aria-hidden="true"
              />
            </div>

            <div class="action-card__body">
              <h2>
                Sampaikan laporan
              </h2>

              <p>
                Laporkan kondisi persampahan atau lingkungan
                yang perlu diperhatikan.
              </p>
            </div>

            <ArrowRight
              class="action-card__arrow"
              size={20}
              stroke-width="2"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  /* ==========================================================================
     TOKENS
     ========================================================================== */

  .dashboard-page {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;

    --white: #fffef8;
    --muted: #6c7068;
    --warning: #ff6a00;

    --line: rgba(9, 10, 8, 0.18);
    --line-dark: rgba(255, 254, 248, 0.17);

    --container: 1320px;

    width: 100%;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .dashboard-container {
    width: min(
      var(--container),
      calc(100% - 40px)
    );
    margin-inline: auto;
  }

  /* ==========================================================================
     INTERACTION
     ========================================================================== */

  .dashboard-page a {
    -webkit-tap-highlight-color: transparent;
  }

  .dashboard-page a:focus-visible {
    outline: 3px solid var(--warning);
    outline-offset: 4px;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .dashboard-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 4px solid var(--ink);
    background:
      linear-gradient(
        135deg,
        var(--paper) 0%,
        var(--paper) 65%,
        var(--acid-soft) 65%,
        var(--acid-soft) 100%
      );
  }

  .dashboard-hero::before {
    position: absolute;
    top: 0;
    right: 14%;
    width: 1px;
    height: 100%;
    background: rgba(9, 10, 8, 0.08);
    content: "";
  }

  .dashboard-hero::after {
    position: absolute;
    right: -7rem;
    bottom: -13rem;
    width: 31rem;
    height: 31rem;
    border: 3px solid rgba(9, 10, 8, 0.09);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .dashboard-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      320px;
    gap: 4rem;
    align-items: end;
    min-height: 580px;
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .dashboard-hero__main {
    max-width: 900px;
  }

  .dashboard-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-bottom: 1.2rem;
    padding: 0.47rem 0.7rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .dashboard-kicker__dot {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--acid);
  }

  .dashboard-hero h1 {
    max-width: 980px;
    margin: 0;
    color: var(--ink);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: clamp(
      3rem,
      7.1vw,
      7.1rem
    );
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.067em;
    text-transform: uppercase;
  }

  .dashboard-hero h1 span {
    display: block;
    color: var(--warning);
  }

  .dashboard-hero__main > p {
    max-width: 700px;
    margin: 1.7rem 0 0;
    color: rgba(9, 10, 8, 0.7);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .dashboard-hero__actions {
