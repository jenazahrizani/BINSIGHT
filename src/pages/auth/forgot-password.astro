<style>
  .forgot-password__trust {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: -1px;
    padding: 12px;
    border: 1px solid #cfcabd;
    background: #f2f0e6;
  }

  .forgot-password__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    border: 2px solid #090a08;
    background: #dfff00;
    color: #090a08;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.6rem;
    font-weight: 900;
    line-height: 1;
  }

  .forgot-password__trust strong {
    display: block;
    color: #090a08;
    font-size: 0.68rem;
    font-weight: 850;
    line-height: 1.4;
  }

  .forgot-password__trust p {
    margin: 3px 0 0;
    color: #6c7068;
    font-size: 0.61rem;
    line-height: 1.6;
  }

  .forgot-password__after {
    margin-top: 30px;
  }

  .forgot-password__after-head {
    display: grid;
    grid-template-columns: auto minmax(30px, 1fr) auto;
    gap: 10px;
    align-items: center;
    color: #777c73;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    line-height: 1.3;
  }

  .forgot-password__after-line {
    height: 1px;
    background: #090a08;
  }

  .forgot-password__after-head strong {
    color: #090a08;
  }

  .forgot-password__steps {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .forgot-password__step {
    display: grid;
    grid-template-columns: 27px minmax(0, 1fr);
    gap: 9px;
    min-width: 0;
    padding: 10px;
    border: 1px solid #cfcabd;
    background: #fffef8;
  }

  .forgot-password__step--active {
    border-color: #090a08;
    background: #efff70;
  }

  .forgot-password__step-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    background: #090a08;
    color: #dfff00;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.56rem;
    font-weight: 900;
    line-height: 1;
  }

  .forgot-password__step strong {
    display: block;
    color: #090a08;
    font-size: 0.66rem;
    font-weight: 850;
    line-height: 1.35;
  }

  .forgot-password__step p {
    margin: 3px 0 0;
    color: #70756c;
    font-size: 0.57rem;
    line-height: 1.55;
  }

  @media (max-width: 600px) {
    .forgot-password__after {
      margin-top: 24px;
    }

    .forgot-password__steps {
      grid-template-columns: 1fr;
    }

    .forgot-password__step {
      grid-template-columns: 30px minmax(0, 1fr);
      align-items: center;
    }

    .forgot-password__step-index {
      width: 30px;
      height: 30px;
    }
  }
</style>