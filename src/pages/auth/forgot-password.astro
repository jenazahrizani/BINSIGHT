---

import AuthLayout from "../../layouts/AuthLayout.astro";
import AuthCard from "../../components/auth/AuthCard.astro";
import AuthInput from "../../components/auth/AuthInput.astro";
--------------------------------------------------------------

<AuthLayout
title="Lupa password"
description="Atur ulang password akun BINSIGHT untuk mendapatkan kembali akses."
eyebrow="BADUNG WASTE INTELLIGENCE"
heading="ACCOUNT RECOVERY"
showBackLink={true}
backHref="/auth/sign-in"
backLabel="Kembali ke masuk"

>

  <Fragment slot="head">
    <meta
      name="robots"
      content="noindex,nofollow"
    />
  </Fragment>

<AuthCard
eyebrow="ACCOUNT RECOVERY"
title="Lupa password?"
description="Masukkan email yang terhubung dengan akun BINSIGHT. Instruksi pemulihan akan dikirim ke alamat tersebut."
actionLabel="Kirim link reset"
footerText="Sudah ingat password?"
footerLabel="Masuk"
footerHref="/auth/sign-in"

>

```
<AuthInput
```

```
  label="Email"
  name="email"
  id="forgot-email"
  type="email"
  placeholder="nama@email.com"
  autocomplete="email"
  inputmode="email"
  required
  hint="Gunakan email yang kamu gunakan saat membuat akun BINSIGHT."
/>

<div class="forgot-password__trust">
  <div
    class="forgot-password__trust-icon"
    aria-hidden="true"
  >
    ✓
  </div>

  <div>
    <strong>
      Pemulihan akun tetap aman
    </strong>

    <p>
      Setelah permintaan dikirim, periksa inbox email
      termasuk folder spam atau promosi.
    </p>
  </div>
</div>
