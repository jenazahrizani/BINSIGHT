---

import AuthLayout from "../../layouts/AuthLayout.astro";
import AuthCard from "../../components/auth/AuthCard.astro";
import AuthInput from "../../components/auth/AuthInput.astro";
import AuthPasswordInput from "../../components/auth/AuthPasswordInput.astro";
------------------------------------------------------------------------------

<AuthLayout
title="Daftar"
description="Buat akun BINSIGHT untuk menjadi bagian dari ekosistem informasi persampahan Kabupaten Badung."
eyebrow="BADUNG WASTE INTELLIGENCE"
heading="CREATE ACCOUNT"
showBackLink={true}
backHref="/"
backLabel="Kembali ke BINSIGHT"

>

  <Fragment slot="head">
    <meta
      name="robots"
      content="noindex,nofollow"
    />
  </Fragment>

<AuthCard
eyebrow="NEW USER"
title="Buat akun BINSIGHT"
description="Daftarkan akun untuk mengakses fitur dan layanan yang relevan dengan ekosistem BINSIGHT."
actionLabel="Buat akun"
footerText="Sudah punya akun?"
footerLabel="Masuk"
footerHref="/auth/sign-in"

>

```
<AuthInput
```

```
  label="Nama lengkap"
  name="name"
  id="signup-name"
  type="text"
  placeholder="Nama lengkap"
  autocomplete="name"
  required
/>

<AuthInput
  label="Email"
  name="email"
  id="signup-email"
  type="email"
  placeholder="nama@email.com"
  autocomplete="email"
  inputmode="email"
  required
/>

<AuthPasswordInput
  label="Password"
  name="password"
  id="signup-password"
  placeholder="Buat password"
  autocomplete="new-password"
  required
/>

<AuthPasswordInput
  label="Konfirmasi password"
  name="passwordConfirmation"
  id="signup-password-confirmation"
  placeholder="Ulangi password"
  autocomplete="new-password"
  required
/>

<label class="sign-up__terms">
  <input
    type="checkbox"
    name="terms"
    value="accepted"
    required
  />

  <span
    class="sign-up__checkbox"
    aria-hidden="true"
  ></span>

  <span class="sign-up__terms-copy">
    Saya menyetujui ketentuan penggunaan dan
    memahami bahwa data akun digunakan untuk
    keperluan layanan BINSIGHT.
  </span>
</label>

<div class="sign-up__note">
  <span
    class="sign-up__note-mark"
    aria-hidden="true"
  >
    +
  </span>

  <p>
    Gunakan alamat email aktif yang dapat kamu akses
    untuk kebutuhan verifikasi dan pemulihan akun.
  </p>
</div>
