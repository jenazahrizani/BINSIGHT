<style>
  .sign-up__terms {
    position: relative;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    margin-top: -1px;
    color: #5d6259;
    cursor: pointer;
    font-size: 0.65rem;
    line-height: 1.65;
    user-select: none;
  }

  .sign-up__terms input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .sign-up__checkbox {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    margin-top: 2px;
    border: 2px solid #090a08;
    background: #fffef8;
    box-shadow: 2px 2px 0 #090a08;
    transition:
      background 120ms ease,
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .sign-up__checkbox::after {
    width: 8px;
    height: 4px;
    border-bottom: 2px solid #090a08;
    border-left: 2px solid #090a08;
    content: "";
    opacity: 0;
    transform: rotate(-45deg) translateY(-1px);
    transition: opacity 120ms ease;
  }

  .sign-up__terms input:checked
    + .sign-up__checkbox {
    background: #dfff00;
  }

  .sign-up__terms input:checked
    + .sign-up__checkbox::after {
    opacity: 1;
  }

  .sign-up__terms:hover .sign-up__checkbox {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 #090a08;
  }

  .sign-up__terms input:focus-visible
    + .sign-up__checkbox {
    outline: 3px solid #dfff00;
    outline-offset: 3px;
  }

  .sign-up__terms-copy {
    min-width: 0;
  }

  .sign-up__terms-copy::first-letter {
    color: #090a08;
  }

  .sign-up__note {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: -2px;
    padding: 10px 11px;
    border-left: 3px solid #dfff00;
    background: rgba(223, 255, 0, 0.16);
  }

  .sign-up__note-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
    border: 1px solid #090a08;
    background: #090a08;
    color: #dfff00;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.65rem;
    font-weight: 900;
    line-height: 1;
  }

  .sign-up__note p {
    margin: 0;
    color: #5d6259;
    font-size: 0.62rem;
    line-height: 1.6;
  }

  .sign-up__after {
    margin-top: 30px;
  }

  .sign-up__after-heading {
    display: grid;
    grid-template-columns: auto minmax(30px, 1fr) auto;
    gap: 10px;
    align-items: center;
  }

  .sign-up__after-kicker,
  .sign-up__after-index {
    color: #777c73;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    line-height: 1.3;
  }

  .sign-up__after-rule {
    height: 1px;
    background: #090a08;
  }

  .sign-up__after-index {
    color: #090a08;
  }

  .sign-up__after-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 14px;
  }

  .sign-up__after-grid > div {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .sign-up__after-grid span {
    color: #858a81;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.3;
  }

  .sign-up__after-grid strong {
    overflow: hidden;
    color: #090a08;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.55rem;
    font-weight: 800;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .sign-up__terms {
      font-size: 0.62rem;
    }

    .sign-up__after {
      margin-top: 24px;
    }

    .sign-up__after-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .sign-up__after-grid > div {
      grid-template-columns: 90px minmax(0, 1fr);
      align-items: center;
      gap: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sign-up__checkbox {
      transition: none;
    }

    .sign-up__checkbox::after {
      transition: none;
    }
  }
</style>