---
/**
 * ============================================================================
 * BINSIGHT — ORGANIZATION DETAIL
 * ============================================================================
 * Public organization profile.
 *
 * Route:
 * /organizations/[slug]
 *
 * Data source:
 * src/lib/data/organizations.ts
 *
 * Prinsip:
 * - Hanya organisasi publik + terverifikasi yang memiliki halaman.
 * - Optional metadata tidak diasumsikan tersedia.
 * - Tidak membuat data operasional baru.
 * - Tidak menggunakan PageHeader agar visual konsisten dengan
 *   dashboard, organizations directory, dan waste directory.
 * ============================================================================
 */

import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  Building2,
  Check,
  CircleCheck,
  ExternalLink,
  Globe,
  Mail,
  Map,
  MapPin,
  Phone,
  Recycle,
  ShieldCheck,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import {
  getPublicOrganizations,
} from "@lib/data/organizations";

import type {
  Organization,
} from "@lib/data/organizations";

/* ============================================================================
   STATIC PATHS
   ========================================================================== */

export async function getStaticPaths() {
  const organizations =
    getPublicOrganizations();

  return organizations
    .filter(
      (organization: Organization) =>
        organization.isPublic === true &&
        organization.status === "verified" &&
        Boolean(
          organization.slug?.trim(),
        ),
    )
    .map(
      (organization: Organization) => ({
        params: {
          slug: organization.slug,
        },
        props: {
          organization,
        },
      }),
    );
}

/* ============================================================================
   PROPS
   ========================================================================== */

interface Props {
  organization: Organization;
}

const {
  organization,
} = Astro.props as Props;

/* ============================================================================
   OPTIONAL RECORD DATA
   ========================================================================== */

const organizationRecord =
  organization as Organization &
    Record<string, unknown>;

const readString = (
  key: string,
): string | undefined => {
  const value =
    organizationRecord[key];

  return typeof value === "string" &&
    value.trim().length > 0
    ? value.trim()
    : undefined;
};

const readStringArray = (
  key: string,
): string[] => {
  const value =
    organizationRecord[key];

  if (!Array.isArray(value)) {
    return [];
  }

  return value.filter(
    (item): item is string =>
      typeof item === "string" &&
      item.trim().length > 0,
  );
};

/* ============================================================================
   CORE FIELDS
   ========================================================================== */

const organizationName =
  organization.name.trim();

const organizationDescription =
  readString("description") ??
  readString("about") ??
  `Profil ${organizationName} dalam ekosistem pengelolaan persampahan Kabupaten Badung.`;

const organizationType =
  readString("typeLabel") ??
  readString("organizationTypeLabel") ??
  readString("type");

const website =
  readString("website") ??
  readString("websiteUrl");

const email =
  readString("email") ??
  readString("contactEmail");

const phone =
  readString("phone") ??
  readString("phoneNumber") ??
  readString("contactPhone");

const logo =
  readString("logo") ??
  readString("logoUrl") ??
  readString("image") ??
  readString("imageUrl");

const address =
  organization.location?.address?.trim() ||
  undefined;

const area =
  organization.location?.area?.trim() ||
  "Kabupaten Badung";

const rawLatitude =
  organization.location?.latitude;

const rawLongitude =
  organization.location?.longitude;

const latitude =
  typeof rawLatitude === "number" &&
  Number.isFinite(rawLatitude)
    ? rawLatitude
    : undefined;

const longitude =
  typeof rawLongitude === "number" &&
  Number.isFinite(rawLongitude)
    ? rawLongitude
    : undefined;

/* ============================================================================
   OPTIONAL WASTE / PROCESS DATA
   ========================================================================== */

const wasteIds =
  readStringArray("wasteIds");

const wasteNames =
  readStringArray("wasteNames");

const processNames =
  readStringArray("processNames");

/* ============================================================================
   LOCATION
   ========================================================================== */

const hasCoordinates =
  latitude !== undefined &&
  longitude !== undefined;

const locationParts = [
  address,
  area,
  "Bali",
].filter(
  (
    value,
  ): value is string =>
    Boolean(value),
);

const locationLabel =
  Array.from(
    new Set(locationParts),
  ).join(", ");

const googleMapsQuery =
  hasCoordinates
    ? `${latitude},${longitude}`
    : locationLabel;

const googleMapsUrl =
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
    googleMapsQuery,
  )}`;

/* ============================================================================
   CONTACT
   ========================================================================== */

type ContactItem = {
  label: string;
  value: string;
  href: string;
  external?: boolean;
  icon:
    | typeof Phone
    | typeof Mail
    | typeof Globe;
};

const contactItems: ContactItem[] = [];

if (phone) {
  contactItems.push({
    label: "Telepon",
    value: phone,
    href: `tel:${phone.replace(
      /[^\d+]/g,
      "",
    )}`,
    icon: Phone,
  });
}

if (email) {
  contactItems.push({
    label: "Email",
    value: email,
    href: `mailto:${email}`,
    icon: Mail,
  });
}

if (website) {
  contactItems.push({
    label: "Website",
    value: website,
    href: website,
    external: true,
    icon: Globe,
  });
}

/* ============================================================================
   STATUS
   ========================================================================== */

const statusLabel =
  organization.status === "verified"
    ? "Terverifikasi"
    : "Belum terverifikasi";

/* ============================================================================
   CANONICAL / STRUCTURED DATA
   ========================================================================== */

const canonicalPath =
  `/organizations/${encodeURIComponent(
    organization.slug,
  )}`;

const canonicalUrl =
  new URL(
    canonicalPath,
    Astro.url.origin,
  ).toString();

let absoluteLogoUrl:
  | string
  | undefined;

if (logo) {
  try {
    absoluteLogoUrl =
      new URL(
        logo,
        Astro.url.origin,
      ).toString();
  } catch {
    absoluteLogoUrl =
      undefined;
  }
}

const schema = {
  "@context":
    "https://schema.org",
  "@type": "Organization",
  name: organizationName,
  description:
    organizationDescription,
  url: canonicalUrl,

  ...(absoluteLogoUrl
    ? {
        logo: absoluteLogoUrl,
      }
    : {}),

  ...(website
    ? {
        sameAs: [website],
      }
    : {}),

  ...(address || area
    ? {
        address: {
          "@type":
            "PostalAddress",

          ...(address
            ? {
                streetAddress:
                  address,
              }
            : {}),

          addressLocality:
            area,

          addressRegion:
            "Bali",

          addressCountry:
            "ID",
        },
      }
    : {}),

  ...(hasCoordinates
    ? {
        location: {
          "@type": "Place",
          name:
            organizationName,
          geo: {
            "@type":
              "GeoCoordinates",
            latitude,
            longitude,
          },
        },
      }
    : {}),
};
---

<PublicLayout
  title={`${organizationName} — Organisasi | BINSIGHT`}
  description={organizationDescription}
>
  <!-- ====================================================================== -->
  <!-- STRUCTURED DATA                                                       -->
  <!-- ====================================================================== -->

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema)}
  ></script>

  <main
    class="organization-page"
    data-organization-detail
  >
    <!-- ================================================================== -->
    <!-- HERO                                                               -->
    <!-- ================================================================== -->

    <section class="organization-hero">
      <div class="organization-container">
        <div class="organization-hero__grid">
          <div class="organization-hero__main">
            <div class="organization-kicker">
              <span
                class="organization-kicker__dot"
                aria-hidden="true"
              ></span>

              BINSIGHT / ORGANISASI
            </div>

            <div class="organization-hero__identity">
              <div class="organization-hero__logo">
                {
                  logo ? (
                    <img
                      src={logo}
                      alt={`Logo ${organizationName}`}
                      width="112"
                      height="112"
                      loading="eager"
                      decoding="async"
                    />
                  ) : (
                    <Building2
                      size={48}
                      stroke-width={1.7}
                      aria-hidden="true"
                    />
                  )
                }
              </div>

              <div class="organization-hero__content">
                <div class="organization-hero__badges">
                  <span class="organization-badge organization-badge--verified">
                    <CircleCheck
                      size={14}
                      stroke-width={2.1}
                      aria-hidden="true"
                    />

                    {statusLabel}
                  </span>

                  {
                    organizationType && (
                      <span class="organization-badge">
                        <Building2
                          size={14}
                          stroke-width={1.8}
                          aria-hidden="true"
                        />

                        {organizationType}
                      </span>
                    )
                  }
                </div>

                <h1>
                  {organizationName}
                </h1>

                <div class="organization-hero__location">
                  <MapPin
                    size={17}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />

                  <span>
                    {locationLabel}
                  </span>
                </div>
              </div>
            </div>

            <p class="organization-hero__description">
              {organizationDescription}
            </p>

            <div class="organization-hero__actions">
              <a
                href="#informasi"
                class="organization-button organization-button--primary"
              >
                <span>
                  Lihat informasi
                </span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a
                href="/map"
                class="organization-button organization-button--secondary"
              >
                <Map
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />

                <span>
                  Lihat peta
                </span>
              </a>
            </div>
          </div>

          <aside class="organization-hero__aside">
            <div class="organization-hero__aside-top">
              <span>
                PROFILE STATUS
              </span>

              <ShieldCheck
                size={21}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <strong>
              Data publik
              terverifikasi.
            </strong>

            <p>
              Profil ini berasal dari organisasi yang
              berstatus publik dan terverifikasi dalam
              data BINSIGHT.
            </p>

            <div class="organization-hero__aside-code">
              <span>ENTITY</span>

              <strong>
                VERIFIED
              </strong>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- CONTENT                                                            -->
    <!-- ================================================================== -->

    <section class="organization-content">
      <div class="organization-container">
        <div class="organization-grid">
          <!-- ============================================================ -->
          <!-- MAIN                                                           -->
          <!-- ============================================================ -->

          <div class="organization-main">
            <!-- PROFILE -->
            <section
              id="informasi"
              class="organization-card"
            >
              <header class="organization-card__header">
                <div>
                  <span class="organization-card__eyebrow">
                    01 / PROFIL
                  </span>

                  <h2>
                    Tentang organisasi.
                  </h2>
                </div>

                <div class="organization-card__icon">
                  <Building2
                    size={21}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </header>

              <div class="organization-card__body">
                <p class="organization-card__text">
                  {organizationDescription}
                </p>
              </div>
            </section>

            <!-- WASTE -->
            <section class="organization-card">
              <header class="organization-card__header">
                <div>
                  <span class="organization-card__eyebrow">
                    02 / PENGELOLAAN
                  </span>

                  <h2>
                    Aktivitas persampahan.
                  </h2>
                </div>

                <div class="organization-card__icon">
                  <Recycle
                    size={21}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </header>

              <div class="organization-card__body">
                {
                  wasteNames.length >
                  0 ? (
                    <div class="organization-section">
                      <h3>
                        Jenis sampah
                        yang dikelola
                      </h3>

                      <div class="organization-tags">
                        {wasteNames.map(
                          (
                            name: string,
                          ) => (
                            <span class="organization-tag">
                              <Recycle
                                size={13}
                                stroke-width={1.9}
                                aria-hidden="true"
                              />

                              {name}
                            </span>
                          ),
                        )}
                      </div>
                    </div>
                  ) : wasteIds.length >
                    0 ? (
                    <div class="organization-empty">
                      <Recycle
                        size={23}
                        stroke-width={1.7}
                        aria-hidden="true"
                      />

                      <div>
                        <strong>
                          Data sampah
                          terhubung
                        </strong>

                        <p>
                          Organisasi memiliki{" "}
                          {wasteIds.length}{" "}
                          data sampah
                          terhubung pada
                          sistem BINSIGHT.
                        </p>
                      </div>
                    </div>
                  ) : (
                    <div class="organization-empty">
                      <Recycle
                        size={23}
                        stroke-width={1.7}
                        aria-hidden="true"
                      />

                      <div>
                        <strong>
                          Belum ada data
                          pengelolaan
                        </strong>

                        <p>
                          Informasi jenis
                          sampah yang
                          dikelola organisasi
                          belum tersedia
                          secara publik.
                        </p>
                      </div>
                    </div>
                  )
                }

                {
                  processNames.length >
                    0 && (
                    <div class="organization-section">
                      <h3>
                        Proses pengelolaan
                      </h3>

                      <div class="organization-process-list">
                        {processNames.map(
                          (
                            process: string,
                            index: number,
                          ) => (
                            <div class="organization-process">
                              <span class="organization-process__number">
                                {String(
                                  index + 1,
                                ).padStart(
                                  2,
                                  "0",
                                )}
                              </span>

                              <span class="organization-process__name">
                                {process}
                              </span>

                              <Check
                                size={15}
                                stroke-width={2}
                                aria-hidden="true"
                              />
                            </div>
                          ),
                        )}
                      </div>
                    </div>
                  )
                }
              </div>
            </section>

            <!-- LOCATION -->
            <section class="organization-card">
              <header class="organization-card__header">
                <div>
                  <span class="organization-card__eyebrow">
                    03 / LOKASI
                  </span>

                  <h2>
                    Lokasi organisasi.
                  </h2>
                </div>

                <div class="organization-card__icon">
                  <MapPin
                    size={21}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </header>

              <div class="organization-card__body">
                <div class="organization-location">
                  <div class="organization-location__icon">
                    <MapPin
                      size={19}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>
                      {area}
                    </strong>

                    <span>
                      {
                        address ??
                        "Kabupaten Badung, Bali"
                      }
                    </span>
                  </div>
                </div>

                {
                  hasCoordinates ? (
                    <div class="organization-coordinates">
                      <div>
                        <span>
                          LATITUDE
                        </span>

                        <strong>
                          {latitude?.toFixed(
                            6,
                          )}
                        </strong>
                      </div>

                      <div>
                        <span>
                          LONGITUDE
                        </span>

                        <strong>
                          {longitude?.toFixed(
                            6,
                          )}
                        </strong>
                      </div>
                    </div>
                  ) : (
                    <div class="organization-note">
                      <MapPin
                        size={15}
                        stroke-width={1.8}
                        aria-hidden="true"
                      />

                      Koordinat lokasi belum
                      tersedia pada data publik.
                    </div>
                  )
                }

                <a
                  href={googleMapsUrl}
                  class="organization-map-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Map
                    size={16}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />

                  Buka lokasi di peta

                  <ExternalLink
                    size={14}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </a>
              </div>
            </section>
          </div>

          <!-- ============================================================ -->
          <!-- SIDEBAR                                                        -->
          <!-- ============================================================ -->

          <aside class="organization-sidebar">
            <!-- STATUS -->
            <section class="organization-side-card">
              <header class="organization-side-card__header">
                <ShieldCheck
                  size={20}
                  stroke-width={1.9}
                  aria-hidden="true"
                />

                <h2>
                  Status organisasi
                </h2>
              </header>

              <div class="organization-status">
                <div class="organization-status__icon">
                  <CircleCheck
                    size={19}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

                <div>
                  <strong>
                    {statusLabel}
                  </strong>

                  <p>
                    Informasi organisasi ditandai sebagai
                    data publik oleh sistem BINSIGHT.
                  </p>
                </div>
              </div>
            </section>

            <!-- CONTACT -->
            {
              contactItems.length >
                0 && (
                <section class="organization-side-card">
                  <header class="organization-side-card__header">
                    <Globe
                      size={20}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />

                    <h2>
                      Kontak
                    </h2>
                  </header>

                  <div class="organization-contact-list">
                    {contactItems.map(
                      (
                        item,
                      ) => {
                        const ContactIcon =
                          item.icon;

                        return (
                          <a
                            href={
                              item.href
                            }
                            class="organization-contact"
                            target={
                              item.external
                                ? "_blank"
                                : undefined
                            }
                            rel={
                              item.external
                                ? "noopener noreferrer"
                                : undefined
                            }
                          >
                            <span class="organization-contact__icon">
                              <ContactIcon
                                size={16}
                                stroke-width={1.9}
                                aria-hidden="true"
                              />
                            </span>

                            <span class="organization-contact__copy">
                              <span>
                                {item.label}
                              </span>

                              <strong>
                                {
                                  item.value
                                }
                              </strong>
                            </span>

                            <ArrowUpRight
                              size={14}
                              stroke-width={1.9}
                              aria-hidden="true"
                            />
                          </a>
                        );
                      },
                    )}
                  </div>
                </section>
              )
            }

            <!-- ECOSYSTEM -->
            <section class="organization-side-card organization-side-card--dark">
              <header class="organization-side-card__header">
                <Recycle
                  size={20}
                  stroke-width={1.9}
                  aria-hidden="true"
                />

                <h2>
                  Jelajahi ekosistem
                </h2>
              </header>

              <p>
                Temukan organisasi lain, jenis sampah,
                lokasi pengelolaan, dan data persampahan
                dalam konteks Kabupaten Badung.
              </p>

              <div class="organization-side-links">
                <a href="/organizations">
                  <span>
                    Semua organisasi
                  </span>

                  <ArrowRight
                    size={15}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </a>

                <a href="/waste">
                  <span>
                    Jenis sampah
                  </span>

                  <ArrowRight
                    size={15}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </a>

                <a href="/map">
                  <span>
                    Peta persampahan
                  </span>

                  <ArrowRight
                    size={15}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </a>
              </div>
            </section>

            <!-- BACK -->
            <a
              href="/organizations"
              class="organization-back-link"
            >
              <ArrowLeft
                size={15}
                stroke-width={2}
                aria-hidden="true"
              />

              Kembali ke organisasi
            </a>
          </aside>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  /* ==========================================================================
     TOKENS
     ========================================================================== */

  .organization-page {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;

    --white: #fffef8;
    --muted: #6c7068;
    --warning: #ff6a00;

    --line: rgba(9, 10, 8, 0.18);
    --line-dark: rgba(255, 254, 248, 0.18);

    --container: 1320px;

    width: 100%;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .organization-container {
    width: min(
      var(--container),
      calc(100% - 40px)
    );
    margin-inline: auto;
  }

  .organization-page a {
    -webkit-tap-highlight-color: transparent;
  }

  .organization-page a:focus-visible {
    outline: 3px solid var(--warning);
    outline-offset: 4px;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .organization-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 4px solid var(--ink);
    background:
      linear-gradient(
        115deg,
        var(--paper) 0%,
        var(--paper) 68%,
        var(--acid-soft) 68%,
        var(--acid-soft) 100%
      );
  }

  .organization-hero::before {
    position: absolute;
    top: 0;
    right: 16%;
    width: 1px;
    height: 100%;
    background: rgba(9, 10, 8, 0.08);
    content: "";
  }

  .organization-hero::after {
    position: absolute;
    right: -8rem;
    bottom: -13rem;
    width: 31rem;
    height: 31rem;
    border: 3px solid rgba(9, 10, 8, 0.08);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .organization-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      320px;
    gap: 4rem;
    align-items: end;
    min-height: 545px;
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .organization-hero__main {
    min-width: 0;
    max-width: 900px;
  }

  .organization-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-bottom: 1.5rem;
    padding: 0.48rem 0.7rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .organization-kicker__dot {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--acid);
  }

  .organization-hero__identity {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem;
    align-items: start;
  }

  .organization-hero__logo {
    display: grid;
    width: 6.2rem;
    height: 6.2rem;
    place-items: center;
    overflow: hidden;
    border: 3px solid var(--ink);
    background: var(--white);
    color: var(--ink);
  }

  .organization-hero__logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.45rem;
  }

  .organization-hero__content {
    min-width: 0;
  }

  .organization-hero__badges {
    display: flex;
