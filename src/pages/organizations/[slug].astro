---

/**

* ============================================================================
* BINSIGHT — ORGANIZATION DETAIL
* ============================================================================
* Public organization profile.
*
* Route:
* /organizations/[slug]
*
* Responsibilities:
* * Generate public organization pages from verified/public organizations
* * Present identity and location information
* * Present optional profile metadata without assuming unavailable fields
* * Provide map/report/discovery actions
* * Generate accessible breadcrumbs and structured data
* * Keep rendering safe when optional organization data is absent
*
* Data source:
* src/lib/data/organizations.ts
* ============================================================================
  */

import {
ArrowLeft,
ArrowUpRight,
Building2,
Check,
CircleCheck,
ExternalLink,
Globe,
Mail,
Map,
MapPin,
Phone,
Recycle,
ShieldCheck,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";

import {
getPublicOrganizations,
type Organization,
} from "@lib/data/organizations";

export async function getStaticPaths() {
const organizations = await getPublicOrganizations();

return organizations
.filter(
(organization: Organization) =>
organization.isPublic === true &&
organization.status === "verified" &&
Boolean(organization.slug),
)
.map((organization: Organization) => ({
params: {
slug: organization.slug,
},
props: {
organization,
},
}));
}

interface Props {
organization: Organization;
}

const { organization } = Astro.props as Props;

/**

* Optional fields are read through a narrow record view.
*
* This intentionally keeps this page compatible with the proven Organization
* contract while still allowing richer Firestore records to populate the UI.
  */
  const organizationRecord =
  organization as Organization &
  Record<string, unknown>;

const readString = (
key: string,
): string | undefined => {
const value = organizationRecord[key];

return typeof value === "string" && value.trim().length > 0
? value.trim()
: undefined;
};

const readStringArray = (
key: string,
): string[] => {
const value = organizationRecord[key];

return Array.isArray(value)
? value.filter(
(item): item is string =>
typeof item === "string" &&
item.trim().length > 0,
)
: [];
};

const organizationName = organization.name.trim();

const organizationDescription =
readString("description") ??
readString("about") ??
`Profil ${organizationName} dalam ekosistem pengelolaan persampahan Kabupaten Badung.`;

const organizationType =
readString("typeLabel") ??
readString("organizationTypeLabel") ??
readString("type");

const website =
readString("website") ??
readString("websiteUrl");

const email =
readString("email") ??
readString("contactEmail");

const phone =
readString("phone") ??
readString("phoneNumber") ??
readString("contactPhone");

const logo =
readString("logo") ??
readString("logoUrl") ??
readString("image") ??
readString("imageUrl");

const address =
organization.location.address?.trim() ||
undefined;

const area =
organization.location.area?.trim() ||
"Kabupaten Badung";

const latitude =
typeof organization.location.latitude === "number" &&
Number.isFinite(organization.location.latitude)
? organization.location.latitude
: undefined;

const longitude =
typeof organization.location.longitude === "number" &&
Number.isFinite(organization.location.longitude)
? organization.location.longitude
: undefined;

const wasteIds = readStringArray("wasteIds");
const wasteNames = readStringArray("wasteNames");

const processNames =
readStringArray("processNames");

const hasCoordinates =
latitude !== undefined &&
longitude !== undefined;

const locationLabel = [
address,
area,
"Kabupaten Badung",
].filter(Boolean).join(", ");

const contactItems = [
{
enabled: Boolean(phone),
href: phone
? `tel:${phone.replace(/[^\d+]/g, "")}`
: undefined,
label: "Telepon",
value: phone,
icon: Phone,
},
{
enabled: Boolean(email),
href: email
? `mailto:${email}`
: undefined,
label: "Email",
value: email,
icon: Mail,
},
{
enabled: Boolean(website),
href: website,
label: "Website",
value: website,
icon: Globe,
},
].filter(
(
item,
): item is {
enabled: true;
href: string;
label: string;
value: string;
icon: typeof Phone;
} => Boolean(item.enabled && item.href && item.value),
);

const breadcrumbItems = [
{
label: "Beranda",
href: "/",
},
{
label: "Organisasi",
href: "/organizations",
},
{
label: organizationName,
},
];

const canonicalPath =
`/organizations/${encodeURIComponent(organization.slug)}`;

const canonicalUrl =
new URL(
canonicalPath,
Astro.site ?? Astro.url.origin,
).toString();

const schema = {
"@context": "https://schema.org",
"@type": "Organization",
name: organizationName,
description: organizationDescription,
url: canonicalUrl,
...(logo
? {
logo: new URL(
logo,
Astro.site ?? Astro.url.origin,
).toString(),
}
: {}),
...(website
? {
sameAs: [website],
}
: {}),
...(address || area
? {
address: {
"@type": "PostalAddress",
...(address
? {
streetAddress: address,
}
: {}),
addressLocality: area,
addressRegion: "Bali",
addressCountry: "ID",
},
}
: {}),
...(hasCoordinates
? {
location: {
"@type": "Place",
name: organizationName,
geo: {
"@type": "GeoCoordinates",
latitude,
longitude,
},
},
}
: {}),
};

const mapQuery =
hasCoordinates
? `${latitude},${longitude}`
: encodeURIComponent(locationLabel);

const statusLabel =
organization.status === "verified"
? "Terverifikasi"
: "Belum terverifikasi";

