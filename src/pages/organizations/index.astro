    color: #0f172a;
    font-size: 1.2rem;
  }

  .hero-stat > span:last-child {
    grid-column: 2;
    margin-top: -5px;
    color: #64748b;
    font-size: 0.76rem;
  }

  .directory-section,
  .trust-section {
    margin-top: 58px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 7px 0 0;
    color: #0f172a;
    font-size: clamp(
      1.55rem,
      2.6vw,
      2.1rem
    );
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .section-heading p {
    max-width: 700px;
    margin: 8px 0 0;
