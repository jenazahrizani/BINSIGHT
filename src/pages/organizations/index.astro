      transform 140ms ease,
      box-shadow 140ms ease,
      background 140ms ease;
  }

  .organizations-button:hover {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .organizations-button--primary {
    background: var(--ink);
    color: var(--acid);
  }

  .organizations-button--secondary {
    background: var(--white);
    color: var(--ink);
  }

  .organizations-button--secondary:hover {
    background: var(--acid);
  }

  /* ==========================================================================
     HERO ASIDE
     ========================================================================== */

  .organizations-hero__aside {
    padding: 1.2rem;
    border: 3px solid var(--ink);
    background: var(--ink);
    color: var(--white);
    box-shadow: 8px 8px 0 var(--warning);
  }

  .organizations-hero__aside-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .organizations-hero__aside > strong {
    display: block;
    max-width: 230px;
    margin-top: 2rem;
    color: var(--white);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .organizations-hero__aside > p {
    margin: 0.85rem 0 0;
    color: rgba(255, 254, 248, 0.62);
    font-size: 0.68rem;
    line-height: 1.65;
  }

  .organizations-hero__stats {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-dark);
  }

  .hero-stat span {
    display: block;
    color: rgba(255, 254, 248, 0.4);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.45rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .hero-stat strong {
    display: block;
    margin-top: 0.2rem;
    color: var(--acid);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1;
  }

  /* ==========================================================================
     DIRECTORY
     ========================================================================== */

  .directory-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .section-heading {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      auto;
    gap: 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .section-heading > div {
    min-width: 0;
  }

  .section-kicker {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--ink);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: clamp(
      2rem,
      4vw,
      3.2rem
    );
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .section-heading p {
    max-width: 650px;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .section-heading__meta {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    padding-bottom: 0.15rem;
  }

  .section-heading__meta span {
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .section-heading__meta strong {
    color: var(--ink);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: 1.15rem;
    font-weight: 900;
  }

  /* ==========================================================================
     TOOLS
     ========================================================================== */

  .directory-tools {
    display: flex;
    align-items: stretch;
    gap: 0.7rem;
  }

  .search-field {
    display: flex;
    align-items: center;
    min-width: 0;
    width: min(100%, 720px);
    min-height: 3.15rem;
    gap: 0.6rem;
    padding: 0 0.9rem;
    border: 2px solid var(--ink);
    background: var(--white);
    color: var(--ink);
  }

  .search-field:focus-within {
    box-shadow: 5px 5px 0 var(--ink);
  }

  .search-field svg {
    flex: 0 0 auto;
  }

  .search-field input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.76rem;
  }

  .search-field input::placeholder {
    color: #8a8e86;
  }

  .filter-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 9rem;
    min-height: 3.15rem;
    padding: 0 0.85rem;
    border: 2px solid var(--ink);
    background: var(--white);
    color: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .filter-button:hover,
  .filter-button[aria-expanded="true"] {
    background: var(--acid);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .filter-button__count {
    display: grid;
    min-width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    padding: 0 0.25rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
    font-size: 0.49rem;
  }

  /* ==========================================================================
     FILTER PANEL
     ========================================================================== */

  .filter-panel {
    margin-top: 0.7rem;
    padding: 1rem;
    border: 2px solid var(--ink);
    background: var(--white);
  }

  .filter-panel[hidden] {
    display: none;
  }

  .filter-panel__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .filter-panel__eyebrow {
    display: block;
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .filter-panel__head h3 {
    margin: 0.3rem 0 0;
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: 0.9rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .clear-filter {
    border: 0;
    border-bottom: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 700;
    cursor: pointer;
  }

  .clear-filter:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .area-filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.9rem;
  }

  .area-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0 0.65rem;
    border: 1px solid var(--ink);
    background: var(--white);
    color: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    cursor: pointer;
  }

  .area-filter strong {
    display: grid;
    min-width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    background: var(--paper-2);
    font-size: 0.48rem;
  }

  .area-filter:hover,
  .area-filter.is-active {
    background: var(--acid);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .area-filter.is-active strong {
    background: var(--ink);
    color: var(--acid);
  }

  /* ==========================================================================
     RESULT BAR
     ========================================================================== */

  .directory-result-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1rem 0 0.8rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    text-transform: uppercase;
  }

  .directory-result-bar__number {
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .result-reset {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 0;
    background: transparent;
    color: var(--warning);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* ==========================================================================
     ORGANIZATION GRID
     ========================================================================== */

  .organization-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .organization-card {
    min-width: 0;
    border: 3px solid var(--ink);
    background: var(--white);
    box-shadow: 5px 5px 0 var(--ink);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease,
      background 140ms ease;
  }

  .organization-card:hover {
    background: var(--acid);
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .organization-card[hidden] {
    display: none;
  }

  .organization-card__main {
    position: relative;
    display: grid;
    grid-template-columns:
      auto minmax(0, 1fr)
      auto;
    gap: 0.85rem;
    align-items: start;
    padding: 0.9rem;
    color: inherit;
    text-decoration: none;
  }

  .organization-card__top {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    left: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .organization-card__index {
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .organization-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.3rem 0.4rem;
    border: 1px solid var(--ink);
    background: var(--acid);
    color: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.44rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .organization-card__visual {
    grid-column: 1;
    padding-top: 1.55rem;
  }

  .organization-card__logo {
    display: grid;
    width: 3.35rem;
    height: 3.35rem;
    place-items: center;
    overflow: hidden;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .organization-card__logo img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0.3rem;
    object-fit: contain;
  }

  .organization-card__body {
    grid-column: 2;
    min-width: 0;
    padding-top: 1.55rem;
  }

  .organization-card__body h3 {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--ink);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: 0.86rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-overflow: ellipsis;
    text-transform: uppercase;
  }

  .organization-card__location {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.6rem;
    line-height: 1.45;
  }

  .organization-card__location svg {
    flex: 0 0 auto;
    margin-top: 0.05rem;
  }

  .organization-card__body p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.6rem 0 0;
    color: rgba(9, 10, 8, 0.62);
    font-size: 0.64rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .organization-card__arrow {
    display: grid;
    grid-column: 3;
    width: 2rem;
    height: 2rem;
    margin-top: 1.55rem;
    place-items: center;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .organization-card:hover
    .organization-card__arrow {
    background: var(--white);
  }

  .organization-card__footer {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.45rem;
    padding: 0.55rem 0.85rem;
    border-top: 1px solid var(--line);
    background: rgba(255, 254, 248, 0.72);
  }

  .organization-card__footer > span {
    min-width: 0;
    overflow: hidden;
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.47rem;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .organization-card__footer > span + span {
    position: relative;
    padding-left: 0.7rem;
  }

  .organization-card__footer > span + span::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 2px;
    height: 2px;
    background: var(--muted);
    content: "";
    transform: translateY(-50%);
  }

  .organization-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    color: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.47rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .organization-card:hover
    .organization-card__link {
    color: var(--warning);
  }

  /* ==========================================================================
     EMPTY STATE
     ========================================================================== */

  .empty-state {
    display: grid;
    place-items: center;
    padding: 4rem 1.5rem;
    border: 2px dashed var(--line);
    background: rgba(255, 254, 248, 0.5);
    text-align: center;
  }

  .empty-state--hidden {
    display: none;
  }

  .empty-state__icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    margin-bottom: 1rem;
    place-items: center;
    border: 2px solid var(--ink);
    background: var(--acid);
    color: var(--ink);
  }

  .empty-state__eyebrow {
    margin-bottom: 0.35rem;
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .empty-state h3 {
    margin: 0;
    color: var(--ink);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .empty-state p {
    max-width: 460px;
    margin: 0.55rem 0 1rem;
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.6;
  }

  .empty-state__button {
    min-height: 2.5rem;
    padding: 0 0.8rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
  }

  .empty-state__button:hover {
    background: var(--warning);
    color: var(--white);
  }

  /* ==========================================================================
     TRUST
     ========================================================================== */

  .trust-section {
    padding: 5rem 0;
    background: var(--ink);
    color: var(--white);
  }

  .trust-card {
    display: grid;
    grid-template-columns:
      minmax(0, 0.95fr)
      minmax(0, 1.05fr);
    gap: 2.2rem;
    padding: 1.4rem;
    border: 3px solid var(--white);
    background: var(--ink-2);
    box-shadow: 8px 8px 0 var(--warning);
  }

  .trust-card__main h2 {
    max-width: 680px;
    margin: 0.55rem 0 0;
    color: var(--white);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: clamp(
      1.55rem,
      3.2vw,
      2.8rem
    );
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .trust-card__main p {
    max-width: 650px;
    margin: 1rem 0 0;
    color: rgba(255, 254, 248, 0.56);
    font-size: 0.72rem;
    line-height: 1.7;
  }

  .trust-card__points {
    display: grid;
    gap: 0.7rem;
    align-content: center;
  }

  .trust-point {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.8rem;
    border: 1px solid var(--line-dark);
    background: rgba(255, 254, 248, 0.03);
  }

  .trust-point__icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--acid);
    color: var(--acid);
  }

  .trust-point strong {
    display: block;
    color: var(--white);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .trust-point p {
    margin: 0.35rem 0 0;
    color: rgba(255, 254, 248, 0.46);
    font-size: 0.61rem;
    line-height: 1.6;
  }

  /* ==========================================================================
     CTA
     ========================================================================== */

  .organizations-cta {
    padding: 1rem 0 5rem;
    background: var(--paper);
