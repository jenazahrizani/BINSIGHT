---
import {
  ArrowRight,
  Building2,
  CircleCheck,
  MapPin,
  Search,
  ShieldCheck,
  SlidersHorizontal,
  Users,
} from "@lucide/astro";

import PageHeader from "@components/layout/PageHeader.astro";
import PublicLayout from "@layouts/PublicLayout.astro";

import {
  getPublicOrganizations,
  type Organization,
} from "@lib/data/organizations";

/* -------------------------------------------------------------------------- */
/* Data                                                                        */
/* -------------------------------------------------------------------------- */

const organizations: Organization[] =
  getPublicOrganizations();

/* -------------------------------------------------------------------------- */
/* Public / verified organizations                                             */
/* -------------------------------------------------------------------------- */

const publicOrganizations = organizations.filter(
  (organization: Organization) =>
    organization.isPublic === true,
);

const verifiedOrganizations =
  publicOrganizations.filter(
    (organization: Organization) =>
      organization.status === "verified",
  );

/* -------------------------------------------------------------------------- */
/* Area summary                                                                */
/* -------------------------------------------------------------------------- */

const areaCounts: Record<string, number> = {};

for (const organization of verifiedOrganizations) {
  const area =
    organization.location?.area?.trim();

  if (!area) {
    continue;
  }

  areaCounts[area] =
    (areaCounts[area] ?? 0) + 1;
}

const areaSummary = Object.entries(areaCounts)
  .map(
    ([name, count]: [string, number]) => ({
      name,
      count,
    }),
  )
  .sort(
    (first, second) =>
      second.count - first.count,
  );

/* -------------------------------------------------------------------------- */
/* Search metadata                                                             */
/* -------------------------------------------------------------------------- */

const breadcrumbs = [
  {
    label: "Beranda",
    href: "/",
  },
  {
    label: "Organisasi",
  },
];

const pageTitle =
  "Organisasi Pengelolaan Sampah";

const pageDescription =
  "Temukan organisasi yang terlibat dalam ekosistem pengelolaan sampah di Kabupaten Badung.";

/* -------------------------------------------------------------------------- */
/* Display helpers                                                             */
/* -------------------------------------------------------------------------- */

const organizationCount =
  verifiedOrganizations.length;

const areaCount =
  areaSummary.length;

---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
>
  <PageHeader
    title={pageTitle}
    description={pageDescription}
    breadcrumbs={breadcrumbs}
    icon="organization"
    eyebrow="BINSIGHT Â· ORGANISASI"
    tone="green"
  />

  <main class="organizations-page">
    <section class="organizations-hero">
      <div class="organizations-hero__content">
        <div class="organizations-hero__eyebrow">
          <Building2
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Ekosistem pengelolaan sampah
          </span>
        </div>

        <h1>
          Kenali organisasi yang mengelola
          sampah di Badung
        </h1>

        <p>
          Jelajahi organisasi yang telah
          diverifikasi dan dipublikasikan dalam
          BINSIGHT. Pahami siapa mereka, di mana
          mereka berada, dan bagaimana mereka
          terhubung dengan ekosistem persampahan.
        </p>

        <div class="organizations-hero__actions">
          <a
            href="#organization-directory"
            class="primary-action"
          >
            <Building2
              size={18}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Jelajahi organisasi
            </span>

            <ArrowRight
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>

          <a
            href="/map"
            class="secondary-action"
          >
            <MapPin
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Lihat di peta
            </span>
          </a>
        </div>
      </div>

      <div
        class="organizations-hero__stats"
        aria-label="Ringkasan organisasi"
      >
        <div class="hero-stat">
          <span class="hero-stat__icon">
            <Building2
              size={19}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <strong>{organizationCount}</strong>

          <span>
            Organisasi terverifikasi
          </span>
        </div>

        <div class="hero-stat">
          <span class="hero-stat__icon">
            <MapPin
              size={19}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <strong>{areaCount}</strong>

          <span>
            Area terwakili
          </span>
        </div>

        <div class="hero-stat">
          <span class="hero-stat__icon">
            <ShieldCheck
              size={19}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <strong>
            {publicOrganizations.length}
          </strong>

          <span>
            Profil publik
          </span>
        </div>
      </div>
    </section>

    <section
      id="organization-directory"
      class="directory-section"
      aria-labelledby="directory-title"
    >
      <div class="section-heading">
        <div>
          <span class="section-eyebrow">
            Direktori organisasi
          </span>

          <h2 id="directory-title">
            Temukan organisasi
          </h2>

          <p>
            Gunakan pencarian dan filter area untuk
            menemukan organisasi yang relevan.
          </p>
        </div>

        <span class="section-count">
          {organizationCount} terverifikasi
        </span>
      </div>

      <div class="directory-tools">
        <label
          class="search-field"
          for="organization-search"
        >
          <Search
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />

          <input
            id="organization-search"
            type="search"
            placeholder="Cari nama organisasi atau lokasi..."
            autocomplete="off"
          />
        </label>

        <button
          type="button"
          class="filter-button"
          id="organization-filter-button"
          aria-expanded="false"
          aria-controls="organization-filter-panel"
        >
          <SlidersHorizontal
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Filter area
          </span>
        </button>
      </div>

      <div
        class="filter-panel"
        id="organization-filter-panel"
      >
        <div class="filter-panel__heading">
          <div>
            <span class="filter-panel__eyebrow">
              Area
            </span>

            <h3>
              Organisasi berdasarkan wilayah
            </h3>
          </div>

          <button
            type="button"
            class="clear-filter"
            id="clear-area-filter"
          >
            Semua area
          </button>
        </div>

        <div class="area-filter-list">
          <button
            type="button"
            class="area-filter is-active"
            data-area-filter=""
          >
            <span>
              Semua area
            </span>

            <strong>
              {organizationCount}
            </strong>
          </button>

          {
            areaSummary.map(
              ({
                name,
                count,
              }: {
                name: string;
                count: number;
              }) => (
                <button
                  type="button"
                  class="area-filter"
                  data-area-filter={name}
                >
                  <span>{name}</span>
                  <strong>{count}</strong>
                </button>
              ),
            )
          }
        </div>
      </div>

      {
        verifiedOrganizations.length > 0 ? (
          <div
            class="organization-grid"
            id="organization-grid"
          >
            {verifiedOrganizations.map(
              (
                organization: Organization,
              ) => {
                const area =
                  organization.location?.area?.trim() ||
                  "Kabupaten Badung";

                const address =
                  organization.location?.address?.trim() ||
                  area;

                return (
                  <article
                    class="organization-card"
                    data-organization-card
                    data-organization-name={
                      organization.name
                    }
                    data-organization-area={area}
                  >
                    <a
                      href={`/organizations/${organization.slug}`}
                      class="organization-card__main"
                      aria-label={`Lihat profil ${organization.name}`}
                    >
                      <div class="organization-card__visual">
                        <div class="organization-card__logo">
                          <Building2
                            size={25}
                            stroke-width={1.8}
                            aria-hidden="true"
                          />
                        </div>

                        <span class="verified-badge">
                          <CircleCheck
                            size={14}
                            stroke-width={2}
                            aria-hidden="true"
                          />

                          <span>
                            Terverifikasi
                          </span>
                        </span>
                      </div>

                      <div class="organization-card__body">
                        <h3>
                          {organization.name}
                        </h3>

                        <div class="organization-card__location">
                          <MapPin
                            size={15}
                            stroke-width={2}
                            aria-hidden="true"
                          />

                          <span>
                            {address}
                          </span>
                        </div>

                        <p>
                          Profil organisasi yang
                          terdaftar dalam ekosistem
                          BINSIGHT.
                        </p>
                      </div>

                      <span class="organization-card__arrow">
                        <ArrowRight
                          size={17}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </span>
                    </a>

                    <div
                      class="organization-card__footer"
                    >
                      <span>
                        <MapPin
                          size={14}
                          stroke-width={2}
                          aria-hidden="true"
                        />

                        {area}
                      </span>

                      <a
                        href={`/organizations/${organization.slug}`}
                        class="organization-card__link"
                      >
                        Lihat profil
                        <ArrowRight
                          size={14}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </a>
                    </div>
                  </article>
                );
              },
            )}
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-state__icon">
              <Building2
                size={28}
                stroke-width={1.8}
                aria-hidden="true"
              />
            </div>

            <h3>
              Belum ada organisasi publik
            </h3>

            <p>
              Belum ada organisasi yang tersedia
              untuk ditampilkan pada direktori publik.
            </p>
          </div>
        )
      }

      <div
        id="organization-no-results"
        class="empty-state empty-state--hidden"
      >
        <div class="empty-state__icon">
          <Search
            size={27}
            stroke-width={1.8}
            aria-hidden="true"
          />
        </div>

        <h3>
          Organisasi tidak ditemukan
        </h3>

        <p>
          Coba gunakan kata kunci atau area
          yang berbeda.
        </p>

        <button
          type="button"
          id="reset-organization-search"
        >
          Reset pencarian
        </button>
      </div>
    </section>

    <section
      class="trust-section"
      aria-labelledby="trust-title"
    >
      <div class="trust-section__content">
        <span class="section-eyebrow">
          Kepercayaan data
        </span>

        <h2 id="trust-title">
          Informasi publik yang lebih dapat dipercaya
        </h2>

        <p>
          BINSIGHT menempatkan verifikasi sebagai
          bagian penting dari direktori organisasi.
          Informasi yang ditampilkan kepada publik
          dipisahkan dari data yang masih dalam proses
          verifikasi.
        </p>
      </div>

      <div class="trust-points">
        <div class="trust-point">
          <span class="trust-point__icon">
            <ShieldCheck
              size={19}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <div>
            <strong>
              Verifikasi organisasi
            </strong>

            <p>
              Profil publik berasal dari organisasi
              yang telah melewati status verifikasi.
            </p>
          </div>
        </div>

        <div class="trust-point">
          <span class="trust-point__icon">
            <MapPin
              size={19}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <div>
            <strong>
              Konteks wilayah
            </strong>

            <p>
              Lokasi organisasi membantu pengguna
              memahami ekosistem pada setiap area.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="organization-cta">
      <div class="organization-cta__icon">
        <Users
          size={24}
          stroke-width={2}
          aria-hidden="true"
        />
      </div>

      <div class="organization-cta__content">
        <span>
          Ekosistem bersama
        </span>

        <h2>
          Ingin mengetahui organisasi dari area
          tertentu?
        </h2>

        <p>
          Gunakan peta BINSIGHT untuk melihat
          keterhubungan antara organisasi dan
          wilayah pengelolaan sampah.
        </p>
      </div>

      <a
        href="/map"
        class="organization-cta__button"
      >
        Buka peta
        <ArrowRight
          size={17}
          stroke-width={2}
          aria-hidden="true"
        />
      </a>
    </section>
  </main>
</PublicLayout>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>(
      "#organization-search",
    );

  const cards =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-organization-card]",
      ),
    );

  const noResults =
    document.querySelector<HTMLElement>(
      "#organization-no-results",
    );

  const resetSearch =
    document.querySelector<HTMLButtonElement>(
      "#reset-organization-search",
    );

  const filterButton =
    document.querySelector<HTMLButtonElement>(
      "#organization-filter-button",
    );

  const filterPanel =
    document.querySelector<HTMLElement>(
      "#organization-filter-panel",
    );

  const areaButtons =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-area-filter]",
      ),
    );

  let activeArea = "";

  function filterOrganizations() {
    const query =
      searchInput?.value
        .trim()
        .toLowerCase() ?? "";

    let visibleCount = 0;

    cards.forEach((card) => {
      const name =
        card
          .dataset[
            "organizationName"
          ]
          ?.toLowerCase() ?? "";

      const area =
        card
          .dataset[
            "organizationArea"
          ]
          ?.toLowerCase() ?? "";

      const searchableText =
        `${name} ${area}`;

      const queryMatches =
        query.length === 0 ||
        searchableText.includes(query);

      const areaMatches =
        activeArea.length === 0 ||
        area === activeArea.toLowerCase();

      const visible =
        queryMatches && areaMatches;

      card.hidden = !visible;

      if (visible) {
        visibleCount += 1;
      }
    });

    if (noResults) {
      noResults.classList.toggle(
        "empty-state--hidden",
        visibleCount > 0,
      );
    }
  }

  searchInput?.addEventListener(
    "input",
    filterOrganizations,
  );

  areaButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        () => {
          activeArea =
            button.dataset[
              "areaFilter"
            ] ?? "";

          areaButtons.forEach(
            (item) => {
              item.classList.toggle(
                "is-active",
                item === button,
              );
            },
          );

          if (activeArea === "") {
            const clearButton =
              document.querySelector<HTMLElement>(
                "#clear-area-filter",
              );

            clearButton?.focus();
          }

          filterOrganizations();
        },
      );
    },
  );

  document
    .querySelector<HTMLButtonElement>(
      "#clear-area-filter",
    )
    ?.addEventListener(
      "click",
      () => {
        activeArea = "";

        areaButtons.forEach(
          (button) => {
            button.classList.toggle(
              "is-active",
              button.dataset[
                "areaFilter"
              ] === "",
            );
          },
        );

        filterOrganizations();
      },
    );

  filterButton?.addEventListener(
    "click",
    () => {
      const expanded =
        filterButton.getAttribute(
          "aria-expanded",
        ) === "true";

      filterButton.setAttribute(
        "aria-expanded",
        String(!expanded),
      );

      filterPanel?.toggleAttribute(
        "data-open",
        !expanded,
      );
    },
  );

  resetSearch?.addEventListener(
    "click",
    () => {
      if (searchInput) {
        searchInput.value = "";
        searchInput.focus();
      }

      activeArea = "";

      areaButtons.forEach(
        (button) => {
          button.classList.toggle(
            "is-active",
            button.dataset[
              "areaFilter"
            ] === "",
          );
        },
      );

      filterOrganizations();
    },
  );
</script>

<style>
  .organizations-page {
    width: min(100% - 32px, 1440px);
    margin-inline: auto;
    padding-bottom: 84px;
  }

  .organizations-hero {
    display: grid;
    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(300px, 0.65fr);
    gap: 32px;
    margin-top: 32px;
    padding: 40px;
    overflow: hidden;
    border: 1px solid #dbe7df;
    border-radius: 28px;
    background:
      radial-gradient(
        circle at 84% 16%,
        rgba(132, 204, 22, 0.14),
        transparent 31%
      ),
      linear-gradient(
        135deg,
        #ffffff 0%,
        #f0fdf4 100%
      );
  }

  .organizations-hero__eyebrow,
  .section-eyebrow,
  .filter-panel__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #166534;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .organizations-hero h1 {
    max-width: 850px;
    margin: 12px 0 0;
    color: #0f172a;
    font-size: clamp(
      2.15rem,
      4vw,
      3.65rem
    );
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .organizations-hero__content > p {
    max-width: 770px;
    margin: 19px 0 0;
    color: #64748b;
    font-size: 1rem;
    line-height: 1.75;
  }

  .organizations-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 28px;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding-inline: 15px;
    border-radius: 12px;
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 750;
  }

  .primary-action {
    background: #166534;
    color: #ffffff;
  }

  .primary-action:hover {
    background: #14532d;
  }

