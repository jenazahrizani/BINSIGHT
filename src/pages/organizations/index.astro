  .area-filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .area-filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding-inline: 11px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #ffffff;
    color: #475569;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }

  .area-filter strong {
    display: inline-grid;
    min-width: 21px;
    height: 21px;
    place-items: center;
    padding-inline: 4px;
