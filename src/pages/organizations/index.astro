---
/**
 * ============================================================================
 * BINSIGHT — ORGANIZATIONS DIRECTORY
 * ============================================================================
 * Badung Waste Intelligence
 *
 * Direktori organisasi publik yang terverifikasi.
 *
 * Catatan:
 * - Tidak membuat data baru.
 * - Tidak menampilkan organisasi di luar data publik yang tersedia.
 * - Filter dan pencarian berjalan client-side terhadap data yang sudah dirender.
 * ============================================================================
 */

import {
  ArrowRight,
  Building2,
  CircleCheck,
  FileText,
  Map,
  MapPin,
  Search,
  ShieldCheck,
  SlidersHorizontal,
  Users,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import {
  getPublicOrganizations,
  type Organization,
} from "@lib/data/organizations";

/* -------------------------------------------------------------------------- */
/* Data                                                                        */
/* -------------------------------------------------------------------------- */

const organizations: Organization[] =
  getPublicOrganizations();

/**
 * Only public organizations are eligible for the directory.
 */
const publicOrganizations =
  organizations.filter(
    (organization) =>
      organization.isPublic === true,
  );

/**
 * Only verified public organizations are shown
 * in the primary directory.
 */
const verifiedOrganizations =
  publicOrganizations.filter(
    (organization) =>
      organization.status === "verified",
  );

/* -------------------------------------------------------------------------- */
/* Area summary                                                                */
/* -------------------------------------------------------------------------- */

const areaCounts: Record<string, number> = {};

for (const organization of verifiedOrganizations) {
  const area =
    organization.location?.area?.trim();

  if (!area) {
    continue;
  }

  areaCounts[area] =
    (areaCounts[area] ?? 0) + 1;
}

const areaSummary = Object.entries(areaCounts)
  .map(([name, count]) => ({
    name,
    count,
  }))
  .sort(
    (first, second) =>
      second.count - first.count ||
      first.name.localeCompare(second.name),
  );

/* -------------------------------------------------------------------------- */
/* Display helpers                                                             */
/* -------------------------------------------------------------------------- */

const organizationCount =
  verifiedOrganizations.length;

const areaCount =
  areaSummary.length;

const publicProfileCount =
  publicOrganizations.length;

const pageTitle =
  "Organisasi Pengelolaan Sampah";

const pageDescription =
  "Temukan organisasi yang terlibat dalam ekosistem pengelolaan sampah di Kabupaten Badung.";
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
>
  <main
    class="organizations-page"
    data-organizations-page
  >
    <!-- ================================================================== -->
    <!-- HERO                                                               -->
    <!-- ================================================================== -->

    <section class="organizations-hero">
      <div class="organizations-container">
        <div class="organizations-hero__grid">
          <div class="organizations-hero__content">
            <div class="organizations-kicker">
              <span
                class="organizations-kicker__dot"
                aria-hidden="true"
              ></span>

              BINSIGHT / ORGANISASI
            </div>

            <h1>
              Kenali organisasi yang
              <span>mengelola sampah</span>
              di Badung.
            </h1>

            <p>
              Jelajahi organisasi yang telah diverifikasi
              dan dipublikasikan dalam BINSIGHT. Pahami
              siapa mereka, di mana mereka berada, dan
              bagaimana mereka terhubung dengan ekosistem
              persampahan.
            </p>

            <div class="organizations-hero__actions">
              <a
                href="#organization-directory"
                class="organizations-button organizations-button--primary"
              >
                <Building2
                  size={17}
                  stroke-width="2"
                  aria-hidden="true"
                />

                <span>
                  Jelajahi organisasi
                </span>

                <ArrowRight
                  size={17}
                  stroke-width="2"
                  aria-hidden="true"
                />
              </a>

              <a
                href="/map"
                class="organizations-button organizations-button--secondary"
              >
                <MapPin
                  size={17}
                  stroke-width="2"
                  aria-hidden="true"
                />

                <span>
                  Lihat di peta
                </span>
              </a>
            </div>
          </div>

          <aside
            class="organizations-hero__aside"
            aria-label="Ringkasan organisasi"
          >
            <div class="organizations-hero__aside-top">
              <span>
                DIRECTORY STATUS
              </span>

              <ShieldCheck
                size={21}
                stroke-width="2"
                aria-hidden="true"
              />
            </div>

            <strong>
              Data publik
              terverifikasi.
            </strong>

            <p>
              Direktori utama hanya menampilkan organisasi
              yang berstatus publik dan terverifikasi pada
              data BINSIGHT.
            </p>

            <div class="organizations-hero__stats">
              <div class="hero-stat">
                <span>
                  ORGANISASI
                </span>

                <strong>
                  {organizationCount}
                </strong>
              </div>

              <div class="hero-stat">
                <span>
                  AREA
                </span>

                <strong>
                  {areaCount}
                </strong>
              </div>

              <div class="hero-stat">
                <span>
                  PROFIL PUBLIK
                </span>

                <strong>
                  {publicProfileCount}
                </strong>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- DIRECTORY                                                          -->
    <!-- ================================================================== -->

    <section
      id="organization-directory"
      class="directory-section"
      aria-labelledby="directory-title"
    >
      <div class="organizations-container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">
              01 / DIREKTORI
            </span>

            <h2 id="directory-title">
              Temukan organisasi.
            </h2>

            <p>
              Cari berdasarkan nama organisasi atau
              lokasi, lalu gunakan filter wilayah untuk
              mempersempit hasil.
            </p>
          </div>

          <div class="section-heading__meta">
            <span>
              VERIFIED DIRECTORY
            </span>

            <strong>
              {organizationCount}
            </strong>
          </div>
        </div>

        <!-- TOOLS -->
        <div class="directory-tools">
          <label
            class="search-field"
            for="organization-search"
          >
            <Search
              size={18}
              stroke-width="2"
              aria-hidden="true"
            />

            <input
              id="organization-search"
              type="search"
              placeholder="Cari organisasi atau lokasi..."
              autocomplete="off"
              aria-controls="organization-grid"
            />
          </label>

          <button
            type="button"
            class="filter-button"
            id="organization-filter-button"
            aria-expanded="false"
            aria-controls="organization-filter-panel"
          >
            <SlidersHorizontal
              size={17}
              stroke-width="2"
              aria-hidden="true"
            />

            <span>
              Filter area
            </span>

            <span
              class="filter-button__count"
              id="organization-filter-count"
              aria-hidden="true"
            >
              {areaCount}
            </span>
          </button>
        </div>

        <!-- FILTER -->
        <div
          class="filter-panel"
          id="organization-filter-panel"
          hidden
        >
          <div class="filter-panel__head">
            <div>
              <span class="filter-panel__eyebrow">
                AREA
              </span>

              <h3>
                Organisasi berdasarkan wilayah
              </h3>
            </div>

            <button
              type="button"
              class="clear-filter"
              id="clear-area-filter"
            >
              Reset area
            </button>
          </div>

          <div class="area-filter-list">
            <button
              type="button"
              class="area-filter is-active"
              data-area-filter=""
              aria-pressed="true"
            >
              <span>
                Semua area
              </span>

              <strong>
                {organizationCount}
              </strong>
            </button>

            {
              areaSummary.map(
                ({ name, count }) => (
                  <button
                    type="button"
                    class="area-filter"
                    data-area-filter={name}
                    aria-pressed="false"
                  >
                    <span>
                      {name}
                    </span>

                    <strong>
                      {count}
                    </strong>
                  </button>
                ),
              )
            }
          </div>
        </div>

        <!-- RESULT META -->
        <div class="directory-result-bar">
          <span>
            <span
              id="organization-visible-count"
              class="directory-result-bar__number"
            >
              {organizationCount}
            </span>

            organisasi ditampilkan
          </span>

          <button
            type="button"
            id="reset-organization-filters"
            class="result-reset"
            hidden
          >
            Reset filter
            <ArrowRight
              size={13}
              stroke-width="2"
              aria-hidden="true"
            />
          </button>
        </div>

        <!-- GRID -->
        {
          verifiedOrganizations.length > 0 ? (
            <div
              class="organization-grid"
              id="organization-grid"
              aria-live="polite"
            >
              {verifiedOrganizations.map(
                (organization) => {
                  const area =
                    organization.location?.area?.trim() ||
                    "Kabupaten Badung";

                  const address =
                    organization.location?.address?.trim() ||
                    area;

                  const description =
                    organization.shortDescription?.trim() ||
                    organization.description?.trim() ||
                    "Profil organisasi yang terdaftar dalam ekosistem BINSIGHT.";

                  return (
                    <article
                      class="organization-card"
                      data-organization-card
                      data-organization-name={
                        organization.name
                      }
                      data-organization-area={area}
                      data-organization-search={[
                        organization.name,
                        area,
                        address,
                        description,
                      ]
                        .filter(Boolean)
                        .join(" ")}
                    >
                      <a
                        href={`/organizations/${organization.slug}`}
                        class="organization-card__main"
                        aria-label={`Lihat profil ${organization.name}`}
                      >
                        <div class="organization-card__top">
                          <span class="organization-card__index">
                            ORG
                          </span>

                          <span class="organization-card__verified">
                            <CircleCheck
                              size={13}
                              stroke-width="2.2"
                              aria-hidden="true"
                            />

                            VERIFIED
                          </span>
                        </div>

                        <div class="organization-card__visual">
                          <div class="organization-card__logo">
                            {organization.logo ? (
                              <img
                                src={organization.logo}
                                alt=""
                                loading="lazy"
                              />
                            ) : (
                              <Building2
                                size={27}
                                stroke-width="1.8"
                                aria-hidden="true"
                              />
                            )}
                          </div>
                        </div>

                        <div class="organization-card__body">
                          <h3>
                            {organization.name}
                          </h3>

                          <div class="organization-card__location">
                            <MapPin
                              size={14}
                              stroke-width="2"
                              aria-hidden="true"
                            />

                            <span>
                              {address}
                            </span>
                          </div>

                          <p>
                            {description}
                          </p>
                        </div>

                        <div class="organization-card__arrow">
                          <ArrowRight
                            size={18}
                            stroke-width="2"
                            aria-hidden="true"
                          />
                        </div>
                      </a>

                      <div class="organization-card__footer">
                        <span>
                          {area}
                        </span>

                        <span>
                          {organization.wasteManaged.length}{" "}
                          kategori
                        </span>

                        <a
                          href={`/organizations/${organization.slug}`}
                          class="organization-card__link"
                          aria-label={`Buka profil ${organization.name}`}
                        >
                          Profil
                          <ArrowRight
                            size={13}
                            stroke-width="2"
                            aria-hidden="true"
                          />
                        </a>
                      </div>
                    </article>
                  );
                },
              )}
            </div>
          ) : (
            <div class="empty-state">
              <div class="empty-state__icon">
                <Building2
                  size={28}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
              </div>

              <span class="empty-state__eyebrow">
                EMPTY DIRECTORY
              </span>

              <h3>
                Belum ada organisasi publik.
              </h3>

              <p>
                Belum ada organisasi yang tersedia
                untuk ditampilkan pada direktori publik.
              </p>
            </div>
          )
        }

        <!-- NO RESULTS -->
        <div
          id="organization-no-results"
          class="empty-state empty-state--hidden"
          aria-live="polite"
        >
          <div class="empty-state__icon">
            <Search
              size={28}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </div>

          <span class="empty-state__eyebrow">
            NO MATCH
          </span>

          <h3>
            Organisasi tidak ditemukan.
          </h3>

          <p>
            Tidak ada organisasi yang cocok dengan
            pencarian atau filter yang dipilih.
          </p>

          <button
            type="button"
            id="reset-organization-search"
            class="empty-state__button"
          >
            Reset pencarian
          </button>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- TRUST                                                               -->
    <!-- ================================================================== -->

    <section class="trust-section">
      <div class="organizations-container">
        <div class="trust-card">
          <div class="trust-card__main">
            <span class="section-kicker">
              02 / TRUST
            </span>

            <h2>
              Informasi publik yang
              dapat ditelusuri.
            </h2>

            <p>
              BINSIGHT memisahkan profil organisasi publik
              dan data yang belum terverifikasi. Direktori
              ini menampilkan organisasi yang memenuhi
              status publik dan verifikasi pada data layer.
            </p>
          </div>

          <div class="trust-card__points">
            <div class="trust-point">
              <div class="trust-point__icon">
                <ShieldCheck
                  size={19}
                  stroke-width="2"
                  aria-hidden="true"
                />
              </div>

              <div>
                <strong>
                  Status terverifikasi
                </strong>

                <p>
                  Profil utama berasal dari organisasi
                  yang memiliki status verifikasi.
                </p>
              </div>
            </div>

            <div class="trust-point">
              <div class="trust-point__icon">
                <MapPin
                  size={19}
                  stroke-width="2"
                  aria-hidden="true"
                />
              </div>

              <div>
                <strong>
                  Konteks wilayah
                </strong>

                <p>
                  Lokasi membantu membaca hubungan
                  organisasi dengan wilayah pengelolaan.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- CTA                                                                 -->
    <!-- ================================================================== -->

    <section class="organizations-cta">
      <div class="organizations-container">
        <div class="organizations-cta__inner">
          <div class="organizations-cta__icon">
            <Users
              size={24}
              stroke-width="2"
              aria-hidden="true"
            />
          </div>

          <div class="organizations-cta__content">
            <span>
              EKOSISTEM BERSAMA
            </span>

            <h2>
              Hubungkan organisasi dengan wilayahnya.
            </h2>

            <p>
              Gunakan peta BINSIGHT untuk melihat organisasi
              dan lokasi pengelolaan dalam konteks geografis
              Kabupaten Badung.
            </p>
          </div>

          <a
            href="/map"
            class="organizations-cta__button"
          >
            <Map
              size={16}
              stroke-width="2"
              aria-hidden="true"
            />

            Buka peta

            <ArrowRight
              size={16}
              stroke-width="2"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<script>
  const initializeOrganizationsPage = () => {
    const page =
      document.querySelector<HTMLElement>(
        "[data-organizations-page]",
      );

    if (!page || page.dataset.initialized === "true") {
      return;
    }

    page.dataset.initialized = "true";

    const searchInput =
      page.querySelector<HTMLInputElement>(
        "#organization-search",
      );

    const filterButton =
      page.querySelector<HTMLButtonElement>(
        "#organization-filter-button",
      );

    const filterPanel =
      page.querySelector<HTMLElement>(
        "#organization-filter-panel",
      );

    const clearAreaButton =
      page.querySelector<HTMLButtonElement>(
        "#clear-area-filter",
      );

    const resetFiltersButton =
      page.querySelector<HTMLButtonElement>(
        "#reset-organization-filters",
      );

    const resetSearchButton =
      page.querySelector<HTMLButtonElement>(
        "#reset-organization-search",
      );

    const visibleCount =
      page.querySelector<HTMLElement>(
        "#organization-visible-count",
      );

    const noResults =
      page.querySelector<HTMLElement>(
        "#organization-no-results",
      );

    const filterCount =
      page.querySelector<HTMLElement>(
        "#organization-filter-count",
      );

    const cards =
      Array.from(
        page.querySelectorAll<HTMLElement>(
          "[data-organization-card]",
        ),
      );

    const areaButtons =
      Array.from(
        page.querySelectorAll<HTMLButtonElement>(
          "[data-area-filter]",
        ),
      );

    let activeArea = "";

    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(
          /[\u0300-\u036f]/g,
          "",
        )
        .toLowerCase()
        .replace(/\s+/g, " ")
        .trim();

    const updateFilterCount = () => {
      if (!filterCount) {
        return;
      }

      filterCount.textContent = String(
        activeArea
          ? 1
          : areaButtons.length - 1,
      );
    };

    const updateResetState = () => {
      const hasSearch =
        Boolean(
          searchInput?.value.trim(),
        );

      const hasFilters =
        hasSearch || Boolean(activeArea);

      if (resetFiltersButton) {
        resetFiltersButton.hidden =
          !hasFilters;
      }

      if (clearAreaButton) {
        clearAreaButton.disabled =
          !activeArea;
      }
    };

    const applyFilters = () => {
      const query =
        normalize(
          searchInput?.value ?? "",
        );

      const normalizedArea =
        normalize(activeArea);

      let count = 0;

      cards.forEach((card) => {
        const searchableText =
          normalize(
            card.dataset[
              "organizationSearch"
            ] ??
              [
                card.dataset[
                  "organizationName"
                ],
                card.dataset[
                  "organizationArea"
                ],
              ]
                .filter(Boolean)
                .join(" "),
          );

        const cardArea =
          normalize(
            card.dataset[
              "organizationArea"
            ] ?? "",
          );

        const queryMatches =
          !query ||
          searchableText.includes(
            query,
          );

        const areaMatches =
          !normalizedArea ||
          cardArea === normalizedArea;

        const matches =
          queryMatches &&
          areaMatches;

        card.hidden = !matches;

        if (matches) {
          count += 1;
        }
      });

      if (visibleCount) {
        visibleCount.textContent =
          String(count);
      }

      noResults?.classList.toggle(
        "empty-state--hidden",
        count > 0,
      );

      updateResetState();
    };

    const setActiveArea = (
      area: string,
    ) => {
      activeArea = area;

      areaButtons.forEach(
        (button) => {
          const buttonArea =
            button.dataset[
              "areaFilter"
            ] ?? "";

          const selected =
            buttonArea === area;

          button.classList.toggle(
            "is-active",
            selected,
          );

          button.setAttribute(
            "aria-pressed",
            String(selected),
          );
        },
      );

      updateFilterCount();
      applyFilters();
    };

    searchInput?.addEventListener(
      "input",
      applyFilters,
    );

    filterButton?.addEventListener(
      "click",
      () => {
        if (!filterPanel) {
          return;
        }

        const isOpen =
          filterButton.getAttribute(
            "aria-expanded",
          ) === "true";

        filterButton.setAttribute(
          "aria-expanded",
          String(!isOpen),
        );

        filterPanel.hidden = isOpen;
      },
    );

    areaButtons.forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            setActiveArea(
              button.dataset[
                "areaFilter"
              ] ?? "",
            );
          },
        );
      },
    );

    clearAreaButton?.addEventListener(
      "click",
      () => {
        setActiveArea("");
      },
    );

    resetFiltersButton?.addEventListener(
      "click",
      () => {
        if (searchInput) {
          searchInput.value = "";
        }

        setActiveArea("");
      },
    );

    resetSearchButton?.addEventListener(
      "click",
      () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
        }

        setActiveArea("");
      },
    );

    updateFilterCount();
    updateResetState();
    applyFilters();
  };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeOrganizationsPage,
      { once: true },
    );
  } else {
    initializeOrganizationsPage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeOrganizationsPage,
  );
</script>

<style>
  /* ==========================================================================
     TOKENS
     ========================================================================== */

  .organizations-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --warning: #ff6a00;

    --line: rgba(9, 10, 8, 0.18);
    --line-dark: rgba(255, 254, 248, 0.18);

    --container: 1320px;

    width: 100%;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .organizations-container {
    width: min(
      var(--container),
      calc(100% - 40px)
    );
    margin-inline: auto;
  }

  .organizations-page a {
    -webkit-tap-highlight-color: transparent;
  }

  .organizations-page a:focus-visible,
  .organizations-page button:focus-visible,
  .organizations-page input:focus-visible {
    outline: 3px solid var(--warning);
    outline-offset: 4px;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .organizations-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 4px solid var(--ink);
    background:
      linear-gradient(
        115deg,
        var(--paper) 0%,
        var(--paper) 67%,
        var(--acid-soft) 67%,
        var(--acid-soft) 100%
      );
  }

  .organizations-hero::before {
    position: absolute;
    top: 0;
    right: 17%;
    width: 1px;
    height: 100%;
    background: rgba(9, 10, 8, 0.08);
    content: "";
  }

  .organizations-hero::after {
    position: absolute;
    right: -8rem;
    bottom: -13rem;
    width: 30rem;
    height: 30rem;
    border: 3px solid rgba(9, 10, 8, 0.08);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .organizations-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      325px;
    gap: 4rem;
    align-items: end;
    min-height: 545px;
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .organizations-hero__content {
    max-width: 900px;
  }

  .organizations-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    margin-bottom: 1.2rem;
    padding: 0.48rem 0.7rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.62rem;
    font-weight: 700;
