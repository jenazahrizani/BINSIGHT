--- 
import { 
  ArrowRight, 
  Building2, 
  CircleCheck, 
  MapPin, 
  Search, 
  ShieldCheck, 
  SlidersHorizontal, 
  Users, 
} from "@lucide/astro"; 

import PageHeader from "@components/layout/PageHeader.astro"; 
import PublicLayout from "@layouts/PublicLayout.astro"; 

import { 
  getPublicOrganizations, 
  type Organization, 
} from "@lib/data/organizations"; 

const organizations: Organization[] = getPublicOrganizations(); 

const publicOrganizations = organizations.filter( 
  (organization: Organization) => organization.isPublic === true, 
); 

const verifiedOrganizations = publicOrganizations.filter( 
  (organization: Organization) => organization.status === "verified", 
); 

const areaCounts: Record<string, number> = {}; 

for (const organization of verifiedOrganizations) { 
  const area = organization.location?.area?.trim(); 
  if (!area) continue; 
  areaCounts[area] = (areaCounts[area] ?? 0) + 1; 
} 

const areaSummary = Object.entries(areaCounts) 
  .map(([name, count]: [string, number]) => ({ name, count })) 
  .sort((first, second) => second.count - first.count); 

const breadcrumbs = [ 
  { label: "Beranda", href: "/" }, 
  { label: "Organisasi" }, 
]; 

const pageTitle = "Organisasi Pengelolaan Sampah"; 

const pageDescription = 
  "Temukan organisasi yang terlibat dalam ekosistem pengelolaan sampah di Kabupaten Badung."; 

const organizationCount = verifiedOrganizations.length; 
const areaCount = areaSummary.length; 
--- 

<PublicLayout title={pageTitle} description={pageDescription}> 
  <PageHeader 
    title={pageTitle} 
    description={pageDescription} 
    breadcrumbs={breadcrumbs} 
    icon="organization" 
    eyebrow="BINSIGHT · ORGANISASI" 
    tone="green" 
  /> 

  <main class="organizations-page"> 
    <section class="organizations-hero"> 
      <div class="organizations-hero__grid" aria-hidden="true"></div> 
      <div class="organizations-hero__accent" aria-hidden="true"></div> 

      <div class="organizations-hero__content"> 
        <div class="organizations-hero__eyebrow"> 
          <span class="organizations-hero__eyebrow-dot" aria-hidden="true"></span> 
          <Building2 size={15} stroke-width={2} aria-hidden="true" /> 
          <span>EKOSISTEM PENGELOLAAN SAMPAH</span> 
        </div> 

        <h1> 
          Kenali organisasi yang 
          <span class="organizations-hero__outline">mengelola</span> 
          <span class="organizations-hero__lime">sampah di Badung.</span> 
        </h1> 

        <div class="organizations-hero__rule" aria-hidden="true"></div> 

        <p> 
          Jelajahi organisasi yang telah diverifikasi dan dipublikasikan dalam 
          BINSIGHT. Pahami siapa mereka, di mana mereka berada, dan bagaimana 
          mereka terhubung dengan ekosistem persampahan. 
        </p> 

        <div class="organizations-hero__actions"> 
          <a href="#organization-directory" class="primary-action"> 
            <Building2 size={17} stroke-width={2} aria-hidden="true" /> 
            <span>JELAJAHI ORGANISASI</span> 
            <ArrowRight size={16} stroke-width={2} aria-hidden="true" /> 
          </a> 

          <a href="/map" class="secondary-action"> 
            <MapPin size={16} stroke-width={2} aria-hidden="true" /> 
            <span>LIHAT DI PETA</span> 
          </a> 
        </div> 
      </div> 

      <div class="organizations-hero__stats" aria-label="Ringkasan organisasi"> 
        <div class="hero-stat"> 
          <span class="hero-stat__index">01</span> 
          <span class="hero-stat__icon"> 
            <Building2 size={18} stroke-width={2} aria-hidden="true" /> 
          </span> 
          <strong>{organizationCount}</strong> 
          <span class="hero-stat__label">ORGANISASI<br />TERVERIFIKASI</span> 
        </div> 

        <div class="hero-stat"> 
          <span class="hero-stat__index">02</span> 
          <span class="hero-stat__icon"> 
            <MapPin size={18} stroke-width={2} aria-hidden="true" /> 
          </span> 
          <strong>{areaCount}</strong> 
          <span class="hero-stat__label">AREA<br />TERWAKILI</span> 
        </div> 

        <div class="hero-stat"> 
          <span class="hero-stat__index">03</span> 
          <span class="hero-stat__icon"> 
            <ShieldCheck size={18} stroke-width={2} aria-hidden="true" /> 
          </span> 
          <strong>{publicOrganizations.length}</strong> 
          <span class="hero-stat__label">PROFIL<br />PUBLIK</span> 
        </div> 

        <div class="hero-stat__footer"> 
          <span>PUBLIC DIRECTORY</span> 
          <span>BINSIGHT / 03</span> 
        </div> 
      </div> 
    </section> 

    <section id="organization-directory" class="directory-section" aria-labelledby="directory-title"> 
      <div class="section-heading"> 
        <div> 
          <span class="section-eyebrow">03 / NETWORK</span> 
          <h2 id="directory-title">Temukan organisasi.</h2> 
          <p>Gunakan pencarian dan filter area untuk menemukan organisasi yang relevan.</p> 
        </div> 
        <span class="section-count">{organizationCount} TERVERIFIKASI</span> 
      </div> 

      <div class="directory-tools"> 
        <label class="search-field" for="organization-search"> 
          <Search size={17} stroke-width={2} aria-hidden="true" /> 
          <input 
            id="organization-search" 
            type="search" 
            placeholder="Cari nama organisasi atau lokasi..." 
            autocomplete="off" 
          /> 
        </label> 

        <button 
          type="button" 
          class="filter-button" 
          id="organization-filter-button" 
          aria-expanded="false" 
          aria-controls="organization-filter-panel" 
        > 
          <SlidersHorizontal size={17} stroke-width={2} aria-hidden="true" /> 
          <span>FILTER AREA</span> 
        </button> 
      </div> 

      <div class="filter-panel" id="organization-filter-panel"> 
        <div class="filter-panel__heading"> 
          <div> 
            <span class="filter-panel__eyebrow">AREA / INDEX</span> 
            <h3>Organisasi berdasarkan wilayah</h3> 
          </div> 
          <button type="button" class="clear-filter" id="clear-area-filter">SEMUA AREA</button> 
        </div> 

        <div class="area-filter-list"> 
          <button type="button" class="area-filter is-active" data-area-filter=""> 
            <span>Semua area</span> 
            <strong>{organizationCount}</strong> 
          </button> 

          {areaSummary.map(({ name, count }: { name: string; count: number }) => ( 
            <button type="button" class="area-filter" data-area-filter={name}> 
              <span>{name}</span> 
              <strong>{count}</strong> 
            </button> 
          ))} 
        </div> 
      </div> 

      {verifiedOrganizations.length > 0 ? ( 
        <div class="organization-grid" id="organization-grid"> 
          {verifiedOrganizations.map((organization: Organization) => { 
            const area = organization.location?.area?.trim() || "Kabupaten Badung"; 
            const address = organization.location?.address?.trim() || area; 

            return ( 
              <article 
                class="organization-card" 
                data-organization-card 
                data-organization-name={organization.name} 
                data-organization-area={area} 
              > 
                <a 
                  href={`/organizations/${organization.slug}`} 
                  class="organization-card__main" 
                  aria-label={`Lihat profil ${organization.name}`} 
                > 
                  <div class="organization-card__topline"> 
                    <span>ORGANIZATION / {String(verifiedOrganizations.indexOf(organization) + 1).padStart(2, "0")}</span> 
                    <span class="verified-badge"> 
                      <CircleCheck size={13} stroke-width={2} aria-hidden="true" /> 
                      VERIFIED 
                    </span> 
                  </div> 

                  <div class="organization-card__body"> 
                    <div class="organization-card__logo"> 
                      <Building2 size={25} stroke-width={1.8} aria-hidden="true" /> 
                    </div> 

                    <div class="organization-card__copy"> 
                      <h3>{organization.name}</h3> 

                      <div class="organization-card__location"> 
                        <MapPin size={14} stroke-width={2} aria-hidden="true" /> 
                        <span>{address}</span> 
                      </div> 

                      <p>Profil organisasi yang terdaftar dalam ekosistem BINSIGHT.</p> 
                    </div> 

                    <span class="organization-card__arrow"> 
                      <ArrowRight size={18} stroke-width={2} aria-hidden="true" /> 
                    </span> 
                  </div> 
                </a> 

                <div class="organization-card__footer"> 
                  <span> 
                    <MapPin size={13} stroke-width={2} aria-hidden="true" /> 
                    {area} 
                  </span> 

                  <a href={`/organizations/${organization.slug}`} class="organization-card__link"> 
                    OPEN PROFILE 
                    <ArrowRight size={13} stroke-width={2} aria-hidden="true" /> 
                  </a> 
                </div> 
              </article> 
            ); 
          })} 
        </div> 
      ) : ( 
        <div class="empty-state"> 
          <div class="empty-state__icon"> 
            <Building2 size={27} stroke-width={1.8} aria-hidden="true" /> 
          </div> 
          <h3>Belum ada organisasi publik</h3> 
          <p>Belum ada organisasi yang tersedia untuk ditampilkan pada direktori publik.</p> 
        </div> 
      )} 

      <div id="organization-no-results" class="empty-state empty-state--hidden"> 
        <div class="empty-state__icon"> 
          <Search size={27} stroke-width={1.8} aria-hidden="true" /> 
        </div> 
        <h3>Organisasi tidak ditemukan</h3> 
        <p>Coba gunakan kata kunci atau area yang berbeda.</p> 
        <button type="button" id="reset-organization-search">RESET PENCARIAN</button> 
      </div> 
    </section> 

    <section class="trust-section" aria-labelledby="trust-title"> 
      <div class="trust-section__content"> 
        <span class="section-eyebrow section-eyebrow--lime">04 / TRUST LAYER</span> 
        <h2 id="trust-title">Informasi publik yang lebih dapat dipercaya.</h2> 
        <p> 
          BINSIGHT menempatkan verifikasi sebagai bagian penting dari direktori organisasi. 
          Informasi yang ditampilkan kepada publik dipisahkan dari data yang masih dalam proses verifikasi. 
        </p> 
      </div> 

      <div class="trust-points"> 
        <div class="trust-point"> 
          <span class="trust-point__index">01</span> 
          <span class="trust-point__icon"> 
            <ShieldCheck size={19} stroke-width={2} aria-hidden="true" /> 
          </span> 
          <div> 
            <strong>VERIFIKASI ORGANISASI</strong> 
            <p>Profil publik berasal dari organisasi yang telah melewati status verifikasi.</p> 
          </div> 
        </div> 

        <div class="trust-point"> 
          <span class="trust-point__index">02</span> 
          <span class="trust-point__icon"> 
            <MapPin size={19} stroke-width={2} aria-hidden="true" /> 
          </span> 
          <div> 
            <strong>KONTEKS WILAYAH</strong> 
            <p>Lokasi organisasi membantu pengguna memahami ekosistem pada setiap area.</p> 
          </div> 
        </div> 
      </div> 
    </section> 

    <section class="organization-cta"> 
      <div class="organization-cta__icon"> 
        <Users size={23} stroke-width={2} aria-hidden="true" /> 
      </div> 

      <div class="organization-cta__content"> 
        <span>05 / ECOSYSTEM</span> 
        <h2>Ingin mengetahui organisasi dari area tertentu?</h2> 
        <p>Gunakan peta BINSIGHT untuk melihat keterhubungan antara organisasi dan wilayah pengelolaan sampah.</p> 
      </div> 

      <a href="/map" class="organization-cta__button"> 
        BUKA PETA 
        <ArrowRight size={17} stroke-width={2} aria-hidden="true" /> 
      </a> 
    </section> 
  </main> 
</PublicLayout> 

<script> 
  const searchInput = document.querySelector<HTMLInputElement>("#organization-search"); 

  const cards = Array.from( 
    document.querySelectorAll<HTMLElement>("[data-organization-card]"), 
  ); 

  const noResults = document.querySelector<HTMLElement>("#organization-no-results"); 
  const resetSearch = document.querySelector<HTMLButtonElement>("#reset-organization-search"); 
  const filterButton = document.querySelector<HTMLButtonElement>("#organization-filter-button"); 
  const filterPanel = document.querySelector<HTMLElement>("#organization-filter-panel"); 

  const areaButtons = Array.from( 
    document.querySelectorAll<HTMLButtonElement>("[data-area-filter]"), 
  ); 

  let activeArea = ""; 

  function filterOrganizations() { 
    const query = searchInput?.value.trim().toLowerCase() ?? ""; 
    let visibleCount = 0; 

    cards.forEach((card) => { 
      const name = card.dataset["organizationName"]?.toLowerCase() ?? ""; 
      const area = card.dataset["organizationArea"]?.toLowerCase() ?? ""; 
      const searchableText = `${name} ${area}`; 

      const queryMatches = query.length === 0 || searchableText.includes(query); 
      const areaMatches = activeArea.length === 0 || area === activeArea.toLowerCase(); 
      const visible = queryMatches && areaMatches; 

      card.hidden = !visible; 
      if (visible) visibleCount += 1; 
    }); 

    if (noResults) { 
      noResults.classList.toggle("empty-state--hidden", visibleCount > 0); 
    } 
  } 

  searchInput?.addEventListener("input", filterOrganizations); 

  areaButtons.forEach((button) => { 
    button.addEventListener("click", () => { 
      activeArea = button.dataset["areaFilter"] ?? ""; 

      areaButtons.forEach((item) => { 
        item.classList.toggle("is-active", item === button); 
      }); 

      if (activeArea === "") { 
        document.querySelector<HTMLElement>("#clear-area-filter")?.focus(); 
      } 

      filterOrganizations(); 
    }); 
  }); 

  document.querySelector<HTMLButtonElement>("#clear-area-filter")?.addEventListener("click", () => { 
    activeArea = ""; 

    areaButtons.forEach((button) => { 
      button.classList.toggle("is-active", button.dataset["areaFilter"] === ""); 
    }); 

    filterOrganizations(); 
  }); 

  filterButton?.addEventListener("click", () => { 
    const expanded = filterButton.getAttribute("aria-expanded") === "true"; 

    filterButton.setAttribute("aria-expanded", String(!expanded)); 
    filterPanel?.toggleAttribute("data-open", !expanded); 
  }); 

  resetSearch?.addEventListener("click", () => { 
    if (searchInput) { 
      searchInput.value = ""; 
      searchInput.focus(); 
    } 

    activeArea = ""; 

    areaButtons.forEach((button) => { 
      button.classList.toggle("is-active", button.dataset["areaFilter"] === ""); 
    }); 

    filterOrganizations(); 
  }); 
</script> 

<style> 
  .organizations-page { 
    --acid: #dfff00; 
    --acid-soft: #efff70; 
    --ink: #090a08; 
    --ink-2: #11130f; 
    --ink-3: #1b1f18; 
    --paper: #f2f0e6; 
    --paper-2: #e4e1d4; 
    --paper-3: #cfcabd; 
    --white: #fffef8; 
    --muted: #6c7068; 
    --line: #090a08; 
    --orange: #ff6a00; 

    width: min(1320px, calc(100% - 40px)); 
    margin-inline: auto; 
    padding-bottom: 110px; 
    color: var(--ink); 
  } 

  .organizations-page *, 
  .organizations-page *::before, 
  .organizations-page *::after { 
    box-sizing: border-box; 
  } 

  /* HERO */ 

  .organizations-hero { 
    position: relative; 
    display: grid; 
    grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr); 
    min-height: 670px; 
    gap: 42px; 
    margin-top: 30px; 
    padding: 68px; 
    overflow: hidden; 
    isolation: isolate; 
    color: var(--white); 
    background: var(--ink); 
    border: 4px solid var(--white); 
    box-shadow: 14px 14px 0 var(--orange); 
  } 

  .organizations-hero__grid { 
    position: absolute; 
    inset: 0; 
    z-index: -2; 
    background: 
      linear-gradient(rgba(255,255,255,.08) 2px, transparent 2px), 
      linear-gradient(90deg, rgba(255,255,255,.08) 2px, transparent 2px); 
    background-size: 70px 70px; 
    opacity: .12; 
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); 
  } 

  .organizations-hero__accent { 
    position: absolute; 
    top: -100px; 
    right: -75px; 
    z-index: -1; 
    width: 390px; 
    height: 300px; 
    background: var(--acid); 
    clip-path: polygon(0 18%, 80% 0, 100% 72%, 28% 100%); 
    opacity: .92; 
    mix-blend-mode: screen; 
  } 

  .organizations-hero__content { 
    position: relative; 
    z-index: 2; 
    align-self: center; 
  } 

  .organizations-hero__eyebrow { 
    display: inline-flex; 
    align-items: center; 
    gap: 8px; 
    padding: 8px 10px; 
    color: var(--ink); 
    background: var(--acid); 
    border: 3px solid var(--ink); 
    box-shadow: 7px 7px 0 var(--white); 
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace; 
    font-size: 10px; 
    font-weight: 900; 
    letter-spacing: .08em; 
    text-transform: uppercase; 
  } 

  .organizations-hero__eyebrow-dot { 
    width: 9px; 
    height: 9px; 
    border: 2px solid var(--ink); 
    background: var(--orange); 
  } 

  .organizations-hero h1 { 
    max-width: 840px; 
    margin: 42px 0 0; 
    color: var(--white); 
    font-family: Sora, Inter, ui-sans-serif, system-ui, sans-serif; 
    font-size: clamp(70px, 8vw, 122px); 
    font-weight: 900; 
    line-height: .84; 
    letter-spacing: -.085em; 
    text-transform: uppercase; 
  } 

  .organizations-hero__outline { 
    display: block; 
    color: transparent; 
    -webkit-text-stroke: 3px var(--white); 
    transform: translateX(3vw); 
  } 

  .organizations-hero__lime { 
    display: block; 
    color: var(--acid); 
    transform: translateX(-1vw); 
  } 

  .organizations-hero__rule { 
    width: 150px; 
    height: 14px; 
    margin-top: 34px; 
    background: var(--acid); 
    border: 3px solid var(--white); 
    box-shadow: 10px 10px 0 var(--orange); 
  } 

  .organizations-hero__content > p { 
    max-width: 650px; 
    margin: 32px 0 0; 
    padding-left: 16px; 
    color: #deded5; 
    border-left: 7px solid var(--acid); 
    font-size: 15px; 
    font-weight: 500; 
    line-height: 1.7; 
  } 

  .organizations-hero__actions { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 10px; 
    margin-top: 28px; 
  } 

  .primary-action, 
  .secondary-action { 
    min-height: 52px; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    gap: 10px; 
    padding: 0 16px; 
    border: 3px solid currentColor; 
    border-radius: 0; 
    font-size: 10px; 
    font-weight: 900; 
    letter-spacing: .05em; 
    text-decoration: none; 
    text-transform: uppercase; 
    transition: transform 120ms steps(2,end), box-shadow 120ms steps(2,end), background 120ms linear; 
  } 

  .primary-action { 
    color: var(--ink); 
    background: var(--acid); 
    border-color: var(--ink); 
    box-shadow: 8px 8px 0 var(--white); 
  } 

  .primary-action:hover { 
    background: var(--acid-soft); 
    transform: translate(-3px,-3px); 
    box-shadow: 11px 11px 0 var(--orange); 
  } 

  .secondary-action { 
    color: var(--white); 
    background: transparent; 
    border-color: var(--white); 
    box-shadow: 8px 8px 0 rgba(255,255,255,.18); 
  } 

  .secondary-action:hover { 
    color: var(--ink); 
    background: var(--white); 
    border-color: var(--white); 
    transform: translate(-3px,-3px); 
    box-shadow: 11px 11px 0 var(--acid); 
  } 

  .organizations-hero__stats { 
    align-self: center; 
    display: grid; 
    gap: 10px; 
    padding: 16px; 
    background: var(--ink-2); 
    border: 3px solid var(--white); 
  } 

  .hero-stat { 
    display: grid; 
    grid-template-columns: 30px 42px minmax(0, 1fr) auto; 
    align-items: center; 
    gap: 10px; 
    min-height: 82px; 
    padding: 10px; 
    color: var(--white); 
    background: var(--ink-3); 
    border: 2px solid var(--white); 
  } 

  .hero-stat__index { 
    color: var(--orange); 
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace; 
    font-size: 9px; 
    font-weight: 900; 
  } 

  .hero-stat__icon { 
    display: grid; 
    width: 42px; 
    height: 42px; 
    place-items: center; 
    color: var(--ink); 
    background: var(--acid); 
    border: 2px solid var(--ink); 
  } 

  .hero-stat strong { 
    color: var(--acid); 
    font-family: Sora, Inter, sans-serif; 
    font-size: 34px; 
    font-weight: 900; 
    line-height: .9; 
    letter-spacing: -.06em; 
  } 

  .hero-stat__label { 
    color: var(--white); 
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace; 
    font-size: 8px; 
    font-weight: 900; 
    line-height: 1.35; 
    letter-spacing: .08em; 
  } 

  .hero-stat__footer { 
    display: flex; 
    justify-content: space-between; 
    gap: 12px; 
    padding: 5px 2px 0; 
    color: var(--white); 
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace; 
    font-size: 8px; 
    font-weight: 900; 
    letter-spacing: .08em; 
  } 

  .hero-stat__footer span:last-child { 
    color: var(--acid); 
  } 

  /* SECTIONS */ 

  .directory-section { 
    position: relative; 
    padding: 120px 0; 
    border-bottom: 4px solid var(--ink); 
  } 

  .directory-section::before { 
    position: absolute; 
    inset: 0; 
    z-index: -1; 
    content: ""; 
    pointer-events: none; 
    background: repeating-linear-gradient(135deg, rgba(9,10,8,.025) 0 1px, transparent 1px 9px); 
  } 

  .section-heading { 
    display: grid; 
    grid-template-columns: minmax(0, 1fr) auto; 
    gap: 30px; 
    align-items: end; 
    margin-bottom: 44px; 
  } 

  .section-eyebrow { 
    display: inline-block; 
    margin-bottom: 14px; 
    padding: 6px 8px; 
    color: var(--white); 
    background: var(--ink); 
    border: 2px solid var(--ink); 
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace; 
    font-size: 8px; 
    font-weight: 900; 
    letter-spacing: .11em; 
    text-transform: uppercase; 
  } 

  .section-eyebrow--lime { 
    color: var(--ink); 
    background: var(--acid); 
    border-color: var(--acid); 
  } 

  .section-heading h2 { 
    margin: 0; 
    font-family: Sora, Inter, ui-sans-serif, system-ui, sans-serif; 
    font-size: clamp(48px, 6.2vw, 90px); 
    font-weight: 900; 
    line-height: .88; 
    letter-spacing: -.08em; 
    text-transform: uppercase; 
  } 

  .section-heading p { 
    max-width: 620px; 
    margin: 12px 0 0; 
    color: var(--muted); 
    font-size: 13px; 
    line-height: 1.7; 
  } 

  .section-count { 
    align-self: start; 
    padding: 8px 10px; 
    color: var(--ink); 
    background: var(--acid); 
    border: 2px solid var(--ink); 
    box-shadow: 4px 4px 0 var(--orange); 
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace; 
    font-size: 8px; 
    font-weight: 900; 
    letter-spacing: .08em; 
  } 

  .directory-tools { 
    display: grid; 
    grid-template-columns: minmax(0, 1fr) auto; 
    gap: 10px; 
    margin-bottom: 12px; 
  } 

  .search-field { 
    display: flex; 
    align-items: center; 
    gap: 10px; 
    min-height: 54px; 
    padding: 0 14px; 
    color: var(--ink); 
    background: var(--white); 
    border: 3px solid var(--ink); 
    box-shadow: 7px 7px 0 var(--ink); 
  } 

  .search-field:focus-within { 
    border-color: var(--acid); 
    box-shadow: 7px 7px 0 var(--acid); 
  } 

  .search-field input { 
    width: 100%; 
    border: 0; 
    outline: 0; 
    color: var(--ink); 
    background: transparent; 
    font: inherit; 
    font-size: 13px; 
  } 

  .search-field input::placeholder { 
    color: #8a8f86; 
  } 

  .filter-button { 
    min-height: 54px; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    gap: 8px; 
