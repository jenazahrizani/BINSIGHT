  .organizations-hero__content > p {
    max-width: 700px;
    margin: 1.7rem 0 0;
    color: rgba(9, 10, 8, 0.7);
    font-size: 0.9rem;
    line-height: 1.72;
  }

  .organizations-hero__actions {
