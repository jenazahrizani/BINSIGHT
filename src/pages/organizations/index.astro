  .organizations-cta__inner {
    display: grid;
    grid-template-columns:
      3rem
      minmax(0, 1fr)
      auto;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem;
    border: 3px solid var(--ink);
    background: var(--acid);
    box-shadow: 7px 7px 0 var(--ink);
  }

  .organizations-cta__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 2px solid var(--ink);
    background: var(--white);
  }

  .organizations-cta__content > span {
    display: block;
    margin-bottom: 0.25rem;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .organizations-cta__content h2 {
    margin: 0;
    color: var(--ink);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: clamp(
      1rem,
      2vw,
      1.5rem
    );
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .organizations-cta__content p {
    max-width: 700px;
    margin: 0.35rem 0 0;
    color: rgba(9, 10, 8, 0.62);
    font-size: 0.65rem;
    line-height: 1.6;
  }

  .organizations-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.9rem;
    padding: 0 0.8rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
