    color: #166534;
  }

  .secondary-action:hover {
    background: #f0fdf4;
  }

  .organizations-hero__stats {
    display: grid;
    align-content: center;
    gap: 11px;
  }

  .hero-stat {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 10px;
    padding: 14px;
    border: 1px solid #dbe7df;
    border-radius: 16px;
    background: rgba(
      255,
      255,
      255,
      0.85
    );
  }

  .hero-stat__icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 13px;
    background: #dcfce7;
    color: #166534;
  }

