---
import {
  ArrowRight,
  Building2,
  CircleCheck,
  Database,
  Leaf,
  Map,
  MapPin,
  ShieldCheck,
  Users,
} from "@lucide/astro";

import PublicLayout from "../../layouts/PublicLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "BINSIGHT — Badung Waste Intelligence",
  url: "https://binsight.id",
  description:
    "Platform informasi persampahan berbasis data untuk membantu masyarakat memahami, menemukan, dan melaporkan kondisi persampahan di Kabupaten Badung.",
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Kabupaten Badung",
  },
};
---

<PublicLayout
  title="Tentang BINSIGHT"
  description="Mengenal BINSIGHT — Badung Waste Intelligence, platform informasi persampahan berbasis data untuk Kabupaten Badung."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="company-page">
    <!-- HERO -->
    <section class="company-hero">
      <div class="company-container">
        <div class="company-hero__grid">
          <div class="company-hero__content">
            <div class="company-kicker">
              <span class="company-kicker__line"></span>
              <span>BINSIGHT / ABOUT</span>
            </div>

            <h1 class="company-hero__title">
              MEMAHAMI
              <span>PERSAMPAHAN</span>
              BADUNG.
            </h1>

            <p class="company-hero__description">
              BINSIGHT — Badung Waste Intelligence adalah platform informasi
              publik yang membantu masyarakat memahami wilayah, lokasi,
              organisasi, kategori sampah, edukasi, dan laporan kondisi
              persampahan dalam satu ekosistem.
            </p>

            <div class="company-hero__actions">
              <a
                class="company-button company-button--primary"
                href="/map"
              >
                <Map
                  size={18}
                  stroke-width={2.2}
                  aria-hidden="true"
                />
                <span>Jelajahi peta</span>
                <ArrowRight
                  size={17}
                  stroke-width={2.2}
                  aria-hidden="true"
                />
              </a>

              <a
                class="company-button company-button--secondary"
                href="/reports/create"
              >
                <span>Buat laporan</span>
                <ArrowRight
                  size={17}
                  stroke-width={2.2}
                  aria-hidden="true"
                />
              </a>
            </div>

            <div class="company-hero__meta">
              <div class="hero-meta-item">
                <span>PLATFORM</span>
                <strong>INFORMASI PUBLIK</strong>
              </div>

              <div class="hero-meta-item">
                <span>WILAYAH</span>
                <strong>KABUPATEN BADUNG</strong>
              </div>

              <div class="hero-meta-item">
                <span>FOKUS</span>
                <strong>PERSAMPAHAN</strong>
              </div>
            </div>
          </div>

          <div class="company-hero__visual">
            <div class="intel-card">
              <div class="intel-card__header">
                <div class="intel-card__brand">
                  <div class="intel-card__brand-mark">
                    <Leaf
                      size={19}
                      stroke-width={2.1}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>BINSIGHT</strong>
                    <span>BADUNG WASTE INTELLIGENCE</span>
                  </div>
                </div>

                <span class="intel-card__code">001 / ABOUT</span>
              </div>

              <div class="intel-map">
                <div class="intel-map__noise"></div>
                <div class="intel-map__grid"></div>

                <div class="intel-map__district intel-map__district--one"></div>
                <div class="intel-map__district intel-map__district--two"></div>
                <div class="intel-map__district intel-map__district--three"></div>

                <div class="intel-map__road intel-map__road--one"></div>
                <div class="intel-map__road intel-map__road--two"></div>
                <div class="intel-map__road intel-map__road--three"></div>
                <div class="intel-map__road intel-map__road--four"></div>

                <div class="intel-map__node intel-map__node--one">
                  <span></span>
                </div>

                <div class="intel-map__node intel-map__node--two">
                  <span></span>
                </div>

                <div class="intel-map__node intel-map__node--three">
                  <span></span>
                </div>

                <div class="intel-map__node intel-map__node--four">
                  <span></span>
                </div>

                <div class="intel-map__label intel-map__label--one">
                  <MapPin
                    size={13}
                    stroke-width={2.1}
                    aria-hidden="true"
                  />
                  <span>LOCATION</span>
                </div>

                <div class="intel-map__label intel-map__label--two">
                  <Building2
                    size={13}
                    stroke-width={2.1}
                    aria-hidden="true"
                  />
                  <span>ORGANIZATION</span>
                </div>

                <div class="intel-map__coordinate">
                  <span>BADUNG</span>
                  <strong>08°43′ S</strong>
                  <strong>115°10′ E</strong>
                </div>
              </div>

              <div class="intel-card__footer">
                <div>
                  <span>SYSTEM</span>
                  <strong>PUBLIC DATA LAYER</strong>
                </div>

                <div>
                  <span>STATUS</span>
                  <strong>ACTIVE</strong>
                </div>

                <span class="intel-card__footer-mark">BSI</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY -->
    <section class="company-section company-section--paper">
      <div class="company-container">
        <div class="section-header section-header--split">
          <div>
            <div class="section-kicker">
              <span>01</span>
              <span>MENGAPA BINSIGHT</span>
            </div>

            <h2>
              DATA YANG TERHUBUNG.
              <span>INFORMASI YANG LEBIH JELAS.</span>
            </h2>
          </div>

          <p>
            Persampahan bukan hanya tentang jumlah sampah. Ada wilayah,
            lokasi, material, organisasi pengelola, proses penanganan,
            dan kondisi lapangan yang saling berkaitan.
          </p>
        </div>

        <div class="principle-grid">
          <article class="principle-card">
            <div class="principle-card__top">
              <span class="principle-card__number">01</span>

              <div class="principle-card__icon">
                <Map
                  size={21}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>
            </div>

            <h3>BERBASIS LOKASI</h3>

            <p>
              Informasi ditempatkan dalam konteks wilayah dan lokasi agar
              masyarakat dapat melihat kondisi secara lebih nyata.
            </p>
          </article>

          <article class="principle-card">
            <div class="principle-card__top">
              <span class="principle-card__number">02</span>

              <div class="principle-card__icon">
                <Building2
                  size={21}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>
            </div>

            <h3>TERHUBUNG DENGAN ORGANISASI</h3>

            <p>
              BINSIGHT membantu memperlihatkan pihak yang memiliki peran
              dalam ekosistem persampahan di tingkat wilayah.
            </p>
          </article>

          <article class="principle-card">
            <div class="principle-card__top">
              <span class="principle-card__number">03</span>

              <div class="principle-card__icon">
                <ShieldCheck
                  size={21}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>
            </div>

            <h3>MENEKANKAN KEPERCAYAAN</h3>

            <p>
              Data publik diarahkan untuk dikelola secara terstruktur dan
              dapat ditelusuri melalui konteks yang jelas.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- PILLARS -->
    <section class="company-section company-section--light">
      <div class="company-container">
        <div class="section-header">
          <div class="section-kicker">
            <span>02</span>
            <span>EMPAT PILAR</span>
          </div>

          <h2>
            DARI MELIHAT DATA
            <span>HINGGA IKUT MELAPORKAN.</span>
          </h2>

          <p>
            BINSIGHT dibangun di sekitar empat fungsi yang saling melengkapi:
            menemukan, memahami, mempelajari, dan berkontribusi.
          </p>
        </div>

        <div class="pillar-grid">
          <article class="pillar-card pillar-card--featured">
            <div class="pillar-card__top">
              <span>01 / MAP</span>

              <Map
                size={23}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <div class="pillar-card__body">
              <h3>MAP</h3>

              <p>
                Temukan lokasi, wilayah, dan informasi spasial terkait
                persampahan Kabupaten Badung.
              </p>
            </div>

            <a href="/map">
              Buka peta
              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__top">
              <span>02 / DATA</span>

              <Database
                size={23}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <div class="pillar-card__body">
              <h3>DATA</h3>

              <p>
                Kenali kategori sampah, material, organisasi, lokasi, dan
                informasi terkait yang tersedia di platform.
              </p>
            </div>

            <a href="/dashboard">
              Lihat data
              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__top">
              <span>03 / EDUCATION</span>

              <Leaf
                size={23}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <div class="pillar-card__body">
              <h3>EDUCATION</h3>

              <p>
                Pelajari karakteristik material dan berbagai pendekatan
                penanganan sampah secara lebih terstruktur.
              </p>
            </div>

            <a href="/waste">
              Pelajari sampah
              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__top">
              <span>04 / REPORT</span>

              <CircleCheck
                size={23}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <div class="pillar-card__body">
              <h3>REPORT</h3>

              <p>
                Sampaikan kondisi lapangan agar dapat menjadi bagian dari
                proses verifikasi dan pemantauan.
              </p>
            </div>

            <a href="/reports/create">
              Buat laporan
              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- MISSION -->
    <section class="company-section company-section--dark">
      <div class="company-container">
        <div class="mission-layout">
          <div class="mission-content">
            <div class="section-kicker section-kicker--light">
              <span>03</span>
              <span>ARAH BINSIGHT</span>
            </div>

            <h2>
              MEMBUAT INFORMASI
              <span>LEBIH DEKAT.</span>
            </h2>

            <p>
              BINSIGHT tidak dirancang sebagai layanan pengangkutan,
              marketplace, atau sistem transaksi. Fokusnya adalah membangun
              lapisan informasi yang membantu publik melihat, memahami,
              dan ikut berkontribusi terhadap ekosistem persampahan.
            </p>

            <div class="mission-checks">
              <div class="mission-check">
                <span class="mission-check__icon">
                  <CircleCheck
                    size={15}
                    stroke-width={2.2}
                    aria-hidden="true"
                  />
                </span>

                <span>Informasi lebih mudah diakses</span>
              </div>

              <div class="mission-check">
                <span class="mission-check__icon">
                  <CircleCheck
                    size={15}
                    stroke-width={2.2}
                    aria-hidden="true"
                  />
                </span>

                <span>Hubungan data lebih jelas</span>
              </div>

              <div class="mission-check">
                <span class="mission-check__icon">
                  <CircleCheck
                    size={15}
                    stroke-width={2.2}
                    aria-hidden="true"
                  />
                </span>

                <span>Pelaporan masyarakat lebih terstruktur</span>
              </div>
            </div>
          </div>

          <aside class="mission-panel">
            <div class="mission-panel__header">
              <div class="mission-panel__icon">
                <Users
                  size={23}
                  stroke-width={1.9}
                  aria-hidden="true"
                />
              </div>

              <span>FOR THE ECOSYSTEM</span>
            </div>

            <h3>
              MASYARAKAT.
              <br />
              ORGANISASI.
              <br />
              DATA.
            </h3>

            <p>
              Satu lapisan informasi untuk mempertemukan kebutuhan berbagai
              pihak dalam konteks wilayah Kabupaten Badung.
            </p>

            <div class="mission-panel__divider"></div>

            <div class="mission-panel__footer">
              <span>BINSIGHT</span>
              <span>BADUNG</span>
              <span>2026</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="company-cta">
      <div class="company-container">
        <div class="company-cta__card">
          <div class="company-cta__content">
            <div class="company-kicker">
              <span class="company-kicker__line"></span>
              <span>START EXPLORING</span>
            </div>

            <h2>
              KENALI EKOSISTEM
              <span>PERSAMPAHAN BADUNG.</span>
            </h2>

            <p>
              Mulai dari peta, data sampah, organisasi, atau laporan
              masyarakat.
            </p>
          </div>

          <div class="company-cta__actions">
            <a
              class="company-button company-button--primary"
              href="/map"
            >
              <Map
                size={18}
                stroke-width={2.1}
                aria-hidden="true"
              />
              <span>Jelajahi BINSIGHT</span>
              <ArrowRight
                size={17}
                stroke-width={2.1}
                aria-hidden="true"
              />
            </a>

            <a
              class="company-button company-button--secondary"
              href="/organizations"
            >
              <span>Lihat organisasi</span>
              <ArrowRight
                size={17}
                stroke-width={2.1}
                aria-hidden="true"
              />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  .company-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --orange: #ff6a00;

    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
  }

  .company-page *,
  .company-page *::before,
  .company-page *::after {
    box-sizing: border-box;
  }

  .company-page a {
    -webkit-tap-highlight-color: transparent;
  }

  .company-container {
    width: min(1320px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* --------------------------------
     SHARED
  -------------------------------- */

  .company-kicker,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .company-kicker__line {
    width: 30px;
    height: 3px;
    background: var(--acid);
  }

  .section-kicker {
    color: var(--muted);
  }

  .section-kicker > span:first-child {
    color: var(--orange);
  }

  .section-kicker--light {
    color: rgb(255 255 248 / 58%);
  }

  .section-kicker--light > span:first-child {
    color: var(--acid);
  }

  .section-header {
    max-width: 790px;
  }

  .section-header--split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.58fr);
    gap: 60px;
    align-items: end;
    max-width: none;
  }

  .section-header h2 {
    margin: 18px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: clamp(2rem, 4.8vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .section-header h2 span {
    display: block;
    color: var(--muted);
  }

  .section-header p {
    max-width: 640px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .section-header--split p {
    margin: 0;
  }

  /* --------------------------------
     HERO
  -------------------------------- */

  .company-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 4px solid var(--ink);
    background:
      radial-gradient(
        circle at 83% 15%,
        rgb(223 255 0 / 15%),
        transparent 24%
      ),
      var(--paper);
  }

  .company-hero::before {
    position: absolute;
    top: 0;
    right: 0;
    width: 34%;
    height: 100%;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgb(9 10 8 / 2%)
      );
    content: "";
    pointer-events: none;
  }

  .company-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(410px, 0.95fr);
    gap: clamp(44px, 7vw, 110px);
    align-items: center;
    min-height: 720px;
    padding: 86px 0;
  }

  .company-hero__content {
    position: relative;
    z-index: 2;
  }

  .company-hero__title {
    max-width: 760px;
    margin: 22px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: clamp(3.2rem, 7.2vw, 6.7rem);
    font-weight: 800;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .company-hero__title span {
    display: block;
    color: var(--ink);
    text-shadow: 7px 7px 0 var(--acid);
  }

  .company-hero__description {
    max-width: 690px;
    margin: 34px 0 0;
    color: #444840;
    font-size: clamp(1rem, 1.7vw, 1.16rem);
    line-height: 1.72;
  }

  .company-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .company-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 50px;
    padding: 0 18px;
    border: 2px solid var(--ink);
    border-radius: 0;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 150ms ease,
      box-shadow 150ms ease,
      background 150ms ease,
      color 150ms ease;
  }

  .company-button:hover {
    transform: translate(-2px, -2px);
  }

  .company-button:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  .company-button--primary {
    background: var(--ink);
    color: var(--acid);
    box-shadow: 6px 6px 0 var(--acid);
  }

  .company-button--primary:hover {
    background: var(--ink-3);
    box-shadow: 8px 8px 0 var(--acid);
  }

  .company-button--secondary {
    background: transparent;
    color: var(--ink);
  }

  .company-button--secondary:hover {
    background: var(--acid);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .company-hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    max-width: 720px;
    margin-top: 56px;
    border-top: 2px solid var(--ink);
  }

  .hero-meta-item {
    min-width: 0;
    padding: 14px 16px 0 0;
    border-right: 1px solid var(--paper-3);
  }

  .hero-meta-item:not(:first-child) {
    padding-left: 16px;
  }

  .hero-meta-item:last-child {
    border-right: 0;
  }

  .hero-meta-item span,
  .hero-meta-item strong {
    display: block;
  }

  .hero-meta-item span {
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.57rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hero-meta-item strong {
    margin-top: 6px;
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.3;
  }

  /* --------------------------------
     HERO VISUAL
  -------------------------------- */

  .company-hero__visual {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
  }

  .intel-card {
    width: min(100%, 540px);
    overflow: hidden;
    border: 3px solid var(--ink);
    background: var(--ink);
    box-shadow: 14px 14px 0 var(--acid);
  }

  .intel-card__header,
  .intel-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 18px;
  }

  .intel-card__header {
    border-bottom: 1px solid rgb(255 255 248 / 12%);
  }

  .intel-card__footer {
    border-top: 1px solid rgb(255 255 248 / 12%);
  }

  .intel-card__brand {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
  }

  .intel-card__brand-mark {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--acid);
    color: var(--ink);
  }

  .intel-card__brand strong,
  .intel-card__brand span {
    display: block;
  }

  .intel-card__brand strong {
    color: var(--white);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .intel-card__brand span {
