---
import {
  ArrowRight,
  Building2,
  CircleCheck,
  Database,
  Leaf,
  Map,
  MapPin,
  ShieldCheck,
  Users,
} from "@lucide/astro";

import PublicLayout from "../../layouts/PublicLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "BINSIGHT — Badung Waste Intelligence",
  url: "https://binsight.id",
  description:
    "Platform informasi persampahan berbasis data untuk membantu masyarakat memahami, menemukan, dan melaporkan kondisi persampahan di Kabupaten Badung.",
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Kabupaten Badung",
  },
};
---

<PublicLayout
  title="Tentang BINSIGHT"
  description="Mengenal BINSIGHT — Badung Waste Intelligence, platform informasi persampahan berbasis data untuk Kabupaten Badung."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="company-page">
    <PageHeader
      eyebrow="TENTANG BINSIGHT"
      title="Membangun pemahaman persampahan yang lebih terbuka dan berbasis data"
      description="BINSIGHT — Badung Waste Intelligence hadir sebagai platform informasi untuk membantu masyarakat memahami ekosistem persampahan, menemukan informasi lokasi dan organisasi, serta menyampaikan laporan kondisi lapangan."
      icon="organization"
      tone="green"
      breadcrumbs={[
        {
          label: "Beranda",
          href: "/",
        },
        {
          label: "Tentang BINSIGHT",
          href: "/company",
        },
      ]}
    />

    <section class="company-hero">
      <div class="company-container">
        <div class="company-hero__grid">
          <div class="company-hero__content">
            <span class="company-eyebrow">
              BADUNG WASTE INTELLIGENCE
            </span>

            <h1 class="company-hero__title">
              Satu tempat untuk
              <span>
                memahami persampahan Badung.
              </span>
            </h1>

            <p class="company-hero__description">
              BINSIGHT dirancang sebagai platform informasi publik yang
              menghubungkan data wilayah, lokasi, organisasi pengelola,
              kategori sampah, edukasi, dan laporan masyarakat dalam satu
              pengalaman yang mudah dipahami.
            </p>

            <div class="company-hero__actions">
              <a
                class="company-button company-button--primary"
                href="/map"
              >
                <Map
                  size={18}
                  stroke-width={2}
                  aria-hidden="true"
                />

                <span>
                  Jelajahi peta
                </span>

                <ArrowRight
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a
                class="company-button company-button--secondary"
                href="/reports/create"
              >
                <span>
                  Buat laporan
                </span>

                <ArrowRight
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
            </div>
          </div>

          <div class="company-hero__visual">
            <div class="company-visual-card">
              <div class="company-visual-card__glow"></div>

              <div class="company-visual-card__top">
                <div class="company-visual-card__brand">
                  <div class="company-visual-card__brand-icon">
                    <Leaf
                      size={21}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>
                      BINSIGHT
                    </strong>

                    <span>
                      Badung Waste Intelligence
                    </span>
                  </div>
                </div>

                <span class="company-visual-card__status">
                  DATA • MAP • REPORT
                </span>
              </div>

              <div class="company-map-visual">
                <div class="company-map-visual__grid"></div>

                <div class="company-map-visual__route company-map-visual__route--one"></div>
                <div class="company-map-visual__route company-map-visual__route--two"></div>
                <div class="company-map-visual__route company-map-visual__route--three"></div>

                <span class="company-map-visual__marker company-map-visual__marker--one"></span>
                <span class="company-map-visual__marker company-map-visual__marker--two"></span>
                <span class="company-map-visual__marker company-map-visual__marker--three"></span>
                <span class="company-map-visual__marker company-map-visual__marker--four"></span>

                <div class="company-map-visual__label company-map-visual__label--one">
                  <MapPin
                    size={14}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Lokasi
                  </span>
                </div>

                <div class="company-map-visual__label company-map-visual__label--two">
                  <Building2
                    size={14}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Organisasi
                  </span>
                </div>
              </div>

              <div class="company-visual-card__bottom">
                <div class="company-mini-stat">
                  <span>
                    PLATFORM
                  </span>

                  <strong>
                    INFORMASI PUBLIK
                  </strong>
                </div>

                <div class="company-mini-stat">
                  <span>
                    WILAYAH
                  </span>

                  <strong>
                    KABUPATEN BADUNG
                  </strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="company-section company-section--muted">
      <div class="company-container">
        <div class="section-heading">
          <span class="section-heading__eyebrow">
            MENGAPA BINSIGHT
          </span>

          <h2 class="section-heading__title">
            Informasi persampahan seharusnya mudah ditemukan dan dipahami
          </h2>

          <p class="section-heading__description">
            Persampahan bukan hanya soal jumlah sampah. Ada wilayah, lokasi,
            jenis material, organisasi pengelola, proses penanganan, serta
            informasi kondisi lapangan yang saling berkaitan.
          </p>
        </div>

        <div class="principle-grid">
          <article class="principle-card">
            <div class="principle-card__icon">
              <Map
                size={21}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <span class="principle-card__number">
              01
            </span>

            <h3>
              Berbasis lokasi
            </h3>

            <p>
              Informasi ditempatkan dalam konteks wilayah dan lokasi sehingga
              masyarakat dapat memahami kondisi secara lebih nyata.
            </p>
          </article>

          <article class="principle-card">
            <div class="principle-card__icon">
              <Building2
                size={21}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <span class="principle-card__number">
              02
            </span>

            <h3>
              Terhubung dengan organisasi
            </h3>

            <p>
              BINSIGHT membantu memperlihatkan siapa yang mengelola,
              menangani, atau memiliki peran dalam ekosistem persampahan.
            </p>
          </article>

          <article class="principle-card">
            <div class="principle-card__icon">
              <ShieldCheck
                size={21}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <span class="principle-card__number">
              03
            </span>

            <h3>
              Menekankan kepercayaan
            </h3>

            <p>
              Informasi publik diarahkan untuk melalui proses verifikasi dan
              pengelolaan data yang terstruktur.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="company-section">
      <div class="company-container">
        <div class="pillars-heading">
          <div>
            <span class="section-heading__eyebrow">
              EMPAT PILAR
            </span>

            <h2 class="section-heading__title">
              Dari melihat data hingga ikut melaporkan
            </h2>
          </div>

          <p class="pillars-heading__description">
            Pengalaman BINSIGHT dibangun di sekitar empat fungsi utama yang
            saling melengkapi.
          </p>
        </div>

        <div class="pillar-grid">
          <article class="pillar-card pillar-card--featured">
            <div class="pillar-card__top">
              <span class="pillar-card__index">
                01
              </span>

              <Map
                size={24}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <h3>
              MAP
            </h3>

            <p>
              Temukan lokasi, wilayah, dan informasi spasial terkait
              persampahan Kabupaten Badung.
            </p>

            <a href="/map">
              Buka peta

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__top">
              <span class="pillar-card__index">
                02
              </span>

              <Database
                size={24}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <h3>
              DATA
            </h3>

            <p>
              Kenali kategori sampah, material, organisasi, lokasi, dan
              informasi terkait yang tersedia di platform.
            </p>

            <a href="/dashboard">
              Lihat data

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__top">
              <span class="pillar-card__index">
                03
              </span>

              <Leaf
                size={24}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <h3>
              EDUCATION
            </h3>

            <p>
              Pelajari karakteristik material dan berbagai pendekatan
              penanganan sampah secara lebih terstruktur.
            </p>

            <a href="/waste">
              Pelajari sampah

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__top">
              <span class="pillar-card__index">
                04
              </span>

              <CircleCheck
                size={24}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <h3>
              REPORT
            </h3>

            <p>
              Sampaikan kondisi lapangan yang ditemukan agar dapat menjadi
              bagian dari proses verifikasi dan pemantauan.
            </p>

            <a href="/reports/create">
              Buat laporan

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="company-section company-section--dark">
      <div class="company-container">
        <div class="mission-layout">
          <div class="mission-content">
            <span class="section-heading__eyebrow section-heading__eyebrow--light">
              ARAH BINSIGHT
            </span>

            <h2 class="mission-title">
              Membuat informasi persampahan lebih dekat dengan masyarakat.
            </h2>

            <p class="mission-description">
              BINSIGHT tidak dirancang sebagai layanan pengangkutan,
              marketplace, atau sistem transaksi. Fokusnya adalah membangun
              lapisan informasi yang membantu publik melihat, memahami, dan
              ikut berkontribusi terhadap ekosistem persampahan.
            </p>

            <div class="mission-checks">
              <div class="mission-check">
                <span class="mission-check__icon">
                  <CircleCheck
                    size={15}
                    stroke-width={2.2}
                    aria-hidden="true"
                  />
                </span>

                <span>
                  Informasi yang lebih mudah diakses
                </span>
              </div>

              <div class="mission-check">
                <span class="mission-check__icon">
                  <CircleCheck
                    size={15}
                    stroke-width={2.2}
                    aria-hidden="true"
                  />
                </span>

                <span>
                  Hubungan data yang lebih jelas
                </span>
              </div>

              <div class="mission-check">
                <span class="mission-check__icon">
                  <CircleCheck
                    size={15}
                    stroke-width={2.2}
                    aria-hidden="true"
                  />
                </span>

                <span>
                  Pelaporan masyarakat yang lebih terstruktur
                </span>
              </div>
            </div>
          </div>

          <div class="mission-panel">
            <div class="mission-panel__icon">
              <Users
                size={24}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <span class="mission-panel__eyebrow">
              UNTUK EKOSISTEM
            </span>

            <h3>
              Masyarakat, organisasi, dan pengelola data.
            </h3>

            <p>
              BINSIGHT mempertemukan kebutuhan berbagai pihak dalam satu
              platform informasi yang berorientasi pada konteks wilayah.
            </p>

            <div class="mission-panel__footer">
              <span>
                BINSIGHT
              </span>

              <span>
                BADUNG
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="company-cta">
      <div class="company-container">
        <div class="company-cta__card">
          <div>
            <span class="company-cta__eyebrow">
              MULAI MENJELAJAH
            </span>

            <h2>
              Kenali ekosistem persampahan Badung lebih dekat.
            </h2>

            <p>
              Mulai dari peta, data sampah, organisasi, atau laporan masyarakat.
            </p>
          </div>

          <div class="company-cta__actions">
            <a
              class="company-button company-button--primary"
              href="/map"
            >
              <Map
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>
                Jelajahi BINSIGHT
              </span>

              <ArrowRight
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>

            <a
              class="company-button company-button--secondary"
              href="/organizations"
            >
              Lihat organisasi

              <ArrowRight
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  .company-page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .company-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .company-hero {
    position: relative;
    overflow: hidden;
    padding: 0 0 var(--space-12);
    background:
      radial-gradient(
        circle at 80% 20%,
        var(--color-primary-soft),
        transparent 34%
      );
  }

  .company-hero__grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.03fr)
      minmax(360px, 0.97fr);
    gap: var(--space-10);
    align-items: center;
    min-height: 520px;
  }

  .company-hero__content {
    max-width: 690px;
  }

  .company-eyebrow,
  .section-heading__eyebrow,
  .company-cta__eyebrow,
  .mission-panel__eyebrow {
    display: inline-flex;
    align-items: center;
    color: var(--color-primary-dark);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .company-hero__title {
    max-width: 700px;
    margin: var(--space-4) 0 0;
    color: var(--color-text-strong);
    font-size: clamp(2.25rem, 5vw, 4.2rem);
    font-weight: 850;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .company-hero__title span {
    display: block;
    color: var(--color-primary);
  }

  .company-hero__description {
    max-width: 650px;
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    line-height: 1.72;
  }

  .company-hero__actions,
  .company-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .company-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .company-button:hover {
    transform: translateY(-1px);
  }

  .company-button--primary {
    border: 1px solid var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .company-button--primary:hover {
    background: var(--color-primary-dark);
    box-shadow: var(--shadow-md);
  }

  .company-button--secondary {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-strong);
  }

  .company-button--secondary:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-sm);
  }

  .company-button:focus-visible {
    outline: 3px solid var(--color-primary-ring);
    outline-offset: 3px;
  }

  .company-hero__visual {
    display: flex;
    justify-content: flex-end;
  }

  .company-visual-card {
    position: relative;
    width: min(100%, 510px);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 28px;
    background:
      linear-gradient(
        145deg,
        var(--color-primary-dark),
        #0f2419 72%
      );
    box-shadow: var(--shadow-lg);
  }

  .company-visual-card__glow {
    position: absolute;
    top: -90px;
    right: -70px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: var(--color-primary);
    opacity: 0.15;
    filter: blur(10px);
  }

  .company-visual-card__top,
  .company-visual-card__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .company-visual-card__top {
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }

  .company-visual-card__bottom {
    border-top: 1px solid rgb(255 255 255 / 8%);
  }

  .company-visual-card__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .company-visual-card__brand-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgb(255 255 255 / 10%);
    color: #bef264;
  }

  .company-visual-card__brand strong,
  .company-visual-card__brand span {
    display: block;
  }

  .company-visual-card__brand strong {
    color: #ffffff;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .company-visual-card__brand span {
    margin-top: 2px;
    color: rgb(255 255 255 / 62%);
    font-size: 0.66rem;
  }

  .company-visual-card__status {
    flex: 0 0 auto;
    color: #bef264;
    font-size: 0.57rem;
    font-weight: 850;
    letter-spacing: 0.09em;
  }

  .company-map-visual {
    position: relative;
    min-height: 360px;
    overflow: hidden;
    background:
      linear-gradient(
        145deg,
        #174b2c,
        #123821
      );
  }

  .company-map-visual__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        rgb(255 255 255 / 6%) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgb(255 255 255 / 6%) 1px,
        transparent 1px
      );
    background-size: 42px 42px;
    opacity: 0.65;
  }

  .company-map-visual__route {
    position: absolute;
    height: 2px;
    border-radius: 999px;
    background: rgb(190 242 100 / 50%);
    transform-origin: left center;
    box-shadow: 0 0 18px rgb(190 242 100 / 20%);
  }

  .company-map-visual__route--one {
    top: 23%;
    left: 4%;
    width: 88%;
    transform: rotate(13deg);
  }

  .company-map-visual__route--two {
    top: 62%;
    left: 11%;
    width: 78%;
    transform: rotate(-18deg);
  }

  .company-map-visual__route--three {
    top: 9%;
    left: 52%;
    width: 62%;
    transform: rotate(74deg);
  }

  .company-map-visual__marker {
    position: absolute;
    width: 13px;
    height: 13px;
    border: 3px solid #ffffff;
    border-radius: 50%;
    background: #84cc16;
    box-shadow:
      0 0 0 8px rgb(132 204 22 / 10%),
      0 8px 20px rgb(0 0 0 / 22%);
  }

  .company-map-visual__marker--one {
    top: 30%;
    left: 23%;
  }

  .company-map-visual__marker--two {
    top: 47%;
    left: 69%;
  }

  .company-map-visual__marker--three {
    top: 72%;
    left: 36%;
  }

  .company-map-visual__marker--four {
    top: 17%;
    left: 79%;
  }

  .company-map-visual__label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 9px;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 9px;
    background: rgb(9 28 16 / 72%);
    backdrop-filter: blur(10px);
    color: #ffffff;
    font-size: 0.61rem;
    font-weight: 750;
  }

  .company-map-visual__label svg {
    color: #bef264;
  }

  .company-map-visual__label--one {
    top: 33%;
    left: 27%;
  }

  .company-map-visual__label--two {
    top: 49%;
    right: 7%;
  }

  .company-mini-stat {
    min-width: 0;
  }

  .company-mini-stat span,
  .company-mini-stat strong {
    display: block;
  }

  .company-mini-stat span {
    color: rgb(255 255 255 / 44%);
    font-size: 0.54rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .company-mini-stat strong {
    margin-top: 4px;
    color: #ffffff;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .company-section {
    padding: var(--space-14) 0;
    background: var(--color-surface);
  }

  .company-section--muted {
    background: var(--color-surface-soft);
  }

  .section-heading {
    max-width: 760px;
  }

  .section-heading__title {
    margin: var(--space-3) 0 0;
    color: var(--color-text-strong);
    font-size: clamp(1.75rem, 3.2vw, 2.55rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .section-heading__description {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
