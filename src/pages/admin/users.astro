---
import {
  Ban,
  CircleCheck,
  Clock3,
  Eye,
  KeyRound,
  Mail,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  UserRound,
  Users,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

type UserStatus =
  | "active"
  | "pending"
  | "suspended";

type UserRole =
  | "super-admin"
  | "admin"
  | "editor"
  | "viewer"
  | "organization";

interface UserRecord {
  id: string;
  name: string;
  email: string;
  role: UserRole;
  roleLabel: string;
  status: UserStatus;
  statusLabel: string;
  organization: string;
  lastActive: string;
  createdAt: string;
}

const users: UserRecord[] = [
  {
    id: "user-demo-001",
    name: "Admin BINSIGHT",
    email: "admin@binsight.id",
    role: "super-admin",
    roleLabel: "Super Admin",
    status: "active",
    statusLabel: "Aktif",
    organization: "BINSIGHT",
    lastActive: "Hari ini, 10:42",
    createdAt: "1 Sep 2026",
  },
  {
    id: "user-demo-002",
    name: "Pengelola Data",
    email: "data@binsight.id",
    role: "admin",
    roleLabel: "Admin",
    status: "active",
    statusLabel: "Aktif",
    organization: "BINSIGHT",
    lastActive: "Hari ini, 09:51",
    createdAt: "2 Sep 2026",
  },
  {
    id: "user-demo-003",
    name: "Editor Konten",
    email: "editor@binsight.id",
    role: "editor",
    roleLabel: "Editor",
    status: "active",
    statusLabel: "Aktif",
    organization: "BINSIGHT",
    lastActive: "9 Sep 2026, 16:18",
    createdAt: "3 Sep 2026",
  },
  {
    id: "user-demo-004",
    name: "Operator Organisasi",
    email: "operator@contoh.id",
    role: "organization",
    roleLabel: "Organisasi",
    status: "pending",
    statusLabel: "Menunggu",
    organization: "Organisasi Pengelola Sampah",
    lastActive: "Belum aktif",
    createdAt: "9 Sep 2026",
  },
  {
    id: "user-demo-005",
    name: "Pengguna Publik",
    email: "viewer@contoh.id",
    role: "viewer",
    roleLabel: "Viewer",
    status: "suspended",
    statusLabel: "Ditangguhkan",
    organization: "—",
    lastActive: "6 Sep 2026, 11:24",
    createdAt: "4 Sep 2026",
  },
];

const roleLabels: Record<UserRole, string> = {
  "super-admin": "Super Admin",
  admin: "Admin",
  editor: "Editor",
  viewer: "Viewer",
  organization: "Organisasi",
};

const statusLabels: Record<UserStatus, string> = {
  active: "Aktif",
  pending: "Menunggu",
  suspended: "Ditangguhkan",
};

const totalUsers =
  users.length;

const activeUsers =
  users.filter(
    (user) =>
      user.status === "active",
  ).length;

const pendingUsers =
  users.filter(
    (user) =>
      user.status === "pending",
  ).length;

const suspendedUsers =
  users.filter(
    (user) =>
      user.status === "suspended",
  ).length;

const usersPayload =
  users.map((user) => ({
    ...user,
  }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Pengguna — Admin BINSIGHT",
  description:
    "Administrasi pengguna BINSIGHT untuk pengelolaan peran, status akun, dan akses platform.",
  url: "https://binsight.id/admin/users",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Pengguna"
  description="Kelola akun, peran, dan status akses pengguna BINSIGHT."
  activeSection="users"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main
    class="users-page"
    data-users-page
  >
    <script
      id="admin-users-data"
      type="application/json"
      is:inline
      set:html={JSON.stringify(usersPayload)}
    />

    <section class="page-intro">
      <div class="page-intro__main">
        <div class="page-intro__eyebrow">
          <span class="page-intro__mark">
            <Users
              size={15}
              stroke-width={2.2}
              aria-hidden="true"
            />
          </span>

          <span>
            USER MANAGEMENT / ADMIN
          </span>
        </div>

        <div class="page-intro__heading-row">
          <div>
            <h1>
              Pengguna
            </h1>

            <p>
              Kelola akun internal dan pengguna organisasi dengan kontrol
              peran yang jelas sehingga akses data BINSIGHT tetap
              terarah.
            </p>
          </div>

          <div class="page-intro__code">
            <span>
              ACCESS
            </span>

            <strong>
              / USERS
            </strong>
          </div>
        </div>
      </div>

      <div class="page-intro__actions">
        <button
          type="button"
          class="button button--light"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2.2}
            aria-hidden="true"
          />

          <span>
            Refresh
          </span>
        </button>

        <button
          type="button"
          class="button button--primary"
          data-create-user
        >
          <Plus
            size={17}
            stroke-width={2.2}
            aria-hidden="true"
          />

          <span>
            Tambah pengguna
          </span>
        </button>
      </div>
    </section>

    <section
      class="summary-grid"
      aria-label="Ringkasan pengguna"
    >
      <article class="summary-card summary-card--primary">
        <div class="summary-card__top">
          <div>
            <span class="summary-card__eyebrow">
              TOTAL
            </span>

            <span class="summary-card__label">
              Semua pengguna
            </span>
          </div>

          <span class="summary-card__icon">
            <Users
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-total-count
        >
          {totalUsers}
        </strong>

        <span class="summary-card__meta">
          Akun dalam workspace
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <div>
            <span class="summary-card__eyebrow">
              ACTIVE
            </span>

            <span class="summary-card__label">
              Aktif
            </span>
          </div>

          <span class="summary-card__icon summary-card__icon--green">
            <CircleCheck
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-active-count
        >
          {activeUsers}
        </strong>

        <span class="summary-card__meta">
          Dapat mengakses workspace
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <div>
            <span class="summary-card__eyebrow">
              PENDING
            </span>

            <span class="summary-card__label">
              Menunggu
            </span>
          </div>

          <span class="summary-card__icon summary-card__icon--orange">
            <Clock3
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-pending-count
        >
          {pendingUsers}
        </strong>

        <span class="summary-card__meta">
          Membutuhkan pemeriksaan akses
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <div>
            <span class="summary-card__eyebrow">
              SUSPENDED
            </span>

            <span class="summary-card__label">
              Ditangguhkan
            </span>
          </div>

          <span class="summary-card__icon summary-card__icon--red">
            <Ban
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-suspended-count
        >
          {suspendedUsers}
        </strong>

        <span class="summary-card__meta">
          Akses sementara dinonaktifkan
        </span>
      </article>
    </section>

    <section class="security-strip">
      <div class="security-strip__mark">
        <ShieldCheck
          size={20}
          stroke-width={2.1}
          aria-hidden="true"
        />
      </div>

      <div class="security-strip__content">
        <span class="security-strip__eyebrow">
          ACCESS CONTROL
        </span>

        <strong>
          Terapkan akses berdasarkan kebutuhan
        </strong>

        <p>
          Berikan peran minimum yang diperlukan. Akses administrasi
          tidak perlu diberikan kepada seluruh pengguna.
        </p>
      </div>

      <span class="security-strip__status">
        <CircleCheck
          size={14}
          stroke-width={2}
          aria-hidden="true"
        />

        Policy active
      </span>
    </section>

    <section class="directory-card">
      <div class="directory-toolbar">
        <div class="search-box">
          <Search
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="user-search"
          >
            Cari pengguna
          </label>

          <input
            id="user-search"
            type="search"
            placeholder="Cari nama, email, organisasi, atau peran..."
            autocomplete="off"
            spellcheck="false"
            data-search
          />

          <button
            type="button"
            class="search-box__clear"
            aria-label="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar-filters">
          <label class="select-box">
            <span class="sr-only">
              Filter status
            </span>

            <select
              aria-label="Filter status pengguna"
              data-status-filter
            >
              <option value="all">
                Semua status
              </option>

              {
                Object.entries(statusLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="select-box">
            <span class="sr-only">
              Filter peran
            </span>

            <select
              aria-label="Filter peran pengguna"
              data-role-filter
            >
              <option value="all">
                Semua peran
              </option>

              {
                Object.entries(roleLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>
        </div>
      </div>

      <div class="directory-head">
        <div>
          <span class="directory-head__eyebrow">
            USER DIRECTORY / 01
          </span>

          <h2>
            Daftar pengguna
          </h2>
        </div>

        <span
          class="directory-count"
          data-result-count
        >
          {totalUsers} pengguna
        </span>
      </div>

      <div class="table-scroll">
        <table class="users-table">
          <caption class="sr-only">
            Daftar pengguna BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Pengguna
              </th>

              <th scope="col">
                Peran
              </th>

              <th scope="col">
                Organisasi
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Aktivitas terakhir
              </th>

              <th scope="col">
                Dibuat
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              users.map((user) => (
                <tr
                  data-user-row
                  data-id={user.id}
                  data-name={user.name.toLowerCase()}
                  data-email={user.email.toLowerCase()}
                  data-role={user.role}
                  data-role-label={user.roleLabel.toLowerCase()}
                  data-status={user.status}
                  data-organization={user.organization.toLowerCase()}
                >
                  <td>
                    <div class="user-cell">
                      <span class="user-avatar">
                        {user.name
                          .split(" ")
                          .map(
                            (part) =>
                              part[0] ?? "",
                          )
                          .join("")
                          .slice(0, 2)
                          .toUpperCase()}
                      </span>

                      <div class="user-cell__content">
                        <strong>
                          {user.name}
                        </strong>

                        <span>
                          {user.email}
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "role-badge",
                        `role-badge--${user.role}`,
                      ]}
                    >
                      {
                        user.role ===
                        "super-admin" ? (
                          <ShieldCheck
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : user.role === "admin" ? (
                          <KeyRound
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : user.role === "organization" ? (
                          <Users
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : (
                          <UserRound
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        )
                      }

                      <span>
                        {user.roleLabel}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span class="organization-label">
                      {user.organization}
                    </span>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "status-badge",
                        `status-badge--${user.status}`,
                      ]}
                      data-row-status
                    >
                      {
                        user.status === "active" ? (
                          <CircleCheck
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : user.status === "pending" ? (
                          <Clock3
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : (
                          <Ban
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        )
                      }

                      <span>
                        {user.statusLabel}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span class="activity-label">
                      {user.lastActive}
                    </span>
                  </td>

                  <td>
                    <span class="created-label">
                      {user.createdAt}
                    </span>
                  </td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Lihat ${user.name}`}
                        data-view
                        data-record={user.id}
                      >
                        <Eye
                          size={15}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </button>

                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Edit ${user.name}`}
                        data-edit
                        data-record={user.id}
                      >
                        <Pencil
                          size={15}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
        >
          <span class="empty-state__mark">
            <Search
              size={22}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span class="empty-state__eyebrow">
            NO MATCH
          </span>

          <h3>
            Pengguna tidak ditemukan
          </h3>

          <p>
            Tidak ada pengguna yang cocok dengan pencarian atau filter
            yang digunakan.
          </p>

          <button
            type="button"
            class="button button--dark"
            data-empty-reset
          >
            Reset filter
          </button>
        </div>
      </div>

      <footer class="directory-footer">
        <span>
          <strong data-footer-count>
            {totalUsers}
          </strong>
          pengguna ditampilkan
        </span>

        <span>
          BINSIGHT / USER DIRECTORY
        </span>
      </footer>
    </section>

    <section class="role-grid">
      <article class="role-card">
        <div class="role-card__top">
          <span class="role-card__index">
            A
          </span>

          <ShieldCheck
            size={19}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <span class="role-card__eyebrow">
          SUPER ADMIN
        </span>

        <h2>
          Akses tertinggi
        </h2>

        <p>
          Untuk pengelolaan sistem, pengguna, konfigurasi, dan
          kebijakan administrasi yang bersifat kritis.
        </p>
      </article>

      <article class="role-card">
        <div class="role-card__top">
          <span class="role-card__index">
            B
          </span>

          <KeyRound
            size={19}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <span class="role-card__eyebrow">
          ADMIN / EDITOR
        </span>

        <h2>
          Kelola data dan konten
        </h2>

        <p>
          Dipakai untuk pekerjaan operasional seperti verifikasi,
          pengelolaan data, dan pemeliharaan konten sesuai kewenangan.
        </p>
      </article>

      <article class="role-card">
        <div class="role-card__top">
          <span class="role-card__index">
            C
          </span>

          <Users
            size={19}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <span class="role-card__eyebrow">
          ORGANISASI / VIEWER
        </span>

        <h2>
          Akses terbatas
        </h2>

        <p>
          Akses diarahkan pada ruang kerja dan informasi yang memang
          relevan dengan peran pengguna.
        </p>
      </article>
    </section>

    <aside
      class="user-drawer"
      data-drawer
      aria-hidden="true"
      hidden
      aria-labelledby="drawer-title"
    >
      <div class="drawer-header">
        <div>
          <span class="drawer-header__eyebrow">
            USER DETAIL
          </span>

          <h2 id="drawer-title">
            Detail pengguna
          </h2>
        </div>

        <button
          type="button"
          class="drawer-close"
          aria-label="Tutup detail pengguna"
          data-drawer-close
        >
          <X
            size={18}
            stroke-width={2.2}
            aria-hidden="true"
          />
        </button>
      </div>

      <div class="drawer-body">
        <div class="drawer-identity">
          <span
            class="drawer-avatar"
            data-drawer-avatar
          >
            US
          </span>

          <div>
            <span class="drawer-identity__eyebrow">
              USER
            </span>

            <h3 data-drawer-name>
              -
            </h3>

            <span data-drawer-email>
              -
            </span>
          </div>
        </div>

        <div class="drawer-badges">
          <span
            class="role-badge"
            data-drawer-role
          >
            -
          </span>

          <span
            class="status-badge"
            data-drawer-status
          >
            -
          </span>
        </div>

        <section class="drawer-section">
          <span class="drawer-section__label">
            AKUN
          </span>

          <dl class="detail-list">
            <div>
              <dt>
                Organisasi
              </dt>

              <dd data-drawer-organization>
                -
              </dd>
            </div>

            <div>
              <dt>
                Dibuat
              </dt>

              <dd data-drawer-created>
                -
              </dd>
            </div>

            <div>
              <dt>
                Aktivitas
              </dt>

              <dd data-drawer-last-active>
                -
              </dd>
            </div>
          </dl>
        </section>

        <section class="drawer-section">
          <span class="drawer-section__label">
            ACCESS PROFILE
          </span>

          <div class="access-box">
            <div class="access-box__mark">
              <ShieldCheck
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div>
              <strong data-drawer-access-title>
                Akses pengguna
              </strong>

              <p data-drawer-access-copy>
                Hak akses mengikuti peran akun.
              </p>
            </div>
          </div>
        </section>

        <div
          class="drawer-protection"
          data-drawer-protection
          hidden
        >
          <ShieldCheck
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <p>
            Akun Super Admin dilindungi dari perubahan status melalui
            halaman ini.
          </p>
        </div>
      </div>

      <div class="drawer-footer">
        <button
          type="button"
          class="button button--light"
          data-drawer-edit
        >
          <Pencil
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Edit
          </span>
        </button>

        <button
          type="button"
          class="button button--danger"
          data-drawer-toggle-status
        >
          <Ban
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Tangguhkan
          </span>
        </button>
      </div>
    </aside>

    <div
      class="drawer-backdrop"
      data-drawer-backdrop
      hidden
    ></div>

    <div
      class="modal"
      data-create-modal
      hidden
      aria-hidden="true"
    >
      <div
        class="modal-backdrop"
        data-create-close
      ></div>

      <div
        class="modal-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="create-user-title"
      >
        <div class="modal-header">
          <div>
            <span class="modal-header__eyebrow">
              USER MANAGEMENT
            </span>

            <h2 id="create-user-title">
              Tambah pengguna
            </h2>

            <p>
              Siapkan data pengguna untuk workflow administrasi BINSIGHT.
            </p>
          </div>

          <button
            type="button"
            class="modal-close"
            aria-label="Tutup form"
            data-create-close
          >
            <X
              size={18}
              stroke-width={2.2}
              aria-hidden="true"
            />
          </button>
        </div>

        <form
          class="user-form"
          data-create-form
        >
          <div class="form-grid">
            <label class="form-field">
              <span>
                Nama
              </span>

              <input
                type="text"
                name="name"
                placeholder="Nama pengguna"
                autocomplete="name"
                required
              />
            </label>

            <label class="form-field">
              <span>
                Email
              </span>

              <input
                type="email"
                name="email"
                placeholder="nama@domain.id"
                autocomplete="email"
                required
              />
            </label>

