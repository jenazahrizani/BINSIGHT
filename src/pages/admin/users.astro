<script>
// @ts-nocheck

  const page =
    document.querySelector(
      "[data-users-page]",
    );

  if (!(page instanceof HTMLElement)) {
    throw new Error(
      "BINSIGHT users admin page root not found.",
    );
  }

  const dataNode =
    page.querySelector(
      "#admin-users-data",
    );

  let users = [];

  try {
    users = JSON.parse(
      dataNode?.textContent ?? "[]",
    );
  } catch (error) {
    console.error(
      "Failed to parse BINSIGHT users data.",
      error,
    );

    users = [];
  }

  const searchInput =
    page.querySelector(
      "[data-search]",
    );

  const clearSearch =
    page.querySelector(
      "[data-clear-search]",
    );

  const statusFilter =
    page.querySelector(
      "[data-status-filter]",
    );

  const roleFilter =
    page.querySelector(
      "[data-role-filter]",
    );

  const resultCount =
    page.querySelector(
      "[data-result-count]",
    );

  const footerCount =
    page.querySelector(
      "[data-footer-count]",
    );

  const totalCountNode =
    page.querySelector(
      "[data-total-count]",
    );

  const activeCountNode =
    page.querySelector(
      "[data-active-count]",
    );

  const pendingCountNode =
    page.querySelector(
      "[data-pending-count]",
    );

  const suspendedCountNode =
    page.querySelector(
      "[data-suspended-count]",
    );

  const emptyState =
    page.querySelector(
      "[data-empty-state]",
    );

  const emptyReset =
    page.querySelector(
      "[data-empty-reset]",
    );

  const rows =
    Array.from(
      page.querySelectorAll(
        "[data-user-row]",
      ),
    );

  const drawer =
    page.querySelector(
      "[data-drawer]",
    );

  const drawerBackdrop =
    page.querySelector(
      "[data-drawer-backdrop]",
    );

  const drawerClose =
    page.querySelector(
      "[data-drawer-close]",
    );

  const drawerAvatar =
    page.querySelector(
      "[data-drawer-avatar]",
    );

  const drawerName =
    page.querySelector(
      "[data-drawer-name]",
    );

  const drawerEmail =
    page.querySelector(
      "[data-drawer-email]",
    );

  const drawerRole =
    page.querySelector(
      "[data-drawer-role]",
    );

  const drawerStatus =
    page.querySelector(
      "[data-drawer-status]",
    );

  const drawerOrganization =
    page.querySelector(
      "[data-drawer-organization]",
    );

  const drawerCreated =
    page.querySelector(
      "[data-drawer-created]",
    );

  const drawerLastActive =
    page.querySelector(
      "[data-drawer-last-active]",
    );

  const drawerAccessTitle =
    page.querySelector(
      "[data-drawer-access-title]",
    );

  const drawerAccessCopy =
    page.querySelector(
      "[data-drawer-access-copy]",
    );

  const drawerProtection =
    page.querySelector(
      "[data-drawer-protection]",
    );

  const drawerEdit =
    page.querySelector(
      "[data-drawer-edit]",
    );

  const drawerToggleStatus =
    page.querySelector(
      "[data-drawer-toggle-status]",
    );

  const createModal =
    page.querySelector(
      "[data-create-modal]",
    );

  const createForm =
    page.querySelector(
      "[data-create-form]",
    );

  const createUserButton =
    page.querySelector(
      "[data-create-user]",
    );

  const createCloseButtons =
    Array.from(
      page.querySelectorAll(
        "[data-create-close]",
      ),
    );

  const toast =
    page.querySelector(
      "[data-toast]",
    );

  const toastMessage =
    page.querySelector(
      "[data-toast-message]",
    );

  let selectedUserId = null;
  let activeTrigger = null;
  let activeModalTrigger = null;
  let toastTimer = null;

  const roleLabels = {
    "super-admin": "Super Admin",
    admin: "Admin",
    editor: "Editor",
    viewer: "Viewer",
    organization: "Organisasi",
  };

  const statusLabels = {
    active: "Aktif",
    pending: "Menunggu",
    suspended: "Ditangguhkan",
  };

  function getUser(id) {
    return users.find(
      (user) =>
        user.id === id,
    );
  }

  function initials(name) {
    return name
      .split(" ")
      .map(
        (part) =>
          part[0] ?? "",
      )
      .join("")
      .slice(0, 2)
      .toUpperCase();
  }

  function setEmptyState(
    hasResults,
  ) {
    if (
      !(emptyState instanceof HTMLElement)
    ) {
      return;
    }

    const shouldShow =
      !hasResults;

    emptyState.hidden =
      !shouldShow;

    emptyState.setAttribute(
      "aria-hidden",
      shouldShow
        ? "false"
        : "true",
    );

    emptyState.style.display =
      shouldShow
        ? "flex"
        : "none";
  }

  function updateSummary() {
    const total =
      users.length;

    const active =
      users.filter(
        (user) =>
          user.status === "active",
      ).length;

    const pending =
      users.filter(
        (user) =>
          user.status === "pending",
      ).length;

    const suspended =
      users.filter(
        (user) =>
          user.status === "suspended",
      ).length;

    if (
      totalCountNode instanceof HTMLElement
    ) {
      totalCountNode.textContent =
        String(total);
    }

    if (
      activeCountNode instanceof HTMLElement
    ) {
      activeCountNode.textContent =
        String(active);
    }

    if (
      pendingCountNode instanceof HTMLElement
    ) {
      pendingCountNode.textContent =
        String(pending);
    }

    if (
      suspendedCountNode instanceof HTMLElement
    ) {
      suspendedCountNode.textContent =
        String(suspended);
    }
  }

  function updateFilters() {
    const query =
      searchInput instanceof HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const status =
      statusFilter instanceof HTMLSelectElement
        ? statusFilter.value
        : "all";

    const role =
      roleFilter instanceof HTMLSelectElement
        ? roleFilter.value
        : "all";

    const visibleRows =
      rows.filter(
        (row) => {
          const name =
            row.getAttribute(
              "data-name",
            ) ?? "";

          const email =
            row.getAttribute(
              "data-email",
            ) ?? "";

          const roleValue =
            row.getAttribute(
              "data-role",
            ) ?? "";

          const roleLabel =
            row.getAttribute(
              "data-role-label",
            ) ?? "";

          const organization =
            row.getAttribute(
              "data-organization",
            ) ?? "";

          const rowStatus =
            row.getAttribute(
              "data-status",
            ) ?? "";

          const matchesSearch =
            query === "" ||
            name.includes(query) ||
            email.includes(query) ||
            roleLabel.includes(query) ||
            organization.includes(query);

          const matchesStatus =
            status === "all" ||
            rowStatus === status;

          const matchesRole =
            role === "all" ||
            roleValue === role;

          return (
            matchesSearch &&
            matchesStatus &&
            matchesRole
          );
        },
      );

    rows.forEach(
      (row) => {
        const visible =
          visibleRows.includes(
            row,
          );

        row.setAttribute(
          "data-hidden",
          visible
            ? "false"
            : "true",
        );
      },
    );

    const count =
      visibleRows.length;

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${count} pengguna`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(count);
    }

    setEmptyState(
      count > 0,
    );

    if (
      clearSearch instanceof HTMLButtonElement &&
      searchInput instanceof HTMLInputElement
    ) {
      clearSearch.hidden =
        searchInput.value.trim() === "";
    }
  }

  function resetFilters() {
    if (
      searchInput instanceof HTMLInputElement
    ) {
      searchInput.value = "";
    }

    if (
      statusFilter instanceof HTMLSelectElement
    ) {
      statusFilter.value =
        "all";
    }

    if (
      roleFilter instanceof HTMLSelectElement
    ) {
      roleFilter.value =
        "all";
    }

    updateFilters();
  }

  function showToast(
    message,
  ) {
    if (
      !(toast instanceof HTMLElement) ||
      !(toastMessage instanceof HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden = false;

    if (
      toastTimer !== null
    ) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden =
            true;
          toastTimer =
            null;
        },
        2800,
      );
  }

  function setRoleBadge(
    element,
    user,
  ) {
    if (
      !(element instanceof HTMLElement)
    ) {
      return;
    }

    element.className =
      `role-badge role-badge--${user.role}`;

    element.textContent =
      user.roleLabel;
  }

  function setStatusBadge(
    element,
    user,
  ) {
    if (
      !(element instanceof HTMLElement)
    ) {
      return;
    }

    element.className =
      `status-badge status-badge--${user.status}`;

    element.textContent =
      user.statusLabel;
  }

  function updateDrawerAction(
    user,
  ) {
    if (
      !(drawerToggleStatus instanceof HTMLButtonElement)
    ) {
      return;
    }

    if (
      user.role === "super-admin"
    ) {
      drawerToggleStatus.className =
        "button button--secondary";

      drawerToggleStatus.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/>
          <path d="M12 8v4l3 2"/>
        </svg>
        <span>Dilindungi</span>
      `;

      drawerToggleStatus.disabled =
        true;

      return;
    }

    drawerToggleStatus.disabled =
      false;

    if (
      user.status === "suspended"
    ) {
      drawerToggleStatus.className =
        "button button--primary";

      drawerToggleStatus.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="m8 12 2.5 2.5L16 9"/>
        </svg>
        <span>Aktifkan</span>
      `;

      return;
    }

    drawerToggleStatus.className =
      "button button--danger";

    drawerToggleStatus.innerHTML = `
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="M8 12h8"/>
      </svg>
      <span>Tangguhkan</span>
    `;
  }

  function populateDrawer(
    user,
  ) {
    if (!user) {
      return;
    }

    if (
      drawerAvatar instanceof HTMLElement
    ) {
      drawerAvatar.textContent =
        initials(user.name);
    }

    if (
      drawerName instanceof HTMLElement
    ) {
      drawerName.textContent =
        user.name;
    }

    if (
      drawerEmail instanceof HTMLElement
    ) {
      drawerEmail.textContent =
        user.email;
    }

    setRoleBadge(
      drawerRole,
      user,
    );

    setStatusBadge(
      drawerStatus,
      user,
    );

    if (
      drawerOrganization instanceof HTMLElement
    ) {
      drawerOrganization.textContent =
        user.organization;
    }

    if (
      drawerCreated instanceof HTMLElement
    ) {
      drawerCreated.textContent =
        user.createdAt;
    }

    if (
      drawerLastActive instanceof HTMLElement
    ) {
      drawerLastActive.textContent =
        user.lastActive;
    }

    if (
      drawerAccessTitle instanceof HTMLElement
    ) {
      drawerAccessTitle.textContent =
        `${user.roleLabel} access`;
    }

    if (
      drawerAccessCopy instanceof HTMLElement
    ) {
      if (
        user.role ===
        "super-admin"
      ) {
        drawerAccessCopy.textContent =
          "Akses administratif tertinggi. Perubahan sensitif membutuhkan kehati-hatian.";
      } else if (
        user.role === "admin"
      ) {
        drawerAccessCopy.textContent =
          "Dapat menangani operasi admin sesuai kewenangan yang diberikan.";
      } else if (
        user.role === "editor"
      ) {
        drawerAccessCopy.textContent =
          "Fokus pada pemeliharaan dan pengelolaan konten.";
      } else if (
        user.role === "organization"
      ) {
        drawerAccessCopy.textContent =
          "Akses diarahkan pada ruang kerja dan data organisasi terkait.";
      } else {
        drawerAccessCopy.textContent =
          "Akses baca sesuai bagian yang diizinkan oleh peran.";
      }
    }

    if (
      drawerProtection instanceof HTMLElement
    ) {
      drawerProtection.hidden =
        user.role !==
        "super-admin";
    }

    updateDrawerAction(
      user,
    );
  }

  function openDrawer(
    id,
    trigger,
  ) {
    const user =
      getUser(id);

    if (
      !user ||
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    selectedUserId =
      id;

    activeTrigger =
      trigger instanceof HTMLElement
        ? trigger
        : null;

    populateDrawer(
      user,
    );

    drawer.hidden = false;
    drawerBackdrop.hidden =
      false;

    drawer.setAttribute(
      "data-open",
      "true",
    );

    drawer.setAttribute(
      "aria-hidden",
      "false",
    );

    document.documentElement.style.overflow =
      "hidden";

    if (
      drawerClose instanceof HTMLButtonElement
    ) {
      window.requestAnimationFrame(
        () => {
          drawerClose.focus();
        },
      );
    }
  }

  function closeDrawer(
    restoreFocus = true,
  ) {
    if (
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        if (
          drawer.getAttribute(
            "data-open",
          ) === "false"
        ) {
          drawer.hidden = true;
          drawerBackdrop.hidden =
            true;
        }
      },
      190,
    );

    document.documentElement.style.overflow =
      "";

    if (
      restoreFocus &&
      activeTrigger instanceof HTMLElement
    ) {
      activeTrigger.focus();
    }

    selectedUserId =
      null;

    activeTrigger =
      null;
  }

  function editUser(
    id,
  ) {
    const user =
      getUser(id);

    if (!user) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-user-edit",
        {
          detail: {
            ...user,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk "${user.name}" dipersiapkan.`,
    );
  }

  function toggleUserStatus() {
    if (!selectedUserId) {
      return;
    }

    const user =
      getUser(
        selectedUserId,
      );

    if (!user) {
      return;
    }

    if (
      user.role ===
      "super-admin"
    ) {
      showToast(
        "Akun Super Admin dilindungi dari perubahan status.",
      );
      return;
    }

    const previousStatus =
      user.status;

    if (
      user.status === "suspended"
    ) {
      user.status =
        "active";

      user.statusLabel =
        statusLabels.active;

      user.lastActive =
        "Aktif kembali";
    } else {
      user.status =
        "suspended";

      user.statusLabel =
        statusLabels.suspended;
    }

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) === user.id,
      );

    if (
      row instanceof HTMLElement
    ) {
      row.setAttribute(
        "data-status",
        user.status,
      );

      const statusBadge =
        row.querySelector(
          "[data-row-status]",
        );

      setStatusBadge(
        statusBadge,
        user,
      );

      const activityCell =
        row.querySelector(
          ".activity-label",
        );

      if (
        activityCell instanceof HTMLElement
      ) {
        activityCell.textContent =
          user.lastActive;
      }
    }

    populateDrawer(
      user,
    );

    updateSummary();
    updateFilters();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-user-status-change",
        {
          detail: {
            ...user,
            previousStatus,
          },
        },
      ),
    );

    showToast(
      user.status ===
        "active"
        ? `${user.name} diaktifkan kembali.`
        : `${user.name} ditangguhkan.`,
    );
  }

  function openCreateModal(
    trigger,
  ) {
    if (
      !(createModal instanceof HTMLElement)
    ) {
      return;
    }

    activeModalTrigger =
      trigger instanceof HTMLElement
        ? trigger
        : null;

    createModal.hidden =
      false;

    createModal.setAttribute(
      "aria-hidden",
      "false",
    );

    document.documentElement.style.overflow =
      "hidden";

    const firstInput =
      createModal.querySelector(
        'input[name="name"]',
      );

    if (
      firstInput instanceof HTMLInputElement
    ) {
      window.setTimeout(
        () => firstInput.focus(),
        0,
      );
    }
  }

  function closeCreateModal(
    restoreFocus = true,
  ) {
    if (
      !(createModal instanceof HTMLElement)
    ) {
      return;
    }

    createModal.hidden =
      true;

    createModal.setAttribute(
      "aria-hidden",
      "true",
    );

    document.documentElement.style.overflow =
      "";

    if (
      restoreFocus &&
      activeModalTrigger instanceof HTMLElement
    ) {
      activeModalTrigger.focus();
    }

    activeModalTrigger =
      null;
  }

  function closeAllOverlays() {
    if (
      drawer instanceof HTMLElement &&
      drawer.getAttribute(
        "data-open",
      ) === "true"
    ) {
      closeDrawer();
      return;
    }

    if (
      createModal instanceof HTMLElement &&
      !createModal.hidden
    ) {
      closeCreateModal();
    }
  }

  createUserButton?.addEventListener(
    "click",
    () =>
      openCreateModal(
        createUserButton,
      ),
  );

  createCloseButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        () => closeCreateModal(),
      );
    },
  );

  createForm?.addEventListener(
    "submit",
    (event) => {
      event.preventDefault();

      if (
        !(createForm instanceof HTMLFormElement)
      ) {
        return;
      }

      const formData =
        new FormData(
          createForm,
        );

      const name =
        String(
          formData.get("name") ?? "",
        ).trim();

      const email =
        String(
          formData.get("email") ?? "",
        ).trim();

      const role =
        String(
          formData.get(
            "role",
          ) ?? "viewer",
        );

      const organization =
        String(
          formData.get(
            "organization",
          ) ?? "—",
        ).trim() || "—";

      if (
        !name ||
        !email
      ) {
        showToast(
          "Nama dan email wajib diisi.",
        );
        return;
      }

      const roleLabel =
        roleLabels[
          role
        ] ?? "Viewer";

      window.dispatchEvent(
        new CustomEvent(
          "binsight:admin-user-create",
          {
            detail: {
              name,
              email,
              role,
              roleLabel,
              status: "pending",
              statusLabel:
                "Menunggu",
              organization,
            },
          },
        ),
      );

      createForm.reset();

      closeCreateModal();

      showToast(
        "Data pengguna disiapkan untuk proses pembuatan akun.",
      );
    },
  );

  searchInput?.addEventListener(
    "input",
    updateFilters,
  );

  statusFilter?.addEventListener(
    "change",
    updateFilters,
  );

  roleFilter?.addEventListener(
    "change",
    updateFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof HTMLInputElement
      ) {
        searchInput.value =
          "";

        searchInput.focus();
      }

      updateFilters();
    },
  );

  emptyReset?.addEventListener(
    "click",
    () => {
      resetFilters();

      if (
        searchInput instanceof HTMLInputElement
      ) {
        searchInput.focus();
      }
    },
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(
                id,
                button,
              );
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editUser(
                id,
              );
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    () => closeDrawer(),
  );

  drawerBackdrop?.addEventListener(
    "click",
    () => closeDrawer(),
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (selectedUserId) {
        editUser(
          selectedUserId,
        );
      }
    },
  );

  drawerToggleStatus?.addEventListener(
    "click",
    toggleUserStatus,
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      () => {
        updateSummary();
        updateFilters();

        showToast(
          "Data pengguna diperbarui.",
        );
      },
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key !== "Escape"
      ) {
        return;
      }

      closeAllOverlays();
    },
  );

  updateSummary();
  updateFilters();
</script>