  .toast {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: min(390px, calc(100vw - 30px));
    padding: 11px 14px;
    border: 1px solid var(--color-primary-soft);
    border-radius: 11px;
    background: var(--color-surface);
    color: var(--color-text-strong);
    box-shadow:
      0 15px 35px rgba(15, 23, 42, 0.14);
    font-size: 0.66rem;
    font-weight: 750;
  }

  .toast[hidden] {
    display: none;
  }

  .toast svg {
    color: var(--color-primary);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1200px) {
    .page-top {
      align-items: flex-start;
      flex-direction: column;
    }

    .page-top__actions {
      justify-content: flex-start;
    }

    .summary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .toolbar {
      align-items: stretch;
      flex-direction: column;
    }

    .toolbar__search {
      max-width: none;
    }

    .toolbar__filters {
      justify-content: flex-start;
    }

    .role-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .users-page {
      padding: 20px 16px 36px;
    }

    .security-strip {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .security-strip__status {
      margin-left: 56px;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .summary-grid {
      grid-template-columns: 1fr;
    }

    .page-top__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .page-top__actions .button {
      width: 100%;
    }

    .toolbar__filters {
      display: grid;
      grid-template-columns: 1fr;
    }

    .filter-control select {
      width: 100%;
      min-width: 0;
    }

    .table-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .drawer__footer {
      align-items: stretch;
    }

    .drawer__footer .button {
      flex: 1;
    }

    .modal {
      padding: 12px;
    }

    .modal__panel {
      max-height: calc(100dvh - 24px);
      overflow-y: auto;
    }

    .modal__footer {
      flex-direction: column-reverse;
    }

    .modal__footer .button {
      width: 100%;
    }

    .toast {
      right: 15px;
      bottom: 15px;
    }
  }
</style>

<script>
// @ts-nocheck

  const users = [
    {
      id: "user-demo-001",
      name: "Admin BINSIGHT",
      email: "admin@binsight.id",
      role: "super-admin",
      roleLabel: "Super Admin",
      status: "active",
      statusLabel: "Aktif",
      organization: "BINSIGHT",
      lastActive: "Hari ini, 10:42",
      createdAt: "1 Sep 2026",
    },
    {
      id: "user-demo-002",
      name: "Pengelola Data",
      email: "data@binsight.id",
      role: "admin",
      roleLabel: "Admin",
      status: "active",
      statusLabel: "Aktif",
      organization: "BINSIGHT",
      lastActive: "Hari ini, 09:51",
      createdAt: "2 Sep 2026",
    },
    {
      id: "user-demo-003",
      name: "Editor Konten",
      email: "editor@binsight.id",
      role: "editor",
      roleLabel: "Editor",
      status: "active",
      statusLabel: "Aktif",
      organization: "BINSIGHT",
      lastActive: "9 Sep 2026, 16:18",
      createdAt: "3 Sep 2026",
    },
    {
      id: "user-demo-004",
      name: "Operator Organisasi",
      email: "operator@contoh.id",
      role: "organization",
      roleLabel: "Organisasi",
      status: "pending",
      statusLabel: "Menunggu",
      organization: "Organisasi Pengelola Sampah",
      lastActive: "Belum aktif",
      createdAt: "9 Sep 2026",
    },
    {
      id: "user-demo-005",
      name: "Pengguna Publik",
      email: "viewer@contoh.id",
      role: "viewer",
      roleLabel: "Viewer",
      status: "suspended",
      statusLabel: "Ditangguhkan",
      organization: "—",
      lastActive: "6 Sep 2026, 11:24",
      createdAt: "4 Sep 2026",
    },
  ];

  const page =
    document.querySelector(
      "[data-users-page]",
    );

  if (!(page instanceof HTMLElement)) {
    throw new Error(
      "BINSIGHT users admin page root not found.",
    );
  }

  const searchInput =
    page.querySelector(
      "[data-search]",
    );

  const clearSearch =
    page.querySelector(
      "[data-clear-search]",
    );

  const statusFilter =
    page.querySelector(
      "[data-status-filter]",
    );

  const roleFilter =
    page.querySelector(
      "[data-role-filter]",
    );

  const resultCount =
    page.querySelector(
      "[data-result-count]",
    );

  const footerCount =
    page.querySelector(
      "[data-footer-count]",
    );

  const emptyState =
    page.querySelector(
      "[data-empty-state]",
    );

  const emptyReset =
    page.querySelector(
      "[data-empty-reset]",
    );

  const rows =
    Array.from(
      page.querySelectorAll(
        "[data-user-row]",
      ),
    );

  const drawer =
    page.querySelector(
      "[data-drawer]",
    );

  const drawerBackdrop =
    page.querySelector(
      "[data-drawer-backdrop]",
    );

  const drawerClose =
    page.querySelector(
      "[data-drawer-close]",
    );

  const drawerAvatar =
    page.querySelector(
      "[data-drawer-avatar]",
    );

  const drawerName =
    page.querySelector(
      "[data-drawer-name]",
    );

  const drawerEmail =
    page.querySelector(
      "[data-drawer-email]",
    );

  const drawerRole =
    page.querySelector(
      "[data-drawer-role]",
    );

  const drawerStatus =
    page.querySelector(
      "[data-drawer-status]",
    );

  const drawerOrganization =
    page.querySelector(
      "[data-drawer-organization]",
    );

  const drawerCreated =
    page.querySelector(
      "[data-drawer-created]",
    );

  const drawerLastActive =
    page.querySelector(
      "[data-drawer-last-active]",
    );

  const drawerAccessTitle =
    page.querySelector(
      "[data-drawer-access-title]",
    );

  const drawerAccessCopy =
    page.querySelector(
      "[data-drawer-access-copy]",
    );

  const drawerEdit =
    page.querySelector(
      "[data-drawer-edit]",
    );

  const drawerToggleStatus =
    page.querySelector(
      "[data-drawer-toggle-status]",
    );

  const createModal =
    page.querySelector(
      "[data-create-modal]",
    );

  const createForm =
    page.querySelector(
      "[data-create-form]",
    );

  const createUserButton =
    page.querySelector(
      "[data-create-user]",
    );

  const createCloseButtons =
    Array.from(
      page.querySelectorAll(
        "[data-create-close]",
      ),
    );

  const toast =
    page.querySelector(
      "[data-toast]",
    );

  const toastMessage =
    page.querySelector(
      "[data-toast-message]",
    );

  let selectedUserId = null;
  let toastTimer = null;

  function getUser(id) {
    return users.find(
      (user) =>
        user.id === id,
    );
  }

  function initials(name) {
    return name
      .split(" ")
      .map(
        (part) =>
          part[0] ?? "",
      )
      .join("")
      .slice(0, 2)
      .toUpperCase();
  }

  function updateFilters() {
    const query =
      searchInput instanceof
      HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const status =
      statusFilter instanceof
      HTMLSelectElement
        ? statusFilter.value
        : "all";

    const role =
      roleFilter instanceof
      HTMLSelectElement
        ? roleFilter.value
        : "all";

    const visibleRows =
      rows.filter(
        (row) => {
          const name =
            row.getAttribute(
              "data-name",
            ) ?? "";

          const email =
            row.getAttribute(
              "data-email",
            ) ?? "";

          const roleValue =
            row.getAttribute(
              "data-role",
            ) ?? "";

          const roleLabel =
            row.getAttribute(
              "data-role-label",
            ) ?? "";

          const organization =
            row.getAttribute(
              "data-organization",
            ) ?? "";

          const rowStatus =
            row.getAttribute(
              "data-status",
            ) ?? "";

          const matchesSearch =
            query === "" ||
            name.includes(query) ||
            email.includes(query) ||
            roleLabel.includes(query) ||
            organization.includes(query);

          const matchesStatus =
            status === "all" ||
            rowStatus === status;

          const matchesRole =
            role === "all" ||
            roleValue === role;

          return (
            matchesSearch &&
            matchesStatus &&
            matchesRole
          );
        },
      );

    rows.forEach(
      (row) => {
        row.setAttribute(
          "data-hidden",
          visibleRows.includes(
            row,
          )
            ? "false"
            : "true",
        );
      },
    );

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${visibleRows.length} pengguna`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(
          visibleRows.length,
        );
    }

    if (
      emptyState instanceof HTMLElement
    ) {
      emptyState.hidden =
        visibleRows.length !== 0;
    }

    if (
      clearSearch instanceof HTMLButtonElement
    ) {
      clearSearch.hidden =
        !(
          searchInput instanceof HTMLInputElement &&
          searchInput.value.length > 0
        );
    }
  }

  function resetFilters() {
    if (
      searchInput instanceof HTMLInputElement
    ) {
      searchInput.value = "";
    }

    if (
      statusFilter instanceof HTMLSelectElement
    ) {
      statusFilter.value = "all";
    }

    if (
      roleFilter instanceof HTMLSelectElement
    ) {
      roleFilter.value = "all";
    }

    updateFilters();
  }

  function showToast(message) {
    if (
      !(toast instanceof HTMLElement) ||
      !(toastMessage instanceof HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden = false;

    if (
      toastTimer !== null
    ) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden = true;
          toastTimer = null;
        },
        2800,
      );
  }

  function setRoleBadge(
    element,
    user,
  ) {
    if (
      !(element instanceof HTMLElement)
    ) {
      return;
    }

    element.className =
      `role-badge role-badge--${user.role}`;

    element.textContent =
      user.roleLabel;
  }

  function setStatusBadge(
    element,
    user,
  ) {
    if (
      !(element instanceof HTMLElement)
    ) {
      return;
    }

    element.className =
      `status-badge status-badge--${user.status}`;

    element.textContent =
      user.statusLabel;
  }

  function updateDrawerAction(
    user,
  ) {
    if (
      !(drawerToggleStatus instanceof HTMLButtonElement)
    ) {
      return;
    }

    if (
      user.status === "suspended"
    ) {
      drawerToggleStatus.className =
        "button button--secondary";

      drawerToggleStatus.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="m8 12 2.5 2.5L16 9"/>
        </svg>
        <span>Aktifkan</span>
      `;

      drawerToggleStatus.disabled =
        user.role === "super-admin";

      return;
    }

    if (
      user.role === "super-admin"
    ) {
      drawerToggleStatus.className =
        "button button--secondary";

      drawerToggleStatus.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/>
          <path d="M12 8v4l3 2"/>
        </svg>
        <span>Dilindungi</span>
      `;

      drawerToggleStatus.disabled =
        true;

      return;
    }

    drawerToggleStatus.disabled =
      false;

    drawerToggleStatus.className =
      "button button--danger";

    drawerToggleStatus.innerHTML = `
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="M8 12h8"/>
      </svg>
      <span>Tangguhkan</span>
    `;
  }

  function populateDrawer(
    user,
  ) {
    if (!user) {
      return;
    }

    if (
      drawerAvatar instanceof HTMLElement
    ) {
      drawerAvatar.textContent =
        initials(user.name);
    }

    if (
      drawerName instanceof HTMLElement
    ) {
      drawerName.textContent =
        user.name;
    }

    if (
      drawerEmail instanceof HTMLElement
    ) {
      drawerEmail.textContent =
        user.email;
    }

    setRoleBadge(
      drawerRole,
      user,
    );

    setStatusBadge(
      drawerStatus,
      user,
    );

    if (
      drawerOrganization instanceof HTMLElement
    ) {
      drawerOrganization.textContent =
        user.organization;
    }

    if (
      drawerCreated instanceof HTMLElement
    ) {
      drawerCreated.textContent =
        user.createdAt;
    }

    if (
      drawerLastActive instanceof HTMLElement
    ) {
      drawerLastActive.textContent =
        user.lastActive;
    }

    if (
      drawerAccessTitle instanceof HTMLElement
    ) {
      drawerAccessTitle.textContent =
        `${user.roleLabel} access`;
    }

    if (
      drawerAccessCopy instanceof HTMLElement
    ) {
      if (
        user.role ===
        "super-admin"
      ) {
        drawerAccessCopy.textContent =
          "Akses administratif tertinggi. Perubahan sensitif membutuhkan kehati-hatian.";
      } else if (
        user.role === "admin"
      ) {
        drawerAccessCopy.textContent =
          "Dapat menangani operasi admin sesuai kewenangan yang diberikan.";
      } else if (
        user.role === "editor"
      ) {
        drawerAccessCopy.textContent =
          "Fokus pada pemeliharaan dan pengelolaan konten.";
      } else if (
        user.role === "organization"
      ) {
        drawerAccessCopy.textContent =
          "Akses diarahkan pada ruang kerja dan data organisasi terkait.";
      } else {
        drawerAccessCopy.textContent =
          "Akses baca sesuai bagian publik atau data yang diizinkan.";
      }
    }

    updateDrawerAction(
      user,
    );
  }

  function openDrawer(id) {
    const user =
      getUser(id);

    if (
      !user ||
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    selectedUserId =
      id;

    populateDrawer(
      user,
    );

    drawer.hidden = false;
    drawerBackdrop.hidden =
      false;

    window.requestAnimationFrame(
      () => {
        drawer.setAttribute(
          "data-open",
          "true",
        );

        drawer.setAttribute(
          "aria-hidden",
          "false",
        );
      },
    );

    document.documentElement.style.overflow =
      "hidden";
  }

  function closeDrawer() {
    if (
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        drawer.hidden = true;
        drawerBackdrop.hidden =
          true;
      },
      190,
    );

    document.documentElement.style.overflow =
      "";

    selectedUserId =
      null;
  }

  function editUser(id) {
    const user =
      getUser(id);

    if (!user) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-user-edit",
        {
          detail: {
            ...user,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk "${user.name}" dipersiapkan.`,
    );
  }

  function toggleUserStatus() {
    if (!selectedUserId) {
      return;
    }

    const user =
      getUser(
        selectedUserId,
      );

    if (!user) {
      return;
    }

    if (
      user.role ===
      "super-admin"
    ) {
      showToast(
        "Akun Super Admin dilindungi dari perubahan status.",
      );
      return;
    }

    if (
      user.status ===
      "suspended"
    ) {
      user.status =
        "active";

      user.statusLabel =
        "Aktif";

      user.lastActive =
        "Aktif kembali sekarang";

      showToast(
        `Akun ${user.name} diaktifkan kembali.`,
      );
    } else {
      user.status =
        "suspended";

      user.statusLabel =
        "Ditangguhkan";

      showToast(
        `Akun ${user.name} ditangguhkan.`,
      );
    }

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) === user.id,
      );

    if (
      row instanceof HTMLElement
    ) {
      row.setAttribute(
        "data-status",
        user.status,
      );

      const statusBadge =
        row.querySelector(
          ".status-badge",
        );

      setStatusBadge(
        statusBadge,
        user,
      );
    }

    populateDrawer(
      user,
    );

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-user-status-change",
        {
          detail: {
            ...user,
          },
        },
      ),
    );

    updateFilters();
  }

  function openCreateModal() {
    if (
      !(createModal instanceof HTMLElement)
    ) {
      return;
    }

    createModal.hidden =
      false;

    createModal.setAttribute(
      "aria-hidden",
      "false",
    );

    document.documentElement.style.overflow =
      "hidden";

    const firstInput =
      createModal.querySelector(
        'input[name="name"]',
      );

    if (
      firstInput instanceof HTMLInputElement
    ) {
      window.setTimeout(
        () => firstInput.focus(),
        0,
      );
    }
  }

  function closeCreateModal() {
    if (
      !(createModal instanceof HTMLElement)
    ) {
      return;
    }

    createModal.hidden =
      true;

    createModal.setAttribute(
      "aria-hidden",
      "true",
    );

    document.documentElement.style.overflow =
      "";
  }

  createUserButton?.addEventListener(
    "click",
    openCreateModal,
  );

  createCloseButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        closeCreateModal,
      );
    },
  );

  createForm?.addEventListener(
    "submit",
    (event) => {
      event.preventDefault();

      if (
        !(createForm instanceof HTMLFormElement)
      ) {
        return;
      }

      const formData =
        new FormData(
          createForm,
        );

      const name =
        String(
          formData.get("name") ?? "",
        ).trim();

      const email =
        String(
          formData.get("email") ?? "",
        ).trim();

      const role =
        String(
          formData.get("role") ??
            "viewer",
        );

      const organization =
        String(
          formData.get(
            "organization",
          ) ?? "—",
        ).trim() || "—";

      if (
        !name ||
        !email
      ) {
        showToast(
          "Nama dan email wajib diisi.",
        );
        return;
      }

      const roleLabelMap = {
        "super-admin": "Super Admin",
        admin: "Admin",
        editor: "Editor",
        viewer: "Viewer",
        organization: "Organisasi",
      };

      window.dispatchEvent(
        new CustomEvent(
          "binsight:admin-user-create",
          {
            detail: {
              name,
              email,
              role,
              roleLabel:
                roleLabelMap[
                  role
                ] ?? "Viewer",
              status: "pending",
              statusLabel:
                "Menunggu",
              organization,
            },
          },
        ),
      );

      closeCreateModal();

      createForm.reset();

      showToast(
        "Data pengguna disiapkan untuk proses pembuatan akun.",
      );
    },
  );

  searchInput?.addEventListener(
    "input",
    updateFilters,
  );

  statusFilter?.addEventListener(
    "change",
    updateFilters,
  );

  roleFilter?.addEventListener(
    "change",
    updateFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof HTMLInputElement
      ) {
        searchInput.value = "";
        searchInput.focus();
      }

      updateFilters();
    },
  );

  emptyReset?.addEventListener(
    "click",
    resetFilters,
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editUser(id);
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerBackdrop?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (selectedUserId) {
        editUser(
          selectedUserId,
        );
      }
    },
  );

  drawerToggleStatus?.addEventListener(
    "click",
    toggleUserStatus,
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      () => {
        updateFilters();

        showToast(
          "Data pengguna diperbarui.",
        );
      },
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key !== "Escape"
      ) {
        return;
      }

      if (
        drawer instanceof HTMLElement &&
        drawer.getAttribute(
          "data-open",
        ) === "true"
      ) {
        closeDrawer();
        return;
      }

      if (
        createModal instanceof HTMLElement &&
        !createModal.hidden
      ) {
        closeCreateModal();
      }
    },
  );

  updateFilters();
</script>