---
import {
  Activity,
  ArrowRight,
  Building2,
  ChartColumn,
  CircleCheck,
  Clock3,
  FileText,
  FolderKanban,
  LayoutDashboard,
  MapPinned,
  Recycle,
  ShieldCheck,
  TriangleAlert,
  Users,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

const managementSections = [
  {
    title: "Organisasi",
    description:
      "Verifikasi organisasi, periksa profil, dan kelola visibilitas organisasi publik.",
    href: "/admin/organizations",
    icon: Building2,
    accent: "green",
  },
  {
    title: "Lokasi",
    description:
      "Kelola titik pengelolaan, lokasi fasilitas, dan informasi wilayah BINSIGHT.",
    href: "/admin/locations",
    icon: MapPinned,
    accent: "blue",
  },
  {
    title: "Jenis sampah",
    description:
      "Kelola referensi kategori, material, karakteristik, dan metode pengelolaan.",
    href: "/admin/waste",
    icon: Recycle,
    accent: "lime",
  },
  {
    title: "Laporan",
    description:
      "Tinjau laporan masyarakat, verifikasi informasi, dan pantau status penyelesaian.",
    href: "/admin/reports",
    icon: FileText,
    accent: "orange",
  },
  {
    title: "Pengguna",
    description:
      "Kelola pengguna platform dan akses berbasis peran.",
    href: "/admin/users",
    icon: Users,
    accent: "purple",
  },
  {
    title: "Konten",
    description:
      "Kelola materi informasi dan konten publik yang ditampilkan di BINSIGHT.",
    href: "/admin/content",
    icon: FolderKanban,
    accent: "slate",
  },
];

const workflowSteps = [
  {
    number: "01",
    label: "Verify",
    description:
      "Pastikan organisasi, lokasi, dan informasi publik telah diperiksa sebelum ditampilkan.",
    icon: ShieldCheck,
  },
  {
    number: "02",
    label: "Manage",
    description:
      "Kelola data ekosistem BINSIGHT melalui modul organisasi, lokasi, sampah, dan laporan.",
    icon: FolderKanban,
  },
  {
    number: "03",
    label: "Monitor",
    description:
      "Pantau kualitas data, laporan masyarakat, dan konsistensi informasi platform.",
    icon: Activity,
  },
];

const quickLinks = [
  {
    label: "Kelola organisasi",
    href: "/admin/organizations",
    icon: Building2,
  },
  {
    label: "Tinjau laporan",
    href: "/admin/reports",
    icon: FileText,
  },
  {
    label: "Kelola lokasi",
    href: "/admin/locations",
    icon: MapPinned,
  },
  {
    label: "Kelola pengguna",
    href: "/admin/users",
    icon: Users,
  },
];

const systemChecks = [
  {
    label: "Platform",
    value: "Aktif",
    status: "positive",
    icon: LayoutDashboard,
  },
  {
    label: "Data",
    value: "Siap dikelola",
    status: "positive",
    icon: ChartColumn,
  },
  {
    label: "Verifikasi",
    value: "Manual",
    status: "neutral",
    icon: ShieldCheck,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Admin — BINSIGHT",
  description:
    "Dashboard administrasi BINSIGHT untuk verifikasi, pengelolaan, dan monitoring ekosistem data persampahan Kabupaten Badung.",
  url: "https://binsight.id/admin",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Overview"
  description="Verifikasi, kelola, dan monitor data ekosistem BINSIGHT."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="admin-overview">
    <!-- ================================================================
         CONTROL HERO
    ================================================================= -->
    <section class="overview-hero">
      <div class="overview-hero__main">
        <div class="overview-hero__eyebrow">
          <span class="overview-hero__eyebrow-rule"></span>

          <span>
            ADMIN WORKSPACE
          </span>
        </div>

        <div class="overview-hero__headline">
          <span class="overview-hero__index">
            01
          </span>

          <div>
            <h1>
              Overview
              <span>BINSIGHT</span>
            </h1>

            <p>
              Pusat kendali untuk memastikan data, organisasi, lokasi,
              laporan, dan konten BINSIGHT tetap terpercaya, terstruktur,
              dan siap digunakan publik.
            </p>
          </div>
        </div>

        <div class="overview-hero__actions">
          <a
            class="button button--primary"
            href="/admin/organizations"
          >
            <Building2
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Kelola organisasi
            </span>

            <ArrowRight
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>

          <a
            class="button button--secondary"
            href="/admin/reports"
          >
            <FileText
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Tinjau laporan
            </span>
          </a>
        </div>
      </div>

      <div
        class="overview-hero__status"
        aria-label="Status sistem"
      >
        <div class="overview-hero__status-top">
          <span class="overview-hero__status-label">
            WORKSPACE STATUS
          </span>

          <span class="status-mark status-mark--active"></span>
        </div>

        <strong>
          Operational
        </strong>

        <span class="overview-hero__status-subtitle">
          BINSIGHT administration
        </span>

        <div class="overview-hero__status-divider"></div>

        <div class="overview-hero__status-row">
          <span>
            MODE
          </span>

          <strong>
            CONTROLLED
          </strong>
        </div>

        <div class="overview-hero__status-row">
          <span>
            VISIBILITY
          </span>

          <strong>
            ADMIN
          </strong>
        </div>

        <div class="overview-hero__status-foot">
          <ShieldCheck
            size={15}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Internal workspace
          </span>
        </div>
      </div>
    </section>

    <!-- ================================================================
         SYSTEM CONTROL
    ================================================================= -->
    <section
      class="system-summary"
      aria-labelledby="system-summary-title"
    >
      <div class="section-heading">
        <div>
          <span class="section-heading__eyebrow">
            SYSTEM CONTROL
          </span>

          <h2 id="system-summary-title">
            Kondisi workspace
          </h2>
        </div>

        <span class="section-heading__meta">
          ADMINISTRATOR ONLY
        </span>
      </div>

      <div class="system-summary__grid">
        {
          systemChecks.map((item, index) => (
            <article
              class:list={[
                "system-card",
                {
                  "system-card--featured": index === 0,
                },
              ]}
            >
              <div class="system-card__top">
                <div
                  class:list={[
                    "system-card__icon",
                    `system-card__icon--${item.status}`,
                  ]}
                >
                  <item.icon
                    size={19}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>

                <span
                  class:list={[
                    "system-card__indicator",
                    `system-card__indicator--${item.status}`,
                  ]}
                  aria-hidden="true"
                ></span>
              </div>

              <span class="system-card__label">
                {item.label}
              </span>

              <strong class="system-card__value">
                {item.value}
              </strong>

              <span class="system-card__code">
                BIN / 0{index + 1}
              </span>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ================================================================
         MANAGEMENT
    ================================================================= -->
    <section
      class="management-section"
      aria-labelledby="management-title"
    >
      <div class="section-heading">
        <div>
          <span class="section-heading__eyebrow">
            MANAGEMENT
          </span>

          <h2 id="management-title">
            Area pengelolaan
          </h2>

          <p>
            Akses modul administrasi utama dari satu workspace.
          </p>
        </div>

        <span class="section-heading__meta">
          06 MODULES
        </span>
      </div>

      <div class="management-grid">
        {
          managementSections.map((section, index) => (
            <a
              class="management-card"
              href={section.href}
            >
              <div class="management-card__header">
                <span class="management-card__index">
                  0{index + 1}
                </span>

                <div
                  class:list={[
                    "management-card__icon",
                    `management-card__icon--${section.accent}`,
                  ]}
                >
                  <section.icon
                    size={20}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>

                <ArrowRight
                  class="management-card__arrow"
                  size={18}
                  stroke-width={1.9}
                  aria-hidden="true"
                />
              </div>

              <div class="management-card__body">
                <h3>
                  {section.title}
                </h3>

                <p>
                  {section.description}
                </p>
              </div>

              <span class="management-card__route">
                OPEN MODULE
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ================================================================
         WORKFLOW
    ================================================================= -->
    <section
      class="workflow-section"
      aria-labelledby="workflow-title"
    >
      <div class="workflow-section__header">
        <div class="section-heading">
          <div>
            <span class="section-heading__eyebrow">
              GOVERNANCE
            </span>

            <h2 id="workflow-title">
              Alur kerja admin
            </h2>

            <p>
              Prinsip dasar pengelolaan data BINSIGHT.
            </p>
          </div>
        </div>

        <div class="workflow-section__note">
          <TriangleAlert
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <span>
            Data publik harus melalui pemeriksaan yang sesuai.
          </span>
        </div>
      </div>

      <div class="workflow-grid">
        {
          workflowSteps.map((step, index) => (
            <article class="workflow-card">
              <div class="workflow-card__top">
                <span class="workflow-card__number">
                  {step.number}
                </span>

                <div class="workflow-card__icon">
                  <step.icon
                    size={19}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <span class="workflow-card__label">
                {step.label}
              </span>

              <p>
                {step.description}
              </p>

              {index < workflowSteps.length - 1 && (
                <div
                  class="workflow-card__connector"
                  aria-hidden="true"
                >
                  <ArrowRight
                    size={16}
                    stroke-width={1.8}
                  />
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <!-- ================================================================
         QUICK ACCESS
    ================================================================= -->
    <section
      class="quick-section"
      aria-labelledby="quick-title"
    >
      <div class="section-heading">
        <div>
          <span class="section-heading__eyebrow">
            QUICK ACCESS
          </span>

          <h2 id="quick-title">
            Aksi cepat
          </h2>
        </div>
      </div>

      <div class="quick-grid">
        {
          quickLinks.map((item, index) => (
            <a
              class="quick-link"
              href={item.href}
            >
              <span class="quick-link__index">
                0{index + 1}
              </span>

              <span class="quick-link__icon">
                <item.icon
                  size={17}
                  stroke-width={1.9}
                  aria-hidden="true"
                />
              </span>

              <span class="quick-link__label">
                {item.label}
              </span>

              <ArrowRight
                class="quick-link__arrow"
                size={15}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </a>
          ))
        }
      </div>
    </section>

    <!-- ================================================================
         PRINCIPLES
    ================================================================= -->
    <section
      class="principles-section"
      aria-labelledby="principles-title"
    >
      <div class="principles-section__main">
        <div class="principles-section__eyebrow-row">
          <span class="section-heading__eyebrow">
            DATA PRINCIPLES
          </span>

          <span class="principles-section__stamp">
            BINSIGHT / CORE
          </span>
        </div>

        <h2 id="principles-title">
          BINSIGHT memprioritaskan
          <span>
            kualitas data.
          </span>
        </h2>

        <p>
          Dashboard admin bukan tempat untuk mengarang metrik. Gunakan data
          yang telah tersedia, terverifikasi, dan memiliki konteks yang jelas
          sebelum dipublikasikan sebagai informasi ekosistem persampahan.
        </p>
      </div>

      <div class="principles-list">
        <div class="principle-row">
          <div class="principle-row__number">
            01
          </div>

          <div class="principle-row__icon">
            <CircleCheck
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </div>

          <div class="principle-row__content">
            <strong>
              Verified before public
            </strong>

            <span>
              Informasi penting diperiksa sebelum masuk ke area publik.
            </span>
          </div>
        </div>

        <div class="principle-row">
          <div class="principle-row__number">
            02
          </div>

          <div class="principle-row__icon">
            <CircleCheck
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </div>

          <div class="principle-row__content">
            <strong>
              Context over volume
            </strong>

            <span>
              Gunakan konteks dan kualitas informasi, bukan angka yang tidak
              memiliki sumber.
            </span>
          </div>
        </div>

        <div class="principle-row">
          <div class="principle-row__number">
            03
          </div>

          <div class="principle-row__icon">
            <Clock3
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </div>

          <div class="principle-row__content">
            <strong>
              Keep information current
            </strong>

            <span>
              Data yang berubah perlu diperiksa dan diperbarui secara berkala.
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
</AdminLayout>

<style>
  /* ================================================================
     BINSIGHT ADMIN OVERVIEW
  ================================================================= */

  .admin-overview {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --orange: #ff6a00;
    --green: #87b800;

    width: 100%;
    min-height: 100%;
    padding: 30px 30px 58px;

    background:
      radial-gradient(
        circle at 92% 0%,
        rgb(223 255 0 / 9%),
        transparent 27rem
      ),
      var(--paper);

    color: var(--ink);
  }

  .admin-overview * {
    box-sizing: border-box;
  }

  .admin-overview a {
    -webkit-tap-highlight-color: transparent;
  }

  /* ================================================================
     HERO
  ================================================================= */

  .overview-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 0;

    border: 2px solid var(--ink);

    background: var(--ink);

    box-shadow: 8px 8px 0 var(--acid);

    overflow: hidden;
  }

  .overview-hero__main {
    min-width: 0;
    padding: 32px 34px 34px;

    background:
      linear-gradient(
        145deg,
        #11130f 0%,
        #090a08 70%
      );

    color: var(--white);
  }

  .overview-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;

    color: #aeb2a6;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.53rem;
    font-weight: 700;

    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .overview-hero__eyebrow-rule {
    width: 34px;
    height: 2px;

    flex: 0 0 auto;

    background: var(--orange);
  }

  .overview-hero__headline {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 18px;

    margin-top: 26px;
  }

  .overview-hero__index {
    align-self: start;

    padding-top: 8px;

    color: var(--acid);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.58rem;
    font-weight: 700;

    letter-spacing: 0.08em;
  }

  .overview-hero h1 {
    max-width: 820px;

    margin: 0;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: clamp(
      2.4rem,
      5vw,
      4.75rem
    );

    font-weight: 800;

    letter-spacing: -0.07em;
    line-height: 0.91;

    text-transform: uppercase;
  }

  .overview-hero h1 span {
    display: block;

    color: var(--acid);
  }

  .overview-hero__main > .overview-hero__headline p {
    max-width: 690px;

    margin: 18px 0 0;

    color: #aeb2a6;

    font-size: 0.82rem;
    line-height: 1.75;
  }

  .overview-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    min-height: 44px;

    padding: 0 15px;

    border: 2px solid var(--acid);
    border-radius: 0;

    font-size: 0.62rem;
    font-weight: 800;

    text-decoration: none;
    text-transform: uppercase;

    transition:
      transform 150ms ease,
      box-shadow 150ms ease,
      background 150ms ease;
  }

  .button:hover {
    transform: translate(-2px, -2px);
  }

  .button--primary {
    background: var(--acid);
    color: var(--ink);

    box-shadow: 5px 5px 0 var(--orange);
  }

  .button--primary:hover {
    box-shadow: 7px 7px 0 var(--orange);
  }

  .button--secondary {
    border-color: #50554c;

    background: transparent;
    color: var(--white);

    box-shadow: 4px 4px 0 #2b3027;
  }

  .button--secondary:hover {
    border-color: var(--white);

    background: #1b1f18;

    box-shadow: 6px 6px 0 #2b3027;
  }

  /* ----------------------------------------------------------------
     HERO STATUS
  ---------------------------------------------------------------- */

  .overview-hero__status {
    align-self: stretch;

    display: flex;
    flex-direction: column;

    min-height: 100%;

    padding: 24px 22px;

    border-left: 2px solid var(--acid);

    background:
      linear-gradient(
        180deg,
        #171b14 0%,
        #0d100c 100%
      );

    color: var(--white);
  }

  .overview-hero__status-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;
  }

  .overview-hero__status-label {
    color: #7f8579;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.49rem;
    font-weight: 700;

    letter-spacing: 0.1em;
  }

  .status-mark {
    width: 8px;
    height: 8px;

    flex: 0 0 auto;

    background: var(--green);

    box-shadow:
      0 0 0 4px rgb(135 184 0 / 12%);
  }

  .overview-hero__status > strong {
    display: block;

    margin-top: 17px;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: 1.45rem;
    font-weight: 800;

    letter-spacing: -0.04em;

    text-transform: uppercase;
  }

  .overview-hero__status-subtitle {
    display: block;

    margin-top: 4px;

    color: #797f74;

    font-size: 0.63rem;
  }

  .overview-hero__status-divider {
    height: 2px;

    margin: 22px 0;

    background: #2b3027;
  }

  .overview-hero__status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    padding: 8px 0;

    border-bottom: 1px solid #242921;
  }

  .overview-hero__status-row span {
    color: #696f64;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.48rem;
    font-weight: 700;

    letter-spacing: 0.09em;
  }

  .overview-hero__status-row strong {
    color: var(--acid);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.5rem;
    font-weight: 700;

    letter-spacing: 0.06em;
  }

  .overview-hero__status-foot {
    display: flex;
    align-items: center;
    gap: 7px;

    margin-top: auto;
    padding-top: 18px;

    color: #73796e;

    font-size: 0.57rem;
  }

  .overview-hero__status-foot svg {
    color: var(--orange);
  }

  /* ================================================================
     SECTION HEAD
  ================================================================= */

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 20px;
  }

  .section-heading__eyebrow {
    display: block;

    color: var(--orange);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.52rem;
    font-weight: 700;

    letter-spacing: 0.1em;
    line-height: 1.2;

    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 6px 0 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: 1.18rem;
    font-weight: 800;

    letter-spacing: -0.04em;
    line-height: 1.15;

    text-transform: uppercase;
  }

  .section-heading p {
    margin: 6px 0 0;

    color: var(--muted);

    font-size: 0.68rem;
    line-height: 1.6;
  }

  .section-heading__meta {
    color: #898d83;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.48rem;
    font-weight: 700;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ================================================================
     SYSTEM SUMMARY
  ================================================================= */

  .system-summary {
    margin-top: 38px;
  }

  .system-summary__grid {
