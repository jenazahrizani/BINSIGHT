---
/**
 * BINSIGHT — ADMIN ORGANIZATIONS
 * --------------------------------------------------------------------------
 * Organization management workspace for BINSIGHT.
 *
 * Design baseline:
 * - BINSIGHT editorial / brutalist visual language
 * - Page-owned hierarchy
 * - No duplicate admin header
 * - No page-level vertical scroll container
 * - Main page uses AdminLayout document scroll
 * - Sidebar behavior belongs exclusively to AdminLayout
 * - Square edges, hard borders, offset shadows
 * - Lime / ink / orange accent system
 * - Responsive without horizontal overflow
 *
 * Data note:
 * - This page currently uses local demo records.
 * - No backend write operation is invented here.
 * - Client actions emit BINSIGHT custom events and update local UI state.
 * --------------------------------------------------------------------------
 */

import {
  ArrowRight,
  Building2,
  CircleCheck,
  Eye,
  FileText,
  Filter,
  MapPin,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  Trash2,
  TriangleAlert,
  UserRound,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

type OrganizationStatus =
  | "verified"
  | "pending"
  | "unverified";

type OrganizationType =
  | "government"
  | "community"
  | "private"
  | "social-enterprise"
  | "cooperative"
  | "educational"
  | "nonprofit"
  | "other";

interface OrganizationRecord {
  id: string;
  name: string;
  slug: string;
  type: OrganizationType;
  status: OrganizationStatus;
  area: string;
  address: string;
  description: string;
  manager: string;
  isPublic: boolean;
  updatedAt: string;
  locationCount: number;
}

const organizations: OrganizationRecord[] = [
  {
    id: "org-demo-001",
    name: "Dinas Lingkungan Hidup dan Kebersihan Kabupaten Badung",
    slug: "dlhk-badung",
    type: "government",
    status: "verified",
    area: "Mengwi",
    address: "Kabupaten Badung, Bali",
    description:
      "Instansi pemerintah daerah yang berkaitan dengan pengelolaan lingkungan dan persampahan Kabupaten Badung.",
    manager: "Administrator Instansi",
    isPublic: true,
    updatedAt: "10 Sep 2026",
    locationCount: 3,
  },
  {
    id: "org-demo-002",
    name: "Bank Sampah Unit Badung",
    slug: "bank-sampah-unit-badung",
    type: "community",
    status: "pending",
    area: "Kuta Utara",
    address: "Badung, Bali",
    description:
      "Organisasi masyarakat yang mengelola pemilahan dan pengumpulan material yang masih memiliki nilai guna.",
    manager: "Pengelola Organisasi",
    isPublic: false,
    updatedAt: "9 Sep 2026",
    locationCount: 1,
  },
  {
    id: "org-demo-003",
    name: "Bali Recycle Hub",
    slug: "bali-recycle-hub",
    type: "private",
    status: "verified",
    area: "Kuta",
    address: "Kuta, Badung, Bali",
    description:
      "Organisasi yang berfokus pada pengelolaan material yang dapat dipulihkan dan diproses kembali.",
    manager: "Manager Operasional",
    isPublic: true,
    updatedAt: "8 Sep 2026",
    locationCount: 2,
  },
  {
    id: "org-demo-004",
    name: "Komunitas Hijau Badung",
    slug: "komunitas-hijau-badung",
    type: "nonprofit",
    status: "pending",
    area: "Abiansemal",
    address: "Abiansemal, Badung, Bali",
    description:
      "Komunitas lingkungan yang menjalankan kegiatan edukasi dan pengelolaan material berbasis masyarakat.",
    manager: "Koordinator Komunitas",
    isPublic: false,
    updatedAt: "7 Sep 2026",
    locationCount: 1,
  },
  {
    id: "org-demo-005",
    name: "Koperasi Daur Ulang Badung",
    slug: "koperasi-daur-ulang-badung",
    type: "cooperative",
    status: "unverified",
    area: "Mengwi",
    address: "Mengwi, Badung, Bali",
    description:
      "Koperasi yang mengembangkan kegiatan pemilahan dan pemanfaatan material yang dapat diproses kembali.",
    manager: "Pengurus Koperasi",
    isPublic: false,
    updatedAt: "6 Sep 2026",
    locationCount: 0,
  },
];

const statusLabels: Record<
  OrganizationStatus,
  string
> = {
  verified: "Terverifikasi",
  pending: "Menunggu",
  unverified: "Belum diverifikasi",
};

const typeLabels: Record<
  OrganizationType,
  string
> = {
  government: "Pemerintah",
  community: "Komunitas",
  private: "Swasta",
  "social-enterprise": "Social enterprise",
  cooperative: "Koperasi",
  educational: "Pendidikan",
  nonprofit: "Nirlaba",
  other: "Lainnya",
};

const totalOrganizations =
  organizations.length;

const verifiedCount =
  organizations.filter(
    (organization) =>
      organization.status === "verified",
  ).length;

const pendingCount =
  organizations.filter(
    (organization) =>
      organization.status === "pending",
  ).length;

const publicCount =
  organizations.filter(
    (organization) =>
      organization.isPublic,
  ).length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Organisasi — Admin BINSIGHT",
  description:
    "Administrasi organisasi BINSIGHT untuk verifikasi, pengelolaan data, dan visibilitas publik.",
  url: "https://binsight.id/admin/organizations",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Organisasi"
  description="Verifikasi dan kelola organisasi yang menjadi bagian dari ekosistem BINSIGHT."
  activeSection="organizations"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <script
    id="admin-organizations-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify(organizations)}
  />

  <div
    class="organizations-page"
    data-organizations-page
  >
    <!-- ============================================================
         PAGE INTRO
    ============================================================= -->
    <section
      class="page-hero"
      aria-labelledby="organizations-page-title"
    >
      <div class="page-hero__copy">
        <div class="page-hero__eyebrow">
          <span class="page-hero__eyebrow-mark">
            <Building2
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span>
            ORGANIZATION MANAGEMENT
          </span>
        </div>

        <h1 id="organizations-page-title">
          Organisasi
        </h1>

        <p>
          Verifikasi, kelola, dan pantau organisasi yang menjadi bagian
          dari ekosistem data BINSIGHT.
        </p>
      </div>

      <div class="page-hero__actions">
        <button
          type="button"
          class="button button--paper"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Refresh
          </span>
        </button>

        <a
          href="/organizations"
          class="button button--ghost"
        >
          <Eye
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <span>
            Lihat publik
          </span>
        </a>

        <button
          type="button"
          class="button button--acid"
          data-create
        >
          <Plus
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Tambah organisasi
          </span>
        </button>
      </div>
    </section>

    <!-- ============================================================
         SUMMARY
    ============================================================= -->
    <section
      class="summary-grid"
      aria-label="Ringkasan organisasi"
    >
      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__index">
            01
          </span>

          <span class="summary-card__icon">
            <Building2
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          TOTAL ORGANISASI
        </span>

        <strong
          class="summary-card__value"
          data-total-count
        >
          {totalOrganizations}
        </strong>

        <span class="summary-card__meta">
          Record dalam workspace
        </span>
      </article>

      <article class="summary-card summary-card--acid">
        <div class="summary-card__top">
          <span class="summary-card__index">
            02
          </span>

          <span class="summary-card__icon">
            <CircleCheck
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          TERVERIFIKASI
        </span>

        <strong
          class="summary-card__value"
          data-verified-count
        >
          {verifiedCount}
        </strong>

        <span class="summary-card__meta">
          Siap untuk visibilitas publik
        </span>
      </article>

      <article class="summary-card summary-card--orange">
        <div class="summary-card__top">
          <span class="summary-card__index">
            03
          </span>

          <span class="summary-card__icon">
            <ShieldCheck
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          MENUNGGU
        </span>

        <strong
          class="summary-card__value"
          data-pending-count
        >
          {pendingCount}
        </strong>

        <span class="summary-card__meta">
          Perlu pemeriksaan admin
        </span>
      </article>

      <article class="summary-card summary-card--muted">
        <div class="summary-card__top">
          <span class="summary-card__index">
            04
          </span>

          <span class="summary-card__icon">
            <Eye
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          PUBLIK
        </span>

        <strong
          class="summary-card__value"
          data-public-count
        >
          {publicCount}
        </strong>

        <span class="summary-card__meta">
          Ditandai dapat dilihat publik
        </span>
      </article>
    </section>

    <!-- ============================================================
         DIRECTORY
    ============================================================= -->
    <section
      class="directory"
      aria-labelledby="organization-directory-title"
    >
      <div class="directory__top">
        <div class="directory__title">
          <span class="directory__eyebrow">
            ORGANIZATION DIRECTORY
          </span>

          <h2 id="organization-directory-title">
            Daftar organisasi
          </h2>
        </div>

        <span
          class="directory__count"
          data-result-count
        >
          {totalOrganizations} organisasi
        </span>
      </div>

      <div class="toolbar">
        <div class="toolbar__search">
          <Search
            size={17}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="organization-search"
          >
            Cari organisasi
          </label>

          <input
            id="organization-search"
            type="search"
            placeholder="Cari nama organisasi, wilayah, atau pengelola..."
            autocomplete="off"
            spellcheck="false"
            data-search
          />

          <button
            type="button"
            class="toolbar__clear"
            aria-label="Hapus pencarian"
            title="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar__filters">
          <label class="filter-control">
            <span class="filter-control__label">
              STATUS
            </span>

            <select
              aria-label="Filter status organisasi"
              data-status-filter
            >
              <option value="all">
                Semua
              </option>

              <option value="verified">
                Terverifikasi
              </option>

              <option value="pending">
                Menunggu
              </option>

              <option value="unverified">
                Belum diverifikasi
              </option>
            </select>
          </label>

          <label class="filter-control">
            <span class="filter-control__label">
              TIPE
            </span>

            <select
              aria-label="Filter tipe organisasi"
              data-type-filter
            >
              <option value="all">
                Semua
              </option>

              {
                Object.entries(
                  typeLabels,
                ).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <button
            type="button"
            class="filter-button"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="organization-filter-panel"
          >
            <Filter
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <span>
              Filter
            </span>
          </button>
        </div>
      </div>

      <div
        id="organization-filter-panel"
        class="filter-panel"
        data-filter-panel
        hidden
      >
        <div class="filter-panel__header">
          <div>
            <span class="filter-panel__eyebrow">
              FILTER DATA
            </span>

            <h3>
              Penyaringan organisasi
            </h3>
          </div>

          <button
            type="button"
            class="filter-panel__close"
            aria-label="Tutup filter"
            title="Tutup filter"
            data-filter-close
          >
            <X
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="filter-panel__body">
          <div class="filter-info">
            <ShieldCheck
              size={17}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <p>
              Gunakan status dan tipe untuk memprioritaskan organisasi
              yang membutuhkan pemeriksaan sebelum informasi ditampilkan
              kepada publik.
            </p>
          </div>

          <button
            type="button"
            class="filter-reset"
            data-filter-reset
          >
            Reset semua filter
          </button>
        </div>
      </div>

      <div class="table-wrap">
        <table class="organizations-table">
          <caption class="sr-only">
            Daftar organisasi BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Organisasi
              </th>

              <th scope="col">
                Tipe
              </th>

              <th scope="col">
                Wilayah
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Visibilitas
              </th>

              <th scope="col">
                Diperbarui
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              organizations.map(
                (organization) => (
                  <tr
                    data-organization-row
                    data-id={organization.id}
                    data-name={organization.name.toLowerCase()}
                    data-area={organization.area.toLowerCase()}
                    data-manager={organization.manager.toLowerCase()}
                    data-description={organization.description.toLowerCase()}
                    data-address={organization.address.toLowerCase()}
                    data-status={organization.status}
                    data-type={organization.type}
                    data-visibility={
                      organization.isPublic
                        ? "public"
                        : "private"
                    }
                  >
                    <td>
                      <div class="organization-cell">
                        <span class:list={[
                          "organization-cell__icon",
                          organization.status ===
                          "verified"
                            ? "organization-cell__icon--verified"
                            : "",
                        ]}>
                          <Building2
                            size={17}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </span>

                        <div class="organization-cell__copy">
                          <strong
                            title={organization.name}
                          >
                            {organization.name}
                          </strong>

                          <span
                            title={organization.address}
                          >
                            {organization.address}
                          </span>
                        </div>
                      </div>
                    </td>

                    <td>
                      <span class="type-label">
                        {typeLabels[organization.type]}
                      </span>
                    </td>

                    <td>
                      <div class="area-cell">
                        <MapPin
                          size={14}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />

                        <span>
                          {organization.area}
                        </span>
                      </div>
                    </td>

                    <td>
                      <span
                        class:list={[
                          "status-badge",
                          `status-badge--${organization.status}`,
                        ]}
                      >
                        {
                          organization.status ===
                          "verified" ? (
                            <CircleCheck
                              size={13}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          ) : organization.status ===
                            "pending" ? (
                            <ShieldCheck
                              size={13}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          ) : (
                            <TriangleAlert
                              size={13}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          )
                        }

                        <span>
                          {statusLabels[
                            organization.status
                          ]}
                        </span>
                      </span>
                    </td>

                    <td>
                      <span
                        class:list={[
                          "visibility-badge",
                          organization.isPublic
                            ? "visibility-badge--public"
                            : "visibility-badge--private",
                        ]}
                      >
                        {organization.isPublic ? (
                          <Eye
                            size={12}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : (
                          <ShieldCheck
                            size={12}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        )}

                        <span>
                          {organization.isPublic
                            ? "Publik"
                            : "Privat"}
                        </span>
                      </span>
                    </td>

                    <td>
                      <span class="updated-label">
                        {organization.updatedAt}
                      </span>
                    </td>

                    <td>
                      <div class="row-actions">
                        <button
                          type="button"
                          class="row-action"
                          aria-label={`Lihat ${organization.name}`}
                          title="Lihat"
                          data-view
                          data-record={organization.id}
                        >
                          <Eye
                            size={15}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </button>

                        <button
                          type="button"
                          class="row-action"
                          aria-label={`Edit ${organization.name}`}
                          title="Edit"
                          data-edit
                          data-record={organization.id}
                        >
                          <Pencil
                            size={15}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </button>

                        <button
                          type="button"
                          class="row-action row-action--danger"
                          aria-label={`Hapus ${organization.name}`}
                          title="Hapus"
                          data-delete
                          data-record={organization.id}
                        >
                          <Trash2
                            size={15}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </button>
                      </div>
                    </td>
                  </tr>
                ),
              )
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
          aria-hidden="true"
        >
          <span class="empty-state__icon">
            <Search
              size={24}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>

          <span class="empty-state__eyebrow">
            NO MATCH
          </span>

          <h3>
            Organisasi tidak ditemukan
          </h3>

          <p>
            Tidak ada organisasi yang cocok dengan pencarian atau
            filter yang digunakan.
          </p>

          <button
            type="button"
            class="button button--paper"
            data-empty-reset
          >
            Reset filter
          </button>
        </div>
      </div>

      <footer class="directory__footer">
        <span>
          <strong data-footer-count>
            {totalOrganizations}
          </strong>
          organisasi ditampilkan
        </span>

        <span>
          BINSIGHT / ORGANIZATIONS
        </span>
      </footer>
    </section>

    <!-- ============================================================
         GOVERNANCE
    ============================================================= -->
    <section class="verification-banner">
      <div class="verification-banner__icon">
        <ShieldCheck
          size={22}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </div>

      <div class="verification-banner__content">
        <span class="verification-banner__eyebrow">
          GOVERNANCE
        </span>

        <h2>
          Verifikasi sebelum publikasi
        </h2>

        <p>
          Pastikan nama, tipe, wilayah, deskripsi, dan keterhubungan
          lokasi organisasi telah diperiksa sebelum organisasi ditandai
          terverifikasi dan dapat ditampilkan kepada masyarakat.
        </p>
      </div>

      <a
        href="/admin/locations"
        class="verification-banner__link"
      >
        Periksa lokasi

        <ArrowRight
          size={16}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </a>
    </section>

    <!-- ============================================================
         DETAIL DRAWER
    ============================================================= -->
    <div
      class="drawer-backdrop"
      data-drawer-backdrop
      hidden
    ></div>

    <aside
      class="organization-drawer"
      data-drawer
      aria-hidden="true"
      hidden
      aria-labelledby="organization-drawer-title"
    >
      <div class="drawer__header">
        <div>
          <span class="drawer__eyebrow">
            ORGANIZATION DETAIL
          </span>

          <h2 id="organization-drawer-title">
            Detail organisasi
          </h2>
        </div>

        <button
          type="button"
          class="drawer__close"
          aria-label="Tutup detail"
          title="Tutup"
          data-drawer-close
        >
          <X
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />
        </button>
      </div>

      <div class="drawer__body">
        <div class="drawer-identity">
          <span class="drawer-identity__icon">
            <Building2
              size={22}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <div class="drawer-identity__copy">
            <h3 data-drawer-name>
              -
            </h3>

            <span data-drawer-type>
              -
            </span>
          </div>
        </div>

        <div class="drawer-status-row">
          <span
            class="status-badge"
            data-drawer-status
          >
            -
          </span>

          <span
            class="visibility-badge"
            data-drawer-visibility
          >
            -
          </span>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            INFORMASI
          </span>

          <dl class="detail-list">
            <div>
              <dt>
                Wilayah
              </dt>

              <dd data-drawer-area>
                -
              </dd>
            </div>

            <div>
              <dt>
                Alamat
              </dt>

              <dd data-drawer-address>
                -
              </dd>
            </div>

            <div>
              <dt>
                Pengelola
              </dt>

              <dd data-drawer-manager>
                -
              </dd>
            </div>

            <div>
              <dt>
                Lokasi terhubung
              </dt>

              <dd data-drawer-location-count>
                -
              </dd>
            </div>

            <div>
              <dt>
                Diperbarui
              </dt>

              <dd data-drawer-updated>
                -
              </dd>
            </div>
          </dl>
        </div>

