<script>
  // @ts-nocheck

  const page =
    document.querySelector(
      "[data-organizations-page]",
    );

  if (
    !(page instanceof HTMLElement)
  ) {
    throw new Error(
      "BINSIGHT organizations admin page root not found.",
    );
  }

  const dataNode =
    document.getElementById(
      "admin-organizations-data",
    );

  let organizations = [];

  try {
    organizations =
      dataNode?.textContent
        ? JSON.parse(
            dataNode.textContent,
          )
        : [];
  } catch {
    organizations = [];
  }

  const searchInput =
    page.querySelector(
      "[data-search]",
    );

  const clearSearch =
    page.querySelector(
      "[data-clear-search]",
    );

  const statusFilter =
    page.querySelector(
      "[data-status-filter]",
    );

  const typeFilter =
    page.querySelector(
      "[data-type-filter]",
    );

  const filterToggle =
    page.querySelector(
      "[data-filter-toggle]",
    );

  const filterPanel =
    page.querySelector(
      "[data-filter-panel]",
    );

  const filterClose =
    page.querySelector(
      "[data-filter-close]",
    );

  const filterReset =
    page.querySelector(
      "[data-filter-reset]",
    );

  let rows = Array.from(
    page.querySelectorAll(
      "[data-organization-row]",
    ),
  );

  const resultCount =
    page.querySelector(
      "[data-result-count]",
    );

  const footerCount =
    page.querySelector(
      "[data-footer-count]",
    );

  const emptyState =
    page.querySelector(
      "[data-empty-state]",
    );

  const emptyReset =
    page.querySelector(
      "[data-empty-reset]",
    );

  const drawer =
    page.querySelector(
      "[data-drawer]",
    );

  const drawerBackdrop =
    page.querySelector(
      "[data-drawer-backdrop]",
    );

  const drawerClose =
    page.querySelector(
      "[data-drawer-close]",
    );

  const drawerName =
    page.querySelector(
      "[data-drawer-name]",
    );

  const drawerType =
    page.querySelector(
      "[data-drawer-type]",
    );

  const drawerStatus =
    page.querySelector(
      "[data-drawer-status]",
    );

  const drawerVisibility =
    page.querySelector(
      "[data-drawer-visibility]",
    );

  const drawerArea =
    page.querySelector(
      "[data-drawer-area]",
    );

  const drawerAddress =
    page.querySelector(
      "[data-drawer-address]",
    );

  const drawerManager =
    page.querySelector(
      "[data-drawer-manager]",
    );

  const drawerLocationCount =
    page.querySelector(
      "[data-drawer-location-count]",
    );

  const drawerUpdated =
    page.querySelector(
      "[data-drawer-updated]",
    );

  const drawerDescription =
    page.querySelector(
      "[data-drawer-description]",
    );

  const drawerWarning =
    page.querySelector(
      "[data-drawer-warning]",
    );

  const drawerVerify =
    page.querySelector(
      "[data-drawer-verify]",
    );

  const drawerEdit =
    page.querySelector(
      "[data-drawer-edit]",
    );

  const drawerDelete =
    page.querySelector(
      "[data-drawer-delete]",
    );

  const toast =
    page.querySelector(
      "[data-toast]",
    );

  const toastMessage =
    page.querySelector(
      "[data-toast-message]",
    );

  const totalCount =
    page.querySelector(
      "[data-total-count]",
    );

  const verifiedCount =
    page.querySelector(
      "[data-verified-count]",
    );

  const pendingCount =
    page.querySelector(
      "[data-pending-count]",
    );

  const publicCount =
    page.querySelector(
      "[data-public-count]",
    );

  let selectedOrganizationId =
    null;

  let toastTimer = null;

  let scrollLockCount = 0;

  let previouslyFocusedElement =
    null;

  function lockPageScroll() {
    scrollLockCount += 1;

    if (
      scrollLockCount ===
      1
    ) {
      document.documentElement.style.overflow =
        "hidden";
    }
  }

  function unlockPageScroll() {
    scrollLockCount =
      Math.max(
        0,
        scrollLockCount - 1,
      );

    if (
      scrollLockCount ===
      0
    ) {
      document.documentElement.style.overflow =
        "";
    }
  }

  function getOrganization(
    id,
  ) {
    return organizations.find(
      (organization) =>
        organization.id === id,
    );
  }

  function updateSummary() {
    const total =
      organizations.length;

    const verified =
      organizations.filter(
        (organization) =>
          organization.status ===
          "verified",
      ).length;

    const pending =
      organizations.filter(
        (organization) =>
          organization.status ===
          "pending",
      ).length;

    const publicOrganizations =
      organizations.filter(
        (organization) =>
          organization.isPublic,
      ).length;

    if (
      totalCount instanceof HTMLElement
    ) {
      totalCount.textContent =
        String(total);
    }

    if (
      verifiedCount instanceof HTMLElement
    ) {
      verifiedCount.textContent =
        String(verified);
    }

    if (
      pendingCount instanceof HTMLElement
    ) {
      pendingCount.textContent =
        String(pending);
    }

    if (
      publicCount instanceof HTMLElement
    ) {
      publicCount.textContent =
        String(
          publicOrganizations,
        );
    }
  }

  function setEmptyState(
    hasResults,
  ) {
    if (
      !(emptyState instanceof
        HTMLElement)
    ) {
      return;
    }

    const shouldShow =
      !hasResults;

    emptyState.hidden =
      !shouldShow;

    emptyState.setAttribute(
      "aria-hidden",
      shouldShow
        ? "false"
        : "true",
    );

    emptyState.style.display =
      shouldShow
        ? "flex"
        : "none";
  }

  function updateRowAttributes(
    row,
    organization,
  ) {
    if (
      !(row instanceof
        HTMLElement)
    ) {
      return;
    }

    row.setAttribute(
      "data-name",
      organization.name.toLowerCase(),
    );

    row.setAttribute(
      "data-area",
      organization.area.toLowerCase(),
    );

    row.setAttribute(
      "data-manager",
      organization.manager.toLowerCase(),
    );

    row.setAttribute(
      "data-description",
      organization.description.toLowerCase(),
    );

    row.setAttribute(
      "data-address",
      organization.address.toLowerCase(),
    );

    row.setAttribute(
      "data-status",
      organization.status,
    );

    row.setAttribute(
      "data-type",
      organization.type,
    );

    row.setAttribute(
      "data-visibility",
      organization.isPublic
        ? "public"
        : "private",
    );

    const statusBadge =
      row.querySelector(
        ".status-badge",
      );

    setStatusBadge(
      statusBadge,
      organization,
    );

    const visibilityBadge =
      row.querySelector(
        ".visibility-badge",
      );

    setVisibilityBadge(
      visibilityBadge,
      organization,
    );
  }

  function setStatusBadge(
    element,
    organization,
  ) {
    if (
      !(element instanceof
        HTMLElement)
    ) {
      return;
    }

    element.className =
      `status-badge status-badge--${organization.status}`;

    element.replaceChildren();

    let icon;

    if (
      organization.status ===
      "verified"
    ) {
      icon =
        document.createElement(
          "span",
        );

      icon.textContent =
        "✓";
    } else if (
      organization.status ===
      "pending"
    ) {
      icon =
        document.createElement(
          "span",
        );

      icon.textContent =
        "◷";
    } else {
      icon =
        document.createElement(
          "span",
        );

      icon.textContent =
        "!";
    }

    icon.setAttribute(
      "aria-hidden",
      "true",
    );

    element.append(
      icon,
    );

    const label =
      document.createElement(
        "span",
      );

    label.textContent =
      organization.statusLabel;

    element.append(
      label,
    );
  }

  function setVisibilityBadge(
    element,
    organization,
  ) {
    if (
      !(element instanceof
        HTMLElement)
    ) {
      return;
    }

    element.className =
      organization.isPublic
        ? "visibility-badge visibility-badge--public"
        : "visibility-badge visibility-badge--private";

    element.replaceChildren();

    const label =
      document.createElement(
        "span",
      );

    label.textContent =
      organization.isPublic
        ? "Publik"
        : "Privat";

    element.append(
      label,
    );
  }

  function getMatchingRows() {
    const query =
      searchInput instanceof
      HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const status =
      statusFilter instanceof
      HTMLSelectElement
        ? statusFilter.value
        : "all";

    const type =
      typeFilter instanceof
      HTMLSelectElement
        ? typeFilter.value
        : "all";

    return rows.filter(
      (row) => {
        const name =
          row.getAttribute(
            "data-name",
          ) ?? "";

        const area =
          row.getAttribute(
            "data-area",
          ) ?? "";

        const manager =
          row.getAttribute(
            "data-manager",
          ) ?? "";

        const description =
          row.getAttribute(
            "data-description",
          ) ?? "";

        const address =
          row.getAttribute(
            "data-address",
          ) ?? "";

        const rowStatus =
          row.getAttribute(
            "data-status",
          ) ?? "";

        const rowType =
          row.getAttribute(
            "data-type",
          ) ?? "";

        const matchesSearch =
          query === "" ||
          name.includes(
            query,
          ) ||
          area.includes(
            query,
          ) ||
          manager.includes(
            query,
          ) ||
          description.includes(
            query,
          ) ||
          address.includes(
            query,
          );

        const matchesStatus =
          status === "all" ||
          rowStatus === status;

        const matchesType =
          type === "all" ||
          rowType === type;

        return (
          matchesSearch &&
          matchesStatus &&
          matchesType
        );
      },
    );
  }

  function applyFilters() {
    const matchingRows =
      getMatchingRows();

    rows.forEach(
      (row) => {
        const visible =
          matchingRows.includes(
            row,
          );

        row.setAttribute(
          "data-hidden",
          visible
            ? "false"
            : "true",
        );

        row.hidden =
          !visible;
      },
    );

    const count =
      matchingRows.length;

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${count} organisasi`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(count);
    }

    setEmptyState(
      count > 0,
    );

    if (
      clearSearch instanceof
      HTMLButtonElement
    ) {
      const hasSearch =
        searchInput instanceof
        HTMLInputElement &&
        searchInput.value.length >
          0;

      clearSearch.hidden =
        !hasSearch;
    }
  }

  function resetFilters() {
    if (
      searchInput instanceof
      HTMLInputElement
    ) {
      searchInput.value =
        "";
    }

    if (
      statusFilter instanceof
      HTMLSelectElement
    ) {
      statusFilter.value =
        "all";
    }

    if (
      typeFilter instanceof
      HTMLSelectElement
    ) {
      typeFilter.value =
        "all";
    }

    applyFilters();
  }

  function setFilterPanel(
    open,
  ) {
    if (
      !(filterPanel instanceof
        HTMLElement) ||
      !(filterToggle instanceof
        HTMLButtonElement)
    ) {
      return;
    }

    filterPanel.hidden =
      !open;

    filterToggle.setAttribute(
      "aria-expanded",
      open
        ? "true"
        : "false",
    );
  }

  function updateDrawer(
    organization,
  ) {
    if (!organization) {
      return;
    }

    if (
      drawerName instanceof
      HTMLElement
    ) {
      drawerName.textContent =
        organization.name;
    }

    if (
      drawerType instanceof
      HTMLElement
    ) {
      drawerType.textContent =
        typeLabels[
          organization.type
        ] ??
        organization.type;
    }

    setStatusBadge(
      drawerStatus,
      organization,
    );

    setVisibilityBadge(
      drawerVisibility,
      organization,
    );

    if (
      drawerArea instanceof
      HTMLElement
    ) {
      drawerArea.textContent =
        organization.area;
    }

    if (
      drawerAddress instanceof
      HTMLElement
    ) {
      drawerAddress.textContent =
        organization.address;
    }

    if (
      drawerManager instanceof
      HTMLElement
    ) {
      drawerManager.textContent =
        organization.manager;
    }

    if (
      drawerLocationCount instanceof
      HTMLElement
    ) {
      drawerLocationCount.textContent =
        `${organization.locationCount} lokasi`;
    }

    if (
      drawerUpdated instanceof
      HTMLElement
    ) {
      drawerUpdated.textContent =
        organization.updatedAt;
    }

    if (
      drawerDescription instanceof
      HTMLElement
    ) {
      drawerDescription.textContent =
        organization.description;
    }

    if (
      drawerWarning instanceof
      HTMLElement
    ) {
      const shouldWarn =
        organization.status !==
        "verified";

      drawerWarning.hidden =
        !shouldWarn;

      drawerWarning.setAttribute(
        "aria-hidden",
        shouldWarn
          ? "false"
          : "true",
      );
    }

    if (
      drawerVerify instanceof
      HTMLButtonElement
    ) {
      const alreadyVerified =
        organization.status ===
        "verified";

      drawerVerify.disabled =
        alreadyVerified;

      drawerVerify.className =
        alreadyVerified
          ? "button button--paper"
          : "button button--acid";

      drawerVerify.replaceChildren();

      const label =
        document.createElement(
          "span",
        );

      label.textContent =
        alreadyVerified
          ? "Sudah terverifikasi"
          : "Verifikasi";

      drawerVerify.append(
        label,
      );
    }
  }

  function openDrawer(
    organizationId,
  ) {
    const organization =
      getOrganization(
        organizationId,
      );

    if (
      !organization ||
      !(drawer instanceof
        HTMLElement) ||
      !(drawerBackdrop instanceof
        HTMLElement)
    ) {
      return;
    }

    previouslyFocusedElement =
      document.activeElement instanceof
      HTMLElement
        ? document.activeElement
        : null;

    selectedOrganizationId =
      organizationId;

    updateDrawer(
      organization,
    );

    drawer.hidden =
      false;

    drawerBackdrop.hidden =
      false;

    lockPageScroll();

    requestAnimationFrame(
      () => {
        drawer.setAttribute(
          "data-open",
          "true",
        );

        drawer.setAttribute(
          "aria-hidden",
          "false",
        );

        if (
          drawerClose instanceof
          HTMLButtonElement
        ) {
          drawerClose.focus();
        }
      },
    );
  }

  function closeDrawer() {
    if (
      !(drawer instanceof
        HTMLElement) ||
      !(drawerBackdrop instanceof
        HTMLElement)
    ) {
      return;
    }

    const wasOpen =
      drawer.getAttribute(
        "data-open",
      ) ===
      "true";

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        if (
          drawer.getAttribute(
            "data-open",
          ) !==
          "true"
        ) {
          drawer.hidden =
            true;

          drawerBackdrop.hidden =
            true;
        }
      },
      190,
    );

    if (wasOpen) {
      unlockPageScroll();
    }

    selectedOrganizationId =
      null;

    if (
      previouslyFocusedElement instanceof
      HTMLElement
    ) {
      previouslyFocusedElement.focus();

      previouslyFocusedElement =
        null;
    }
  }

  function showToast(
    message,
  ) {
    if (
      !(toast instanceof
        HTMLElement) ||
      !(toastMessage instanceof
        HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden =
      false;

    if (
      toastTimer !== null
    ) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden =
            true;

          toastTimer =
            null;
        },
        2800,
      );
  }

  function editOrganization(
    id,
  ) {
    const organization =
      getOrganization(id);

    if (!organization) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-organization-edit",
        {
          detail: {
            ...organization,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk "${organization.name}" dipersiapkan.`,
    );
  }

  function createOrganization() {
    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-organization-create",
      ),
    );

    showToast(
      "Form organisasi baru dipersiapkan.",
    );
  }

  function verifySelectedOrganization() {
    if (
      !selectedOrganizationId
    ) {
      return;
    }

    const organization =
      getOrganization(
        selectedOrganizationId,
      );

    if (!organization) {
      return;
    }

    if (
      organization.status ===
      "verified"
    ) {
      showToast(
        "Organisasi ini sudah terverifikasi.",
      );

      return;
    }

    organization.status =
      "verified";

    organization.isPublic =
      true;

    organization.updatedAt =
      "10 Sep 2026, sekarang";

    organization.statusLabel =
      "Terverifikasi";

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) ===
          organization.id,
      );

    if (
      row instanceof HTMLElement
    ) {
      updateRowAttributes(
        row,
        organization,
      );
    }

    updateDrawer(
      organization,
    );

    updateSummary();
    applyFilters();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-organization-verify",
        {
          detail: {
            ...organization,
          },
        },
      ),
    );

    showToast(
      `"${organization.name}" ditandai terverifikasi.`,
    );
  }

  function deleteOrganization(
    id,
  ) {
    const organization =
      getOrganization(id);

    if (!organization) {
      return;
    }

    const confirmed =
      window.confirm(
        `Hapus organisasi "${organization.name}" dari workspace admin?`,
      );

    if (!confirmed) {
      return;
    }

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) === id,
      );

    if (
      row instanceof HTMLElement
    ) {
      row.remove();
    }

    const organizationIndex =
      organizations.findIndex(
        (item) =>
          item.id === id,
      );

    if (
      organizationIndex >=
      0
    ) {
      organizations.splice(
        organizationIndex,
        1,
      );
    }

    rows =
      Array.from(
        page.querySelectorAll(
          "[data-organization-row]",
        ),
      );

    if (
      selectedOrganizationId ===
      id
    ) {
      closeDrawer();
    }

    updateSummary();
    applyFilters();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-organization-delete",
        {
          detail: {
            ...organization,
          },
        },
      ),
    );

    showToast(
      `"${organization.name}" dihapus dari daftar.`,
    );
  }

  function refreshOrganizations() {
    updateSummary();
    applyFilters();

    showToast(
      "Daftar organisasi diperbarui.",
    );
  }

  searchInput?.addEventListener(
    "input",
    applyFilters,
  );

  statusFilter?.addEventListener(
    "change",
    applyFilters,
  );

  typeFilter?.addEventListener(
    "change",
    applyFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof
        HTMLInputElement
      ) {
        searchInput.value =
          "";

        searchInput.focus();
      }

      applyFilters();
    },
  );

  emptyReset?.addEventListener(
    "click",
    resetFilters,
  );

  filterReset?.addEventListener(
    "click",
    () => {
      resetFilters();
      setFilterPanel(
        false,
      );
    },
  );

  filterToggle?.addEventListener(
    "click",
    () => {
      if (
        !(filterToggle instanceof
          HTMLButtonElement)
      ) {
        return;
      }

      const currentlyOpen =
        filterToggle.getAttribute(
          "aria-expanded",
        ) ===
        "true";

      setFilterPanel(
        !currentlyOpen,
      );
    },
  );

  filterClose?.addEventListener(
    "click",
    () => {
      setFilterPanel(
        false,
      );
    },
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editOrganization(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-delete]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              deleteOrganization(id);
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerBackdrop?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (
        selectedOrganizationId
      ) {
        editOrganization(
          selectedOrganizationId,
        );
      }
    },
  );

  drawerVerify?.addEventListener(
    "click",
    verifySelectedOrganization,
  );

  drawerDelete?.addEventListener(
    "click",
    () => {
      if (
        selectedOrganizationId
      ) {
        deleteOrganization(
          selectedOrganizationId,
        );
      }
    },
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      refreshOrganizations,
    );

  page
    .querySelector(
      "[data-create]",
    )
    ?.addEventListener(
      "click",
      createOrganization,
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key !==
        "Escape"
      ) {
        return;
      }

      if (
        drawer instanceof
          HTMLElement &&
        drawer.getAttribute(
          "data-open",
        ) ===
          "true"
      ) {
        closeDrawer();

        return;
      }

      if (
        filterPanel instanceof
          HTMLElement &&
        !filterPanel.hidden
      ) {
        setFilterPanel(
          false,
        );
      }
    },
  );

  window.addEventListener(
    "beforeunload",
    () => {
      document.documentElement.style.overflow =
        "";
    },
  );

  /*
   * Initial state:
   * records exist -> empty state remains hidden.
   */
  setEmptyState(
    rows.length > 0,
  );

  updateSummary();
  applyFilters();
</script>