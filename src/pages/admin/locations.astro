---
/**
 * BINSIGHT — ADMIN LOCATIONS
 * --------------------------------------------------------------------------
 * Location management workspace for BINSIGHT.
 *
 * Design baseline:
 * - BINSIGHT editorial / brutalist visual language
 * - Page-owned hierarchy
 * - No duplicate admin header
 * - No page-level vertical scroll container
 * - Main page uses AdminLayout document scroll
 * - Sidebar behavior belongs exclusively to AdminLayout
 * - Square edges, hard borders, offset shadows
 * - Lime / ink / orange accent system
 * - Responsive without horizontal overflow
 *
 * Data note:
 * - This page currently uses local demo records.
 * - No backend write operation is invented here.
 * - Client actions emit BINSIGHT custom events and update local UI state.
 * --------------------------------------------------------------------------
 */

import {
  Activity,
  ArrowRight,
  Building2,
  CircleCheck,
  Eye,
  Filter,
  MapPin,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  TriangleAlert,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

type LocationStatus =
  | "active"
  | "inactive";

type LocationType =
  | "collection-point"
  | "recycling-center"
  | "waste-bank"
  | "processing-facility"
  | "drop-point"
  | "other";

interface WasteLocationRecord {
  id: string;
  slug: string;
  name: string;
  description: string;
  address: string;
  areaId: string;
  areaName: string;
  type: LocationType;
  status: LocationStatus;
  coordinates: {
    lat: number;
    lng: number;
  };
  organizationIds: string[];
  tags: string[];
  createdAt: string;
  updatedAt: string;
}

const locations: WasteLocationRecord[] = [
  {
    id: "loc-demo-001",
    slug: "titik-pengelolaan-mengwi",
    name: "Titik Pengelolaan Sampah Mengwi",
    description:
      "Lokasi pengelolaan yang terhubung dengan aktivitas pemilahan dan pengumpulan material.",
    address: "Mengwi, Kabupaten Badung, Bali",
    areaId: "mengwi",
    areaName: "Mengwi",
    type: "collection-point",
    status: "active",
    coordinates: {
      lat: -8.544,
      lng: 115.171,
    },
    organizationIds: ["org-demo-001"],
    tags: ["pengumpulan", "pemilahan"],
    createdAt: "2026-09-01",
    updatedAt: "2026-09-10",
  },
  {
    id: "loc-demo-002",
    slug: "hub-daur-ulang-kuta",
    name: "Hub Daur Ulang Kuta",
    description:
      "Fasilitas yang menangani material yang dapat dipulihkan dan diproses kembali.",
    address: "Kuta, Kabupaten Badung, Bali",
    areaId: "kuta",
    areaName: "Kuta",
    type: "recycling-center",
    status: "active",
    coordinates: {
      lat: -8.727,
      lng: 115.171,
    },
    organizationIds: ["org-demo-003"],
    tags: ["recycling", "material-recovery"],
    createdAt: "2026-09-02",
    updatedAt: "2026-09-08",
  },
  {
    id: "loc-demo-003",
    slug: "bank-sampah-kuta-utara",
    name: "Bank Sampah Kuta Utara",
    description:
      "Titik berbasis masyarakat untuk penerimaan, pemilahan, dan pengelolaan material tertentu.",
    address: "Kuta Utara, Kabupaten Badung, Bali",
    areaId: "kuta-utara",
    areaName: "Kuta Utara",
    type: "waste-bank",
    status: "active",
    coordinates: {
      lat: -8.66,
      lng: 115.168,
    },
    organizationIds: ["org-demo-002"],
    tags: ["bank-sampah", "komunitas"],
    createdAt: "2026-09-03",
    updatedAt: "2026-09-09",
  },
  {
    id: "loc-demo-004",
    slug: "fasilitas-pengolahan-abiansemal",
    name: "Fasilitas Pengolahan Abiansemal",
    description:
      "Lokasi fasilitas pengolahan yang sedang dipersiapkan untuk informasi operasional.",
    address: "Abiansemal, Kabupaten Badung, Bali",
    areaId: "abiansemal",
    areaName: "Abiansemal",
    type: "processing-facility",
    status: "inactive",
    coordinates: {
      lat: -8.55,
      lng: 115.206,
    },
    organizationIds: ["org-demo-004"],
    tags: ["pengolahan"],
    createdAt: "2026-09-04",
    updatedAt: "2026-09-07",
  },
  {
    id: "loc-demo-005",
    slug: "drop-point-mengwi",
    name: "Drop Point Mengwi",
    description:
      "Titik penerimaan material dengan cakupan layanan yang terbatas.",
    address: "Mengwi, Kabupaten Badung, Bali",
    areaId: "mengwi",
    areaName: "Mengwi",
    type: "drop-point",
    status: "active",
    coordinates: {
      lat: -8.536,
      lng: 115.173,
    },
    organizationIds: [],
    tags: ["drop-point"],
    createdAt: "2026-09-05",
    updatedAt: "2026-09-06",
  },
];

const typeLabels: Record<LocationType, string> = {
  "collection-point": "Titik pengumpulan",
  "recycling-center": "Pusat daur ulang",
  "waste-bank": "Bank sampah",
  "processing-facility": "Fasilitas pengolahan",
  "drop-point": "Drop point",
  other: "Lainnya",
};

const statusLabels: Record<LocationStatus, string> = {
  active: "Aktif",
  inactive: "Tidak aktif",
};

const totalLocations =
  locations.length;

const activeLocations =
  locations.filter(
    (location) =>
      location.status === "active",
  ).length;

const inactiveLocations =
  locations.filter(
    (location) =>
      location.status === "inactive",
  ).length;

const linkedLocations =
  locations.filter(
    (location) =>
      location.organizationIds.length > 0,
  ).length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Lokasi — Admin BINSIGHT",
  description:
    "Administrasi lokasi pengelolaan persampahan BINSIGHT.",
  url: "https://binsight.id/admin/locations",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Lokasi"
  description="Kelola titik lokasi pengelolaan persampahan dalam ekosistem BINSIGHT."
  activeSection="locations"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <script
    id="admin-locations-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify(locations)}
  />

  <div
    class="locations-page"
    data-locations-page
  >
    <!-- ============================================================
         PAGE INTRO
    ============================================================= -->
    <section
      class="page-hero"
      aria-labelledby="locations-page-title"
    >
      <div class="page-hero__copy">
        <div class="page-hero__eyebrow">
          <span class="page-hero__eyebrow-mark">
            <MapPin
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span>
            LOCATION MANAGEMENT
          </span>
        </div>

        <h1 id="locations-page-title">
          Lokasi
        </h1>

        <p>
          Kelola titik pengumpulan, bank sampah, fasilitas pengolahan,
          dan lokasi lain yang menjadi bagian dari peta ekosistem BINSIGHT.
        </p>
      </div>

      <div class="page-hero__actions">
        <button
          type="button"
          class="button button--paper"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Refresh
          </span>
        </button>

        <a
          href="/map"
          class="button button--ghost"
        >
          <Eye
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <span>
            Lihat peta
          </span>
        </a>

        <button
          type="button"
          class="button button--acid"
          data-create
        >
          <Plus
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Tambah lokasi
          </span>
        </button>
      </div>
    </section>

    <!-- ============================================================
         SUMMARY
    ============================================================= -->
    <section
      class="summary-grid"
      aria-label="Ringkasan lokasi"
    >
      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__index">
            01
          </span>

          <span class="summary-card__icon">
            <MapPin
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          TOTAL LOKASI
        </span>

        <strong
          class="summary-card__value"
          data-total-count
        >
          {totalLocations}
        </strong>

        <span class="summary-card__meta">
          Record lokasi dalam workspace
        </span>
      </article>

      <article class="summary-card summary-card--acid">
        <div class="summary-card__top">
          <span class="summary-card__index">
            02
          </span>

          <span class="summary-card__icon">
            <CircleCheck
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          AKTIF
        </span>

        <strong
          class="summary-card__value"
          data-active-count
        >
          {activeLocations}
        </strong>

        <span class="summary-card__meta">
          Lokasi yang aktif
        </span>
      </article>

      <article class="summary-card summary-card--orange">
        <div class="summary-card__top">
          <span class="summary-card__index">
            03
          </span>

          <span class="summary-card__icon">
            <TriangleAlert
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          TIDAK AKTIF
        </span>

        <strong
          class="summary-card__value"
          data-inactive-count
        >
          {inactiveLocations}
        </strong>

        <span class="summary-card__meta">
          Perlu diperiksa kembali
        </span>
      </article>

      <article class="summary-card summary-card--muted">
        <div class="summary-card__top">
          <span class="summary-card__index">
            04
          </span>

          <span class="summary-card__icon">
            <Building2
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          TERHUBUNG ORGANISASI
        </span>

        <strong
          class="summary-card__value"
          data-linked-count
        >
          {linkedLocations}
        </strong>

        <span class="summary-card__meta">
          Memiliki organisasi terkait
        </span>
      </article>
    </section>

    <!-- ============================================================
         DIRECTORY
    ============================================================= -->
    <section
      class="directory"
      aria-labelledby="location-directory-title"
    >
      <div class="directory__top">
        <div class="directory__title">
          <span class="directory__eyebrow">
            LOCATION DIRECTORY
          </span>

          <h2 id="location-directory-title">
            Daftar lokasi
          </h2>
        </div>

        <span
          class="directory__count"
          data-result-count
        >
          {totalLocations} lokasi
        </span>
      </div>

      <div class="toolbar">
        <div class="toolbar__search">
          <Search
            size={17}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="location-search"
          >
            Cari lokasi
          </label>

          <input
            id="location-search"
            type="search"
            placeholder="Cari lokasi, wilayah, alamat, atau tag..."
            autocomplete="off"
            spellcheck="false"
            data-search
          />

          <button
            type="button"
            class="toolbar__clear"
            aria-label="Hapus pencarian"
            title="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar__filters">
          <label class="filter-control">
            <span class="filter-control__label">
              STATUS
            </span>

            <select
              aria-label="Filter status lokasi"
              data-status-filter
            >
              <option value="all">
                Semua
              </option>

              <option value="active">
                Aktif
              </option>

              <option value="inactive">
                Tidak aktif
              </option>
            </select>
          </label>

          <label class="filter-control">
            <span class="filter-control__label">
              TIPE
            </span>

            <select
              aria-label="Filter tipe lokasi"
              data-type-filter
            >
              <option value="all">
                Semua
              </option>

              {
                Object.entries(typeLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="filter-control__label">
              WILAYAH
            </span>

            <select
              aria-label="Filter wilayah lokasi"
              data-area-filter
            >
              <option value="all">
                Semua
              </option>

              <option value="abiansemal">
                Abiansemal
              </option>

              <option value="kuta">
                Kuta
              </option>

              <option value="kuta-utara">
                Kuta Utara
              </option>

              <option value="mengwi">
                Mengwi
              </option>
            </select>
          </label>

          <button
            type="button"
            class="filter-button"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="location-filter-panel"
          >
            <Filter
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <span>
              Filter
            </span>
          </button>
        </div>
      </div>

      <div
        id="location-filter-panel"
        class="filter-panel"
        data-filter-panel
        hidden
      >
        <div class="filter-panel__header">
          <div>
            <span class="filter-panel__eyebrow">
              FILTER DATA
            </span>

            <h3>
              Penyaringan lokasi
            </h3>
          </div>

          <button
            type="button"
            class="filter-panel__close"
            aria-label="Tutup filter"
            title="Tutup filter"
            data-filter-close
          >
            <X
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="filter-panel__body">
          <div class="filter-info">
            <ShieldCheck
              size={17}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <p>
              Pastikan setiap lokasi memiliki nama, alamat, wilayah,
              status, dan koordinat yang benar sebelum digunakan sebagai
              bagian dari peta publik.
            </p>
          </div>

          <button
            type="button"
            class="filter-reset"
            data-filter-reset
          >
            Reset semua filter
          </button>
        </div>
      </div>

      <div class="table-wrap">
        <table class="locations-table">
          <caption class="sr-only">
            Daftar lokasi pengelolaan persampahan BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Lokasi
              </th>

              <th scope="col">
                Tipe
              </th>

              <th scope="col">
                Wilayah
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Organisasi
              </th>

              <th scope="col">
                Koordinat
              </th>

              <th scope="col">
                Diperbarui
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              locations.map((location) => (
                <tr
                  data-location-row
                  data-id={location.id}
                  data-name={location.name.toLowerCase()}
                  data-area-id={location.areaId}
                  data-area={location.areaName.toLowerCase()}
                  data-address={location.address.toLowerCase()}
                  data-tags={location.tags
                    .join(" ")
                    .toLowerCase()}
                  data-status={location.status}
                  data-type={location.type}
                >
                  <td>
                    <div class="location-cell">
                      <span class:list={[
                        "location-cell__icon",
                        location.status ===
                        "active"
                          ? "location-cell__icon--active"
                          : "",
                      ]}>
                        <MapPin
                          size={17}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </span>

                      <div class="location-cell__copy">
                        <strong
                          title={location.name}
                        >
                          {location.name}
                        </strong>

                        <span
                          title={location.address}
                        >
                          {location.address}
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>
                    <span class="type-label">
                      {typeLabels[location.type]}
                    </span>
                  </td>

                  <td>
                    <div class="area-cell">
                      <MapPin
                        size={13}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <span>
                        {location.areaName}
                      </span>
                    </div>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "status-badge",
                        `status-badge--${location.status}`,
                      ]}
                    >
                      {
                        location.status ===
                        "active" ? (
                          <CircleCheck
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : (
                          <TriangleAlert
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        )
                      }

                      <span>
                        {
                          statusLabels[
                            location.status
                          ]
                        }
                      </span>
                    </span>
                  </td>

                  <td>
                    <span class="organization-count">
                      {
                        location.organizationIds
                          .length
                      }{" "}
                      organisasi
                    </span>
                  </td>

                  <td>
                    <span class="coordinate-label">
                      {location.coordinates.lat.toFixed(4)},
                      {" "}
                      {location.coordinates.lng.toFixed(4)}
                    </span>
                  </td>

                  <td>
                    <span class="updated-label">
                      {location.updatedAt}
                    </span>
                  </td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Lihat ${location.name}`}
                        title="Lihat"
                        data-view
                        data-record={location.id}
                      >
                        <Eye
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>

                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Edit ${location.name}`}
                        title="Edit"
                        data-edit
                        data-record={location.id}
                      >
                        <Pencil
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
          aria-hidden="true"
        >
          <span class="empty-state__icon">
            <Search
              size={24}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>

          <span class="empty-state__eyebrow">
            NO MATCH
          </span>

          <h3>
            Lokasi tidak ditemukan
          </h3>

          <p>
            Tidak ada lokasi yang cocok dengan pencarian atau filter
            yang digunakan.
          </p>

          <button
            type="button"
            class="button button--paper"
            data-empty-reset
          >
            Reset filter
          </button>
        </div>
      </div>

      <footer class="directory__footer">
        <span>
          <strong data-footer-count>
            {totalLocations}
          </strong>
          lokasi ditampilkan
        </span>

        <span>
          BINSIGHT / LOCATIONS
        </span>
      </footer>
    </section>

    <!-- ============================================================
         MAP GOVERNANCE
    ============================================================= -->
    <section class="map-banner">
      <div class="map-banner__icon">
        <MapPin
          size={22}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </div>

      <div class="map-banner__content">
        <span class="map-banner__eyebrow">
          MAP GOVERNANCE
        </span>

        <h2>
          Lokasi adalah fondasi peta BINSIGHT
        </h2>

        <p>
          Pastikan koordinat, wilayah, alamat, dan keterhubungan organisasi
          konsisten agar setiap titik pada peta publik memiliki konteks yang
          jelas.
        </p>
      </div>

      <a
        href="/map"
        class="map-banner__link"
      >
        Buka peta

        <ArrowRight
          size={16}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </a>
    </section>

    <!-- ============================================================
         DETAIL DRAWER
    ============================================================= -->
    <div
      class="drawer-backdrop"
      data-drawer-backdrop
      hidden
    ></div>

    <aside
      class="location-drawer"
      data-drawer
      aria-hidden="true"
      hidden
      aria-labelledby="drawer-title"
    >
      <div class="drawer__header">
        <div>
          <span class="drawer__eyebrow">
            LOCATION DETAIL
          </span>

          <h2 id="drawer-title">
            Detail lokasi
          </h2>
        </div>

        <button
          type="button"
          class="drawer__close"
          aria-label="Tutup detail"
          title="Tutup"
          data-drawer-close
        >
          <X
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />
        </button>
      </div>

      <div class="drawer__body">
        <div class="drawer-identity">
          <span class="drawer-identity__icon">
            <MapPin
              size={22}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <div class="drawer-identity__copy">
            <h3 data-drawer-name>
              -
            </h3>

            <span data-drawer-type>
              -
            </span>
          </div>
        </div>

        <div class="drawer-status-row">
          <span
            class="status-badge"
            data-drawer-status
          >
            -
          </span>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            INFORMASI
          </span>

          <dl class="detail-list">
            <div>
              <dt>
                Wilayah
              </dt>

              <dd data-drawer-area>
                -
              </dd>
            </div>

            <div>
              <dt>
                Alamat
              </dt>

              <dd data-drawer-address>
                -
              </dd>
            </div>

            <div>
              <dt>
                Koordinat
              </dt>

              <dd data-drawer-coordinates>
                -
              </dd>
            </div>

            <div>
              <dt>
                Organisasi
              </dt>

              <dd data-drawer-organization-count>
                -
              </dd>
            </div>

            <div>
              <dt>
                Tag
              </dt>

