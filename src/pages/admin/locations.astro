</style>

<script>
  // @ts-nocheck

  const page =
    document.querySelector(
      "[data-locations-page]",
    );

  if (
    !(page instanceof HTMLElement)
  ) {
    throw new Error(
      "BINSIGHT locations admin page root not found.",
    );
  }

  const dataNode =
    document.getElementById(
      "admin-locations-data",
    );

  let locations = [];

  try {
    locations =
      dataNode?.textContent
        ? JSON.parse(
            dataNode.textContent,
          )
        : [];
  } catch {
    locations = [];
  }

  const searchInput =
    page.querySelector(
      "[data-search]",
    );

  const clearSearch =
    page.querySelector(
      "[data-clear-search]",
    );

  const statusFilter =
    page.querySelector(
      "[data-status-filter]",
    );

  const typeFilter =
    page.querySelector(
      "[data-type-filter]",
    );

  const areaFilter =
    page.querySelector(
      "[data-area-filter]",
    );

  const filterToggle =
    page.querySelector(
      "[data-filter-toggle]",
    );

  const filterPanel =
    page.querySelector(
      "[data-filter-panel]",
    );

  const filterClose =
    page.querySelector(
      "[data-filter-close]",
    );

  const filterReset =
    page.querySelector(
      "[data-filter-reset]",
    );

  let rows = Array.from(
    page.querySelectorAll(
      "[data-location-row]",
    ),
  );

  const resultCount =
    page.querySelector(
      "[data-result-count]",
    );

  const footerCount =
    page.querySelector(
      "[data-footer-count]",
    );

  const emptyState =
    page.querySelector(
      "[data-empty-state]",
    );

  const emptyReset =
    page.querySelector(
      "[data-empty-reset]",
    );

  const totalCount =
    page.querySelector(
      "[data-total-count]",
    );

  const activeCount =
    page.querySelector(
      "[data-active-count]",
    );

  const inactiveCount =
    page.querySelector(
      "[data-inactive-count]",
    );

  const linkedCount =
    page.querySelector(
      "[data-linked-count]",
    );

  const drawer =
    page.querySelector(
      "[data-drawer]",
    );

  const drawerBackdrop =
    page.querySelector(
      "[data-drawer-backdrop]",
    );

  const drawerClose =
    page.querySelector(
      "[data-drawer-close]",
    );

  const drawerName =
    page.querySelector(
      "[data-drawer-name]",
    );

  const drawerType =
    page.querySelector(
      "[data-drawer-type]",
    );

  const drawerStatus =
    page.querySelector(
      "[data-drawer-status]",
    );

  const drawerArea =
    page.querySelector(
      "[data-drawer-area]",
    );

  const drawerAddress =
    page.querySelector(
      "[data-drawer-address]",
    );

  const drawerCoordinates =
    page.querySelector(
      "[data-drawer-coordinates]",
    );

  const drawerOrganizationCount =
    page.querySelector(
      "[data-drawer-organization-count]",
    );

  const drawerTags =
    page.querySelector(
      "[data-drawer-tags]",
    );

  const drawerUpdated =
    page.querySelector(
      "[data-drawer-updated]",
    );

  const drawerDescription =
    page.querySelector(
      "[data-drawer-description]",
    );

  const drawerWarning =
    page.querySelector(
      "[data-drawer-warning]",
    );

  const drawerEdit =
    page.querySelector(
      "[data-drawer-edit]",
    );

  const drawerStatusAction =
    page.querySelector(
      "[data-drawer-status-action]",
    );

  const drawerMap =
    page.querySelector(
      "[data-drawer-map]",
    );

  const toast =
    page.querySelector(
      "[data-toast]",
    );

  const toastMessage =
    page.querySelector(
      "[data-toast-message]",
    );

  let selectedLocationId =
    null;

  let toastTimer =
    null;

  let scrollLockCount =
    0;

  let previouslyFocusedElement =
    null;

  function lockPageScroll() {
    scrollLockCount +=
      1;

    if (
      scrollLockCount === 1
    ) {
      document.documentElement.style.overflow =
        "hidden";
    }
  }

  function unlockPageScroll() {
    scrollLockCount =
      Math.max(
        0,
        scrollLockCount - 1,
      );

    if (
      scrollLockCount === 0
    ) {
      document.documentElement.style.overflow =
        "";
    }
  }

  function getLocation(
    id,
  ) {
    return locations.find(
      (location) =>
        location.id === id,
    );
  }

  function updateSummary() {
    const total =
      locations.length;

    const active =
      locations.filter(
        (location) =>
          location.status ===
          "active",
      ).length;

    const inactive =
      locations.filter(
        (location) =>
          location.status ===
          "inactive",
      ).length;

    const linked =
      locations.filter(
        (location) =>
          location.organizationIds.length >
          0,
      ).length;

    if (
      totalCount instanceof HTMLElement
    ) {
      totalCount.textContent =
        String(total);
    }

    if (
      activeCount instanceof HTMLElement
    ) {
      activeCount.textContent =
        String(active);
    }

    if (
      inactiveCount instanceof HTMLElement
    ) {
      inactiveCount.textContent =
        String(inactive);
    }

    if (
      linkedCount instanceof HTMLElement
    ) {
      linkedCount.textContent =
        String(linked);
    }
  }

  function setEmptyState(
    hasResults,
  ) {
    if (
      !(emptyState instanceof HTMLElement)
    ) {
      return;
    }

    const shouldShow =
      !hasResults;

    emptyState.hidden =
      !shouldShow;

    emptyState.setAttribute(
      "aria-hidden",
      shouldShow
        ? "false"
        : "true",
    );

    emptyState.style.display =
      shouldShow
        ? "flex"
        : "none";
  }

  function getVisibleRows() {
    const query =
      searchInput instanceof
      HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const status =
      statusFilter instanceof
      HTMLSelectElement
        ? statusFilter.value
        : "all";

    const type =
      typeFilter instanceof
      HTMLSelectElement
        ? typeFilter.value
        : "all";

    const area =
      areaFilter instanceof
      HTMLSelectElement
        ? areaFilter.value
        : "all";

    return rows.filter(
      (row) => {
        const name =
          row.getAttribute(
            "data-name",
          ) ?? "";

        const rowArea =
          row.getAttribute(
            "data-area",
          ) ?? "";

        const address =
          row.getAttribute(
            "data-address",
          ) ?? "";

        const tags =
          row.getAttribute(
            "data-tags",
          ) ?? "";

        const rowStatus =
          row.getAttribute(
            "data-status",
          ) ?? "";

        const rowType =
          row.getAttribute(
            "data-type",
          ) ?? "";

        const rowAreaId =
          row.getAttribute(
            "data-area-id",
          ) ?? "";

        const matchesSearch =
          query === "" ||
          name.includes(query) ||
          rowArea.includes(query) ||
          address.includes(query) ||
          tags.includes(query);

        const matchesStatus =
          status === "all" ||
          rowStatus === status;

        const matchesType =
          type === "all" ||
          rowType === type;

        const matchesArea =
          area === "all" ||
          rowAreaId === area;

        return (
          matchesSearch &&
          matchesStatus &&
          matchesType &&
          matchesArea
        );
      },
    );
  }

  function applyFilters() {
    const visibleRows =
      getVisibleRows();

    rows.forEach(
      (row) => {
        const visible =
          visibleRows.includes(
            row,
          );

        row.setAttribute(
          "data-hidden",
          visible
            ? "false"
            : "true",
        );

        row.hidden =
          !visible;
      },
    );

    const count =
      visibleRows.length;

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${count} lokasi`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(count);
    }

    setEmptyState(
      count > 0,
    );

    if (
      clearSearch instanceof HTMLButtonElement
    ) {
      const hasSearch =
        searchInput instanceof HTMLInputElement &&
        searchInput.value.length > 0;

      clearSearch.hidden =
        !hasSearch;
    }
  }

  function resetFilters() {
    if (
      searchInput instanceof
      HTMLInputElement
    ) {
      searchInput.value =
        "";
    }

    if (
      statusFilter instanceof
      HTMLSelectElement
    ) {
      statusFilter.value =
        "all";
    }

    if (
      typeFilter instanceof
      HTMLSelectElement
    ) {
      typeFilter.value =
        "all";
    }

    if (
      areaFilter instanceof
      HTMLSelectElement
    ) {
      areaFilter.value =
        "all";
    }

    applyFilters();
  }

  function setFilterPanel(
    open,
  ) {
    if (
      !(filterPanel instanceof
        HTMLElement) ||
      !(filterToggle instanceof
        HTMLButtonElement)
    ) {
      return;
    }

    filterPanel.hidden =
      !open;

    filterToggle.setAttribute(
      "aria-expanded",
      open
        ? "true"
        : "false",
    );
  }

  function setDrawerStatus(
    location,
  ) {
    if (
      !(drawerStatus instanceof
        HTMLElement)
    ) {
      return;
    }

    drawerStatus.className =
      `status-badge status-badge--${location.status}`;

    drawerStatus.innerHTML =
      location.status ===
      "active"
        ? `
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 12 4 4L19 6"/>
          </svg>
          <span>Aktif</span>
        `
        : `
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m10.3 2.6-8.1 14A2 2 0 0 0 4 19.6h16a2 2 0 0 0 1.7-3l-8.1-14a2 2 0 0 0-3.3 0Z"/>
            <path d="M12 9v4"/>
            <path d="M12 17h.01"/>
          </svg>
          <span>Tidak aktif</span>
        `;
  }

  function updateDrawer(
    location,
  ) {
    if (!location) {
      return;
    }

    if (
      drawerName instanceof HTMLElement
    ) {
      drawerName.textContent =
        location.name;
    }

    if (
      drawerType instanceof HTMLElement
    ) {
      drawerType.textContent =
        location.typeLabel ??
        "Lainnya";
    }

    setDrawerStatus(
      location,
    );

    if (
      drawerArea instanceof HTMLElement
    ) {
      drawerArea.textContent =
        location.areaName;
    }

    if (
      drawerAddress instanceof HTMLElement
    ) {
      drawerAddress.textContent =
        location.address;
    }

    if (
      drawerCoordinates instanceof
      HTMLElement
    ) {
      drawerCoordinates.textContent =
        `${location.coordinates.lat.toFixed(6)}, ${location.coordinates.lng.toFixed(6)}`;
    }

    if (
      drawerOrganizationCount instanceof
      HTMLElement
    ) {
      drawerOrganizationCount.textContent =
        `${location.organizationIds.length} organisasi`;
    }

    if (
      drawerTags instanceof
      HTMLElement
    ) {
      drawerTags.textContent =
        location.tags.length > 0
          ? location.tags.join(", ")
          : "Tidak ada tag";
    }

    if (
      drawerUpdated instanceof
      HTMLElement
    ) {
      drawerUpdated.textContent =
        location.updatedAt;
    }

    if (
      drawerDescription instanceof
      HTMLElement
    ) {
      drawerDescription.textContent =
        location.description;
    }

    if (
      drawerWarning instanceof
      HTMLElement
    ) {
      const shouldWarn =
        location.status ===
        "inactive";

      drawerWarning.hidden =
        !shouldWarn;

      drawerWarning.setAttribute(
        "aria-hidden",
        shouldWarn
          ? "false"
          : "true",
      );
    }

    if (
      drawerStatusAction instanceof
      HTMLButtonElement
    ) {
      drawerStatusAction.replaceChildren();

      const label =
        document.createElement(
          "span",
        );

      label.textContent =
        location.status ===
        "active"
          ? "Nonaktifkan"
          : "Aktifkan";

      drawerStatusAction.append(
        label,
      );
    }

    if (
      drawerMap instanceof
      HTMLAnchorElement
    ) {
      drawerMap.href =
        `/map#${location.slug}`;
    }
  }

  function updateRow(
    row,
    location,
  ) {
    if (
      !(row instanceof
        HTMLElement)
    ) {
      return;
    }

    row.setAttribute(
      "data-status",
      location.status,
    );

    row.setAttribute(
      "data-type",
      location.type,
    );

    const statusBadge =
      row.querySelector(
        ".status-badge",
      );

    if (
      statusBadge instanceof HTMLElement
    ) {
      statusBadge.className =
        `status-badge status-badge--${location.status}`;

      statusBadge.innerHTML =
        location.status ===
        "active"
          ? `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 12 4 4L19 6"/>
            </svg>
            <span>Aktif</span>
          `
          : `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m10.3 2.6-8.1 14A2 2 0 0 0 4 19.6h16a2 2 0 0 0 1.7-3l-8.1-14a2 2 0 0 0-3.3 0Z"/>
              <path d="M12 9v4"/>
              <path d="M12 17h.01"/>
            </svg>
            <span>Tidak aktif</span>
          `;
    }

    const icon =
      row.querySelector(
        ".location-cell__icon",
      );

    if (
      icon instanceof HTMLElement
    ) {
      icon.classList.toggle(
        "location-cell__icon--active",
        location.status === "active",
      );
    }
  }

  function openDrawer(
    locationId,
  ) {
    const location =
      getLocation(
        locationId,
      );

    if (
      !location ||
      !(drawer instanceof
        HTMLElement) ||
      !(drawerBackdrop instanceof
        HTMLElement)
    ) {
      return;
    }

    previouslyFocusedElement =
      document.activeElement instanceof
      HTMLElement
        ? document.activeElement
        : null;

    selectedLocationId =
      locationId;

    updateDrawer(
      location,
    );

    drawer.hidden =
      false;

    drawerBackdrop.hidden =
      false;

    lockPageScroll();

    requestAnimationFrame(
      () => {
        drawer.setAttribute(
          "data-open",
          "true",
        );

        drawer.setAttribute(
          "aria-hidden",
          "false",
        );

        if (
          drawerClose instanceof
          HTMLButtonElement
        ) {
          drawerClose.focus();
        }
      },
    );
  }

  function closeDrawer() {
    if (
      !(drawer instanceof
        HTMLElement) ||
      !(drawerBackdrop instanceof
        HTMLElement)
    ) {
      return;
    }

    const wasOpen =
      drawer.getAttribute(
        "data-open",
      ) ===
      "true";

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        if (
          drawer.getAttribute(
            "data-open",
          ) !==
          "true"
        ) {
          drawer.hidden =
            true;

          drawerBackdrop.hidden =
            true;
        }
      },
      190,
    );

    if (wasOpen) {
      unlockPageScroll();
    }

    selectedLocationId =
      null;

    if (
      previouslyFocusedElement instanceof
      HTMLElement
    ) {
      previouslyFocusedElement.focus();

      previouslyFocusedElement =
        null;
    }
  }

  function showToast(
    message,
  ) {
    if (
      !(toast instanceof
        HTMLElement) ||
      !(toastMessage instanceof
        HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden =
      false;

    if (
      toastTimer !== null
    ) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden =
            true;

          toastTimer =
            null;
        },
        2800,
      );
  }

  function refreshLocations() {
    updateSummary();
    applyFilters();

    showToast(
      "Daftar lokasi diperbarui.",
    );
  }

  function createLocation() {
    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-location-create",
      ),
    );

    showToast(
      "Form lokasi baru dipersiapkan.",
    );
  }

  function editLocation(
    id,
  ) {
    const location =
      getLocation(id);

    if (!location) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-location-edit",
        {
          detail: {
            ...location,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk "${location.name}" dipersiapkan.`,
    );
  }

  function toggleSelectedLocationStatus() {
    if (!selectedLocationId) {
      return;
    }

    const location =
      getLocation(
        selectedLocationId,
      );

    if (!location) {
      return;
    }

    location.status =
      location.status ===
      "active"
        ? "inactive"
        : "active";

    location.updatedAt =
      "10 Sep 2026";

    location.statusLabel =
      location.status ===
      "active"
        ? "Aktif"
        : "Tidak aktif";

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) ===
          location.id,
      );

    if (
      row instanceof HTMLElement
    ) {
      updateRow(
        row,
        location,
      );
    }

    updateDrawer(
      location,
    );

    updateSummary();
    applyFilters();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-location-status-change",
        {
          detail: {
            ...location,
          },
        },
      ),
    );

    showToast(
      `"${location.name}" sekarang ${location.statusLabel.toLowerCase()}.`,
    );
  }

  searchInput?.addEventListener(
    "input",
    applyFilters,
  );

  statusFilter?.addEventListener(
    "change",
    applyFilters,
  );

  typeFilter?.addEventListener(
    "change",
    applyFilters,
  );

  areaFilter?.addEventListener(
    "change",
    applyFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof
        HTMLInputElement
      ) {
        searchInput.value =
          "";

        searchInput.focus();
      }

      applyFilters();
    },
  );

  emptyReset?.addEventListener(
    "click",
    resetFilters,
  );

  filterReset?.addEventListener(
    "click",
    () => {
      resetFilters();

      setFilterPanel(
        false,
      );
    },
  );

  filterToggle?.addEventListener(
    "click",
    () => {
      if (
        !(filterToggle instanceof
          HTMLButtonElement)
      ) {
        return;
      }

      const isOpen =
        filterToggle.getAttribute(
          "aria-expanded",
        ) ===
        "true";

      setFilterPanel(
        !isOpen,
      );
    },
  );

  filterClose?.addEventListener(
    "click",
    () => {
      setFilterPanel(
        false,
      );
    },
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editLocation(id);
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerBackdrop?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (
        selectedLocationId
      ) {
        editLocation(
          selectedLocationId,
        );
      }
    },
  );

  drawerStatusAction?.addEventListener(
    "click",
    toggleSelectedLocationStatus,
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      refreshLocations,
    );

  page
    .querySelector(
      "[data-create]",
    )
    ?.addEventListener(
      "click",
      createLocation,
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key !==
        "Escape"
      ) {
        return;
      }

      if (
        drawer instanceof
          HTMLElement &&
        drawer.getAttribute(
          "data-open",
        ) ===
          "true"
      ) {
        closeDrawer();

        return;
      }

      if (
        filterPanel instanceof
          HTMLElement &&
        !filterPanel.hidden
      ) {
        setFilterPanel(
          false,
        );
      }
    },
  );

  window.addEventListener(
    "beforeunload",
    () => {
      document.documentElement.style.overflow =
        "";
    },
  );

  setEmptyState(
    rows.length > 0,
  );

  updateSummary();
  applyFilters();
</script>