---
import {
  ArrowRight,
  CircleCheck,
  Clock3,
  Eye,
  FileText,
  ListFilter,
  MapPin,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  TriangleAlert,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

type ReportStatus =
  | "pending"
  | "verified"
  | "in-progress"
  | "resolved"
  | "rejected";

type ReportPriority =
  | "low"
  | "medium"
  | "high";

type ReportType =
  | "illegal-dumping"
  | "overflowing-waste"
  | "burning-waste"
  | "hazardous-waste"
  | "environmental-pollution"
  | "other";

interface ReportRecord {
  id: string;
  title: string;
  description: string;
  type: ReportType;
  category: string;
  status: ReportStatus;
  priority: ReportPriority;
  areaName: string;
  address: string;
  reporterName: string;
  reporterContact: string;
  createdAt: string;
  updatedAt: string;
}

const reports: ReportRecord[] = [
  {
    id: "report-demo-001",
    title: "Tumpukan sampah di area terbuka",
    description:
      "Laporan masyarakat mengenai tumpukan sampah yang terlihat pada area terbuka.",
    type: "illegal-dumping",
    category: "Sampah campuran",
    status: "pending",
    priority: "high",
    areaName: "Kuta Utara",
    address: "Kuta Utara, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "10 Sep 2026",
    updatedAt: "10 Sep 2026",
  },
  {
    id: "report-demo-002",
    title: "Kontainer sampah meluap",
    description:
      "Laporan mengenai kondisi penampungan yang terlihat melebihi kapasitas.",
    type: "overflowing-waste",
    category: "Sampah campuran",
    status: "verified",
    priority: "medium",
    areaName: "Kuta",
    address: "Kuta, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "9 Sep 2026",
    updatedAt: "9 Sep 2026",
  },
  {
    id: "report-demo-003",
    title: "Pembakaran sampah terbuka",
    description:
      "Laporan aktivitas pembakaran sampah pada ruang terbuka.",
    type: "burning-waste",
    category: "Sampah campuran",
    status: "in-progress",
    priority: "high",
    areaName: "Mengwi",
    address: "Mengwi, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "8 Sep 2026",
    updatedAt: "9 Sep 2026",
  },
  {
    id: "report-demo-004",
    title: "Dugaan pencemaran lingkungan",
    description:
      "Laporan masyarakat mengenai kondisi lingkungan yang perlu diperiksa lebih lanjut.",
    type: "environmental-pollution",
    category: "Pencemaran lingkungan",
    status: "resolved",
    priority: "medium",
    areaName: "Abiansemal",
    address: "Abiansemal, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "6 Sep 2026",
    updatedAt: "8 Sep 2026",
  },
  {
    id: "report-demo-005",
    title: "Temuan material berbahaya",
    description:
      "Laporan mengenai material yang diduga memerlukan penanganan khusus.",
    type: "hazardous-waste",
    category: "Bahan berbahaya",
    status: "rejected",
    priority: "high",
    areaName: "Mengwi",
    address: "Mengwi, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "5 Sep 2026",
    updatedAt: "7 Sep 2026",
  },
];

const statusLabels: Record<
  ReportStatus,
  string
> = {
  pending: "Menunggu",
  verified: "Terverifikasi",
  "in-progress": "Diproses",
  resolved: "Selesai",
  rejected: "Ditolak",
};

const priorityLabels: Record<
  ReportPriority,
  string
> = {
  low: "Rendah",
  medium: "Sedang",
  high: "Tinggi",
};

const typeLabels: Record<
  ReportType,
  string
> = {
  "illegal-dumping": "Pembuangan ilegal",
  "overflowing-waste": "Sampah meluap",
  "burning-waste": "Pembakaran sampah",
  "hazardous-waste": "Sampah berbahaya",
  "environmental-pollution":
    "Pencemaran lingkungan",
  other: "Lainnya",
};

const totalReports = reports.length;

const pendingCount = reports.filter(
  (report) =>
    report.status === "pending",
).length;

const activeCount = reports.filter(
  (report) =>
    report.status === "verified" ||
    report.status === "in-progress",
).length;

const resolvedCount = reports.filter(
  (report) =>
    report.status === "resolved",
).length;

const highPriorityCount = reports.filter(
  (report) =>
    report.priority === "high",
).length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Laporan — Admin BINSIGHT",
  description:
    "Administrasi laporan masyarakat BINSIGHT untuk verifikasi, pemantauan status, dan pengelolaan tindak lanjut.",
  url: "https://binsight.id/admin/reports",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Laporan"
  description="Tinjau, verifikasi, dan monitor laporan masyarakat tentang persampahan."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main
    class="reports-page"
    data-reports-page
  >
    <header class="page-top">
      <div class="page-top__main">
        <div class="page-top__eyebrow">
          <span class="page-top__eyebrow-icon">
            <FileText
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span>
            REPORT MANAGEMENT
          </span>
        </div>

        <h1>
          Laporan
        </h1>

        <p>
          Tinjau laporan masyarakat, periksa informasi, tetapkan prioritas,
          dan pantau status penanganannya dalam satu workspace admin.
        </p>
      </div>

      <div class="page-top__actions">
        <button
          type="button"
          class="button button--secondary"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Refresh
          </span>
        </button>

        <a
          href="/reports"
          class="button button--ghost"
        >
          <Eye
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Lihat publik
          </span>
        </a>

        <a
          href="/reports/create"
          class="button button--primary"
        >
          <Plus
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Buat laporan
          </span>
        </a>
      </div>
    </header>

    <section
      class="summary-grid"
      aria-label="Ringkasan laporan"
    >
      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Total laporan
          </span>

          <span class="summary-card__icon summary-card__icon--green">
            <FileText
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {totalReports}
        </strong>

        <span class="summary-card__meta">
          Record dalam workspace
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Menunggu
          </span>

          <span class="summary-card__icon summary-card__icon--pending">
            <Clock3
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {pendingCount}
        </strong>

        <span class="summary-card__meta">
          Menunggu pemeriksaan admin
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Sedang diproses
          </span>

          <span class="summary-card__icon summary-card__icon--active">
            <Clock3
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {activeCount}
        </strong>

        <span class="summary-card__meta">
          Terverifikasi atau ditindaklanjuti
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Selesai
          </span>

          <span class="summary-card__icon summary-card__icon--resolved">
            <CircleCheck
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {resolvedCount}
        </strong>

        <span class="summary-card__meta">
          Laporan telah diselesaikan
        </span>
      </article>
    </section>

    <section class="priority-strip">
      <div class="priority-strip__icon">
        <TriangleAlert
          size={20}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </div>

      <div class="priority-strip__content">
        <span class="priority-strip__eyebrow">
          PRIORITY WATCH
        </span>

        <strong>
          {highPriorityCount} laporan prioritas tinggi
        </strong>

        <p>
          Prioritas membantu admin menentukan laporan mana yang perlu
          diperiksa terlebih dahulu.
        </p>
      </div>

      <button
        type="button"
        class="priority-strip__action"
        data-high-priority
      >
        Tampilkan prioritas tinggi

        <ArrowRight
          size={15}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </button>
    </section>

    <section class="workspace-card">
      <div class="toolbar">
        <div class="toolbar__search">
          <Search
            size={17}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="report-search"
          >
            Cari laporan
          </label>

          <input
            id="report-search"
            type="search"
            placeholder="Cari judul, wilayah, kategori, atau tipe laporan..."
            autocomplete="off"
            data-search
          />

          <button
            type="button"
            class="toolbar__clear"
            aria-label="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar__filters">
          <label class="filter-control">
            <span class="sr-only">
              Filter status
            </span>

            <select
              aria-label="Filter status"
              data-status-filter
            >
              <option value="all">
                Semua status
              </option>

              {
                Object.entries(statusLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="sr-only">
              Filter prioritas
            </span>

            <select
              aria-label="Filter prioritas"
              data-priority-filter
            >
              <option value="all">
                Semua prioritas
              </option>

              {
                Object.entries(priorityLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="sr-only">
              Filter tipe laporan
            </span>

            <select
              aria-label="Filter tipe laporan"
              data-type-filter
            >
              <option value="all">
                Semua tipe
              </option>

              {
                Object.entries(typeLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <button
            type="button"
            class="filter-button"
            data-filter-toggle
            aria-expanded="false"
          >
            <ListFilter
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <span>
              Filter
            </span>
          </button>
        </div>
      </div>

      <div
        class="filter-panel"
        data-filter-panel
        hidden
      >
        <div class="filter-panel__header">
          <div>
            <span class="filter-panel__eyebrow">
              FILTER DATA
            </span>

            <h2>
              Penyaringan laporan
            </h2>
          </div>

          <button
            type="button"
            class="filter-panel__close"
            aria-label="Tutup filter"
            data-filter-close
          >
            <X
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="filter-panel__body">
          <div class="filter-info">
            <ShieldCheck
              size={17}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <p>
              Laporan adalah masukan masyarakat. Status harus mencerminkan
              hasil pemeriksaan dan tindak lanjut admin, bukan asumsi.
            </p>
          </div>

          <button
            type="button"
            class="filter-reset"
            data-filter-reset
          >
            Reset semua filter
          </button>
        </div>
      </div>

      <div class="table-head">
        <div>
          <span class="table-head__eyebrow">
            REPORT QUEUE
          </span>

          <h2>
            Daftar laporan
          </h2>
        </div>

        <span
          class="result-count"
          data-result-count
        >
          {totalReports} laporan
        </span>
      </div>

      <div class="table-wrap">
        <table class="reports-table">
          <caption class="sr-only">
            Daftar laporan masyarakat BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Laporan
              </th>

              <th scope="col">
                Tipe
              </th>

              <th scope="col">
                Wilayah
              </th>

              <th scope="col">
                Prioritas
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Dibuat
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              reports.map((report) => (
                <tr
                  data-report-row
                  data-id={report.id}
                  data-title={report.title.toLowerCase()}
                  data-description={report.description.toLowerCase()}
                  data-category={report.category.toLowerCase()}
                  data-area={report.areaName.toLowerCase()}
                  data-type={report.type}
                  data-type-label={typeLabels[
                    report.type
                  ].toLowerCase()}
                  data-status={report.status}
                  data-priority={report.priority}
                >
                  <td>
                    <div class="report-cell">
                      <span
                        class:list={[
                          "report-cell__icon",
                          `report-cell__icon--${report.priority}`,
                        ]}
                      >
                        <FileText
                          size={17}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </span>

                      <div class="report-cell__copy">
                        <strong>
                          {report.title}
                        </strong>

                        <span>
                          {report.category}
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>
                    <span class="type-label">
                      {typeLabels[report.type]}
                    </span>
                  </td>

                  <td>
                    <div class="area-cell">
                      <MapPin
                        size={14}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <span>
                        {report.areaName}
                      </span>
                    </div>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "priority-badge",
                        `priority-badge--${report.priority}`,
                      ]}
                    >
                      {report.priority ===
                      "high" ? (
                        <TriangleAlert
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : report.priority ===
                        "medium" ? (
                        <Clock3
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : (
                        <CircleCheck
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      )}

                      <span>
                        {priorityLabels[
                          report.priority
                        ]}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "status-badge",
                        `status-badge--${report.status}`,
                      ]}
                    >
                      {report.status ===
                      "resolved" ? (
                        <CircleCheck
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : report.status ===
                        "in-progress" ? (
                        <Clock3
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : report.status ===
                        "rejected" ? (
                        <TriangleAlert
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : (
                        <ShieldCheck
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      )}

                      <span>
                        {statusLabels[
                          report.status
                        ]}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span class="updated-label">
                      {report.createdAt}
                    </span>
                  </td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Lihat ${report.title}`}
                        data-view
                        data-record={report.id}
                      >
                        <Eye
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>

                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Edit ${report.title}`}
                        data-edit
                        data-record={report.id}
                      >
                        <Pencil
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
        >
          <span class="empty-state__icon">
            <Search
              size={23}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>

          <h3>
            Tidak ada laporan yang cocok
          </h3>

          <p>
            Coba ubah kata pencarian atau filter yang digunakan.
          </p>

          <button
            type="button"
            class="button button--secondary"
            data-empty-reset
          >
            Reset pencarian
          </button>
        </div>
      </div>

      <footer class="table-footer">
        <span>
          <strong data-footer-count>
            {totalReports}
          </strong>
          laporan ditampilkan
        </span>

        <span>
          Data admin
        </span>
      </footer>
    </section>

    <section class="governance-grid">
      <article class="governance-card">
        <div class="governance-card__icon governance-card__icon--green">
          <ShieldCheck
            size={20}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </div>

        <div>
          <span class="governance-card__eyebrow">
            VERIFICATION
          </span>

          <h2>
            Periksa sebelum menetapkan status
          </h2>

          <p>
            Status laporan harus mengikuti hasil pemeriksaan. Laporan
            masyarakat tidak otomatis dianggap benar hanya karena telah
            diterima sistem.
          </p>
        </div>
      </article>

      <article class="governance-card">
        <div class="governance-card__icon governance-card__icon--orange">
          <TriangleAlert
            size={20}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </div>

        <div>
          <span class="governance-card__eyebrow">
            PRIORITY
          </span>

          <h2>
            Prioritas membantu triase
          </h2>

          <p>
            Gunakan prioritas untuk membantu menentukan urutan pemeriksaan
            tanpa mengubah prioritas menjadi ukuran statistik dampak.
          </p>
        </div>
      </article>
    </section>

    <aside
      class="report-drawer"
      data-drawer
      aria-hidden="true"
      hidden
      aria-labelledby="drawer-title"
    >
      <div class="drawer__header">
        <div>
          <span class="drawer__eyebrow">
            REPORT DETAIL
          </span>

          <h2 id="drawer-title">
            Detail laporan
          </h2>
        </div>

        <button
          type="button"
          class="drawer__close"
          aria-label="Tutup detail"
          data-drawer-close
        >
          <X
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />
        </button>
      </div>

      <div class="drawer__body">
        <div class="drawer-identity">
          <span class="drawer-identity__icon">
            <FileText
              size={22}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <div>
            <h3 data-drawer-title>
              -
            </h3>

            <span data-drawer-type>
              -
            </span>
          </div>
        </div>

        <div class="drawer-status-row">
          <span
            class="priority-badge"
            data-drawer-priority
          >
            -
          </span>

          <span
            class="status-badge"
            data-drawer-status
          >
            -
          </span>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            LOKASI
          </span>

          <dl class="detail-list">
            <div>
              <dt>
                Wilayah
              </dt>

              <dd data-drawer-area>
                -
              </dd>
            </div>

            <div>
              <dt>
                Alamat
              </dt>

              <dd data-drawer-address>
                -
              </dd>
            </div>
          </dl>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            LAPORAN
          </span>

          <p
            class="drawer-description"
            data-drawer-description
          >
            -
          </p>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            PELAPOR
          </span>

          <dl class="detail-list">
            <div>
              <dt>
                Nama
              </dt>

              <dd data-drawer-reporter>
                -
              </dd>
            </div>

            <div>
              <dt>
                Kontak
              </dt>

              <dd data-drawer-contact>
                -
              </dd>
