---
import {
  ArrowRight,
  CircleCheck,
  Clock3,
  Eye,
  FileText,
  ListFilter,
  MapPin,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  TriangleAlert,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

type ReportStatus =
  | "pending"
  | "verified"
  | "in-progress"
  | "resolved"
  | "rejected";

type ReportPriority =
  | "low"
  | "medium"
  | "high";

type ReportType =
  | "illegal-dumping"
  | "overflowing-waste"
  | "burning-waste"
  | "hazardous-waste"
  | "environmental-pollution"
  | "other";

interface ReportRecord {
  id: string;
  title: string;
  description: string;
  type: ReportType;
  category: string;
  status: ReportStatus;
  priority: ReportPriority;
  areaName: string;
  address: string;
  reporterName: string;
  reporterContact: string;
  createdAt: string;
  updatedAt: string;
}

const reports: ReportRecord[] = [
  {
    id: "report-demo-001",
    title: "Tumpukan sampah di area terbuka",
    description:
      "Laporan masyarakat mengenai tumpukan sampah yang terlihat pada area terbuka.",
    type: "illegal-dumping",
    category: "Sampah campuran",
    status: "pending",
    priority: "high",
    areaName: "Kuta Utara",
    address: "Kuta Utara, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "10 Sep 2026",
    updatedAt: "10 Sep 2026",
  },
  {
    id: "report-demo-002",
    title: "Kontainer sampah meluap",
    description:
      "Laporan mengenai kondisi penampungan yang terlihat melebihi kapasitas.",
    type: "overflowing-waste",
    category: "Sampah campuran",
    status: "verified",
    priority: "medium",
    areaName: "Kuta",
    address: "Kuta, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "9 Sep 2026",
    updatedAt: "9 Sep 2026",
  },
  {
    id: "report-demo-003",
    title: "Pembakaran sampah terbuka",
    description:
      "Laporan aktivitas pembakaran sampah pada ruang terbuka.",
    type: "burning-waste",
    category: "Sampah campuran",
    status: "in-progress",
    priority: "high",
    areaName: "Mengwi",
    address: "Mengwi, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "8 Sep 2026",
    updatedAt: "9 Sep 2026",
  },
  {
    id: "report-demo-004",
    title: "Dugaan pencemaran lingkungan",
    description:
      "Laporan masyarakat mengenai kondisi lingkungan yang perlu diperiksa lebih lanjut.",
    type: "environmental-pollution",
    category: "Pencemaran lingkungan",
    status: "resolved",
    priority: "medium",
    areaName: "Abiansemal",
    address: "Abiansemal, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "6 Sep 2026",
    updatedAt: "8 Sep 2026",
  },
  {
    id: "report-demo-005",
    title: "Temuan material berbahaya",
    description:
      "Laporan mengenai material yang diduga memerlukan penanganan khusus.",
    type: "hazardous-waste",
    category: "Bahan berbahaya",
    status: "rejected",
    priority: "high",
    areaName: "Mengwi",
    address: "Mengwi, Kabupaten Badung, Bali",
    reporterName: "Warga",
    reporterContact: "Tidak ditampilkan",
    createdAt: "5 Sep 2026",
    updatedAt: "7 Sep 2026",
  },
];

const statusLabels: Record<
  ReportStatus,
  string
> = {
  pending: "Menunggu",
  verified: "Terverifikasi",
  "in-progress": "Diproses",
  resolved: "Selesai",
  rejected: "Ditolak",
};

const priorityLabels: Record<
  ReportPriority,
  string
> = {
  low: "Rendah",
  medium: "Sedang",
  high: "Tinggi",
};

const typeLabels: Record<
  ReportType,
  string
> = {
  "illegal-dumping": "Pembuangan ilegal",
  "overflowing-waste": "Sampah meluap",
  "burning-waste": "Pembakaran sampah",
  "hazardous-waste": "Sampah berbahaya",
  "environmental-pollution":
    "Pencemaran lingkungan",
  other: "Lainnya",
};

const totalReports =
  reports.length;

const pendingCount =
  reports.filter(
    (report) =>
      report.status === "pending",
  ).length;

const activeCount =
  reports.filter(
    (report) =>
      report.status === "verified" ||
      report.status === "in-progress",
  ).length;

const resolvedCount =
  reports.filter(
    (report) =>
      report.status === "resolved",
  ).length;

const highPriorityCount =
  reports.filter(
    (report) =>
      report.priority === "high",
  ).length;

const reportsPayload =
  reports.map((report) => ({
    ...report,
    typeLabel:
      typeLabels[report.type],
    statusLabel:
      statusLabels[report.status],
    priorityLabel:
      priorityLabels[report.priority],
  }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Laporan — Admin BINSIGHT",
  description:
    "Administrasi laporan masyarakat BINSIGHT untuk verifikasi, pemantauan status, dan pengelolaan tindak lanjut.",
  url: "https://binsight.id/admin/reports",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Laporan"
  description="Tinjau, verifikasi, dan monitor laporan masyarakat tentang persampahan."
  activeSection="reports"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main
    class="reports-page"
    data-reports-page
  >
    <script
      id="admin-reports-data"
      type="application/json"
      is:inline
      set:html={JSON.stringify(reportsPayload)}
    />

    <section class="page-intro">
      <div class="page-intro__main">
        <div class="page-intro__eyebrow">
          <span class="page-intro__mark">
            <FileText
              size={15}
              stroke-width={2.2}
              aria-hidden="true"
            />
          </span>

          <span>
            REPORT MANAGEMENT / ADMIN
          </span>
        </div>

        <div class="page-intro__heading-row">
          <div>
            <h1>
              Laporan
            </h1>

            <p>
              Tinjau masukan masyarakat, periksa informasi, tetapkan
              prioritas, dan pantau status tindak lanjut laporan dalam
              satu workspace admin.
            </p>
          </div>

          <div class="page-intro__code">
            <span>
              QUEUE
            </span>

            <strong>
              / REPORTS
            </strong>
          </div>
        </div>
      </div>

      <div class="page-intro__actions">
        <button
          type="button"
          class="button button--light"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2.2}
            aria-hidden="true"
          />

          <span>
            Refresh
          </span>
        </button>

        <a
          href="/reports"
          class="button button--ghost"
        >
          <Eye
            size={16}
            stroke-width={2.1}
            aria-hidden="true"
          />

          <span>
            Lihat publik
          </span>

          <ArrowRight
            size={14}
            stroke-width={2.1}
            aria-hidden="true"
          />
        </a>

        <a
          href="/reports/create"
          class="button button--primary"
        >
          <Plus
            size={17}
            stroke-width={2.2}
            aria-hidden="true"
          />

          <span>
            Buat laporan
          </span>
        </a>
      </div>
    </section>

    <section
      class="summary-grid"
      aria-label="Ringkasan laporan"
    >
      <article class="summary-card summary-card--primary">
        <div class="summary-card__top">
          <div>
            <span class="summary-card__eyebrow">
              TOTAL
            </span>

            <span class="summary-card__label">
              Semua laporan
            </span>
          </div>

          <span class="summary-card__icon">
            <FileText
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-total-count
        >
          {totalReports}
        </strong>

        <span class="summary-card__meta">
          Record dalam workspace
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <div>
            <span class="summary-card__eyebrow">
              PENDING
            </span>

            <span class="summary-card__label">
              Menunggu
            </span>
          </div>

          <span class="summary-card__icon summary-card__icon--orange">
            <Clock3
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-pending-count
        >
          {pendingCount}
        </strong>

        <span class="summary-card__meta">
          Menunggu pemeriksaan admin
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <div>
            <span class="summary-card__eyebrow">
              ACTIVE
            </span>

            <span class="summary-card__label">
              Sedang diproses
            </span>
          </div>

          <span class="summary-card__icon summary-card__icon--blue">
            <Clock3
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-active-count
        >
          {activeCount}
        </strong>

        <span class="summary-card__meta">
          Terverifikasi atau ditindaklanjuti
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <div>
            <span class="summary-card__eyebrow">
              RESOLVED
            </span>

            <span class="summary-card__label">
              Selesai
            </span>
          </div>

          <span class="summary-card__icon summary-card__icon--green">
            <CircleCheck
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-resolved-count
        >
          {resolvedCount}
        </strong>

        <span class="summary-card__meta">
          Laporan telah diselesaikan
        </span>
      </article>
    </section>

    <section
      class="priority-strip"
      aria-label="Laporan prioritas tinggi"
    >
      <div class="priority-strip__mark">
        <TriangleAlert
          size={19}
          stroke-width={2.1}
          aria-hidden="true"
        />
      </div>

      <div class="priority-strip__content">
        <span class="priority-strip__eyebrow">
          PRIORITY WATCH
        </span>

        <strong data-high-priority-count>
          {highPriorityCount} laporan prioritas tinggi
        </strong>

        <p>
          Prioritas membantu admin menentukan urutan pemeriksaan.
        </p>
      </div>

      <button
        type="button"
        class="priority-strip__action"
        data-high-priority
      >
        <span>
          Tampilkan prioritas tinggi
        </span>

        <ArrowRight
          size={15}
          stroke-width={2}
          aria-hidden="true"
        />
      </button>
    </section>

    <section class="directory-card">
      <div class="directory-toolbar">
        <div class="search-box">
          <Search
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="report-search"
          >
            Cari laporan
          </label>

          <input
            id="report-search"
            type="search"
            placeholder="Cari judul, wilayah, kategori, tipe..."
            autocomplete="off"
            spellcheck="false"
            data-search
          />

          <button
            type="button"
            class="search-box__clear"
            aria-label="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar-filters">
          <label class="select-box">
            <span class="sr-only">
              Filter status
            </span>

            <select
              aria-label="Filter status"
              data-status-filter
            >
              <option value="all">
                Semua status
              </option>

              {
                Object.entries(statusLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="select-box">
            <span class="sr-only">
              Filter prioritas
            </span>

            <select
              aria-label="Filter prioritas"
              data-priority-filter
            >
              <option value="all">
                Semua prioritas
              </option>

              {
                Object.entries(priorityLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="select-box">
            <span class="sr-only">
              Filter tipe laporan
            </span>

            <select
              aria-label="Filter tipe laporan"
              data-type-filter
            >
              <option value="all">
                Semua tipe
              </option>

              {
                Object.entries(typeLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <button
            type="button"
            class="filter-toggle"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="report-filter-panel"
          >
            <ListFilter
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Filter
            </span>
          </button>
        </div>
      </div>

      <div
        class="filter-panel"
        id="report-filter-panel"
        data-filter-panel
        hidden
      >
        <div>
          <span class="filter-panel__eyebrow">
            FILTER DATA
          </span>

          <h2>
            Penyaringan laporan
          </h2>
        </div>

        <div class="filter-panel__right">
          <div class="filter-note">
            <ShieldCheck
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <p>
              Laporan masyarakat harus diperlakukan sebagai masukan yang
              perlu diperiksa. Status mencerminkan proses admin, bukan
              asumsi atas kondisi lapangan.
            </p>
          </div>

          <button
            type="button"
            class="filter-reset"
            data-filter-reset
          >
            Reset filter
          </button>

          <button
            type="button"
            class="filter-close"
            aria-label="Tutup filter"
            data-filter-close
          >
            <X
              size={16}
              stroke-width={2.2}
              aria-hidden="true"
            />
          </button>
        </div>
      </div>

      <div class="directory-head">
        <div>
          <span class="directory-head__eyebrow">
            REPORT QUEUE / 01
          </span>

          <h2>
            Daftar laporan
          </h2>
        </div>

        <span
          class="directory-count"
          data-result-count
        >
          {totalReports} laporan
        </span>
      </div>

      <div class="table-scroll">
        <table class="reports-table">
          <caption class="sr-only">
            Daftar laporan masyarakat BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Laporan
              </th>

              <th scope="col">
                Tipe
              </th>

              <th scope="col">
                Wilayah
              </th>

              <th scope="col">
                Prioritas
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Dibuat
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              reports.map((report) => (
                <tr
                  data-report-row
                  data-id={report.id}
                  data-title={report.title.toLowerCase()}
                  data-description={report.description.toLowerCase()}
                  data-category={report.category.toLowerCase()}
                  data-area={report.areaName.toLowerCase()}
                  data-address={report.address.toLowerCase()}
                  data-type={report.type}
                  data-type-label={typeLabels[
                    report.type
                  ].toLowerCase()}
                  data-status={report.status}
                  data-priority={report.priority}
                >
                  <td>
                    <div class="report-cell">
                      <span
                        class:list={[
                          "report-cell__mark",
                          `report-cell__mark--${report.priority}`,
                        ]}
                      >
                        <FileText
                          size={17}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </span>

                      <div class="report-cell__content">
                        <strong>
                          {report.title}
                        </strong>

                        <span>
                          {report.category}
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>
                    <span class="type-label">
                      {typeLabels[report.type]}
                    </span>
                  </td>

                  <td>
                    <div class="area-cell">
                      <MapPin
                        size={14}
                        stroke-width={2}
                        aria-hidden="true"
                      />

                      <span>
                        {report.areaName}
                      </span>
                    </div>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "priority-badge",
                        `priority-badge--${report.priority}`,
                      ]}
                      data-row-priority-badge
                    >
                      {
                        report.priority === "high" ? (
                          <TriangleAlert
                            size={13}
                            stroke-width={2.1}
                            aria-hidden="true"
                          />
                        ) : report.priority ===
                          "medium" ? (
                          <Clock3
                            size={13}
                            stroke-width={2.1}
                            aria-hidden="true"
                          />
                        ) : (
                          <CircleCheck
                            size={13}
                            stroke-width={2.1}
                            aria-hidden="true"
                          />
                        )
                      }

                      <span>
                        {priorityLabels[
                          report.priority
                        ]}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "status-badge",
                        `status-badge--${report.status}`,
                      ]}
                      data-row-status-badge
                    >
                      {
                        report.status === "resolved" ? (
                          <CircleCheck
                            size={13}
                            stroke-width={2.1}
                            aria-hidden="true"
                          />
                        ) : report.status ===
                          "in-progress" ? (
                          <Clock3
                            size={13}
                            stroke-width={2.1}
                            aria-hidden="true"
                          />
                        ) : report.status ===
                          "rejected" ? (
                          <TriangleAlert
                            size={13}
                            stroke-width={2.1}
                            aria-hidden="true"
                          />
                        ) : (
                          <ShieldCheck
                            size={13}
                            stroke-width={2.1}
                            aria-hidden="true"
                          />
                        )
                      }

                      <span>
                        {statusLabels[
                          report.status
                        ]}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span class="date-label">
                      {report.createdAt}
                    </span>
                  </td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Lihat ${report.title}`}
                        data-view
                        data-record={report.id}
                      >
                        <Eye
                          size={15}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </button>

                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Edit ${report.title}`}
                        data-edit
                        data-record={report.id}
                      >
                        <Pencil
                          size={15}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
        >
          <span class="empty-state__mark">
            <Search
              size={22}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span class="empty-state__eyebrow">
            NO MATCH
          </span>

          <h3>
            Tidak ada laporan yang cocok
          </h3>

          <p>
            Ubah kata pencarian atau reset filter laporan.
          </p>

          <button
            type="button"
            class="button button--dark"
            data-empty-reset
          >
            Reset pencarian
          </button>
        </div>
      </div>

      <footer class="directory-footer">
        <span>
          <strong data-footer-count>
            {totalReports}
          </strong>
          laporan ditampilkan
        </span>

        <span>
          BINSIGHT / REPORT QUEUE
        </span>
      </footer>
    </section>

    <section class="governance-grid">
      <article class="governance-card">
        <div class="governance-card__top">
          <span class="governance-card__index">
            A
          </span>

          <ShieldCheck
            size={19}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <span class="governance-card__eyebrow">
          VERIFICATION
        </span>

        <h2>
          Periksa sebelum menetapkan status
        </h2>

        <p>
          Status laporan harus mengikuti hasil pemeriksaan. Laporan
          masyarakat tidak otomatis dianggap benar hanya karena telah
          diterima sistem.
        </p>
      </article>

      <article class="governance-card governance-card--accent">
        <div class="governance-card__top">
          <span class="governance-card__index">
            B
          </span>

          <TriangleAlert
            size={19}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <span class="governance-card__eyebrow">
          PRIORITY
        </span>

        <h2>
          Prioritas membantu triase
        </h2>

        <p>
          Gunakan prioritas untuk menentukan urutan pemeriksaan tanpa
          memperlakukan prioritas sebagai ukuran statistik dampak.
        </p>
      </article>
    </section>

    <aside
      class="report-drawer"
      data-drawer
      aria-hidden="true"
      hidden
      aria-labelledby="drawer-title"
    >
      <div class="drawer-header">
        <div>
          <span class="drawer-header__eyebrow">
            REPORT DETAIL
          </span>

          <h2 id="drawer-title">
            Detail laporan
          </h2>
        </div>

        <button
          type="button"
          class="drawer-close"
          aria-label="Tutup detail"
          data-drawer-close
        >
          <X
            size={18}
            stroke-width={2.2}
