    );

  const drawerTitle =
    page.querySelector(
      "[data-drawer-title]",
    );

  const drawerType =
    page.querySelector(
      "[data-drawer-type]",
    );

  const drawerPriority =
    page.querySelector(
      "[data-drawer-priority]",
    );

  const drawerStatus =
    page.querySelector(
      "[data-drawer-status]",
    );

  const drawerArea =
    page.querySelector(
      "[data-drawer-area]",
    );

  const drawerAddress =
    page.querySelector(
      "[data-drawer-address]",
    );

  const drawerDescription =
    page.querySelector(
