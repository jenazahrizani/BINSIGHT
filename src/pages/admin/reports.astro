    );

  const drawerUpdated =
    page.querySelector(
      "[data-drawer-updated]",
    );

  const drawerEdit =
    page.querySelector(
      "[data-drawer-edit]",
    );

  const drawerAction =
    page.querySelector(
      "[data-drawer-action]",
    );

  const toast =
    page.querySelector(
      "[data-toast]",
    );

  const toastMessage =
    page.querySelector(
      "[data-toast-message]",
    );

  let selectedReportId =
    null;

  let toastTimer =
    null;

  function getReport(id) {
    return reports.find(
      (report) =>
        report.id === id,
    );
  }

  function updateFilters() {
    const query =
      searchInput instanceof
      HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const status =
      statusFilter instanceof
      HTMLSelectElement
        ? statusFilter.value
        : "all";

    const priority =
      priorityFilter instanceof
      HTMLSelectElement
        ? priorityFilter.value
        : "all";

    const type =
      typeFilter instanceof
      HTMLSelectElement
        ? typeFilter.value
        : "all";

    const visibleRows =
      rows.filter(
        (row) => {
          const title =
            row.getAttribute(
              "data-title",
            ) ?? "";

          const description =
            row.getAttribute(
              "data-description",
            ) ?? "";

          const category =
            row.getAttribute(
              "data-category",
            ) ?? "";

          const area =
            row.getAttribute(
              "data-area",
            ) ?? "";

          const typeLabel =
            row.getAttribute(
              "data-type-label",
            ) ?? "";

          const rowType =
            row.getAttribute(
              "data-type",
            ) ?? "";

          const rowStatus =
            row.getAttribute(
              "data-status",
            ) ?? "";

          const rowPriority =
            row.getAttribute(
              "data-priority",
            ) ?? "";

          const matchesSearch =
            query === "" ||
            title.includes(query) ||
            description.includes(query) ||
            category.includes(query) ||
            area.includes(query) ||
            typeLabel.includes(query);

          const matchesStatus =
            status === "all" ||
            rowStatus === status;

          const matchesPriority =
            priority === "all" ||
            rowPriority === priority;

          const matchesType =
            type === "all" ||
            rowType === type;

          return (
            matchesSearch &&
            matchesStatus &&
            matchesPriority &&
            matchesType
          );
        },
      );

    rows.forEach(
      (row) => {
        row.setAttribute(
          "data-hidden",
          visibleRows.includes(
            row,
          )
            ? "false"
            : "true",
        );
      },
    );

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${visibleRows.length} laporan`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(
          visibleRows.length,
        );
    }

    if (
      emptyState instanceof HTMLElement
    ) {
      emptyState.hidden =
        visibleRows.length !== 0;
    }

    if (
      clearSearch instanceof HTMLButtonElement
    ) {
      clearSearch.hidden =
        !(
          searchInput instanceof HTMLInputElement &&
          searchInput.value.length > 0
        );
    }
  }

  function resetFilters() {
    if (
      searchInput instanceof HTMLInputElement
    ) {
      searchInput.value = "";
    }

    if (
      statusFilter instanceof HTMLSelectElement
    ) {
      statusFilter.value =
        "all";
    }

    if (
      priorityFilter instanceof HTMLSelectElement
    ) {
      priorityFilter.value =
        "all";
    }

    if (
      typeFilter instanceof HTMLSelectElement
    ) {
      typeFilter.value =
        "all";
    }

    updateFilters();
  }

  function showToast(
    message,
  ) {
    if (
      !(toast instanceof HTMLElement) ||
      !(toastMessage instanceof HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden =
      false;

    if (
      toastTimer !==
      null
    ) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden =
            true;

          toastTimer =
            null;
        },
        2800,
      );
  }

  function setPriorityBadge(
    element,
    report,
  ) {
    if (
      !(element instanceof HTMLElement)
    ) {
      return;
    }

    element.className =
      `priority-badge priority-badge--${report.priority}`;

    if (
      report.priority ===
      "high"
    ) {
      element.innerHTML = `
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m10.3 2.6-8.1 14A2 2 0 0 0 4 19.6h16a2 2 0 0 0 1.7-3l-8.1-14a2 2 0 0 0-3.3 0Z"/>
          <path d="M12 9v4"/>
          <path d="M12 17h.01"/>
        </svg>
        <span>${report.priorityLabel}</span>
      `;
      return;
    }

    if (
      report.priority ===
      "medium"
    ) {
      element.innerHTML = `
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3 2"/>
        </svg>
        <span>${report.priorityLabel}</span>
      `;
      return;
    }

    element.innerHTML = `
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m5 12 4 4L19 6"/>
      </svg>
      <span>${report.priorityLabel}</span>
    `;
  }

  function setStatusBadge(
    element,
    report,
  ) {
    if (
      !(element instanceof HTMLElement)
    ) {
      return;
    }

    element.className =
      `status-badge status-badge--${report.status}`;

    if (
      report.status ===
      "resolved"
    ) {
      element.innerHTML = `
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m5 12 4 4L19 6"/>
        </svg>
        <span>${report.statusLabel}</span>
      `;
      return;
    }

    if (
      report.status ===
      "in-progress"
    ) {
      element.innerHTML = `
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3 2"/>
        </svg>
        <span>${report.statusLabel}</span>
      `;
      return;
    }

    if (
      report.status ===
      "rejected"
    ) {
      element.innerHTML = `
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m10.3 2.6-8.1 14A2 2 0 0 0 4 19.6h16a2 2 0 0 0 1.7-3l-8.1-14a2 2 0 0 0-3.3 0Z"/>
          <path d="M12 9v4"/>
          <path d="M12 17h.01"/>
        </svg>
        <span>${report.statusLabel}</span>
      `;
      return;
    }

    element.innerHTML = `
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
      <span>${report.statusLabel}</span>
    `;
  }

  function populateDrawer(
    report,
  ) {
    if (!report) {
      return;
    }

    if (
      drawerTitle instanceof HTMLElement
    ) {
      drawerTitle.textContent =
        report.title;
    }

    if (
      drawerType instanceof HTMLElement
    ) {
      drawerType.textContent =
        report.typeLabel;
    }

    setPriorityBadge(
      drawerPriority,
      report,
    );

    setStatusBadge(
      drawerStatus,
      report,
    );

    if (
      drawerArea instanceof HTMLElement
    ) {
      drawerArea.textContent =
        report.areaName;
    }

    if (
      drawerAddress instanceof HTMLElement
    ) {
      drawerAddress.textContent =
        report.address;
    }

    if (
      drawerDescription instanceof HTMLElement
    ) {
      drawerDescription.textContent =
        report.description;
    }

    if (
      drawerReporter instanceof HTMLElement
    ) {
      drawerReporter.textContent =
        report.reporterName;
    }

    if (
      drawerContact instanceof HTMLElement
    ) {
      drawerContact.textContent =
        report.reporterContact;
    }

    if (
      drawerCreated instanceof HTMLElement
    ) {
      drawerCreated.textContent =
        report.createdAt;
    }

    if (
      drawerUpdated instanceof HTMLElement
    ) {
      drawerUpdated.textContent =
        report.updatedAt;
    }

    if (
      drawerAction instanceof HTMLButtonElement
    ) {
      drawerAction.disabled =
        false;

      drawerAction.className =
        "button button--primary";

      if (
        report.status ===
        "pending"
      ) {
        drawerAction.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          <span>Verifikasi</span>
        `;
      } else if (
        report.status ===
        "verified"
      ) {
        drawerAction.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 7v5l3 2"/>
          </svg>
          <span>Mulai proses</span>
        `;
      } else if (
        report.status ===
        "in-progress"
      ) {
        drawerAction.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 12 4 4L19 6"/>
          </svg>
          <span>Tandai selesai</span>
        `;
      } else {
        drawerAction.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
          </svg>
          <span>Tidak ada aksi</span>
        `;

        drawerAction.disabled =
          true;
      }
    }
  }

  function updateRowStatus(
    report,
  ) {
    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) === report.id,
      );

    if (
      !(row instanceof HTMLElement)
    ) {
      return;
    }

    row.setAttribute(
      "data-status",
      report.status,
    );

    const statusBadge =
      row.querySelector(
        ".status-badge",
      );

    setStatusBadge(
      statusBadge,
      report,
    );
  }

  function openDrawer(
    id,
  ) {
    const report =
      getReport(id);

    if (
      !report ||
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    selectedReportId =
      id;

    populateDrawer(
      report,
    );

    drawer.hidden =
      false;

    drawerBackdrop.hidden =
      false;

    window.requestAnimationFrame(
      () => {
        drawer.setAttribute(
          "data-open",
          "true",
        );

        drawer.setAttribute(
          "aria-hidden",
          "false",
        );
      },
    );

    document.documentElement.style.overflow =
      "hidden";
  }

  function closeDrawer() {
    if (
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        drawer.hidden =
          true;

        drawerBackdrop.hidden =
          true;
      },
      190,
    );

    document.documentElement.style.overflow =
      "";

    selectedReportId =
      null;
  }

  function editReport(
    id,
  ) {
    const report =
      getReport(id);

    if (!report) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-report-edit",
        {
          detail: {
            ...report,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk "${report.title}" dipersiapkan.`,
    );
  }

  function updateReportStatus() {
    if (!selectedReportId) {
      return;
    }

    const report =
      getReport(
        selectedReportId,
      );

    if (!report) {
      return;
    }

    if (
      report.status ===
      "pending"
    ) {
      report.status =
        "verified";
    } else if (
      report.status ===
      "verified"
    ) {
      report.status =
        "in-progress";
    } else if (
      report.status ===
      "in-progress"
    ) {
      report.status =
        "resolved";
    } else {
      showToast(
        "Laporan ini tidak memiliki aksi status berikutnya.",
      );

      return;
    }

    report.statusLabel = {
      pending: "Menunggu",
      verified: "Terverifikasi",
      "in-progress": "Diproses",
      resolved: "Selesai",
      rejected: "Ditolak",
    }[
      report.status
    ];

    report.updatedAt =
      "10 Sep 2026";

    updateRowStatus(
      report,
    );

    populateDrawer(
      report,
    );

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-report-status-change",
        {
          detail: {
            ...report,
          },
        },
      ),
    );

    showToast(
      `Status laporan diubah menjadi ${report.statusLabel.toLowerCase()}.`,
    );

    updateFilters();
  }

  function showHighPriority() {
    if (
      priorityFilter instanceof HTMLSelectElement
    ) {
      priorityFilter.value =
        "high";
    }

    updateFilters();

    if (
      priorityFilter instanceof HTMLSelectElement
    ) {
      priorityFilter.focus();
    }
  }

  searchInput?.addEventListener(
    "input",
    updateFilters,
  );

  statusFilter?.addEventListener(
    "change",
    updateFilters,
  );

  priorityFilter?.addEventListener(
    "change",
    updateFilters,
  );

  typeFilter?.addEventListener(
    "change",
    updateFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof HTMLInputElement
      ) {
        searchInput.value =
          "";

        searchInput.focus();
      }

      updateFilters();
    },
  );

  filterReset?.addEventListener(
    "click",
    resetFilters,
  );

  emptyReset?.addEventListener(
    "click",
    resetFilters,
  );

  highPriorityButton?.addEventListener(
    "click",
    showHighPriority,
  );

  filterToggle?.addEventListener(
    "click",
    () => {
      if (
        !(filterToggle instanceof HTMLButtonElement) ||
        !(filterPanel instanceof HTMLElement)
      ) {
        return;
      }

      const isOpen =
        filterToggle.getAttribute(
          "aria-expanded",
        ) === "true";

      filterToggle.setAttribute(
        "aria-expanded",
        isOpen
          ? "false"
          : "true",
      );

      filterPanel.hidden =
        isOpen;
    },
  );

  filterClose?.addEventListener(
    "click",
    () => {
      if (
        filterToggle instanceof HTMLButtonElement &&
        filterPanel instanceof HTMLElement
      ) {
        filterToggle.setAttribute(
          "aria-expanded",
          "false",
        );

        filterPanel.hidden =
          true;
      }
    },
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editReport(id);
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerBackdrop?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (selectedReportId) {
        editReport(
          selectedReportId,
        );
      }
    },
  );

  drawerAction?.addEventListener(
    "click",
    updateReportStatus,
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      () => {
        updateFilters();

        showToast(
          "Data laporan diperbarui.",
        );
      },
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key === "Escape" &&
        drawer instanceof HTMLElement &&
        drawer.getAttribute(
          "data-open",
        ) === "true"
      ) {
        closeDrawer();
      }
    },
  );

  updateFilters();
</script>