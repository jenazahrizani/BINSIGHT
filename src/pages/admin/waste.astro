  function visibilityLabel(
    value,
  ) {
    return (
      {
        public: "Publik",
        private: "Privat",
      }[value] ??
      value
    );
  }

  function getFilteredRows() {
    const query =
      searchInput instanceof HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const category =
      categoryFilter instanceof HTMLSelectElement
        ? categoryFilter.value
        : "all";

    const status =
      statusFilter instanceof HTMLSelectElement
        ? statusFilter.value
        : "all";

    const visibility =
      visibilityFilter instanceof HTMLSelectElement
        ? visibilityFilter.value
        : "all";

    return rows.filter(
      (row) => {
        const name =
          row.getAttribute(
            "data-name",
          ) ?? "";

        const categoryName =
          row.getAttribute(
            "data-category-label",
          ) ?? "";

        const description =
          row.getAttribute(
            "data-description",
          ) ?? "";

        const characteristics =
          row.getAttribute(
            "data-characteristics",
          ) ?? "";

        const methods =
          row.getAttribute(
            "data-methods",
          ) ?? "";

        const rowCategory =
          row.getAttribute(
            "data-category",
          ) ?? "";

        const rowStatus =
          row.getAttribute(
            "data-status",
          ) ?? "";

        const rowVisibility =
          row.getAttribute(
            "data-visibility",
          ) ?? "";

        const matchesQuery =
          query === "" ||
          name.includes(query) ||
          categoryName.includes(query) ||
          description.includes(query) ||
          characteristics.includes(query) ||
          methods.includes(query);

        const matchesCategory =
          category === "all" ||
          rowCategory === category;

        const matchesStatus =
          status === "all" ||
          rowStatus === status;

        const matchesVisibility =
          visibility === "all" ||
          rowVisibility === visibility;

        return (
          matchesQuery &&
          matchesCategory &&
          matchesStatus &&
          matchesVisibility
        );
      },
    );
  }

  function applyFilters() {
    const visibleRows =
      getFilteredRows();

    rows.forEach(
      (row) => {
        row.setAttribute(
          "data-hidden",
          visibleRows.includes(
            row,
          )
            ? "false"
            : "true",
        );
      },
    );

    const count =
      visibleRows.length;

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${count} material`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(count);
    }

    if (
      emptyState instanceof HTMLElement
    ) {
      emptyState.hidden =
        count !== 0;
    }

    if (
      clearSearch instanceof HTMLButtonElement
    ) {
      clearSearch.hidden =
        !(
          searchInput instanceof HTMLInputElement &&
          searchInput.value.length >
            0
        );
    }
  }

  function resetFilters() {
    if (
      searchInput instanceof HTMLInputElement
    ) {
      searchInput.value = "";
    }

    if (
      categoryFilter instanceof HTMLSelectElement
    ) {
      categoryFilter.value =
        "all";
    }

    if (
      statusFilter instanceof HTMLSelectElement
    ) {
      statusFilter.value =
        "all";
    }

    if (
      visibilityFilter instanceof HTMLSelectElement
    ) {
      visibilityFilter.value =
        "all";
    }

    categoryCards.forEach(
      (card) => {
        card.setAttribute(
          "data-selected",
          "false",
        );
      },
    );

    applyFilters();
  }

  function showToast(
    message,
  ) {
    if (
      !(toast instanceof HTMLElement) ||
      !(toastMessage instanceof HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden = false;

    if (
      toastTimer !== null
    ) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden = true;
          toastTimer = null;
        },
        2800,
      );
  }

  function populateDrawer(
    record,
  ) {
    if (!record) {
      return;
    }

    if (
      drawerName instanceof HTMLElement
    ) {
      drawerName.textContent =
        record.name;
    }

    if (
      drawerCategory instanceof HTMLElement
    ) {
      drawerCategory.textContent =
        record.categoryLabel;
    }

    if (
      drawerStatus instanceof HTMLElement
    ) {
      drawerStatus.className =
        `status-badge status-badge--${record.status}`;

      drawerStatus.innerHTML =
        record.status === "active"
          ? `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 12 4 4L19 6"/>
            </svg>
            <span>${statusLabel(record.status)}</span>
          `
          : `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            <span>${statusLabel(record.status)}</span>
          `;
    }

    if (
      drawerVisibility instanceof HTMLElement
    ) {
      drawerVisibility.className =
        record.visibility === "public"
          ? "visibility-badge visibility-badge--public"
          : "visibility-badge visibility-badge--private";

      drawerVisibility.textContent =
        visibilityLabel(
          record.visibility,
        );
    }

    if (
      drawerDescription instanceof HTMLElement
    ) {
      drawerDescription.textContent =
        record.description;
    }

    if (
      drawerCharacteristics instanceof HTMLElement
    ) {
      drawerCharacteristics.innerHTML =
        record.characteristics
          .map(
            (item) =>
              `<span class="tag">${labelForCharacteristic(item)}</span>`,
          )
