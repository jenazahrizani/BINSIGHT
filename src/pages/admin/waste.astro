            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 6h12v12H6z"/>
            </svg>
            <span>Nonaktifkan</span>
          `
          : `
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 12 4 4L19 6"/>
            </svg>
            <span>Aktifkan</span>
          `;
    }
  }

  function openDrawer(
    id,
  ) {
    const record =
      getRecord(id);

    if (
      !record ||
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    selectedId = id;

    populateDrawer(
      record,
    );

    drawer.hidden = false;
    drawerBackdrop.hidden =
      false;

    window.requestAnimationFrame(
      () => {
        drawer.setAttribute(
          "data-open",
          "true",
        );

        drawer.setAttribute(
          "aria-hidden",
          "false",
        );
      },
    );

    document.documentElement.style.overflow =
      "hidden";
  }

  function closeDrawer() {
    if (
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        drawer.hidden = true;
        drawerBackdrop.hidden =
          true;
      },
      190,
    );

    document.documentElement.style.overflow =
      "";

    selectedId = null;
  }

  function toggleSelectedStatus() {
    if (!selectedId) {
      return;
    }

    const record =
      getRecord(
        selectedId,
      );

    if (!record) {
      return;
    }

    record.status =
      record.status === "active"
        ? "archived"
        : "active";

    populateDrawer(
      record,
    );

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) ===
          selectedId,
      );

    if (
      row instanceof HTMLElement
    ) {
      const statusBadge =
        row.querySelector(
          ".status-badge",
        );

      if (
        statusBadge instanceof HTMLElement
      ) {
        statusBadge.className =
          `status-badge status-badge--${record.status}`;

        statusBadge.textContent =
          statusLabel(
            record.status,
          );
      }

      row.setAttribute(
        "data-status",
        record.status,
      );
    }

    applyFilters();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-waste-status-change",
        {
          detail: {
            ...record,
          },
        },
      ),
    );

    showToast(
      `${record.name} sekarang ${statusLabel(record.status).toLowerCase()}.`,
    );
  }

  function editRecord(
    id,
  ) {
    const record =
      getRecord(id);

    if (!record) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-waste-edit",
        {
          detail: {
            ...record,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk ${record.name} dipersiapkan.`,
    );
  }

  function createRecord() {
    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-waste-create",
      ),
    );

    showToast(
      "Form material baru dipersiapkan.",
    );
  }

  searchInput?.addEventListener(
    "input",
    applyFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof HTMLInputElement
      ) {
        searchInput.value = "";
        searchInput.focus();
      }

      applyFilters();
    },
  );

  categoryFilter?.addEventListener(
    "change",
    applyFilters,
  );

  statusFilter?.addEventListener(
    "change",
    applyFilters,
  );

  visibilityFilter?.addEventListener(
    "change",
    applyFilters,
  );

  filterToggle?.addEventListener(
    "click",
    () => {
      if (
        !(filterToggle instanceof HTMLButtonElement) ||
        !(filterPanel instanceof HTMLElement)
      ) {
        return;
      }

      const open =
        filterToggle.getAttribute(
          "aria-expanded",
        ) === "true";

      filterToggle.setAttribute(
        "aria-expanded",
        open
          ? "false"
          : "true",
      );

      filterPanel.hidden =
        open;
    },
  );

  filterClose?.addEventListener(
    "click",
    () => {
      if (
        filterToggle instanceof HTMLButtonElement &&
        filterPanel instanceof HTMLElement
      ) {
        filterToggle.setAttribute(
          "aria-expanded",
          "false",
        );

        filterPanel.hidden =
          true;
      }
    },
  );

  filterReset?.addEventListener(
    "click",
    resetFilters,
  );

  emptyReset?.addEventListener(
    "click",
    resetFilters,
  );

  categoryCards.forEach(
    (card) => {
      card.addEventListener(
        "click",
        () => {
          const category =
            card.getAttribute(
              "data-category",
            );

          if (
            !category ||
            !(categoryFilter instanceof
              HTMLSelectElement)
          ) {
            return;
          }

          const alreadySelected =
            card.getAttribute(
              "data-selected",
            ) === "true";

          categoryCards.forEach(
            (candidate) => {
              candidate.setAttribute(
                "data-selected",
                "false",
              );
            },
          );

          categoryFilter.value =
            alreadySelected
              ? "all"
              : category;

          if (!alreadySelected) {
            card.setAttribute(
              "data-selected",
              "true",
            );
          }

          applyFilters();
        },
      );
    },
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editRecord(id);
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerBackdrop?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (selectedId) {
        editRecord(
          selectedId,
        );
      }
    },
  );

  drawerStatusAction?.addEventListener(
    "click",
    toggleSelectedStatus,
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      () => {
        applyFilters();

        showToast(
          "Taxonomy diperbarui.",
        );
      },
    );

  page
    .querySelector(
      "[data-create]",
    )
    ?.addEventListener(
      "click",
      createRecord,
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key === "Escape" &&
        drawer instanceof HTMLElement &&
        drawer.getAttribute(
          "data-open",
        ) === "true"
      ) {
        closeDrawer();
      }
    },
  );

  applyFilters();
</script>