---
import {
  ArrowRight,
  CircleCheck,
  Eye,
  Filter,
  Leaf,
  Package,
  Pencil,
  Plus,
  RefreshCw,
  Recycle,
  Search,
  ShieldCheck,
  TriangleAlert,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

import {
  WASTE_CATEGORIES,
  WASTE_MATERIALS,
  WASTE_METHOD_LABELS,
  WASTE_CHARACTERISTIC_LABELS,
  WASTE_STATUS_LABELS,
  WASTE_VISIBILITY_LABELS,
  type WasteCategory,
  type WasteMaterial,
  type WasteStatus,
  type WasteVisibility,
} from "../../lib/constants/waste";

interface WasteRecord {
  id: WasteMaterial;
  name: string;
  category: WasteCategory;
  description: string;
  characteristics: readonly string[];
  methods: readonly string[];
  status: WasteStatus;
  visibility: WasteVisibility;
}

const categoryMap = new Map(
  WASTE_CATEGORIES.map((category) => [
    category.id,
    category,
  ]),
);

const wasteRecords: WasteRecord[] =
  WASTE_MATERIALS.map((material) => ({
    id: material.id,
    name: material.label,
    category: material.category,
    description: material.description,
    characteristics: material.characteristics,
    methods: material.recommendedMethods,
    status: "active",
    visibility: "public",
  }));

const categoryCounts = WASTE_CATEGORIES.map(
  (category) => ({
    ...category,
    count: wasteRecords.filter(
      (material) =>
        material.category === category.id,
    ).length,
  }),
);

const activeCount = wasteRecords.filter(
  (material) =>
    material.status === "active",
).length;

const draftCount = wasteRecords.filter(
  (material) =>
    material.status === "draft",
).length;

const archivedCount = wasteRecords.filter(
  (material) =>
    material.status === "archived",
).length;

const publicCount = wasteRecords.filter(
  (material) =>
    material.visibility === "public",
).length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Jenis Sampah — Admin BINSIGHT",
  description:
    "Administrasi taxonomy jenis sampah, material, karakteristik, dan metode pengelolaan BINSIGHT.",
  url: "https://binsight.id/admin/waste",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Jenis Sampah"
  description="Kelola taxonomy material, kategori, karakteristik, dan metode pengelolaan BINSIGHT."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main
    class="waste-page"
    data-waste-page
  >
    <header class="page-top">
      <div class="page-top__main">
        <div class="page-top__eyebrow">
          <span class="page-top__eyebrow-icon">
            <Recycle
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span>
            WASTE TAXONOMY
          </span>
        </div>

        <h1>
          Jenis sampah
        </h1>

        <p>
          Kelola vocabulary dan taxonomy sampah yang digunakan bersama oleh
          halaman publik, organisasi, laporan, peta, dan dashboard BINSIGHT.
        </p>
      </div>

      <div class="page-top__actions">
        <button
          type="button"
          class="button button--secondary"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Refresh
          </span>
        </button>

        <a
          href="/waste"
          class="button button--ghost"
        >
          <Eye
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Lihat publik
          </span>
        </a>

        <button
          type="button"
          class="button button--primary"
          data-create
        >
          <Plus
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Tambah material
          </span>
        </button>
      </div>
    </header>

    <section
      class="summary-grid"
      aria-label="Ringkasan taxonomy sampah"
    >
      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Total material
          </span>

          <span class="summary-card__icon summary-card__icon--green">
            <Package
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {wasteRecords.length}
        </strong>

        <span class="summary-card__meta">
          Material dalam taxonomy
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Kategori
          </span>

          <span class="summary-card__icon summary-card__icon--blue">
            <Recycle
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {WASTE_CATEGORIES.length}
        </strong>

        <span class="summary-card__meta">
          Kelompok utama taxonomy
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Aktif
          </span>

          <span class="summary-card__icon summary-card__icon--verified">
            <CircleCheck
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-active-count
        >
          {activeCount}
        </strong>

        <span class="summary-card__meta">
          Material aktif
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Publik
          </span>

          <span class="summary-card__icon summary-card__icon--public">
            <Eye
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-public-count
        >
          {publicCount}
        </strong>

        <span class="summary-card__meta">
          Material dengan visibility publik
        </span>
      </article>
    </section>

    <section
      class="category-overview"
      aria-labelledby="category-overview-title"
    >
      <div class="section-heading">
        <div>
          <span class="section-heading__eyebrow">
            TAXONOMY
          </span>

          <h2 id="category-overview-title">
            Kategori material
          </h2>

          <p>
            Kategori berikut berasal langsung dari taxonomy BINSIGHT.
          </p>
        </div>
      </div>

      <div class="category-grid">
        {
          categoryCounts.map((category) => (
            <button
              type="button"
              class="category-card"
              data-category-card
              data-category={category.id}
              style={`--category-color:${category.color};--category-soft:${category.softColor};`}
            >
              <span class="category-card__top">
                <span class="category-card__icon">
                  {
                    category.id ===
                    "organic" ? (
                      <Leaf
                        size={18}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />
                    ) : category.id ===
                      "inorganic" ? (
                      <Package
                        size={18}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />
                    ) : category.id ===
                      "hazardous" ? (
                      <TriangleAlert
                        size={18}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />
                    ) : category.id ===
                      "electronic" ? (
                      <Package
                        size={18}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />
                    ) : (
                      <Recycle
                        size={18}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />
                    )
                  }
                </span>

                <span class="category-card__count">
                  {category.count}
                </span>
              </span>

              <strong>
                {category.label}
              </strong>

              <span>
                {category.description}
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="workspace-card">
      <div class="toolbar">
        <div class="toolbar__search">
          <Search
            size={17}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="waste-search"
          >
            Cari material
          </label>

          <input
            id="waste-search"
            type="search"
            placeholder="Cari material, kategori, karakteristik, atau metode..."
            autocomplete="off"
            data-search
          />

          <button
            type="button"
            class="toolbar__clear"
            aria-label="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar__filters">
          <label class="filter-control">
            <span class="sr-only">
              Filter kategori
            </span>

            <select
              aria-label="Filter kategori"
              data-category-filter
            >
              <option value="all">
                Semua kategori
              </option>

              {
                WASTE_CATEGORIES.map(
                  (category) => (
                    <option value={category.id}>
                      {category.label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="sr-only">
              Filter status
            </span>

            <select
              aria-label="Filter status"
              data-status-filter
            >
              <option value="all">
                Semua status
              </option>

              {
                Object.entries(
                  WASTE_STATUS_LABELS,
                ).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="sr-only">
              Filter visibility
            </span>

            <select
              aria-label="Filter visibility"
              data-visibility-filter
            >
              <option value="all">
                Semua visibility
              </option>

              {
                Object.entries(
                  WASTE_VISIBILITY_LABELS,
                ).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <button
            type="button"
            class="filter-button"
            data-filter-toggle
            aria-expanded="false"
          >
            <Filter
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <span>
              Filter
            </span>
          </button>
        </div>
      </div>

      <div
        class="filter-panel"
        data-filter-panel
        hidden
      >
        <div class="filter-panel__header">
          <div>
            <span class="filter-panel__eyebrow">
              FILTER DATA
            </span>

            <h2>
              Penyaringan taxonomy
            </h2>
          </div>

          <button
            type="button"
            class="filter-panel__close"
            aria-label="Tutup filter"
            data-filter-close
          >
            <X
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="filter-panel__body">
          <div class="filter-info">
            <ShieldCheck
              size={17}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <p>
              Gunakan taxonomy ini sebagai vocabulary bersama. Jangan
              menambahkan angka tonase atau statistik yang tidak berasal dari
              data operasional.
            </p>
          </div>

          <button
            type="button"
            class="filter-reset"
            data-filter-reset
          >
            Reset semua filter
          </button>
        </div>
      </div>

      <div class="table-head">
        <div>
          <span class="table-head__eyebrow">
            MATERIAL DIRECTORY
          </span>

          <h2>
            Daftar material
          </h2>
        </div>

        <span
          class="result-count"
          data-result-count
        >
          {wasteRecords.length} material
        </span>
      </div>

      <div class="table-wrap">
        <table class="waste-table">
          <caption class="sr-only">
            Daftar material taxonomy BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Material
              </th>

              <th scope="col">
                Kategori
              </th>

              <th scope="col">
                Karakteristik
              </th>

              <th scope="col">
                Metode
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Visibility
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              wasteRecords.map((material) => {
                const category =
                  categoryMap.get(
                    material.category,
                  );

                return (
                  <tr
                    data-waste-row
                    data-id={material.id}
                    data-name={material.name.toLowerCase()}
                    data-category={material.category}
                    data-category-label={category?.label.toLowerCase() ?? ""}
                    data-description={material.description.toLowerCase()}
                    data-characteristics={material.characteristics
                      .map(
                        (item) =>
                          WASTE_CHARACTERISTIC_LABELS[
                            item as keyof typeof WASTE_CHARACTERISTIC_LABELS
                          ] ?? item,
                      )
                      .join(" ")
                      .toLowerCase()}
                    data-methods={material.methods
                      .map(
                        (item) =>
                          WASTE_METHOD_LABELS[
                            item as keyof typeof WASTE_METHOD_LABELS
                          ] ?? item,
                      )
                      .join(" ")
                      .toLowerCase()}
                    data-status={material.status}
                    data-visibility={material.visibility}
                  >
                    <td>
                      <div class="material-cell">
                        <span
                          class="material-cell__icon"
                          style={`--material-color:${category?.color ?? "#166534"};--material-soft:${category?.softColor ?? "#DCFCE7"};`}
                        >
                          {
                            material.category ===
                            "organic" ? (
                              <Leaf
                                size={17}
                                stroke-width={1.9}
                                aria-hidden="true"
                              />
                            ) : material.category ===
                              "hazardous" ? (
                              <TriangleAlert
                                size={17}
                                stroke-width={1.9}
                                aria-hidden="true"
                              />
                            ) : (
                              <Recycle
                                size={17}
                                stroke-width={1.9}
                                aria-hidden="true"
                              />
                            )
                          }
                        </span>

                        <div class="material-cell__copy">
                          <strong>
                            {material.name}
                          </strong>

                          <span>
                            {material.description}
                          </span>
                        </div>
                      </div>
                    </td>

                    <td>
                      <span
                        class="category-badge"
                        style={`--category-color:${category?.color ?? "#166534"};--category-soft:${category?.softColor ?? "#DCFCE7"};`}
                      >
                        {category?.shortLabel ??
                          material.category}
                      </span>
                    </td>

                    <td>
                      <div class="tag-list">
                        {
                          material.characteristics
                            .slice(0, 2)
                            .map((characteristic) => (
                              <span class="tag">
                                {
                                  WASTE_CHARACTERISTIC_LABELS[
                                    characteristic as keyof typeof WASTE_CHARACTERISTIC_LABELS
                                  ] ??
                                    characteristic
                                }
                              </span>
                            ))
                        }

                        {
                          material.characteristics.length >
                            2 && (
                            <span class="tag tag--more">
                              +
                              {material.characteristics.length -
                                2}
                            </span>
                          )
                        }
                      </div>
                    </td>

                    <td>
                      <div class="tag-list">
                        {
                          material.methods
                            .slice(0, 2)
                            .map((method) => (
                              <span class="tag">
                                {
                                  WASTE_METHOD_LABELS[
                                    method as keyof typeof WASTE_METHOD_LABELS
                                  ] ??
                                    method
                                }
                              </span>
                            ))
                        }

                        {
                          material.methods.length >
                            2 && (
                            <span class="tag tag--more">
                              +
                              {material.methods.length -
                                2}
                            </span>
                          )
                        }
                      </div>
                    </td>

                    <td>
                      <span
                        class:list={[
                          "status-badge",
                          `status-badge--${material.status}`,
                        ]}
                      >
                        {material.status ===
                        "active" ? (
                          <CircleCheck
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : material.status ===
                          "draft" ? (
                          <ShieldCheck
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        ) : (
                          <TriangleAlert
                            size={13}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        )}

                        <span>
                          {WASTE_STATUS_LABELS[
                            material.status
                          ]}
                        </span>
                      </span>
                    </td>

                    <td>
                      <span
                        class:list={[
                          "visibility-badge",
                          material.visibility ===
                          "public"
                            ? "visibility-badge--public"
                            : "visibility-badge--private",
                        ]}
                      >
                        {WASTE_VISIBILITY_LABELS[
                          material.visibility
                        ]}
                      </span>
                    </td>

                    <td>
                      <div class="row-actions">
                        <button
                          type="button"
                          class="row-action"
                          aria-label={`Lihat ${material.name}`}
                          data-view
                          data-record={material.id}
                        >
                          <Eye
                            size={15}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </button>

                        <button
                          type="button"
                          class="row-action"
                          aria-label={`Edit ${material.name}`}
                          data-edit
                          data-record={material.id}
                        >
                          <Pencil
                            size={15}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
        >
          <span class="empty-state__icon">
            <Search
              size={23}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>

          <h3>
            Tidak ada material yang cocok
          </h3>

          <p>
            Coba ubah kata pencarian atau filter yang digunakan.
          </p>

          <button
            type="button"
            class="button button--secondary"
            data-empty-reset
          >
            Reset pencarian
          </button>
        </div>
      </div>

      <footer class="table-footer">
        <span>
          <strong data-footer-count>
            {wasteRecords.length}
          </strong>
          material ditampilkan
        </span>

        <span>
          Taxonomy BINSIGHT
        </span>
      </footer>
    </section>

    <section class="governance-grid">
      <article class="governance-card">
        <div class="governance-card__icon governance-card__icon--green">
          <ShieldCheck
            size={20}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </div>

        <div>
          <span class="governance-card__eyebrow">
            SINGLE SOURCE OF TRUTH
          </span>

          <h2>
            Taxonomy harus konsisten
          </h2>

          <p>
            Kategori, material, karakteristik, dan metode dipakai lintas
            halaman. Perubahan vocabulary sebaiknya dilakukan dari sumber
            taxonomy, bukan dengan membuat label lokal yang berbeda.
          </p>
        </div>
      </article>

      <article class="governance-card">
        <div class="governance-card__icon governance-card__icon--blue">
          <CircleCheck
            size={20}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </div>

        <div>
          <span class="governance-card__eyebrow">
            DATA QUALITY
          </span>

          <h2>
            Vocabulary ≠ statistik
          </h2>

          <p>
            Halaman ini mengelola definisi dan klasifikasi. Statistik
            operasional, jumlah laporan, atau data volume harus berasal dari
            data aktual, bukan dari file taxonomy.
          </p>
        </div>
      </article>
    </section>

    <aside
      class="waste-drawer"
      data-drawer
      aria-hidden="true"
      hidden
      aria-labelledby="drawer-title"
    >
      <div class="drawer__header">
        <div>
          <span class="drawer__eyebrow">
            MATERIAL DETAIL
          </span>

          <h2 id="drawer-title">
            Detail material
          </h2>
        </div>

        <button
          type="button"
          class="drawer__close"
          aria-label="Tutup detail"
          data-drawer-close
        >
          <X
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />
        </button>
      </div>

      <div class="drawer__body">
        <div class="drawer-identity">
          <span
            class="drawer-identity__icon"
            data-drawer-icon
          >
            <Recycle
              size={22}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <div>
            <h3 data-drawer-name>
              -
            </h3>

            <span data-drawer-category>
              -
            </span>
          </div>
        </div>

        <div class="drawer-status-row">
          <span
            class="status-badge"
            data-drawer-status
          >
            -
          </span>

          <span
            class="visibility-badge"
            data-drawer-visibility
          >
            -
          </span>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            DESKRIPSI
          </span>

          <p
            class="drawer-description"
            data-drawer-description
          >
            -
          </p>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            KARAKTERISTIK
          </span>

          <div
            class="drawer-tags"
            data-drawer-characteristics
          ></div>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            METODE PENGELOLAAN
          </span>

          <div
            class="drawer-tags"
            data-drawer-methods
          ></div>
        </div>

        <div
          class="drawer-warning"
          data-drawer-warning
          hidden
        >
          <TriangleAlert
            size={17}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <p>
            Material ini tidak aktif. Periksa kembali definisi dan
            penggunaannya sebelum dipublikasikan.
          </p>
        </div>
      </div>

      <div class="drawer__footer">
        <button
          type="button"
          class="button button--secondary"
          data-drawer-edit
        >
          <Pencil
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <span>
            Edit
          </span>
        </button>

        <button
          type="button"
          class="button button--primary"
          data-drawer-status
          data-drawer-status-action
        >
