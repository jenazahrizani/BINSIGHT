</style>

<script>
  // @ts-nocheck

  const page =
    document.querySelector(
      "[data-waste-page]",
    );

  if (!(page instanceof HTMLElement)) {
    throw new Error(
      "BINSIGHT waste admin page root not found.",
    );
  }

  const dataNode =
    page.querySelector(
      "#admin-waste-data",
    );

  let records = [];

  try {
    records = JSON.parse(
      dataNode?.textContent ?? "[]",
    );
  } catch (error) {
    console.error(
      "Failed to parse BINSIGHT waste taxonomy data.",
      error,
    );

    records = [];
  }

  const searchInput =
    page.querySelector(
      "[data-search]",
    );

  const clearSearch =
    page.querySelector(
      "[data-clear-search]",
    );

  const categoryFilter =
    page.querySelector(
      "[data-category-filter]",
    );

  const statusFilter =
    page.querySelector(
      "[data-status-filter]",
    );

  const visibilityFilter =
    page.querySelector(
      "[data-visibility-filter]",
    );

  const resultCount =
    page.querySelector(
      "[data-result-count]",
    );

  const footerCount =
    page.querySelector(
      "[data-footer-count]",
    );

  const activeCountNode =
    page.querySelector(
      "[data-active-count]",
    );

  const publicCountNode =
    page.querySelector(
      "[data-public-count]",
    );

  const emptyState =
    page.querySelector(
      "[data-empty-state]",
    );

  const filterToggle =
    page.querySelector(
      "[data-filter-toggle]",
    );

  const filterPanel =
    page.querySelector(
      "[data-filter-panel]",
    );

  const filterClose =
    page.querySelector(
      "[data-filter-close]",
    );

  const filterReset =
    page.querySelector(
      "[data-filter-reset]",
    );

  const emptyReset =
    page.querySelector(
      "[data-empty-reset]",
    );

  const categoryCards =
    Array.from(
      page.querySelectorAll(
        "[data-category-card]",
      ),
    );

  const rows =
    Array.from(
      page.querySelectorAll(
        "[data-waste-row]",
      ),
    );

  const drawer =
    page.querySelector(
      "[data-drawer]",
    );

  const drawerBackdrop =
    page.querySelector(
      "[data-drawer-backdrop]",
    );

  const drawerClose =
    page.querySelector(
      "[data-drawer-close]",
    );

  const drawerName =
    page.querySelector(
      "[data-drawer-name]",
    );

  const drawerCategory =
    page.querySelector(
      "[data-drawer-category]",
    );

  const drawerStatus =
    page.querySelector(
      "[data-drawer-status]",
    );

  const drawerVisibility =
    page.querySelector(
      "[data-drawer-visibility]",
    );

  const drawerDescription =
    page.querySelector(
      "[data-drawer-description]",
    );

  const drawerCharacteristics =
    page.querySelector(
      "[data-drawer-characteristics]",
    );

  const drawerMethods =
    page.querySelector(
      "[data-drawer-methods]",
    );

  const drawerWarning =
    page.querySelector(
      "[data-drawer-warning]",
    );

  const drawerEdit =
    page.querySelector(
      "[data-drawer-edit]",
    );

  const drawerStatusAction =
    page.querySelector(
      "[data-drawer-status-action]",
    );

  const drawerIcon =
    page.querySelector(
      "[data-drawer-icon]",
    );

  const toast =
    page.querySelector(
      "[data-toast]",
    );

  const toastMessage =
    page.querySelector(
      "[data-toast-message]",
    );

  let selectedId = null;
  let activeTrigger = null;
  let toastTimer = null;

  const characteristicLabels = {
    biodegradable: "Mudah terurai",
    recyclable: "Dapat didaur ulang",
    recoverable:
      "Dapat dipulihkan / dimanfaatkan",
    residual: "Residu",
    hazardous: "Berbahaya",
    "special-handling":
      "Perlu penanganan khusus",
    "valuable-material":
      "Memiliki nilai material",
    reusable: "Guna ulang",
  };

  const methodLabels = {
    reduce: "Mengurangi",
    reuse: "Guna ulang",
    recycle: "Daur ulang",
    compost: "Pengomposan",
    recovery: "Pemulihan material",
    sorting: "Pemilahan",
    collection: "Pengumpulan",
    processing: "Pengolahan",
    storage: "Penyimpanan",
    treatment:
      "Penanganan / pengolahan khusus",
    disposal: "Pembuangan akhir",
    "special-handling":
      "Penanganan khusus",
  };

  const statusLabels = {
    active: "Aktif",
    draft: "Draft",
    archived: "Arsip",
  };

  const visibilityLabels = {
    public: "Publik",
    private: "Privat",
  };

  const categoryColorMap = {
    organic: {
      color: "#4d7c0f",
      soft: "#efff70",
    },
    inorganic: {
      color: "#2563eb",
      soft: "#dce8ff",
    },
    hazardous: {
      color: "#c2410c",
      soft: "#ffe0ce",
    },
    electronic: {
      color: "#6d28d9",
      soft: "#eadcff",
    },
    residual: {
      color: "#5f6360",
      soft: "#e4e2da",
    },
  };

  function getRecord(id) {
    return records.find(
      (record) =>
        record.id === id,
    );
  }

  function labelForCharacteristic(
    value,
  ) {
    return (
      characteristicLabels[value] ??
      value
    );
  }

  function labelForMethod(
    value,
  ) {
    return (
      methodLabels[value] ??
      value
    );
  }

  function labelForStatus(
    value,
  ) {
    return (
      statusLabels[value] ??
      value
    );
  }

  function labelForVisibility(
    value,
  ) {
    return (
      visibilityLabels[value] ??
      value
    );
  }

  function getFilteredRows() {
    const query =
      searchInput instanceof HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const category =
      categoryFilter instanceof HTMLSelectElement
        ? categoryFilter.value
        : "all";

    const status =
      statusFilter instanceof HTMLSelectElement
        ? statusFilter.value
        : "all";

    const visibility =
      visibilityFilter instanceof HTMLSelectElement
        ? visibilityFilter.value
        : "all";

    return rows.filter(
      (row) => {
        const name =
          row.getAttribute(
            "data-name",
          ) ?? "";

        const categoryLabel =
          row.getAttribute(
            "data-category-label",
          ) ?? "";

        const description =
          row.getAttribute(
            "data-description",
          ) ?? "";

        const characteristics =
          row.getAttribute(
            "data-characteristics",
          ) ?? "";

        const methods =
          row.getAttribute(
            "data-methods",
          ) ?? "";

        const rowCategory =
          row.getAttribute(
            "data-category",
          ) ?? "";

        const rowStatus =
          row.getAttribute(
            "data-status",
          ) ?? "";

        const rowVisibility =
          row.getAttribute(
            "data-visibility",
          ) ?? "";

        const matchesQuery =
          query === "" ||
          name.includes(query) ||
          categoryLabel.includes(query) ||
          description.includes(query) ||
          characteristics.includes(query) ||
          methods.includes(query);

        const matchesCategory =
          category === "all" ||
          rowCategory === category;

        const matchesStatus =
          status === "all" ||
          rowStatus === status;

        const matchesVisibility =
          visibility === "all" ||
          rowVisibility === visibility;

        return (
          matchesQuery &&
          matchesCategory &&
          matchesStatus &&
          matchesVisibility
        );
      },
    );
  }

  function setEmptyState(
    hasResults,
  ) {
    if (!(emptyState instanceof HTMLElement)) {
      return;
    }

    const shouldShow =
      !hasResults;

    emptyState.hidden =
      !shouldShow;

    emptyState.setAttribute(
      "aria-hidden",
      shouldShow
        ? "false"
        : "true",
    );

    emptyState.style.display =
      shouldShow
        ? "flex"
        : "none";
  }

  function updateSummary() {
    const activeCount =
      records.filter(
        (record) =>
          record.status === "active",
      ).length;

    const publicCount =
      records.filter(
        (record) =>
          record.visibility === "public",
      ).length;

    if (
      activeCountNode instanceof HTMLElement
    ) {
      activeCountNode.textContent =
        String(activeCount);
    }

    if (
      publicCountNode instanceof HTMLElement
    ) {
      publicCountNode.textContent =
        String(publicCount);
    }
  }

  function applyFilters() {
    const visibleRows =
      getFilteredRows();

    rows.forEach(
      (row) => {
        const visible =
          visibleRows.includes(
            row,
          );

        row.setAttribute(
          "data-hidden",
          visible
            ? "false"
            : "true",
        );
      },
    );

    const count =
      visibleRows.length;

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${count} material`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(count);
    }

    setEmptyState(
      count > 0,
    );

    if (
      clearSearch instanceof HTMLButtonElement &&
      searchInput instanceof HTMLInputElement
    ) {
      clearSearch.hidden =
        searchInput.value.trim() === "";
    }
  }

  function resetCategoryCards() {
    categoryCards.forEach(
      (card) => {
        card.setAttribute(
          "data-selected",
          "false",
        );
      },
    );
  }

  function resetFilters() {
    if (
      searchInput instanceof HTMLInputElement
    ) {
      searchInput.value = "";
    }

    if (
      categoryFilter instanceof HTMLSelectElement
    ) {
      categoryFilter.value =
        "all";
    }

    if (
      statusFilter instanceof HTMLSelectElement
    ) {
      statusFilter.value =
        "all";
    }

    if (
      visibilityFilter instanceof HTMLSelectElement
    ) {
      visibilityFilter.value =
        "all";
    }

    resetCategoryCards();
    applyFilters();
  }

  function showToast(
    message,
  ) {
    if (
      !(toast instanceof HTMLElement) ||
      !(toastMessage instanceof HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden = false;

    if (toastTimer !== null) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden =
            true;
          toastTimer = null;
        },
        2800,
      );
  }

  function createStatusBadge(
    status,
  ) {
    const badge =
      document.createElement(
        "span",
      );

    badge.className =
      `status-badge status-badge--${status}`;

    const text =
      document.createElement(
        "span",
      );

    text.textContent =
      labelForStatus(
        status,
      );

    const icon =
      document.createElement(
        "span",
      );

    icon.setAttribute(
      "aria-hidden",
      "true",
    );

    if (status === "active") {
      icon.textContent = "●";
    } else if (status === "draft") {
      icon.textContent = "◐";
    } else {
      icon.textContent = "!";
    }

    badge.append(
      icon,
      text,
    );

    return badge;
  }

  function populateDrawer(
    record,
  ) {
    if (!record) {
      return;
    }

    if (
      drawerName instanceof HTMLElement
    ) {
      drawerName.textContent =
        record.name;
    }

    if (
      drawerCategory instanceof HTMLElement
    ) {
      drawerCategory.textContent =
        record.categoryLabel;
    }

    if (
      drawerDescription instanceof HTMLElement
    ) {
      drawerDescription.textContent =
        record.description;
    }

    if (
      drawerStatus instanceof HTMLElement
    ) {
      drawerStatus.replaceChildren(
        createStatusBadge(
          record.status,
        ).firstElementChild,
        createStatusBadge(
          record.status,
        ).lastElementChild,
      );

      drawerStatus.className =
        `status-badge status-badge--${record.status}`;
    }

    if (
      drawerVisibility instanceof HTMLElement
    ) {
      drawerVisibility.className =
        record.visibility === "public"
          ? "visibility-badge visibility-badge--public"
          : "visibility-badge visibility-badge--private";

      drawerVisibility.textContent =
        labelForVisibility(
          record.visibility,
        );
    }

    if (
      drawerCharacteristics instanceof HTMLElement
    ) {
      drawerCharacteristics.replaceChildren();

      record.characteristics.forEach(
        (item) => {
          const tag =
            document.createElement(
              "span",
            );

          tag.className = "tag";
          tag.textContent =
            labelForCharacteristic(
              item,
            );

          drawerCharacteristics.append(
            tag,
          );
        },
      );
    }

    if (
      drawerMethods instanceof HTMLElement
    ) {
      drawerMethods.replaceChildren();

      record.methods.forEach(
        (item) => {
          const tag =
            document.createElement(
              "span",
            );

          tag.className = "tag";
          tag.textContent =
            labelForMethod(
              item,
            );

          drawerMethods.append(
            tag,
          );
        },
      );
    }

    if (
      drawerWarning instanceof HTMLElement
    ) {
      drawerWarning.hidden =
        record.status ===
        "active";
    }

    if (
      drawerStatusAction instanceof HTMLButtonElement
    ) {
      drawerStatusAction.textContent =
        record.status ===
        "active"
          ? "Nonaktifkan"
          : "Aktifkan";
    }

    if (
      drawerIcon instanceof HTMLElement
    ) {
      const colors =
        categoryColorMap[
          record.category
        ] ?? {
          color: "#4d7c0f",
          soft: "#efff70",
        };

      drawerIcon.style.setProperty(
        "--drawer-color",
        colors.color,
      );

      drawerIcon.style.setProperty(
        "--drawer-soft",
        colors.soft,
      );
    }
  }

  function openDrawer(
    id,
    trigger,
  ) {
    const record =
      getRecord(id);

    if (
      !record ||
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    selectedId = id;
    activeTrigger =
      trigger instanceof HTMLElement
        ? trigger
        : null;

    populateDrawer(
      record,
    );

    drawer.hidden = false;
    drawerBackdrop.hidden =
      false;

    drawer.setAttribute(
      "data-open",
      "true",
    );

    drawer.setAttribute(
      "aria-hidden",
      "false",
    );

    document.documentElement.style.overflow =
      "hidden";

    if (
      drawerClose instanceof HTMLButtonElement
    ) {
      window.requestAnimationFrame(
        () => {
          drawerClose.focus();
        },
      );
    }
  }

  function closeDrawer(
    restoreFocus = true,
  ) {
    if (
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        if (
          drawer.getAttribute(
            "data-open",
          ) === "false"
        ) {
          drawer.hidden =
            true;

          drawerBackdrop.hidden =
            true;
        }
      },
      190,
    );

    document.documentElement.style.overflow =
      "";

    if (
      restoreFocus &&
      activeTrigger instanceof HTMLElement
    ) {
      activeTrigger.focus();
    }

    selectedId = null;
    activeTrigger = null;
  }

  function updateRow(
    record,
  ) {
    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) === record.id,
      );

    if (!(row instanceof HTMLElement)) {
      return;
    }

    row.setAttribute(
      "data-status",
      record.status,
    );

    const badge =
      row.querySelector(
        "[data-row-status-badge]",
      );

    if (badge instanceof HTMLElement) {
      badge.replaceWith(
        createStatusBadge(
          record.status,
        ),
      );

      const nextBadge =
        row.querySelector(
          ".status-badge",
        );

      if (
        nextBadge instanceof HTMLElement
      ) {
        nextBadge.setAttribute(
          "data-row-status-badge",
          "",
        );
      }
    }
  }

  function toggleSelectedStatus() {
    if (!selectedId) {
      return;
    }

    const record =
      getRecord(
        selectedId,
      );

    if (!record) {
      return;
    }

    record.status =
      record.status === "active"
        ? "archived"
        : "active";

    updateRow(
      record,
    );

    populateDrawer(
      record,
    );

    updateSummary();
    applyFilters();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-waste-status-change",
        {
          detail: {
            ...record,
          },
        },
      ),
    );

    showToast(
      `${record.name} sekarang ${labelForStatus(record.status).toLowerCase()}.`,
    );
  }

  function editRecord(
    id,
  ) {
    const record =
      getRecord(id);

    if (!record) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-waste-edit",
        {
          detail: {
            ...record,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk ${record.name} dipersiapkan.`,
    );
  }

  function createRecord() {
    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-waste-create",
      ),
    );

    showToast(
      "Form material baru dipersiapkan.",
    );
  }

  function toggleFilterPanel() {
    if (
      !(filterToggle instanceof HTMLButtonElement) ||
      !(filterPanel instanceof HTMLElement)
    ) {
      return;
    }

    const isOpen =
      filterToggle.getAttribute(
        "aria-expanded",
      ) === "true";

    filterToggle.setAttribute(
      "aria-expanded",
      isOpen
        ? "false"
        : "true",
    );

    filterPanel.hidden =
      isOpen;
  }

  function closeFilterPanel() {
    if (
      filterToggle instanceof HTMLButtonElement &&
      filterPanel instanceof HTMLElement
    ) {
      filterToggle.setAttribute(
        "aria-expanded",
        "false",
      );

      filterPanel.hidden =
        true;
    }
  }

  searchInput?.addEventListener(
    "input",
    applyFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof HTMLInputElement
      ) {
        searchInput.value = "";
        searchInput.focus();
      }

      applyFilters();
    },
  );

  categoryFilter?.addEventListener(
    "change",
    () => {
      const category =
        categoryFilter instanceof HTMLSelectElement
          ? categoryFilter.value
          : "all";

      categoryCards.forEach(
        (card) => {
          card.setAttribute(
            "data-selected",
            card.getAttribute(
              "data-category",
            ) === category &&
            category !== "all"
              ? "true"
              : "false",
          );
        },
      );

      applyFilters();
    },
  );

  statusFilter?.addEventListener(
    "change",
    applyFilters,
  );

  visibilityFilter?.addEventListener(
    "change",
    applyFilters,
  );

  filterToggle?.addEventListener(
    "click",
    toggleFilterPanel,
  );

  filterClose?.addEventListener(
    "click",
    closeFilterPanel,
  );

  filterReset?.addEventListener(
    "click",
    resetFilters,
  );

  emptyReset?.addEventListener(
    "click",
    () => {
      resetFilters();

      if (
        searchInput instanceof HTMLInputElement
      ) {
        searchInput.focus();
      }
    },
  );

  categoryCards.forEach(
    (card) => {
      card.addEventListener(
        "click",
        () => {
          const category =
            card.getAttribute(
              "data-category",
            );

          if (
            !category ||
            !(categoryFilter instanceof HTMLSelectElement)
          ) {
            return;
          }

          const alreadySelected =
            card.getAttribute(
              "data-selected",
            ) === "true";

          resetCategoryCards();

          categoryFilter.value =
            alreadySelected
              ? "all"
              : category;

          if (!alreadySelected) {
            card.setAttribute(
              "data-selected",
              "true",
            );
          }

          applyFilters();
        },
      );
    },
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(
                id,
                button,
              );
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editRecord(
                id,
              );
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    () => closeDrawer(),
  );

  drawerBackdrop?.addEventListener(
    "click",
    () => closeDrawer(),
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (selectedId) {
        editRecord(
          selectedId,
        );
      }
    },
  );

  drawerStatusAction?.addEventListener(
    "click",
    toggleSelectedStatus,
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      () => {
        applyFilters();
        updateSummary();

        showToast(
          "Taxonomy diperbarui.",
        );
      },
    );

  page
    .querySelector(
      "[data-create]",
    )
    ?.addEventListener(
      "click",
      createRecord,
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key === "Escape"
      ) {
        if (
          drawer instanceof HTMLElement &&
          drawer.getAttribute(
            "data-open",
          ) === "true"
        ) {
          closeDrawer();
          return;
        }

        if (
          filterPanel instanceof HTMLElement &&
          filterToggle instanceof HTMLButtonElement &&
          filterToggle.getAttribute(
            "aria-expanded",
          ) === "true"
        ) {
          closeFilterPanel();
        }
      }
    },
  );

  applyFilters();
  updateSummary();

  if (
    drawerStatus instanceof HTMLElement
  ) {
    drawerStatus.textContent =
      "-";
  }
</script>