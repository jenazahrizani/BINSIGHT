---
import {
  ArrowRight,
  CircleCheck,
  Eye,
  Filter,
  Leaf,
  Package,
  Pencil,
  Plus,
  RefreshCw,
  Recycle,
  Search,
  ShieldCheck,
  TriangleAlert,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

import {
  WASTE_CATEGORIES,
  WASTE_MATERIALS,
  WASTE_METHOD_LABELS,
  WASTE_CHARACTERISTIC_LABELS,
  WASTE_STATUS_LABELS,
  WASTE_VISIBILITY_LABELS,
  type WasteCategory,
  type WasteMaterial,
  type WasteStatus,
  type WasteVisibility,
} from "../../lib/constants/waste";

interface WasteRecord {
  id: WasteMaterial;
  name: string;
  category: WasteCategory;
  description: string;
  characteristics: readonly string[];
  methods: readonly string[];
  status: WasteStatus;
  visibility: WasteVisibility;
}

const categoryMap = new Map(
  WASTE_CATEGORIES.map((category) => [
    category.id,
    category,
  ]),
);

const wasteRecords: WasteRecord[] = WASTE_MATERIALS.map(
  (material) => ({
    id: material.id,
    name: material.label,
    category: material.category,
    description: material.description,
    characteristics: material.characteristics,
    methods: material.recommendedMethods,
    status: "active",
    visibility: "public",
  }),
);

const categoryCounts = WASTE_CATEGORIES.map(
  (category) => ({
    ...category,
    count: wasteRecords.filter(
      (material) =>
        material.category === category.id,
    ).length,
  }),
);

const activeCount = wasteRecords.filter(
  (material) =>
    material.status === "active",
).length;

const draftCount = wasteRecords.filter(
  (material) =>
    material.status === "draft",
).length;

const archivedCount = wasteRecords.filter(
  (material) =>
    material.status === "archived",
).length;

const publicCount = wasteRecords.filter(
  (material) =>
    material.visibility === "public",
).length;

const taxonomyPayload = wasteRecords.map(
  (material) => ({
    id: material.id,
    name: material.name,
    category: material.category,
    categoryLabel:
      categoryMap.get(material.category)?.label ??
      material.category,
    description: material.description,
    characteristics: [...material.characteristics],
    methods: [...material.methods],
    status: material.status,
    visibility: material.visibility,
  }),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Jenis Sampah — Admin BINSIGHT",
  description:
    "Administrasi taxonomy jenis sampah, material, karakteristik, dan metode pengelolaan BINSIGHT.",
  url: "https://binsight.id/admin/waste",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Jenis Sampah"
  description="Kelola taxonomy material, kategori, karakteristik, dan metode pengelolaan BINSIGHT."
  activeSection="waste"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main
    class="waste-page"
    data-waste-page
  >
    <script
      type="application/json"
      id="admin-waste-data"
      is:inline
      set:html={JSON.stringify(taxonomyPayload)}
    />

    <section class="page-intro">
      <div class="page-intro__main">
        <div class="page-intro__eyebrow">
          <span class="page-intro__eyebrow-mark">
            <Recycle
              size={15}
              stroke-width={2.2}
              aria-hidden="true"
            />
          </span>

          <span>
            WASTE TAXONOMY / ADMIN
          </span>
        </div>

        <div class="page-intro__heading-row">
          <div>
            <h1>
              Jenis sampah
            </h1>

            <p>
              Kelola vocabulary material yang dipakai bersama oleh
              halaman publik, organisasi, laporan, peta, dan dashboard
              BINSIGHT.
            </p>
          </div>

          <div class="page-intro__code">
            <span>
              TAXONOMY
            </span>
            <strong>
              / WASTE
            </strong>
          </div>
        </div>
      </div>

      <div class="page-intro__actions">
        <button
          type="button"
          class="button button--light"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2.2}
            aria-hidden="true"
          />

          <span>
            Refresh
          </span>
        </button>

        <a
          href="/waste"
          class="button button--ghost"
        >
          <Eye
            size={16}
            stroke-width={2.1}
            aria-hidden="true"
          />

          <span>
            Lihat publik
          </span>

          <ArrowRight
            size={14}
            stroke-width={2.1}
            aria-hidden="true"
          />
        </a>

        <button
          type="button"
          class="button button--primary"
          data-create
        >
          <Plus
            size={17}
            stroke-width={2.2}
            aria-hidden="true"
          />

          <span>
            Tambah material
          </span>
        </button>
      </div>
    </section>

    <section
      class="summary-grid"
      aria-label="Ringkasan taxonomy sampah"
    >
      <article class="summary-card summary-card--primary">
        <div class="summary-card__meta-row">
          <span class="summary-card__eyebrow">
            MATERIAL
          </span>

          <span class="summary-card__icon">
            <Package
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {wasteRecords.length}
        </strong>

        <span class="summary-card__label">
          Material dalam taxonomy
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__meta-row">
          <span class="summary-card__eyebrow">
            CATEGORY
          </span>

          <span class="summary-card__icon">
            <Recycle
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {WASTE_CATEGORIES.length}
        </strong>

        <span class="summary-card__label">
          Kelompok utama taxonomy
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__meta-row">
          <span class="summary-card__eyebrow">
            ACTIVE
          </span>

          <span class="summary-card__icon">
            <CircleCheck
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-active-count
        >
          {activeCount}
        </strong>

        <span class="summary-card__label">
          Material aktif
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__meta-row">
          <span class="summary-card__eyebrow">
            PUBLIC
          </span>

          <span class="summary-card__icon">
            <Eye
              size={17}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong
          class="summary-card__value"
          data-public-count
        >
          {publicCount}
        </strong>

        <span class="summary-card__label">
          Material visibility publik
        </span>
      </article>
    </section>

    <section
      class="taxonomy-overview"
      aria-labelledby="taxonomy-overview-title"
    >
      <div class="section-head">
        <div>
          <span class="section-head__eyebrow">
            01 / TAXONOMY MAP
          </span>

          <h2 id="taxonomy-overview-title">
            Kategori material
          </h2>
        </div>

        <p>
          Klik kategori untuk memfilter direktori material.
        </p>
      </div>

      <div class="category-grid">
        {
          categoryCounts.map((category) => (
            <button
              type="button"
              class="category-card"
              data-category-card
              data-category={category.id}
              data-selected="false"
              style={`--category-color:${category.color};--category-soft:${category.softColor};`}
            >
              <div class="category-card__top">
                <span class="category-card__mark">
                  {
                    category.id === "organic" ? (
                      <Leaf
                        size={18}
                        stroke-width={2.05}
                        aria-hidden="true"
                      />
                    ) : category.id === "inorganic" ? (
                      <Package
                        size={18}
                        stroke-width={2.05}
                        aria-hidden="true"
                      />
                    ) : category.id === "hazardous" ? (
                      <TriangleAlert
                        size={18}
                        stroke-width={2.05}
                        aria-hidden="true"
                      />
                    ) : category.id === "electronic" ? (
                      <Package
                        size={18}
                        stroke-width={2.05}
                        aria-hidden="true"
                      />
                    ) : (
                      <Recycle
                        size={18}
                        stroke-width={2.05}
                        aria-hidden="true"
                      />
                    )
                  }
                </span>

                <span class="category-card__count">
                  {category.count}
                </span>
              </div>

              <strong>
                {category.label}
              </strong>

              <span class="category-card__description">
                {category.description}
              </span>

              <span class="category-card__action">
                Filter →
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="directory-card">
      <div class="directory-toolbar">
        <div class="search-box">
          <Search
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="waste-search"
          >
            Cari material
          </label>

          <input
            id="waste-search"
            type="search"
            placeholder="Cari material, kategori, karakteristik, metode..."
            autocomplete="off"
            spellcheck="false"
            data-search
          />

          <button
            type="button"
            class="search-box__clear"
            aria-label="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar-filters">
          <label class="select-box">
            <span class="sr-only">
              Filter kategori
            </span>

            <select
              aria-label="Filter kategori"
              data-category-filter
            >
              <option value="all">
                Semua kategori
              </option>

              {
                WASTE_CATEGORIES.map((category) => (
                  <option value={category.id}>
                    {category.label}
                  </option>
                ))
              }
            </select>
          </label>

          <label class="select-box">
            <span class="sr-only">
              Filter status
            </span>

            <select
              aria-label="Filter status"
              data-status-filter
            >
              <option value="all">
                Semua status
              </option>

              {
                Object.entries(
                  WASTE_STATUS_LABELS,
                ).map(([value, label]) => (
                  <option value={value}>
                    {label}
                  </option>
                ))
              }
            </select>
          </label>

          <label class="select-box">
            <span class="sr-only">
              Filter visibility
            </span>

            <select
              aria-label="Filter visibility"
              data-visibility-filter
            >
              <option value="all">
                Semua visibility
              </option>

              {
                Object.entries(
                  WASTE_VISIBILITY_LABELS,
                ).map(([value, label]) => (
                  <option value={value}>
                    {label}
                  </option>
                ))
              }
            </select>
          </label>

          <button
            type="button"
            class="filter-toggle"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="waste-filter-panel"
          >
            <Filter
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Filter
            </span>
          </button>
        </div>
      </div>

      <div
        class="filter-panel"
        id="waste-filter-panel"
        data-filter-panel
        hidden
      >
        <div>
          <span class="filter-panel__eyebrow">
            02 / DATA CONTROL
          </span>

          <h2>
            Penyaringan taxonomy
          </h2>
        </div>

        <div class="filter-panel__right">
          <div class="filter-note">
            <ShieldCheck
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <p>
              Taxonomy adalah vocabulary bersama. Hindari membuat
              label lokal yang berbeda dari sumber taxonomy BINSIGHT.
            </p>
          </div>

          <button
            type="button"
            class="filter-reset"
            data-filter-reset
          >
            Reset filter
          </button>

          <button
            type="button"
            class="filter-close"
            aria-label="Tutup panel filter"
            data-filter-close
          >
            <X
              size={16}
              stroke-width={2.2}
              aria-hidden="true"
            />
          </button>
        </div>
      </div>

      <div class="directory-head">
        <div>
          <span class="directory-head__eyebrow">
            03 / MATERIAL DIRECTORY
          </span>

          <h2>
            Daftar material
          </h2>
        </div>

        <span
          class="directory-count"
          data-result-count
        >
          {wasteRecords.length} material
        </span>
      </div>

      <div class="table-scroll">
        <table class="waste-table">
          <caption class="sr-only">
            Daftar material taxonomy BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Material
              </th>

              <th scope="col">
                Kategori
              </th>

              <th scope="col">
                Karakteristik
              </th>

              <th scope="col">
                Metode
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Visibility
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              wasteRecords.map((material) => {
                const category =
                  categoryMap.get(material.category);

                return (
                  <tr
                    data-waste-row
                    data-id={material.id}
                    data-name={material.name.toLowerCase()}
                    data-category={material.category}
                    data-category-label={
                      category?.label.toLowerCase() ?? ""
                    }
                    data-description={
                      material.description.toLowerCase()
                    }
                    data-characteristics={material.characteristics
                      .map(
                        (item) =>
                          WASTE_CHARACTERISTIC_LABELS[
                            item as keyof typeof WASTE_CHARACTERISTIC_LABELS
                          ] ?? item,
                      )
                      .join(" ")
                      .toLowerCase()}
                    data-methods={material.methods
                      .map(
                        (item) =>
                          WASTE_METHOD_LABELS[
                            item as keyof typeof WASTE_METHOD_LABELS
                          ] ?? item,
                      )
                      .join(" ")
                      .toLowerCase()}
                    data-status={material.status}
                    data-visibility={material.visibility}
                  >
                    <td>
                      <div class="material-cell">
                        <span
                          class="material-cell__mark"
                          style={`--material-color:${category?.color ?? "#7cb800"};--material-soft:${category?.softColor ?? "#efff70"};`}
                        >
                          {
                            material.category === "organic" ? (
                              <Leaf
                                size={17}
                                stroke-width={2.05}
                                aria-hidden="true"
                              />
                            ) : material.category === "hazardous" ? (
                              <TriangleAlert
                                size={17}
                                stroke-width={2.05}
                                aria-hidden="true"
                              />
                            ) : material.category === "electronic" ? (
                              <Package
                                size={17}
                                stroke-width={2.05}
                                aria-hidden="true"
                              />
                            ) : (
                              <Recycle
                                size={17}
                                stroke-width={2.05}
                                aria-hidden="true"
                              />
                            )
                          }
                        </span>

                        <div class="material-cell__content">
                          <strong>
                            {material.name}
                          </strong>

                          <span>
                            {material.description}
                          </span>
                        </div>
                      </div>
                    </td>

                    <td>
                      <span
                        class="category-badge"
                        style={`--category-color:${category?.color ?? "#7cb800"};--category-soft:${category?.softColor ?? "#efff70"};`}
                      >
                        {category?.shortLabel ??
                          material.category}
                      </span>
                    </td>

                    <td>
                      <div class="tag-list">
                        {
                          material.characteristics
                            .slice(0, 2)
                            .map((characteristic) => (
                              <span class="tag">
                                {
                                  WASTE_CHARACTERISTIC_LABELS[
                                    characteristic as keyof typeof WASTE_CHARACTERISTIC_LABELS
                                  ] ??
                                    characteristic
                                }
                              </span>
                            ))
                        }

                        {
                          material.characteristics.length >
                            2 && (
                            <span class="tag tag--more">
                              +
                              {material.characteristics.length -
                                2}
                            </span>
                          )
                        }
                      </div>
                    </td>

                    <td>
                      <div class="tag-list">
                        {
                          material.methods
                            .slice(0, 2)
                            .map((method) => (
                              <span class="tag">
                                {
                                  WASTE_METHOD_LABELS[
                                    method as keyof typeof WASTE_METHOD_LABELS
                                  ] ??
                                    method
                                }
                              </span>
                            ))
                        }

                        {
                          material.methods.length >
                            2 && (
                            <span class="tag tag--more">
                              +
                              {material.methods.length -
                                2}
                            </span>
                          )
                        }
                      </div>
                    </td>

                    <td>
                      <span
                        class:list={[
                          "status-badge",
                          `status-badge--${material.status}`,
                        ]}
                        data-row-status-badge
                      >
                        {
                          material.status ===
                          "active" ? (
                            <CircleCheck
                              size={13}
                              stroke-width={2.2}
                              aria-hidden="true"
                            />
                          ) : material.status === "draft" ? (
                            <ShieldCheck
                              size={13}
                              stroke-width={2.2}
                              aria-hidden="true"
                            />
                          ) : (
                            <TriangleAlert
                              size={13}
                              stroke-width={2.2}
                              aria-hidden="true"
                            />
                          )
                        }

                        <span>
                          {
                            WASTE_STATUS_LABELS[
                              material.status
                            ]
                          }
                        </span>
                      </span>
                    </td>

                    <td>
                      <span
                        class:list={[
                          "visibility-badge",
                          material.visibility ===
                          "public"
                            ? "visibility-badge--public"
                            : "visibility-badge--private",
                        ]}
                        data-row-visibility-badge
                      >
                        {
                          WASTE_VISIBILITY_LABELS[
                            material.visibility
                          ]
                        }
                      </span>
                    </td>

                    <td>
                      <div class="row-actions">
                        <button
                          type="button"
                          class="row-action"
                          aria-label={`Lihat ${material.name}`}
                          data-view
                          data-record={material.id}
                        >
                          <Eye
                            size={15}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        </button>

                        <button
                          type="button"
                          class="row-action"
                          aria-label={`Edit ${material.name}`}
                          data-edit
                          data-record={material.id}
                        >
                          <Pencil
                            size={15}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
        >
          <span class="empty-state__mark">
            <Search
              size={22}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span class="empty-state__eyebrow">
            NO MATCH
          </span>

          <h3>
            Tidak ada material yang cocok
          </h3>

          <p>
            Ubah kata pencarian atau reset filter taxonomy.
          </p>

          <button
            type="button"
            class="button button--dark"
            data-empty-reset
          >
            Reset pencarian
          </button>
        </div>
      </div>

      <footer class="directory-footer">
        <span>
          <strong data-footer-count>
            {wasteRecords.length}
          </strong>
          material ditampilkan
        </span>

        <span>
          BINSIGHT / WASTE TAXONOMY
        </span>
      </footer>
    </section>

    <section class="governance-grid">
      <article class="governance-card">
        <div class="governance-card__top">
          <span class="governance-card__index">
            A
          </span>

          <ShieldCheck
            size={19}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <span class="governance-card__eyebrow">
          SINGLE SOURCE OF TRUTH
        </span>

        <h2>
          Taxonomy harus konsisten
        </h2>

        <p>
          Kategori, material, karakteristik, dan metode dipakai lintas
          halaman. Perubahan vocabulary sebaiknya dilakukan dari sumber
          taxonomy, bukan dengan membuat label lokal yang berbeda.
        </p>
      </article>

      <article class="governance-card governance-card--accent">
        <div class="governance-card__top">
          <span class="governance-card__index">
            B
          </span>

          <CircleCheck
            size={19}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <span class="governance-card__eyebrow">
          DATA QUALITY
        </span>

        <h2>
          Vocabulary ≠ statistik
        </h2>

        <p>
          Halaman ini mengelola definisi dan klasifikasi. Statistik
          operasional, jumlah laporan, atau volume harus berasal dari data
          aktual, bukan dari file taxonomy.
        </p>
      </article>
    </section>

    <aside
      class="waste-drawer"
      data-drawer
      aria-hidden="true"
      hidden
      aria-labelledby="drawer-title"
    >
      <div class="drawer-header">
        <div>
          <span class="drawer-header__eyebrow">
            MATERIAL DETAIL
          </span>

          <h2 id="drawer-title">
            Detail material
          </h2>
        </div>

        <button
          type="button"
          class="drawer-close"
          aria-label="Tutup detail"
          data-drawer-close
        >
          <X
            size={18}
            stroke-width={2.2}
            aria-hidden="true"
          />
        </button>
      </div>

      <div class="drawer-body">
        <div class="drawer-identity">
          <span
            class="drawer-identity__mark"
            data-drawer-icon
          >
            <Recycle
              size={22}
              stroke-width={2.1}
              aria-hidden="true"
            />
          </span>

          <div>
            <span class="drawer-identity__eyebrow">
              MATERIAL
            </span>

            <h3 data-drawer-name>
              -
            </h3>

            <span data-drawer-category>
              -
            </span>
          </div>
        </div>

        <div class="drawer-status-row">
          <span
            class="status-badge"
            data-drawer-status
          >
            -
          </span>

          <span
            class="visibility-badge"
            data-drawer-visibility
          >
            -
          </span>
        </div>

        <section class="drawer-section">
