  if (
    !(page instanceof HTMLElement)
  ) {
    throw new Error(
      "BINSIGHT content admin page root not found.",
    );
  }

  const dataNode =
    document.getElementById(
      "admin-content-data",
    );

  let contents = [];

  try {
    contents = dataNode?.textContent
      ? JSON.parse(
          dataNode.textContent,
        )
      : [];
  } catch {
    contents = [];
  }

  const searchInput =
    page.querySelector(
      "[data-search]",
    );

  const clearSearch =
    page.querySelector(
      "[data-clear-search]",
    );

  const statusFilter =
    page.querySelector(
      "[data-status-filter]",
    );

  const typeFilter =
    page.querySelector(
      "[data-type-filter]",
    );

  const visibilityFilter =
    page.querySelector(
      "[data-visibility-filter]",
    );

  const resultCount =
    page.querySelector(
      "[data-result-count]",
    );

  const footerCount =
    page.querySelector(
      "[data-footer-count]",
    );

  const emptyState =
    page.querySelector(
      "[data-empty-state]",
    );

  const emptyReset =
    page.querySelector(
      "[data-empty-reset]",
    );

  const rows =
    Array.from(
      page.querySelectorAll(
        "[data-content-row]",
      ),
    );

  const summaryTotal =
    page.querySelector(
      "[data-summary-total]",
    );

  const summaryPublished =
    page.querySelector(
      "[data-summary-published]",
    );

  const summaryDraft =
    page.querySelector(
      "[data-summary-draft]",
    );

  const summaryArchived =
    page.querySelector(
      "[data-summary-archived]",
    );

  const publicCountElement =
    page.querySelector(
      "[data-public-count]",
    );

  const drawer =
    page.parentElement?.querySelector(
      "[data-drawer]",
    );

  const drawerBackdrop =
    page.parentElement?.querySelector(
      "[data-drawer-backdrop]",
    );

  const drawerClose =
    page.parentElement?.querySelector(
      "[data-drawer-close]",
    );

  const drawerTitle =
    page.parentElement?.querySelector(
      "[data-drawer-title]",
    );

  const drawerType =
    page.parentElement?.querySelector(
      "[data-drawer-type]",
    );

  const drawerStatus =
    page.parentElement?.querySelector(
      "[data-drawer-status]",
    );

  const drawerVisibility =
    page.parentElement?.querySelector(
      "[data-drawer-visibility]",
    );

  const drawerDescription =
    page.parentElement?.querySelector(
      "[data-drawer-description]",
    );

  const drawerAuthor =
    page.parentElement?.querySelector(
      "[data-drawer-author]",
    );

  const drawerCreated =
    page.parentElement?.querySelector(
      "[data-drawer-created]",
    );

  const drawerUpdated =
    page.parentElement?.querySelector(
      "[data-drawer-updated]",
    );

  const drawerPublicationTitle =
    page.parentElement?.querySelector(
      "[data-drawer-publication-title]",
    );

  const drawerPublicationCopy =
    page.parentElement?.querySelector(
      "[data-drawer-publication-copy]",
    );

  const drawerRecord =
    page.parentElement?.querySelector(
      "[data-drawer-record]",
    );

  const drawerEdit =
    page.parentElement?.querySelector(
      "[data-drawer-edit]",
    );

  const drawerPublish =
    page.parentElement?.querySelector(
      "[data-drawer-publish]",
    );

  const createModal =
    page.parentElement?.querySelector(
      "[data-create-modal]",
    );

  const createForm =
    page.parentElement?.querySelector(
      "[data-create-form]",
    );

  const createContentButton =
    page.querySelector(
      "[data-create-content]",
    );

  const createCloseButtons =
    Array.from(
      page.parentElement?.querySelectorAll(
        "[data-create-close]",
      ) ?? [],
    );

  const toast =
    page.parentElement?.querySelector(
      "[data-toast]",
    );

  const toastMessage =
    page.parentElement?.querySelector(
      "[data-toast-message]",
    );

  let selectedContentId =
    null;

  let toastTimer =
    null;

  let previouslyFocusedElement =
    null;

  let scrollLockCount =
    0;

  function lockPageScroll() {
    scrollLockCount += 1;

    if (
      scrollLockCount === 1
    ) {
      document.documentElement.style.overflow =
        "hidden";
    }
  }

  function unlockPageScroll() {
    scrollLockCount =
      Math.max(
        0,
        scrollLockCount - 1,
      );

    if (
      scrollLockCount === 0
    ) {
      document.documentElement.style.overflow =
        "";
    }
  }

  function getContent(
    id,
  ) {
    return contents.find(
      (content) =>
        content.id === id,
    );
  }

  function updateSummary() {
    const published =
      contents.filter(
        (item) =>
          item.status ===
          "published",
      ).length;

    const draft =
      contents.filter(
        (item) =>
          item.status ===
          "draft",
      ).length;

    const archived =
      contents.filter(
        (item) =>
          item.status ===
          "archived",
      ).length;

    const publicCount =
      contents.filter(
        (item) =>
          item.visibility ===
          "public",
      ).length;

    if (
      summaryTotal instanceof HTMLElement
    ) {
      summaryTotal.textContent =
        String(
          contents.length,
        );
    }

    if (
      summaryPublished instanceof HTMLElement
    ) {
      summaryPublished.textContent =
        String(
          published,
        );
    }

    if (
      summaryDraft instanceof HTMLElement
    ) {
      summaryDraft.textContent =
        String(
          draft,
        );
    }

    if (
      summaryArchived instanceof HTMLElement
    ) {
      summaryArchived.textContent =
        String(
          archived,
        );
    }

    if (
      publicCountElement instanceof
      HTMLElement
    ) {
      publicCountElement.textContent =
        String(
          publicCount,
        );
    }
  }

  function setEmptyState(
    hasResults,
  ) {
    if (
      !(emptyState instanceof
        HTMLElement)
    ) {
      return;
    }

    const shouldShow =
      !hasResults;

    emptyState.hidden =
      !shouldShow;

    emptyState.setAttribute(
      "aria-hidden",
      shouldShow
        ? "false"
        : "true",
    );

    /*
     * Explicit inline display is intentional here.
     * This guarantees that a global `.empty-state`,
     * parent layout rule, or external CSS cannot make
     * the empty state visible when hidden.
     */
    emptyState.style.display =
      shouldShow
        ? "flex"
        : "none";
  }

  function updateFilters() {
    const query =
      searchInput instanceof
      HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const status =
      statusFilter instanceof
      HTMLSelectElement
        ? statusFilter.value
        : "all";

    const type =
      typeFilter instanceof
      HTMLSelectElement
        ? typeFilter.value
        : "all";

    const visibility =
      visibilityFilter instanceof
      HTMLSelectElement
        ? visibilityFilter.value
        : "all";

    const visibleRows =
      rows.filter(
        (row) => {
          const title =
            row.getAttribute(
              "data-title",
            ) ?? "";

          const description =
            row.getAttribute(
              "data-description",
            ) ?? "";

          const typeValue =
            row.getAttribute(
              "data-type",
            ) ?? "";

          const typeLabel =
            row.getAttribute(
              "data-type-label",
            ) ?? "";

          const rowStatus =
            row.getAttribute(
              "data-status",
            ) ?? "";

          const author =
            row.getAttribute(
              "data-author",
            ) ?? "";

          const rowVisibility =
            row.getAttribute(
              "data-visibility",
            ) ?? "";

          const matchesSearch =
            query === "" ||
            title.includes(
              query,
            ) ||
            description.includes(
              query,
            ) ||
            typeLabel.includes(
              query,
            ) ||
            author.includes(
              query,
            );

          const matchesStatus =
            status === "all" ||
            rowStatus === status;

          const matchesType =
            type === "all" ||
            typeValue === type;

          const matchesVisibility =
            visibility === "all" ||
            rowVisibility ===
              visibility;

          return (
            matchesSearch &&
            matchesStatus &&
            matchesType &&
            matchesVisibility
          );
        },
      );

    rows.forEach(
      (row) => {
        const isVisible =
          visibleRows.includes(
            row,
          );

        row.setAttribute(
          "data-hidden",
          isVisible
            ? "false"
            : "true",
        );

        row.hidden =
          !isVisible;
      },
    );

    const hasResults =
      visibleRows.length >
      0;

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${visibleRows.length} record`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(
          visibleRows.length,
        );
    }

    setEmptyState(
      hasResults,
    );

    if (
      clearSearch instanceof
      HTMLButtonElement
    ) {
      clearSearch.hidden =
        !(
          searchInput instanceof
          HTMLInputElement &&
          searchInput.value.length >
            0
        );
    }

    updateSummary();
  }

  function resetFilters() {
    if (
      searchInput instanceof
      HTMLInputElement
    ) {
      searchInput.value =
        "";
    }

    if (
      statusFilter instanceof
      HTMLSelectElement
    ) {
      statusFilter.value =
        "all";
    }

    if (
      typeFilter instanceof
      HTMLSelectElement
    ) {
      typeFilter.value =
        "all";
    }

    if (
      visibilityFilter instanceof
      HTMLSelectElement
    ) {
      visibilityFilter.value =
        "all";
    }

    updateFilters();
  }

  function showToast(
    message,
  ) {
    if (
      !(toast instanceof
        HTMLElement) ||
      !(toastMessage instanceof
        HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden =
      false;

    if (
      toastTimer !== null
    ) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden =
            true;

          toastTimer =
            null;
        },
        2800,
      );
  }

  function setStatusBadge(
    element,
    content,
  ) {
    if (
      !(element instanceof
        HTMLElement)
    ) {
      return;
    }

    element.className =
      `status-badge status-badge--${content.status}`;

    element.replaceChildren();

    const wrapper =
      document.createElement(
        "span",
      );

    wrapper.textContent =
      content.statusLabel;

    element.append(
      wrapper,
    );
  }

  function setVisibilityBadge(
    element,
    content,
  ) {
    if (
      !(element instanceof
        HTMLElement)
    ) {
      return;
    }

    element.className =
      `visibility-badge visibility-badge--${content.visibility}`;

    element.replaceChildren();

    const wrapper =
      document.createElement(
        "span",
      );

    wrapper.textContent =
      content.visibility ===
      "public"
        ? "Publik"
        : "Privat";

    element.append(
      wrapper,
    );
  }

  function updateDrawerAction(
    content,
  ) {
    if (
      !(drawerPublish instanceof
        HTMLButtonElement)
    ) {
      return;
    }

    drawerPublish.disabled =
      false;

    drawerPublish.className =
      "button button--acid";

    if (
      content.status ===
      "published"
    ) {
      drawerPublish.innerHTML =
        `
          <span>Sudah terbit</span>
        `;

      drawerPublish.disabled =
        true;

      drawerPublish.className =
        "button button--paper";

      return;
    }

    if (
      content.status ===
      "archived"
    ) {
      drawerPublish.innerHTML =
        `
          <span>Diarsipkan</span>
        `;

      drawerPublish.disabled =
        true;

      drawerPublish.className =
        "button button--paper";

      return;
    }

    drawerPublish.innerHTML =
      `
        <span>Terbitkan</span>
      `;
  }

  function populateDrawer(
    content,
  ) {
    if (!content) {
      return;
    }

    if (
      drawerTitle instanceof
      HTMLElement
    ) {
      drawerTitle.textContent =
        content.title;
    }

    if (
      drawerType instanceof
      HTMLElement
    ) {
      drawerType.textContent =
        content.typeLabel;
    }

    setStatusBadge(
      drawerStatus,
      content,
    );

    setVisibilityBadge(
      drawerVisibility,
      content,
    );

    if (
      drawerDescription instanceof
      HTMLElement
    ) {
      drawerDescription.textContent =
        content.description;
    }

    if (
      drawerAuthor instanceof
      HTMLElement
    ) {
      drawerAuthor.textContent =
        content.author;
    }

    if (
      drawerCreated instanceof
      HTMLElement
    ) {
      drawerCreated.textContent =
        content.createdAt;
    }

    if (
      drawerUpdated instanceof
      HTMLElement
    ) {
      drawerUpdated.textContent =
        content.updatedAt;
    }

    if (
      drawerPublicationTitle instanceof
      HTMLElement
    ) {
      drawerPublicationTitle.textContent =
        content.visibility ===
        "public"
          ? "Konten publik"
          : "Konten privat";
    }

    if (
      drawerPublicationCopy instanceof
      HTMLElement
    ) {
      drawerPublicationCopy.textContent =
        content.visibility ===
        "public"
          ? "Konten ini ditujukan untuk pengalaman publik BINSIGHT."
          : "Konten ini tidak ditujukan sebagai informasi publik utama.";
    }

    if (
      drawerRecord instanceof
      HTMLElement
    ) {
      drawerRecord.textContent =
        content.id;
    }

    updateDrawerAction(
      content,
    );
  }

  function openDrawer(
    id,
  ) {
    const content =
      getContent(id);

    if (
      !content ||
      !(drawer instanceof
        HTMLElement) ||
      !(drawerBackdrop instanceof
        HTMLElement)
    ) {
      return;
    }

    previouslyFocusedElement =
      document.activeElement instanceof
      HTMLElement
        ? document.activeElement
        : null;

    selectedContentId =
      id;

    populateDrawer(
      content,
    );

    drawer.hidden =
      false;

    drawerBackdrop.hidden =
      false;

    lockPageScroll();

    requestAnimationFrame(
      () => {
        drawer.setAttribute(
          "data-open",
          "true",
        );

        drawer.setAttribute(
          "aria-hidden",
          "false",
        );

        if (
          drawerClose instanceof
          HTMLButtonElement
        ) {
          drawerClose.focus();
        }
      },
    );
  }

  function closeDrawer() {
    if (
      !(drawer instanceof
        HTMLElement) ||
      !(drawerBackdrop instanceof
        HTMLElement)
    ) {
      return;
    }

    const wasOpen =
      drawer.getAttribute(
        "data-open",
      ) ===
      "true";

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        if (
          drawer.getAttribute(
            "data-open",
          ) !==
          "true"
        ) {
          drawer.hidden =
            true;

          drawerBackdrop.hidden =
            true;
        }
      },
      190,
    );

    if (wasOpen) {
      unlockPageScroll();
    }

    selectedContentId =
      null;

    if (
      previouslyFocusedElement instanceof
      HTMLElement
    ) {
      previouslyFocusedElement.focus();

      previouslyFocusedElement =
        null;
    }
  }

  function editContent(
    id,
  ) {
    const content =
      getContent(id);

    if (!content) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-content-edit",
        {
          detail: {
            ...content,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk "${content.title}" dipersiapkan.`,
    );
  }

  function publishContent() {
    if (
      !selectedContentId
    ) {
      return;
    }

    const content =
      getContent(
        selectedContentId,
      );

    if (!content) {
      return;
    }

    if (
      content.status ===
      "published"
    ) {
      showToast(
        "Konten ini sudah berstatus terbit.",
      );

      return;
    }

    if (
      content.status ===
      "archived"
    ) {
      showToast(
        "Konten arsip tidak dapat langsung diterbitkan.",
      );

      return;
    }

    content.status =
      "published";

    content.statusLabel =
      "Terbit";

    content.updatedAt =
      "10 Sep 2026, sekarang";

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) ===
          content.id,
      );

    if (
      row instanceof HTMLElement
    ) {
      row.setAttribute(
        "data-status",
        content.status,
      );

      row.hidden =
        false;

      const statusBadge =
        row.querySelector(
          ".status-badge",
        );

      setStatusBadge(
        statusBadge,
        content,
      );
    }

    populateDrawer(
      content,
    );

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-content-publish",
        {
          detail: {
            ...content,
          },
        },
      ),
    );

    showToast(
      `"${content.title}" ditandai sebagai terbit.`,
    );

    updateFilters();
  }

  function archiveContent(
    id,
  ) {
    const content =
      getContent(id);

    if (!content) {
      return;
    }

    if (
      content.status ===
      "archived"
    ) {
      showToast(
        "Konten ini sudah diarsipkan.",
      );

      return;
    }

    content.status =
      "archived";

    content.statusLabel =
      "Arsip";

    content.visibility =
      "private";

    content.updatedAt =
      "10 Sep 2026, sekarang";

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) ===
          content.id,
      );

    if (
      row instanceof HTMLElement
    ) {
      row.setAttribute(
        "data-status",
        content.status,
      );

      row.setAttribute(
        "data-visibility",
        content.visibility,
      );

      const statusBadge =
        row.querySelector(
          ".status-badge",
        );

      const visibilityBadge =
        row.querySelector(
          ".visibility-badge",
        );

      setStatusBadge(
        statusBadge,
        content,
      );

      setVisibilityBadge(
        visibilityBadge,
        content,
      );
    }

    if (
      selectedContentId ===
      content.id
    ) {
      populateDrawer(
        content,
      );
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-content-archive",
        {
          detail: {
            ...content,
          },
        },
      ),
    );

    showToast(
      `"${content.title}" diarsipkan.`,
    );

    updateFilters();
  }

  function openCreateModal() {
    if (
      !(createModal instanceof
        HTMLElement)
    ) {
      return;
    }

    previouslyFocusedElement =
      document.activeElement instanceof
      HTMLElement
        ? document.activeElement
        : null;

    createModal.hidden =
      false;

    createModal.setAttribute(
      "aria-hidden",
      "false",
    );

    lockPageScroll();

    const firstInput =
      createModal.querySelector(
        'input[name="title"]',
      );

    if (
      firstInput instanceof
      HTMLInputElement
    ) {
      window.setTimeout(
        () =>
          firstInput.focus(),
        0,
      );
    }
  }

  function closeCreateModal() {
    if (
      !(createModal instanceof
        HTMLElement) ||
      createModal.hidden
    ) {
      return;
    }

    createModal.hidden =
      true;

    createModal.setAttribute(
      "aria-hidden",
      "true",
    );

    unlockPageScroll();

    if (
      previouslyFocusedElement instanceof
      HTMLElement
    ) {
      previouslyFocusedElement.focus();

      previouslyFocusedElement =
        null;
    }
  }

  createContentButton?.addEventListener(
    "click",
    openCreateModal,
  );

  createCloseButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        closeCreateModal,
      );
    },
  );

  createForm?.addEventListener(
    "submit",
    (event) => {
      event.preventDefault();

      if (
        !(createForm instanceof
          HTMLFormElement)
      ) {
        return;
      }

      const formData =
        new FormData(
          createForm,
        );

      const title =
        String(
          formData.get(
            "title",
          ) ?? "",
        ).trim();

      const description =
        String(
          formData.get(
            "description",
          ) ?? "",
        ).trim();

      const type =
        String(
          formData.get(
            "type",
          ) ?? "page",
        );

      const visibility =
        String(
          formData.get(
            "visibility",
          ) ?? "public",
        );

      if (
        !title ||
        !description
      ) {
        showToast(
          "Judul dan deskripsi wajib diisi.",
        );

        return;
      }

      const typeMap = {
        page: "Halaman",
        article: "Artikel",
        guide: "Panduan",
        media: "Media",
      };

      window.dispatchEvent(
        new CustomEvent(
          "binsight:admin-content-create",
          {
            detail: {
              title,
              description,
              type,
              typeLabel:
                typeMap[
                  type
                ] ??
                "Halaman",
              visibility,
              status:
                "draft",
              statusLabel:
                "Draft",
            },
          },
        ),
      );

      closeCreateModal();

      createForm.reset();

      showToast(
        `"${title}" disiapkan sebagai draft.`,
      );
    },
  );

  searchInput?.addEventListener(
    "input",
    updateFilters,
  );

  statusFilter?.addEventListener(
    "change",
    updateFilters,
  );

  typeFilter?.addEventListener(
    "change",
    updateFilters,
  );

  visibilityFilter?.addEventListener(
    "change",
    updateFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof
        HTMLInputElement
      ) {
        searchInput.value =
          "";

        searchInput.focus();
      }

      updateFilters();
    },
  );

  emptyReset?.addEventListener(
    "click",
    resetFilters,
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editContent(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-archive]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              archiveContent(id);
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerBackdrop?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (
        selectedContentId
      ) {
        editContent(
          selectedContentId,
        );
      }
    },
  );

  drawerPublish?.addEventListener(
    "click",
    publishContent,
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      () => {
        updateFilters();

        showToast(
          "Daftar konten diperbarui.",
        );
      },
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key !== "Escape"
      ) {
        return;
      }

      if (
        drawer instanceof
          HTMLElement &&
        drawer.getAttribute(
          "data-open",
        ) ===
          "true"
      ) {
        closeDrawer();

        return;
      }

      if (
        createModal instanceof
          HTMLElement &&
        !createModal.hidden
      ) {
        closeCreateModal();
      }
    },
  );

  window.addEventListener(
    "beforeunload",
    () => {
      document.documentElement.style.overflow =
        "";
    },
  );

  /*
   * Initial state:
   * records exist -> NO MATCH must stay hidden.
   */
  setEmptyState(
    rows.length > 0,
  );

  updateFilters();
</script>