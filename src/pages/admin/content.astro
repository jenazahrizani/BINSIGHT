      type: "article",
      typeLabel: "Artikel",
      status: "published",
      statusLabel: "Terbit",
      author: "Admin BINSIGHT",
      updatedAt: "8 Sep 2026, 17:05",
      createdAt: "2 Sep 2026",
      visibility: "public",
    },
    {
      id: "content-demo-005",
      title: "Materi Program Lama",
      description:
        "Konten lama yang tidak lagi menjadi bagian dari informasi publik utama.",
      type: "page",
      typeLabel: "Halaman",
      status: "archived",
      statusLabel: "Arsip",
      author: "Admin BINSIGHT",
      updatedAt: "5 Sep 2026, 10:35",
      createdAt: "1 Sep 2026",
      visibility: "private",
    },
    {
      id: "content-demo-006",
      title: "Asset Foto Ekosistem Badung",
      description:
        "Kumpulan media pendukung untuk kebutuhan konten dan visualisasi platform.",
      type: "media",
      typeLabel: "Media",
      status: "published",
      statusLabel: "Terbit",
      author: "Admin BINSIGHT",
      updatedAt: "4 Sep 2026, 14:22",
      createdAt: "2 Sep 2026",
      visibility: "private",
    },
  ];

  const page =
    document.querySelector(
      "[data-content-page]",
    );

  if (!(page instanceof HTMLElement)) {
    throw new Error(
      "BINSIGHT content admin page root not found.",
    );
  }

  const searchInput =
    page.querySelector(
      "[data-search]",
    );

  const clearSearch =
    page.querySelector(
      "[data-clear-search]",
    );

  const statusFilter =
    page.querySelector(
      "[data-status-filter]",
    );

  const typeFilter =
    page.querySelector(
      "[data-type-filter]",
    );

  const visibilityFilter =
    page.querySelector(
      "[data-visibility-filter]",
    );

  const resultCount =
    page.querySelector(
      "[data-result-count]",
    );

  const footerCount =
    page.querySelector(
      "[data-footer-count]",
    );

  const emptyState =
    page.querySelector(
      "[data-empty-state]",
    );

  const emptyReset =
    page.querySelector(
      "[data-empty-reset]",
    );

  const rows =
    Array.from(
      page.querySelectorAll(
        "[data-content-row]",
      ),
    );

  const drawer =
    page.querySelector(
      "[data-drawer]",
    );

  const drawerBackdrop =
    page.querySelector(
      "[data-drawer-backdrop]",
    );

  const drawerClose =
    page.querySelector(
      "[data-drawer-close]",
    );

  const drawerTitle =
    page.querySelector(
      "[data-drawer-title]",
    );

  const drawerType =
    page.querySelector(
      "[data-drawer-type]",
    );

  const drawerStatus =
    page.querySelector(
      "[data-drawer-status]",
    );

  const drawerVisibility =
    page.querySelector(
      "[data-drawer-visibility]",
    );

  const drawerDescription =
    page.querySelector(
      "[data-drawer-description]",
    );

  const drawerAuthor =
    page.querySelector(
      "[data-drawer-author]",
    );

  const drawerCreated =
    page.querySelector(
      "[data-drawer-created]",
    );

  const drawerUpdated =
    page.querySelector(
      "[data-drawer-updated]",
    );

  const drawerPublicationTitle =
    page.querySelector(
      "[data-drawer-publication-title]",
    );

  const drawerPublicationCopy =
    page.querySelector(
      "[data-drawer-publication-copy]",
    );

  const drawerLink =
    page.querySelector(
      "[data-drawer-link]",
    );

  const drawerEdit =
    page.querySelector(
      "[data-drawer-edit]",
    );

  const drawerPublish =
    page.querySelector(
      "[data-drawer-publish]",
    );

  const createModal =
    page.querySelector(
      "[data-create-modal]",
    );

  const createForm =
    page.querySelector(
      "[data-create-form]",
    );

  const createContentButton =
    page.querySelector(
      "[data-create-content]",
    );

  const createCloseButtons =
    Array.from(
      page.querySelectorAll(
        "[data-create-close]",
      ),
    );

  const toast =
    page.querySelector(
      "[data-toast]",
    );

  const toastMessage =
    page.querySelector(
      "[data-toast-message]",
    );

  let selectedContentId = null;
  let toastTimer = null;

  function getContent(id) {
    return contents.find(
      (content) =>
        content.id === id,
    );
  }

  function updateFilters() {
    const query =
      searchInput instanceof
      HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const status =
      statusFilter instanceof
      HTMLSelectElement
        ? statusFilter.value
        : "all";

    const type =
      typeFilter instanceof
      HTMLSelectElement
        ? typeFilter.value
        : "all";

    const visibility =
      visibilityFilter instanceof
      HTMLSelectElement
        ? visibilityFilter.value
        : "all";

    const visibleRows =
      rows.filter(
        (row) => {
          const title =
            row.getAttribute(
              "data-title",
            ) ?? "";

          const description =
            row.getAttribute(
              "data-description",
            ) ?? "";

          const typeValue =
            row.getAttribute(
              "data-type",
            ) ?? "";

          const typeLabel =
            row.getAttribute(
              "data-type-label",
            ) ?? "";

          const rowStatus =
            row.getAttribute(
              "data-status",
            ) ?? "";

          const author =
            row.getAttribute(
              "data-author",
            ) ?? "";

          const rowVisibility =
            row.getAttribute(
              "data-visibility",
            ) ?? "";

          const matchesSearch =
            query === "" ||
            title.includes(query) ||
            description.includes(query) ||
            typeLabel.includes(query) ||
            author.includes(query);

          const matchesStatus =
            status === "all" ||
            rowStatus === status;

          const matchesType =
            type === "all" ||
            typeValue === type;

          const matchesVisibility =
            visibility === "all" ||
            rowVisibility === visibility;

          return (
            matchesSearch &&
            matchesStatus &&
            matchesType &&
            matchesVisibility
          );
        },
      );

    rows.forEach(
      (row) => {
        row.setAttribute(
          "data-hidden",
          visibleRows.includes(
            row,
          )
            ? "false"
            : "true",
        );
      },
    );

    if (
      resultCount instanceof HTMLElement
    ) {
      resultCount.textContent =
        `${visibleRows.length} konten`;
    }

    if (
      footerCount instanceof HTMLElement
    ) {
      footerCount.textContent =
        String(
          visibleRows.length,
        );
    }

    if (
      emptyState instanceof HTMLElement
    ) {
      emptyState.hidden =
        visibleRows.length !== 0;
    }

    if (
      clearSearch instanceof HTMLButtonElement
    ) {
      clearSearch.hidden =
        !(
          searchInput instanceof HTMLInputElement &&
          searchInput.value.length > 0
        );
    }
  }

  function resetFilters() {
    if (
      searchInput instanceof HTMLInputElement
    ) {
      searchInput.value = "";
    }

    if (
      statusFilter instanceof HTMLSelectElement
    ) {
      statusFilter.value = "all";
    }

    if (
      typeFilter instanceof HTMLSelectElement
    ) {
      typeFilter.value = "all";
    }

    if (
      visibilityFilter instanceof HTMLSelectElement
    ) {
      visibilityFilter.value = "all";
    }

    updateFilters();
  }

  function showToast(message) {
    if (
      !(toast instanceof HTMLElement) ||
      !(toastMessage instanceof HTMLElement)
    ) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.hidden = false;

    if (
      toastTimer !== null
    ) {
      window.clearTimeout(
        toastTimer,
      );
    }

    toastTimer =
      window.setTimeout(
        () => {
          toast.hidden = true;
          toastTimer = null;
        },
        2800,
      );
  }

  function setStatusBadge(
    element,
    content,
  ) {
    if (
      !(element instanceof HTMLElement)
    ) {
      return;
    }

    element.className =
      `status-badge status-badge--${content.status}`;

    element.textContent =
      content.statusLabel;
  }

  function setVisibilityBadge(
    element,
    content,
  ) {
    if (
      !(element instanceof HTMLElement)
    ) {
      return;
    }

    element.className =
      `visibility-badge visibility-badge--${content.visibility}`;

    element.textContent =
      content.visibility ===
      "public"
        ? "Publik"
        : "Privat";
  }

  function updateDrawerAction(
    content,
  ) {
    if (
      !(drawerPublish instanceof HTMLButtonElement)
    ) {
      return;
    }

    drawerPublish.disabled =
      false;

    drawerPublish.className =
      "button button--primary";

    if (
      content.status ===
      "published"
    ) {
      drawerPublish.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>Sudah terbit</span>
      `;

      drawerPublish.disabled =
        true;

      return;
    }

    if (
      content.status ===
      "archived"
    ) {
      drawerPublish.className =
        "button button--secondary";

      drawerPublish.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18"/>
          <path d="M8 6V4h8v2"/>
          <path d="M19 6v14H5V6"/>
        </svg>
        <span>Diarsipkan</span>
      `;

      drawerPublish.disabled =
        true;

      return;
    }

    drawerPublish.innerHTML = `
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12"/>
        <path d="m7 8 5-5 5 5"/>
        <path d="M5 21h14"/>
      </svg>
      <span>Terbitkan</span>
    `;
  }

  function populateDrawer(
    content,
  ) {
    if (!content) {
      return;
    }

    if (
      drawerTitle instanceof HTMLElement
    ) {
      drawerTitle.textContent =
        content.title;
    }

    if (
      drawerType instanceof HTMLElement
    ) {
      drawerType.textContent =
        content.typeLabel;
    }

    setStatusBadge(
      drawerStatus,
      content,
    );

    setVisibilityBadge(
      drawerVisibility,
      content,
    );

    if (
      drawerDescription instanceof HTMLElement
    ) {
      drawerDescription.textContent =
        content.description;
    }

    if (
      drawerAuthor instanceof HTMLElement
    ) {
      drawerAuthor.textContent =
        content.author;
    }

    if (
      drawerCreated instanceof HTMLElement
    ) {
      drawerCreated.textContent =
        content.createdAt;
    }

    if (
      drawerUpdated instanceof HTMLElement
    ) {
      drawerUpdated.textContent =
        content.updatedAt;
    }

    if (
      drawerPublicationTitle instanceof HTMLElement
    ) {
      drawerPublicationTitle.textContent =
        content.visibility ===
        "public"
          ? "Konten publik"
          : "Konten privat";
    }

    if (
      drawerPublicationCopy instanceof HTMLElement
    ) {
      drawerPublicationCopy.textContent =
        content.visibility ===
        "public"
          ? "Konten ini ditujukan untuk pengalaman publik BINSIGHT."
          : "Konten ini tidak ditujukan sebagai informasi publik utama.";
    }

    if (
      drawerLink instanceof HTMLElement
    ) {
      drawerLink.textContent =
        `/content/${content.id}`;
    }

    updateDrawerAction(
      content,
    );
  }

  function openDrawer(id) {
    const content =
      getContent(id);

    if (
      !content ||
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    selectedContentId =
      id;

    populateDrawer(
      content,
    );

    drawer.hidden =
      false;

    drawerBackdrop.hidden =
      false;

    window.requestAnimationFrame(
      () => {
        drawer.setAttribute(
          "data-open",
          "true",
        );

        drawer.setAttribute(
          "aria-hidden",
          "false",
        );
      },
    );

    document.documentElement.style.overflow =
      "hidden";
  }

  function closeDrawer() {
    if (
      !(drawer instanceof HTMLElement) ||
      !(drawerBackdrop instanceof HTMLElement)
    ) {
      return;
    }

    drawer.setAttribute(
      "data-open",
      "false",
    );

    drawer.setAttribute(
      "aria-hidden",
      "true",
    );

    window.setTimeout(
      () => {
        drawer.hidden =
          true;

        drawerBackdrop.hidden =
          true;
      },
      190,
    );

    document.documentElement.style.overflow =
      "";

    selectedContentId =
      null;
  }

  function editContent(id) {
    const content =
      getContent(id);

    if (!content) {
      return;
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-content-edit",
        {
          detail: {
            ...content,
          },
        },
      ),
    );

    showToast(
      `Mode edit untuk "${content.title}" dipersiapkan.`,
    );
  }

  function publishContent() {
    if (!selectedContentId) {
      return;
    }

    const content =
      getContent(
        selectedContentId,
      );

    if (!content) {
      return;
    }

    if (
      content.status ===
      "published"
    ) {
      showToast(
        "Konten ini sudah berstatus terbit.",
      );
      return;
    }

    if (
      content.status ===
      "archived"
    ) {
      showToast(
        "Konten arsip tidak dapat langsung diterbitkan.",
      );
      return;
    }

    content.status =
      "published";

    content.statusLabel =
      "Terbit";

    content.updatedAt =
      "10 Sep 2026, sekarang";

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) === content.id,
      );

    if (
      row instanceof HTMLElement
    ) {
      row.setAttribute(
        "data-status",
        content.status,
      );

      const statusBadge =
        row.querySelector(
          ".status-badge",
        );

      setStatusBadge(
        statusBadge,
        content,
      );
    }

    populateDrawer(
      content,
    );

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-content-publish",
        {
          detail: {
            ...content,
          },
        },
      ),
    );

    showToast(
      `"${content.title}" ditandai sebagai terbit.`,
    );

    updateFilters();
  }

  function archiveContent(
    id,
  ) {
    const content =
      getContent(id);

    if (!content) {
      return;
    }

    if (
      content.status ===
      "archived"
    ) {
      showToast(
        "Konten ini sudah diarsipkan.",
      );
      return;
    }

    content.status =
      "archived";

    content.statusLabel =
      "Arsip";

    content.visibility =
      "private";

    content.updatedAt =
      "10 Sep 2026, sekarang";

    const row =
      rows.find(
        (candidate) =>
          candidate.getAttribute(
            "data-id",
          ) === content.id,
      );

    if (
      row instanceof HTMLElement
    ) {
      row.setAttribute(
        "data-status",
        content.status,
      );

      row.setAttribute(
        "data-visibility",
        content.visibility,
      );

      const statusBadge =
        row.querySelector(
          ".status-badge",
        );

      const visibilityBadge =
        row.querySelector(
          ".visibility-badge",
        );

      setStatusBadge(
        statusBadge,
        content,
      );

      setVisibilityBadge(
        visibilityBadge,
        content,
      );
    }

    window.dispatchEvent(
      new CustomEvent(
        "binsight:admin-content-archive",
        {
          detail: {
            ...content,
          },
        },
      ),
    );

    if (
      selectedContentId ===
      content.id
    ) {
      populateDrawer(
        content,
      );
    }

    showToast(
      `"${content.title}" diarsipkan.`,
    );

    updateFilters();
  }

  function openCreateModal() {
    if (
      !(createModal instanceof HTMLElement)
    ) {
      return;
    }

    createModal.hidden =
      false;

    createModal.setAttribute(
      "aria-hidden",
      "false",
    );

    document.documentElement.style.overflow =
      "hidden";

    const firstInput =
      createModal.querySelector(
        'input[name="title"]',
      );

    if (
      firstInput instanceof HTMLInputElement
    ) {
      window.setTimeout(
        () =>
          firstInput.focus(),
        0,
      );
    }
  }

  function closeCreateModal() {
    if (
      !(createModal instanceof HTMLElement)
    ) {
      return;
    }

    createModal.hidden =
      true;

    createModal.setAttribute(
      "aria-hidden",
      "true",
    );

    document.documentElement.style.overflow =
      "";
  }

  createContentButton?.addEventListener(
    "click",
    openCreateModal,
  );

  createCloseButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        closeCreateModal,
      );
    },
  );

  createForm?.addEventListener(
    "submit",
    (event) => {
      event.preventDefault();

      if (
        !(createForm instanceof HTMLFormElement)
      ) {
        return;
      }

      const formData =
        new FormData(
          createForm,
        );

      const title =
        String(
          formData.get(
            "title",
          ) ?? "",
        ).trim();

      const description =
        String(
          formData.get(
            "description",
          ) ?? "",
        ).trim();

      const type =
        String(
          formData.get(
            "type",
          ) ?? "page",
        );

      const visibility =
        String(
          formData.get(
            "visibility",
          ) ?? "public",
        );

      if (
        !title ||
        !description
      ) {
        showToast(
          "Judul dan deskripsi wajib diisi.",
        );

        return;
      }

      const typeMap = {
        page: "Halaman",
        article: "Artikel",
        guide: "Panduan",
        media: "Media",
      };

      window.dispatchEvent(
        new CustomEvent(
          "binsight:admin-content-create",
          {
            detail: {
              title,
              description,
              type,
              typeLabel:
                typeMap[
                  type
                ] ?? "Halaman",
              visibility,
              status:
                "draft",
              statusLabel:
                "Draft",
            },
          },
        ),
      );

      closeCreateModal();

      createForm.reset();

      showToast(
        `"${title}" disiapkan sebagai draft.`,
      );
    },
  );

  searchInput?.addEventListener(
    "input",
    updateFilters,
  );

  statusFilter?.addEventListener(
    "change",
    updateFilters,
  );

  typeFilter?.addEventListener(
    "change",
    updateFilters,
  );

  visibilityFilter?.addEventListener(
    "change",
    updateFilters,
  );

  clearSearch?.addEventListener(
    "click",
    () => {
      if (
        searchInput instanceof HTMLInputElement
      ) {
        searchInput.value =
          "";

        searchInput.focus();
      }

      updateFilters();
    },
  );

  emptyReset?.addEventListener(
    "click",
    resetFilters,
  );

  page
    .querySelectorAll(
      "[data-view]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              openDrawer(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-edit]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              editContent(id);
            }
          },
        );
      },
    );

  page
    .querySelectorAll(
      "[data-archive]",
    )
    .forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const id =
              button.getAttribute(
                "data-record",
              );

            if (id) {
              archiveContent(id);
            }
          },
        );
      },
    );

  drawerClose?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerBackdrop?.addEventListener(
    "click",
    closeDrawer,
  );

  drawerEdit?.addEventListener(
    "click",
    () => {
      if (
        selectedContentId
      ) {
        editContent(
          selectedContentId,
        );
      }
    },
  );

  drawerPublish?.addEventListener(
    "click",
    publishContent,
  );

  page
    .querySelector(
      "[data-refresh]",
    )
    ?.addEventListener(
      "click",
      () => {
        updateFilters();

        showToast(
          "Daftar konten diperbarui.",
        );
      },
    );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key !== "Escape"
      ) {
        return;
      }

      if (
        drawer instanceof HTMLElement &&
        drawer.getAttribute(
          "data-open",
        ) === "true"
      ) {
        closeDrawer();
        return;
      }

      if (
        createModal instanceof HTMLElement &&
        !createModal.hidden
      ) {
        closeCreateModal();
      }
    },
  );

  updateFilters();
</script>