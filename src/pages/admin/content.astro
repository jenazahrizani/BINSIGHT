---
import {
  CircleCheck,
  Clock3,
  Eye,
  FileText,
  FolderOpen,
  Globe,
  Image,
  Link2,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  Trash2,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

type ContentStatus =
  | "published"
  | "draft"
  | "archived";

type ContentType =
  | "page"
  | "article"
  | "guide"
  | "media";

interface ContentRecord {
  id: string;
  title: string;
  description: string;
  type: ContentType;
  typeLabel: string;
  status: ContentStatus;
  statusLabel: string;
  author: string;
  updatedAt: string;
  createdAt: string;
  visibility: "public" | "private";
}

const contents: ContentRecord[] = [
  {
    id: "content-demo-001",
    title: "Tentang BINSIGHT",
    description:
      "Informasi mengenai tujuan, fungsi, dan peran BINSIGHT dalam ekosistem persampahan Badung.",
    type: "page",
    typeLabel: "Halaman",
    status: "published",
    statusLabel: "Terbit",
    author: "Admin BINSIGHT",
    updatedAt: "10 Sep 2026, 09:40",
    createdAt: "1 Sep 2026",
    visibility: "public",
  },
  {
    id: "content-demo-002",
    title: "Panduan Pemilahan Sampah Rumah Tangga",
    description:
      "Panduan dasar untuk memahami dan memilah sampah sebelum diserahkan kepada pengelola.",
    type: "guide",
    typeLabel: "Panduan",
    status: "published",
    statusLabel: "Terbit",
    author: "Editor Konten",
    updatedAt: "9 Sep 2026, 15:25",
    createdAt: "3 Sep 2026",
    visibility: "public",
  },
  {
    id: "content-demo-003",
    title: "Mengenal Sampah Elektronik",
    description:
      "Konten edukasi tentang perangkat elektronik dan pentingnya penanganan khusus.",
    type: "article",
    typeLabel: "Artikel",
    status: "draft",
    statusLabel: "Draft",
    author: "Editor Konten",
    updatedAt: "9 Sep 2026, 12:10",
    createdAt: "7 Sep 2026",
    visibility: "public",
  },
  {
    id: "content-demo-004",
    title: "Peta dan Data Persampahan",
    description:
      "Penjelasan mengenai cara menggunakan peta dan membaca data ekosistem BINSIGHT.",
    type: "article",
    typeLabel: "Artikel",
    status: "published",
    statusLabel: "Terbit",
    author: "Admin BINSIGHT",
    updatedAt: "8 Sep 2026, 17:05",
    createdAt: "2 Sep 2026",
    visibility: "public",
  },
  {
    id: "content-demo-005",
    title: "Materi Program Lama",
    description:
      "Konten lama yang tidak lagi menjadi bagian dari informasi publik utama.",
    type: "page",
    typeLabel: "Halaman",
    status: "archived",
    statusLabel: "Arsip",
    author: "Admin BINSIGHT",
    updatedAt: "5 Sep 2026, 10:35",
    createdAt: "1 Sep 2026",
    visibility: "private",
  },
  {
    id: "content-demo-006",
    title: "Asset Foto Ekosistem Badung",
    description:
      "Kumpulan media pendukung untuk kebutuhan konten dan visualisasi platform.",
    type: "media",
    typeLabel: "Media",
    status: "published",
    statusLabel: "Terbit",
    author: "Admin BINSIGHT",
    updatedAt: "4 Sep 2026, 14:22",
    createdAt: "2 Sep 2026",
    visibility: "private",
  },
];

const statusLabels: Record<
  ContentStatus,
  string
> = {
  published: "Terbit",
  draft: "Draft",
  archived: "Arsip",
};

const typeLabels: Record<
  ContentType,
  string
> = {
  page: "Halaman",
  article: "Artikel",
  guide: "Panduan",
  media: "Media",
};

const totalContent = contents.length;

const publishedCount = contents.filter(
  (item) =>
    item.status === "published",
).length;

const draftCount = contents.filter(
  (item) =>
    item.status === "draft",
).length;

const archivedCount = contents.filter(
  (item) =>
    item.status === "archived",
).length;

const publicCount = contents.filter(
  (item) =>
    item.visibility === "public",
).length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Konten — Admin BINSIGHT",
  description:
    "Administrasi konten BINSIGHT untuk halaman, artikel, panduan, dan media.",
  url: "https://binsight.id/admin/content",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Konten"
  description="Kelola halaman, artikel, panduan, dan media BINSIGHT."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main
    class="content-page"
    data-content-page
  >
    <header class="page-top">
      <div class="page-top__main">
        <div class="page-top__eyebrow">
          <span class="page-top__eyebrow-icon">
            <FolderOpen
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span>CONTENT MANAGEMENT</span>
        </div>

        <h1>Konten</h1>

        <p>
          Kelola materi informasi BINSIGHT yang digunakan untuk edukasi,
          navigasi publik, dan komunikasi platform.
        </p>
      </div>

      <div class="page-top__actions">
        <button
          type="button"
          class="button button--secondary"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>Refresh</span>
        </button>

        <a
          href="/"
          class="button button--ghost"
        >
          <Eye
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <span>Lihat publik</span>
        </a>

        <button
          type="button"
          class="button button--primary"
          data-create-content
        >
          <Plus
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>Tambah konten</span>
        </button>
      </div>
    </header>

    <section
      class="summary-grid"
      aria-label="Ringkasan konten"
    >
      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Total konten
          </span>

          <span class="summary-card__icon summary-card__icon--green">
            <FileText
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {totalContent}
        </strong>

        <span class="summary-card__meta">
          Semua record konten
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Terbit
          </span>

          <span class="summary-card__icon summary-card__icon--published">
            <CircleCheck
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {publishedCount}
        </strong>

        <span class="summary-card__meta">
          Konten tersedia untuk publik
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Draft
          </span>

          <span class="summary-card__icon summary-card__icon--draft">
            <Clock3
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {draftCount}
        </strong>

        <span class="summary-card__meta">
          Belum dipublikasikan
        </span>
      </article>

      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__label">
            Arsip
          </span>

          <span class="summary-card__icon summary-card__icon--archived">
            <FolderOpen
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <strong class="summary-card__value">
          {archivedCount}
        </strong>

        <span class="summary-card__meta">
          Tidak menjadi konten aktif
        </span>
      </article>
    </section>

    <section class="publication-strip">
      <div class="publication-strip__icon">
        <Globe
          size={21}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </div>

      <div class="publication-strip__content">
        <span class="publication-strip__eyebrow">
          PUBLICATION CONTROL
        </span>

        <strong>
          {publicCount} konten ditandai publik
        </strong>

        <p>
          Hanya konten yang sudah diperiksa dan berstatus terbit yang
          seharusnya digunakan sebagai informasi publik utama.
        </p>
      </div>

      <span class="publication-strip__status">
        <ShieldCheck
          size={14}
          stroke-width={2}
          aria-hidden="true"
        />

        Editorial workflow
      </span>
    </section>

    <section class="workspace-card">
      <div class="toolbar">
        <div class="toolbar__search">
          <Search
            size={17}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="content-search"
          >
            Cari konten
          </label>

          <input
            id="content-search"
            type="search"
            placeholder="Cari judul, deskripsi, tipe, atau author..."
            autocomplete="off"
            data-search
          />

          <button
            type="button"
            class="toolbar__clear"
            aria-label="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar__filters">
          <label class="filter-control">
            <span class="sr-only">
              Filter status
            </span>

            <select
              aria-label="Filter status konten"
              data-status-filter
            >
              <option value="all">
                Semua status
              </option>

              {
                Object.entries(statusLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="sr-only">
              Filter tipe
            </span>

            <select
              aria-label="Filter tipe konten"
              data-type-filter
            >
              <option value="all">
                Semua tipe
              </option>

              {
                Object.entries(typeLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="sr-only">
              Filter visibility
            </span>

            <select
              aria-label="Filter visibilitas"
              data-visibility-filter
            >
              <option value="all">
                Semua visibilitas
              </option>

              <option value="public">
                Publik
              </option>

              <option value="private">
                Privat
              </option>
            </select>
          </label>
        </div>
      </div>

      <div class="table-head">
        <div>
          <span class="table-head__eyebrow">
            CONTENT DIRECTORY
          </span>

          <h2>
            Daftar konten
          </h2>
        </div>

        <span
          class="result-count"
          data-result-count
        >
          {totalContent} konten
        </span>
      </div>

      <div class="table-wrap">
        <table class="content-table">
          <caption class="sr-only">
            Daftar konten BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Konten
              </th>

              <th scope="col">
                Tipe
              </th>

              <th scope="col">
                Author
              </th>

              <th scope="col">
                Visibilitas
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Diperbarui
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              contents.map((content) => (
                <tr
                  data-content-row
                  data-id={content.id}
                  data-title={content.title.toLowerCase()}
                  data-description={content.description.toLowerCase()}
                  data-type={content.type}
                  data-type-label={content.typeLabel.toLowerCase()}
                  data-status={content.status}
                  data-author={content.author.toLowerCase()}
                  data-visibility={content.visibility}
                >
                  <td>
                    <div class="content-cell">
                      <span
                        class:list={[
                          "content-cell__icon",
                          `content-cell__icon--${content.type}`,
                        ]}
                      >
                        {content.type === "media" ? (
                          <Image
                            size={17}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        ) : content.type === "guide" ? (
                          <FolderOpen
                            size={17}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        ) : (
                          <FileText
                            size={17}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        )}
                      </span>

                      <div class="content-cell__copy">
                        <strong>
                          {content.title}
                        </strong>

                        <span>
                          {content.description}
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>
                    <span class="type-label">
                      {content.typeLabel}
                    </span>
                  </td>

                  <td>
                    <span class="author-label">
                      {content.author}
                    </span>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "visibility-badge",
                        `visibility-badge--${content.visibility}`,
                      ]}
                    >
                      {content.visibility ===
                      "public" ? (
                        <Globe
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : (
                        <ShieldCheck
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      )}

                      <span>
                        {
                          content.visibility ===
                          "public"
                            ? "Publik"
                            : "Privat"
                        }
                      </span>
                    </span>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "status-badge",
                        `status-badge--${content.status}`,
                      ]}
                    >
                      {content.status ===
                      "published" ? (
                        <CircleCheck
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : content.status ===
                        "draft" ? (
                        <Clock3
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : (
                        <FolderOpen
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      )}

                      <span>
                        {content.statusLabel}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span class="updated-label">
                      {content.updatedAt}
                    </span>
                  </td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Lihat ${content.title}`}
                        data-view
                        data-record={content.id}
                      >
                        <Eye
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>

                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Edit ${content.title}`}
                        data-edit
                        data-record={content.id}
                      >
                        <Pencil
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>

                      <button
                        type="button"
                        class="row-action row-action--danger"
                        aria-label={`Arsipkan ${content.title}`}
                        data-archive
                        data-record={content.id}
                      >
                        <Trash2
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
        >
          <span class="empty-state__icon">
            <Search
              size={23}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>

          <h3>
            Konten tidak ditemukan
          </h3>

          <p>
            Tidak ada konten yang cocok dengan pencarian atau filter
            yang digunakan.
          </p>

          <button
            type="button"
            class="button button--secondary"
            data-empty-reset
          >
            Reset filter
          </button>
        </div>
      </div>

      <footer class="table-footer">
        <span>
          <strong data-footer-count>
            {totalContent}
          </strong>
          konten ditampilkan
        </span>

        <span>
          Content directory
        </span>
      </footer>
    </section>

    <section class="workflow-grid">
      <article class="workflow-card">
        <div class="workflow-card__icon workflow-card__icon--draft">
          <Pencil
            size={19}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </div>

        <div>
          <span class="workflow-card__eyebrow">
            01 · DRAFT
          </span>

          <h2>
            Tulis dan revisi
          </h2>

          <p>
            Materi baru sebaiknya disimpan sebagai draft sampai isi,
            struktur, dan tautan diperiksa.
          </p>
        </div>
      </article>

      <article class="workflow-card">
        <div class="workflow-card__icon workflow-card__icon--review">
          <ShieldCheck
            size={19}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </div>

        <div>
          <span class="workflow-card__eyebrow">
            02 · REVIEW
          </span>

          <h2>
            Periksa sebelum terbit
          </h2>

          <p>
            Pastikan informasi sesuai konteks BINSIGHT dan tidak
            menyajikan data yang tidak terverifikasi.
          </p>
        </div>
      </article>

      <article class="workflow-card">
        <div class="workflow-card__icon workflow-card__icon--published">
          <Globe
            size={19}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </div>

        <div>
          <span class="workflow-card__eyebrow">
            03 · PUBLISHED
          </span>

          <h2>
            Publikasikan
          </h2>

          <p>
            Konten terbit menjadi bagian dari pengalaman publik dan
            harus dijaga relevansinya dari waktu ke waktu.
          </p>
        </div>
      </article>
    </section>

    <aside
      class="content-drawer"
      data-drawer
      aria-hidden="true"
      hidden
      aria-labelledby="drawer-title"
    >
      <div class="drawer__header">
        <div>
          <span class="drawer__eyebrow">
            CONTENT DETAIL
          </span>

          <h2 id="drawer-title">
            Detail konten
          </h2>
        </div>

        <button
          type="button"
          class="drawer__close"
          aria-label="Tutup detail konten"
          data-drawer-close
        >
          <X
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />
        </button>
      </div>

      <div class="drawer__body">
        <div class="drawer-identity">
          <span
            class="drawer-identity__icon"
            data-drawer-icon
          >
            <FileText
              size={21}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <div>
            <h3 data-drawer-title>
              -
            </h3>

            <span data-drawer-type>
              -
            </span>
          </div>
        </div>

        <div class="drawer-badges">
          <span
            class="status-badge"
            data-drawer-status
          >
            -
          </span>

          <span
            class="visibility-badge"
            data-drawer-visibility
          >
            -
          </span>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            INFORMASI
          </span>

          <p
            class="drawer-description"
            data-drawer-description
          >
            -
          </p>

          <dl class="detail-list">
            <div>
              <dt>
                Author
              </dt>

              <dd data-drawer-author>
                -
              </dd>
            </div>

            <div>
              <dt>
                Dibuat
              </dt>

              <dd data-drawer-created>
                -
              </dd>
            </div>

            <div>
              <dt>
                Diperbarui
              </dt>

              <dd data-drawer-updated>
                -
              </dd>
            </div>
          </dl>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            PUBLICATION
          </span>

          <div class="publication-box">
            <div class="publication-box__icon">
              <Globe
                size={18}
                stroke-width={1.9}
                aria-hidden="true"
              />
            </div>

            <div>
              <strong data-drawer-publication-title>
                Publik
              </strong>

              <p data-drawer-publication-copy>
                Konten tersedia untuk pengalaman publik.
              </p>
            </div>
          </div>
        </div>

        <div class="drawer-section">
          <span class="drawer-section__label">
            LINK
          </span>

          <div class="preview-link">
            <Link2
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />

            <span data-drawer-link>
              /content
            </span>
          </div>
        </div>
      </div>

      <div class="drawer__footer">
        <button
          type="button"
          class="button button--secondary"
          data-drawer-edit
        >
          <Pencil
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <span>
            Edit
          </span>
        </button>

        <button
          type="button"
          class="button button--primary"
          data-drawer-publish
        >
          <Globe
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <span>
            Terbitkan
          </span>
        </button>
      </div>
    </aside>

    <div
      class="drawer-backdrop"
      data-drawer-backdrop
      hidden
    ></div>

    <div
      class="modal"
      data-create-modal
      hidden
      aria-hidden="true"
    >
      <div
        class="modal__backdrop"
        data-create-close
      ></div>

      <div
        class="modal__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="create-content-title"
      >
        <div class="modal__header">
          <div>
            <span class="modal__eyebrow">
              CONTENT MANAGEMENT
            </span>

            <h2 id="create-content-title">
              Tambah konten
            </h2>

            <p>
              Siapkan metadata dasar untuk konten baru.
            </p>
          </div>

          <button
            type="button"
            class="modal__close"
