          stroke-width={1.9}
          aria-hidden="true"
        />

        <span>
          Edit
        </span>
      </button>

      <button
        type="button"
        class="button button--acid"
        data-drawer-publish
      >
        <Globe
          size={16}
          stroke-width={1.9}
          aria-hidden="true"
        />

        <span>
          Terbitkan
        </span>
      </button>
    </div>
  </aside>

  <div
    class="drawer-backdrop"
    data-drawer-backdrop
    hidden
  ></div>

  <!-- ==============================================================
       CREATE MODAL
  ============================================================== -->
  <div
    class="modal"
    data-create-modal
    hidden
    aria-hidden="true"
  >
    <div
      class="modal__backdrop"
      data-create-close
    ></div>

    <div
      class="modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="create-content-title"
    >
      <div class="modal__header">
        <div>
          <span class="modal__eyebrow">
            CONTENT MANAGEMENT
          </span>

          <h2 id="create-content-title">
            Tambah konten
          </h2>

          <p>
            Siapkan metadata dasar untuk konten baru.
          </p>
        </div>

        <button
          type="button"
          class="modal__close"
          aria-label="Tutup form"
          title="Tutup"
          data-create-close
        >
          <X
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />
        </button>
      </div>

      <form
        class="content-form"
        data-create-form
      >
        <label class="form-field">
          <span>
            Judul
          </span>

          <input
            type="text"
            name="title"
            placeholder="Judul konten"
            required
            autocomplete="off"
          />
        </label>

        <label class="form-field">
          <span>
            Deskripsi
          </span>

          <textarea
            name="description"
            rows="4"
            placeholder="Ringkasan singkat konten..."
            required
          ></textarea>
        </label>

        <div class="form-grid">
          <label class="form-field">
            <span>
              Tipe
            </span>

            <select
              name="type"
              required
            >
              <option value="page">
                Halaman
              </option>

              <option value="article">
                Artikel
              </option>

              <option value="guide">
                Panduan
              </option>

              <option value="media">
                Media
              </option>
            </select>
          </label>

          <label class="form-field">
            <span>
              Visibilitas
            </span>

            <select
              name="visibility"
              required
            >
              <option value="public">
                Publik
              </option>

              <option value="private">
                Privat
              </option>
            </select>
          </label>
        </div>

        <div class="form-note">
          <ShieldCheck
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <span>
            Penyimpanan backend belum diaktifkan pada halaman ini.
            Submit hanya menyiapkan event untuk layer data.
          </span>
        </div>

        <div class="modal__footer">
          <button
            type="button"
            class="button button--paper"
            data-create-close
          >
            Batal
          </button>

          <button
            type="submit"
            class="button button--acid"
          >
            <Plus
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Siapkan konten
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==============================================================
       TOAST
  ============================================================== -->
  <div
    class="toast"
    data-toast
    hidden
    role="status"
    aria-live="polite"
  >
    <CircleCheck
      size={17}
      stroke-width={2}
      aria-hidden="true"
    />

    <span data-toast-message>
      Berhasil
    </span>
  </div>
</AdminLayout>

