---
/**
 * BINSIGHT — ADMIN CONTENT
 * --------------------------------------------------------------------------
 * Content management workspace for BINSIGHT.
 *
 * Design baseline:
 * - BINSIGHT editorial / brutalist visual language
 * - Page-owned hierarchy
 * - No duplicate admin header
 * - No page-level vertical scroll container
 * - Main page uses the AdminLayout document scroll
 * - Sidebar behavior belongs exclusively to AdminLayout
 * - Square edges, hard borders, offset shadows
 * - Lime / ink / orange accent system
 * - Responsive without horizontal overflow
 *
 * Data note:
 * - This page currently uses local demo records.
 * - No backend write operation is invented here.
 * - Client actions emit BINSIGHT custom events and update local UI state.
 * --------------------------------------------------------------------------
 */

import {
  CircleCheck,
  Clock3,
  Eye,
  FileText,
  FolderOpen,
  Globe,
  Image,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  Trash2,
  X,
} from "@lucide/astro";

import AdminLayout from "../../layouts/AdminLayout.astro";

type ContentStatus =
  | "published"
  | "draft"
  | "archived";

type ContentType =
  | "page"
  | "article"
  | "guide"
  | "media";

interface ContentRecord {
  id: string;
  title: string;
  description: string;
  type: ContentType;
  typeLabel: string;
  status: ContentStatus;
  statusLabel: string;
  author: string;
  updatedAt: string;
  createdAt: string;
  visibility: "public" | "private";
}

const contents: ContentRecord[] = [
  {
    id: "content-demo-001",
    title: "Tentang BINSIGHT",
    description:
      "Informasi mengenai tujuan, fungsi, dan peran BINSIGHT dalam ekosistem persampahan Badung.",
    type: "page",
    typeLabel: "Halaman",
    status: "published",
    statusLabel: "Terbit",
    author: "Admin BINSIGHT",
    updatedAt: "10 Sep 2026, 09:40",
    createdAt: "1 Sep 2026",
    visibility: "public",
  },
  {
    id: "content-demo-002",
    title: "Panduan Pemilahan Sampah Rumah Tangga",
    description:
      "Panduan dasar untuk memahami dan memilah sampah sebelum diserahkan kepada pengelola.",
    type: "guide",
    typeLabel: "Panduan",
    status: "published",
    statusLabel: "Terbit",
    author: "Editor Konten",
    updatedAt: "9 Sep 2026, 15:25",
    createdAt: "3 Sep 2026",
    visibility: "public",
  },
  {
    id: "content-demo-003",
    title: "Mengenal Sampah Elektronik",
    description:
      "Konten edukasi tentang perangkat elektronik dan pentingnya penanganan khusus.",
    type: "article",
    typeLabel: "Artikel",
    status: "draft",
    statusLabel: "Draft",
    author: "Editor Konten",
    updatedAt: "9 Sep 2026, 12:10",
    createdAt: "7 Sep 2026",
    visibility: "public",
  },
  {
    id: "content-demo-004",
    title: "Peta dan Data Persampahan",
    description:
      "Penjelasan mengenai cara menggunakan peta dan membaca data ekosistem BINSIGHT.",
    type: "article",
    typeLabel: "Artikel",
    status: "published",
    statusLabel: "Terbit",
    author: "Admin BINSIGHT",
    updatedAt: "8 Sep 2026, 17:05",
    createdAt: "2 Sep 2026",
    visibility: "public",
  },
  {
    id: "content-demo-005",
    title: "Materi Program Lama",
    description:
      "Konten lama yang tidak lagi menjadi bagian dari informasi publik utama.",
    type: "page",
    typeLabel: "Halaman",
    status: "archived",
    statusLabel: "Arsip",
    author: "Admin BINSIGHT",
    updatedAt: "5 Sep 2026, 10:35",
    createdAt: "1 Sep 2026",
    visibility: "private",
  },
  {
    id: "content-demo-006",
    title: "Asset Foto Ekosistem Badung",
    description:
      "Kumpulan media pendukung untuk kebutuhan konten dan visualisasi platform.",
    type: "media",
    typeLabel: "Media",
    status: "published",
    statusLabel: "Terbit",
    author: "Admin BINSIGHT",
    updatedAt: "4 Sep 2026, 14:22",
    createdAt: "2 Sep 2026",
    visibility: "private",
  },
];

const statusLabels: Record<ContentStatus, string> = {
  published: "Terbit",
  draft: "Draft",
  archived: "Arsip",
};

const typeLabels: Record<ContentType, string> = {
  page: "Halaman",
  article: "Artikel",
  guide: "Panduan",
  media: "Media",
};

const totalContent = contents.length;

const publishedCount = contents.filter(
  (item) => item.status === "published",
).length;

const draftCount = contents.filter(
  (item) => item.status === "draft",
).length;

const archivedCount = contents.filter(
  (item) => item.status === "archived",
).length;

const publicCount = contents.filter(
  (item) => item.visibility === "public",
).length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Konten — Admin BINSIGHT",
  description:
    "Administrasi konten BINSIGHT untuk halaman, artikel, panduan, dan media.",
  url: "https://binsight.id/admin/content",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<AdminLayout
  title="Konten"
  description="Kelola halaman, artikel, panduan, dan media BINSIGHT."
  activeSection="content"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <script
    id="admin-content-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify(contents)}
  />

  <div
    class="content-page"
    data-content-page
  >
    <!-- ============================================================
         PAGE INTRO
    ============================================================= -->
    <section
      class="page-hero"
      aria-labelledby="content-page-title"
    >
      <div class="page-hero__copy">
        <div class="page-hero__eyebrow">
          <span class="page-hero__eyebrow-mark">
            <FolderOpen
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <span>CONTENT MANAGEMENT</span>
        </div>

        <h1 id="content-page-title">
          Konten
        </h1>

        <p>
          Kelola materi informasi BINSIGHT yang digunakan untuk
          edukasi, navigasi publik, dan komunikasi platform.
        </p>
      </div>

      <div class="page-hero__actions">
        <button
          type="button"
          class="button button--paper"
          data-refresh
        >
          <RefreshCw
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />
          <span>Refresh</span>
        </button>

        <a
          href="/"
          class="button button--ghost"
        >
          <Eye
            size={16}
            stroke-width={1.9}
            aria-hidden="true"
          />
          <span>Lihat publik</span>
        </a>

        <button
          type="button"
          class="button button--acid"
          data-create-content
        >
          <Plus
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />
          <span>Tambah konten</span>
        </button>
      </div>
    </section>

    <!-- ============================================================
         SUMMARY
    ============================================================= -->
    <section
      class="summary-grid"
      aria-label="Ringkasan konten"
    >
      <article class="summary-card">
        <div class="summary-card__top">
          <span class="summary-card__index">
            01
          </span>

          <span class="summary-card__icon">
            <FileText
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          TOTAL KONTEN
        </span>

        <strong
          class="summary-card__value"
          data-summary-total
        >
          {totalContent}
        </strong>

        <span class="summary-card__meta">
          Semua record konten
        </span>
      </article>

      <article class="summary-card summary-card--acid">
        <div class="summary-card__top">
          <span class="summary-card__index">
            02
          </span>

          <span class="summary-card__icon">
            <CircleCheck
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          TERBIT
        </span>

        <strong
          class="summary-card__value"
          data-summary-published
        >
          {publishedCount}
        </strong>

        <span class="summary-card__meta">
          Konten berstatus terbit
        </span>
      </article>

      <article class="summary-card summary-card--orange">
        <div class="summary-card__top">
          <span class="summary-card__index">
            03
          </span>

          <span class="summary-card__icon">
            <Clock3
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          DRAFT
        </span>

        <strong
          class="summary-card__value"
          data-summary-draft
        >
          {draftCount}
        </strong>

        <span class="summary-card__meta">
          Belum dipublikasikan
        </span>
      </article>

      <article class="summary-card summary-card--muted">
        <div class="summary-card__top">
          <span class="summary-card__index">
            04
          </span>

          <span class="summary-card__icon">
            <FolderOpen
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>
        </div>

        <span class="summary-card__label">
          ARSIP
        </span>

        <strong
          class="summary-card__value"
          data-summary-archived
        >
          {archivedCount}
        </strong>

        <span class="summary-card__meta">
          Tidak menjadi konten aktif
        </span>
      </article>
    </section>

    <!-- ============================================================
         PUBLICATION CONTROL
    ============================================================= -->
    <section
      class="publication-strip"
      aria-label="Kontrol publikasi"
    >
      <div class="publication-strip__mark">
        <Globe
          size={21}
          stroke-width={1.9}
          aria-hidden="true"
        />
      </div>

      <div class="publication-strip__content">
        <span class="publication-strip__eyebrow">
          PUBLICATION CONTROL
        </span>

        <strong>
          <span data-public-count>
            {publicCount}
          </span>
          konten ditandai publik
        </strong>

        <p>
          Hanya konten yang sudah diperiksa dan berstatus terbit yang
          seharusnya digunakan sebagai informasi publik utama.
        </p>
      </div>

      <span class="publication-strip__status">
        <ShieldCheck
          size={14}
          stroke-width={2}
          aria-hidden="true"
        />
        Editorial workflow
      </span>
    </section>

    <!-- ============================================================
         CONTENT DIRECTORY
    ============================================================= -->
    <section
      class="directory"
      aria-labelledby="content-directory-title"
    >
      <div class="directory__top">
        <div class="directory__title">
          <span class="directory__eyebrow">
            CONTENT DIRECTORY
          </span>

          <h2 id="content-directory-title">
            Daftar konten
          </h2>
        </div>

        <span
          class="directory__count"
          data-result-count
        >
          {totalContent} record
        </span>
      </div>

      <div class="toolbar">
        <div class="toolbar__search">
          <Search
            size={17}
            stroke-width={1.9}
            aria-hidden="true"
          />

          <label
            class="sr-only"
            for="content-search"
          >
            Cari konten
          </label>

          <input
            id="content-search"
            type="search"
            placeholder="Cari judul, deskripsi, tipe, atau author..."
            autocomplete="off"
            spellcheck="false"
            data-search
          />

          <button
            type="button"
            class="toolbar__clear"
            aria-label="Hapus pencarian"
            title="Hapus pencarian"
            data-clear-search
            hidden
          >
            <X
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />
          </button>
        </div>

        <div class="toolbar__filters">
          <label class="filter-control">
            <span class="filter-control__label">
              STATUS
            </span>

            <select
              aria-label="Filter status konten"
              data-status-filter
            >
              <option value="all">
                Semua
              </option>

              {
                Object.entries(statusLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="filter-control__label">
              TIPE
            </span>

            <select
              aria-label="Filter tipe konten"
              data-type-filter
            >
              <option value="all">
                Semua
              </option>

              {
                Object.entries(typeLabels).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>
          </label>

          <label class="filter-control">
            <span class="filter-control__label">
              VISIBILITAS
            </span>

            <select
              aria-label="Filter visibilitas"
              data-visibility-filter
            >
              <option value="all">
                Semua
              </option>

              <option value="public">
                Publik
              </option>

              <option value="private">
                Privat
              </option>
            </select>
          </label>
        </div>
      </div>

      <div class="table-wrap">
        <table class="content-table">
          <caption class="sr-only">
            Daftar konten BINSIGHT
          </caption>

          <thead>
            <tr>
              <th scope="col">
                Konten
              </th>

              <th scope="col">
                Tipe
              </th>

              <th scope="col">
                Author
              </th>

              <th scope="col">
                Visibilitas
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Diperbarui
              </th>

              <th scope="col">
                <span class="sr-only">
                  Aksi
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            {
              contents.map((content) => (
                <tr
                  data-content-row
                  data-id={content.id}
                  data-title={content.title.toLowerCase()}
                  data-description={content.description.toLowerCase()}
                  data-type={content.type}
                  data-type-label={content.typeLabel.toLowerCase()}
                  data-status={content.status}
                  data-author={content.author.toLowerCase()}
                  data-visibility={content.visibility}
                >
                  <td>
                    <div class="content-cell">
                      <span
                        class:list={[
                          "content-cell__icon",
                          `content-cell__icon--${content.type}`,
                        ]}
                      >
                        {content.type === "media" ? (
                          <Image
                            size={17}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        ) : content.type === "guide" ? (
                          <FolderOpen
                            size={17}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        ) : (
                          <FileText
                            size={17}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        )}
                      </span>

                      <div class="content-cell__copy">
                        <strong title={content.title}>
                          {content.title}
                        </strong>

                        <span title={content.description}>
                          {content.description}
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>
                    <span class="type-label">
                      {content.typeLabel}
                    </span>
                  </td>

                  <td>
                    <span
                      class="author-label"
                      title={content.author}
                    >
                      {content.author}
                    </span>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "visibility-badge",
                        `visibility-badge--${content.visibility}`,
                      ]}
                    >
                      {content.visibility === "public" ? (
                        <Globe
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : (
                        <ShieldCheck
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      )}

                      <span>
                        {content.visibility === "public"
                          ? "Publik"
                          : "Privat"}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span
                      class:list={[
                        "status-badge",
                        `status-badge--${content.status}`,
                      ]}
                    >
                      {content.status === "published" ? (
                        <CircleCheck
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : content.status === "draft" ? (
                        <Clock3
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      ) : (
                        <FolderOpen
                          size={13}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      )}

                      <span>
                        {content.statusLabel}
                      </span>
                    </span>
                  </td>

                  <td>
                    <span class="updated-label">
                      {content.updatedAt}
                    </span>
                  </td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Lihat ${content.title}`}
                        title="Lihat"
                        data-view
                        data-record={content.id}
                      >
                        <Eye
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>

                      <button
                        type="button"
                        class="row-action"
                        aria-label={`Edit ${content.title}`}
                        title="Edit"
                        data-edit
                        data-record={content.id}
                      >
                        <Pencil
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>

                      <button
                        type="button"
                        class="row-action row-action--danger"
                        aria-label={`Arsipkan ${content.title}`}
                        title="Arsipkan"
                        data-archive
                        data-record={content.id}
                      >
                        <Trash2
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div
          class="empty-state"
          data-empty-state
          hidden
          aria-hidden="true"
        >
          <span class="empty-state__icon">
            <Search
              size={24}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>

          <span class="empty-state__eyebrow">
            NO MATCH
          </span>

          <h3>
            Konten tidak ditemukan
          </h3>

          <p>
            Tidak ada konten yang cocok dengan pencarian atau filter
            yang digunakan.
          </p>

          <button
            type="button"
            class="button button--paper"
            data-empty-reset
          >
            Reset filter
          </button>
        </div>
      </div>

      <footer class="directory__footer">
        <span>
          <strong data-footer-count>
            {totalContent}
          </strong>
          record ditampilkan
        </span>

        <span>
          BINSIGHT / CONTENT
        </span>
      </footer>
    </section>

    <!-- ============================================================
         WORKFLOW
    ============================================================= -->
    <section
      class="workflow-grid"
      aria-label="Alur editorial"
    >
      <article class="workflow-card">
        <div class="workflow-card__number">
          01
        </div>

        <div class="workflow-card__content">
          <span class="workflow-card__eyebrow">
            DRAFT
          </span>

          <h2>
            Tulis dan revisi
          </h2>

          <p>
            Materi baru disimpan sebagai draft sampai isi, struktur,
            dan konteks informasinya diperiksa.
          </p>
        </div>
      </article>

      <article class="workflow-card workflow-card--dark">
        <div class="workflow-card__number">
          02
        </div>

        <div class="workflow-card__content">
          <span class="workflow-card__eyebrow">
            REVIEW
          </span>

          <h2>
            Periksa sebelum terbit
          </h2>

          <p>
            Pastikan informasi sesuai konteks BINSIGHT dan tidak
            menyajikan data yang tidak terverifikasi.
          </p>
        </div>
      </article>

      <article class="workflow-card workflow-card--acid">
        <div class="workflow-card__number">
          03
        </div>

        <div class="workflow-card__content">
          <span class="workflow-card__eyebrow">
            PUBLISHED
          </span>

          <h2>
            Publikasikan
          </h2>

          <p>
            Konten terbit menjadi bagian dari pengalaman publik dan
            harus dijaga relevansinya dari waktu ke waktu.
          </p>
        </div>
      </article>
    </section>
  </div>

  <!-- ==============================================================
       DETAIL DRAWER
  ============================================================== -->
  <aside
    class="content-drawer"
    data-drawer
    aria-hidden="true"
    hidden
    aria-labelledby="drawer-title"
  >
    <div class="drawer__header">
      <div>
        <span class="drawer__eyebrow">
          CONTENT DETAIL
        </span>

        <h2 id="drawer-title">
          Detail konten
        </h2>
      </div>

      <button
        type="button"
        class="drawer__close"
        aria-label="Tutup detail konten"
        title="Tutup"
        data-drawer-close
      >
        <X
          size={18}
          stroke-width={2}
          aria-hidden="true"
        />
      </button>
    </div>

    <div class="drawer__body">
      <div class="drawer-identity">
        <span
          class="drawer-identity__icon"
          data-drawer-icon
        >
          <FileText
            size={21}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </span>

        <div class="drawer-identity__copy">
          <h3 data-drawer-title>
            -
          </h3>

          <span data-drawer-type>
            -
          </span>
        </div>
      </div>

      <div class="drawer-badges">
        <span
          class="status-badge"
          data-drawer-status
        >
          -
        </span>

        <span
          class="visibility-badge"
          data-drawer-visibility
        >
          -
        </span>
      </div>

      <section class="drawer-section">
        <span class="drawer-section__label">
          INFORMASI
        </span>

        <p
          class="drawer-description"
          data-drawer-description
        >
          -
        </p>

        <dl class="detail-list">
          <div>
            <dt>
              Author
            </dt>

            <dd data-drawer-author>
              -
            </dd>
          </div>

          <div>
            <dt>
              Dibuat
            </dt>

            <dd data-drawer-created>
              -
            </dd>
          </div>

          <div>
            <dt>
              Diperbarui
            </dt>

            <dd data-drawer-updated>
              -
            </dd>
          </div>
        </dl>
      </section>

      <section class="drawer-section">
        <span class="drawer-section__label">
          PUBLICATION
        </span>

        <div class="publication-box">
          <div class="publication-box__mark">
            <Globe
              size={18}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </div>

          <div>
            <strong data-drawer-publication-title>
              Publik
            </strong>

            <p data-drawer-publication-copy>
              Konten tersedia untuk pengalaman publik.
            </p>
          </div>
        </div>
      </section>

      <section class="drawer-section">
