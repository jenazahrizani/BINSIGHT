    gap: 14px;

    align-items: center;
  }

  .report-success__icon {
    display: grid;

    width: 58px;

    height: 58px;

    place-items: center;

    color: var(--ink);

    background: var(--acid);

    border:
      3px solid
      var(--white);
  }

  .report-success__icon svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .report-success__eyebrow {
    display: block;

