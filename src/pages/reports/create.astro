</style>

<script>
// @ts-nocheck

  const form =
    document.querySelector(
      "[data-report-form]",
    );

  const successPanel =
    document.querySelector(
      "[data-report-success]",
    );

  const newReportButton =
    document.querySelector(
      "[data-new-report]",
    );

  const submitButton =
    document.querySelector(
      "[data-submit-button]",
    );

  const submitLabel =
    document.querySelector(
      "[data-submit-label]",
    );

  const typeSelect =
    document.querySelector(
      "[name='type']",
    );

  const typeExplainer =
    document.querySelector(
      "[data-type-explainer]",
    );

  const descriptionField =
    document.querySelector(
      "[name='description']",
    );

  const descriptionCounter =
    document.querySelector(
      "[data-description-counter]",
    );

  const imageInput =
    document.querySelector(
      "[data-report-image]",
    );

  const imageName =
    document.querySelector(
      "[data-image-name]",
    );

  const reportTypeDescriptions = {
    "illegal-dumping":
      "Sampah dibuang di lokasi yang tidak semestinya.",

    "overflowing-waste":
      "Tempat sampah atau titik pengumpulan sudah penuh dan meluber.",

    "burning-waste":
      "Aktivitas pembakaran sampah yang mengganggu lingkungan.",

    "hazardous-waste":
      "Temuan limbah atau sampah yang membutuhkan penanganan khusus.",

    "environmental-pollution":
      "Kondisi pencemaran yang berkaitan dengan sampah atau limbah.",

    other:
      "Masalah persampahan lain yang belum masuk kategori di atas.",
  };

  function updateTypeDescription() {
    if (
      !(typeSelect instanceof HTMLSelectElement)
    ) {
      return;
    }

    if (
      !(typeExplainer instanceof HTMLElement)
    ) {
      return;
    }

    const value =
      typeSelect.value;

    typeExplainer.textContent =
      reportTypeDescriptions[value] ??
      "Pilih kategori yang paling sesuai dengan kondisi lapangan.";
  }

  function updateDescriptionCounter() {
    if (
      !(descriptionField instanceof HTMLTextAreaElement) ||
      !(descriptionCounter instanceof HTMLElement)
    ) {
      return;
    }

    descriptionCounter.textContent =
      `${descriptionField.value.length} / 2000`;
  }

  function setFieldError(
    fieldName,
    message,
  ) {
    const field =
      form?.querySelector(
        `[name="${fieldName}"]`,
      );

    const error =
      form?.querySelector(
        `[data-field-error="${fieldName}"]`,
      );

    if (
      field instanceof HTMLElement
    ) {
      field.setAttribute(
        "aria-invalid",
        "true",
      );
    }

    if (
      error instanceof HTMLElement
    ) {
      error.textContent =
        message;

      error.hidden = false;
    }
  }

  function clearFieldError(
    fieldName,
  ) {
    const field =
      form?.querySelector(
        `[name="${fieldName}"]`,
      );

    const error =
      form?.querySelector(
        `[data-field-error="${fieldName}"]`,
      );

    if (
      field instanceof HTMLElement
    ) {
      field.removeAttribute(
        "aria-invalid",
      );
    }

    if (
      error instanceof HTMLElement
    ) {
      error.textContent = "";
      error.hidden = true;
    }
  }

  function clearAllErrors() {
    [
      "title",
      "description",
      "type",
      "areaId",
      "address",
      "confirmation",
    ].forEach(
      (fieldName) => {
        clearFieldError(
          fieldName,
        );
      },
    );
  }

  function validateReportForm() {
    if (
      !(form instanceof HTMLFormElement)
    ) {
      return false;
    }

    clearAllErrors();

    const title =
      form.elements.namedItem(
        "title",
      );

    const description =
      form.elements.namedItem(
        "description",
      );

    const type =
      form.elements.namedItem(
        "type",
      );

    const area =
      form.elements.namedItem(
        "areaId",
      );

    const address =
      form.elements.namedItem(
        "address",
      );

    const confirmation =
      form.elements.namedItem(
        "confirmation",
      );

    let valid = true;

    if (
      !(title instanceof HTMLInputElement) ||
      title.value.trim().length < 5
    ) {
      setFieldError(
        "title",
        "Judul laporan minimal 5 karakter.",
      );

      valid = false;
    }

    if (
      !(
        description instanceof
        HTMLTextAreaElement
      ) ||
      description.value.trim().length < 20
    ) {
      setFieldError(
        "description",
        "Deskripsi laporan minimal 20 karakter.",
      );

      valid = false;
    }

    if (
      !(type instanceof HTMLSelectElement) ||
      type.value === ""
    ) {
      setFieldError(
        "type",
        "Silakan pilih jenis laporan.",
      );

      valid = false;
    }

    if (
      !(area instanceof HTMLSelectElement) ||
      area.value === ""
    ) {
      setFieldError(
        "areaId",
        "Silakan pilih area atau kecamatan.",
      );

      valid = false;
    }

    if (
      !(address instanceof HTMLInputElement) ||
      address.value.trim().length < 5
    ) {
      setFieldError(
        "address",
        "Alamat atau lokasi perlu diisi.",
      );

      valid = false;
    }

    if (
      !(
        confirmation instanceof
        HTMLInputElement
      ) ||
      !confirmation.checked
    ) {
      setFieldError(
        "confirmation",
        "Konfirmasi diperlukan sebelum laporan dikirim.",
      );

      valid = false;
    }

    if (!valid) {
      const firstInvalid =
        form.querySelector(
          "[aria-invalid='true']",
        );

      if (
        firstInvalid instanceof
        HTMLElement
      ) {
        firstInvalid.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
      }
    }

    return valid;
  }

  function buildReportPayload() {
    if (
      !(form instanceof HTMLFormElement)
    ) {
      return null;
    }

    const formData =
      new FormData(form);

    const latitudeRaw =
      String(
        formData.get(
          "latitude",
        ) ?? "",
      ).trim();

    const longitudeRaw =
      String(
        formData.get(
          "longitude",
        ) ?? "",
      ).trim();

    const latitude =
      latitudeRaw !== ""
        ? Number(latitudeRaw)
        : undefined;

    const longitude =
      longitudeRaw !== ""
        ? Number(longitudeRaw)
        : undefined;

    const image =
      formData.get("image");

    const selectedArea =
      form.elements.namedItem(
        "areaId",
      );

    let areaName = "";

    if (
      selectedArea instanceof
      HTMLSelectElement
    ) {
      const selectedOption =
        selectedArea.options[
          selectedArea.selectedIndex
        ];

      areaName =
        selectedOption?.textContent?.trim() ??
        "";
    }

    return {
      title:
        String(
          formData.get(
            "title",
          ) ?? "",
        ).trim(),

      description:
        String(
          formData.get(
            "description",
          ) ?? "",
        ).trim(),

      type:
        String(
          formData.get(
            "type",
          ) ?? "",
        ),

      category:
        String(
          formData.get(
            "category",
          ) ?? "",
        ),

      location: {
        address:
          String(
            formData.get(
              "address",
            ) ?? "",
          ).trim(),

        areaId:
          String(
            formData.get(
              "areaId",
            ) ?? "",
          ),

        areaName,

        coordinates:
          latitude !== undefined &&
          longitude !== undefined &&
          Number.isFinite(latitude) &&
          Number.isFinite(longitude)
            ? {
                lat: latitude,
                lng: longitude,
              }
            : undefined,
      },

      reporterName:
        String(
          formData.get(
            "reporterName",
          ) ?? "",
        ).trim(),

      reporterContact:
        String(
          formData.get(
            "reporterContact",
          ) ?? "",
        ).trim(),

      notes:
        String(
          formData.get(
            "notes",
          ) ?? "",
        ).trim(),

      imageName:
        image instanceof File &&
        image.size > 0
          ? image.name
          : undefined,

      createdAt:
        new Date().toISOString(),
    };
  }

  async function handleSubmit(
    event,
  ) {
    event.preventDefault();

    if (
      !(form instanceof HTMLFormElement)
    ) {
      return;
    }

    if (!validateReportForm()) {
      return;
    }

    const payload =
      buildReportPayload();

    if (!payload) {
      return;
    }

    if (
      submitButton instanceof
      HTMLButtonElement
    ) {
      submitButton.disabled = true;
    }

    if (
      submitLabel instanceof HTMLElement
    ) {
      submitLabel.textContent =
        "Menyiapkan laporan...";
    }

    await Promise.resolve();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:report-submit",
        {
          detail: payload,
        },
      ),
    );

    form.hidden = true;

    if (
      successPanel instanceof HTMLElement
    ) {
      successPanel.hidden = false;

      successPanel.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }
  }

  function resetReportForm() {
    if (
      !(form instanceof HTMLFormElement)
    ) {
      return;
    }

    form.reset();

    clearAllErrors();

    form.hidden = false;

    if (
      successPanel instanceof HTMLElement
    ) {
      successPanel.hidden = true;
    }

    if (
      submitButton instanceof
      HTMLButtonElement
    ) {
      submitButton.disabled = false;
    }

    if (
      submitLabel instanceof HTMLElement
    ) {
      submitLabel.textContent =
        "Kirim laporan";
    }

    if (
      imageName instanceof HTMLElement
    ) {
      imageName.textContent = "";
      imageName.hidden = true;
    }

    updateTypeDescription();
    updateDescriptionCounter();

    const title =
      form.elements.namedItem(
        "title",
      );

    if (
      title instanceof HTMLInputElement
    ) {
      title.focus();
    }
  }

  typeSelect?.addEventListener(
    "change",
    updateTypeDescription,
  );

  descriptionField?.addEventListener(
    "input",
    updateDescriptionCounter,
  );

  imageInput?.addEventListener(
    "change",
    () => {
      if (
        !(imageInput instanceof HTMLInputElement) ||
        !(imageName instanceof HTMLElement)
      ) {
        return;
      }

      const file =
        imageInput.files?.[0];

      if (!file) {
        imageName.textContent = "";
        imageName.hidden = true;
        return;
      }

      imageName.textContent =
        `${file.name} · ${(file.size / 1024 / 1024).toFixed(2)} MB`;

      imageName.hidden = false;
    },
  );

  form?.addEventListener(
    "submit",
    handleSubmit,
  );

  newReportButton?.addEventListener(
    "click",
    resetReportForm,
  );

  form?.querySelectorAll(
    "input, textarea, select",
  ).forEach(
    (field) => {
      field.addEventListener(
        "input",
        () => {
          const name =
            field.getAttribute(
              "name",
            );

          if (name) {
            clearFieldError(
              name,
            );
          }
        },
      );

      field.addEventListener(
        "change",
        () => {
          const name =
            field.getAttribute(
              "name",
            );

          if (name) {
            clearFieldError(
              name,
            );
          }
        },
      );
    },
  );

  updateTypeDescription();
  updateDescriptionCounter();
</script>