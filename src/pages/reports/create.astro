        minmax(0, 1fr)
      );

    gap: 15px;

    margin-top: 18px;
  }

  /* ==========================================================================
     FILE
     ========================================================================== */

  .file-field__input {
    position: absolute;

    width: 1px;

    height: 1px;

    opacity: 0;

    pointer-events: none;
  }

  .file-field__label {
    display: grid;

    grid-template-columns:
      44px
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 12px;

    min-height: 76px;

    padding: 11px;

    color: var(--ink);

    background: var(--paper);

    border:
      3px
      dashed
      var(--ink);

    cursor: pointer;

    transition:
      background 120ms linear,
      box-shadow 120ms linear;
  }

  .file-field__label:hover {
    background: var(--acid-soft);

    box-shadow:
      5px 5px 0
      var(--warning);
  }

  .file-field__icon {
    display: grid;

    width: 44px;

    height: 44px;

    place-items: center;

    color: var(--acid);

    background: var(--ink);

    border:
      2px solid
      var(--ink);
  }

  .file-field__icon svg {
    color: var(--acid);
    stroke: var(--acid);
  }

  .file-field__copy {
    display: grid;

    gap: 4px;

    min-width: 0;
  }

  .file-field__copy strong {
    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 10px;

    font-weight: 900;

    line-height: 1;

    text-transform: uppercase;
  }

  .file-field__copy small {
    color: #687067;

    font-size: 8px;

    line-height: 1.4;
  }

  .file-field__button {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 34px;

    padding: 0 10px;

    color: var(--ink);

    background: var(--white);

    border:
      2px solid
      var(--ink);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .file-field__filename {
    margin: 7px 0 0;

    padding: 9px 10px;

    color: var(--ink);

    background: var(--acid-soft);

    border:
      2px solid
      var(--ink);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 800;

    line-height: 1.5;
  }

  .file-field__filename[hidden] {
    display: none;
  }

  .file-field
    [data-field-error="image"] {
    margin-top: 7px;
  }

  /* ==========================================================================
     CONFIRMATION
     ========================================================================== */

  .confirmation-box {
    display: grid;

    grid-template-columns:
      47px
      minmax(0, 1fr);

    gap: 13px;

    padding: 15px;

    background: var(--ink-2);

    border:
      2px solid
      #343932;
  }

  .confirmation-box__icon {
    display: grid;

    width: 47px;

    height: 47px;

    place-items: center;

    color: var(--ink);

    background: var(--acid);

    border:
      2px solid
      var(--white);
  }

  .confirmation-box__icon svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .confirmation-box__eyebrow {
    display: block;

    margin-bottom: 7px;

    color: var(--acid);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;
  }

  .confirmation-box__title {
    margin: 0;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 14px;

    font-weight: 900;

    line-height: 1.05;

    letter-spacing: -0.03em;

    text-transform: uppercase;
  }

  .confirmation-box__description {
    margin: 7px 0 0;

    color: #bfc5bb;

    font-size: 9px;

    line-height: 1.65;
  }

  .consent-field {
    position: relative;

    display: grid;

    grid-template-columns:
      22px
      minmax(0, 1fr);

    align-items: start;

    gap: 10px;

    margin-top: 18px;

    cursor: pointer;
  }

  .consent-field input {
    position: absolute;

    width: 1px;

    height: 1px;

    opacity: 0;

    pointer-events: none;
  }

  .consent-field__box {
    display: grid;

    width: 22px;

    height: 22px;

    place-items: center;

    margin-top: 1px;

    background: var(--white);

    border:
      3px solid
      var(--white);
  }

  .consent-field input:checked
    + .consent-field__box {
    background: var(--acid);

    border-color:
      var(--acid);
  }

  .consent-field input:checked
    + .consent-field__box::after {
    width: 6px;

    height: 11px;

    border-right:
      3px solid
      var(--ink);

    border-bottom:
      3px solid
      var(--ink);

    transform:
      rotate(45deg)
      translate(
        -1px,
        -1px
      );

    content: "";
  }

  .consent-field input:focus-visible
    + .consent-field__box {
    outline:
      3px solid
      var(--acid);

    outline-offset: 3px;
  }

  .consent-field__text {
    color: #bcc2b8;

    font-size: 8px;

    line-height: 1.7;
  }

  .form-field__error--confirmation {
    margin:
      7px
      0
      0
      32px;
  }

  /* ==========================================================================
     ACTIONS
     ========================================================================== */

  .form-actions {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    margin-top: 23px;

    padding-top: 20px;

    border-top:
      2px solid
      #343932;
  }

  .form-actions__back {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    min-height: 45px;

    padding: 0 12px;

    color: var(--white);

    border:
      2px solid
      #545b51;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.06em;

    text-decoration: none;

    text-transform: uppercase;
  }

  .form-actions__back svg {
    color: var(--acid);
    stroke: var(--acid);
  }

  .form-actions__back:hover {
    color: var(--ink);

    background: var(--white);

    border-color: var(--white);
  }

  .form-actions__back:hover svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .form-actions__submit {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    min-width: 175px;

    min-height: 50px;

    padding: 0 16px;

    color: var(--ink);

    background: var(--acid);

    border:
      3px solid
      var(--white);

    border-radius: 0;

    box-shadow:
      6px 6px 0
      var(--warning);

    font-family:
      "DM Mono",
      monospace;

    font-size: 8px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.07em;

    text-transform: uppercase;

    cursor: pointer;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .form-actions__submit svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .form-actions__submit:hover:not(:disabled) {
    background: var(--acid-soft);

    transform:
      translate(
        -2px,
        -2px
      );

    box-shadow:
      8px 8px 0
      var(--white);
  }

  .form-actions__submit:active:not(:disabled) {
    transform:
      translate(
        2px,
        2px
      );

    box-shadow:
      2px 2px 0
      var(--white);
  }

  .form-actions__submit:disabled {
    opacity: 0.58;

    cursor: wait;
  }

  .form-actions__note {
    margin: 11px 0 0;

    color: #777f75;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 700;

    line-height: 1.5;

    text-align: right;

    text-transform: uppercase;
  }

  /* ==========================================================================
     SIDEBAR
     ========================================================================== */

  .report-create-sidebar {
    position: sticky;

    top: 24px;

    display: grid;

    gap: 15px;

    min-width: 0;
  }

  .sidebar-card {
    min-width: 0;

    padding: 19px;

    color: var(--ink);

    background: var(--white);

    border:
      3px solid
      var(--ink);

    box-shadow:
      6px 6px 0
      var(--ink);
  }

  .sidebar-card--dark {
    color: var(--white);

    background: var(--ink);

    box-shadow:
      7px 7px 0
      var(--acid);
  }

  .sidebar-card--link {
    display: grid;

    grid-template-columns:
      42px
      minmax(0, 1fr);

    gap: 11px;

    align-items: start;
  }

  .sidebar-card__top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;

    margin-bottom: 13px;
  }

  .sidebar-card__icon {
    display: grid;

    width: 42px;

    height: 42px;

    place-items: center;

    color: var(--ink);

    background: var(--acid);

    border:
      2px solid
      var(--ink);
  }

  .sidebar-card__icon svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .sidebar-card__icon--warning {
    color: var(--ink);
    background: var(--warning);
  }

  .sidebar-card__icon--location {
    color: var(--ink);
    background: var(--acid);
  }

  .sidebar-card__eyebrow {
    color: var(--acid);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .sidebar-card__eyebrow--dark {
    color: #727a70;
  }

  .sidebar-card__title {
    margin: 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 17px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: -0.045em;

    text-transform: uppercase;
  }

  .sidebar-card--dark
    .sidebar-card__title {
    color: var(--white);
  }

  .sidebar-card__description {
    margin: 10px 0 0;

    color: var(--muted);

    font-size: 9px;

    line-height: 1.68;
  }

  .sidebar-card--dark
