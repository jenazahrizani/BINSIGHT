  }

  .report-success__primary svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .report-success__primary:hover {
    background: var(--acid-soft);
  }

  .report-success__secondary {
    color: var(--white);

    background: transparent;

    cursor: pointer;
  }

  .report-success__secondary:hover {
    color: var(--ink);

    background: var(--white);
  }

  /* ==========================================================================
     ACCESSIBILITY
     ========================================================================== */

  .report-create-page a:focus-visible,
  .report-create-page button:focus-visible,
  .report-create-page input:focus-visible,
  .report-create-page select:focus-visible,
  .report-create-page textarea:focus-visible {
