---
import {
  ArrowLeft,
  CircleCheck,
  FileText,
  Image,
  Info,
  LocateFixed,
  MapPin,
  Send,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import PublicLayout from "../../layouts/PublicLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import { getAreas } from "../../lib/data/locations";

const areas = getAreas();

const reportTypes = [
  {
    value: "illegal-dumping",
    label: "Pembuangan ilegal",
    description:
      "Sampah dibuang di lokasi yang tidak semestinya.",
  },
  {
    value: "overflowing-waste",
    label: "Sampah meluber",
    description:
      "Tempat sampah atau titik pengumpulan sudah penuh dan meluber.",
  },
  {
    value: "burning-waste",
    label: "Pembakaran sampah",
    description:
      "Aktivitas pembakaran sampah yang mengganggu lingkungan.",
  },
  {
    value: "hazardous-waste",
    label: "Sampah berbahaya",
    description:
      "Temuan limbah atau sampah yang membutuhkan penanganan khusus.",
  },
  {
    value: "environmental-pollution",
    label: "Pencemaran lingkungan",
    description:
      "Kondisi pencemaran yang berkaitan dengan sampah atau limbah.",
  },
  {
    value: "other",
    label: "Lainnya",
    description:
      "Masalah persampahan lain yang belum masuk kategori di atas.",
  },
];

const reportCategories = [
  {
    value: "organic",
    label: "Organik",
  },
  {
    value: "inorganic",
    label: "Anorganik",
  },
  {
    value: "hazardous",
    label: "Berbahaya",
  },
  {
    value: "electronic",
    label: "Elektronik",
  },
  {
    value: "residual",
    label: "Residu",
  },
  {
    value: "mixed",
    label: "Campuran / tidak diketahui",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Buat Laporan — BINSIGHT",
  description:
    "Formulir untuk mengirimkan laporan masyarakat terkait kondisi persampahan dan lingkungan di Kabupaten Badung.",
  url: "https://binsight.id/reports/create",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<PublicLayout
  title="Buat Laporan"
  description="Laporkan kondisi persampahan dan lingkungan yang Anda temukan di Kabupaten Badung."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="report-create-page">
    <PageHeader
      eyebrow="LAPORAN MASYARAKAT"
      title="Laporkan kondisi persampahan yang Anda temukan"
      description="Berikan informasi lokasi dan kondisi lapangan secara jelas. Laporan yang masuk dapat menjadi data pendukung untuk proses verifikasi dan pemantauan."
      icon="report"
      tone="green"
      breadcrumbs={[
        {
          label: "Beranda",
          href: "/",
        },
        {
          label: "Laporan Masyarakat",
          href: "/reports",
        },
        {
          label: "Buat Laporan",
          href: "/reports/create",
        },
      ]}
    />

    <section class="report-create-page__content">
      <div class="report-create-page__container">
        <div class="report-create-layout">
          <div class="report-create-main">
            <form
              id="report-create-form"
              class="report-form"
              novalidate
              data-report-form
            >
              <section class="form-section">
                <div class="form-section__header">
                  <div class="form-section__number">
                    01
                  </div>

                  <div>
                    <h2 class="form-section__title">
                      Informasi laporan
                    </h2>

                    <p class="form-section__description">
                      Jelaskan masalah persampahan yang Anda temukan.
                    </p>
                  </div>
                </div>

                <div class="form-grid">
                  <div class="form-field form-field--full">
                    <label
                      class="form-field__label"
                      for="title"
                    >
                      Judul laporan
                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <p
                      id="title-hint"
                      class="form-field__hint"
                    >
                      Buat judul singkat yang menggambarkan kondisi di lokasi.
                    </p>

                    <input
                      id="title"
                      name="title"
                      class="form-field__input"
                      type="text"
                      placeholder="Contoh: Tumpukan sampah di pinggir jalan"
                      minlength="5"
                      maxlength="120"
                      required
                      aria-describedby="title-hint title-error"
                      autocomplete="off"
                    />

                    <p
                      id="title-error"
                      class="form-field__error"
                      data-field-error="title"
                      hidden
                    ></p>
                  </div>

                  <div class="form-field form-field--full">
                    <label
                      class="form-field__label"
                      for="description"
                    >
                      Deskripsi kondisi
                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <p
                      id="description-hint"
                      class="form-field__hint"
                    >
                      Jelaskan apa yang Anda lihat, perkiraan kondisi, dan
                      hal penting lain yang membantu proses verifikasi.
                    </p>

                    <textarea
                      id="description"
                      name="description"
                      class="form-field__textarea"
                      placeholder="Jelaskan kondisi sampah atau pencemaran yang Anda temukan..."
                      minlength="20"
                      maxlength="2000"
                      rows="7"
                      required
                      aria-describedby="description-hint description-error"
                    ></textarea>

                    <div class="form-field__footer">
                      <p
                        id="description-error"
                        class="form-field__error"
                        data-field-error="description"
                        hidden
                      ></p>

                      <span
                        class="form-field__counter"
                        data-description-counter
                      >
                        0 / 2000
                      </span>
                    </div>
                  </div>

                  <div class="form-field">
                    <label
                      class="form-field__label"
                      for="type"
                    >
                      Jenis laporan
                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="type"
                      name="type"
                      class="form-field__select"
                      required
                      aria-describedby="type-error"
                    >
                      <option value="">
                        Pilih jenis laporan
                      </option>

                      {
                        reportTypes.map((item) => (
                          <option value={item.value}>
                            {item.label}
                          </option>
                        ))
                      }
                    </select>

                    <p
                      id="type-error"
                      class="form-field__error"
                      data-field-error="type"
                      hidden
                    ></p>

                    <div
                      class="type-explainer"
                      data-type-explainer
                    >
                      Pilih kategori yang paling sesuai dengan kondisi lapangan.
                    </div>
                  </div>

                  <div class="form-field">
                    <label
                      class="form-field__label"
                      for="category"
                    >
                      Kategori sampah
                    </label>

                    <select
                      id="category"
                      name="category"
                      class="form-field__select"
                      aria-describedby="category-hint"
                    >
                      <option value="">
                        Pilih kategori
                      </option>

                      {
                        reportCategories.map((item) => (
                          <option value={item.value}>
                            {item.label}
                          </option>
                        ))
                      }
                    </select>

                    <p
                      id="category-hint"
                      class="form-field__hint"
                    >
                      Pilih kategori apabila jenis sampah dapat diidentifikasi.
                    </p>
                  </div>
                </div>
              </section>

              <section class="form-section">
                <div class="form-section__header">
                  <div class="form-section__number">
                    02
                  </div>

                  <div>
                    <h2 class="form-section__title">
                      Lokasi kejadian
                    </h2>

                    <p class="form-section__description">
                      Lokasi yang jelas membantu laporan dipahami dan diverifikasi.
                    </p>
                  </div>
                </div>

                <div class="location-notice">
                  <div class="location-notice__icon">
                    <LocateFixed
                      size={19}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>
                      Gunakan lokasi yang mudah dikenali
                    </strong>

                    <p>
                      Cantumkan area dan alamat atau patokan terdekat.
                      Koordinat dapat ditambahkan apabila tersedia.
                    </p>
                  </div>
                </div>

                <div class="form-grid">
                  <div class="form-field">
                    <label
                      class="form-field__label"
                      for="areaId"
                    >
                      Area / Kecamatan
                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="areaId"
                      name="areaId"
                      class="form-field__select"
                      required
                      aria-describedby="area-error"
                    >
                      <option value="">
                        Pilih area
                      </option>

                      {
                        areas.map((area) => (
                          <option value={area.id}>
                            {area.name}
                          </option>
                        ))
                      }
                    </select>

                    <p
                      id="area-error"
                      class="form-field__error"
                      data-field-error="areaId"
                      hidden
                    ></p>
                  </div>

                  <div class="form-field">
                    <label
                      class="form-field__label"
                      for="address"
                    >
                      Alamat / lokasi
                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <input
                      id="address"
                      name="address"
                      class="form-field__input"
                      type="text"
                      placeholder="Contoh: Jalan Raya Kerobokan, dekat pasar..."
                      minlength="5"
                      maxlength="300"
                      required
                      aria-describedby="address-error"
                      autocomplete="street-address"
                    />

                    <p
                      id="address-error"
                      class="form-field__error"
                      data-field-error="address"
                      hidden
                    ></p>
                  </div>

                  <div class="form-field">
                    <label
                      class="form-field__label"
                      for="latitude"
                    >
                      Latitude
                    </label>

                    <input
                      id="latitude"
                      name="latitude"
                      class="form-field__input"
                      type="number"
                      inputmode="decimal"
                      step="any"
                      min="-90"
                      max="90"
                      placeholder="-8.650000"
                      aria-describedby="coordinates-hint"
                    />
                  </div>

                  <div class="form-field">
                    <label
                      class="form-field__label"
                      for="longitude"
                    >
                      Longitude
                    </label>

                    <input
                      id="longitude"
                      name="longitude"
                      class="form-field__input"
                      type="number"
                      inputmode="decimal"
                      step="any"
                      min="-180"
                      max="180"
                      placeholder="115.216667"
                      aria-describedby="coordinates-hint"
                    />
                  </div>

                  <div class="form-field form-field--full">
                    <p
                      id="coordinates-hint"
                      class="form-field__hint form-field__hint--standalone"
                    >
                      Koordinat bersifat opsional. Pastikan nilainya benar apabila
                      Anda mengisinya.
                    </p>
                  </div>
                </div>
              </section>

              <section class="form-section">
                <div class="form-section__header">
                  <div class="form-section__number">
                    03
                  </div>

                  <div>
                    <h2 class="form-section__title">
                      Bukti dan pelapor
                    </h2>

                    <p class="form-section__description">
                      Tambahkan bukti visual dan informasi kontak seperlunya.
                    </p>
                  </div>
                </div>

                <div class="form-grid">
                  <div class="form-field form-field--full">
                    <label
                      class="form-field__label"
                      for="image"
                    >
                      Foto kondisi
                    </label>

                    <div class="file-field">
                      <input
                        id="image"
                        name="image"
                        class="file-field__input"
                        type="file"
                        accept="image/jpeg,image/png,image/webp"
                        data-report-image
                      />

                      <label
                        class="file-field__label"
                        for="image"
                      >
                        <span class="file-field__icon">
                          <Image
                            size={20}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </span>

                        <span class="file-field__copy">
                          <strong>
                            Pilih foto
                          </strong>

                          <small>
                            JPG, PNG, atau WebP
                          </small>
                        </span>

                        <span class="file-field__button">
                          Pilih file
                        </span>
                      </label>

                      <p
                        class="file-field__filename"
                        data-image-name
                        hidden
                      ></p>
                    </div>
                  </div>

                  <div class="form-field">
                    <label
                      class="form-field__label"
                      for="reporterName"
                    >
                      Nama pelapor
                    </label>

                    <input
                      id="reporterName"
                      name="reporterName"
                      class="form-field__input"
                      type="text"
                      maxlength="100"
                      placeholder="Nama Anda"
                      autocomplete="name"
                    />

                    <p class="form-field__hint">
                      Nama dapat dikosongkan.
                    </p>
                  </div>

                  <div class="form-field">
                    <label
                      class="form-field__label"
                      for="reporterContact"
                    >
                      Kontak pelapor
                    </label>

                    <input
                      id="reporterContact"
                      name="reporterContact"
                      class="form-field__input"
                      type="text"
                      maxlength="120"
                      placeholder="Email atau nomor telepon"
                      autocomplete="email"
                    />

                    <p class="form-field__hint">
                      Kontak bersifat opsional.
                    </p>
                  </div>

                  <div class="form-field form-field--full">
                    <label
                      class="form-field__label"
                      for="notes"
                    >
                      Catatan tambahan
                    </label>

                    <textarea
                      id="notes"
                      name="notes"
                      class="form-field__textarea"
                      rows="4"
                      maxlength="1000"
                      placeholder="Informasi lain yang menurut Anda penting..."
                    ></textarea>
                  </div>
                </div>
              </section>

              <section class="form-section form-section--confirmation">
                <div class="confirmation-box">
                  <div class="confirmation-box__icon">
                    <ShieldCheck
                      size={22}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="confirmation-box__content">
                    <h2 class="confirmation-box__title">
                      Kirim laporan dengan informasi yang akurat
                    </h2>

                    <p class="confirmation-box__description">
                      Pastikan informasi yang Anda masukkan sesuai dengan kondisi
                      yang benar-benar Anda temukan di lapangan.
                    </p>
                  </div>
                </div>

                <label class="consent-field">
                  <input
                    type="checkbox"
                    name="confirmation"
                    value="confirmed"
                    required
                    data-report-confirmation
                  />

                  <span class="consent-field__box"></span>

                  <span class="consent-field__text">
                    Saya memastikan informasi laporan ini dibuat berdasarkan
                    kondisi yang saya temukan dan bukan informasi yang
                    disengaja untuk menyesatkan.
                  </span>
                </label>

                <p
                  class="form-field__error form-field__error--confirmation"
                  data-field-error="confirmation"
                  hidden
                ></p>

                <div class="form-actions">
                  <a
                    class="form-actions__back"
                    href="/reports"
                  >
                    <ArrowLeft
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>
                      Kembali
                    </span>
                  </a>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-submit-button
                  >
                    <Send
                      size={18}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-submit-label>
                      Kirim laporan
                    </span>
                  </button>
                </div>

                <p class="form-actions__note">
                  Laporan akan dipersiapkan untuk proses verifikasi.
                </p>
              </section>
            </form>

            <div
              class="report-success"
              data-report-success
              hidden
            >
              <div class="report-success__icon">
                <CircleCheck
                  size={34}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="report-success__eyebrow">
                LAPORAN SIAP DIPROSES
              </span>

              <h2 class="report-success__title">
                Laporan berhasil dipersiapkan
              </h2>

              <p class="report-success__description">
                Data laporan telah lolos pemeriksaan dasar di browser.
                Sistem dapat meneruskannya ke proses penyimpanan atau verifikasi
                berikutnya.
              </p>

              <div class="report-success__actions">
                <a
                  class="report-success__primary"
                  href="/reports"
                >
                  Lihat laporan
                  <ArrowLeft
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="report-success__secondary"
                  data-new-report
                >
                  Buat laporan lain
                </button>
              </div>
            </div>
          </div>

          <aside class="report-create-sidebar">
            <div class="sidebar-card sidebar-card--highlight">
              <div class="sidebar-card__icon">
                <Info
                  size={20}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <h2 class="sidebar-card__title">
                Apa yang membuat laporan berguna?
              </h2>

              <p class="sidebar-card__description">
                Informasi yang spesifik membuat laporan lebih mudah dipahami
                dan diverifikasi.
              </p>

              <div class="sidebar-check-list">
                <div class="sidebar-check-item">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                  <span>
                    Judul yang jelas
                  </span>
                </div>

                <div class="sidebar-check-item">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                  <span>
                    Deskripsi kondisi
                  </span>
                </div>

                <div class="sidebar-check-item">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                  <span>
                    Lokasi yang mudah ditemukan
                  </span>
                </div>

                <div class="sidebar-check-item">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                  <span>
                    Foto apabila tersedia
                  </span>
                </div>
              </div>
            </div>

            <div class="sidebar-card">
              <div class="sidebar-card__icon sidebar-card__icon--warning">
                <TriangleAlert
                  size={20}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <h2 class="sidebar-card__title">
                Hindari informasi yang tidak pasti
              </h2>

              <p class="sidebar-card__description">
                Jangan menambahkan dugaan sebagai fakta. Tulis apa yang benar-benar
                Anda amati di lokasi.
              </p>
            </div>

            <div class="sidebar-card">
              <div class="sidebar-card__icon sidebar-card__icon--location">
                <MapPin
                  size={20}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <h2 class="sidebar-card__title">
                Lokasi adalah bagian penting
              </h2>

              <p class="sidebar-card__description">
                Area, alamat, dan koordinat yang akurat membantu laporan
                dipahami secara spasial.
              </p>
            </div>

            <div class="sidebar-card sidebar-card--link">
              <FileText
                size={19}
                stroke-width={2}
                aria-hidden="true"
              />

              <div>
                <strong>
                  Sudah pernah melapor?
                </strong>

                <a href="/reports">
                  Lihat laporan masyarakat
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  .report-create-page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .report-create-page__content {
    padding: var(--space-10) 0 var(--space-14);
  }

  .report-create-page__container {
    width: min(
      1180px,
      calc(100% - 40px)
    );
    margin-inline: auto;
  }

  .report-create-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      320px;
    gap: var(--space-7);
    align-items: start;
  }

  .report-create-main {
    min-width: 0;
  }

  .report-form {
    display: grid;
    gap: var(--space-5);
  }

  .form-section {
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  .form-section__header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .form-section__number {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    font-size: var(--font-size-xs);
    font-weight: 850;
    letter-spacing: 0.04em;
  }

  .form-section__title {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 1.08rem;
    font-weight: 800;
  }

  .form-section__description {
    margin: 5px 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.55;
  }

  .form-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  .form-field {
    min-width: 0;
  }

  .form-field--full {
    grid-column: 1 / -1;
  }

  .form-field__label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: var(--space-2);
    color: var(--color-text-strong);
    font-size: var(--font-size-sm);
    font-weight: 750;
  }

  .form-field__required {
    color: var(--color-danger);
  }

  .form-field__hint {
    margin: 0 0 var(--space-2);
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
    line-height: 1.5;
  }

  .form-field__hint--standalone {
    margin-top: calc(var(--space-3) * -1);
    margin-bottom: 0;
  }

  .form-field__input,
  .form-field__textarea,
  .form-field__select {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-strong);
    font: inherit;
    font-size: var(--font-size-sm);
    transition:
