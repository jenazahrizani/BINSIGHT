    color: #aeb6ac;
  }

  .sidebar-check-list {
    display: grid;

    gap: 10px;

    margin-top: 18px;

    padding-top: 15px;

    border-top:
      2px solid
      rgba(
        255,
        255,
        255,
        0.15
      );
  }

  .sidebar-check-item {
    display: grid;

    grid-template-columns:
      17px
      minmax(0, 1fr);

    gap: 8px;

    align-items: start;

    color: #c4c9c0;

    font-size: 8px;

    line-height: 1.5;
  }

  .sidebar-check-item svg {
    color: var(--acid);
    stroke: var(--acid);

    margin-top: 1px;
  }

  .sidebar-card__link-icon {
    display: grid;

    width: 42px;

    height: 42px;

    place-items: center;

    color: var(--acid);

    background: var(--ink);

    border:
      2px solid
      var(--ink);
  }

  .sidebar-card__link-icon svg {
    color: var(--acid);
    stroke: var(--acid);
  }

  .sidebar-card--link strong {
    display: block;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 10px;

    font-weight: 900;

    line-height: 1.15;

    text-transform: uppercase;
  }

  .sidebar-card--link a {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    margin-top: 7px;

    color: #586057;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1.4;

    letter-spacing: 0.04em;

    text-decoration: none;

    text-transform: uppercase;
  }

  .sidebar-card--link a svg {
    color: var(--warning);
    stroke: var(--warning);
  }

  .sidebar-card--link a:hover {
    color: var(--ink);
  }

  /* ==========================================================================
     SUCCESS
     ========================================================================== */

  .report-success {
    padding: 30px;

    color: var(--white);

    background: var(--ink);

    border:
      4px solid
      var(--ink);

    box-shadow:
      9px 9px 0
