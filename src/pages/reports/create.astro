      width: 49px;

      height: 49px;
    }

    .report-success__title {
      font-size: 26px;
    }

    .report-success__summary {
      grid-template-columns: 1fr;
    }

    .report-success__actions {
      flex-direction: column;

      align-items: stretch;
    }

    .report-success__primary,
    .report-success__secondary {
      width: 100%;
    }
  }

  @media (max-width: 430px) {
    .report-hero {
      width: calc(100% - 16px);
    }

    .report-create-container {
      width: calc(100% - 16px);
    }

    .report-hero__main {
      padding:
        27px
        16px;
    }

    .report-hero__crumbs {
      font-size: 6px;
    }

    .report-hero h1 {
      font-size: 15vw;
    }

    .report-create-content {
      padding-top: 62px;
    }

    .form-section {
      padding: 16px;
    }

    .form-field__input,
    .form-field__textarea,
    .form-field__select {
      font-size: 10px;
    }

    .location-picker__map {
      height: 285px;
    }

    .form-actions__submit {
      min-width: 0;
    }
  }

  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */

  @media (prefers-reduced-motion: reduce) {
    .report-create-page *,
    .report-create-page *::before,
    .report-create-page *::after {
      scroll-behavior: auto !important;

      transition-duration:
        0.01ms !important;

      animation-duration:
        0.01ms !important;

      animation-iteration-count: 1 !important;
    }
  }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  type ReportSubmitPayload = {
    title: string;
    description: string;
    type: string;
    category: string;

    location: {
      address: string;
      areaId: string;
      areaName: string;

      coordinates?: {
        lat: number;
        lng: number;
      };
    };

    reporterName: string;
    reporterContact: string;
    notes: string;
    imageName?: string;
    createdAt: string;
  };

  type NominatimReverseResponse = {
    display_name?: string;

    address?: {
      road?: string;
      pedestrian?: string;
      footway?: string;
      house_number?: string;

      neighbourhood?: string;
      suburb?: string;
      village?: string;
      town?: string;
      city?: string;
      city_district?: string;
      municipality?: string;
      county?: string;
      state_district?: string;

      postcode?: string;

      state?: string;
      country?: string;
    };
  };

  const REPORT_IMAGE_MAX_SIZE =
    5 * 1024 * 1024;

  const REPORT_IMAGE_TYPES =
    new Set([
      "image/jpeg",
      "image/png",
      "image/webp",
    ]);

  const REPORT_TYPE_DESCRIPTIONS:
    Record<string, string> = {
    "illegal-dumping":
      "Sampah dibuang di lokasi yang tidak semestinya.",

    "overflowing-waste":
      "Tempat sampah atau titik pengumpulan sudah penuh dan meluber.",

    "burning-waste":
      "Aktivitas pembakaran sampah yang mengganggu lingkungan.",

    "hazardous-waste":
      "Temuan limbah atau sampah yang membutuhkan penanganan khusus.",

    "environmental-pollution":
      "Kondisi pencemaran yang berkaitan dengan sampah atau limbah.",

    other:
      "Masalah persampahan lain yang belum masuk kategori di atas.",
  };

  /*
   * Kuta / South Bali focus.
   * These coordinates are only used as the initial map view
   * and interaction bounds.
   */
  const DEFAULT_LAT =
    -8.7180;

  const DEFAULT_LNG =
    115.1740;

  /*
   * Interaction bounds around Kabupaten Badung.
   * The map cannot be panned far outside this area.
   */
  const BADUNG_BOUNDS =
    L.latLngBounds(
      [-8.86, 114.96],
      [-8.20, 115.32],
    );

  const normalizeText = (
    value: unknown,
  ) => {
    return String(value ?? "")
      .normalize("NFD")
      .replace(
        /[\u0300-\u036f]/g,
        "",
      )
      .toLowerCase()
      .replace(
        /\b(kecamatan|kec\.?|kabupaten|kab\.?)\b/g,
        " ",
      )
      .replace(
        /[^a-z0-9\s]/g,
        " ",
      )
      .replace(
        /\s+/g,
        " ",
      )
      .trim();
  };

  const initializeReportPage = () => {
    const page =
      document.querySelector<HTMLElement>(
        ".report-create-page",
      );

    const form =
      document.querySelector<HTMLFormElement>(
        "[data-report-form]",
      );

    const successPanel =
      document.querySelector<HTMLElement>(
        "[data-report-success]",
      );

    if (
      !page ||
      !form ||
      !successPanel
    ) {
      return;
    }

    if (
      form.dataset.initialized ===
      "true"
    ) {
      return;
    }

    form.dataset.initialized =
      "true";

    /* ======================================================================
       ELEMENTS
       ====================================================================== */

    const submitButton =
      form.querySelector<HTMLButtonElement>(
        "[data-submit-button]",
      );

    const submitLabel =
      form.querySelector<HTMLElement>(
        "[data-submit-label]",
      );

    const typeSelect =
      form.querySelector<HTMLSelectElement>(
        "[name='type']",
      );

    const typeExplainer =
      form.querySelector<HTMLElement>(
        "[data-type-explainer]",
      );

    const descriptionField =
      form.querySelector<HTMLTextAreaElement>(
        "[name='description']",
      );

    const descriptionCounter =
      form.querySelector<HTMLElement>(
        "[data-description-counter]",
      );

    const imageInput =
      form.querySelector<HTMLInputElement>(
        "[data-report-image]",
      );

    const imageName =
      form.querySelector<HTMLElement>(
        "[data-image-name]",
      );

    const newReportButton =
      successPanel.querySelector<HTMLButtonElement>(
        "[data-new-report]",
      );

    const latitudeInput =
      form.querySelector<HTMLInputElement>(
        "[name='latitude']",
      );

    const longitudeInput =
      form.querySelector<HTMLInputElement>(
        "[name='longitude']",
      );

    const areaSelect =
      form.querySelector<HTMLSelectElement>(
        "[name='areaId']",
      );

    const addressInput =
      form.querySelector<HTMLInputElement>(
        "[name='address']",
      );

    const locationMap =
      form.querySelector<HTMLElement>(
        "[data-location-map]",
      );

    const locateButton =
      form.querySelector<HTMLButtonElement>(
        "[data-use-current-location]",
      );

    /* ======================================================================
       TYPE
       ====================================================================== */

    const updateTypeDescription =
      () => {
        if (
          !typeSelect ||
          !typeExplainer
        ) {
          return;
        }

        typeExplainer.textContent =
          REPORT_TYPE_DESCRIPTIONS[
            typeSelect.value
          ] ??
          "Pilih kategori yang paling sesuai dengan kondisi lapangan.";
      };

    /* ======================================================================
       DESCRIPTION COUNTER
       ====================================================================== */

    const updateDescriptionCounter =
      () => {
        if (
          !descriptionField ||
          !descriptionCounter
        ) {
          return;
        }

        descriptionCounter.textContent =
          `${descriptionField.value.length} / 2000`;
      };

    /* ======================================================================
       ERRORS
       ====================================================================== */

    const getField = (
      fieldName: string,
    ) =>
      form.querySelector<HTMLElement>(
        `[name="${fieldName}"]`,
      );

    const getError = (
      fieldName: string,
    ) =>
      form.querySelector<HTMLElement>(
        `[data-field-error="${fieldName}"]`,
      );

    const setFieldError = (
      fieldName: string,
      message: string,
    ) => {
      const field =
        getField(fieldName);

      const error =
        getError(fieldName);

      field?.setAttribute(
        "aria-invalid",
        "true",
      );

      if (error) {
        error.textContent =
          message;

        error.hidden =
          false;
      }
    };

    const clearFieldError = (
      fieldName: string,
    ) => {
      const field =
        getField(fieldName);

      const error =
        getError(fieldName);

      field?.removeAttribute(
        "aria-invalid",
      );

      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
    };

    const clearAllErrors = () => {
      [
        "title",
        "description",
        "type",
        "areaId",
        "address",
        "latitude",
        "longitude",
        "image",
        "confirmation",
      ].forEach(
        clearFieldError,
      );
    };

    const focusFirstInvalid =
      () => {
        const firstInvalid =
          form.querySelector<HTMLElement>(
            "[aria-invalid='true']",
          );

        if (!firstInvalid) {
          return;
        }

        firstInvalid.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        window.setTimeout(
          () => {
            try {
              firstInvalid.focus();
            } catch {}
          },
          220,
        );
      };

    /* ======================================================================
       LOCATION MAP
       ====================================================================== */

    let locationMapInstance:
      | L.Map
      | null = null;

    let locationMarker:
      | L.Marker
      | null = null;

    let reverseGeocodeTimer:
      | number
      | null = null;

    let reverseGeocodeRequest =
      0;

    const createLocationIcon =
      () =>
        L.divIcon({
          className:
            "binsight-location-marker-wrapper",

          html: `
            <span
              class="binsight-location-marker"
              aria-hidden="true"
            ></span>
          `,

          iconSize: [
            30,
            38,
          ],

          iconAnchor: [
            15,
            37,
          ],

          popupAnchor: [
            0,
            -35,
          ],
        });

    const setCoordinateInputs =
      (
        lat: number,
        lng: number,
      ) => {
        if (
          latitudeInput
        ) {
          latitudeInput.value =
            lat.toFixed(6);

          latitudeInput.setAttribute(
            "readonly",
            "true",
          );
        }

        if (
          longitudeInput
        ) {
          longitudeInput.value =
            lng.toFixed(6);

          longitudeInput.setAttribute(
            "readonly",
            "true",
          );
        }

        clearFieldError(
          "latitude",
        );

        clearFieldError(
          "longitude",
        );
      };

    const clampToBadungBounds =
      (
        lat: number,
        lng: number,
      ) => {
        const clampedLat =
          Math.max(
            BADUNG_BOUNDS.getSouth(),
            Math.min(
              BADUNG_BOUNDS.getNorth(),
              lat,
            ),
          );

        const clampedLng =
          Math.max(
            BADUNG_BOUNDS.getWest(),
            Math.min(
              BADUNG_BOUNDS.getEast(),
              lng,
            ),
          );

        return {
          lat: clampedLat,
          lng: clampedLng,
        };
      };

    /* ======================================================================
       AREA MATCHING
       ====================================================================== */

    const matchAreaFromReverseGeocode =
      (
        result: NominatimReverseResponse,
      ) => {
        if (
          !areaSelect
        ) {
          return null;
        }

        const address =
          result.address ??
          {};

        const candidates = [
          address.city_district,
          address.municipality,
          address.county,
          address.town,
          address.city,
          address.village,
          address.suburb,
          address.neighbourhood,
          address.state_district,
        ]
          .filter(Boolean)
          .map(
            normalizeText,
          )
          .filter(Boolean);

        const options =
          Array.from(
            areaSelect.options,
          );

        for (
          const option of options
        ) {
          if (
            !option.value
          ) {
            continue;
          }

          const areaName =
            option.dataset.areaName ??
            option.textContent ??
            "";

          const normalizedArea =
            normalizeText(
              areaName,
            );

          if (
            candidates.includes(
              normalizedArea,
            )
          ) {
            areaSelect.value =
              option.value;

            clearFieldError(
              "areaId",
            );

            return areaName.trim();
          }
        }

        const displayName =
          normalizeText(
            result.display_name,
          );

        for (
          const option of options
        ) {
          if (
            !option.value
          ) {
            continue;
          }

          const areaName =
            option.dataset.areaName ??
            option.textContent ??
            "";

          const normalizedArea =
            normalizeText(
              areaName,
            );

          if (
            normalizedArea &&
            displayName.includes(
              normalizedArea,
            )
          ) {
            areaSelect.value =
              option.value;

            clearFieldError(
              "areaId",
            );

            return areaName.trim();
          }
        }

        return null;
      };

    /* ======================================================================
       ADDRESS
       ====================================================================== */

    const buildAutomaticAddress =
      (
        result: NominatimReverseResponse,
      ) => {
        const address =
          result.address ??
          {};

        const rawParts = [
          [
            address.house_number,
            address.road ??
              address.pedestrian ??
              address.footway,
          ]
            .filter(Boolean)
            .join(" "),

          address.neighbourhood,

          address.suburb,

          address.village,

          address.town,

          address.city_district,

          address.municipality,
        ]
          .filter(Boolean)
          .map(
            (value) =>
              String(
                value,
              ).trim(),
          )
          .filter(Boolean);

        const uniqueParts =
          Array.from(
            new Set(
              rawParts,
            ),
          );

        if (
          uniqueParts.length
        ) {
          return uniqueParts.join(
            ", ",
          );
        }

        return String(
          result.display_name ??
            "",
        )
          .split(",")
          .slice(
            0,
            5,
          )
          .join(", ")
          .trim();
      };

    /* ======================================================================
       REVERSE GEOCODING
       ====================================================================== */

    const reverseGeocode =
      async (
        lat: number,
        lng: number,
      ) => {
        const requestId =
          ++reverseGeocodeRequest;

        try {
          const url =
            new URL(
              "https://nominatim.openstreetmap.org/reverse",
            );

          url.searchParams.set(
            "format",
            "jsonv2",
          );

          url.searchParams.set(
            "lat",
            lat.toFixed(6),
          );

          url.searchParams.set(
            "lon",
            lng.toFixed(6),
          );

          url.searchParams.set(
            "zoom",
            "18",
          );

          url.searchParams.set(
            "addressdetails",
            "1",
          );

          url.searchParams.set(
            "layer",
            "address",
          );

          url.searchParams.set(
            "accept-language",
            "id",
          );

          const response =
            await fetch(
              url.toString(),
              {
                headers: {
                  Accept:
                    "application/json",
                },
              },
            );

          if (
            !response.ok
          ) {
            throw new Error(
              `Reverse geocoding failed: ${response.status}`,
            );
          }

          const result =
            (await response.json()) as NominatimReverseResponse;

          if (
            requestId !==
            reverseGeocodeRequest
          ) {
            return;
          }

          matchAreaFromReverseGeocode(
            result,
          );

          const automaticAddress =
            buildAutomaticAddress(
              result,
            );

          if (
            addressInput &&
            automaticAddress
          ) {
            addressInput.value =
              automaticAddress;

            clearFieldError(
              "address",
            );
          }
        } catch (error) {
          console.warn(
            "[BINSIGHT] Reverse geocoding failed:",
            error,
          );

          if (
            requestId !==
            reverseGeocodeRequest
          ) {
            return;
          }
        }
      };

    const scheduleReverseGeocode =
      (
        lat: number,
        lng: number,
      ) => {
        if (
          reverseGeocodeTimer !==
          null
        ) {
          window.clearTimeout(
            reverseGeocodeTimer,
          );
        }

        reverseGeocodeTimer =
          window.setTimeout(
            () => {
              reverseGeocode(
                lat,
                lng,
              );
            },
            650,
          );
      };

    /* ======================================================================
       UPDATE MARKER
       ====================================================================== */

    const updateMarkerPosition =
      (
        lat: number,
        lng: number,
        source:
          | "map"
          | "drag"
          | "gps",
      ) => {
        if (
          !locationMapInstance
        ) {
          return;
        }

        const clamped =
          clampToBadungBounds(
            lat,
            lng,
          );

        lat =
          clamped.lat;

        lng =
          clamped.lng;

        if (
          !locationMarker
        ) {
          locationMarker =
            L.marker(
              [
                lat,
                lng,
              ],
              {
                icon:
                  createLocationIcon(),

                draggable:
                  true,

                title:
                  "Geser untuk memilih lokasi",

                autoPan: true,
              },
            ).addTo(
              locationMapInstance,
            );

          locationMarker.on(
            "drag",
            () => {
              const position =
                locationMarker?.getLatLng();

              if (
                !position
              ) {
                return;
              }

              const bounded =
                clampToBadungBounds(
                  position.lat,
                  position.lng,
                );

              if (
                bounded.lat !==
                  position.lat ||
                bounded.lng !==
                  position.lng
              ) {
                locationMarker?.setLatLng(
                  [
                    bounded.lat,
                    bounded.lng,
                  ],
                );
              }

              setCoordinateInputs(
                bounded.lat,
                bounded.lng,
              );
            },
          );

          locationMarker.on(
            "dragend",
            () => {
              const position =
                locationMarker?.getLatLng();

              if (
                !position
              ) {
                return;
              }

              const bounded =
                clampToBadungBounds(
                  position.lat,
                  position.lng,
                );

              locationMarker?.setLatLng(
                [
                  bounded.lat,
                  bounded.lng,
                ],
              );

              setCoordinateInputs(
                bounded.lat,
                bounded.lng,
              );

              scheduleReverseGeocode(
                bounded.lat,
                bounded.lng,
              );
            },
          );
        } else {
          locationMarker.setLatLng(
            [
              lat,
              lng,
            ],
          );
        }

        setCoordinateInputs(
          lat,
          lng,
        );

        scheduleReverseGeocode(
          lat,
          lng,
        );

        if (
          source === "gps"
        ) {
          locationMapInstance.setView(
            [
              lat,
              lng,
            ],
            16,
            {
              animate: true,
            },
          );
        }
      };

    /* ======================================================================
       MAP INIT
       ====================================================================== */

    const initializeLocationMap =
      () => {
        if (
          !locationMap ||
          locationMap.dataset.initialized ===
            "true"
        ) {
          return;
        }

        locationMap.dataset.initialized =
          "true";

        try {
          locationMapInstance =
            L.map(
              locationMap,
              {
                center: [
                  DEFAULT_LAT,
                  DEFAULT_LNG,
                ],

                zoom: 13,

                minZoom: 11,

                maxZoom: 18,

                maxBounds:
                  BADUNG_BOUNDS,

                maxBoundsViscosity:
                  1,

                zoomControl: true,

                attributionControl:
                  false,

                scrollWheelZoom:
                  true,

                dragging: true,

                touchZoom: true,

                doubleClickZoom:
                  true,

                keyboard: true,
              },
            );

          L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
              maxZoom: 19,

              attribution:
                "© OpenStreetMap contributors",
            },
          ).addTo(
            locationMapInstance,
          );

          if (
            !locationMarker
          ) {
            locationMarker =
              L.marker(
                [
                  DEFAULT_LAT,
                  DEFAULT_LNG,
                ],
                {
                  icon:
                    createLocationIcon(),

                  draggable: true,

                  title:
                    "Geser untuk memilih lokasi",

                  autoPan: true,
                },
              ).addTo(
                locationMapInstance,
              );

            locationMarker.on(
              "drag",
              () => {
                const position =
                  locationMarker?.getLatLng();

                if (
                  !position
                ) {
                  return;
                }

                const bounded =
                  clampToBadungBounds(
                    position.lat,
                    position.lng,
                  );

                if (
                  bounded.lat !==
                    position.lat ||
                  bounded.lng !==
                    position.lng
                ) {
                  locationMarker?.setLatLng(
                    [
                      bounded.lat,
                      bounded.lng,
                    ],
                  );
                }

                setCoordinateInputs(
                  bounded.lat,
                  bounded.lng,
                );
              },
            );

            locationMarker.on(
              "dragend",
              () => {
                const position =
                  locationMarker?.getLatLng();

                if (
                  !position
                ) {
                  return;
                }

                const bounded =
                  clampToBadungBounds(
                    position.lat,
                    position.lng,
                  );

                locationMarker?.setLatLng(
                  [
                    bounded.lat,
                    bounded.lng,
                  ],
                );

                setCoordinateInputs(
                  bounded.lat,
                  bounded.lng,
                );

                scheduleReverseGeocode(
                  bounded.lat,
                  bounded.lng,
                );
              },
            );
          }

          locationMapInstance.on(
            "click",
            (
              event: L.LeafletMouseEvent,
            ) => {
              const bounded =
                clampToBadungBounds(
                  event.latlng.lat,
                  event.latlng.lng,
                );

              updateMarkerPosition(
                bounded.lat,
                bounded.lng,
                "map",
              );

              locationMapInstance?.panTo(
                [
                  bounded.lat,
                  bounded.lng,
                ],
                {
                  animate: true,
                },
              );
            },
          );

          setCoordinateInputs(
            DEFAULT_LAT,
            DEFAULT_LNG,
          );

          requestAnimationFrame(
            () => {
              locationMapInstance?.invalidateSize();
            },
          );

          window.setTimeout(
            () => {
              locationMapInstance?.invalidateSize();
            },
            200,
          );
        } catch (error) {
          console.error(
            "[BINSIGHT] Failed to initialize report location map:",
            error,
          );
        }
      };

    initializeLocationMap();

    /* ======================================================================
       CURRENT LOCATION
       ====================================================================== */

    locateButton?.addEventListener(
      "click",
      () => {
        if (
          !navigator.geolocation
        ) {
          return;
        }

        locateButton.disabled =
          true;

        const label =
          locateButton.querySelector<HTMLElement>(
            "span",
          );

        if (label) {
          label.textContent =
            "Mencari lokasi...";
        }

        navigator.geolocation.getCurrentPosition(
          (
            position,
          ) => {
            const lat =
              position.coords
                .latitude;

            const lng =
              position.coords
                .longitude;

            /*
             * Keep report map focused on Badung.
             * Ignore GPS positions outside the
             * map interaction area.
             */
            if (
              !BADUNG_BOUNDS.contains([
                lat,
                lng,
              ])
            ) {
              locateButton.disabled =
                false;

              if (label) {
                label.textContent =
                  "Gunakan lokasi saya";
              }

              return;
            }

            updateMarkerPosition(
              lat,
              lng,
              "gps",
            );

            locateButton.disabled =
              false;

            if (label) {
              label.textContent =
                "Gunakan lokasi saya";
            }
          },

          () => {
            locateButton.disabled =
              false;

            if (label) {
              label.textContent =
                "Gunakan lokasi saya";
            }
          },

          {
            enableHighAccuracy:
              true,

            timeout:
              12000,

            maximumAge:
              60000,
          },
        );
      },
    );

    /* ======================================================================
       VALIDATION
       ====================================================================== */

    const validateCoordinates =
      (): boolean => {
        const latitudeValue =
          latitudeInput?.value.trim() ??
          "";

        const longitudeValue =
          longitudeInput?.value.trim() ??
          "";

        if (
          !latitudeValue ||
          !longitudeValue
        ) {
          setFieldError(
            "latitude",
            "Pilih lokasi pada peta terlebih dahulu.",
          );

          setFieldError(
            "longitude",
            "Pilih lokasi pada peta terlebih dahulu.",
          );

          return false;
        }

        const lat =
          Number(
            latitudeValue,
          );

        const lng =
          Number(
            longitudeValue,
          );

        let valid = true;

        if (
          !Number.isFinite(
            lat,
          ) ||
          lat < -90 ||
          lat > 90
        ) {
          setFieldError(
            "latitude",
            "Latitude lokasi tidak valid.",
          );

          valid = false;
        }

        if (
          !Number.isFinite(
            lng,
          ) ||
          lng < -180 ||
          lng > 180
        ) {
          setFieldError(
            "longitude",
            "Longitude lokasi tidak valid.",
          );

          valid = false;
        }

        if (
          valid &&
          !BADUNG_BOUNDS.contains([
            lat,
            lng,
          ])
        ) {
          setFieldError(
            "latitude",
            "Lokasi harus berada dalam area fokus Kabupaten Badung.",
          );

          setFieldError(
            "longitude",
            "Lokasi harus berada dalam area fokus Kabupaten Badung.",
          );

          valid = false;
        }

        return valid;
      };

    const validateImage =
      (): boolean => {
        if (
          !imageInput
        ) {
          return true;
        }

        const file =
          imageInput.files?.[0];

        if (!file) {
          return true;
        }

        if (
          !REPORT_IMAGE_TYPES.has(
            file.type,
          )
        ) {
          setFieldError(
            "image",
            "Gunakan file JPG, PNG, atau WebP.",
          );

          return false;
        }

        if (
          file.size >
          REPORT_IMAGE_MAX_SIZE
        ) {
          setFieldError(
            "image",
            "Ukuran foto maksimal 5 MB.",
          );

          return false;
        }

        return true;
      };

    const validateReportForm =
      (): boolean => {
        clearAllErrors();

        const title =
          form.elements.namedItem(
            "title",
          );

        const description =
          form.elements.namedItem(
            "description",
          );

        const type =
          form.elements.namedItem(
            "type",
          );

        const area =
          form.elements.namedItem(
            "areaId",
          );

        const address =
          form.elements.namedItem(
            "address",
          );

        const confirmation =
          form.elements.namedItem(
            "confirmation",
          );

        let valid = true;

        if (
          !(
            title instanceof
            HTMLInputElement
          ) ||
          title.value.trim()
            .length < 5
        ) {
          setFieldError(
            "title",
            "Judul laporan minimal 5 karakter.",
          );

          valid = false;
        }

        if (
          !(
            description instanceof
            HTMLTextAreaElement
          ) ||
          description.value.trim()
            .length < 20
        ) {
          setFieldError(
            "description",
            "Deskripsi laporan minimal 20 karakter.",
          );

          valid = false;
        }

        if (
          !(
            type instanceof
            HTMLSelectElement
          ) ||
          !type.value
        ) {
          setFieldError(
            "type",
            "Silakan pilih jenis laporan.",
          );

          valid = false;
        }

        if (
          !(
            area instanceof
            HTMLSelectElement
          ) ||
          !area.value
        ) {
          setFieldError(
            "areaId",
            "Silakan pilih area atau kecamatan.",
          );

          valid = false;
        }

        if (
          !(
            address instanceof
            HTMLInputElement
          ) ||
          address.value.trim()
            .length < 5
        ) {
          setFieldError(
            "address",
            "Pilih lokasi pada peta agar alamat terisi otomatis.",
          );

          valid = false;
        }

        if (
          !(
            confirmation instanceof
            HTMLInputElement
          ) ||
          !confirmation.checked
        ) {
          setFieldError(
            "confirmation",
            "Konfirmasi diperlukan sebelum laporan dikirim.",
          );

          valid = false;
        }

        if (
          !validateCoordinates()
        ) {
          valid = false;
        }

        if (
          !validateImage()
        ) {
          valid = false;
        }

        if (!valid) {
          focusFirstInvalid();
        }

        return valid;
      };

    /* ======================================================================
       PAYLOAD
       ====================================================================== */

    const buildReportPayload =
      (): ReportSubmitPayload | null => {
        const formData =
          new FormData(form);

        const latitude =
          Number(
            String(
              formData.get(
                "latitude",
              ) ?? "",
            ).trim(),
          );

        const longitude =
          Number(
            String(
              formData.get(
                "longitude",
              ) ?? "",
            ).trim(),
          );

        const areaField =
          form.elements.namedItem(
            "areaId",
          );

        let areaName = "";

        if (
          areaField instanceof
          HTMLSelectElement
        ) {
          const selectedOption =
            areaField.options[
              areaField.selectedIndex
            ];

          areaName =
            selectedOption
              ?.dataset.areaName ??
            selectedOption
              ?.textContent
              ?.trim() ??
            "";
        }

        const image =
          formData.get("image");

        return {
          title:
            String(
              formData.get(
                "title",
              ) ?? "",
            ).trim(),

          description:
            String(
              formData.get(
                "description",
              ) ?? "",
            ).trim(),

          type:
            String(
              formData.get(
                "type",
              ) ?? "",
            ),

          category:
            String(
              formData.get(
                "category",
              ) ?? "",
            ),

          location: {
            address:
              String(
                formData.get(
                  "address",
                ) ?? "",
              ).trim(),

            areaId:
              String(
                formData.get(
                  "areaId",
                ) ?? "",
              ),

            areaName,

            coordinates: {
              lat: latitude,
              lng: longitude,
            },
          },

          reporterName:
            String(
              formData.get(
                "reporterName",
              ) ?? "",
            ).trim(),

          reporterContact:
            String(
              formData.get(
                "reporterContact",
              ) ?? "",
            ).trim(),

          notes:
            String(
              formData.get(
                "notes",
              ) ?? "",
            ).trim(),

          imageName:
            image instanceof File &&
            image.size > 0
              ? image.name
              : undefined,

          createdAt:
            new Date().toISOString(),
        };
      };

    /* ======================================================================
       SUBMIT
       ====================================================================== */

    const setSubmitting =
      (
        submitting: boolean,
      ) => {
        if (
          submitButton
        ) {
          submitButton.disabled =
            submitting;
        }

        if (
          submitLabel
        ) {
          submitLabel.textContent =
            submitting
              ? "Menyiapkan laporan..."
              : "Kirim laporan";
        }
      };

    const showSuccess =
      () => {
        form.hidden =
          true;

        successPanel.hidden =
          false;

        successPanel.setAttribute(
          "tabindex",
          "-1",
        );

        successPanel.scrollIntoView({
          behavior:
            "smooth",

          block:
            "start",
        });

        window.setTimeout(
          () => {
            successPanel.focus({
              preventScroll:
                true,
            });
          },
          300,
        );
      };

    /* ======================================================================
       RESET
       ====================================================================== */

    const resetReportForm =
      () => {
        form.reset();

        clearAllErrors();

        form.hidden =
          false;

        successPanel.hidden =
          true;

        setSubmitting(
          false,
        );

        updateTypeDescription();

        updateDescriptionCounter();

        if (
          imageName
        ) {
          imageName.textContent =
            "";

          imageName.hidden =
            true;
        }

        if (
          addressInput
        ) {
          addressInput.value =
            "";
        }

        if (
          areaSelect
        ) {
          areaSelect.value =
            "";
        }

        if (
          locationMapInstance
        ) {
          locationMapInstance.setView(
            [
              DEFAULT_LAT,
              DEFAULT_LNG,
            ],
            13,
            {
              animate: false,
            },
          );

          locationMarker?.setLatLng(
            [
              DEFAULT_LAT,
              DEFAULT_LNG,
            ],
          );

          setCoordinateInputs(
            DEFAULT_LAT,
            DEFAULT_LNG,
          );
        }

        const title =
          form.elements.namedItem(
            "title",
          );

        if (
          title instanceof
          HTMLInputElement
        ) {
          window.setTimeout(
            () => {
              title.focus();
            },
            50,
          );
        }
      };

    /* ======================================================================
       EVENTS
       ====================================================================== */

    typeSelect?.addEventListener(
      "change",
      updateTypeDescription,
    );

    descriptionField?.addEventListener(
      "input",
      updateDescriptionCounter,
    );

    imageInput?.addEventListener(
      "change",
      () => {
        clearFieldError(
          "image",
        );

        const file =
          imageInput.files?.[0];

        if (!file) {
          if (
            imageName
          ) {
            imageName.textContent =
              "";

            imageName.hidden =
              true;
          }

          return;
        }

        if (
          !REPORT_IMAGE_TYPES.has(
            file.type,
          )
        ) {
          setFieldError(
            "image",
            "Gunakan file JPG, PNG, atau WebP.",
          );

          imageInput.value =
            "";

          return;
        }

        if (
          file.size >
          REPORT_IMAGE_MAX_SIZE
        ) {
          setFieldError(
            "image",
            "Ukuran foto maksimal 5 MB.",
          );

          imageInput.value =
            "";

          return;
        }

        if (
          imageName
        ) {
          imageName.textContent =
            `${file.name} · ${(file.size / 1024 / 1024).toFixed(2)} MB`;

          imageName.hidden =
            false;
        }
      },
    );

    form.addEventListener(
      "submit",
      async (
        event: SubmitEvent,
      ) => {
        event.preventDefault();

        if (
          submitButton?.disabled
        ) {
          return;
        }

        if (
          !validateReportForm()
        ) {
          return;
        }

        const payload =
          buildReportPayload();

        if (!payload) {
          return;
        }

        setSubmitting(
          true,
        );

        await new Promise<void>(
          (resolve) => {
            window.setTimeout(
              resolve,
              80,
            );
          },
        );

        window.dispatchEvent(
          new CustomEvent<ReportSubmitPayload>(
            "binsight:report-submit",
            {
              detail:
                payload,
            },
          ),
        );

        showSuccess();
      },
    );

    newReportButton?.addEventListener(
      "click",
      resetReportForm,
    );

    form
      .querySelectorAll<
        HTMLInputElement |
        HTMLTextAreaElement |
        HTMLSelectElement
      >(
        "input, textarea, select",
      )
      .forEach(
        (field) => {
          if (
            field.name ===
              "latitude" ||
            field.name ===
              "longitude" ||
            field.name ===
              "address"
          ) {
            return;
          }

          field.addEventListener(
            "input",
            () => {
              clearFieldError(
                field.name,
              );
            },
          );

          field.addEventListener(
            "change",
            () => {
              clearFieldError(
                field.name,
              );
            },
          );
        },
      );

    updateTypeDescription();

    updateDescriptionCounter();
  };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeReportPage,
      {
        once: true,
      },
    );
  } else {
    initializeReportPage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeReportPage,
  );
</script>