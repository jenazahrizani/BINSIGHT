      Inter,
      sans-serif;

    font-size: 12px;

    font-weight: 900;

    line-height: 1;

    text-transform: uppercase;
  }

  .report-success__actions {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 24px;
  }

  .report-success__primary,
  .report-success__secondary {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 45px;

    padding: 0 13px;

    border:
      3px solid
      var(--white);

    border-radius: 0;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.06em;

    text-decoration: none;

    text-transform: uppercase;
