---
import {
  ArrowLeft,
  ArrowRight,
  CircleCheck,
  FileText,
  Image as ImageIcon,
  Info,
  LocateFixed,
  MapPin,
  Send,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import PublicLayout from "../../layouts/PublicLayout.astro";
import { getAreas } from "../../lib/data/locations";

const areas = getAreas().filter(
  (area) => area.status === "active",
);

const reportTypes = [
  {
    value: "illegal-dumping",
    label: "Pembuangan ilegal",
    description:
      "Sampah dibuang di lokasi yang tidak semestinya.",
  },
  {
    value: "overflowing-waste",
    label: "Sampah meluber",
    description:
      "Tempat sampah atau titik pengumpulan sudah penuh dan meluber.",
  },
  {
    value: "burning-waste",
    label: "Pembakaran sampah",
    description:
      "Aktivitas pembakaran sampah yang mengganggu lingkungan.",
  },
  {
    value: "hazardous-waste",
    label: "Sampah berbahaya",
    description:
      "Temuan limbah atau sampah yang membutuhkan penanganan khusus.",
  },
  {
    value: "environmental-pollution",
    label: "Pencemaran lingkungan",
    description:
      "Kondisi pencemaran yang berkaitan dengan sampah atau limbah.",
  },
  {
    value: "other",
    label: "Lainnya",
    description:
      "Masalah persampahan lain yang belum masuk kategori di atas.",
  },
];

const reportCategories = [
  {
    value: "organic",
    label: "Organik",
  },
  {
    value: "inorganic",
    label: "Anorganik",
  },
  {
    value: "hazardous",
    label: "Berbahaya",
  },
  {
    value: "electronic",
    label: "Elektronik",
  },
  {
    value: "residual",
    label: "Residu",
  },
  {
    value: "mixed",
    label: "Campuran / tidak diketahui",
  },
];

const pageTitle =
  "Buat Laporan — BINSIGHT";

const pageDescription =
  "Laporkan kondisi persampahan dan lingkungan yang Anda temukan di Kabupaten Badung.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Buat Laporan — BINSIGHT",
  description:
    "Formulir untuk mengirimkan laporan masyarakat terkait kondisi persampahan dan lingkungan di Kabupaten Badung.",
  url: "https://binsight.id/reports/create",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="report-create-page">

    <!-- =====================================================================
         HERO
         ================================================================== -->

    <section
      class="report-hero"
      aria-labelledby="report-hero-title"
    >
      <div class="report-hero__main">

        <div class="report-label">
          <TriangleAlert
            size={15}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            BINSIGHT · LAPORAN
          </span>
        </div>

        <div class="report-hero__crumbs">
          <a href="/">
            Beranda
          </a>

          <span aria-hidden="true">
            /
          </span>

          <a href="/reports">
            Laporan masyarakat
          </a>

          <span aria-hidden="true">
            /
          </span>

          <span>
            Buat laporan
          </span>
        </div>

        <h1 id="report-hero-title">
          Laporkan kondisi persampahan yang Anda temukan
        </h1>

        <p class="report-hero__description">
          Berikan informasi lokasi dan kondisi lapangan secara jelas.
          Laporan yang masuk dapat menjadi data pendukung untuk proses
          verifikasi dan pemantauan.
        </p>

      </div>

      <div class="report-hero__side">

        <div class="report-hero__side-mark">
          <Send
            size={22}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <div>
          <span class="report-hero__side-label">
            Kontribusi publik
          </span>

          <strong>
            Data lapangan
          </strong>

          <p>
            Detail yang jelas membantu laporan lebih mudah diverifikasi.
          </p>
        </div>

      </div>
    </section>

    <!-- =====================================================================
         CONTENT
         ================================================================== -->

    <section
      class="report-create-content"
      aria-label="Formulir laporan"
    >
      <div class="report-create-container">

        <div class="report-create-layout">

          <!-- ===============================================================
               MAIN
               ============================================================ -->

          <div class="report-create-main">

            <form
              id="report-create-form"
              class="report-form"
              novalidate
              data-report-form
            >

              <!-- =========================================================
                   01
                   ====================================================== -->

              <section class="form-section">

                <header class="form-section__header">

                  <span class="form-section__number">
                    01
                  </span>

                  <div>
                    <span class="form-section__eyebrow">
                      INFORMASI DASAR
                    </span>

                    <h2 class="form-section__title">
                      Informasi laporan
                    </h2>

                    <p class="form-section__description">
                      Jelaskan masalah persampahan yang Anda temukan.
                    </p>
                  </div>

                </header>

                <div class="form-grid">

                  <!-- TITLE -->

                  <div class="form-field form-field--full">

                    <label
                      class="form-field__label"
                      for="title"
                    >
                      Judul laporan

                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <p
                      id="title-hint"
                      class="form-field__hint"
                    >
                      Buat judul singkat yang menggambarkan kondisi di lokasi.
                    </p>

                    <input
                      id="title"
                      name="title"
                      class="form-field__input"
                      type="text"
                      placeholder="Contoh: Tumpukan sampah di pinggir jalan"
                      minlength="5"
                      maxlength="120"
                      required
                      aria-describedby="title-hint title-error"
                      autocomplete="off"
                    />

                    <div class="field-meta">

                      <p
                        id="title-error"
                        class="form-field__error"
                        data-field-error="title"
                        hidden
                      ></p>

                      <span class="field-meta__counter">
                        Maks. 120 karakter
                      </span>

                    </div>

                  </div>

                  <!-- DESCRIPTION -->

                  <div class="form-field form-field--full">

                    <label
                      class="form-field__label"
                      for="description"
                    >
                      Deskripsi kondisi

                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <p
                      id="description-hint"
                      class="form-field__hint"
                    >
                      Jelaskan apa yang Anda lihat, perkiraan kondisi,
                      dan hal penting lain yang membantu proses verifikasi.
                    </p>

                    <textarea
                      id="description"
                      name="description"
                      class="form-field__textarea"
                      placeholder="Jelaskan kondisi sampah atau pencemaran yang Anda temukan..."
                      minlength="20"
                      maxlength="2000"
                      rows="7"
                      required
                      aria-describedby="description-hint description-error"
                    ></textarea>

                    <div class="field-meta">

                      <p
                        id="description-error"
                        class="form-field__error"
                        data-field-error="description"
                        hidden
                      ></p>

                      <span
                        class="field-counter"
                        data-description-counter
                      >
                        0 / 2000
                      </span>

                    </div>

                  </div>

                  <!-- TYPE -->

                  <div class="form-field">

                    <label
                      class="form-field__label"
                      for="type"
                    >
                      Jenis laporan

                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="type"
                      name="type"
                      class="form-field__select"
                      required
                      aria-describedby="type-error type-explainer"
                    >
                      <option value="">
                        Pilih jenis laporan
                      </option>

                      {
                        reportTypes.map(
                          (item) => (
                            <option value={item.value}>
                              {item.label}
                            </option>
                          ),
                        )
                      }
                    </select>

                    <p
                      id="type-error"
                      class="form-field__error"
                      data-field-error="type"
                      hidden
                    ></p>

                    <div
                      id="type-explainer"
                      class="type-explainer"
                      data-type-explainer
                    >
                      Pilih kategori yang paling sesuai dengan kondisi lapangan.
                    </div>

                  </div>

                  <!-- CATEGORY -->

                  <div class="form-field">

                    <label
                      class="form-field__label"
                      for="category"
                    >
                      Kategori sampah
                    </label>

                    <select
                      id="category"
                      name="category"
                      class="form-field__select"
                      aria-describedby="category-hint"
                    >
                      <option value="">
                        Pilih kategori
                      </option>

                      {
                        reportCategories.map(
                          (item) => (
                            <option value={item.value}>
                              {item.label}
                            </option>
                          ),
                        )
                      }
                    </select>

                    <p
                      id="category-hint"
                      class="form-field__hint"
                    >
                      Pilih kategori apabila jenis sampah dapat diidentifikasi.
                    </p>

                  </div>

                </div>
              </section>

              <!-- =========================================================
                   02
                   ====================================================== -->

              <section class="form-section">

                <header class="form-section__header">

                  <span class="form-section__number">
                    02
                  </span>

                  <div>
                    <span class="form-section__eyebrow">
                      DATA SPASIAL
                    </span>

                    <h2 class="form-section__title">
                      Lokasi kejadian
                    </h2>

                    <p class="form-section__description">
                      Pilih lokasi langsung pada peta agar titik laporan lebih akurat.
                    </p>
                  </div>

                </header>

                <div class="location-notice">

                  <div class="location-notice__icon">
                    <LocateFixed
                      size={19}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>
                      Tentukan lokasi dengan peta
                    </strong>

                    <p>
                      Klik peta atau geser marker ke lokasi kejadian.
                      Gunakan lokasi perangkat untuk mendapatkan posisi saat ini.
                    </p>
                  </div>

                </div>

                <div class="form-grid">

                  <!-- ADDRESS -->

                  <div class="form-field">

                    <label
                      class="form-field__label"
                      for="address"
                    >
                      Alamat / lokasi

                      <span
                        class="form-field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <p
                      id="address-hint"
                      class="form-field__hint"
                    >
                      Alamat akan terisi otomatis berdasarkan posisi marker pada peta.
                    </p>

                    <div class="auto-address-field">

                      <div
                        class="auto-address-field__icon"
                        aria-hidden="true"
                      >
                        <MapPin
                          size={17}
                          stroke-width={2}
                        />
                      </div>

                      <input
                        id="address"
                        name="address"
                        class="form-field__input auto-address-field__input"
                        type="text"
                        placeholder="Pilih titik pada peta..."
                        minlength="5"
                        maxlength="300"
                        required
                        readonly
                        aria-readonly="true"
                        aria-describedby="address-hint address-error"
                        autocomplete="street-address"
                      />

                      <span
                        class="auto-address-field__badge"
                        aria-hidden="true"
                      >
                        OTOMATIS
                      </span>

                    </div>

                    <p
                      id="address-error"
                      class="form-field__error"
                      data-field-error="address"
                      hidden
                    ></p>

                  </div>

                  <!-- LOCATION PICKER -->

                  <div class="form-field form-field--full">

                    <div class="location-picker-header">

                      <div>
                        <label class="form-field__label">
                          Tandai lokasi pada peta
                        </label>

                        <p class="form-field__hint">
                          Klik peta atau geser titik merah ke lokasi kejadian.
                        </p>
                      </div>

                      <button
                        type="button"
                        class="location-picker__locate"
                        data-use-current-location
                      >
                        <LocateFixed
                          size={15}
                          stroke-width={2}
                          aria-hidden="true"
                        />

                        <span>
                          Gunakan lokasi saya
                        </span>
                      </button>

                    </div>

                    <div
                      class="location-picker"
                      data-location-picker
                    >

                      <div
                        class="location-picker__map"
                        data-location-map
                        aria-label="Pilih lokasi kejadian pada peta"
                      ></div>

                    </div>

                    <!-- READONLY COORDINATES -->

                    <div class="coordinates-grid">

                      <div class="form-field">

                        <label
                          class="form-field__label"
                          for="latitude"
                        >
                          Latitude
                        </label>

                        <div class="coordinate-field">

                          <span class="coordinate-field__prefix">
                            LAT
                          </span>

                          <input
                            id="latitude"
                            name="latitude"
                            class="form-field__input coordinate-field__input"
                            type="text"
                            readonly
                            aria-readonly="true"
                            placeholder="-8.550000"
                            aria-describedby="latitude-hint latitude-error"
                          />

                        </div>

                        <p
                          id="latitude-hint"
                          class="form-field__hint"
                        >
                          Diatur otomatis dari titik peta.
                        </p>

                        <p
                          id="latitude-error"
                          class="form-field__error"
                          data-field-error="latitude"
                          hidden
                        ></p>

                      </div>

                      <div class="form-field">

                        <label
                          class="form-field__label"
                          for="longitude"
                        >
                          Longitude
                        </label>

                        <div class="coordinate-field">

                          <span class="coordinate-field__prefix">
                            LNG
                          </span>

                          <input
                            id="longitude"
                            name="longitude"
                            class="form-field__input coordinate-field__input"
                            type="text"
                            readonly
                            aria-readonly="true"
                            placeholder="115.180000"
                            aria-describedby="longitude-hint longitude-error"
                          />

                        </div>

                        <p
                          id="longitude-hint"
                          class="form-field__hint"
                        >
                          Diatur otomatis dari titik peta.
                        </p>

                        <p
                          id="longitude-error"
                          class="form-field__error"
                          data-field-error="longitude"
                          hidden
                        ></p>

                      </div>

                    </div>

                  </div>

                </div>
              </section>

              <!-- =========================================================
                   03
                   ====================================================== -->

              <section class="form-section">

                <header class="form-section__header">

                  <span class="form-section__number">
                    03
                  </span>

                  <div>
                    <span class="form-section__eyebrow">
                      BUKTI & KONTAK
                    </span>

                    <h2 class="form-section__title">
                      Bukti dan pelapor
                    </h2>

                    <p class="form-section__description">
                      Tambahkan bukti visual dan informasi kontak seperlunya.
                    </p>
                  </div>

                </header>

                <div class="form-grid">

                  <div class="form-field form-field--full">

                    <label
                      class="form-field__label"
                      for="image"
                    >
                      Foto kondisi
                    </label>

                    <div class="file-field">

                      <input
                        id="image"
                        name="image"
                        class="file-field__input"
                        type="file"
                        accept="image/jpeg,image/png,image/webp"
                        data-report-image
                      />

                      <label
                        class="file-field__label"
                        for="image"
                      >

                        <span class="file-field__icon">
                          <ImageIcon
                            size={20}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </span>

                        <span class="file-field__copy">

                          <strong>
                            Pilih foto
                          </strong>

                          <small>
                            JPG, PNG, atau WebP · Maks. 5 MB
                          </small>

                        </span>

                        <span class="file-field__button">
                          Pilih file
                        </span>

                      </label>

                      <p
                        class="file-field__filename"
                        data-image-name
                        hidden
                      ></p>

                      <p
                        class="form-field__error"
                        data-field-error="image"
                        hidden
                      ></p>

                    </div>

                  </div>

                  <div class="form-field">

                    <label
                      class="form-field__label"
                      for="reporterName"
                    >
                      Nama pelapor
                    </label>

                    <input
                      id="reporterName"
                      name="reporterName"
                      class="form-field__input"
                      type="text"
                      maxlength="100"
                      placeholder="Nama Anda"
                      autocomplete="name"
                    />

                    <p class="form-field__hint">
                      Nama dapat dikosongkan.
                    </p>

                  </div>

                  <div class="form-field">

                    <label
                      class="form-field__label"
                      for="reporterContact"
                    >
                      Kontak pelapor
                    </label>

                    <input
                      id="reporterContact"
                      name="reporterContact"
                      class="form-field__input"
                      type="text"
                      maxlength="120"
                      placeholder="Email atau nomor telepon"
                      autocomplete="email"
                    />

                    <p class="form-field__hint">
                      Kontak bersifat opsional.
                    </p>

                  </div>

                  <div class="form-field form-field--full">

                    <label
                      class="form-field__label"
                      for="notes"
                    >
                      Catatan tambahan
                    </label>

                    <textarea
                      id="notes"
                      name="notes"
                      class="form-field__textarea form-field__textarea--small"
                      rows="4"
                      maxlength="1000"
                      placeholder="Informasi lain yang menurut Anda penting..."
                    ></textarea>

                  </div>

                </div>
              </section>

              <!-- =========================================================
                   CONFIRMATION
                   ====================================================== -->

              <section class="form-section form-section--confirmation">

                <div class="confirmation-box">

                  <div class="confirmation-box__icon">
                    <ShieldCheck
                      size={22}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="confirmation-box__content">

                    <span class="confirmation-box__eyebrow">
                      KONFIRMASI
                    </span>

                    <h2 class="confirmation-box__title">
                      Kirim laporan dengan informasi yang akurat
                    </h2>

                    <p class="confirmation-box__description">
                      Pastikan informasi yang Anda masukkan sesuai dengan
                      kondisi yang benar-benar Anda temukan di lapangan.
                    </p>

                  </div>

                </div>

                <label class="consent-field">

                  <input
                    type="checkbox"
                    name="confirmation"
                    value="confirmed"
                    required
                    data-report-confirmation
                  />

                  <span
                    class="consent-field__box"
                    aria-hidden="true"
                  ></span>

                  <span class="consent-field__text">
                    Saya memastikan informasi laporan ini dibuat berdasarkan
                    kondisi yang saya temukan dan bukan informasi yang
                    disengaja untuk menyesatkan.
                  </span>

                </label>

                <p
                  class="form-field__error form-field__error--confirmation"
                  data-field-error="confirmation"
                  hidden
                ></p>

                <div class="form-actions">

                  <a
                    class="form-actions__back"
                    href="/reports"
                  >
                    <ArrowLeft
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>
                      Kembali
                    </span>
                  </a>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-submit-button
                  >
                    <Send
                      size={18}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-submit-label>
                      Kirim laporan
                    </span>
                  </button>

                </div>

                <p class="form-actions__note">
                  Laporan akan dipersiapkan untuk proses verifikasi.
                </p>

              </section>

            </form>

            <!-- ===========================================================
                 SUCCESS
                 ======================================================== -->

            <div
              class="report-success"
              data-report-success
              hidden
            >

              <div class="report-success__top">

                <span class="report-success__icon">
                  <CircleCheck
                    size={31}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </span>

                <div>

                  <span class="report-success__eyebrow">
                    LAPORAN SIAP DIPROSES
                  </span>

                  <h2 class="report-success__title">
                    Laporan berhasil dipersiapkan
                  </h2>

                </div>

              </div>

              <p class="report-success__description">
                Data laporan telah lolos pemeriksaan dasar di browser.
                Sistem dapat meneruskannya ke proses penyimpanan atau
                verifikasi berikutnya.
              </p>

              <div class="report-success__summary">

                <div>
                  <span>
                    Status
                  </span>

                  <strong>
                    Siap diverifikasi
                  </strong>
                </div>

                <div>
                  <span>
                    Data
                  </span>

                  <strong>
                    Terisi & tervalidasi
                  </strong>
                </div>

              </div>

              <div class="report-success__actions">

                <a
                  class="report-success__primary"
                  href="/reports"
                >
                  <span>
                    Lihat laporan
                  </span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="report-success__secondary"
                  data-new-report
                >
                  Buat laporan lain
                </button>

              </div>

            </div>

          </div>

          <!-- =============================================================
               SIDEBAR
               ========================================================== -->

          <aside
            class="report-create-sidebar"
            aria-label="Panduan membuat laporan"
          >

            <div class="sidebar-card sidebar-card--dark">

              <div class="sidebar-card__top">

                <span class="sidebar-card__icon">
                  <Info
                    size={19}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </span>

                <span class="sidebar-card__eyebrow">
                  PANDUAN
                </span>

              </div>

              <h2 class="sidebar-card__title">
                Apa yang membuat laporan berguna?
              </h2>

              <p class="sidebar-card__description">
                Informasi yang spesifik membuat laporan lebih mudah dipahami
                dan diverifikasi.
              </p>

              <div class="sidebar-check-list">

                <div class="sidebar-check-item">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Judul yang jelas
                  </span>
                </div>

                <div class="sidebar-check-item">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Deskripsi kondisi
                  </span>
                </div>

                <div class="sidebar-check-item">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Lokasi yang mudah ditemukan
                  </span>
                </div>

                <div class="sidebar-check-item">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Foto apabila tersedia
                  </span>
                </div>

              </div>

            </div>

            <div class="sidebar-card">

              <div class="sidebar-card__top">

                <span class="sidebar-card__icon sidebar-card__icon--warning">
                  <TriangleAlert
                    size={19}
