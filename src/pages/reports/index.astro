<script>
  const searchInput =
    document.querySelector(
      "[data-report-search]",
    );

  const statusSelect =
    document.querySelector(
      "[data-report-status]",
    );

  const prioritySelect =
    document.querySelector(
      "[data-report-priority]",
    );

  const typeSelect =
    document.querySelector(
      "[data-report-type]",
    );

  const resetButton =
    document.querySelector(
      "[data-report-reset]",
    );

  const filterEmpty =
    document.querySelector(
      "[data-report-filter-empty]",
    );

  const reportCards = Array.from(
    document.querySelectorAll<HTMLElement>(
      "[data-report-card]",
    ),
  );

  function applyReportFilters() {
    const searchValue =
      searchInput instanceof HTMLInputElement
        ? searchInput.value
            .trim()
            .toLowerCase()
        : "";

    const statusValue =
      statusSelect instanceof HTMLSelectElement
        ? statusSelect.value
        : "all";

    const priorityValue =
      prioritySelect instanceof HTMLSelectElement
        ? prioritySelect.value
        : "all";

    const typeValue =
      typeSelect instanceof HTMLSelectElement
        ? typeSelect.value
        : "all";

    let visibleCount = 0;

    reportCards.forEach((card) => {
      const cardStatus =
        card.getAttribute(
          "data-report-status-value",
        ) ?? "";

      const cardPriority =
        card.getAttribute(
          "data-report-priority-value",
        ) ?? "";

      const cardType =
        card.getAttribute(
          "data-report-type-value",
        ) ?? "";

      const cardSearch =
        card.getAttribute(
          "data-report-search-value",
        ) ?? "";

      const matchesSearch =
        searchValue === "" ||
        cardSearch.includes(searchValue);

      const matchesStatus =
        statusValue === "all" ||
        cardStatus === statusValue;

      const matchesPriority =
        priorityValue === "all" ||
        cardPriority === priorityValue;

      const matchesType =
        typeValue === "all" ||
        cardType === typeValue;

      const visible =
        matchesSearch &&
        matchesStatus &&
        matchesPriority &&
        matchesType;

      card.hidden = !visible;

      if (visible) {
        visibleCount += 1;
      }
    });

    if (filterEmpty instanceof HTMLElement) {
      filterEmpty.hidden =
        visibleCount !== 0;
    }
  }

  function resetReportFilters() {
    if (searchInput instanceof HTMLInputElement) {
      searchInput.value = "";
    }

    if (statusSelect instanceof HTMLSelectElement) {
      statusSelect.value = "all";
    }

    if (prioritySelect instanceof HTMLSelectElement) {
      prioritySelect.value = "all";
    }

    if (typeSelect instanceof HTMLSelectElement) {
      typeSelect.value = "all";
    }

    applyReportFilters();
  }

  searchInput?.addEventListener(
    "input",
    applyReportFilters,
  );

  statusSelect?.addEventListener(
    "change",
    applyReportFilters,
  );

  prioritySelect?.addEventListener(
    "change",
    applyReportFilters,
  );

  typeSelect?.addEventListener(
    "change",
    applyReportFilters,
  );

  resetButton?.addEventListener(
    "click",
    resetReportFilters,
  );

  applyReportFilters();
</script>