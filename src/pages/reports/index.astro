  .reports-hero__side-mark svg {
    color: var(--acid);
    stroke: var(--acid);
  }

  .reports-hero__side-label {
    margin-bottom: 6px;

    color: #4b5147;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .reports-hero__side strong {
    display: block;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size:
      clamp(
        54px,
        7vw,
        88px
      );

    font-weight: 900;

    line-height: 0.8;

    letter-spacing: -0.09em;
  }

  .reports-hero__side-caption {
    margin-top: 8px;

    color: #4b5147;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 800;

    line-height: 1.3;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  /* ==========================================================================
     INTRO
     ========================================================================== */

  .reports-intro {
    padding:
      92px
      0
      34px;
  }

  .reports-intro__grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      300px;

    gap: 30px;

    align-items: stretch;
  }

  .reports-intro__copy {
    min-width: 0;

    padding:
      4px
      0
      6px;
  }

  .reports-section-label {
    display: flex;

    align-items: center;

    gap: 9px;

    color: #71786e;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .reports-section-label > span {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-width: 29px;

    min-height: 21px;

    padding: 0 5px;

    color: var(--acid);

    background: var(--ink);

    border:
      2px solid
      var(--ink);
  }

  .reports-intro__copy h2 {
    max-width: 650px;

    margin: 17px 0 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size:
      clamp(
        30px,
        4vw,
        53px
      );

    font-weight: 900;

    line-height: 0.93;

    letter-spacing: -0.075em;

    text-transform: uppercase;
  }

  .reports-intro__copy p {
    max-width: 680px;

    margin: 19px 0 0;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.8;
  }

  .reports-create {
    display: flex;

    align-items: center;

    gap: 12px;

    min-width: 0;

    padding: 15px;

    color: var(--ink);

    background: var(--acid);

    border:
      3px solid
      var(--ink);

    box-shadow:
      7px 7px 0
      var(--warning);

    text-decoration: none;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }

  .reports-create:hover {
    transform:
      translate(
        -2px,
        -2px
      );

    box-shadow:
      9px 9px 0
      var(--ink);
  }

  .reports-create__icon {
    display: grid;

    width: 45px;
    height: 45px;

    flex: 0 0 45px;

    place-items: center;

    color: var(--acid);

    background: var(--ink);

    border:
      2px solid
      var(--ink);
  }

  .reports-create__icon svg {
    color: var(--acid);
    stroke: var(--acid);
  }

  .reports-create__copy {
    display: grid;

    min-width: 0;

    flex: 1;
  }

  .reports-create__copy small {
    color: #566052;

    font-family:
      "DM Mono",
      monospace;

    font-size: 6px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.07em;
  }

  .reports-create__copy strong {
    margin-top: 5px;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 15px;

    font-weight: 900;

    line-height: 1;

    text-transform: uppercase;
  }

  .reports-create > svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  /* ==========================================================================
     STATS
     ========================================================================== */

  .reports-stats {
    padding:
      18px
      0
      35px;
  }

  .reports-stats__grid {
    display: grid;

    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );

    gap: 12px;
  }

  .report-stat {
    display: flex;

    align-items: center;

    gap: 12px;

    min-width: 0;

    min-height: 104px;

    padding: 15px;

    background: var(--white);

    border:
      3px solid
      var(--ink);

    box-shadow:
      5px 5px 0
      var(--ink);
  }

  .report-stat--dark {
    color: var(--white);

    background: var(--ink);

    box-shadow:
      5px 5px 0
      var(--acid);
  }

  .report-stat__number {
    color: var(--acid);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size:
      clamp(
        34px,
        4vw,
        46px
      );

    font-weight: 900;

    line-height: 0.85;

    letter-spacing: -0.075em;
  }

  .report-stat__copy {
    display: grid;

    min-width: 0;
  }

  .report-stat__copy span {
    color: #71786e;

    font-family:
      "DM Mono",
      monospace;

    font-size: 6px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;
  }

  .report-stat--dark
    .report-stat__copy
    span {
    color: #a2aaa0;
  }

  .report-stat__copy strong {
    margin-top: 6px;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 14px;

    font-weight: 900;

    line-height: 1.05;

    text-transform: uppercase;
  }

  .report-stat--dark
    .report-stat__copy
    strong {
    color: var(--white);
  }

  .report-stat__copy small {
    margin-top: 6px;

    color: #7a8177;

    font-size: 8px;

    line-height: 1.3;
  }

  .report-stat__icon {
    display: grid;

    width: 41px;
    height: 41px;

    flex: 0 0 41px;

    place-items: center;

    color: var(--ink);

    background: var(--paper-2);

    border:
      2px solid
      var(--ink);
  }

  .report-stat__icon svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .report-stat__icon--success {
    background: var(--acid);
  }

  .report-stat__icon--warning {
    background: var(--warning);
  }

  /* ==========================================================================
     REPORTS CONTENT
     ========================================================================== */

  .reports-content {
    padding:
      8px
      0
      105px;
  }

  .reports-toolbar {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 20px;

    padding-bottom: 15px;

    border-bottom:
      3px solid
      var(--ink);
  }

  .reports-toolbar__title-wrap {
    display: flex;

    align-items: center;

    gap: 12px;

    min-width: 0;
  }

  .reports-toolbar__icon {
    display: grid;

    width: 43px;
    height: 43px;

    flex: 0 0 43px;

    place-items: center;

    color: var(--acid);

    background: var(--ink);

    border:
      2px solid
      var(--ink);
  }

  .reports-toolbar__icon svg {
    color: var(--acid);
    stroke: var(--acid);
  }

  .reports-toolbar__title {
    margin: 7px 0 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 23px;

    font-weight: 900;

    line-height: 0.95;

    letter-spacing: -0.055em;

    text-transform: uppercase;
  }

  .reports-toolbar__result {
    display: flex;

    align-items: baseline;

    gap: 5px;

    color: #71786e;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.05em;

    text-transform: uppercase;
  }

  .reports-toolbar__result strong {
    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 28px;

    letter-spacing: -0.06em;
  }

  /* ==========================================================================
     FILTERS
     ========================================================================== */

  .reports-filters {
    display: grid;

    grid-template-columns:
      minmax(270px, 1.6fr)
      repeat(
        3,
        minmax(145px, 1fr)
      );

    gap: 10px;

    margin:
      18px
      0
      22px;
  }

  .reports-filter {
    min-width: 0;
  }

  .reports-filter__label {
    display: block;

    margin-bottom: 6px;

    color: #6f766c;

    font-family:
      "DM Mono",
      monospace;

    font-size: 6px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .reports-filter__search {
    position: relative;
  }

  .reports-filter__search svg {
    position: absolute;

    top: 50%;
    left: 11px;

    color: #727a70;

    transform:
      translateY(-50%);

    pointer-events: none;
  }

  .reports-filter__input,
  .reports-filter__select {
    display: block;

    width: 100%;

    min-height: 43px;

    padding:
      0
      11px;

    color: var(--ink);

    background: var(--white);

    border:
      2px solid
      var(--ink);

    border-radius: 0;

    outline: none;

    font-size: 10px;

    line-height: 1.4;
  }

  .reports-filter__input {
    padding-left: 37px;
  }

  .reports-filter__input::placeholder {
    color: #8a9187;
  }

  .reports-filter__input:focus,
  .reports-filter__select:focus {
    box-shadow:
      4px 4px 0
      var(--acid);
  }

  .reports-filter__reset {
    display: inline-flex;

    align-self: end;

    align-items: center;

    justify-content: center;

    gap: 5px;

    min-height: 43px;

    padding: 0 11px;

    color: var(--white);

    background: var(--ink);

    border:
      2px solid
      var(--ink);

    border-radius: 0;

    cursor: pointer;

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .reports-filter__reset:hover {
    color: var(--ink);

    background: var(--acid);
  }

  .reports-filter__reset[hidden] {
    display: none;
  }

  /* ==========================================================================
     REPORT CARD
     ========================================================================== */

  .reports-list {
    display: grid;

    gap: 12px;
  }

  .report-card {
    position: relative;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      160px;

    min-width: 0;

    background: var(--white);

    border:
      3px solid
      var(--ink);

    box-shadow:
      6px 6px 0
      var(--ink);

    overflow: hidden;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }

  .report-card:hover {
    transform:
      translate(
        -2px,
        -2px
      );

    box-shadow:
      8px 8px 0
      var(--warning);
  }

  .report-card[hidden] {
    display: none;
  }

  .report-card__accent {
    position: absolute;

    top: 0;
    bottom: 0;
    left: 0;

    width: 6px;

    background: var(--acid);
  }

  .report-card__body {
    min-width: 0;

    padding:
      18px
      18px
      17px
      23px;
  }

  .report-card__header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 14px;

    margin-bottom: 12px;
  }

  .report-card__type {
    display: grid;

    width: 39px;
    height: 39px;

    flex: 0 0 39px;

    place-items: center;

    border:
      2px solid
      var(--ink);
  }

  .report-card__type--warning {
    color: var(--ink);

    background: var(--acid);
  }

  .report-card__type--hazardous {
    color: var(--white);

    background: var(--warning);
  }

  .report-card__type--environmental {
    color: var(--acid);

    background: var(--ink);
  }

  .report-card__type--other {
    color: var(--ink);

    background: var(--paper-2);
  }

  .report-card__type svg {
    color: inherit;
    stroke: currentColor;
  }

  .report-card__badges {
    display: flex;

    align-items: center;

    justify-content: flex-end;

    flex-wrap: wrap;

    gap: 6px;

    min-width: 0;
  }

  .report-status,
  .report-priority {
    display: inline-flex;

    align-items: center;

    min-height: 23px;

    padding:
      0
      7px;

    border:
      2px solid
      var(--ink);

    border-radius: 0;

    font-family:
      "DM Mono",
      monospace;

    font-size: 6px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.04em;

    text-transform: uppercase;

    white-space: nowrap;
  }

  .report-status--pending {
    color: var(--ink);

    background: var(--acid);
  }

  .report-status--verified {
    color: var(--ink);

    background: #a9d8ff;
  }

  .report-status--in-progress {
    color: var(--ink);

    background: #cfb9ff;
  }

  .report-status--resolved {
    color: var(--ink);

    background: #a8efb5;
  }

  .report-status--rejected {
    color: var(--white);

    background: var(--ink);
  }

  .report-priority--high {
    color: var(--white);

    background: var(--warning);
  }

  .report-priority--medium {
    color: var(--ink);

    background: #ffd24a;
  }

  .report-priority--low {
    color: var(--ink);

    background: var(--paper-2);
  }

  .report-card__title {
    display: block;

    margin: 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 18px;

    font-weight: 900;

    line-height: 1.03;

    letter-spacing: -0.045em;

    text-transform: uppercase;

    text-decoration: none;
  }

  .report-card__title:hover {
    color: #474d43;
  }

  .report-card__description {
    display: -webkit-box;

    max-width: 860px;

    margin: 9px 0 0;

    overflow: hidden;

    color: #656c63;

    font-size: 10px;

    line-height: 1.7;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .report-card__meta {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap:
      8px
      15px;

    margin-top: 14px;
  }

  .report-card__meta span {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    min-width: 0;

    color: #757c72;

    font-family:
      "DM Mono",
      monospace;

    font-size: 6px;

    font-weight: 800;

    line-height: 1.3;

    letter-spacing: 0.025em;

    text-transform: uppercase;
  }

  .report-card__meta svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .report-card__meta strong {
    color: var(--ink);
  }

  .report-card__footer {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;

    padding:
      18px
      15px;

    color: var(--white);

    background: var(--ink);

    border-left:
      3px solid
      var(--ink);
  }

  .report-card__id {
    display: grid;

    gap: 4px;

    color: #8f978e;

    font-family:
      "DM Mono",
      monospace;

    font-size: 6px;

    font-weight: 800;

    line-height: 1;

    letter-spacing: 0.05em;
  }

  .report-card__id strong {
    color: var(--acid);

    font-size: 8px;
  }

  .report-card__detail {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: var(--acid);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.05em;

    text-decoration: none;

    text-transform: uppercase;
  }

  .report-card__detail:hover {
    color: var(--white);
  }

  .report-card__detail svg {
    color: currentColor;
    stroke: currentColor;
  }

  /* ==========================================================================
     EMPTY STATES
     ========================================================================== */

  .reports-empty,
  .reports-no-results {
    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    min-height: 340px;

    padding: 40px 24px;

    color: var(--ink);

    background: var(--white);

    border:
      3px solid
      var(--ink);

    box-shadow:
      6px 6px 0
      var(--ink);

    text-align: center;
  }

  .reports-empty__icon,
  .reports-no-results__icon {
    display: grid;

    width: 58px;
    height: 58px;

    place-items: center;

    margin-bottom: 14px;

    color: var(--acid);

    background: var(--ink);

    border:
      3px solid
      var(--ink);

    box-shadow:
      5px 5px 0
      var(--warning);
  }

  .reports-empty__icon svg,
  .reports-no-results__icon svg {
    color: var(--acid);
    stroke: var(--acid);
  }

  .reports-empty__label,
  .reports-no-results > span {
    color: #70776d;

    font-family:
      "DM Mono",
      monospace;

    font-size: 6px;

    font-weight: 900;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .reports-empty h3,
  .reports-no-results h3 {
    max-width: 520px;

    margin: 9px 0 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 23px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: -0.05em;

    text-transform: uppercase;
  }

  .reports-empty p,
  .reports-no-results p {
    max-width: 480px;

    margin: 9px 0 0;

    color: var(--muted);

    font-size: 9px;

    line-height: 1.7;
  }

  .reports-empty__button,
  .reports-no-results button {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    min-height: 43px;

    margin-top: 17px;

    padding:
      0
      13px;

    color: var(--ink);

    background: var(--acid);

    border:
      3px solid
      var(--ink);

    box-shadow:
      5px 5px 0
      var(--warning);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.06em;

    text-decoration: none;

    text-transform: uppercase;

    cursor: pointer;
  }

  .reports-empty__button:hover,
  .reports-no-results button:hover {
    background: var(--acid-soft);
  }

  .reports-no-results[hidden] {
    display: none;
  }

  /* ==========================================================================
     GUIDANCE
     ========================================================================== */

  .reports-guidance {
    padding:
      0
      0
      110px;
  }

  .reports-guidance__inner {
    display: grid;

    grid-template-columns:
      48px
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 14px;

    padding: 18px;

    color: var(--white);

    background: var(--ink);

    border:
      4px solid
      var(--ink);

    box-shadow:
      9px 9px 0
      var(--acid);
  }

  .reports-guidance__icon {
    display: grid;

    width: 48px;
    height: 48px;

    place-items: center;

    color: var(--ink);

    background: var(--acid);

    border:
      2px solid
      var(--white);
  }

  .reports-guidance__icon svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .reports-guidance__copy > span {
    color: var(--acid);

    font-family:
      "DM Mono",
      monospace;

    font-size: 6px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;
  }

  .reports-guidance__copy h2 {
    margin: 7px 0 0;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 18px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: -0.045em;

    text-transform: uppercase;
  }

  .reports-guidance__copy p {
    max-width: 620px;

    margin: 7px 0 0;

    color: #aeb5ab;

    font-size: 8px;

    line-height: 1.65;
  }

  .reports-guidance__link {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    min-height: 43px;

    padding:
      0
      12px;

    color: var(--ink);

    background: var(--acid);

    border:
      3px solid
      var(--white);

    box-shadow:
      4px 4px 0
      var(--warning);

    font-family:
      "DM Mono",
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.06em;

    text-decoration: none;

    text-transform: uppercase;
  }

  .reports-guidance__link:hover {
    background: var(--acid-soft);
  }

  /* ==========================================================================
     FOCUS
     ========================================================================== */

  .reports-page a:focus-visible,
  .reports-page button:focus-visible,
  .reports-page input:focus-visible,
  .reports-page select:focus-visible {
