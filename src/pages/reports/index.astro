---
import {
  ArrowRight,
  Check,
  CircleCheck,
  Clock3,
  FileText,
  ListFilter,
  MapPin,
  Plus,
  Search,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import PublicLayout from "../../layouts/PublicLayout.astro";
import { getReports } from "../../lib/data/reports";

const reports = getReports();

type ReportItem =
  ReturnType<typeof getReports> extends readonly (infer T)[]
    ? T
    : never;

const statusLabels: Record<
  ReportItem["status"],
  string
> = {
  pending: "Menunggu verifikasi",
  verified: "Terverifikasi",
  "in-progress": "Sedang ditangani",
  resolved: "Selesai",
  rejected: "Ditolak",
};

const priorityLabels: Record<
  ReportItem["priority"],
  string
> = {
  low: "Rendah",
  medium: "Sedang",
  high: "Tinggi",
};

const typeLabels: Record<
  ReportItem["type"],
  string
> = {
  "illegal-dumping": "Pembuangan ilegal",
  "overflowing-waste": "Sampah meluber",
  "burning-waste": "Pembakaran sampah",
  "hazardous-waste": "Sampah berbahaya",
  "environmental-pollution": "Pencemaran lingkungan",
  other: "Lainnya",
};

const reportStatusOrder: ReportItem["status"][] = [
  "pending",
  "verified",
  "in-progress",
  "resolved",
  "rejected",
];

const statusCounts =
  reportStatusOrder.reduce(
    (
      accumulator,
      status,
    ) => {
      accumulator[status] =
        reports.filter(
          (report) =>
            report.status ===
            status,
        ).length;

      return accumulator;
    },
    {} as Record<
      ReportItem["status"],
      number
    >,
  );

const activeCount =
  statusCounts.pending +
  statusCounts.verified +
  statusCounts["in-progress"];

const resolvedCount =
  statusCounts.resolved;

const highPriorityCount =
  reports.filter(
    (report) =>
      report.priority ===
      "high",
  ).length;

function getDateValue(
  value: unknown,
): Date | null {
  if (
    value instanceof Date
  ) {
    return Number.isNaN(
      value.getTime(),
    )
      ? null
      : value;
  }

  if (
    typeof value ===
      "string" ||
    typeof value ===
      "number"
  ) {
    const date = new Date(
      value,
    );

    return Number.isNaN(
      date.getTime(),
    )
      ? null
      : date;
  }

  if (
    typeof value ===
      "object" &&
    value !== null &&
    "toDate" in value &&
    typeof value.toDate ===
      "function"
  ) {
    const date =
      value.toDate();

    return date instanceof
        Date &&
      !Number.isNaN(
        date.getTime(),
      )
      ? date
      : null;
  }

  return null;
}

function formatDate(
  value: unknown,
): string {
  const date =
    getDateValue(value);

  if (!date) {
    return "Tanggal tidak tersedia";
  }

  return new Intl.DateTimeFormat(
    "id-ID",
    {
      day: "numeric",
      month: "short",
      year: "numeric",
    },
  ).format(date);
}

function getReportTypeIcon(
  type: ReportItem["type"],
): "warning" | "hazardous" | "environmental" | "other" {
  switch (type) {
    case "illegal-dumping":
    case "overflowing-waste":
    case "burning-waste":
      return "warning";

    case "hazardous-waste":
      return "hazardous";

    case "environmental-pollution":
      return "environmental";

    default:
      return "other";
  }
}

function getStatusClass(
  status: ReportItem["status"],
): string {
  return `report-status report-status--${status}`;
}

function getPriorityClass(
  priority: ReportItem["priority"],
): string {
  return `report-priority report-priority--${priority}`;
}

function getTypeClass(
  type: ReportItem["type"],
): string {
  return `report-card__type report-card__type--${getReportTypeIcon(
    type,
  )}`;
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Laporan Masyarakat — BINSIGHT",
  description:
    "Kumpulan laporan masyarakat terkait kondisi persampahan dan lingkungan di Kabupaten Badung.",
  url: "https://binsight.id/reports",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<PublicLayout
  title="Laporan Masyarakat"
  description="Laporan masyarakat terkait persampahan dan kondisi lingkungan di Kabupaten Badung."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(
      jsonLd,
    )}
  />

  <main
    class="reports-page"
    data-reports-page
  >

    <!-- =====================================================================
         HERO
         ================================================================== -->

    <section
      class="reports-hero"
      aria-labelledby="reports-title"
    >
      <div class="reports-hero__main">

        <div class="reports-kicker">
          <ShieldCheck
            size={15}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            BINSIGHT · LAPORAN MASYARAKAT
          </span>
        </div>

        <div class="reports-breadcrumbs">
          <a href="/">
            Beranda
          </a>

          <span aria-hidden="true">
            /
          </span>

          <span>
            Laporan masyarakat
          </span>
        </div>

        <h1 id="reports-title">
          Kondisi lapangan,
          dilaporkan masyarakat.
        </h1>

        <p class="reports-hero__description">
          Pantau laporan persampahan yang tercatat di Kabupaten Badung,
          lihat status penanganannya, dan temukan informasi lapangan
          yang relevan.
        </p>

      </div>

      <div class="reports-hero__side">

        <div class="reports-hero__side-mark">
          <FileText
            size={22}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>

        <span class="reports-hero__side-label">
          DATA PUBLIK
        </span>

        <strong>
          {reports.length}
        </strong>

        <span class="reports-hero__side-caption">
          laporan tercatat
        </span>

      </div>
    </section>

    <!-- =====================================================================
         INTRO
         ================================================================== -->

    <section
      class="reports-intro"
      aria-label="Tentang laporan masyarakat"
    >
      <div class="reports-container">

        <div class="reports-intro__grid">

          <div class="reports-intro__copy">

            <span class="reports-section-label">
              <span>01</span>
              KONTEKS LAPANGAN
            </span>

            <h2>
              Suara masyarakat
              menjadi data.
            </h2>

            <p>
              Laporan publik membantu membangun gambaran kondisi
              persampahan dari tingkat lokasi. Setiap laporan dapat
              dibaca bersama dengan informasi area, kategori, prioritas,
              dan status penanganannya.
            </p>

          </div>

          <a
            class="reports-create"
            href="/reports/create"
          >
            <span class="reports-create__icon">
              <Plus
                size={20}
                stroke-width={2.3}
                aria-hidden="true"
              />
            </span>

            <span class="reports-create__copy">
              <small>
                KONTRIBUSI PUBLIK
              </small>

              <strong>
                Buat laporan
              </strong>
            </span>

            <ArrowRight
              size={19}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>

        </div>

      </div>
    </section>

    <!-- =====================================================================
         STATS
         ================================================================== -->

    <section
      class="reports-stats"
      aria-label="Ringkasan laporan"
    >
      <div class="reports-container">

        <div class="reports-stats__grid">

          <article class="report-stat report-stat--dark">

            <div class="report-stat__number">
              {reports.length}
            </div>

            <div class="report-stat__copy">
              <span>
                TOTAL
              </span>

              <strong>
                Semua laporan
              </strong>
            </div>

          </article>

          <article class="report-stat">

            <div class="report-stat__icon">
              <Clock3
                size={19}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="report-stat__copy">
              <span>
                AKTIF
              </span>

              <strong>
                {activeCount}
              </strong>

              <small>
                masih dalam proses
              </small>
            </div>

          </article>

          <article class="report-stat">

            <div class="report-stat__icon report-stat__icon--success">
              <CircleCheck
                size={19}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="report-stat__copy">
              <span>
                SELESAI
              </span>

              <strong>
                {resolvedCount}
              </strong>

              <small>
                laporan terselesaikan
              </small>
            </div>

          </article>

          <article class="report-stat">

            <div class="report-stat__icon report-stat__icon--warning">
              <TriangleAlert
                size={19}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="report-stat__copy">
              <span>
                PRIORITAS
              </span>

              <strong>
                {highPriorityCount}
              </strong>

              <small>
                perlu perhatian lebih
              </small>
            </div>

          </article>

        </div>

      </div>
    </section>

    <!-- =====================================================================
         REPORTS
         ================================================================== -->

    <section
      class="reports-content"
      aria-labelledby="reports-list-title"
    >
      <div class="reports-container">

        <div class="reports-toolbar">

          <div class="reports-toolbar__title-wrap">

            <div class="reports-toolbar__icon">
              <ListFilter
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div>
              <span class="reports-section-label">
                <span>02</span>
                DATABASE LAPORAN
              </span>

              <h2
                id="reports-list-title"
                class="reports-toolbar__title"
              >
                Laporan masyarakat
              </h2>
            </div>

          </div>

          <div class="reports-toolbar__result">
            <strong
              data-report-result-count
            >
              {reports.length}
            </strong>

            <span>
              laporan
            </span>
          </div>

        </div>

        <div
          class="reports-filters"
          data-report-filters
        >

          <div class="reports-filter reports-filter--search">

            <label
              class="reports-filter__label"
              for="report-search"
            >
              Cari
            </label>

            <div class="reports-filter__search">
              <Search
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />

              <input
                id="report-search"
                type="search"
                class="reports-filter__input"
                placeholder="Cari judul, alamat, area..."
                autocomplete="off"
                data-report-search
              />

            </div>

          </div>

          <div class="reports-filter">

            <label
              class="reports-filter__label"
              for="report-status"
            >
              Status
            </label>

            <select
              id="report-status"
              class="reports-filter__select"
              data-report-status
            >
              <option value="all">
                Semua status
              </option>

              {
                reportStatusOrder.map(
                  (status) => (
                    <option value={status}>
                      {statusLabels[status]}
                    </option>
                  ),
                )
              }
            </select>

          </div>

          <div class="reports-filter">

            <label
              class="reports-filter__label"
              for="report-priority"
            >
              Prioritas
            </label>

            <select
              id="report-priority"
              class="reports-filter__select"
              data-report-priority
            >
              <option value="all">
                Semua prioritas
              </option>

              <option value="high">
                Tinggi
              </option>

              <option value="medium">
                Sedang
              </option>

              <option value="low">
                Rendah
              </option>
            </select>

          </div>

          <div class="reports-filter">

            <label
              class="reports-filter__label"
              for="report-type"
            >
              Jenis
            </label>

            <select
              id="report-type"
              class="reports-filter__select"
              data-report-type
            >
              <option value="all">
                Semua jenis
              </option>

              {
                Object.entries(
                  typeLabels,
                ).map(
                  ([value, label]) => (
                    <option value={value}>
                      {label}
                    </option>
                  ),
                )
              }
            </select>

          </div>

          <button
            type="button"
            class="reports-filter__reset"
            data-report-reset
            hidden
          >
            <span>
              Reset
            </span>

            <span aria-hidden="true">
              ×
            </span>
          </button>

        </div>

        <div
          class="reports-list"
          data-report-list
        >
          {
            reports.length > 0 ? (
              reports.map((report) => {
                const typeIcon =
                  getReportTypeIcon(
                    report.type,
                  );

                const searchableText = [
                  report.title,
                  report.description,
                  report.location.address,
                  report.location.areaName,
                  typeLabels[
                    report.type
                  ],
                  statusLabels[
                    report.status
                  ],
                  priorityLabels[
                    report.priority
                  ],
                ]
                  .filter(Boolean)
                  .join(" ")
                  .toLowerCase();

                const date =
                  getDateValue(
                    report.createdAt,
                  );

                const isoDate =
                  date?.toISOString();

                return (
                  <article
                    class="report-card"
                    data-report-card
                    data-report-status={report.status}
                    data-report-priority={
                      report.priority
                    }
                    data-report-type={report.type}
                    data-report-search={searchableText}
                  >

                    <div class="report-card__accent"></div>

                    <div class="report-card__body">

                      <div class="report-card__header">

                        <div
                          class={getTypeClass(
                            report.type,
                          )}
                        >
                          {typeIcon ===
                          "environmental" ? (
                            <MapPin
                              size={19}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          ) : typeIcon ===
                            "hazardous" ||
                            typeIcon ===
                              "warning" ? (
                            <TriangleAlert
                              size={19}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          ) : (
                            <FileText
                              size={19}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          )}
                        </div>

                        <div class="report-card__badges">

                          <span
                            class={getStatusClass(
                              report.status,
                            )}
                          >
                            {statusLabels[
                              report.status
                            ]}
                          </span>

                          <span
                            class={getPriorityClass(
                              report.priority,
                            )}
                          >
                            {priorityLabels[
                              report.priority
                            ]}
                          </span>

                        </div>

                      </div>

                      <a
                        class="report-card__title"
                        href={`/reports/${report.id}`}
                      >
                        {report.title}
                      </a>

                      <p class="report-card__description">
                        {report.description}
                      </p>

                      <div class="report-card__meta">

                        <span>
                          <MapPin
                            size={14}
                            stroke-width={2}
                            aria-hidden="true"
                          />

                          <strong>
                            {report.location.areaName}
                          </strong>
                        </span>

                        <span>
                          <Clock3
                            size={14}
                            stroke-width={2}
                            aria-hidden="true"
                          />

                          <time datetime={isoDate}>
                            {formatDate(
                              report.createdAt,
                            )}
                          </time>
                        </span>

                        <span>
                          <FileText
                            size={14}
                            stroke-width={2}
                            aria-hidden="true"
                          />

                          {typeLabels[
                            report.type
                          ]}
                        </span>

                      </div>

                    </div>

                    <div class="report-card__footer">

                      <span class="report-card__id">
                        REPORT
                        <strong>
                          {String(
                            report.id,
                          ).slice(
                            0,
                            8,
                          ).toUpperCase()}
                        </strong>
                      </span>

                      <a
                        class="report-card__detail"
                        href={`/reports/${report.id}`}
                        aria-label={`Lihat detail laporan ${report.title}`}
                      >
                        <span>
                          Detail
                        </span>

                        <ArrowRight
                          size={17}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </a>

                    </div>

                  </article>
                );
              })
            ) : (
              <div class="reports-empty">

                <div class="reports-empty__icon">
                  <FileText
                    size={28}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>

                <span class="reports-empty__label">
                  DATABASE KOSONG
                </span>

                <h3>
                  Belum ada laporan
                </h3>

                <p>
                  Belum ada laporan masyarakat yang tersedia.
                </p>

                <a
                  href="/reports/create"
                  class="reports-empty__button"
                >
                  <Plus
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Buat laporan
                  </span>
                </a>

              </div>
            )
          }
        </div>

        <div
          class="reports-no-results"
          data-report-no-results
          hidden
        >
          <div class="reports-no-results__icon">
            <Search
              size={25}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </div>

          <span>
            FILTER
          </span>

          <h3>
            Tidak ada laporan yang cocok
          </h3>

          <p>
            Ubah kata kunci atau filter untuk melihat laporan lainnya.
          </p>

          <button
            type="button"
            data-report-reset-empty
          >
            Reset filter
          </button>
        </div>

      </div>
    </section>

    <!-- =====================================================================
         GUIDANCE
         ================================================================== -->

    <section class="reports-guidance">

      <div class="reports-container">

        <div class="reports-guidance__inner">

          <div class="reports-guidance__icon">
            <ShieldCheck
              size={21}
              stroke-width={2}
              aria-hidden="true"
            />
          </div>

          <div class="reports-guidance__copy">

            <span>
              03 · KONTRIBUSI
            </span>

            <h2>
              Temukan kondisi lapangan?
            </h2>

            <p>
              Sampaikan lokasi dan kondisi secara jelas agar
              laporan dapat dipahami dan diverifikasi.
            </p>

          </div>

          <a
            href="/reports/create"
            class="reports-guidance__link"
          >
            <span>
              Buat laporan
            </span>

            <ArrowRight
              size={18}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>

        </div>

      </div>

    </section>

  </main>
</PublicLayout>

<style>
  /* ==========================================================================
     PAGE
     ========================================================================== */

  .reports-page,
  .reports-page *,
  .reports-page *::before,
  .reports-page *::after {
    box-sizing: border-box;
  }

  .reports-page {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;

    --white: #fffef8;
    --muted: #6c7068;

    --warning: #ff6a00;

    min-height: 100vh;

    color: var(--ink);

    background:
      repeating-linear-gradient(
        135deg,
        rgba(9, 10, 8, 0.025) 0 1px,
        transparent 1px 9px
      ),
      var(--paper);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .reports-page a {
    color: inherit;
  }

  .reports-page button,
  .reports-page input,
  .reports-page select {
    font: inherit;
  }

  .reports-page svg {
    flex: 0 0 auto;
  }

  .reports-page h1,
  .reports-page h2,
  .reports-page h3,
  .reports-page p {
    overflow-wrap: anywhere;
  }

  .reports-container {
    width: min(
      1180px,
      calc(100% - 40px)
    );

    margin-inline: auto;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .reports-hero {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      270px;

    width: min(
      1320px,
      calc(100% - 40px)
    );

    margin:
      24px
      auto
      0;

    color: var(--white);

    background: var(--ink);

    border: 4px solid var(--ink);

    box-shadow:
      14px 14px 0
      var(--warning);

    overflow: hidden;
  }

  .reports-hero__main {
    min-width: 0;

    padding:
      clamp(
        40px,
        5vw,
        68px
      );
  }

  .reports-kicker {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    width: fit-content;

    min-height: 30px;

    padding: 7px 10px;

    color: var(--ink);

    background: var(--acid);

    border: 3px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .reports-kicker svg {
    color: var(--ink);
    stroke: var(--ink);
  }

  .reports-breadcrumbs {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 7px;

    margin-top: 25px;

    color: #9ba198;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 700;

    line-height: 1.5;

    letter-spacing: 0.05em;

    text-transform: uppercase;
  }

  .reports-breadcrumbs a {
    color: #c5c9c0;

    text-decoration: none;
  }

  .reports-breadcrumbs a:hover {
    color: var(--acid);
  }

  .reports-hero h1 {
    max-width: 900px;

    margin: 30px 0 0;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size:
      clamp(
        47px,
        6vw,
        80px
      );

    font-weight: 900;

    line-height: 0.87;

    letter-spacing: -0.085em;

    text-transform: uppercase;
  }

  .reports-hero__description {
    max-width: 680px;

    margin: 33px 0 0;

    padding:
      5px
      0
      5px
      16px;

    color: #d3d8ce;

    border-left:
      7px solid
      var(--acid);

    font-size: 12px;

    line-height: 1.8;
  }

  .reports-hero__side {
    display: flex;

    flex-direction: column;

    justify-content: flex-end;

    min-width: 0;

    padding: 28px;

    color: var(--ink);

    background: var(--acid);

    border-left:
      4px solid
      var(--ink);
  }

  .reports-hero__side-mark {
    display: grid;

    width: 57px;
    height: 57px;

    place-items: center;

    margin-bottom: auto;

    color: var(--acid);

    background: var(--ink);

    border: 3px solid var(--ink);

    box-shadow:
      7px 7px 0
      var(--warning);
