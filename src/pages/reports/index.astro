</style>

<script>
  const initializeReportsPage =
    () => {
      const page =
        document.querySelector<HTMLElement>(
          "[data-reports-page]",
        );

      if (
        !page ||
        page.dataset.initialized ===
          "true"
      ) {
        return;
      }

      page.dataset.initialized =
        "true";

      const searchInput =
        page.querySelector<HTMLInputElement>(
          "[data-report-search]",
        );

      const statusSelect =
        page.querySelector<HTMLSelectElement>(
          "[data-report-status]",
        );

      const prioritySelect =
        page.querySelector<HTMLSelectElement>(
          "[data-report-priority]",
        );

      const typeSelect =
        page.querySelector<HTMLSelectElement>(
          "[data-report-type]",
        );

      const resetButton =
        page.querySelector<HTMLButtonElement>(
          "[data-report-reset]",
        );

      const resetEmptyButton =
        page.querySelector<HTMLButtonElement>(
          "[data-report-reset-empty]",
        );

      const filterSection =
        page.querySelector<HTMLElement>(
          "[data-report-filters]",
        );

      const noResults =
        page.querySelector<HTMLElement>(
          "[data-report-no-results]",
        );

      const resultCount =
        page.querySelector<HTMLElement>(
          "[data-report-result-count]",
        );

      const reportCards =
        Array.from(
          page.querySelectorAll<HTMLElement>(
            "[data-report-card]",
          ),
        );

      const normalize =
        (value: string) =>
          value
            .normalize("NFD")
            .replace(
              /[\u0300-\u036f]/g,
              "",
            )
            .toLowerCase()
            .replace(
              /\s+/g,
              " ",
            )
            .trim();

      const updateResetButton =
        () => {
          if (!resetButton) {
            return;
          }

          const hasSearch =
            Boolean(
              searchInput?.value.trim(),
            );

          const hasStatus =
            Boolean(
              statusSelect &&
                statusSelect.value !==
                  "all",
            );

          const hasPriority =
            Boolean(
              prioritySelect &&
                prioritySelect.value !==
                  "all",
            );

          const hasType =
            Boolean(
              typeSelect &&
                typeSelect.value !==
                  "all",
            );

          resetButton.hidden =
            !(
              hasSearch ||
              hasStatus ||
              hasPriority ||
              hasType
            );
        };

      const applyFilters =
        () => {
          const search =
            normalize(
              searchInput?.value ??
                "",
            );

          const status =
            statusSelect?.value ??
            "all";

          const priority =
            prioritySelect?.value ??
            "all";

          const type =
            typeSelect?.value ??
            "all";

          let visibleCount =
            0;

          reportCards.forEach(
            (
              card,
            ) => {
              const cardStatus =
                card.dataset
                  .reportStatus ??
                "";

              const cardPriority =
                card.dataset
                  .reportPriority ??
                "";

              const cardType =
                card.dataset
                  .reportType ??
                "";

              const cardSearch =
                normalize(
                  card.dataset
                    .reportSearch ??
                    "",
                );

              const matchesSearch =
                !search ||
                cardSearch.includes(
                  search,
                );

              const matchesStatus =
                status === "all" ||
                cardStatus ===
                  status;

              const matchesPriority =
                priority ===
                  "all" ||
                cardPriority ===
                  priority;

              const matchesType =
                type === "all" ||
                cardType === type;

              const visible =
                matchesSearch &&
                matchesStatus &&
                matchesPriority &&
                matchesType;

              card.hidden =
                !visible;

              if (
                visible
              ) {
                visibleCount += 1;
              }
            },
          );

          if (
            resultCount
          ) {
            resultCount.textContent =
              String(
                visibleCount,
              );
          }

          const filtering =
            Boolean(
              search ||
                status !== "all" ||
                priority !== "all" ||
                type !== "all",
            );

          if (
            noResults
          ) {
            noResults.hidden =
              !(
                filtering &&
                visibleCount ===
                  0
              );
          }

          if (
            filterSection
          ) {
            filterSection.toggleAttribute(
              "data-filtering",
              filtering,
            );
          }

          updateResetButton();
        };

      const resetFilters =
        () => {
          if (
            searchInput
          ) {
            searchInput.value =
              "";
          }

          if (
            statusSelect
          ) {
            statusSelect.value =
              "all";
          }

          if (
            prioritySelect
          ) {
            prioritySelect.value =
              "all";
          }

          if (
            typeSelect
          ) {
            typeSelect.value =
              "all";
          }

          applyFilters();
        };

      searchInput?.addEventListener(
        "input",
        applyFilters,
      );

      statusSelect?.addEventListener(
        "change",
        applyFilters,
      );

      prioritySelect?.addEventListener(
        "change",
        applyFilters,
      );

      typeSelect?.addEventListener(
        "change",
        applyFilters,
      );

      resetButton?.addEventListener(
        "click",
        resetFilters,
      );

      resetEmptyButton?.addEventListener(
        "click",
        resetFilters,
      );

      applyFilters();
    };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeReportsPage,
      {
        once: true,
      },
    );
  } else {
    initializeReportsPage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeReportsPage,
  );
</script>