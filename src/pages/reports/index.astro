---
import {
  ArrowRight,
  CircleCheck,
  Clock3,
  FileText,
  ListFilter,
  MapPin,
  Plus,
  Search,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import PublicLayout from "../../layouts/PublicLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import { getReports } from "../../lib/data/reports";

const reports = getReports();

type ReportItem =
  ReturnType<typeof getReports> extends readonly (infer T)[]
    ? T
    : never;

const statusLabels: Record<ReportItem["status"], string> = {
  pending: "Menunggu verifikasi",
  verified: "Terverifikasi",
  "in-progress": "Sedang ditangani",
  resolved: "Selesai",
  rejected: "Ditolak",
};

const priorityLabels: Record<ReportItem["priority"], string> = {
  low: "Rendah",
  medium: "Sedang",
  high: "Tinggi",
};

const typeLabels: Record<ReportItem["type"], string> = {
  "illegal-dumping": "Pembuangan ilegal",
  "overflowing-waste": "Sampah meluber",
  "burning-waste": "Pembakaran sampah",
  "hazardous-waste": "Sampah berbahaya",
  "environmental-pollution": "Pencemaran lingkungan",
  other: "Lainnya",
};

const reportStatusOrder: ReportItem["status"][] = [
  "pending",
  "verified",
  "in-progress",
  "resolved",
  "rejected",
];

const statusCounts = reportStatusOrder.reduce(
  (accumulator, status) => {
    accumulator[status] = reports.filter(
      (report) => report.status === status,
    ).length;

    return accumulator;
  },
  {} as Record<ReportItem["status"], number>,
);

const activeCount =
  statusCounts.pending +
  statusCounts.verified +
  statusCounts["in-progress"];

const resolvedCount = statusCounts.resolved;

const highPriorityCount = reports.filter(
  (report) => report.priority === "high",
).length;

function getDateValue(value: unknown): Date | null {
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? null : value;
  }

  if (typeof value === "string" || typeof value === "number") {
    const date = new Date(value);

    return Number.isNaN(date.getTime()) ? null : date;
  }

  if (
    typeof value === "object" &&
    value !== null &&
    "toDate" in value &&
    typeof value.toDate === "function"
  ) {
    const date = value.toDate();

    return date instanceof Date && !Number.isNaN(date.getTime())
      ? date
      : null;
  }

  return null;
}

function formatDate(value: unknown): string {
  const date = getDateValue(value);

  if (!date) {
    return "Tanggal tidak tersedia";
  }

  return new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
}

function getReportTimestamp(report: ReportItem): unknown {
  return report.createdAt;
}

function getStatusClass(status: ReportItem["status"]): string {
  switch (status) {
    case "pending":
      return "status-badge status-badge--pending";

    case "verified":
      return "status-badge status-badge--verified";

    case "in-progress":
      return "status-badge status-badge--progress";

    case "resolved":
      return "status-badge status-badge--resolved";

    case "rejected":
      return "status-badge status-badge--rejected";

    default:
      return "status-badge";
  }
}

function getPriorityClass(priority: ReportItem["priority"]): string {
  switch (priority) {
    case "high":
      return "priority-badge priority-badge--high";

    case "medium":
      return "priority-badge priority-badge--medium";

    case "low":
      return "priority-badge priority-badge--low";

    default:
      return "priority-badge";
  }
}

function getReportTypeIcon(type: ReportItem["type"]): string {
  switch (type) {
    case "illegal-dumping":
      return "warning";

    case "overflowing-waste":
      return "warning";

    case "burning-waste":
      return "warning";

    case "hazardous-waste":
      return "hazardous";

    case "environmental-pollution":
      return "environmental";

    case "other":
    default:
      return "other";
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Laporan Masyarakat — BINSIGHT",
  description:
    "Kumpulan laporan masyarakat terkait kondisi persampahan dan lingkungan di Kabupaten Badung.",
  url: "https://binsight.id/reports",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<PublicLayout
  title="Laporan Masyarakat"
  description="Laporan masyarakat terkait persampahan dan kondisi lingkungan di Kabupaten Badung."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="reports-page">
    <PageHeader
      eyebrow="LAPORAN MASYARAKAT"
      title="Pantau kondisi persampahan dari laporan lapangan"
      description="BINSIGHT menghubungkan laporan masyarakat dengan data, lokasi, dan proses tindak lanjut agar kondisi persampahan di Badung dapat dipantau secara lebih terbuka."
      icon="report"
      tone="green"
      breadcrumbs={[
        {
          label: "Beranda",
          href: "/",
        },
        {
          label: "Laporan Masyarakat",
          href: "/reports",
        },
      ]}
    />

    <section class="reports-page__intro">
      <div class="reports-page__container">
        <div class="reports-page__intro-card">
          <div class="reports-page__intro-content">
            <div class="reports-page__eyebrow">
              <ShieldCheck
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
              <span>DATA LAPANGAN</span>
            </div>

            <h2 class="reports-page__intro-title">
              Suara masyarakat menjadi data lapangan.
            </h2>

            <p class="reports-page__intro-description">
              Temukan laporan yang masuk, lihat status penanganannya, dan
              bantu memperkaya pemahaman bersama tentang kondisi persampahan
              di Kabupaten Badung.
            </p>
          </div>

          <a
            class="reports-page__create-button"
            href="/reports/create"
          >
            <Plus
              size={18}
              stroke-width={2.2}
              aria-hidden="true"
            />
            <span>Buat Laporan</span>
            <ArrowRight
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>

    <section
      class="reports-page__stats"
      aria-label="Ringkasan laporan"
    >
      <div class="reports-page__container">
        <div class="reports-stat-grid">
          <article class="reports-stat-card">
            <div
              class="reports-stat-card__icon reports-stat-card__icon--all"
            >
              <FileText
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="reports-stat-card__content">
              <span class="reports-stat-card__label">
                Total laporan
              </span>

              <strong class="reports-stat-card__value">
                {reports.length}
              </strong>

              <span class="reports-stat-card__meta">
                Seluruh laporan yang tercatat
              </span>
            </div>
          </article>

          <article class="reports-stat-card">
            <div
              class="reports-stat-card__icon reports-stat-card__icon--active"
            >
              <Clock3
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="reports-stat-card__content">
              <span class="reports-stat-card__label">
                Aktif
              </span>

              <strong class="reports-stat-card__value">
                {activeCount}
              </strong>

              <span class="reports-stat-card__meta">
                Masih dalam proses
              </span>
            </div>
          </article>

          <article class="reports-stat-card">
            <div
              class="reports-stat-card__icon reports-stat-card__icon--resolved"
            >
              <CircleCheck
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="reports-stat-card__content">
              <span class="reports-stat-card__label">
                Selesai
              </span>

              <strong class="reports-stat-card__value">
                {resolvedCount}
              </strong>

              <span class="reports-stat-card__meta">
                Laporan terselesaikan
              </span>
            </div>
          </article>

          <article class="reports-stat-card">
            <div
              class="reports-stat-card__icon reports-stat-card__icon--priority"
            >
              <TriangleAlert
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="reports-stat-card__content">
              <span class="reports-stat-card__label">
                Prioritas tinggi
              </span>

              <strong class="reports-stat-card__value">
                {highPriorityCount}
              </strong>

              <span class="reports-stat-card__meta">
                Perlu perhatian lebih
              </span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="reports-page__content">
      <div class="reports-page__container">
        <div
          class="reports-toolbar"
          data-report-filters
        >
          <div class="reports-toolbar__heading">
            <div class="reports-toolbar__heading-icon">
              <ListFilter
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div>
              <h2 class="reports-toolbar__title">
                Laporan masyarakat
              </h2>

              <p class="reports-toolbar__description">
                Gunakan filter untuk menemukan laporan yang relevan.
              </p>
            </div>
          </div>

          <div class="reports-toolbar__controls">
            <label class="reports-filter">
              <span class="reports-filter__label">
                <span class="sr-only">Cari laporan</span>
              </span>

              <span class="reports-filter__field">
                <Search
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />

                <input
                  type="search"
                  class="reports-filter__input"
                  placeholder="Cari laporan..."
                  autocomplete="off"
                  data-report-search
                />
              </span>
            </label>

            <label class="reports-filter">
              <span class="reports-filter__label">
                Status
              </span>

              <select
                class="reports-filter__select"
                data-report-status
              >
                <option value="all">
                  Semua status
                </option>

                {
                  reportStatusOrder.map((status) => (
                    <option value={status}>
                      {statusLabels[status]}
                    </option>
                  ))
                }
              </select>
            </label>

            <label class="reports-filter">
              <span class="reports-filter__label">
                Prioritas
              </span>

              <select
                class="reports-filter__select"
                data-report-priority
              >
                <option value="all">
                  Semua prioritas
                </option>

                <option value="high">Tinggi</option>
                <option value="medium">Sedang</option>
                <option value="low">Rendah</option>
              </select>
            </label>

            <label class="reports-filter">
              <span class="reports-filter__label">
                Jenis
              </span>

              <select
                class="reports-filter__select"
                data-report-type
              >
                <option value="all">
                  Semua jenis
                </option>

                <option value="illegal-dumping">
                  Pembuangan ilegal
                </option>

                <option value="overflowing-waste">
                  Sampah meluber
                </option>

                <option value="burning-waste">
                  Pembakaran sampah
                </option>

                <option value="hazardous-waste">
                  Sampah berbahaya
                </option>

                <option value="environmental-pollution">
                  Pencemaran lingkungan
                </option>

                <option value="other">
                  Lainnya
                </option>
              </select>
            </label>
          </div>
        </div>

        <div
          class="reports-list"
          data-report-list
          aria-live="polite"
        >
          {
            reports.length > 0 ? (
              reports.map((report) => {
                const dateValue = getDateValue(
                  getReportTimestamp(report),
                );

                const dateIso = dateValue
                  ? dateValue.toISOString()
                  : undefined;

                const statusLabel =
                  statusLabels[report.status];

                const priorityLabel =
                  priorityLabels[report.priority];

                const typeLabel =
                  typeLabels[report.type];

                const typeIcon =
                  getReportTypeIcon(report.type);

                const searchableText = [
                  report.title,
                  report.description,
                  report.location.address,
                  report.location.areaName,
                  typeLabel,
                  statusLabel,
                  priorityLabel,
                ]
                  .filter(Boolean)
                  .join(" ")
                  .toLowerCase();

                return (
                  <article
                    class="report-list-card"
                    data-report-card
                    data-report-status-value={report.status}
                    data-report-priority-value={
                      report.priority
                    }
                    data-report-type-value={report.type}
                    data-report-search-value={
                      searchableText
                    }
                  >
                    <div class="report-list-card__main">
                      <div class="report-list-card__top">
                        <div
                          class:list={[
                            "report-list-card__type-icon",
                            `report-list-card__type-icon--${typeIcon}`,
                          ]}
                        >
                          {typeIcon === "hazardous" ? (
                            <TriangleAlert
                              size={19}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          ) : typeIcon === "warning" ? (
                            <TriangleAlert
                              size={19}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          ) : typeIcon === "environmental" ? (
                            <MapPin
                              size={19}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          ) : (
                            <FileText
                              size={19}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          )}
                        </div>

                        <div class="report-list-card__badges">
                          <span
                            class={getStatusClass(
                              report.status,
                            )}
                          >
                            {statusLabel}
                          </span>

                          <span
                            class={getPriorityClass(
                              report.priority,
                            )}
                          >
                            {priorityLabel}
                          </span>
                        </div>
                      </div>

                      <a
                        class="report-list-card__title"
                        href={`/reports/${report.id}`}
                      >
                        {report.title}
                      </a>

                      <p class="report-list-card__description">
                        {report.description}
                      </p>

                      <div class="report-list-card__meta">
                        <span class="report-list-card__meta-item">
                          <MapPin
                            size={15}
                            stroke-width={2}
                            aria-hidden="true"
                          />

                          <span>
                            {report.location.areaName}
                          </span>
                        </span>

                        <span
                          class="report-list-card__meta-item"
                          title={dateIso}
                        >
                          <Clock3
                            size={15}
                            stroke-width={2}
                            aria-hidden="true"
                          />

                          <time datetime={dateIso}>
                            {formatDate(
                              getReportTimestamp(
                                report,
                              ),
                            )}
                          </time>
                        </span>

                        <span class="report-list-card__meta-item">
                          <FileText
                            size={15}
                            stroke-width={2}
                            aria-hidden="true"
                          />

                          <span>
                            {typeLabel}
                          </span>
                        </span>
                      </div>
                    </div>

                    <div class="report-list-card__action">
                      <a
                        class="report-list-card__link"
                        href={`/reports/${report.id}`}
                        aria-label={`Lihat detail laporan ${report.title}`}
                      >
                        <span>Lihat detail</span>

                        <ArrowRight
                          size={17}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </a>
                    </div>
                  </article>
                );
              })
            ) : (
              <div class="reports-empty">
                <div class="reports-empty__icon">
                  <FileText
                    size={28}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>

                <h3 class="reports-empty__title">
                  Belum ada laporan
                </h3>

                <p class="reports-empty__description">
                  Belum ada laporan masyarakat yang tersedia.
                  Anda dapat menjadi bagian pertama dengan
                  mengirimkan laporan.
                </p>

                <a
                  class="reports-empty__button"
                  href="/reports/create"
                >
                  <Plus
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Buat laporan
                  </span>
                </a>
              </div>
            )
          }
        </div>

        <div
          class="reports-filter-empty"
          data-report-filter-empty
          hidden
        >
          <div class="reports-filter-empty__icon">
            <Search
              size={25}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </div>

          <h3 class="reports-filter-empty__title">
            Laporan tidak ditemukan
          </h3>

          <p class="reports-filter-empty__description">
            Tidak ada laporan yang sesuai dengan filter
            yang dipilih. Coba ubah kata kunci atau filter
            Anda.
          </p>

          <button
            type="button"
            class="reports-filter-empty__button"
            data-report-reset
          >
            Reset filter
          </button>
        </div>
      </div>
    </section>

    <section class="reports-page__guidance">
      <div class="reports-page__container">
        <div class="reports-guidance-card">
          <div class="reports-guidance-card__icon">
            <ShieldCheck
              size={22}
              stroke-width={2}
              aria-hidden="true"
            />
          </div>

          <div class="reports-guidance-card__content">
            <h2 class="reports-guidance-card__title">
              Laporkan kondisi yang Anda temukan
            </h2>

            <p class="reports-guidance-card__description">
              Sampaikan lokasi dan kondisi persampahan
              dengan informasi yang jelas agar laporan
              dapat diverifikasi dan ditindaklanjuti.
            </p>
          </div>

          <a
            class="reports-guidance-card__link"
            href="/reports/create"
          >
            <span>Buat laporan</span>

            <ArrowRight
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  .reports-page {
    --reports-container: min(
      1180px,
      calc(100% - 40px)
    );

    min-height: 100vh;
    background: var(--color-background);
  }

  .reports-page__container {
    width: var(--reports-container);
    margin-inline: auto;
  }

  .reports-page__intro {
    padding: var(--space-8) 0 var(--space-5);
  }

  .reports-page__intro-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(
        135deg,
        var(--color-primary-soft),
        var(--color-surface)
      );
    box-shadow: var(--shadow-sm);
  }

  .reports-page__intro-content {
    min-width: 0;
    flex: 1;
  }

  .reports-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-primary-dark);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .reports-page__intro-title {
    margin: 0 0 var(--space-3);
    max-width: 760px;
    color: var(--color-text-strong);
    font-size: clamp(
      1.45rem,
      3vw,
      2rem
    );
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  .reports-page__intro-description {
    max-width: 760px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    line-height: 1.75;
  }

  .reports-page__create-button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-2);
    min-height: 46px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--font-size-sm);
    font-weight: 750;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .reports-page__create-button:hover {
    transform: translateY(-1px);
    background: var(--color-primary-dark);
    box-shadow: var(--shadow-md);
  }

  .reports-page__create-button:focus-visible,
  .report-list-card__link:focus-visible,
  .report-list-card__title:focus-visible,
  .reports-guidance-card__link:focus-visible,
  .reports-empty__button:focus-visible {
    outline: 3px solid var(--color-primary-ring);
    outline-offset: 3px;
  }

  .reports-page__stats {
    padding: var(--space-3) 0 var(--space-6);
  }

  .reports-stat-grid {
    display: grid;
    grid-template-columns: repeat(
      4,
      minmax(0, 1fr)
    );
    gap: var(--space-4);
  }

  .reports-stat-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  .reports-stat-card__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
  }

  .reports-stat-card__icon--all {
    background: var(--color-info-soft);
    color: var(--color-info);
  }

  .reports-stat-card__icon--active {
    background: var(--color-warning-soft);
    color: var(--color-warning-text);
  }

  .reports-stat-card__icon--resolved {
    background: var(--color-success-soft);
    color: var(--color-success-text);
  }

  .reports-stat-card__icon--priority {
    background: var(--color-danger-soft);
    color: var(--color-danger-text);
  }

  .reports-stat-card__content {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .reports-stat-card__label {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.3;
  }

  .reports-stat-card__value {
    margin-top: 4px;
    color: var(--color-text-strong);
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .reports-stat-card__meta {
    margin-top: var(--space-2);
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
    line-height: 1.4;
  }

  .reports-page__content {
    padding: var(--space-2) 0 var(--space-10);
  }

  .reports-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-5);
