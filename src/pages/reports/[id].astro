---
import {
  ArrowLeft,
  CalendarDays,
  CheckCircle,
  Clock3,
  ExternalLink,
  FileText,
  MapPin,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import PublicLayout from "../../layouts/PublicLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import { getReports } from "../../lib/data/reports";

const reports = getReports();

export function getStaticPaths() {
  return reports.map((report) => ({
    params: {
      id: report.id,
    },
    props: {
      report,
    },
  }));
}

type ReportItem =
  ReturnType<typeof getReports> extends readonly (infer T)[]
    ? T
    : never;

interface Props {
  report: ReportItem;
}

const { report } = Astro.props;

const statusLabels: Record<ReportItem["status"], string> = {
  pending: "Menunggu verifikasi",
  verified: "Terverifikasi",
  "in-progress": "Sedang ditangani",
  resolved: "Selesai",
  rejected: "Ditolak",
};

const priorityLabels: Record<
  ReportItem["priority"],
  string
> = {
  low: "Rendah",
  medium: "Sedang",
  high: "Tinggi",
};

const typeLabels: Record<ReportItem["type"], string> = {
  "illegal-dumping": "Pembuangan ilegal",
  "overflowing-waste": "Sampah meluber",
  "burning-waste": "Pembakaran sampah",
  "hazardous-waste": "Sampah berbahaya",
  "environmental-pollution": "Pencemaran lingkungan",
  other: "Lainnya",
};

const categoryLabels: Record<string, string> = {
  organic: "Organik",
  inorganic: "Anorganik",
  hazardous: "Berbahaya",
  electronic: "Elektronik",
  residual: "Residu",
  mixed: "Campuran / tidak diketahui",
};

function getDateValue(value: unknown): Date | null {
  if (value instanceof Date) {
    return Number.isNaN(value.getTime())
      ? null
      : value;
  }

  if (
    typeof value === "string" ||
    typeof value === "number"
  ) {
    const date = new Date(value);

    return Number.isNaN(date.getTime())
      ? null
      : date;
  }

  if (
    typeof value === "object" &&
    value !== null &&
    "toDate" in value &&
    typeof value.toDate === "function"
  ) {
    const date = value.toDate();

    return date instanceof Date &&
      !Number.isNaN(date.getTime())
      ? date
      : null;
  }

  return null;
}

function formatDate(
  value: unknown,
  withTime = false,
): string {
  const date = getDateValue(value);

  if (!date) {
    return "Tanggal tidak tersedia";
  }

  return new Intl.DateTimeFormat(
    "id-ID",
    withTime
      ? {
          day: "numeric",
          month: "long",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        }
      : {
          day: "numeric",
          month: "long",
          year: "numeric",
        },
  ).format(date);
}

function getIsoDate(
  value: unknown,
): string | undefined {
  const date = getDateValue(value);

  return date
    ? date.toISOString()
    : undefined;
}

function getStatusClass(
  status: ReportItem["status"],
): string {
  switch (status) {
    case "pending":
      return "status-badge status-badge--pending";

    case "verified":
      return "status-badge status-badge--verified";

    case "in-progress":
      return "status-badge status-badge--progress";

    case "resolved":
      return "status-badge status-badge--resolved";

    case "rejected":
      return "status-badge status-badge--rejected";

    default:
      return "status-badge";
  }
}

function getPriorityClass(
  priority: ReportItem["priority"],
): string {
  switch (priority) {
    case "high":
      return "priority-badge priority-badge--high";

    case "medium":
      return "priority-badge priority-badge--medium";

    case "low":
      return "priority-badge priority-badge--low";

    default:
      return "priority-badge";
  }
}

function getTypeIcon(
  type: ReportItem["type"],
): string {
  switch (type) {
    case "hazardous-waste":
      return "hazardous";

    case "environmental-pollution":
      return "environmental";

    case "illegal-dumping":
    case "overflowing-waste":
    case "burning-waste":
      return "warning";

    case "other":
    default:
      return "default";
  }
}

const typeIcon = getTypeIcon(report.type);

const imageItems = [
  ...(report.image
    ? [report.image]
    : []),
  ...(Array.isArray(report.images)
    ? report.images
    : []),
].filter(
  (value, index, array) =>
    typeof value === "string" &&
    value.length > 0 &&
    array.indexOf(value) === index,
);

const primaryImage =
  imageItems[0] ?? null;

const reportStatusIndex = [
  "pending",
  "verified",
  "in-progress",
  "resolved",
].indexOf(report.status);

const statusSteps = [
  {
    key: "pending",
    label: "Laporan diterima",
    description:
      "Laporan tercatat dan menunggu proses pemeriksaan.",
  },
  {
    key: "verified",
    label: "Terverifikasi",
    description:
      "Informasi laporan telah melalui tahap verifikasi.",
  },
  {
    key: "in-progress",
    label: "Sedang ditangani",
    description:
      "Laporan berada dalam proses tindak lanjut.",
  },
  {
    key: "resolved",
    label: "Selesai",
    description:
      "Laporan telah ditandai selesai.",
  },
] as const;

const statusStepState = (
  stepIndex: number,
): string => {
  if (report.status === "rejected") {
    return stepIndex === 0
      ? "status-step status-step--complete"
      : "status-step";
  }

  if (stepIndex < reportStatusIndex) {
    return "status-step status-step--complete";
  }

  if (stepIndex === reportStatusIndex) {
    return "status-step status-step--current";
  }

  return "status-step";
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Report",
  name: report.title,
  description: report.description,
  url: `https://binsight.id/reports/${report.id}`,
  dateCreated: getIsoDate(report.createdAt),
  dateModified: getIsoDate(report.updatedAt),
  spatialCoverage: {
    "@type": "Place",
    name: report.location.areaName,
    address: report.location.address,
  },
};
---

<PublicLayout
  title={`${report.title} — Laporan Masyarakat`}
  description={report.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="report-detail-page">
    <PageHeader
      eyebrow="DETAIL LAPORAN"
      title={report.title}
      description="Informasi laporan masyarakat, lokasi, status penanganan, dan catatan tindak lanjut."
      icon="report"
      tone="green"
      breadcrumbs={[
        {
          label: "Beranda",
          href: "/",
        },
        {
          label: "Laporan Masyarakat",
          href: "/reports",
        },
        {
          label: report.title,
          href: `/reports/${report.id}`,
        },
      ]}
    />

    <section class="report-detail-page__content">
      <div class="report-detail-page__container">
        <div class="report-detail-grid">
          <div class="report-detail-main">
            <div class="report-hero-card">
              <div class="report-hero-card__header">
                <div
                  class:list={[
                    "report-type-icon",
                    `report-type-icon--${typeIcon}`,
                  ]}
                >
                  {
                    typeIcon === "hazardous" ? (
                      <TriangleAlert
                        size={24}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    ) : typeIcon === "environmental" ? (
                      <MapPin
                        size={24}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    ) : typeIcon === "warning" ? (
                      <TriangleAlert
                        size={24}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    ) : (
                      <FileText
                        size={24}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    )
                  }
                </div>

                <div class="report-hero-card__badges">
                  <span class={getStatusClass(report.status)}>
                    {statusLabels[report.status]}
                  </span>

                  <span
                    class={getPriorityClass(report.priority)}
                  >
                    Prioritas {priorityLabels[report.priority]}
                  </span>
                </div>
              </div>

              <div class="report-hero-card__type">
                {typeLabels[report.type]}
              </div>

              <h1 class="report-hero-card__title">
                {report.title}
              </h1>

              <p class="report-hero-card__description">
                {report.description}
              </p>

              <div class="report-hero-card__meta">
                <span class="report-meta-item">
                  <MapPin
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    {report.location.areaName}
                  </span>
                </span>

                <span class="report-meta-item">
                  <CalendarDays
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <time
                    datetime={getIsoDate(report.createdAt)}
                  >
                    {formatDate(report.createdAt)}
                  </time>
                </span>

                {
                  report.reporterName ? (
                    <span class="report-meta-item">
                      <ShieldCheck
                        size={16}
                        stroke-width={2}
                        aria-hidden="true"
                      />

                      <span>
                        Dilaporkan oleh {report.reporterName}
                      </span>
                    </span>
                  ) : null
                }
              </div>
            </div>

            <section class="detail-card">
              <div class="detail-card__header">
                <div class="detail-card__header-icon">
                  <FileText
                    size={19}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

                <div>
                  <h2 class="detail-card__title">
                    Informasi laporan
                  </h2>

                  <p class="detail-card__subtitle">
                    Ringkasan informasi yang diberikan saat laporan dibuat.
                  </p>
                </div>
              </div>

              <div class="detail-facts">
                <div class="detail-fact">
                  <span class="detail-fact__label">
                    Jenis laporan
                  </span>

                  <strong class="detail-fact__value">
                    {typeLabels[report.type]}
                  </strong>
                </div>

                <div class="detail-fact">
                  <span class="detail-fact__label">
                    Kategori sampah
                  </span>

                  <strong class="detail-fact__value">
                    {
                      report.category
                        ? categoryLabels[report.category] ??
                          report.category
                        : "Tidak ditentukan"
                    }
                  </strong>
                </div>

                <div class="detail-fact">
                  <span class="detail-fact__label">
                    Prioritas
                  </span>

                  <strong class="detail-fact__value">
                    {priorityLabels[report.priority]}
                  </strong>
                </div>

                <div class="detail-fact">
                  <span class="detail-fact__label">
                    Status
                  </span>

                  <strong class="detail-fact__value">
                    {statusLabels[report.status]}
                  </strong>
                </div>

                <div class="detail-fact detail-fact--full">
                  <span class="detail-fact__label">
                    Waktu laporan
                  </span>

                  <strong class="detail-fact__value">
                    {formatDate(
                      report.createdAt,
                      true,
                    )}
                  </strong>
                </div>
              </div>
            </section>

            <section class="detail-card">
              <div class="detail-card__header">
                <div class="detail-card__header-icon detail-card__header-icon--location">
                  <MapPin
                    size={19}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

                <div>
                  <h2 class="detail-card__title">
                    Lokasi kejadian
                  </h2>

                  <p class="detail-card__subtitle">
                    Lokasi sebagaimana dicatat pada laporan.
                  </p>
                </div>
              </div>

              <div class="location-panel">
                <div class="location-panel__row">
                  <MapPin
                    size={18}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <div>
                    <span class="location-panel__label">
                      Area
                    </span>

                    <strong class="location-panel__value">
                      {report.location.areaName}
                    </strong>
                  </div>
                </div>

                <div class="location-panel__row">
                  <FileText
                    size={18}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <div>
                    <span class="location-panel__label">
                      Alamat / lokasi
                    </span>

                    <strong class="location-panel__value">
                      {report.location.address}
                    </strong>
                  </div>
                </div>

                {
                  report.location.coordinates ? (
                    <div class="location-panel__coordinates">
                      <div>
                        <span class="location-panel__label">
                          Latitude
                        </span>

                        <strong>
                          {report.location.coordinates.lat}
                        </strong>
                      </div>

                      <div>
                        <span class="location-panel__label">
                          Longitude
                        </span>

                        <strong>
                          {report.location.coordinates.lng}
                        </strong>
                      </div>
                    </div>
                  ) : null
                }
              </div>

              {
                report.location.coordinates ? (
                  <a
                    class="location-map-link"
                    href={`https://www.google.com/maps/search/?api=1&query=${report.location.coordinates.lat},${report.location.coordinates.lng}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <MapPin
                      size={16}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>
                      Buka koordinat di peta
                    </span>

                    <ExternalLink
                      size={15}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </a>
                ) : null
              }
            </section>

            {
              imageItems.length > 0 ? (
                <section class="detail-card">
                  <div class="detail-card__header">
                    <div class="detail-card__header-icon">
                      <FileText
                        size={19}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>

                    <div>
                      <h2 class="detail-card__title">
                        Bukti visual
                      </h2>

                      <p class="detail-card__subtitle">
                        Foto yang dilampirkan bersama laporan.
                      </p>
                    </div>
                  </div>

                  <div class="report-gallery">
                    {imageItems.map((image, index) => (
                      <a
                        class:list={[
                          "report-gallery__item",
                          {
                            "report-gallery__item--primary":
                              index === 0,
                          },
                        ]}
                        href={image}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <img
                          src={image}
                          alt={`Bukti laporan ${report.title}, foto ${index + 1}`}
                          loading={
                            index === 0
                              ? "eager"
                              : "lazy"
                          }
                          decoding="async"
                        />

                        <span class="report-gallery__overlay">
                          <ExternalLink
                            size={17}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        </span>
                      </a>
                    ))}
                  </div>
                </section>
              ) : null
            }

            {
              report.notes ? (
                <section class="detail-card">
                  <div class="detail-card__header">
                    <div class="detail-card__header-icon detail-card__header-icon--note">
                      <FileText
                        size={19}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>

                    <div>
                      <h2 class="detail-card__title">
                        Catatan tambahan
                      </h2>
                    </div>
                  </div>

                  <p class="detail-note">
                    {report.notes}
                  </p>
                </section>
              ) : null
            }

            {
              report.resolution ? (
                <section class="detail-card detail-card--resolution">
                  <div class="detail-card__header">
                    <div class="detail-card__header-icon detail-card__header-icon--success">
                      <CheckCircle
                        size={19}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>

                    <div>
                      <h2 class="detail-card__title">
                        Penyelesaian
                      </h2>

                      <p class="detail-card__subtitle">
                        Catatan penyelesaian laporan.
                      </p>
                    </div>
                  </div>

                  <p class="detail-note">
                    {report.resolution}
                  </p>
                </section>
              ) : null
            }
          </div>

          <aside class="report-detail-sidebar">
            <section class="sidebar-status-card">
              <div class="sidebar-status-card__header">
                <div>
                  <span class="sidebar-status-card__eyebrow">
                    STATUS LAPORAN
                  </span>

                  <h2 class="sidebar-status-card__title">
                    {statusLabels[report.status]}
                  </h2>
                </div>

                {
                  report.status === "resolved" ? (
                    <div class="sidebar-status-card__success">
                      <CheckCircle
                        size={20}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>
                  ) : report.status ===
                    "rejected" ? (
                    <div class="sidebar-status-card__danger">
                      <TriangleAlert
                        size={20}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>
                  ) : (
                    <div class="sidebar-status-card__clock">
                      <Clock3
                        size={20}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>
                  )
                }
              </div>

              <div class="status-timeline">
                {
                  statusSteps.map(
                    (
                      step,
                      index,
                    ) => (
                      <div
                        class={statusStepState(
                          index,
                        )}
                      >
                        <div class="status-step__marker">
                          {index <
                          reportStatusIndex ? (
                            <CheckCircle
                              size={15}
                              stroke-width={2.2}
                              aria-hidden="true"
                            />
                          ) : index ===
                            reportStatusIndex ? (
                            <span />
                          ) : (
                            <span />
                          )}
                        </div>

                        <div class="status-step__body">
                          <strong>
                            {step.label}
                          </strong>

                          <p>
                            {step.description}
                          </p>
                        </div>
                      </div>
                    ),
                  )
                }

                {
                  report.status === "rejected" ? (
                    <div class="status-rejected-note">
                      <TriangleAlert
                        size={16}
                        stroke-width={2}
                        aria-hidden="true"
                      />

                      <span>
                        Laporan ini ditandai ditolak dan
                        tidak dilanjutkan ke tahap penanganan.
                      </span>
                    </div>
                  ) : null
                }
              </div>

              {
                report.verifiedAt ? (
                  <div class="sidebar-status-card__date">
                    <span>
                      Diverifikasi
                    </span>

                    <strong>
                      {formatDate(
                        report.verifiedAt,
                        true,
                      )}
                    </strong>
                  </div>
                ) : null
              }

              {
                report.resolvedAt ? (
                  <div class="sidebar-status-card__date">
                    <span>
                      Diselesaikan
                    </span>

                    <strong>
                      {formatDate(
                        report.resolvedAt,
                        true,
                      )}
                    </strong>
                  </div>
                ) : null
              }
            </section>

            <section class="sidebar-info-card">
              <div class="sidebar-info-card__icon">
                <MapPin
                  size={19}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <span class="sidebar-info-card__label">
                  AREA
                </span>

                <strong class="sidebar-info-card__value">
                  {report.location.areaName}
                </strong>
              </div>
            </section>

            <section class="sidebar-info-card">
              <div class="sidebar-info-card__icon sidebar-info-card__icon--type">
                <FileText
                  size={19}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <span class="sidebar-info-card__label">
                  JENIS
                </span>

                <strong class="sidebar-info-card__value">
                  {typeLabels[report.type]}
                </strong>
              </div>
            </section>

            <section class="sidebar-info-card">
              <div class="sidebar-info-card__icon sidebar-info-card__icon--priority">
                <TriangleAlert
                  size={19}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <span class="sidebar-info-card__label">
                  PRIORITAS
                </span>

                <strong class="sidebar-info-card__value">
                  {priorityLabels[report.priority]}
                </strong>
              </div>
            </section>

            <section class="sidebar-help-card">
              <ShieldCheck
                size={21}
                stroke-width={2}
                aria-hidden="true"
              />

              <div>
                <h2>
                  Ingin melaporkan kondisi lain?
                </h2>

                <p>
                  Bantu memperkaya data kondisi persampahan
                  di Kabupaten Badung.
                </p>

                <a href="/reports/create">
                  <span>
                    Buat laporan baru
                  </span>

                  <ArrowLeft
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>
              </div>
            </section>
          </aside>
        </div>

        <nav
          class="report-detail-footer-nav"
          aria-label="Navigasi laporan"
        >
          <a
            class="report-detail-footer-nav__back"
            href="/reports"
          >
            <ArrowLeft
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Kembali ke laporan masyarakat
            </span>
          </a>

          <a
            class="report-detail-footer-nav__create"
            href="/reports/create"
          >
            <span>
              Buat laporan
            </span>

            <ArrowLeft
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>
        </nav>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  .report-detail-page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .report-detail-page__content {
    padding: var(--space-10) 0 var(--space-14);
  }

  .report-detail-page__container {
    width: min(
      1180px,
      calc(100% - 40px)
    );
    margin-inline: auto;
  }

  .report-detail-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      320px;
    gap: var(--space-7);
    align-items: start;
  }

  .report-detail-main {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .report-hero-card,
  .detail-card,
  .sidebar-status-card,
  .sidebar-info-card,
  .sidebar-help-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  .report-hero-card {
    padding: var(--space-7);
  }

  .report-hero-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .report-type-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: var(--radius-lg);
  }

  .report-type-icon--warning {
    background: var(--color-warning-soft);
    color: var(--color-warning-text);
  }

  .report-type-icon--hazardous {
    background: var(--color-danger-soft);
    color: var(--color-danger-text);
  }

  .report-type-icon--environmental {
