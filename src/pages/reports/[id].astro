---
import {
  ArrowLeft,
  CalendarDays,
  CheckCircle,
  Clock3,
  ExternalLink,
  FileText,
  MapPin,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import PublicLayout from "../../layouts/PublicLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import { getReports } from "../../lib/data/reports";

/**
 * IMPORTANT:
 * Astro executes getStaticPaths() in its own scope.
 * Therefore getReports() must be called inside getStaticPaths().
 */
export function getStaticPaths() {
  const reports = getReports();

  return reports.map((report) => ({
    params: {
      id: report.id,
    },
    props: {
      report,
    },
  }));
}

type ReportItem =
  ReturnType<typeof getReports> extends readonly (infer T)[]
    ? T
    : never;

interface Props {
  report: ReportItem;
}

const { report } = Astro.props;

const statusLabels: Record<ReportItem["status"], string> = {
  pending: "Menunggu verifikasi",
  verified: "Terverifikasi",
  "in-progress": "Sedang ditangani",
  resolved: "Selesai",
  rejected: "Ditolak",
};

const priorityLabels: Record<ReportItem["priority"], string> = {
  low: "Rendah",
  medium: "Sedang",
  high: "Tinggi",
};

const typeLabels: Record<ReportItem["type"], string> = {
  "illegal-dumping": "Pembuangan ilegal",
  "overflowing-waste": "Sampah meluber",
  "burning-waste": "Pembakaran sampah",
  "hazardous-waste": "Sampah berbahaya",
  "environmental-pollution": "Pencemaran lingkungan",
  other: "Lainnya",
};

const categoryLabels: Record<string, string> = {
  organic: "Organik",
  inorganic: "Anorganik",
  hazardous: "Berbahaya",
  electronic: "Elektronik",
  residual: "Residu",
  mixed: "Campuran / tidak diketahui",
};

function getDateValue(value: unknown): Date | null {
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? null : value;
  }

  if (typeof value === "string" || typeof value === "number") {
    const date = new Date(value);

    return Number.isNaN(date.getTime()) ? null : date;
  }

  if (
    typeof value === "object" &&
    value !== null &&
    "toDate" in value &&
    typeof value.toDate === "function"
  ) {
    const date = value.toDate();

    return date instanceof Date && !Number.isNaN(date.getTime())
      ? date
      : null;
  }

  return null;
}

function formatDate(
  value: unknown,
  withTime = false,
): string {
  const date = getDateValue(value);

  if (!date) {
    return "Tanggal tidak tersedia";
  }

  return new Intl.DateTimeFormat(
    "id-ID",
    withTime
      ? {
          day: "numeric",
          month: "long",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        }
      : {
          day: "numeric",
          month: "long",
          year: "numeric",
        },
  ).format(date);
}

function getIsoDate(
  value: unknown,
): string | undefined {
  const date = getDateValue(value);

  return date ? date.toISOString() : undefined;
}

function getStatusClass(
  status: ReportItem["status"],
): string {
  switch (status) {
    case "pending":
      return "report-status report-status--pending";

    case "verified":
      return "report-status report-status--verified";

    case "in-progress":
      return "report-status report-status--progress";

    case "resolved":
      return "report-status report-status--resolved";

    case "rejected":
      return "report-status report-status--rejected";

    default:
      return "report-status";
  }
}

function getPriorityClass(
  priority: ReportItem["priority"],
): string {
  switch (priority) {
    case "high":
      return "report-priority report-priority--high";

    case "medium":
      return "report-priority report-priority--medium";

    case "low":
      return "report-priority report-priority--low";

    default:
      return "report-priority";
  }
}

function getTypeIcon(
  type: ReportItem["type"],
): string {
  switch (type) {
    case "hazardous-waste":
      return "hazardous";

    case "environmental-pollution":
      return "environmental";

    case "illegal-dumping":
    case "overflowing-waste":
    case "burning-waste":
      return "warning";

    case "other":
    default:
      return "default";
  }
}

const typeIcon = getTypeIcon(report.type);

const imageItems = [
  ...(report.image ? [report.image] : []),
  ...(Array.isArray(report.images) ? report.images : []),
].filter(
  (value, index, array) =>
    typeof value === "string" &&
    value.length > 0 &&
    array.indexOf(value) === index,
);

const reportStatusIndex = [
  "pending",
  "verified",
  "in-progress",
  "resolved",
].indexOf(report.status);

const statusSteps = [
  {
    key: "pending",
    label: "Laporan diterima",
    description:
      "Laporan tercatat dan menunggu proses pemeriksaan.",
  },
  {
    key: "verified",
    label: "Terverifikasi",
    description:
      "Informasi laporan telah melalui tahap verifikasi.",
  },
  {
    key: "in-progress",
    label: "Sedang ditangani",
    description:
      "Laporan berada dalam proses tindak lanjut.",
  },
  {
    key: "resolved",
    label: "Selesai",
    description:
      "Laporan telah ditandai selesai.",
  },
] as const;

function getStatusStepState(
  stepIndex: number,
): string {
  if (report.status === "rejected") {
    return stepIndex === 0
      ? "status-step status-step--complete"
      : "status-step";
  }

  if (stepIndex < reportStatusIndex) {
    return "status-step status-step--complete";
  }

  if (stepIndex === reportStatusIndex) {
    return "status-step status-step--current";
  }

  return "status-step";
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Report",
  name: report.title,
  description: report.description,
  url: `https://binsight.id/reports/${report.id}`,
  dateCreated: getIsoDate(report.createdAt),
  dateModified: getIsoDate(report.updatedAt),
  spatialCoverage: {
    "@type": "Place",
    name: report.location.areaName,
    address: report.location.address,
  },
};
---

<PublicLayout
  title={`${report.title} — Laporan Masyarakat`}
  description={report.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="report-detail-page">
    <div class="report-detail__topbar">
      <div class="report-detail__topbar-inner">
        <a
          class="report-detail__back-link"
          href="/reports"
        >
          <ArrowLeft
            size={16}
            stroke-width={2.2}
            aria-hidden="true"
          />
          <span>Kembali ke laporan</span>
        </a>

        <span class="report-detail__topbar-label">
          BINSIGHT / CIVIC INPUT
        </span>
      </div>
    </div>

    <PageHeader
      eyebrow="LAPORAN MASYARAKAT"
      title={report.title}
      description="Informasi laporan masyarakat, lokasi, status penanganan, dan catatan tindak lanjut."
      icon="report"
      tone="green"
      breadcrumbs={[
        {
          label: "Beranda",
          href: "/",
        },
        {
          label: "Laporan Masyarakat",
          href: "/reports",
        },
        {
          label: report.title,
          href: `/reports/${report.id}`,
        },
      ]}
    />

    <section class="report-detail-page__content">
      <div class="report-detail-page__container">

        <div class="report-detail-intro">
          <div class="report-detail-intro__index">
            <span>REPORT</span>
            <strong>{report.id}</strong>
          </div>

          <div class="report-detail-intro__rule"></div>

          <p class="report-detail-intro__text">
            Satu laporan. Satu lokasi. Satu konteks yang dapat
            membantu memahami kondisi persampahan di Badung.
          </p>
        </div>

        <div class="report-detail-grid">

          <!-- MAIN -->
          <div class="report-detail-main">

            <article class="report-hero-card">
              <div class="report-hero-card__accent">
                BINSIGHT
              </div>

              <div class="report-hero-card__header">
                <div
                  class:list={[
                    "report-type-icon",
                    `report-type-icon--${typeIcon}`,
                  ]}
                >
                  {
                    typeIcon === "hazardous" ? (
                      <TriangleAlert
                        size={25}
                        stroke-width={2.2}
                        aria-hidden="true"
                      />
                    ) : typeIcon === "environmental" ? (
                      <MapPin
                        size={25}
                        stroke-width={2.2}
                        aria-hidden="true"
                      />
                    ) : typeIcon === "warning" ? (
                      <TriangleAlert
                        size={25}
                        stroke-width={2.2}
                        aria-hidden="true"
                      />
                    ) : (
                      <FileText
                        size={25}
                        stroke-width={2.2}
                        aria-hidden="true"
                      />
                    )
                  }
                </div>

                <div class="report-hero-card__badges">
                  <span class={getStatusClass(report.status)}>
                    {statusLabels[report.status]}
                  </span>

                  <span class={getPriorityClass(report.priority)}>
                    PRIORITAS / {priorityLabels[report.priority]}
                  </span>
                </div>
              </div>

              <div class="report-hero-card__type">
                {typeLabels[report.type]}
              </div>

              <h1 class="report-hero-card__title">
                {report.title}
              </h1>

              <p class="report-hero-card__description">
                {report.description}
              </p>

              <div class="report-hero-card__meta">
                <span class="report-meta-item">
                  <MapPin
                    size={15}
                    stroke-width={2.2}
                    aria-hidden="true"
                  />
                  <span>{report.location.areaName}</span>
                </span>

                <span class="report-meta-item">
                  <CalendarDays
                    size={15}
                    stroke-width={2.2}
                    aria-hidden="true"
                  />
                  <time datetime={getIsoDate(report.createdAt)}>
                    {formatDate(report.createdAt)}
                  </time>
                </span>

                {
                  report.reporterName ? (
                    <span class="report-meta-item">
                      <ShieldCheck
                        size={15}
                        stroke-width={2.2}
                        aria-hidden="true"
                      />
                      <span>
                        Dilaporkan oleh {report.reporterName}
                      </span>
                    </span>
                  ) : null
                }
              </div>
            </article>

            <!-- REPORT INFO -->
            <section class="detail-card">
              <div class="detail-card__header">
                <div class="detail-card__serial">
                  01
                </div>

                <div>
                  <span class="detail-card__eyebrow">
                    CONTEXT
                  </span>

                  <h2 class="detail-card__title">
                    Informasi laporan
                  </h2>

                  <p class="detail-card__subtitle">
                    Ringkasan informasi yang diberikan saat laporan dibuat.
                  </p>
                </div>
              </div>

              <div class="detail-facts">
                <div class="detail-fact">
                  <span class="detail-fact__label">
                    JENIS LAPORAN
                  </span>

                  <strong class="detail-fact__value">
                    {typeLabels[report.type]}
                  </strong>
                </div>

                <div class="detail-fact">
                  <span class="detail-fact__label">
                    KATEGORI SAMPAH
                  </span>

                  <strong class="detail-fact__value">
                    {
                      report.category
                        ? categoryLabels[report.category] ??
                          report.category
                        : "Tidak ditentukan"
                    }
                  </strong>
                </div>

                <div class="detail-fact">
                  <span class="detail-fact__label">
                    PRIORITAS
                  </span>

                  <strong class="detail-fact__value">
                    {priorityLabels[report.priority]}
                  </strong>
                </div>

                <div class="detail-fact">
                  <span class="detail-fact__label">
                    STATUS
                  </span>

                  <strong class="detail-fact__value">
                    {statusLabels[report.status]}
                  </strong>
                </div>

                <div class="detail-fact detail-fact--full">
                  <span class="detail-fact__label">
                    WAKTU LAPORAN
                  </span>

                  <strong class="detail-fact__value">
                    {formatDate(report.createdAt, true)}
                  </strong>
                </div>
              </div>
            </section>

            <!-- LOCATION -->
            <section class="detail-card">
              <div class="detail-card__header">
                <div class="detail-card__serial">
                  02
                </div>

                <div>
                  <span class="detail-card__eyebrow">
                    LOCATION
                  </span>

                  <h2 class="detail-card__title">
                    Lokasi kejadian
                  </h2>

                  <p class="detail-card__subtitle">
                    Lokasi sebagaimana dicatat pada laporan.
                  </p>
                </div>
              </div>

              <div class="location-panel">
                <div class="location-panel__row">
                  <div class="location-panel__icon">
                    <MapPin
                      size={18}
                      stroke-width={2.2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <span class="location-panel__label">
                      AREA
                    </span>

                    <strong class="location-panel__value">
                      {report.location.areaName}
                    </strong>
                  </div>
                </div>

                <div class="location-panel__row">
                  <div class="location-panel__icon">
                    <FileText
                      size={18}
                      stroke-width={2.2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <span class="location-panel__label">
                      ALAMAT / LOKASI
                    </span>

                    <strong class="location-panel__value">
                      {report.location.address}
                    </strong>
                  </div>
                </div>

                {
                  report.location.coordinates ? (
                    <div class="location-panel__coordinates">
                      <div>
                        <span class="location-panel__label">
                          LATITUDE
                        </span>

                        <strong>
                          {report.location.coordinates.lat}
                        </strong>
                      </div>

                      <div>
                        <span class="location-panel__label">
                          LONGITUDE
                        </span>

                        <strong>
                          {report.location.coordinates.lng}
                        </strong>
                      </div>
                    </div>
                  ) : null
                }
              </div>

              {
                report.location.coordinates ? (
                  <a
                    class="location-map-link"
                    href={`https://www.google.com/maps/search/?api=1&query=${report.location.coordinates.lat},${report.location.coordinates.lng}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <MapPin
                      size={16}
                      stroke-width={2.2}
                      aria-hidden="true"
                    />

                    <span>
                      Buka koordinat di peta
                    </span>

                    <ExternalLink
                      size={15}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </a>
                ) : null
              }
            </section>

            <!-- GALLERY -->
            {
              imageItems.length > 0 ? (
                <section class="detail-card">
                  <div class="detail-card__header">
                    <div class="detail-card__serial">
                      03
                    </div>

                    <div>
                      <span class="detail-card__eyebrow">
                        EVIDENCE
                      </span>

                      <h2 class="detail-card__title">
                        Bukti visual
                      </h2>

                      <p class="detail-card__subtitle">
                        Foto yang dilampirkan bersama laporan.
                      </p>
                    </div>
                  </div>

                  <div class="report-gallery">
                    {imageItems.map((image, index) => (
                      <a
                        class:list={[
                          "report-gallery__item",
                          {
                            "report-gallery__item--primary":
                              index === 0,
                          },
                        ]}
                        href={image}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <img
                          src={image}
                          alt={`Bukti laporan ${report.title}, foto ${index + 1}`}
                          loading={index === 0 ? "eager" : "lazy"}
                          decoding="async"
                        />

                        <span class="report-gallery__overlay">
                          <ExternalLink
                            size={17}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                          <span>BUKA</span>
                        </span>

                        <span class="report-gallery__index">
                          {String(index + 1).padStart(2, "0")}
                        </span>
                      </a>
                    ))}
                  </div>
                </section>
              ) : null
            }

            <!-- NOTES -->
            {
              report.notes ? (
                <section class="detail-card">
                  <div class="detail-card__header">
                    <div class="detail-card__serial">
                      04
                    </div>

                    <div>
                      <span class="detail-card__eyebrow">
                        NOTE
                      </span>

                      <h2 class="detail-card__title">
                        Catatan tambahan
                      </h2>
                    </div>
                  </div>

                  <p class="detail-note">
                    {report.notes}
                  </p>
                </section>
              ) : null
            }

            <!-- RESOLUTION -->
            {
              report.resolution ? (
                <section class="detail-card detail-card--resolution">
                  <div class="detail-card__header">
                    <div class="detail-card__serial">
                      ✓
                    </div>

                    <div>
                      <span class="detail-card__eyebrow">
                        RESOLUTION
                      </span>

                      <h2 class="detail-card__title">
                        Penyelesaian
                      </h2>

                      <p class="detail-card__subtitle">
                        Catatan penyelesaian laporan.
                      </p>
                    </div>
                  </div>

                  <div class="resolution-panel">
                    <CheckCircle
                      size={21}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <p class="detail-note">
                      {report.resolution}
                    </p>
                  </div>
                </section>
              ) : null
            }
          </div>

          <!-- SIDEBAR -->
          <aside class="report-detail-sidebar">

            <section class="sidebar-status-card">
              <div class="sidebar-status-card__topline">
                <span>
                  STATUS / TRACKING
                </span>

                <span class="sidebar-status-card__code">
                  {report.id}
                </span>
              </div>

              <div class="sidebar-status-card__header">
                <div>
                  <span class="sidebar-status-card__eyebrow">
                    STATUS AKTUAL
                  </span>

                  <h2 class="sidebar-status-card__title">
                    {statusLabels[report.status]}
                  </h2>
                </div>

                {
                  report.status === "resolved" ? (
                    <div class="sidebar-status-card__success">
                      <CheckCircle
                        size={21}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>
                  ) : report.status === "rejected" ? (
                    <div class="sidebar-status-card__danger">
                      <TriangleAlert
                        size={21}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>
                  ) : (
                    <div class="sidebar-status-card__clock">
                      <Clock3
                        size={21}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>
                  )
                }
              </div>

              <div class="status-timeline">
                {
                  statusSteps.map((step, index) => (
                    <div class={getStatusStepState(index)}>
                      <div class="status-step__marker">
                        {index < reportStatusIndex ? (
                          <CheckCircle
                            size={14}
                            stroke-width={2.4}
                            aria-hidden="true"
                          />
                        ) : (
                          <span />
                        )}
                      </div>

                      <div class="status-step__body">
                        <strong>
                          {step.label}
                        </strong>

                        <p>
                          {step.description}
                        </p>
                      </div>
                    </div>
                  ))
                }

                {
                  report.status === "rejected" ? (
                    <div class="status-rejected-note">
                      <TriangleAlert
                        size={16}
                        stroke-width={2}
                        aria-hidden="true"
                      />

                      <span>
                        Laporan ini ditandai ditolak dan
                        tidak dilanjutkan ke tahap penanganan.
                      </span>
                    </div>
                  ) : null
                }
              </div>

              {
                report.verifiedAt ? (
                  <div class="sidebar-status-card__date">
                    <span>
                      DIVERIFIKASI
                    </span>

                    <strong>
                      {formatDate(report.verifiedAt, true)}
                    </strong>
                  </div>
                ) : null
              }

              {
                report.resolvedAt ? (
                  <div class="sidebar-status-card__date">
                    <span>
                      DISELESAIKAN
                    </span>

                    <strong>
                      {formatDate(report.resolvedAt, true)}
                    </strong>
                  </div>
                ) : null
              }
            </section>

            <section class="sidebar-info-card">
              <div class="sidebar-info-card__icon">
                <MapPin
                  size={19}
                  stroke-width={2.2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <span class="sidebar-info-card__label">
                  AREA
                </span>

                <strong class="sidebar-info-card__value">
                  {report.location.areaName}
                </strong>
              </div>
            </section>

            <section class="sidebar-info-card">
              <div class="sidebar-info-card__icon sidebar-info-card__icon--type">
                <FileText
                  size={19}
                  stroke-width={2.2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <span class="sidebar-info-card__label">
                  JENIS
                </span>

                <strong class="sidebar-info-card__value">
                  {typeLabels[report.type]}
                </strong>
              </div>
            </section>

            <section class="sidebar-info-card">
              <div class="sidebar-info-card__icon sidebar-info-card__icon--priority">
                <TriangleAlert
                  size={19}
                  stroke-width={2.2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <span class="sidebar-info-card__label">
                  PRIORITAS
                </span>

                <strong class="sidebar-info-card__value">
                  {priorityLabels[report.priority]}
                </strong>
              </div>
            </section>

            <section class="sidebar-system-card">
              <div class="sidebar-system-card__eyebrow">
                CIVIC INPUT
              </div>

              <h2>
                Kontribusi masyarakat,
                konteks untuk Badung.
              </h2>

              <p>
                Laporan publik membantu membentuk konteks
                kondisi persampahan yang dapat dipahami
                dan ditindaklanjuti.
              </p>

              <a href="/reports/create">
                <span>Buat laporan baru</span>

                <ArrowLeft
                  size={16}
                  stroke-width={2.2}
                  aria-hidden="true"
                />
              </a>
            </section>
          </aside>
        </div>

        <nav
          class="report-detail-footer-nav"
          aria-label="Navigasi laporan"
        >
          <a
            class="report-detail-footer-nav__back"
            href="/reports"
          >
            <ArrowLeft
              size={17}
              stroke-width={2.2}
              aria-hidden="true"
            />

            <span>
              Kembali ke laporan masyarakat
            </span>
          </a>

          <a
            class="report-detail-footer-nav__create"
            href="/reports/create"
          >
            <span>
              Buat laporan
            </span>

            <ArrowLeft
              size={16}
              stroke-width={2.2}
              aria-hidden="true"
            />
          </a>
        </nav>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  :global(html) {
    overflow-x: hidden;
  }

  .report-detail-page {
    --report-ink: #090a08;
    --report-ink-2: #11130f;
    --report-ink-3: #1b1f18;
    --report-acid: #dfff00;
    --report-acid-soft: #efff70;
    --report-paper: #f2f0e6;
    --report-paper-2: #e4e1d4;
    --report-paper-3: #cfcabd;
    --report-white: #fffef8;
    --report-muted: #6c7068;
    --report-orange: #ff6a00;
    --report-green: #87b800;

    min-height: 100vh;
    background: var(--report-paper);
    color: var(--report-ink);
  }

  /* ----------------------------------------------------------
     TOPBAR
     ---------------------------------------------------------- */

  .report-detail__topbar {
    background: var(--report-ink);
    border-bottom: 2px solid var(--report-ink);
  }

  .report-detail__topbar-inner {
    width: min(
      1240px,
      calc(100% - 40px)
    );
    min-height: 44px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .report-detail__back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--report-white);
    text-decoration: none;
    text-transform: uppercase;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .report-detail__back-link:hover {
    color: var(--report-acid);
    transform: translateX(-2px);
  }

  .report-detail__topbar-label {
    color: var(--report-acid);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* ----------------------------------------------------------
     CONTENT
     ---------------------------------------------------------- */

  .report-detail-page__content {
    padding: 52px 0 76px;
  }

  .report-detail-page__container {
    width: min(
      1180px,
      calc(100% - 40px)
    );
    margin-inline: auto;
  }

  .report-detail-intro {
    display: grid;
    grid-template-columns: auto minmax(40px, 1fr) minmax(260px, 400px);
    align-items: center;
    gap: 18px;
    margin-bottom: 28px;
  }

  .report-detail-intro__index {
    display: grid;
    gap: 3px;
  }

  .report-detail-intro__index span,
  .report-detail-intro__index strong {
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
  }

  .report-detail-intro__index span {
    color: var(--report-muted);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .report-detail-intro__index strong {
    color: var(--report-ink);
    font-size: 0.76rem;
    font-weight: 700;
    word-break: break-word;
  }

  .report-detail-intro__rule {
    height: 2px;
    background: var(--report-ink);
  }

  .report-detail-intro__text {
    margin: 0;
    color: #565b53;
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .report-detail-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      300px;
    gap: 30px;
    align-items: start;
  }

  .report-detail-main {
    display: grid;
    gap: 20px;
    min-width: 0;
  }

  /* ----------------------------------------------------------
     HERO
     ---------------------------------------------------------- */

  .report-hero-card {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--report-ink);
    background: var(--report-white);
    box-shadow: 8px 8px 0 var(--report-ink);
    padding: 34px;
  }

  .report-hero-card__accent {
    position: absolute;
    top: 0;
    right: 0;
    padding: 8px 12px;
    background: var(--report-acid);
    border-left: 2px solid var(--report-ink);
    border-bottom: 2px solid var(--report-ink);
    color: var(--report-ink);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .report-hero-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding-right: 80px;
  }

  .report-type-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border: 2px solid var(--report-ink);
    background: var(--report-acid);
    color: var(--report-ink);
  }

  .report-type-icon--warning {
    background: var(--report-orange);
    color: var(--report-white);
  }

  .report-type-icon--hazardous {
    background: #1b1f18;
    color: var(--report-acid);
  }

  .report-type-icon--environmental {
    background: var(--report-acid-soft);
    color: var(--report-ink);
  }

  .report-type-icon--default {
    background: var(--report-paper-2);
    color: var(--report-ink);
  }

  .report-hero-card__badges {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 7px;
  }

  .report-status,
  .report-priority {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 6px 9px;
    border: 1px solid var(--report-ink);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.61rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.035em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .report-status--pending {
    background: var(--report-orange);
    color: var(--report-white);
  }

  .report-status--verified {
    background: var(--report-acid);
    color: var(--report-ink);
  }

  .report-status--progress {
    background: var(--report-ink);
    color: var(--report-acid);
  }

  .report-status--resolved {
    background: var(--report-green);
    color: var(--report-white);
  }

  .report-status--rejected {
    background: #5b1d14;
    color: var(--report-white);
  }

  .report-priority--high {
    background: #5b1d14;
    color: var(--report-white);
  }

  .report-priority--medium {
    background: var(--report-paper-2);
    color: var(--report-ink);
  }

  .report-priority--low {
    background: var(--report-paper);
    color: var(--report-muted);
  }

  .report-hero-card__type {
    display: inline-flex;
    margin-top: 30px;
    padding: 7px 10px;
    background: var(--report-ink);
    color: var(--report-acid);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .report-hero-card__title {
    max-width: 850px;
    margin: 16px 0 0;
    color: var(--report-ink);
    font-family:
      "Sora",
      Inter,
      system-ui,
      sans-serif;
    font-size: clamp(
      1.9rem,
      4vw,
      3.05rem
    );
    font-weight: 850;
    line-height: 1.04;
    letter-spacing: -0.055em;
    overflow-wrap: anywhere;
  }

  .report-hero-card__description {
    max-width: 820px;
    margin: 18px 0 0;
    color: #4f544c;
    font-size: 0.97rem;
    line-height: 1.8;
  }

  .report-hero-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 2px solid var(--report-ink);
  }

  .report-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 28px;
    padding: 0 15px;
    border-right: 1px solid var(--report-paper-3);
    color: var(--report-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.64rem;
    line-height: 1.4;
  }

  .report-meta-item:first-child {
    padding-left: 0;
  }

  .report-meta-item:last-child {
    border-right: 0;
  }

  .report-meta-item svg {
    flex: 0 0 auto;
    color: var(--report-ink);
  }

  /* ----------------------------------------------------------
     DETAIL CARDS
     ---------------------------------------------------------- */

  .detail-card {
    border: 2px solid var(--report-ink);
    background: var(--report-white);
    box-shadow: 5px 5px 0 var(--report-ink);
    padding: 28px;
  }

  .detail-card--resolution {
    background: var(--report-acid-soft);
  }

  .detail-card__header {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--report-ink);
  }

  .detail-card__serial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 2px solid var(--report-ink);
    background: var(--report-ink);
    color: var(--report-acid);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .detail-card__eyebrow {
    display: block;
    margin-bottom: 4px;
    color: var(--report-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .detail-card__title {
    margin: 0;
    color: var(--report-ink);
    font-family:
      "Sora",
      Inter,
      system-ui,
      sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .detail-card__subtitle {
    max-width: 620px;
    margin: 5px 0 0;
    color: var(--report-muted);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .detail-facts {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    margin-top: 4px;
  }

  .detail-fact {
    min-width: 0;
    padding: 17px 14px 17px 0;
    border-bottom: 1px solid var(--report-paper-3);
  }

  .detail-fact:nth-child(even) {
    padding-left: 14px;
    border-left: 1px solid var(--report-paper-3);
  }

  .detail-fact--full {
    grid-column: 1 / -1;
    padding-right: 0;
  }

  .detail-fact__label {
    display: block;
    margin-bottom: 5px;
    color: var(--report-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.055em;
  }

  .detail-fact__value {
    display: block;
    color: var(--report-ink);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.5;
  }

  /* ----------------------------------------------------------
     LOCATION
     ---------------------------------------------------------- */

  .location-panel {
    display: grid;
    gap: 0;
    margin-top: 22px;
    border: 2px solid var(--report-ink);
    background: var(--report-paper);
  }

  .location-panel__row {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 17px;
    border-bottom: 1px solid var(--report-paper-3);
  }

  .location-panel__row:last-child {
    border-bottom: 0;
  }

  .location-panel__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--report-ink);
    color: var(--report-acid);
  }

  .location-panel__label {
    display: block;
    margin-bottom: 4px;
    color: var(--report-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.055em;
  }

  .location-panel__value {
    display: block;
    color: var(--report-ink);
    font-size: 0.85rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .location-panel__coordinates {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--report-paper-3);
  }

  .location-panel__coordinates > div {
    padding: 16px 17px;
  }

  .location-panel__coordinates > div + div {
    border-left: 1px solid var(--report-paper-3);
  }

  .location-panel__coordinates strong {
    color: var(--report-ink);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .location-map-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 15px;
    padding: 11px 14px;
    border: 2px solid var(--report-ink);
    background: var(--report-acid);
    color: var(--report-ink);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.045em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--report-ink);
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .location-map-link:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--report-ink);
  }

  /* ----------------------------------------------------------
     GALLERY
     ---------------------------------------------------------- */

  .report-gallery {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 22px;
  }

  .report-gallery__item {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 180px;
    border: 2px solid var(--report-ink);
    background: var(--report-ink);
  }

  .report-gallery__item--primary {
    grid-column: 1 / -1;
    min-height: 340px;
  }

  .report-gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82);
    transition:
      transform 220ms ease,
      filter 220ms ease;
  }

  .report-gallery__item:hover img {
    transform: scale(1.025);
    filter: saturate(1);
  }

  .report-gallery__overlay {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 10px;
    background: var(--report-acid);
    border: 2px solid var(--report-ink);
    color: var(--report-ink);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.055em;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .report-gallery__item:hover .report-gallery__overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .report-gallery__index {
    position: absolute;
    top: 9px;
    left: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 31px;
    height: 25px;
    padding-inline: 6px;
    background: var(--report-ink);
    color: var(--report-acid);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.58rem;
    font-weight: 700;
  }

  /* ----------------------------------------------------------
     NOTE / RESOLUTION
     ---------------------------------------------------------- */

  .detail-note {
    margin: 22px 0 0;
    color: #454a43;
    font-size: 0.88rem;
    line-height: 1.8;
    white-space: pre-line;
  }

  .resolution-panel {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin-top: 21px;
    padding: 16px;
    border: 2px solid var(--report-ink);
    background: var(--report-white);
  }

  .resolution-panel > svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--report-green);
  }

  .resolution-panel .detail-note {
    margin: 0;
  }

  /* ----------------------------------------------------------
     SIDEBAR
     ---------------------------------------------------------- */

  .report-detail-sidebar {
    position: sticky;
    top: 24px;
    display: grid;
    gap: 12px;
  }

  .sidebar-status-card,
  .sidebar-info-card,
  .sidebar-system-card {
    border: 2px solid var(--report-ink);
    background: var(--report-white);
  }

  .sidebar-status-card {
    box-shadow: 5px 5px 0 var(--report-ink);
    padding: 18px;
  }

  .sidebar-status-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--report-ink);
    color: var(--report-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.07em;
  }

  .sidebar-status-card__code {
    max-width: 145px;
    overflow: hidden;
    color: var(--report-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-status-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 17px 0 18px;
    border-bottom: 1px solid var(--report-paper-3);
  }

  .sidebar-status-card__eyebrow {
    display: block;
    color: var(--report-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.065em;
  }

  .sidebar-status-card__title {
    margin: 5px 0 0;
    color: var(--report-ink);
    font-family:
      "Sora",
      Inter,
      system-ui,
      sans-serif;
    font-size: 0.98rem;
    font-weight: 850;
    line-height: 1.35;
  }

  .sidebar-status-card__success,
  .sidebar-status-card__danger,
  .sidebar-status-card__clock {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 2px solid var(--report-ink);
  }

  .sidebar-status-card__success {
    background: var(--report-acid);
    color: var(--report-ink);
  }

  .sidebar-status-card__danger {
    background: var(--report-orange);
    color: var(--report-white);
  }

  .sidebar-status-card__clock {
    background: var(--report-paper-2);
    color: var(--report-ink);
  }

  .status-timeline {
    display: grid;
    gap: 0;
    padding-top: 17px;
  }

  .status-step {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 10px;
    min-height: 76px;
  }

  .status-step:not(:last-child)::after {
    position: absolute;
    top: 28px;
    bottom: 0;
    left: 13px;
    width: 2px;
    background: var(--report-paper-3);
    content: "";
  }

  .status-step--complete:not(:last-child)::after {
    background: var(--report-acid);
  }

  .status-step__marker {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 2px solid var(--report-paper-3);
    background: var(--report-white);
    color: var(--report-ink);
  }

  .status-step__marker > span {
    width: 7px;
    height: 7px;
    background: currentColor;
  }

  .status-step--complete .status-step__marker {
    border-color: var(--report-ink);
    background: var(--report-acid);
  }

  .status-step--current .status-step__marker {
    border-color: var(--report-ink);
    background: var(--report-ink);
    color: var(--report-acid);
  }

  .status-step__body {
    padding-bottom: 14px;
  }

  .status-step__body strong {
    display: block;
    color: var(--report-ink);
    font-size: 0.76rem;
    font-weight: 850;
    line-height: 1.35;
  }

  .status-step__body p {
    margin: 4px 0 0;
    color: var(--report-muted);
    font-size: 0.69rem;
    line-height: 1.55;
  }

  .status-rejected-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 2px;
    padding: 10px;
    border: 1px solid var(--report-ink);
    background: #f6d2c9;
    color: #5b1d14;
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .sidebar-status-card__date {
    display: grid;
    gap: 3px;
    margin-top: 13px;
    padding-top: 13px;
    border-top: 1px solid var(--report-paper-3);
  }

  .sidebar-status-card__date span {
    color: var(--report-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .sidebar-status-card__date strong {
    color: var(--report-ink);
    font-size: 0.69rem;
    line-height: 1.45;
  }

  .sidebar-info-card {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 13px;
  }

  .sidebar-info-card__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: var(--report-acid);
    color: var(--report-ink);
  }

  .sidebar-info-card__icon--type {
    background: var(--report-paper-2);
  }

  .sidebar-info-card__icon--priority {
    background: var(--report-orange);
    color: var(--report-white);
  }

  .sidebar-info-card__label {
    display: block;
    margin-bottom: 3px;
