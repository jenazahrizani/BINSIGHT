        )
      }
    </div>
  </section>

  <section
    class="directory-section"
    aria-labelledby="directory-title"
  >
    <div class="directory-toolbar">
      <div>
        <span class="section-heading__eyebrow">
          Direktori material
        </span>

        <h2
          id="directory-title"
          class="section-heading__title"
        >
          Jelajahi material
        </h2>

        <p class="section-heading__description">
          Cari berdasarkan nama material, kategori,
          karakteristik, atau metode pengelolaan.
        </p>
      </div>

      <label class="directory-search">
        <Search
          size={18}
          stroke-width={1.9}
          aria-hidden="true"
        />

        <span class="sr-only">
          Cari material sampah
        </span>

        <input
          id="waste-search"
          type="search"
          placeholder="Cari material..."
          autocomplete="off"
          aria-label="Cari material sampah"
        />
      </label>
    </div>

    <div
      class="active-filter"
      data-active-filter
      hidden
    >
      <span>Filter:</span>

      <strong data-active-filter-label>
        Semua
      </strong>

      <button
        type="button"
        data-clear-filter
      >
        Hapus
      </button>
    </div>

    <div
      class="material-grid"
      data-material-grid
    >
      {
        materialViews.map(
          (
            material: WasteMaterialDefinition,
          ) => {
            const category = getCategory(
              material.category,
            );

            const characteristicLabels =
              getCharacteristicLabels(
                material,
              );

            const methodLabels =
              getMethodLabels(material);

            const searchableText = [
              material.label,
              material.id,
              material.description,
              category.label,
              category.shortLabel,
              ...characteristicLabels,
              ...methodLabels,
            ]
              .join(" ")
              .toLowerCase();

            return (
              <article
                class="material-card"
                data-material-card
                data-category={
                  material.category
                }
                data-search-text={
                  searchableText
                }
              >
                <div class="material-card__top">
                  <span
                    class="material-card__icon"
                    style={`--category-color:${category.color};--category-soft:${category.softColor};`}
                  >
                    {getCategoryIconMarkup(
                      material.category,
                      21,
                    )}
                  </span>

                  <span
                    class="material-card__category"
                    style={`--category-color:${category.color};--category-soft:${category.softColor};`}
                  >
                    {category.shortLabel}
                  </span>
                </div>

                <div class="material-card__content">
                  <h3 class="material-card__title">
                    {material.label}
                  </h3>

                  <p class="material-card__description">
                    {material.description}
                  </p>

                  <div class="material-card__section">
                    <span class="material-card__section-title">
                      Karakteristik
                    </span>

                    <div class="material-card__tags">
                      {
                        characteristicLabels.map(
                          (
                            label: string,
                          ) => (
                            <span class="material-tag">
                              <Check
                                size={12}
                                stroke-width={2}
                                aria-hidden="true"
                              />

                              {label}
                            </span>
                          ),
                        )
                      }
                    </div>
                  </div>

                  <div class="material-card__section">
                    <span class="material-card__section-title">
                      Metode yang direkomendasikan
                    </span>

                    <div class="method-list">
                      {
                        methodLabels.map(
                          (
                            label: string,
                          ) => (
                            <span class="method-item">
                              <span class="method-item__dot"></span>
                              {label}
                            </span>
                          ),
                        )
                      }
                    </div>
                  </div>
                </div>

                <footer class="material-card__footer">
                  <a
                    href={`/waste/${encodeURIComponent(material.id)}`}
                    class="material-card__link"
                  >
                    Pelajari material

                    <ArrowRight
                      size={15}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </a>
                </footer>
