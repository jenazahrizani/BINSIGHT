      <ArrowRight
        size={16}
        stroke-width={1.9}
        aria-hidden="true"
      />
    </a>
  </section>

</section>
</main>

  <script>
    const categoryFilterData = [
      {
        id: "organic",
        label: "Organik",
      },
      {
        id: "inorganic",
        label: "Anorganik",
      },
      {
        id: "hazardous",
        label: "B3 / Berbahaya",
      },
      {
        id: "electronic",
        label: "Elektronik",
      },
      {
        id: "residual",
        label: "Residu",
      },
    ];

    const searchInput =
      document.querySelector<HTMLInputElement>(
        "#waste-search",
      );

    const categoryButtons =
      Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-category-filter]",
        ),
      );

    const materialCards =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          "[data-material-card]",
        ),
      );

    const emptyState =
      document.querySelector<HTMLElement>(
        "[data-directory-empty]",
      );

    const activeFilter =
      document.querySelector<HTMLElement>(
        "[data-active-filter]",
      );

    const activeFilterLabel =
      document.querySelector<HTMLElement>(
        "[data-active-filter-label]",
      );

    const clearFilterButton =
      document.querySelector<HTMLButtonElement>(
        "[data-clear-filter]",
      );

    const clearAllButton =
      document.querySelector<HTMLButtonElement>(
        "[data-clear-all]",
      );

    const materialGrid =
      document.querySelector<HTMLElement>(
        "[data-material-grid]",
      );

    let selectedCategory = "";

    const normalize = (
      value: string,
    ): string =>
      value.trim().toLowerCase();

    const getCategoryLabel = (
      value: string,
    ): string => {
      const match = categoryFilterData.find(
        (item: {
          id: string;
          label: string;
        }) => item.id === value,
      );

      return match?.label ?? value;
    };

    const updateFilterState = (): void => {
      const query = normalize(
        searchInput?.value ?? "",
      );

      let visibleCount = 0;

      materialCards.forEach(
        (card: HTMLElement) => {
          const category =
            card.dataset["category"] ?? "";

          const searchText =
            card.dataset["searchText"] ?? "";

          const categoryMatches =
            !selectedCategory ||
            category === selectedCategory;

          const searchMatches =
            !query ||
            searchText.includes(query);

          const visible =
            categoryMatches &&
            searchMatches;

          card.hidden = !visible;

          if (visible) {
            visibleCount += 1;
          }
        },
      );

      categoryButtons.forEach(
        (button: HTMLButtonElement) => {
          const category =
            button.dataset[
              "categoryFilter"
            ] ?? "";

          const active =
            category === selectedCategory;

          button.classList.toggle(
            "category-card--active",
            active,
          );

          button.setAttribute(
            "aria-pressed",
            String(active),
          );
        },
      );

      if (emptyState) {
        emptyState.hidden =
          visibleCount > 0;
      }

      if (materialGrid) {
        materialGrid.hidden =
          visibleCount === 0;
      }

      if (activeFilter) {
        activeFilter.hidden =
          !selectedCategory;
      }

      if (
        activeFilterLabel &&
        selectedCategory
      ) {
        activeFilterLabel.textContent =
          getCategoryLabel(
            selectedCategory,
          );
      }
    };

    categoryButtons.forEach(
      (button: HTMLButtonElement) => {
        button.addEventListener(
          "click",
          () => {
            const category =
              button.dataset[
                "categoryFilter"
              ] ?? "";

            selectedCategory =
              selectedCategory === category
                ? ""
                : category;

            updateFilterState();
          },
        );
      },
    );

    searchInput?.addEventListener(
      "input",
      () => {
        updateFilterState();
      },
    );

    clearFilterButton?.addEventListener(
      "click",
      () => {
        selectedCategory = "";
        updateFilterState();
      },
    );

    clearAllButton?.addEventListener(
      "click",
      () => {
        selectedCategory = "";

        if (searchInput) {
          searchInput.value = "";
        }

        updateFilterState();
      },
    );

    updateFilterState();
  </script>

