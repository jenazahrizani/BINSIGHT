---

/**

* ============================================================================
* BINSIGHT â€” WASTE DIRECTORY
* ============================================================================
* Public waste taxonomy / education page.
*
* Route:
* /waste
*
* Source of truth:
* src/lib/constants/waste.ts
*
* This page presents taxonomy only.
* No invented operational statistics are shown.
* ============================================================================
  */

import {
ArrowRight,
Check,
Leaf,
Package,
Recycle,
Search,
ShieldAlert,
Smartphone,
Trash,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";

import {
WASTE_CATEGORIES,
WASTE_MATERIALS,
getWasteCategoryLabel,
getWasteCharacteristicLabel,
getWasteMethodLabel,
type WasteCategory,
type WasteMaterialDefinition,
} from "@lib/constants/waste";

/* -------------------------------------------------------------------------- */
/* Types                                                                      */
/* -------------------------------------------------------------------------- */

interface CategoryView {
id: WasteCategory;
label: string;
shortLabel: string;
description: string;
color: string;
softColor: string;
icon: string;
count: number;
}

/* -------------------------------------------------------------------------- */
/* Data                                                                       */
/* -------------------------------------------------------------------------- */

const categoryViews: CategoryView[] =
WASTE_CATEGORIES.map((category) => ({
id: category.id,
label: category.label,
shortLabel: category.shortLabel,
description: category.description,
color: category.color,
softColor: category.softColor,
icon: category.icon,
count: WASTE_MATERIALS.filter(
(material: WasteMaterialDefinition) =>
material.category === category.id,
).length,
}));

const materialViews: WasteMaterialDefinition[] =
[...WASTE_MATERIALS].sort(
(
first: WasteMaterialDefinition,
second: WasteMaterialDefinition,
) => first.order - second.order,
);

const totalMaterials = materialViews.length;

const breadcrumbs = [
{
label: "Beranda",
href: "/",
},
{
label: "Jenis Sampah",
},
];

/* -------------------------------------------------------------------------- */
/* Helpers                                                                    */
/* -------------------------------------------------------------------------- */

const getCategory = (
category: WasteCategory,
): CategoryView => {
const found = categoryViews.find(
(item: CategoryView) =>
item.id === category,
);

return (
found ?? {
id: category,
label: getWasteCategoryLabel(category),
shortLabel: getWasteCategoryLabel(category),
description:
"Kategori sampah dalam taksonomi BINSIGHT.",
color: "#64748B",
softColor: "#F1F5F9",
icon: "recycle",
count: 0,
}
);
};

const getCategoryIconMarkup = (
category: WasteCategory,
size = 22,
) => {
switch (category) {
case "organic":
return ( <Leaf
       size={size}
       stroke-width={1.8}
       aria-hidden="true"
     />
);
case "inorganic":
  return (
    <Package
      size={size}
      stroke-width={1.8}
      aria-hidden="true"
    />
  );

case "hazardous":
  return (
    <ShieldAlert
      size={size}
      stroke-width={1.8}
      aria-hidden="true"
    />
  );

case "electronic":
  return (
    <Smartphone
      size={size}
      stroke-width={1.8}
      aria-hidden="true"
    />
  );

case "residual":
  return (
    <Trash
      size={size}
      stroke-width={1.8}
      aria-hidden="true"
    />
  );

default:
  return (
    <Recycle
      size={size}
      stroke-width={1.8}
      aria-hidden="true"
    />
  );
}
};

const getCharacteristicLabels = (
material: WasteMaterialDefinition,
): string[] =>
material.characteristics.map(
(characteristic) =>
getWasteCharacteristicLabel(
characteristic,
),
);

const getMethodLabels = (
material: WasteMaterialDefinition,
): string[] =>
material.recommendedMethods.map(
(method) =>
getWasteMethodLabel(method),
);

---

<PublicLayout
title="Jenis Sampah â€” BINSIGHT"
description="Pelajari kategori, material, karakteristik, dan metode pengelolaan sampah dalam ekosistem BINSIGHT."

>

<PageHeader
 eyebrow="Edukasi Persampahan"
 title="Jenis Sampah"
 description="Kenali berbagai kategori dan material sampah, karakteristiknya, serta pendekatan pengelolaan yang sesuai."
 icon="waste"
 tone="green"
