---
/**
 * ============================================================================
 * BINSIGHT — WASTE DIRECTORY
 * ============================================================================
 * Public waste taxonomy / education page.
 *
 * Route:
 * /waste
 *
 * Source of truth:
 * src/lib/constants/waste.ts
 *
 * This page presents taxonomy only.
 * No invented operational statistics are shown.
 * ============================================================================
 */

import {
  ArrowRight,
  Check,
  Leaf,
  Package,
  Recycle,
  Search,
  ShieldAlert,
  Smartphone,
  Trash,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import {
  WASTE_CATEGORIES,
  WASTE_MATERIALS,
  getWasteCategoryLabel,
  getWasteCharacteristicLabel,
  getWasteMethodLabel,
} from "@lib/constants/waste";

import type {
  WasteCategory,
  WasteMaterialDefinition,
} from "@lib/constants/waste";

/* -------------------------------------------------------------------------- */
/* Types                                                                      */
/* -------------------------------------------------------------------------- */

interface CategoryView {
  id: WasteCategory;
  label: string;
  shortLabel: string;
  description: string;
  color: string;
  softColor: string;
  icon: string;
  count: number;
}

/* -------------------------------------------------------------------------- */
/* Data                                                                       */
/* -------------------------------------------------------------------------- */

const categoryViews: CategoryView[] =
  WASTE_CATEGORIES.map((category) => ({
    id: category.id,
    label: category.label,
    shortLabel: category.shortLabel,
    description: category.description,
    color: category.color,
    softColor: category.softColor,
    icon: category.icon,
    count: WASTE_MATERIALS.filter(
      (material: WasteMaterialDefinition) =>
        material.category === category.id,
    ).length,
  }));

const materialViews: WasteMaterialDefinition[] =
  [...WASTE_MATERIALS].sort(
    (
      first: WasteMaterialDefinition,
      second: WasteMaterialDefinition,
    ) => first.order - second.order,
  );

const totalMaterials =
  materialViews.length;

const pageTitle =
  "Jenis Sampah — BINSIGHT";

const pageDescription =
  "Pelajari kategori, material, karakteristik, dan metode pengelolaan sampah dalam ekosistem BINSIGHT.";

/* -------------------------------------------------------------------------- */
/* Helpers                                                                    */
/* -------------------------------------------------------------------------- */

const getCategory = (
  category: WasteCategory,
): CategoryView => {
  const found =
    categoryViews.find(
      (item) => item.id === category,
    );

  return (
    found ?? {
      id: category,
      label:
        getWasteCategoryLabel(category),
      shortLabel:
        getWasteCategoryLabel(category),
      description:
        "Kategori sampah dalam taksonomi BINSIGHT.",
      color: "#64748B",
      softColor: "#F1F5F9",
      icon: "recycle",
      count: 0,
    }
  );
};

const getCategoryIcon = (
  category: WasteCategory,
) => {
  switch (category) {
    case "organic":
      return Leaf;

    case "inorganic":
      return Package;

    case "hazardous":
      return ShieldAlert;

    case "electronic":
      return Smartphone;

    case "residual":
      return Trash;

    default:
      return Recycle;
  }
};

const getCharacteristicLabels = (
  material: WasteMaterialDefinition,
): string[] =>
  material.characteristics.map(
    (characteristic) =>
      getWasteCharacteristicLabel(
        characteristic,
      ),
  );

const getMethodLabels = (
  material: WasteMaterialDefinition,
): string[] =>
  material.recommendedMethods.map(
    (method) =>
      getWasteMethodLabel(method),
  );
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
>
  <main
    class="waste-page"
    data-waste-page
  >
    <!-- ================================================================== -->
    <!-- HERO                                                               -->
    <!-- ================================================================== -->

    <section class="waste-hero">
      <div class="waste-container waste-hero__inner">
        <div class="waste-hero__content">
          <div class="waste-kicker">
            <span
              class="waste-kicker__dot"
              aria-hidden="true"
            ></span>

            BINSIGHT / WASTE TAXONOMY
          </div>

          <h1>
            Memahami sampah
            <span>sebelum mengelolanya.</span>
          </h1>

          <p>
            Kenali kategori, material, karakteristik,
            dan pendekatan pengelolaan yang tercatat
            dalam taksonomi BINSIGHT.
          </p>
        </div>

        <aside class="waste-hero__aside">
          <div class="waste-hero__aside-top">
            <span>
              TAXONOMY STATUS
            </span>

            <Recycle
              size={22}
              stroke-width="2"
              aria-hidden="true"
            />
          </div>

          <strong>
            Referensi material
            publik.
          </strong>

          <p>
            Halaman ini menyajikan struktur taksonomi,
            bukan statistik operasional atau volume
            sampah.
          </p>

          <div class="waste-hero__stats">
            <div>
              <span>KATEGORI</span>
              <strong>
                {categoryViews.length}
              </strong>
            </div>

            <div>
              <span>MATERIAL</span>
              <strong>
                {totalMaterials}
              </strong>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- CATEGORY                                                           -->
    <!-- ================================================================== -->

    <section
      class="category-section"
      aria-labelledby="category-title"
    >
      <div class="waste-container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">
              01 / STRUKTUR DATA
            </span>

            <h2 id="category-title">
              Kategori sampah.
            </h2>

            <p>
              Kelompok utama yang digunakan untuk
              mengorganisasi material pada sistem
              BINSIGHT.
            </p>
          </div>

          <span class="section-heading__meta">
            FILTER MATERIAL
          </span>
        </div>

        <div class="category-grid">
          {categoryViews.map(
            (category: CategoryView) => {
              const Icon =
                getCategoryIcon(
                  category.id,
                );

              return (
                <button
                  type="button"
                  class="category-card"
                  data-category-filter={
                    category.id
                  }
                  data-category-label={
                    category.label
                  }
                  aria-pressed="false"
                  style={`--category-color:${category.color};--category-soft:${category.softColor};`}
                >
                  <span class="category-card__top">
                    <span class="category-card__number">
                      {String(
                        categoryViews.indexOf(
                          category,
                        ) + 1,
                      ).padStart(2, "0")}
                    </span>

                    <span class="category-card__icon">
                      <Icon
                        size={23}
                        stroke-width="1.8"
                        aria-hidden="true"
                      />
                    </span>
                  </span>

                  <span class="category-card__body">
                    <span class="category-card__label">
                      {category.label}
                    </span>

                    <span class="category-card__description">
                      {category.description}
                    </span>

                    <span class="category-card__meta">
                      {category.count} material

                      <ArrowRight
                        size={14}
                        stroke-width="1.9"
                        aria-hidden="true"
                      />
                    </span>
                  </span>
                </button>
              );
            },
          )}
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- DIRECTORY                                                          -->
    <!-- ================================================================== -->

    <section
      class="directory-section"
      aria-labelledby="directory-title"
    >
      <div class="waste-container">
        <div class="directory-toolbar">
          <div>
            <span class="section-kicker">
              02 / DIREKTORI MATERIAL
            </span>

            <h2
              id="directory-title"
              class="directory-title"
            >
              Jelajahi material.
            </h2>

            <p class="directory-description">
              Cari berdasarkan nama material, kategori,
              karakteristik, atau metode pengelolaan.
            </p>
          </div>

          <label
            class="directory-search"
            for="waste-search"
          >
            <Search
              size={17}
              stroke-width="1.9"
              aria-hidden="true"
            />

            <span class="sr-only">
              Cari material sampah
            </span>

            <input
              id="waste-search"
              type="search"
              placeholder="Cari material..."
              autocomplete="off"
              aria-label="Cari material sampah"
            />
          </label>
        </div>

        <div
          class="active-filter"
          data-active-filter
          hidden
        >
          <span>
            FILTER
          </span>

          <strong
            data-active-filter-label
          >
            Semua
          </strong>

          <button
            type="button"
            data-clear-filter
          >
            Hapus
          </button>
        </div>

        <div class="directory-result-bar">
          <span>
            <strong
              data-visible-count
            >
              {totalMaterials}
            </strong>
            material ditampilkan
          </span>

          <button
            type="button"
            class="result-reset"
            data-clear-all
            hidden
          >
            Reset

            <ArrowRight
              size={13}
              stroke-width="2"
              aria-hidden="true"
            />
          </button>
        </div>

        <!-- MATERIAL GRID -->
        <div
          class="material-grid"
          data-material-grid
          aria-live="polite"
        >
          {materialViews.map(
            (
              material: WasteMaterialDefinition,
            ) => {
              const category =
                getCategory(
                  material.category,
                );

              const Icon =
                getCategoryIcon(
                  material.category,
                );

              const characteristicLabels =
                getCharacteristicLabels(
                  material,
                );

              const methodLabels =
                getMethodLabels(
                  material,
                );

              const searchableText = [
                material.label,
                material.id,
                material.description,
                category.label,
                category.shortLabel,
                ...characteristicLabels,
                ...methodLabels,
              ]
                .join(" ")
                .toLowerCase();

              return (
                <article
                  class="material-card"
                  data-material-card
                  data-category={
                    material.category
                  }
                  data-search-text={
                    searchableText
                  }
                  style={`--category-color:${category.color};--category-soft:${category.softColor};`}
                >
                  <div class="material-card__top">
                    <span class="material-card__index">
                      MATERIAL
                    </span>

                    <span class="material-card__category">
                      {category.shortLabel}
                    </span>
                  </div>

                  <div class="material-card__visual">
                    <div class="material-card__icon">
                      <Icon
                        size={25}
                        stroke-width="1.8"
                        aria-hidden="true"
                      />
                    </div>

                    <span class="material-card__code">
                      {material.id}
                    </span>
                  </div>

                  <div class="material-card__content">
                    <h3 class="material-card__title">
                      {material.label}
                    </h3>

                    <p class="material-card__description">
                      {material.description}
                    </p>

                    {characteristicLabels.length >
                      0 && (
                      <div class="material-card__section">
                        <span class="material-card__section-title">
                          KARAKTERISTIK
                        </span>

                        <div class="material-card__tags">
                          {characteristicLabels.map(
                            (
                              label: string,
                            ) => (
                              <span class="material-tag">
                                <Check
                                  size={11}
                                  stroke-width="2"
                                  aria-hidden="true"
                                />

                                {label}
                              </span>
                            ),
                          )}
                        </div>
                      </div>
                    )}

                    {methodLabels.length > 0 && (
                      <div class="material-card__section">
                        <span class="material-card__section-title">
                          METODE YANG DIREKOMENDASIKAN
                        </span>

                        <div class="method-list">
                          {methodLabels.map(
                            (
                              label: string,
                            ) => (
                              <span class="method-item">
                                <span class="method-item__dot"></span>

                                {label}
                              </span>
                            ),
                          )}
                        </div>
                      </div>
                    )}
                  </div>

                  <footer class="material-card__footer">
                    <a
                      href={`/waste/${encodeURIComponent(material.id)}`}
                      class="material-card__link"
                    >
                      <span>
                        Pelajari material
                      </span>

                      <ArrowRight
                        size={15}
                        stroke-width="1.9"
                        aria-hidden="true"
                      />
                    </a>
                  </footer>
                </article>
              );
            },
          )}
        </div>

        <!-- EMPTY -->
        <div
          class="directory-empty"
          data-directory-empty
          hidden
        >
          <div class="directory-empty__icon">
            <Search
              size={27}
              stroke-width="1.7"
              aria-hidden="true"
            />
          </div>

          <span class="directory-empty__eyebrow">
            NO MATCH
          </span>

          <h3>
            Material tidak ditemukan.
          </h3>

          <p>
            Tidak ada material yang cocok dengan
            pencarian atau filter yang dipilih.
          </p>

          <button
            type="button"
            data-clear-all-empty
          >
            Tampilkan semua material
          </button>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- GUIDANCE                                                           -->
    <!-- ================================================================== -->

    <section class="guidance-section">
      <div class="waste-container">
        <div class="guidance-card">
          <div class="guidance-card__icon">
            <Recycle
              size={25}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </div>

          <div class="guidance-card__content">
            <span>
              03 / PRINSIP DATA
            </span>

            <h2>
              Kenali material.
              Pilih jalur pengelolaan.
            </h2>

            <p>
              Direktori ini berfungsi sebagai referensi
              taksonomi. Informasi kuantitas atau statistik
              operasional tidak ditampilkan tanpa sumber
              data yang tersedia.
            </p>
          </div>

          <a
            href="/organizations"
            class="guidance-card__link"
          >
            Temukan organisasi

            <ArrowRight
              size={16}
              stroke-width="1.9"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<script>
  const initializeWastePage = () => {
    const page =
      document.querySelector<HTMLElement>(
        "[data-waste-page]",
      );

    if (
      !page ||
      page.dataset.initialized === "true"
    ) {
      return;
    }

    page.dataset.initialized =
      "true";

    const searchInput =
      page.querySelector<HTMLInputElement>(
        "#waste-search",
      );

    const categoryButtons =
      Array.from(
        page.querySelectorAll<HTMLButtonElement>(
          "[data-category-filter]",
        ),
      );

    const materialCards =
      Array.from(
        page.querySelectorAll<HTMLElement>(
          "[data-material-card]",
        ),
      );

    const materialGrid =
      page.querySelector<HTMLElement>(
        "[data-material-grid]",
      );

    const emptyState =
      page.querySelector<HTMLElement>(
        "[data-directory-empty]",
      );

    const activeFilter =
      page.querySelector<HTMLElement>(
        "[data-active-filter]",
      );

    const activeFilterLabel =
      page.querySelector<HTMLElement>(
        "[data-active-filter-label]",
      );

    const clearFilterButton =
      page.querySelector<HTMLButtonElement>(
        "[data-clear-filter]",
      );

    const clearAllButton =
      page.querySelector<HTMLButtonElement>(
        "[data-clear-all]",
      );

    const clearAllEmptyButton =
      page.querySelector<HTMLButtonElement>(
        "[data-clear-all-empty]",
      );

    const visibleCount =
      page.querySelector<HTMLElement>(
        "[data-visible-count]",
      );

    let selectedCategory = "";

    const normalize = (
      value: string,
    ): string =>
      value
        .normalize("NFD")
        .replace(
          /[\u0300-\u036f]/g,
          "",
        )
        .toLowerCase()
        .replace(/\s+/g, " ")
        .trim();

    const hasActiveFilters = () => {
      return Boolean(
        selectedCategory ||
          searchInput?.value.trim(),
      );
    };

    const clearEverything = () => {
      selectedCategory = "";

      if (searchInput) {
        searchInput.value = "";
      }

      applyFilters();
    };

    const applyFilters = () => {
      const query =
        normalize(
          searchInput?.value ?? "",
        );

      let visibleTotal = 0;

      materialCards.forEach(
        (card) => {
          const category =
            card.dataset[
              "category"
            ] ?? "";

          const searchText =
            normalize(
              card.dataset[
                "searchText"
              ] ?? "",
            );

          const categoryMatches =
            !selectedCategory ||
            category ===
              selectedCategory;

          const searchMatches =
            !query ||
            searchText.includes(
              query,
            );

          const matches =
            categoryMatches &&
            searchMatches;

          card.hidden = !matches;

          if (matches) {
            visibleTotal += 1;
          }
        },
      );

      categoryButtons.forEach(
        (button) => {
          const category =
            button.dataset[
              "categoryFilter"
            ] ?? "";

          const active =
            category ===
            selectedCategory;

          button.classList.toggle(
            "category-card--active",
            active,
          );

          button.setAttribute(
            "aria-pressed",
            String(active),
          );
        },
      );

      if (visibleCount) {
        visibleCount.textContent =
          String(visibleTotal);
      }

      if (materialGrid) {
        materialGrid.hidden =
          visibleTotal === 0;
      }

      if (emptyState) {
        emptyState.hidden =
          visibleTotal > 0;
      }

      const active =
        Boolean(selectedCategory);

      if (activeFilter) {
        activeFilter.hidden =
          !active;
      }

      if (
        activeFilterLabel &&
        selectedCategory
      ) {
        const activeButton =
          categoryButtons.find(
            (button) =>
              button.dataset[
                "categoryFilter"
              ] === selectedCategory,
          );

        activeFilterLabel.textContent =
          activeButton?.dataset[
            "categoryLabel"
          ] ??
          selectedCategory;
      }

      const filtersActive =
        hasActiveFilters();

      if (clearAllButton) {
        clearAllButton.hidden =
          !filtersActive;
      }
    };

    categoryButtons.forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const category =
              button.dataset[
                "categoryFilter"
              ] ?? "";

            selectedCategory =
              selectedCategory ===
              category
                ? ""
                : category;

            applyFilters();
          },
        );
      },
    );

    searchInput?.addEventListener(
      "input",
      applyFilters,
    );

    clearFilterButton?.addEventListener(
      "click",
      () => {
        selectedCategory = "";
        applyFilters();
      },
    );

    clearAllButton?.addEventListener(
      "click",
      clearEverything,
    );

    clearAllEmptyButton?.addEventListener(
      "click",
      clearEverything,
    );

    applyFilters();
  };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeWastePage,
      { once: true },
    );
  } else {
    initializeWastePage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeWastePage,
  );
</script>

<style>
  /* ==========================================================================
     TOKENS
     ========================================================================== */

  .waste-page {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;

    --white: #fffef8;
    --muted: #6c7068;
    --warning: #ff6a00;

    --line: rgba(9, 10, 8, 0.18);
    --line-dark: rgba(255, 254, 248, 0.18);

    --container: 1320px;

    width: 100%;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .waste-container {
    width: min(
      var(--container),
      calc(100% - 40px)
    );
    margin-inline: auto;
  }

  .waste-page a,
  .waste-page button {
    -webkit-tap-highlight-color: transparent;
  }

  .waste-page a:focus-visible,
  .waste-page button:focus-visible,
  .waste-page input:focus-visible {
    outline: 3px solid var(--warning);
    outline-offset: 4px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .waste-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 4px solid var(--ink);
    background:
      linear-gradient(
        115deg,
        var(--paper) 0%,
        var(--paper) 67%,
        var(--acid-soft) 67%,
        var(--acid-soft) 100%
      );
  }

  .waste-hero::before {
    position: absolute;
    top: 0;
    right: 16%;
    width: 1px;
    height: 100%;
    background: rgba(9, 10, 8, 0.08);
    content: "";
  }

  .waste-hero::after {
    position: absolute;
    right: -8rem;
    bottom: -13rem;
    width: 30rem;
    height: 30rem;
    border: 3px solid rgba(9, 10, 8, 0.08);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .waste-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      320px;
    gap: 4rem;
    align-items: end;
    min-height: 540px;
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .waste-hero__content {
    max-width: 900px;
  }

  .waste-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-bottom: 1.2rem;
    padding: 0.48rem 0.7rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .waste-kicker__dot {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--acid);
  }

  .waste-hero h1 {
    max-width: 950px;
    margin: 0;
    color: var(--ink);
    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;
    font-size: clamp(
      3rem,
      7vw,
      7rem
    );
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.067em;
    text-transform: uppercase;
  }

  .waste-hero h1 span {
    display: block;
    color: var(--warning);
  }

  .waste-hero__content > p {
    max-width: 720px;
    margin: 1.7rem 0 0;
    color: rgba(9, 10, 8, 0.68);
    font-size: 0.9rem;
    line-height: 1.72;
  }

  .waste-hero__aside {
    padding: 1.2rem;
    border: 3px solid var(--ink);
    background: var(--ink);
    color: var(--white);
    box-shadow: 8px 8px 0 var(--warning);
  }

  .waste-hero__aside-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .waste-hero__aside > strong {
    display: block;
    margin-top: 2rem;
    color: var(--white);
    font-family:
      "Sora",
