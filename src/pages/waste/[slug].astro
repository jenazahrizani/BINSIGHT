---
/**
 * ============================================================================
 * BINSIGHT — WASTE DETAIL
 * ============================================================================
 * Public educational detail page for one waste material.
 *
 * Route:
 * /waste/[slug]
 *
 * Source of truth:
 * src/lib/constants/waste.ts
 *
 * The page intentionally does not invent live quantities, prices, capacity,
 * collection schedules, or organization statistics.
 * ============================================================================
 */

import {
  ArrowLeft,
  ArrowRight,
  Check,
  ChevronRight,
  Info,
  Package,
  Recycle,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import {
  WASTE_MATERIALS,
  WASTE_CATEGORIES,
  getWasteCategoryLabel,
  getWasteCharacteristicLabel,
  getWasteMethodLabel,
} from "@lib/constants/waste";

import type {
  WasteCategory,
  WasteMaterialDefinition,
} from "@lib/constants/waste";

/* -------------------------------------------------------------------------- */
/* Route generation                                                           */
/* -------------------------------------------------------------------------- */

export function getStaticPaths() {
  return WASTE_MATERIALS.map(
    (material: WasteMaterialDefinition) => ({
      params: {
        slug: material.id,
      },
    }),
  );
}

/* -------------------------------------------------------------------------- */
/* Route resolution                                                           */
/* -------------------------------------------------------------------------- */

const requestedSlug =
  Astro.params.slug?.trim().toLowerCase() ?? "";

const material =
  WASTE_MATERIALS.find(
    (item: WasteMaterialDefinition) =>
      item.id.toLowerCase() === requestedSlug,
  ) ?? null;

if (!material) {
  return Astro.redirect("/waste", 302);
}

/* -------------------------------------------------------------------------- */
/* Derived data                                                               */
/* -------------------------------------------------------------------------- */

const category = WASTE_CATEGORIES.find(
  (item: WasteCategory) =>
    item.id === material.category,
);

const categoryLabel =
  category?.label ??
  getWasteCategoryLabel(material.category);

const characteristics = material.characteristics.map(
  (characteristic) =>
    getWasteCharacteristicLabel(characteristic),
);

const methods = material.recommendedMethods.map(
  (method) =>
    getWasteMethodLabel(method),
);

const categoryMaterials = WASTE_MATERIALS
  .filter(
    (item: WasteMaterialDefinition) =>
      item.category === material.category,
  )
  .sort(
    (
      first: WasteMaterialDefinition,
      second: WasteMaterialDefinition,
    ) => first.order - second.order,
  );

const relatedMaterials = categoryMaterials
  .filter(
    (item: WasteMaterialDefinition) =>
      item.id !== material.id,
  )
  .slice(0, 4);

const materialIndex = WASTE_MATERIALS.findIndex(
  (item: WasteMaterialDefinition) =>
    item.id === material.id,
);

const previousMaterial =
  materialIndex > 0
    ? WASTE_MATERIALS[materialIndex - 1]
    : null;

const nextMaterial =
  materialIndex >= 0 &&
  materialIndex < WASTE_MATERIALS.length - 1
    ? WASTE_MATERIALS[materialIndex + 1]
    : null;

const categoryColor =
  category?.color ?? "#dfff00";

const categorySoftColor =
  category?.softColor ?? "#efff70";

/* -------------------------------------------------------------------------- */
/* Structured data                                                            */
/* -------------------------------------------------------------------------- */

const siteOrigin =
  Astro.site?.toString() ??
  Astro.url.origin;

const canonicalUrl = new URL(
  `/waste/${encodeURIComponent(material.id)}`,
  siteOrigin,
).toString();

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `${material.label} — BINSIGHT`,
  description: material.description,
  url: canonicalUrl,
  about: {
    "@type": "Thing",
    name: material.label,
  },
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: siteOrigin,
  },
};
---

<PublicLayout
  title={`${material.label} — Jenis Sampah | BINSIGHT`}
  description={material.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema)}
  />

  <main class="waste-detail">
    <!-- ================================================================
         INTRO
    ================================================================= -->
    <section class="waste-detail__intro">
      <div class="waste-container">
        <nav
          class="detail-breadcrumb"
          aria-label="Breadcrumb"
        >
          <a href="/">Beranda</a>
          <ChevronRight
            size={13}
            stroke-width={2}
            aria-hidden="true"
          />
          <a href="/waste">Jenis Sampah</a>
          <ChevronRight
            size={13}
            stroke-width={2}
            aria-hidden="true"
          />
          <span>{material.label}</span>
        </nav>

        <div class="detail-hero">
          <div
            class="detail-hero__mark"
            style={`--category-color:${categoryColor};--category-soft:${categorySoftColor};`}
          >
            <Recycle
              size={30}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </div>

          <div class="detail-hero__content">
            <div class="detail-hero__meta">
              <span class="detail-label">
                WASTE / DETAIL
              </span>

              <span class="detail-divider"></span>

              <span class="detail-category">
                {categoryLabel}
              </span>

              <span class="detail-order">
                #{String(material.order).padStart(2, "0")}
              </span>
            </div>

            <h1>{material.label}</h1>

            <p>
              {material.description}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================
         CONTENT
    ================================================================= -->
    <section class="waste-detail__content">
      <div class="waste-container">
        <div class="waste-detail__layout">
          <div class="waste-detail__main">
            <!-- ABOUT -->
            <section class="detail-card">
              <header class="detail-card__header">
                <div>
                  <span class="section-kicker">
                    01 / MATERIAL
                  </span>

                  <h2>
                    Mengenal {material.label}
                  </h2>
                </div>

                <div class="detail-card__icon">
                  <Info
                    size={19}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>
              </header>

              <div class="detail-card__body">
                <p class="detail-card__lead">
                  {material.description}
                </p>

                <div class="detail-copy">
                  <p>
                    Material ini termasuk dalam kategori
                    <strong>{categoryLabel}</strong>
                    pada taksonomi persampahan BINSIGHT.
                  </p>

                  <p>
                    Karakteristik dan metode pengelolaan yang
                    tercantum di bawah digunakan sebagai referensi
                    untuk memahami material dan pendekatan
                    penanganannya.
                  </p>
                </div>
              </div>
            </section>

            <!-- CHARACTERISTICS -->
            <section class="detail-card">
              <header class="detail-card__header">
                <div>
                  <span class="section-kicker">
                    02 / CHARACTERISTICS
                  </span>

                  <h2>
                    Karakteristik material
                  </h2>
                </div>

                <div class="detail-card__icon">
                  <Check
                    size={19}
                    stroke-width={2.1}
                    aria-hidden="true"
                  />
                </div>
              </header>

              <div class="detail-card__body">
                {
                  characteristics.length > 0 ? (
                    <div class="characteristic-grid">
                      {characteristics.map(
                        (characteristic: string) => (
                          <div class="characteristic-item">
                            <span class="characteristic-item__icon">
                              <Check
                                size={14}
                                stroke-width={2.5}
                                aria-hidden="true"
                              />
                            </span>

                            <span>
                              {characteristic}
                            </span>
                          </div>
                        ),
                      )}
                    </div>
                  ) : (
                    <div class="empty-state">
                      Belum ada karakteristik yang
                      tercatat untuk material ini.
                    </div>
                  )
                }
              </div>
            </section>

            <!-- METHODS -->
            <section class="detail-card">
              <header class="detail-card__header">
                <div>
                  <span class="section-kicker">
                    03 / MANAGEMENT
                  </span>

                  <h2>
                    Metode pengelolaan
                  </h2>
                </div>

                <div class="detail-card__icon">
                  <Recycle
                    size={19}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </header>

              <div class="detail-card__body">
                {
                  methods.length > 0 ? (
                    <div class="method-list">
                      {methods.map(
                        (
                          method: string,
                          index: number,
                        ) => (
                          <article class="method-item">
                            <div class="method-item__number">
                              {String(index + 1).padStart(
                                2,
                                "0",
                              )}
                            </div>

                            <div class="method-item__content">
                              <strong>
                                {method}
                              </strong>

                              <p>
                                Pendekatan yang
                                direkomendasikan dalam
                                penanganan material{" "}
                                {material.label.toLowerCase()}.
                              </p>
                            </div>

                            <div class="method-item__check">
                              <Check
                                size={15}
                                stroke-width={2.4}
                                aria-hidden="true"
                              />
                            </div>
                          </article>
                        ),
                      )}
                    </div>
                  ) : (
                    <div class="empty-state">
                      Belum ada metode pengelolaan yang
                      tercatat untuk material ini.
                    </div>
                  )
                }
              </div>
            </section>

            <!-- RELATED -->
            <section class="detail-card">
              <header class="detail-card__header">
                <div>
                  <span class="section-kicker">
                    04 / RELATED
                  </span>

                  <h2>
                    Material lain dalam {categoryLabel}
                  </h2>
                </div>

                <div class="detail-card__icon">
                  <Package
                    size={19}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </header>

              <div class="detail-card__body">
                {
                  relatedMaterials.length > 0 ? (
                    <div class="related-list">
                      {relatedMaterials.map(
                        (
                          related: WasteMaterialDefinition,
                        ) => (
                          <a
                            href={`/waste/${encodeURIComponent(
                              related.id,
                            )}`}
                            class="related-item"
                          >
                            <div
                              class="related-item__mark"
                              style={`--related-color:${categoryColor};--related-soft:${categorySoftColor};`}
                            >
                              <Recycle
                                size={17}
                                stroke-width={1.9}
                                aria-hidden="true"
                              />
                            </div>

                            <div class="related-item__content">
                              <strong>
                                {related.label}
                              </strong>

                              <span>
                                {related.description}
                              </span>
                            </div>

                            <ArrowRight
                              size={16}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          </a>
                        ),
                      )}
                    </div>
                  ) : (
                    <div class="empty-state">
                      Material lain dalam kategori ini
                      belum tersedia.
                    </div>
                  )
                }

                <a
                  href={`/waste#${material.category}`}
                  class="category-link"
                >
                  <span>
                    Lihat semua material {categoryLabel}
                  </span>

                  <ArrowRight
                    size={15}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>
              </div>
            </section>
          </div>

          <!-- ==========================================================
               SIDEBAR
          =========================================================== -->
          <aside class="waste-detail__sidebar">
            <!-- CATEGORY -->
            <section
              class="category-card"
              style={`--category-color:${categoryColor};--category-soft:${categorySoftColor};`}
            >
              <div class="category-card__top">
                <div class="category-card__mark">
                  <Recycle
                    size={21}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>

                <span>
                  CATEGORY
                </span>
              </div>

              <h2>
                {categoryLabel}
              </h2>

              {
                category?.description && (
                  <p>
                    {category.description}
                  </p>
                )
              }

              <a
                href={`/waste#${material.category}`}
                class="category-card__link"
              >
                <span>Jelajahi kategori</span>

                <ArrowRight
                  size={15}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
            </section>

            <!-- SUMMARY -->
            <section class="side-card">
              <header class="side-card__header">
                <span class="side-card__index">
                  01
                </span>

                <h2>Ringkasan</h2>
              </header>

              <dl class="summary-list">
                <div>
                  <dt>Material</dt>
                  <dd>{material.label}</dd>
                </div>

                <div>
                  <dt>Kategori</dt>
                  <dd>{categoryLabel}</dd>
                </div>

                <div>
                  <dt>Karakteristik</dt>
                  <dd>{characteristics.length}</dd>
                </div>

                <div>
                  <dt>Metode</dt>
                  <dd>{methods.length}</dd>
                </div>
              </dl>
            </section>

            <!-- DATA NOTE -->
            <section class="side-card side-card--dark">
              <header class="side-card__header">
                <span class="side-card__index">
                  02
                </span>

                <h2>Data note</h2>
              </header>

              <div class="data-note__icon">
                <Info
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <p>
                Halaman ini menjelaskan taksonomi
                material. Informasi jumlah, volume,
                kapasitas, harga, jadwal, atau statistik
                operasional tidak ditampilkan tanpa
                sumber data aktual.
              </p>
            </section>

            <!-- NAVIGATION -->
            <section class="side-navigation">
              <span class="side-navigation__label">
                MATERIAL NAVIGATION
              </span>

              <a
                href={
                  previousMaterial
                    ? `/waste/${encodeURIComponent(
                        previousMaterial.id,
                      )}`
                    : "/waste"
                }
                class="side-navigation__item"
              >
                <span class="side-navigation__direction">
                  <ArrowLeft
                    size={14}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  Sebelumnya
                </span>

                <strong>
                  {previousMaterial?.label ??
                    "Daftar jenis sampah"}
                </strong>
              </a>

              <div class="side-navigation__divider"></div>

              <a
                href={
                  nextMaterial
                    ? `/waste/${encodeURIComponent(
                        nextMaterial.id,
                      )}`
                    : "/waste"
                }
                class="side-navigation__item side-navigation__item--next"
              >
                <span class="side-navigation__direction">
                  Berikutnya

                  <ArrowRight
                    size={14}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </span>

                <strong>
                  {nextMaterial?.label ??
                    "Daftar jenis sampah"}
                </strong>
              </a>
            </section>
          </aside>
        </div>

        <!-- BOTTOM NAV -->
        <nav
          class="detail-bottom-nav"
          aria-label="Navigasi jenis sampah"
        >
          <a href="/waste">
            <ArrowLeft
              size={15}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Kembali ke semua jenis sampah
            </span>
          </a>

          <span class="detail-bottom-nav__current">
            {material.label}
          </span>
        </nav>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  .waste-detail {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --orange: #ff6a00;

    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
  }

  .waste-detail *,
  .waste-detail *::before,
  .waste-detail *::after {
    box-sizing: border-box;
  }

  .waste-detail a {
    -webkit-tap-highlight-color: transparent;
  }

  .waste-container {
    width: min(1320px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* ================================================================
     INTRO
  ================================================================= */

  .waste-detail__intro {
    border-bottom: 2px solid var(--ink);
    background:
      radial-gradient(
        circle at 86% 10%,
        rgb(223 255 0 / 13%),
        transparent 25%
      ),
      var(--paper);
  }

  .detail-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    padding-top: 28px;
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .detail-breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .detail-breadcrumb a:hover {
    color: var(--ink);
  }

  .detail-breadcrumb svg {
    color: var(--orange);
    flex: 0 0 auto;
  }

  .detail-breadcrumb span {
    color: var(--ink);
  }

  .detail-hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding: 74px 0 82px;
  }

  .detail-hero__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 92px;
    height: 92px;
    border: 3px solid var(--ink);
    background: var(--category-soft);
    color: var(--category-color);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .detail-hero__content {
    min-width: 0;
  }

  .detail-hero__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .detail-label,
  .detail-category,
  .detail-order {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 4px 8px;
    border: 1px solid var(--paper-3);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .detail-label {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--acid);
  }

  .detail-category {
    color: var(--ink);
    background: var(--white);
  }

  .detail-order {
    color: var(--orange);
    background: transparent;
  }

  .detail-divider {
    width: 22px;
    height: 1px;
    background: var(--paper-3);
  }

  .detail-hero h1 {
    max-width: 1000px;
    margin: 20px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 800;
    letter-spacing: -0.075em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .detail-hero p {
    max-width: 850px;
    margin: 28px 0 0;
    color: #454a42;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.75;
  }

  /* ================================================================
     CONTENT
  ================================================================= */

  .waste-detail__content {
    padding: 64px 0 110px;
    border-bottom: 2px solid var(--ink);
    background: var(--paper-2);
  }

  .waste-detail__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 22px;
    align-items: start;
  }

  .waste-detail__main,
  .waste-detail__sidebar {
    display: grid;
    gap: 22px;
  }

  /* ================================================================
     MAIN CARDS
  ================================================================= */

  .detail-card {
    overflow: hidden;
    border: 2px solid var(--ink);
    background: var(--white);
    box-shadow: 6px 6px 0 rgb(9 10 8 / 9%);
  }

  .detail-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 26px;
    border-bottom: 2px solid var(--ink);
  }

  .section-kicker {
    display: block;
    color: var(--orange);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .detail-card__header h2 {
    margin: 11px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .detail-card__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 2px solid var(--ink);
    background: var(--acid);
    color: var(--ink);
  }

  .detail-card__body {
    padding: 28px 26px;
  }

  .detail-card__lead {
    max-width: 780px;
    margin: 0;
    color: #2e332c;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.78;
  }

  .detail-copy {
    display: grid;
    gap: 12px;
    max-width: 780px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--paper-3);
  }

  .detail-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .detail-copy strong {
    color: var(--ink);
  }

  /* ================================================================
     CHARACTERISTICS
  ================================================================= */

  .characteristic-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .characteristic-item {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 60px;
    padding: 12px 14px;
    border: 1px solid var(--paper-3);
    background: var(--paper);
  }

  .characteristic-item__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--ink);
    background: var(--acid);
    color: var(--ink);
  }

  .characteristic-item > span:last-child {
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 750;
    line-height: 1.45;
  }

  /* ================================================================
     METHODS
  ================================================================= */

  .method-list {
    display: grid;
    gap: 10px;
  }

  .method-item {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 34px;
    gap: 14px;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--paper-3);
    background: var(--paper);
  }

  .method-item__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 2px solid var(--ink);
    background: var(--white);
    color: var(--orange);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
