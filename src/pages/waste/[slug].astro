      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      color: var(--related-color);
      background: var(--related-soft);
      border-radius: 10px;
    }

    .related-material__content {
      display: grid;
      min-width: 0;
      gap: 3px;
    }

    .related-material__content strong {
      color: #334155;
      font-size: 12px;
      font-weight: 800;
    }

    .related-material__content span {
      overflow: hidden;
      color: #64748b;
      font-size: 10px;
      line-height: 1.5;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .related-material > svg {
      color: #94a3b8;
    }

    .category-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 15px;
      color: #166534;
      text-decoration: none;
      font-size: 11px;
      font-weight: 800;
    }

    .category-link:hover {
      text-decoration: underline;
    }

    .summary-card {
      padding: 20px;
      border-color: color-mix(
        in srgb,
        var(--category-color) 18%,
        #e2e8f0
      );
      background: linear-gradient(
        145deg,
        var(--category-soft),
        #ffffff 72%
      );
    }

    .summary-card__icon {
      width: 48px;
      height: 48px;
