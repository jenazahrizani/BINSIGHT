---

/**

* ============================================================================
* BINSIGHT ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â WASTE DETAIL
* ============================================================================
* Public educational detail page for one waste material.
*
* Route:
* /waste/[slug]
*
* Source of truth:
* src/lib/constants/waste.ts
*
* The taxonomy contains:
* * Waste categories
* * Waste materials
* * Characteristics
* * Recommended management methods
*
* This page intentionally does NOT invent live quantities, prices, capacity,
* collection schedules, or organization statistics.
* ============================================================================
  */

import {
ArrowLeft,
ArrowRight,
Check,
ChevronRight,
Info,
Package,
Recycle,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";

import {
WASTE_MATERIALS,
WASTE_CATEGORIES,
getWasteCategoryLabel,
getWasteCharacteristicLabel,
getWasteMethodLabel,
type WasteCategory,
type WasteMaterialDefinition,
} from "@lib/constants/waste";

/* -------------------------------------------------------------------------- */
/* Route generation                                                           */
/* -------------------------------------------------------------------------- */

export function getStaticPaths() {
return WASTE_MATERIALS.map(
(material: WasteMaterialDefinition) => ({
params: {
slug: material.id,
},
}),
);
}

/* -------------------------------------------------------------------------- */
/* Route resolution                                                           */
/* -------------------------------------------------------------------------- */

const requestedSlug =
Astro.params.slug?.trim().toLowerCase() ?? "";

const material =
WASTE_MATERIALS.find(
(item: WasteMaterialDefinition) =>
item.id.toLowerCase() === requestedSlug,
) ?? null;

if (!material) {
return Astro.redirect("/waste", 302);
}

/* -------------------------------------------------------------------------- */
/* Derived data                                                               */
/* -------------------------------------------------------------------------- */

const category = WASTE_CATEGORIES.find(
(item) =>
item.id === material.category,
);

const categoryLabel =
category?.label ??
getWasteCategoryLabel(material.category);

const characteristics =
material.characteristics.map(
(characteristic) =>
getWasteCharacteristicLabel(
characteristic,
),
);

const methods =
material.recommendedMethods.map(
(method) =>
getWasteMethodLabel(method),
);

const categoryMaterials =
WASTE_MATERIALS
.filter(
(item: WasteMaterialDefinition) =>
item.category === material.category,
)
.sort(
(
first: WasteMaterialDefinition,
second: WasteMaterialDefinition,
) => first.order - second.order,
);

const relatedMaterials =
categoryMaterials
.filter(
(item: WasteMaterialDefinition) =>
item.id !== material.id,
)
.slice(0, 4);

const materialIndex =
WASTE_MATERIALS.findIndex(
(item: WasteMaterialDefinition) =>
item.id === material.id,
);

const previousMaterial =
materialIndex > 0
? WASTE_MATERIALS[materialIndex - 1]
: null;

const nextMaterial =
materialIndex >= 0 &&
materialIndex < WASTE_MATERIALS.length - 1
? WASTE_MATERIALS[materialIndex + 1]
: null;

const breadcrumbs = [
{
label: "Beranda",
href: "/",
},
{
label: "Jenis Sampah",
href: "/waste",
},
{
label: material.label,
},
];

/* -------------------------------------------------------------------------- */
/* Structured data                                                            */
/* -------------------------------------------------------------------------- */

const siteOrigin =
Astro.site?.toString() ??
Astro.url.origin;

const canonicalUrl = new URL(
`/waste/${encodeURIComponent(material.id)}`,
siteOrigin,
).toString();

const schema = {
"@context": "https://schema.org",
"@type": "Article",
headline: `${material.label} ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â BINSIGHT`,
description: material.description,
url: canonicalUrl,
about: {
"@type": "Thing",
name: material.label,
},
};

---

<PublicLayout
title={`${material.label} ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â Jenis Sampah | BINSIGHT`}
description={material.description}

>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema)}
  ></script>

<PageHeader
 eyebrow={categoryLabel}
 title={material.label}
 description={material.description}
 icon="waste"
 tone="green"
 breadcrumbs={breadcrumbs}
/>

  <main class="waste-detail">
    <section class="waste-detail__container">
<div class="waste-detail__back">
    <a href="/waste">
      <ArrowLeft
        size={16}
        stroke-width={1.9}
        aria-hidden="true"
      />
      Kembali ke jenis sampah
    </a>
  </div>

  <div
    class="waste-detail__hero"
    style={`--category-color:${category?.color ?? "#16A34A"};--category-soft:${category?.softColor ?? "#DCFCE7"};`}
  >
    <div class="waste-detail__hero-icon">
      <Recycle size={20} stroke-width={1.9} aria-hidden="true" />
    </div>

    <div class="waste-detail__hero-content">

      <div class="waste-detail__chips">
        <span class="waste-detail__category">
          <Recycle size={20} stroke-width={1.9} aria-hidden="true" />
          {categoryLabel}
        </span>

        <span class="waste-detail__order">
          Material #{material.order}
        </span>
      </div>

      <h1>
        {material.label}
      </h1>

      <p>
        {material.description}
      </p>
    </div>
  </div>

  <div class="waste-detail__grid">

    <div class="waste-detail__main">

      <section class="detail-card">
        <div class="detail-card__header">
          <div>
            <span class="detail-card__eyebrow">
              Tentang material
            </span>

            <h2>
              Mengenal {material.label}
            </h2>
          </div>

          <span class="detail-card__icon">
            <Info
              size={20}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>
        </div>

        <div class="detail-card__body">
          <p class="detail-card__lead">
            {material.description}
          </p>

          <p class="detail-card__text">
            Material ini termasuk dalam kategori
            <strong>{categoryLabel}</strong>
            pada taksonomi persampahan BINSIGHT.
            Karakteristik dan metode pengelolaan di
            bawah menjadi referensi untuk memahami
            material sebelum menentukan penanganannya.
          </p>
        </div>
      </section>

      <section class="detail-card">
        <div class="detail-card__header">
          <div>
            <span class="detail-card__eyebrow">
              Karakteristik
            </span>

            <h2>
              Karakteristik material
            </h2>
          </div>

          <span class="detail-card__icon">
            <Check
              size={20}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>
        </div>

        <div class="detail-card__body">

          {
            characteristics.length > 0 ? (
              <div class="characteristic-grid">
                {
                  characteristics.map(
                    (characteristic: string) => (
                      <div class="characteristic-item">
                        <span class="characteristic-item__icon">
                          <Check
                            size={16}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        </span>

                        <span>
                          {characteristic}
                        </span>
                      </div>
                    ),
                  )
                }
              </div>
            ) : (
              <div class="detail-empty">
                Belum ada karakteristik yang
                tercatat untuk material ini.
              </div>
            )
          }

        </div>
      </section>

      <section class="detail-card">
        <div class="detail-card__header">
          <div>
            <span class="detail-card__eyebrow">
              Pengelolaan
            </span>

            <h2>
              Metode pengelolaan yang direkomendasikan
            </h2>
          </div>

          <span class="detail-card__icon">
            <Recycle
              size={20}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>
        </div>

        <div class="detail-card__body">

          {
            methods.length > 0 ? (
              <div class="method-list">
                {
                  methods.map(
                    (
                      method: string,
                      index: number,
                    ) => (
                      <div class="method-row">
                        <span class="method-row__number">
                          {index + 1}
                        </span>

                        <div class="method-row__content">
                          <strong>
                            {method}
                          </strong>

                          <span>
                            Tahapan yang direkomendasikan
                            dalam penanganan material
                            {material.label.toLowerCase()}.
                          </span>
                        </div>

                        <Check
                          size={17}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </div>
                    ),
                  )
                }
              </div>
            ) : (
              <div class="detail-empty">
                Belum ada metode pengelolaan yang
                tercatat untuk material ini.
              </div>
            )
          }

        </div>
      </section>

      <section class="detail-card">
        <div class="detail-card__header">
          <div>
            <span class="detail-card__eyebrow">
              Dalam kategori
            </span>

            <h2>
              Material lain dalam {categoryLabel}
            </h2>
          </div>

          <span class="detail-card__icon">
            <Package
              size={20}
              stroke-width={1.8}
              aria-hidden="true"
            />
          </span>
        </div>

        <div class="detail-card__body">

          {
            relatedMaterials.length > 0 ? (
              <div class="related-materials">
                {
                  relatedMaterials.map(
                    (
                      related: WasteMaterialDefinition,
                    ) => (
                      <a
                        href={`/waste/${encodeURIComponent(related.id)}`}
                        class:list={[
                          "related-material",
                          {
                            "related-material--current":
                              related.id === material.id,
                          },
                        ]}
                      >
                        <span
                          class="related-material__icon"
                          style={`--related-color:${category?.color ?? "#16A34A"};--related-soft:${category?.softColor ?? "#DCFCE7"};`}
                        >
                          <Recycle size={20} stroke-width={1.9} aria-hidden="true" />
                        </span>

                        <span class="related-material__content">
                          <strong>
                            {related.label}
                          </strong>

                          <span>
                            {related.description}
                          </span>
                        </span>

                        <ArrowRight
                          size={16}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </a>
                    ),
                  )
                }
              </div>
            ) : (
              <div class="detail-empty">
                Material lain dalam kategori ini
                belum tersedia.
              </div>
            )
          }

          <a
            href={`/waste#${material.category}`}
            class="category-link"
          >
            Lihat seluruh material {categoryLabel}
            <ArrowRight
              size={15}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </a>

        </div>
      </section>

    </div>

    <aside class="waste-detail__sidebar">

      <section
        class="summary-card"
        style={`--category-color:${category?.color ?? "#16A34A"};--category-soft:${category?.softColor ?? "#DCFCE7"};`}
      >
        <div class="summary-card__icon">
          <Recycle size={20} stroke-width={1.9} aria-hidden="true" />
        </div>

        <span class="summary-card__eyebrow">
          Kategori
        </span>

        <h2>
          {categoryLabel}
        </h2>

        {
          category?.description && (
            <p>
              {category.description}
            </p>
          )
        }

        <a
          href={`/waste#${material.category}`}
          class="summary-card__link"
        >
          Jelajahi kategori
          <ArrowRight
            size={15}
            stroke-width={1.9}
            aria-hidden="true"
          />
        </a>
      </section>

      <section class="sidebar-card">
        <div class="sidebar-card__header">
          <Recycle
            size={18}
            stroke-width={1.8}
            aria-hidden="true"
          />

          <h2>
            Ringkasan
          </h2>
        </div>

        <dl class="summary-list">

          <div>
            <dt>
              Material
            </dt>

            <dd>
              {material.label}
            </dd>
          </div>

          <div>
            <dt>
              Kategori
            </dt>

            <dd>
              {categoryLabel}
            </dd>
          </div>

          <div>
            <dt>
              Karakteristik
            </dt>

            <dd>
              {characteristics.length}
            </dd>
          </div>

          <div>
            <dt>
              Metode pengelolaan
            </dt>

            <dd>
              {methods.length}
            </dd>
          </div>

        </dl>
      </section>

      <section class="sidebar-card sidebar-card--green">
        <div class="sidebar-card__header">
          <Info
            size={18}
            stroke-width={1.8}
            aria-hidden="true"
          />

          <h2>
            Catatan data
          </h2>
        </div>

        <p>
          Halaman ini menjelaskan taksonomi material.
          Informasi jumlah, volume, kapasitas, atau
          statistik operasional tidak ditampilkan tanpa
          sumber data aktual.
        </p>
      </section>

      <section class="navigation-card">
        <a
          href={
            previousMaterial
              ? `/waste/${encodeURIComponent(previousMaterial.id)}`
              : "/waste"
          }
          class="navigation-card__item"
        >
          <span class="navigation-card__direction">
            <ArrowLeft
              size={15}
              stroke-width={1.9}
              aria-hidden="true"
            />
            Sebelumnya
          </span>

          <strong>
            {previousMaterial?.label ??
              "Daftar jenis sampah"}
          </strong>
        </a>

        <div class="navigation-card__divider"></div>

        <a
          href={
            nextMaterial
              ? `/waste/${encodeURIComponent(nextMaterial.id)}`
              : "/waste"
          }
          class="navigation-card__item navigation-card__item--next"
        >
          <span class="navigation-card__direction">
            Berikutnya
            <ArrowRight
              size={15}
              stroke-width={1.9}
              aria-hidden="true"
            />
          </span>

          <strong>
            {nextMaterial?.label ??
              "Daftar jenis sampah"}
          </strong>
        </a>
      </section>

    </aside>

  </div>

  <nav
    class="waste-breadcrumb-nav"
    aria-label="Navigasi halaman"
  >
    <a href="/waste">
      <ArrowLeft
        size={15}
        stroke-width={1.9}
        aria-hidden="true"
      />
      Semua jenis sampah
    </a>

    <ChevronRight
      size={14}
      stroke-width={1.8}
      aria-hidden="true"
    />

    <span>
      {material.label}
    </span>
  </nav>

</section>
</main>

  <style>
