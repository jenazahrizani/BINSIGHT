      background: #f8fafc;
      padding: 0 0 82px;
    }

    .waste-detail__container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    .waste-detail__back {
      margin-top: -8px;
      position: relative;
      z-index: 3;
    }

    .waste-detail__back a,
    .waste-breadcrumb-nav a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #64748b;
      text-decoration: none;
      font-size: 12px;
      font-weight: 750;
      transition: color 160ms ease;
    }

    .waste-detail__back a:hover,
    .waste-breadcrumb-nav a:hover {
