      color:
        var(--ink-soft);

      font-size:
        12px;

      line-height:
        1.75;
    }


    .principle-row__mark {

      color:
        var(--green);
    }


    /* =====================================================
       ECOSYSTEM
    ====================================================== */

    .ecosystem {

      padding:
        122px
        0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--paper);
    }


    .section-intro--ecosystem,
    .section-intro--materials {

      align-items:
        end;
    }


    .section-intro--ecosystem
      > div:nth-child(2),
    .section-intro--materials
      > div:nth-child(2) {

      align-self:
        start;
    }


    .organization-list {

      border-top:
        1px solid
        var(--ink);
    }


    .organization-list__header,
    .organization-row {

      display:
        grid;

      grid-template-columns:
        48px
        minmax(
          0,
          1.3fr
        )
        140px
        120px
        145px
        24px;

      align-items:
        center;

      gap:
        16px;
    }


    .organization-list__header {

      min-height:
        47px;

      color:
        var(--muted);

      font-family:
        "DM Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.08em;

      text-transform:
        uppercase;
    }


    .organization-row {

      min-height:
        88px;

      border-top:
        1px solid
        var(--line);

      transition:
        background
        160ms ease,
        padding
        160ms ease;
    }


    .organization-row:hover {

      padding:
        0 10px;

      background:
        var(--surface-green);
    }


    .organization-row__number {

      color:
        var(--muted);

      font-family:
        "DM Mono",
        monospace;

      font-size:
        8px;
    }


    .organization-row__name {

      display:
        flex;

      flex-direction:
        column;

      gap:
        4px;

      min-width:
        0;
    }


    .organization-row__name strong {

      overflow:
        hidden;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      font-size:
        14px;

      font-weight:
        800;
    }


    .organization-row__name small,
    .organization-row__type,
    .organization-row__area {

      color:
        var(--muted);

      font-family:
        "DM Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.05em;

      text-transform:
        uppercase;
    }


    .organization-row__status {

      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      width:
        fit-content;

      min-height:
        28px;

      padding:
        0 8px;

      gap:
        5px;

      border:
        1px solid
        var(--line-strong);

      color:
        var(--muted);

      font-size:
        9px;

      font-weight:
        600;

      white-space:
        nowrap;
    }


    .organization-row__status.is-verified {

      border-color:
        #97b49f;

      background:
        #ecf4ed;

      color:
        var(--forest);
    }


    .organization-row__arrow {

      color:
        var(--muted);
    }


    .organization-row:hover
      .organization-row__arrow {

      color:
        var(--forest);
    }


    .data-note {

      margin:
        14px 0
        0;

      color:
        var(--muted);

      font-size:
        10px;

      line-height:
        1.7;
    }


    .text-link {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      margin-top:
        15px;

      color:
        var(--forest);

      font-size:
        10px;

      font-weight:
        800;
    }


    .text-link:hover {

      color:
        var(--forest-dark);
    }


    /* =====================================================
       MATERIALS
    ====================================================== */

    .materials {

      padding:
        122px
        0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--surface);
    }


    .material-list {

      border-top:
        1px solid
        var(--ink);
    }


    .material-row {

      display:
        grid;

      grid-template-columns:
        48px
        minmax(
          200px,
          0.55fr
        )
        minmax(
          300px,
          1fr
        )
        36px;

      align-items:
        center;

      gap:
        20px;

      min-height:
        108px;

      border-bottom:
        1px solid
        var(--line);

      transition:
        background
        160ms ease,
        padding
        160ms ease;
    }


    .material-row:hover {

      padding:
        0 10px;

      background:
        var(--surface-green);
    }


    .material-row__number {

      color:
        var(--muted);

      font-family:
        "DM Mono",
        monospace;

      font-size:
        8px;
    }


    .material-row__name h3 {

      margin:
        0;

      font-size:
        19px;

      font-weight:
        800;

      letter-spacing:
        -0.035em;
    }


    .material-row__description {

      margin:
        0;

      color:
        var(--ink-soft);

      font-size:
        12px;

      line-height:
        1.72;
    }


    .material-row__arrow {

      display:
        grid;

      width:
        34px;

      height:
        34px;

      place-items:
        center;

      justify-self:
        end;

      border:
        1px solid
        var(--line);

      color:
        var(--muted);
    }


    .material-row:hover
      .material-row__arrow {

      border-color:
        var(--forest);

      background:
        var(--forest);

      color:
        #ffffff;
    }


    /* =====================================================
       SUMMARY
    ====================================================== */

    .summary {

      padding:
        95px
        0;

      background:
        var(--forest-dark);

      color:
        #ffffff;
    }


    .summary__box {

      display:
        grid;

      grid-template-columns:
        minmax(
          280px,
          0.65fr
        )
        minmax(
          0,
          1.35fr
        );

      gap:
        80px;

      align-items:
        center;
    }


    .summary__title span {

      color:
        #9bc0a5;

      font-family:
        "DM Mono",
        monospace;

      font-size:
        8px;

      letter-spacing:
        0.08em;
    }


    .summary__title h2 {

      max-width:
        520px;

      margin:
        13px 0 0;

      color:
        #ffffff;

      font-size:
        clamp(
          42px,
          4.5vw,
          66px
        );

      font-weight:
        800;

      line-height:
        0.97;

      letter-spacing:
        -0.065em;
    }


    .summary__columns {

      display:
        grid;

      grid-template-columns:
        repeat(
          3,
          minmax(
            0,
            1fr
          )
        );

      border-top:
        1px solid
        #416550;

      border-bottom:
        1px solid
        #416550;
    }


    .summary__columns > div {

      min-height:
        205px;

      padding:
        21px 18px;

      border-right:
        1px solid
        #416550;
    }


    .summary__columns > div:last-child {

      border-right:
        0;
    }


    .summary__columns > div > span {

      color:
        #819b88;

      font-family:
        "DM Mono",
        monospace;

      font-size:
        8px;
    }


    .summary__columns strong {

      display:
        block;

      margin-top:
        55px;

      color:
        #ffffff;

      font-size:
        13px;

      letter-spacing:
        0.04em;
    }


    .summary__columns p {

      max-width:
        170px;

      margin:
        8px 0 0;

      color:
        #b5c5ba;

      font-size:
        11px;

      line-height:
        1.7;
    }


    /* =====================================================
       FOOTER
    ====================================================== */

    .footer {

      background:
        #e8ede8;
    }


    .footer__top {

      display:
        grid;

      grid-template-columns:
        minmax(
          0,
          1fr
        )
        minmax(
          350px,
          0.7fr
        );

      gap:
        85px;

      padding:
        70px
        0
        56px;
    }


    .footer__brand p {

      max-width:
        440px;

      margin:
        21px 0
        0;

      color:
        var(--ink-soft);

      font-size:
        12px;

      line-height:
        1.8;
    }


    .footer__links {

      display:
        grid;

      grid-template-columns:
        1fr
        1fr;

      gap:
        45px;
    }


    .footer__links > div {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        flex-start;

      gap:
        8px;
    }


    .footer__links small {

      margin-bottom:
        9px;

      color:
        var(--muted);

      font-family:
        "DM Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.08em;
    }


    .footer__links a {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

      font-size:
        11px;

      font-weight:
        700;
    }


    .footer__links a:hover {

      color:
        var(--forest);
    }


    .footer__links span {

      color:
        #68786d;

      font-family:
        "DM Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.05em;
    }


    .footer__bottom {

      min-height:
        58px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        20px;

      border-top:
        1px solid
        var(--line-strong);

      color:
        var(--muted);

      font-family:
        "DM Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.07em;
    }


    /* =====================================================
       FLOATING REPORT
    ====================================================== */

    .floating-report {

      position:
        fixed;

      right:
        22px;

      bottom:
        22px;

      z-index:
        200;

      display:
        grid;

      grid-template-columns:
        43px
        minmax(
          100px,
          1fr
        )
        31px;

      align-items:
        center;

      gap:
        9px;

      width:
        225px;

      min-height:
        64px;

      padding:
        8px;

      background:
        var(--orange);

      color:
        #ffffff;

      border:
        1px solid
        var(--orange-dark);

      box-shadow:
        6px
        6px
        0
        rgba(
          35,
          43,
          37,
          0.14
        );

      transition:
        transform
        170ms ease,
        box-shadow
        170ms ease,
        background
        170ms ease;
    }


    .floating-report:hover {

      transform:
        translate(
          -2px,
          -3px
        );

      background:
        var(--orange-dark);

      box-shadow:
        8px
        9px
        0
        rgba(
          35,
          43,
          37,
          0.16
        );
    }


    .floating-report__icon {

      display:
        grid;

      width:
        43px;

      height:
        43px;

      place-items:
        center;

      background:
        var(--ink);

      color:
        var(--yellow-placeholder, #e7cf73);
    }


    .floating-report__text {

      display:
        flex;

      flex-direction:
        column;

      gap:
        3px;

      min-width:
        0;
    }


    .floating-report__text small {

      color:
        rgba(
          255,
          255,
          255,
          0.67
        );

      font-family:
        "DM Mono",
        monospace;

      font-size:
        6px;

      letter-spacing:
        0.08em;
    }


    .floating-report__text strong {

      color:
        #ffffff;

      font-size:
        11px;

      font-weight:
        800;
    }


    .floating-report__arrow {

      display:
        grid;

      width:
        31px;

      height:
        31px;

      place-items:
        center;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.25
        );

      background:
        rgba(
          255,
          255,
          255,
          0.12
        );
    }


    /* =====================================================
       FOCUS
    ====================================================== */

    :global(a:focus-visible),
    :global(button:focus-visible) {

      outline:
        3px solid
        rgba(
          198,
          91,
          61,
          0.38
        );

      outline-offset:
        4px;
    }


    /* =====================================================
       TABLET
    ====================================================== */

    @media (max-width: 1080px) {

      .main-nav {
        display:
          none;
      }


      .header__inner {

        grid-template-columns:
          minmax(
            0,
            1fr
          )
          auto;
      }


      .menu-toggle {
        display:
          grid;
      }


      .hero__inner {

        grid-template-columns:
          1fr;

        gap:
          50px;

        min-height:
          auto;

        padding:
          65px
          0;
      }


      .hero__right {

        max-width:
          720px;
      }


      .section-intro,
      .section-intro--services,
      .section-intro--ecosystem,
      .section-intro--materials {

        grid-template-columns:
          42px
          minmax(
            0,
            1fr
          )
          300px;

        gap:
          18px;
      }


      .about__grid {

        grid-template-columns:
          1fr
          0.7fr;

        gap:
          55px;
      }


      .service-row {

        grid-template-columns:
          46px
          56px
          minmax(
            0,
            0.8fr
          )
          minmax(
            220px,
            1fr
          )
          85px;
      }


      .organization-list__header,
      .organization-row {

        grid-template-columns:
          42px
          minmax(
            0,
            1fr
          )
          110px
          95px
          125px
          20px;
      }


      .summary__box {

        grid-template-columns:
          1fr;

        gap:
          45px;
      }


      .footer__top {

        grid-template-columns:
          1fr
          0.8fr;
      }

    }


