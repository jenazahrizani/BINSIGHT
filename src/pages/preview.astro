      .organization-card__name {
        min-width: 0;
      }

      .organization-card__name h3 {
        margin: 0;
        color: var(--ink);
        font-family:
          Sora,
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
        font-size: 1.45rem;
        font-weight: 900;
        line-height: 0.95;
        letter-spacing: -0.055em;
        text-transform: uppercase;
      }

      .organization-card__name span {
        display: inline-block;
        margin-top: 0.45rem;
        padding: 4px 6px;
        color: var(--acid);
        background: var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
        line-height: 1;
        text-transform: uppercase;
      }

      .organization-card__verified {
        flex: 0 0 auto;
        padding: 5px 7px;
        color: var(--ink);
        background: var(--acid);
        border: 2px solid var(--ink);
        border-radius: 0;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: 0.07em;
        line-height: 1;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .organization-card__description {
        display: -webkit-box;
        overflow: hidden;
        margin: 0.85rem 0 0;
        color: var(--muted);
        font-size: 0.78rem;
        line-height: 1.65;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
