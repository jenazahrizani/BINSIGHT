      .header__inner {

        min-height:
          68px;

        gap:
          10px;
      }


      .brand__mark {

        width:
          36px;

        height:
          36px;
      }


      .brand__text strong {

        font-size:
          14px;
      }


      .brand__text small {

        display:
          none;
      }


      .search-link {

        display:
          none;
      }


