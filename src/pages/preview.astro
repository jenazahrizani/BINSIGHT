<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
    />

    <title>BINSIGHT — Badung Waste Intelligence</title>

    <link
      rel="icon"
      href={siteHref("/favicon.svg")}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&family=Sora:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ==========================================================================
         BINSIGHT // BRUTALIST SYSTEM
         Hard edges. Loud hierarchy. Zero decoration for decoration's sake.
         ========================================================================== */

      .home {
        --acid: #dfff00;
        --acid-soft: #efff70;
        --ink: #090a08;
        --ink-2: #11130f;
        --ink-3: #1b1f18;
        --paper: #f2f0e6;
        --paper-2: #e4e1d4;
        --paper-3: #cfcabd;
        --white: #fffef8;
        --muted: #6c7068;
        --line: #090a08;
        --warning: #ff6a00;

        width: 100%;
        min-width: 0;
        overflow: clip;
        color: var(--ink);
        background: var(--paper);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: geometricPrecision;
      }

      .home *,
      .home *::before,
      .home *::after {
        box-sizing: border-box;
      }

      .home a {
        -webkit-tap-highlight-color: transparent;
      }

      .home-container {
        width: min(1320px, calc(100% - 40px));
        margin: 0 auto;
      }

      /* ==========================================================================
         GLOBAL BRUTALIST TEXTURE
         ========================================================================== */

      .hero,
      .section--black,
      .map-cta {
        isolation: isolate;
      }

      .hero::before,
      .section--black::before,
      .map-cta::before {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        content: "";
        background-image:
          linear-gradient(
            rgba(255, 255, 255, 0.045) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.045) 1px,
            transparent 1px
          );
        background-size: 24px 24px;
        opacity: 0.32;
      }

      .section--paper {
        position: relative;
        background:
          repeating-linear-gradient(
            135deg,
            rgba(9, 10, 8, 0.025) 0 1px,
            transparent 1px 9px
          ),
          var(--paper);
      }

      .section--sand {
        position: relative;
        background:
          repeating-linear-gradient(
            0deg,
            rgba(9, 10, 8, 0.03) 0 1px,
            transparent 1px 7px
          ),
          var(--paper-2);
      }

      .section--black {
        position: relative;
        background: var(--ink);
        color: var(--white);
      }

      /* ==========================================================================
         HERO
         ========================================================================== */

      .hero {
        position: relative;
        min-height: 860px;
        overflow: hidden;
        color: var(--white);
        background: var(--ink);
        border-bottom: 10px solid var(--acid);
      }

      .hero__grid {
        position: absolute;
        inset: 0;
        opacity: 0.16;
        pointer-events: none;
        background:
          linear-gradient(
            rgba(255, 255, 255, 0.09) 2px,
            transparent 2px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.09) 2px,
            transparent 2px
          );
        background-size: 72px 72px;
        mask-image: linear-gradient(
          to right,
          transparent,
          black 6%,
          black 94%,
          transparent
        );
        -webkit-mask-image: linear-gradient(
          to right,
          transparent,
          black 6%,
          black 94%,
          transparent
        );
      }

      .hero__glow {
        position: absolute;
        pointer-events: none;
        border-radius: 0;
        filter: none;
      }

      .hero__glow--one {
        width: 420px;
        height: 420px;
        top: -120px;
        right: -70px;
        background: var(--acid);
        opacity: 0.92;
        clip-path: polygon(
          0 12%,
          84% 0,
          100% 76%,
          30% 100%
        );
        mix-blend-mode: screen;
      }

      .hero__glow--two {
        width: 360px;
        height: 260px;
        bottom: -160px;
        left: 12%;
        background: var(--warning);
        opacity: 0.5;
        transform: rotate(-7deg);
      }

      .hero__inner {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns:
          minmax(0, 1.1fr)
          minmax(440px, 0.9fr);
        align-items: center;
        gap: 48px;
        min-height: 805px;
        padding: 60px 0 84px;
      }

      .hero__left {
        min-width: 0;
      }

      /* ==========================================================================
         EYEBROW
         ========================================================================== */

      .eyebrow {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 8px 10px;
        color: var(--ink);
        background: var(--acid);
        border: 3px solid var(--ink);
        box-shadow: 8px 8px 0 var(--white);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .eyebrow__dot {
        width: 9px;
        height: 9px;
        flex: 0 0 auto;
        border: 2px solid var(--ink);
        border-radius: 0;
        background: var(--warning);
        box-shadow: none;
      }

      .eyebrow__line {
        width: 26px;
        height: 2px;
        background: var(--ink);
      }

      /* ==========================================================================
         HERO TITLE
         ========================================================================== */

      .hero__title {
        display: flex;
        flex-direction: column;
        margin: 42px 0 0;
        color: var(--white);
        font-family:
          Sora,
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
        font-size: clamp(86px, 10.8vw, 168px);
        font-weight: 900;
        line-height: 0.76;
        letter-spacing: -0.095em;
        text-transform: uppercase;
      }

      .hero__title span {
        display: block;
        width: max-content;
        max-width: 100%;
      }

      .hero__title--outline {
        color: transparent;
        -webkit-text-stroke: 3px var(--white);
        text-stroke: 3px var(--white);
        transform: translateX(4vw);
      }

      .hero__title--lime {
        color: var(--acid);
        transform: translateX(-1vw);
      }

      .hero__accent {
        width: 160px;
        height: 15px;
        margin-top: 38px;
        background: var(--acid);
        border: 3px solid var(--white);
        box-shadow: 12px 12px 0 var(--warning);
      }

      .hero__description {
        max-width: 650px;
        margin: 34px 0 0;
        padding-left: 18px;
        color: #deded5;
        border-left: 8px solid var(--acid);
        font-size: 16px;
        font-weight: 500;
        line-height: 1.7;
      }

      .hero__description strong {
        color: var(--acid);
        font-weight: 900;
      }

      /* ==========================================================================
         BUTTONS
         ========================================================================== */

      .hero__actions,
      .map-cta__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 30px;
      }

      .button {
        min-height: 54px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 18px;
        border: 3px solid currentColor;
        border-radius: 0;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 0.035em;
        text-decoration: none;
        text-transform: uppercase;
        transition:
          transform 120ms steps(2, end),
          box-shadow 120ms steps(2, end),
          background 120ms linear;
      }

      .button:hover {
        transform: translate(-4px, -4px);
      }

      .button:focus-visible {
        outline: 4px solid var(--acid);
        outline-offset: 4px;
      }

      .button--lime {
        color: var(--ink);
        background: var(--acid);
        border-color: var(--ink);
        box-shadow: 8px 8px 0 var(--white);
      }

      .button--lime:hover {
        background: var(--acid-soft);
        box-shadow: 12px 12px 0 var(--warning);
      }

      .button--ghost {
        color: var(--white);
        background: transparent;
        border-color: var(--white);
        box-shadow: 8px 8px 0 rgba(255, 255, 255, 0.18);
      }

      .button--ghost:hover {
        color: var(--ink);
        background: var(--white);
        border-color: var(--white);
        box-shadow: 12px 12px 0 var(--acid);
      }

      /* ==========================================================================
         HERO METRICS
         ========================================================================== */

      .hero__metrics {
        display: flex;
        align-items: stretch;
        gap: 0;
        margin-top: 58px;
        border: 3px solid var(--white);
        background: var(--ink-2);
      }

      .metric {
        min-width: 150px;
        display: flex;
        flex-direction: column;
        gap: 7px;
        justify-content: center;
        padding: 16px 20px;
      }

      .metric strong {
        color: var(--acid);
        font-family:
          Sora,
          Inter,
          sans-serif;
        font-size: 38px;
        font-weight: 900;
        line-height: 0.9;
        letter-spacing: -0.06em;
      }

      .metric span {
        color: var(--white);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 800;
        line-height: 1.4;
        letter-spacing: 0.08em;
      }

      .metric__separator {
        width: 3px;
        flex: 0 0 3px;
        background: var(--white);
      }

      /* ==========================================================================
         HERO MAP
         ========================================================================== */

      .hero__right {
        position: relative;
        min-width: 0;
        min-height: 580px;
      }

      .map-window {
        position: absolute;
        inset: 0;
        overflow: hidden;
        border: 4px solid var(--white);
        border-radius: 0;
        background: var(--acid);
        box-shadow: 18px 18px 0 var(--warning);
        transform: rotate(1.3deg);
      }

      .map-window__top {
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 0 17px;
        color: var(--ink);
        background: var(--acid);
        border-bottom: 4px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .map-window__title {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--ink);
      }

      .live-dot {
        width: 10px;
        height: 10px;
        flex: 0 0 auto;
        border: 2px solid var(--ink);
        border-radius: 0;
        background: var(--warning);
        box-shadow: none;
      }

      .map-window__body {
        position: relative;
        min-height: 452px;
        overflow: hidden;
        background: #22281d;
      }

      .map-lines {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            rgba(223, 255, 0, 0.11) 2px,
            transparent 2px
          ),
          linear-gradient(
            90deg,
            rgba(223, 255, 0, 0.11) 2px,
            transparent 2px
          );
        background-size: 30px 30px;
      }

      .map-shape {
        position: absolute;
        border: 3px solid var(--acid);
        border-radius: 0;
        background: rgba(223, 255, 0, 0.03);
        box-shadow: none;
      }

      .map-shape--a {
        left: 8%;
        top: 16%;
        width: 64%;
        height: 35%;
        clip-path: polygon(
          9% 16%,
          30% 0,
          70% 7%,
          96% 31%,
          84% 82%,
          48% 100%,
          16% 89%,
          0 51%
        );
        transform: rotate(7deg);
      }

      .map-shape--b {
        right: -4%;
        bottom: 8%;
        width: 68%;
        height: 43%;
        clip-path: polygon(
          0 30%,
          24% 2%,
          70% 0,
          100% 26%,
          88% 76%,
          57% 100%,
          18% 82%
        );
        transform: rotate(-6deg);
      }

      .map-shape--c {
        right: 9%;
        top: 8%;
        width: 22%;
        height: 22%;
        border: 0;
        background: var(--warning);
        clip-path: polygon(
          50% 0,
          100% 28%,
          84% 100%,
          9% 76%,
          0 34%
        );
      }

      .map-road {
        position: absolute;
        height: 3px;
        background: var(--acid);
        transform-origin: left center;
      }

      .map-road--a {
        left: -4%;
        top: 55%;
        width: 110%;
        transform: rotate(-12deg);
      }

      .map-road--b {
        left: -2%;
        top: 73%;
        width: 104%;
        transform: rotate(16deg);
      }

      .map-road--c {
        left: 14%;
        top: 31%;
        width: 84%;
        transform: rotate(61deg);
      }

      .map-road--d {
        left: 18%;
        top: 46%;
        width: 68%;
        transform: rotate(-48deg);
      }

      .map-node {
        position: absolute;
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border: 3px solid var(--ink);
        border-radius: 0;
        background: var(--acid);
        box-shadow: 6px 6px 0 var(--ink);
      }

      .map-node span {
        width: 10px;
        height: 10px;
        border: 2px solid var(--ink);
        border-radius: 0;
        background: var(--warning);
        box-shadow: none;
      }

      .map-node--1 {
        left: 27%;
        top: 25%;
      }

      .map-node--2 {
        right: 27%;
        top: 35%;
      }

      .map-node--3 {
        right: 17%;
        bottom: 22%;
      }

      .map-node--4 {
        left: 20%;
        bottom: 18%;
      }

      .map-node--5 {
        left: 49%;
        top: 59%;
      }

      .map-place {
        position: absolute;
        color: var(--acid);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.12em;
        background: var(--ink);
        padding: 3px 5px;
      }

      .map-place--1 {
        left: 29%;
        top: 34%;
      }

      .map-place--2 {
        left: 56%;
        bottom: 32%;
      }

      .map-place--3 {
        right: 12%;
        top: 47%;
      }

      .map-compass {
        position: absolute;
        top: 18px;
        right: 18px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        color: var(--acid);
        background: var(--ink);
        padding: 5px 7px;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
      }

      .map-coordinates {
        position: absolute;
        right: 18px;
        bottom: 18px;
        color: var(--acid);
        background: var(--ink);
        padding: 6px 8px;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        line-height: 1.55;
        text-align: right;
      }

      .map-window__bottom {
        min-height: 66px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 0 17px;
        color: var(--white);
        background: var(--ink);
        border-top: 4px solid var(--ink);
      }

      .map-window__stat {
        display: inline-flex;
        align-items: baseline;
        gap: 10px;
      }

      .map-window__bottom span {
        color: var(--white);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .map-window__bottom strong {
        color: var(--acid);
        font-family:
          Sora,
          Inter,
          sans-serif;
        font-size: 26px;
        font-weight: 900;
      }

      .map-index {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--acid);
        white-space: nowrap;
        font-weight: 900;
      }

      .floating-label {
        position: absolute;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        color: var(--ink);
        background: var(--white);
        border: 3px solid var(--ink);
        box-shadow: 7px 7px 0 var(--warning);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .floating-label--top {
        top: -18px;
        right: -15px;
        transform: rotate(2deg);
      }

      .floating-label--top span {
        width: 8px;
        height: 8px;
        border: 2px solid var(--ink);
        border-radius: 0;
        background: var(--acid);
      }

      .floating-label--bottom {
        left: -18px;
        bottom: 32px;
        flex-direction: column;
        align-items: flex-start;
        gap: 1px;
        padding: 11px 13px;
        transform: rotate(-2deg);
      }

      .floating-label--bottom small {
        color: var(--muted);
        font-size: 7px;
      }

      .floating-label--bottom strong {
        color: var(--ink);
        font-family:
          Sora,
          Inter,
          sans-serif;
        font-size: 21px;
        font-weight: 900;
      }

      /* ==========================================================================
         HERO FOOTER
         ========================================================================== */

      .hero__footer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 4;
        border-top: 4px solid var(--white);
        background: var(--ink);
      }

      .hero__footer-inner {
        min-height: 54px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 20px;
        color: var(--white);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .hero__footer-inner > :last-child {
        text-align: right;
      }

      .hero__footer-inner > div {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--acid);
      }

      .hero__footer-inner b {
        color: var(--warning);
      }

      /* ==========================================================================
         SECTION FRAME
         ========================================================================== */

      .section {
        padding: 120px 0;
        border-bottom: 4px solid var(--ink);
      }

      .section-head {
        display: grid;
        grid-template-columns:
          minmax(0, 1fr)
          minmax(320px, 0.42fr);
        align-items: end;
        gap: 70px;
        margin-bottom: 54px;
      }

      .section-head h2 {
        max-width: 900px;
        margin: 0;
        font-family:
          Sora,
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
        font-size: clamp(48px, 6.6vw, 94px);
        font-weight: 900;
        line-height: 0.87;
        letter-spacing: -0.085em;
        text-transform: uppercase;
      }

      .section-head--dark h2 {
        color: var(--white);
      }

      .section-kicker {
        display: inline-block;
        margin-bottom: 18px;
        padding: 6px 8px;
        color: var(--white);
        background: var(--ink);
        border: 2px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .section-kicker--lime {
        color: var(--ink);
        background: var(--acid);
        border-color: var(--acid);
      }

      .section-side {
        padding-bottom: 0;
      }

      .section-side__line {
        width: 100%;
        height: 8px;
        margin-bottom: 18px;
        background: var(--ink);
      }

      .section-side__line--lime {
        background: var(--acid);
      }

      .section-side p {
        max-width: 500px;
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
      }

      .section-head--dark .section-side p {
        color: #c3c4ba;
      }

      .section-link {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-top: 18px;
        padding: 8px 10px;
        color: var(--ink);
        background: var(--acid);
        border: 2px solid var(--ink);
        box-shadow: 4px 4px 0 var(--ink);
        font-size: 10px;
        font-weight: 900;
        text-decoration: none;
        text-transform: uppercase;
        transition:
          transform 120ms steps(2, end),
          box-shadow 120ms steps(2, end);
      }

      .section-link:hover {
        gap: 12px;
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 var(--warning);
      }

      .section-link:focus-visible {
        outline: 3px solid var(--acid);
        outline-offset: 4px;
      }

      /* ==========================================================================
         DISCOVERY
         ========================================================================== */

      .discovery-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
      }

      .discovery-card {
        position: relative;
        min-height: 350px;
        display: flex;
        flex-direction: column;
        padding: 18px;
        color: var(--ink);
        background: var(--white);
        border: 4px solid var(--ink);
        border-radius: 0;
        box-shadow: 9px 9px 0 var(--ink);
        text-decoration: none;
        transition:
          transform 120ms steps(2, end),
          box-shadow 120ms steps(2, end),
          background 120ms linear;
      }

      .discovery-card:nth-child(2n) {
        transform: translateY(18px);
      }

      .discovery-card:nth-child(2n):hover {
        transform: translate(5px, 13px);
      }

      .discovery-card:hover {
        transform: translate(5px, -5px);
        background: var(--acid);
        box-shadow: 13px 13px 0 var(--warning);
      }

      .discovery-card:focus-visible {
        outline: 4px solid var(--acid);
        outline-offset: 5px;
      }

      .discovery-card__top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        color: var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .discovery-card__middle {
        width: 62px;
        height: 62px;
        display: grid;
        place-items: center;
        margin-top: 54px;
        color: var(--acid);
        background: var(--ink);
        border: 3px solid var(--ink);
        border-radius: 0;
        transform: rotate(-4deg);
      }

      .discovery-card:hover .discovery-card__middle {
        color: var(--ink);
        background: var(--white);
        transform: rotate(5deg) scale(1.08);
      }

      .discovery-card__content {
        margin-top: auto;
        padding-top: 28px;
      }

      .discovery-card__content h3 {
        margin: 0;
        font-family:
          Sora,
          Inter,
          sans-serif;
        font-size: 28px;
        font-weight: 900;
        line-height: 0.95;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .discovery-card__content p {
        margin: 13px 0 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.65;
      }

      .discovery-card:hover
        .discovery-card__content
        p {
        color: var(--ink);
      }

      .discovery-card__bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 24px;
        padding-top: 12px;
        border-top: 3px solid var(--ink);
        color: var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      /* ==========================================================================
         SYSTEM BAR
         ========================================================================== */

      .system-bar {
        position: relative;
        background: var(--acid);
        color: var(--ink);
        border-bottom: 4px solid var(--ink);
        border-top: 4px solid var(--ink);
      }

      .system-bar__inner {
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
      }

      .system-bar__brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .system-bar__brand span {
        width: 14px;
        height: 14px;
        display: block;
        background: var(--warning);
        border: 2px solid var(--ink);
      }

      .system-bar__formula {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 10px;
        font-weight: 900;
      }

      .system-bar__formula b {
        color: var(--warning);
      }

      .system-bar__formula strong {
        padding: 4px 6px;
        background: var(--ink);
        color: var(--acid);
      }

      /* ==========================================================================
         PILLARS
         ========================================================================== */

      .pillar-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .pillar-card {
        position: relative;
        display: grid;
        grid-template-columns: 52px 64px minmax(0, 1fr) 34px;
        gap: 16px;
        align-items: center;
        padding: 18px;
        color: var(--white);
        background: var(--ink-2);
        border: 3px solid var(--white);
        border-radius: 0;
        text-decoration: none;
        transition:
          transform 120ms steps(2, end),
          background 120ms linear,
          color 120ms linear,
          box-shadow 120ms steps(2, end);
      }

      .pillar-card:nth-child(2) {
        transform: translateX(34px);
      }

      .pillar-card:nth-child(3) {
        transform: translateX(10px);
      }

      .pillar-card:nth-child(4) {
        transform: translateX(48px);
      }

      .pillar-card:hover {
        color: var(--ink);
        background: var(--acid);
        border-color: var(--acid);
        transform: translateX(6px) translateY(-4px);
        box-shadow: 10px 10px 0 var(--warning);
      }

      .pillar-card:nth-child(2):hover,
      .pillar-card:nth-child(3):hover,
      .pillar-card:nth-child(4):hover {
        transform: translateX(6px) translateY(-4px);
      }

      .pillar-card__number {
        align-self: stretch;
        display: grid;
        place-items: center;
        min-height: 62px;
        color: var(--ink);
        background: var(--acid);
        border: 2px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 11px;
        font-weight: 900;
      }

      .pillar-card__icon {
        width: 64px;
        height: 64px;
        display: grid;
        place-items: center;
        color: var(--acid);
        border: 3px solid var(--acid);
        background: transparent;
      }

      .pillar-card:hover .pillar-card__icon {
        color: var(--ink);
        border-color: var(--ink);
      }

      .pillar-card__body > span {
        color: #9ca199;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .pillar-card:hover
        .pillar-card__body
        > span {
        color: var(--ink);
      }

      .pillar-card__body h3 {
        margin: 4px 0 0;
        font-family:
          Sora,
          Inter,
          sans-serif;
        font-size: 30px;
        font-weight: 900;
        line-height: 0.95;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .pillar-card__body p {
        max-width: 730px;
        margin: 9px 0 0;
        color: #c6c8c0;
        font-size: 11px;
        line-height: 1.6;
      }

      .pillar-card:hover
        .pillar-card__body
        p {
        color: var(--ink);
      }

      .pillar-card__arrow {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        color: var(--acid);
        border: 2px solid var(--acid);
        background: transparent;
      }

      .pillar-card:hover .pillar-card__arrow {
        color: var(--ink);
        border-color: var(--ink);
        background: var(--white);
      }

      /* ==========================================================================
         ORGANIZATIONS / WASTE
         ========================================================================== */

      .organization-grid,
      .waste-grid {
        display: grid;
        gap: 14px;
      }

      .organization-grid {
        grid-template-columns: repeat(
          3,
          minmax(0, 1fr)
        );
      }

      .waste-grid {
        grid-template-columns: repeat(
          5,
          minmax(0, 1fr)
        );
      }

      .organization-grid :global(*),
      .waste-grid :global(*) {
        border-radius: 0;
      }

      .organization-grid > *,
      .waste-grid > * {
        min-width: 0;
      }

      .organization-grid > * {
        border: 3px solid var(--ink);
        box-shadow: 7px 7px 0 var(--ink);
        background: var(--white);
      }

      .waste-item {
        position: relative;
        min-width: 0;
      }

      .waste-item__index {
        position: absolute;
        top: -10px;
        left: 10px;
        z-index: 2;
        min-width: 34px;
        padding: 5px 7px;
        color: var(--acid);
        background: var(--ink);
        border: 2px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
      }

      .waste-item__accent {
        position: absolute;
        right: -4px;
        bottom: -4px;
        z-index: 2;
        width: 58px;
        height: 58px;
        pointer-events: none;
        background: var(--warning);
        border: 3px solid var(--ink);
        clip-path: polygon(
          0 0,
          100% 0,
          100% 100%,
          24% 78%
        );
      }

      /* ==========================================================================
         MAP CTA
         ========================================================================== */

      .map-cta {
        position: relative;
        padding: 118px 0;
        color: var(--white);
        background: var(--ink);
        border-top: 10px solid var(--acid);
        border-bottom: 10px solid var(--acid);
      }

      .map-cta__inner {
        display: grid;
        grid-template-columns:
          minmax(0, 0.9fr)
          minmax(380px, 1.1fr);
        align-items: stretch;
        gap: 0;
      }

      .map-cta__content {
        position: relative;
        z-index: 2;
        padding: 58px 54px;
        color: var(--ink);
        background: var(--acid);
        border: 4px solid var(--white);
        box-shadow: 18px 18px 0 var(--warning);
      }

      .map-cta__content h2 {
        margin: 0;
        font-family:
          Sora,
          Inter,
          sans-serif;
        font-size: clamp(60px, 8vw, 110px);
        font-weight: 900;
        line-height: 0.78;
        letter-spacing: -0.09em;
        text-transform: uppercase;
      }

      .map-cta__content p {
        max-width: 560px;
        margin: 28px 0 0;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.7;
      }

      .map-cta__visual {
        position: relative;
        min-height: 520px;
        overflow: hidden;
        border: 4px solid var(--white);
        background: #20271e;
        transform: translate(-18px, 22px) rotate(-1.2deg);
      }

      .map-cta__grid {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            rgba(223, 255, 0, 0.13) 2px,
            transparent 2px
          ),
          linear-gradient(
            90deg,
            rgba(223, 255, 0, 0.13) 2px,
            transparent 2px
          );
        background-size: 34px 34px;
      }

      .map-cta__orbit {
        position: absolute;
        border: 4px solid var(--acid);
        border-radius: 0;
        transform: rotate(14deg);
      }

      .map-cta__orbit--1 {
        width: 70%;
        height: 42%;
        left: 7%;
        top: 16%;
      }

      .map-cta__orbit--2 {
        width: 62%;
        height: 34%;
        left: 17%;
        top: 25%;
        transform: rotate(-20deg);
      }

      .map-cta__orbit--3 {
        width: 34%;
        height: 26%;
        right: 7%;
        bottom: 7%;
        border-color: var(--warning);
        transform: rotate(8deg);
      }

      .map-cta__route {
        position: absolute;
        height: 5px;
        background: var(--acid);
      }

      .map-cta__route--1 {
        width: 90%;
        left: 5%;
        top: 30%;
        transform: rotate(17deg);
      }

      .map-cta__route--2 {
        width: 82%;
        left: 9%;
        top: 63%;
        transform: rotate(-11deg);
      }

      .map-cta__route--3 {
        width: 60%;
        left: 22%;
        top: 50%;
        transform: rotate(71deg);
        background: var(--warning);
      }

      .map-cta__marker {
        position: absolute;
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        color: var(--ink);
        background: var(--acid);
        border: 3px solid var(--ink);
        box-shadow: 6px 6px 0 var(--warning);
      }

      .map-cta__marker--1 {
        left: 18%;
        top: 25%;
      }

      .map-cta__marker--2 {
        right: 20%;
        top: 38%;
      }

      .map-cta__marker--3 {
        left: 45%;
        bottom: 18%;
      }

      .map-cta__coordinates {
        position: absolute;
        right: 22px;
        bottom: 22px;
        color: var(--acid);
        background: var(--ink);
        padding: 8px 10px;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 9px;
        font-weight: 900;
        text-align: right;
      }

      /* ==========================================================================
         REPORT
         ========================================================================== */

      .report-section {
        padding: 96px 0 112px;
        background:
          repeating-linear-gradient(
            90deg,
            rgba(9, 10, 8, 0.025) 0 2px,
            transparent 2px 14px
          ),
          var(--paper);
      }

      .report-box {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: 24px;
        padding: 30px;
        color: var(--white);
        background: var(--ink);
        border: 4px solid var(--ink);
        box-shadow: 16px 16px 0 var(--acid);
      }

      .report-box__content {
        display: flex;
        align-items: flex-start;
        gap: 24px;
        min-width: 0;
      }

      .report-box__icon {
        width: 68px;
        height: 68px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        color: var(--ink);
        background: var(--acid);
        border: 3px solid var(--white);
      }

      .report-box__content .section-kicker {
        margin-bottom: 12px;
