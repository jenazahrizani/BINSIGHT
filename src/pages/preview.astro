    .specimen__bottom {
      border-top:
        1px solid
        var(--line);
    }


    /* =========================================
       COMMON SECTION CODE
    ========================================== */

    .section-code {
      display:
        grid;

      grid-template-columns:
        38px
        auto
        minmax(
          20px,
          1fr
        );

      align-items:
        center;

      gap:
        11px;

      color:
        var(--muted);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.1em;

      text-transform:
        uppercase;
    }

    .section-code span:first-child {
      color:
        var(--rust);

      font-size:
        9px;
    }

    .section-code::after {
      height:
        1px;

      content:
        "";

      background:
        var(--line);
    }

    .section-code--light {
      color:
        #888a81;
    }

    .section-code--light::after {
      background:
        #3b3c37;
    }

    .section-code--light
      span:first-child {
      color:
        var(--rust-light);
    }

    .micro-label {
      margin:
        0;

      color:
        var(--muted);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.1em;

      text-transform:
        uppercase;
    }

    .micro-label--light {
      color:
        #888a81;
    }


    /* =========================================
       MANIFESTO
    ========================================== */

    .manifesto {
      padding:
        126px
        0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--paper-light);
    }

    .manifesto__layout {
      display:
        grid;

      grid-template-columns:
        55px
        minmax(
          0,
          1fr
        )
        minmax(
          280px,
          0.54fr
        );

      gap:
        58px;

      margin-top:
        65px;
    }

    .manifesto__number {
      color:
        #b9b0a1;

      font-family:
        "Bodoni Moda",
        Georgia,
        serif;

      font-size:
        82px;

      line-height:
        0.8;
    }

    .manifesto__headline {
      max-width:
        720px;
    }

    .manifesto__headline h2,
    .archive h2,
    .system h2,
    .principles h2,
    .directory h2,
    .materials h2,
    .context h2 {
      margin:
        14px 0
        0;

      font-family:
        "Bodoni Moda",
        Georgia,
        serif;

      font-size:
        clamp(
          54px,
          6.4vw,
          94px
        );

      font-weight:
        400;

      line-height:
        0.9;

      letter-spacing:
        -0.06em;
    }

    .manifesto__headline h2 span,
    .archive h2 span,
    .system h2 span,
    .principles h2 span,
    .directory h2 span,
    .materials h2 span,
    .context h2 span {
      display:
        block;

      color:
        var(--rust);

      font-style:
        italic;
    }

    .manifesto__copy {
      padding-top:
        52px;
    }

    .manifesto__lead {
      margin:
        0 0 18px;

      font-size:
        20px;

      font-weight:
        600;

      letter-spacing:
        -0.035em;
    }

    .manifesto__copy p:not(.manifesto__lead) {
      margin:
        0 0 17px;

      color:
        var(--ink-soft);

      font-size:
        13px;

      line-height:
        1.8;
    }

    .text-arrow {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      margin-top:
        8px;

      font-size:
        10px;

      font-weight:
        700;
    }

    .text-arrow span {
      display:
        grid;

      width:
        31px;

      height:
        31px;

      place-items:
        center;

      border:
        1px solid
        var(--line);
    }


    /* =========================================
       ARCHIVE
    ========================================== */

    .archive {
      padding:
        126px
        0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--paper);
    }

    .archive__header {
      display:
        grid;

      grid-template-columns:
        minmax(
          0,
          1fr
        )
        340px;

      gap:
        70px;

      margin:
        55px
        0
        58px;
    }

    .archive__header > p {
      align-self:
        end;

      margin:
        0;

      color:
        var(--ink-soft);

      font-size:
        13px;

      line-height:
        1.8;
    }

    .archive-list {
      border-top:
        1px solid
        var(--ink);
    }

    .archive-row {
      display:
        grid;

      grid-template-columns:
        58px
        62px
        minmax(
          0,
          1fr
        )
        120px;

      align-items:
        center;

      gap:
        18px;

      min-height:
        178px;

      border-bottom:
        1px solid
        var(--line);

      transition:
        background
        170ms ease,
        padding
        170ms ease;
    }

    .archive-row:hover {
      padding-left:
        15px;

      padding-right:
        15px;

      background:
        #e5dbca;
    }

    .archive-row__number {
      align-self:
        start;

      padding-top:
        28px;

      color:
        #a19a8e;

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        8px;
    }

    .archive-row__symbol {
      display:
        grid;

      width:
        50px;

      height:
        50px;

      place-items:
        center;

      border:
        1px solid
        var(--ink);

      background:
        var(--paper-light);

      color:
        var(--rust);
    }

    .archive-row__content small {
      color:
        var(--muted);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.09em;
    }

    .archive-row__content h3 {
      margin:
        7px 0
        7px;

      font-size:
        27px;

      font-weight:
        700;

      letter-spacing:
        -0.055em;
    }

    .archive-row__content p {
      max-width:
        650px;

      margin:
        0;

      color:
        var(--ink-soft);

      font-size:
        11px;

      line-height:
        1.72;
    }

    .archive-row__arrow {
      display:
        flex;

      align-items:
        center;

      justify-content:
        flex-end;

      gap:
        9px;

      color:
        var(--muted);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.08em;
    }

    .archive-row__arrow div {
      display:
        grid;

      width:
        38px;

      height:
        38px;

      place-items:
        center;

      border:
        1px solid
        var(--line);

      background:
        var(--paper-light);
    }

    .archive-row:hover
      .archive-row__arrow div {
      background:
        var(--rust);

      color:
        #fff;

      border-color:
        var(--rust);
    }


    /* =========================================
       SYSTEM
    ========================================== */

    .system {
      padding:
        122px
        0;

      border-bottom:
        1px solid
        #343631;

      background:
        var(--dark);

      color:
        #f5f1e8;
    }

    .system__header {
      display:
        grid;

      grid-template-columns:
        minmax(
          0,
          1fr
        )
        320px;

      gap:
        65px;

      margin:
        54px 0
        62px;
    }

    .system__aside {
      align-self:
        end;
    }

    .system__aside > span {
      display:
        block;

      color:
        #898b82;

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.1em;
    }

    .system__aside p {
      margin:
        10px 0 0;

      color:
        #aaa99e;

      font-size:
        12px;

      line-height:
        1.8;
    }

    .system h2 span {
      color:
        var(--rust-light);
    }

    .constellation {
      position:
        relative;

      min-height:
        530px;

      border:
        1px solid
        #363831;

      background:
        radial-gradient(
          circle at center,
          rgba(
            190,
            78,
            62,
            0.09
          ),
          transparent 23%
        );
    }

    .constellation::before {
      position:
        absolute;

      inset:
        0;

      content:
        "";

      opacity:
        0.2;

      background-image:
        radial-gradient(
          #70736a 0.7px,
          transparent 0.7px
        );

      background-size:
        17px 17px;
    }

    .constellation__center {
      position:
        absolute;

      top:
        50%;

      left:
        50%;

      z-index:
        3;

      display:
        flex;

      width:
        175px;

      height:
        175px;

      flex-direction:
        column;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px solid
        #6c6e65;

      border-radius:
        50%;

      background:
        #1d1f1b;

      transform:
        translate(
          -50%,
          -50%
        );

      box-shadow:
        0
        0
        0
        14px
        rgba(
          25,
          26,
          22,
          0.3
        );
    }

    .constellation__center::before {
      position:
        absolute;

      inset:
        12px;

      content:
        "";

      border:
        1px solid
        #383b34;

      border-radius:
        50%;
    }

    .constellation__center small {
      position:
        relative;

      color:
        #96998e;

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.1em;
    }

    .constellation__center strong {
      position:
        relative;

      margin:
        5px 0;

      color:
        #fff;

      font-family:
        "Bodoni Moda",
        Georgia,
        serif;

      font-size:
        27px;

      font-weight:
        400;
    }

    .constellation__center span {
      position:
        relative;

      color:
        var(--rust-light);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.1em;
    }

    .constellation__line {
      position:
        absolute;

      left:
        50%;

      top:
        50%;

      width:
        1px;

      height:
        41%;

      z-index:
        1;

      background:
        #4b4d45;

      transform-origin:
        top;
    }

    .constellation__line--one {
      transform:
        translateY(
          -100%
        )
        rotate(
          27deg
        );
    }

    .constellation__line--two {
      transform:
        translateY(
          -100%
        )
        rotate(
          117deg
        );
    }

    .constellation__line--three {
      transform:
        translateY(
          -100%
        )
        rotate(
          207deg
        );
    }

    .constellation__line--four {
      transform:
        translateY(
          -100%
        )
        rotate(
          297deg
        );
    }

    .constellation__node {
      position:
        absolute;

      z-index:
        4;

      display:
        flex;

      min-width:
        110px;

      min-height:
        72px;

      flex-direction:
        column;

      justify-content:
        center;

      padding:
        11px;

      border:
        1px solid
        #484b44;

      background:
        #1d1f1b;

      box-shadow:
        5px
        5px
        0
        rgba(
          0,
          0,
          0,
          0.18
        );
    }

    .constellation__node span,
    .constellation__node small {
      color:
        #888b82;

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        6px;

      letter-spacing:
        0.08em;
    }

    .constellation__node strong {
      margin:
        5px 0 2px;

      font-size:
        12px;

      font-weight:
        600;
    }

    .constellation__node--one {
      top:
        72px;

      left:
        15%;
    }

    .constellation__node--two {
      top:
        58px;

      right:
        14%;
    }

    .constellation__node--three {
      right:
        13%;

      bottom:
        72px;
    }

    .constellation__node--four {
      bottom:
        54px;

      left:
        15%;
    }

    .constellation__legend {
      position:
        absolute;

      right:
        17px;

      top:
        16px;

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      color:
        #7d8077;

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        6px;

      letter-spacing:
        0.08em;
    }

    .constellation__legend span {
      width:
        6px;

      height:
        6px;

      border-radius:
        50%;

      background:
        var(--rust-light);
    }


    /* =========================================
       PRINCIPLES
    ========================================== */

    .principles {
      padding:
        126px
        0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--paper-light);
    }

    .principles__headline {
      max-width:
        820px;

      margin-top:
        55px;
    }

    .principles__grid {
      display:
        grid;

      grid-template-columns:
        repeat(
          3,
          minmax(
            0,
            1fr
          )
        );

      gap:
        0;

      margin-top:
        65px;

      border-top:
        1px solid
        var(--ink);
    }

    .principle-card {
      min-height:
        330px;

      padding:
        20px
        28px
        24px
        0;

      border-right:
        1px solid
        var(--line);
    }

    .principle-card
      + .principle-card {
      padding-left:
        28px;
    }

    .principle-card:last-child {
      border-right:
        0;

      padding-right:
        0;
    }

    .principle-card__top {
      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      color:
        var(--muted);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.08em;
    }

    .principle-card__body {
      margin-top:
        82px;
    }

    .principle-card h3 {
      margin:
        0;

      font-family:
        "Bodoni Moda",
        Georgia,
        serif;

      font-size:
        35px;

      font-weight:
        400;

      line-height:
        0.95;

      letter-spacing:
        -0.045em;
    }

    .principle-card p {
      max-width:
        310px;

      margin:
        16px 0 0;

      color:
        var(--ink-soft);

      font-size:
        11px;

      line-height:
        1.75;
    }

    .principle-card__line {
      width:
        38px;

      height:
        2px;

      margin-top:
        22px;

      background:
        var(--rust);
    }


    /* =========================================
       DIRECTORY
    ========================================== */

    .directory {
      padding:
        126px
        0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--paper);
    }

    .directory__header {
      display:
        grid;

      grid-template-columns:
        minmax(
          0,
          1fr
        )
        340px;

      gap:
        70px;

      margin-top:
        55px;

      margin-bottom:
        55px;
    }

    .directory__header > p {
      align-self:
        end;

      margin:
        0;

      color:
        var(--ink-soft);

      font-size:
        13px;

      line-height:
        1.8;
    }

    .directory-table {
      border-top:
        1px solid
        var(--ink);
    }

    .directory-table__head,
    .directory-table__row {
      display:
        grid;

      grid-template-columns:
        55px
        minmax(
          0,
          1.3fr
        )
        150px
        120px
        145px
        24px;

      align-items:
        center;

      gap:
        15px;
    }

    .directory-table__head {
      min-height:
        44px;

      color:
        var(--muted);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.08em;

      text-transform:
        uppercase;
    }

    .directory-table__row {
      min-height:
        88px;

      border-top:
        1px solid
        var(--line);

      transition:
        background
        160ms ease,
        padding
        160ms ease;
    }

    .directory-table__row:hover {
      padding-left:
        10px;

      padding-right:
        10px;

      background:
        #ded5c4;
    }

    .directory-table__number {
      color:
        #989084;

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        8px;
    }

    .directory-table__name {
      display:
        flex;

      min-width:
        0;

      flex-direction:
        column;

      gap:
        4px;
    }

    .directory-table__name strong {
      overflow:
        hidden;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      font-size:
        15px;

      font-weight:
        700;

      letter-spacing:
        -0.035em;
    }

    .directory-table__name small,
    .directory-table__type,
    .directory-table__area,
    .directory-table__status {
      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.06em;

      text-transform:
        uppercase;
    }

    .directory-table__name small,
    .directory-table__type,
    .directory-table__area {
      color:
        var(--muted);
    }

    .directory-table__status {
      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        5px;

      min-height:
        27px;

      padding:
        0 8px;

      border:
        1px solid
        var(--line);

      color:
        var(--muted);

      white-space:
        nowrap;
    }

    .directory-table__status.is-verified {
      border-color:
        #aa7770;

      background:
        #ead3cf;

      color:
        #883d32;
    }

    .directory-table__arrow {
      color:
        #8b847a;

      transition:
        transform
        160ms ease;
    }

    .directory-table__row:hover
      .directory-table__arrow {
      transform:
        translate(
          2px,
          -2px
        );
    }

    .preview-note {
      margin:
        15px 0 0;

      color:
        #8d867b;

      font-size:
        9px;

      line-height:
        1.6;
    }


    /* =========================================
       MATERIAL INDEX
    ========================================== */

    .materials {
      padding:
        126px
        0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--paper-light);
    }

    .materials__header {
      display:
        grid;

      grid-template-columns:
        minmax(
          0,
          1fr
        )
        340px;

      gap:
        70px;

      margin-top:
        55px;

      margin-bottom:
        58px;
    }

    .materials__header > p {
      align-self:
        end;

      margin:
        0;

      color:
        var(--ink-soft);

      font-size:
        13px;

      line-height:
        1.8;
    }

    .material-index {
      display:
        grid;

      grid-template-columns:
        80px
        minmax(
          0,
          1fr
        );

      border-top:
        1px solid
        var(--ink);
    }

    .material-index__rail {
      display:
        flex;

      flex-direction:
        column;

      justify-content:
        space-between;

      padding:
        17px
        0;

      border-right:
        1px solid
        var(--line);

      color:
        var(--muted);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.08em;
    }

    .material-index__items {
      display:
        grid;
    }

    .material-row {
      position:
        relative;

      display:
        grid;

      grid-template-columns:
        48px
        minmax(
          180px,
          0.8fr
        )
        minmax(
          180px,
          0.65fr
        )
        32px;

      align-items:
        center;

      gap:
        16px;

      min-height:
        100px;

      border-bottom:
        1px solid
        var(--line);

      transition:
        background
        160ms ease,
        padding
        160ms ease;
    }

    .material-row:hover {
      padding-left:
        12px;

      padding-right:
        12px;

      background:
        #ded5c4;
    }

    .material-row--wide {
      min-height:
        136px;
    }

    .material-row--medium {
      min-height:
        113px;
    }

    .material-row--small {
      min-height:
        86px;
    }

    .material-row__number {
      color:
        #9b9388;

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        8px;
    }

    .material-row__name {
      font-family:
        "Bodoni Moda",
        Georgia,
        serif;

      font-size:
        clamp(
          27px,
          3.1vw,
          42px
        );

      font-weight:
        400;

      line-height:
        0.9;

      letter-spacing:
        -0.05em;
    }

    .material-row__code {
      color:
        var(--muted);

      font-family:
        "IBM Plex Mono",
        monospace;

      font-size:
        7px;

      letter-spacing:
        0.08em;
    }

    .material-row__arrow {
      display:
        grid;

      width:
        31px;

      height:
        31px;

      place-items:
        center;

      border:
        1px solid
        var(--line);
    }

    .material-row:hover
