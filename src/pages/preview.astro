            <div>
              <span>02</span>
              <small>DATA</small>
            </div>

            <div>
              <span>03</span>
              <small>NETWORK</small>
            </div>

            <div>
              <span>04</span>
              <small>MATERIAL</small>
            </div>

            <div>
              <span>05</span>
              <small>REPORT</small>
            </div>

          </div>

        </section>


        <!-- ===================================================
             STATEMENT
        ==================================================== -->

        <section class="statement">

          <div class="page-width statement__grid">

            <div class="statement__meta">
              <span>02</span>
              <small>THE CONTEXT</small>
            </div>

            <div class="statement__content">

              <p class="statement__eyebrow">
                SATU ISU, BANYAK KONTEKS.
              </p>

              <h2>
                Persampahan
                <span>perlu dilihat</span>
                secara utuh.
              </h2>

              <div class="statement__lower">

                <p>
                  Informasi tentang sampah tidak hanya berbicara
                  tentang material. Ia juga berkaitan dengan tempat,
                  manusia, organisasi, dan kondisi di sekitarnya.
                </p>

                <p>
                  BINSIGHT menyatukan konteks tersebut agar informasi
                  publik dapat dibaca dengan lebih jelas dan
                  digunakan dengan lebih baik.
                </p>

              </div>

            </div>

          </div>

        </section>


        <!-- ===================================================
             MODULES
        ==================================================== -->

        <section class="modules">

          <div class="page-width">

            <div class="modules__head">

              <div>
                <span class="section-label">
                  03 / EXPLORE
                </span>

                <h2>
                  Pilih ruang
                  <span>yang ingin dilihat.</span>
                </h2>
              </div>

              <p>
                Mulai dari satu kebutuhan, kemudian lanjutkan
                ke konteks yang berhubungan dengannya.
              </p>

            </div>


            <div class="module-grid">

              {
                services.map((service) => {
                  const Icon = service.icon;

                  return (
                    <a
                      href={siteHref(service.href)}
                      class="module-card"
                    >

                      <div class="module-card__top">

                        <span class="module-card__number">
                          {service.no}
                        </span>

                        <span class="module-card__label">
                          {service.label}
                        </span>

                      </div>


                      <div class="module-card__middle">

                        <div class="module-card__icon">
                          <Icon
                            size={25}
                            strokeWidth={1.7}
                          />
                        </div>

                        <ArrowUpRight
                          class="module-card__arrow"
                          size={18}
                          strokeWidth={1.6}
                        />

                      </div>


                      <div class="module-card__content">

                        <h3>
                          {service.title}
                        </h3>

                        <p>
                          {service.text}
                        </p>

                      </div>


                      <div class="module-card__footer">

                        <span>
                          OPEN MODULE
                        </span>

                        <span>
                          BINSIGHT / {service.no}
                        </span>

                      </div>

                    </a>
                  );
                })
              }

            </div>

          </div>

        </section>


        <!-- ===================================================
             DARK CONTEXT SECTION
        ==================================================== -->

        <section class="dark-section">

          <div class="page-width">

            <div class="dark-section__top">

              <div class="dark-section__meta">
                <span>04</span>
                <small>THE IDEA</small>
              </div>

              <div class="dark-section__label">
                BADUNG / WASTE / INTELLIGENCE
              </div>

            </div>


            <div class="dark-section__headline">

              <p>
                Memahami lingkungan berarti
                memahami hubungan di dalamnya.
              </p>

              <h2>
                MAP
                <span>+</span>
                DATA
                <span>+</span>
                PEOPLE
                <span>+</span>
                MATERIAL
              </h2>

            </div>


            <div class="dark-section__bottom">

              <p>
                Platform tidak berhenti pada satu titik informasi.
                Setiap bagian dirancang untuk membantu pengguna
                berpindah dari satu konteks ke konteks berikutnya.
              </p>

              <a
                href={siteHref("/map")}
                class="dark-section__link"
              >
                Lihat konteks
                <ArrowRight
                  size={16}
                  strokeWidth={1.7}
                />
              </a>

            </div>

          </div>

        </section>


        <!-- ===================================================
             METHOD
        ==================================================== -->

        <section class="method">

          <div class="page-width">

            <div class="method__header">

              <div>
                <span class="section-label">
                  05 / PROCESS
                </span>

                <h2>
                  Dari pertanyaan
                  <span>menjadi konteks.</span>
                </h2>
              </div>

              <p>
                Pengalaman BINSIGHT dibangun sebagai alur sederhana
                yang mengikuti kebutuhan pengguna.
              </p>

            </div>


            <div class="method__grid">

              <article class="method-card">

                <div class="method-card__number">
                  01
                </div>

                <div class="method-card__marker">
                  <span></span>
                </div>

                <div class="method-card__body">

                  <small>
                    LANGKAH PERTAMA
                  </small>

                  <h3>
                    Temukan
                  </h3>

                  <p>
                    Cari lokasi, wilayah, data,
                    organisasi, atau material
                    yang ingin diketahui.
                  </p>

                </div>

              </article>


              <article class="method-card">

                <div class="method-card__number">
                  02
                </div>

                <div class="method-card__marker">
                  <span></span>
                </div>

                <div class="method-card__body">

                  <small>
                    LANGKAH KEDUA
                  </small>

                  <h3>
                    Pahami
                  </h3>

                  <p>
                    Baca informasi yang tersedia
                    dan lihat konteks yang
                    berada di baliknya.
                  </p>

                </div>

              </article>


              <article class="method-card">

                <div class="method-card__number">
                  03
                </div>

                <div class="method-card__marker">
                  <span></span>
                </div>

                <div class="method-card__body">

                  <small>
                    LANGKAH KETIGA
                  </small>

                  <h3>
                    Hubungkan
                  </h3>

                  <p>
                    Kaitkan informasi dengan wilayah,
                    material, organisasi, dan
                    pengalaman masyarakat.
                  </p>

                </div>

              </article>

            </div>

          </div>

        </section>


        <!-- ===================================================
             AREAS
        ==================================================== -->

        <section class="coverage">

          <div class="page-width">

            <div class="coverage__head">

              <div>
                <span class="section-label">
                  06 / COVERAGE
                </span>

                <h2>
                  Melihat Badung
                  <span>dari dekat.</span>
                </h2>
              </div>

              <p>
                Informasi dapat dilihat berdasarkan wilayah
                untuk memahami konteks lokal secara lebih dekat.
              </p>

            </div>


            <div class="coverage__body">

              <div class="coverage__map">

                <div class="coverage__map-grid"></div>

                <div class="coverage__outline coverage__outline--one"></div>
                <div class="coverage__outline coverage__outline--two"></div>
                <div class="coverage__outline coverage__outline--three"></div>

                <div class="coverage__label coverage__label--badung">
                  <span></span>
                  BADUNG
                </div>

                <div class="coverage__label coverage__label--mengwi">
                  <span></span>
                  MENGWI
                </div>

                <div class="coverage__label coverage__label--abiansemal">
                  <span></span>
                  ABIANSEMAL
                </div>

                <div class="coverage__center">
                  <small>AREA VIEW</small>
                  <strong>BADUNG</strong>
                  <span>01 / 03</span>
                </div>

              </div>


              <div class="coverage__list">

                {
                  areas.map((area) => (
                    <a
                      href={siteHref("/map")}
                      class="coverage-row"
                    >

                      <div class="coverage-row__number">
                        {area.no}
                      </div>

                      <div class="coverage-row__name">

                        <small>
                          {area.type}
                        </small>

                        <strong>
                          {area.name}
                        </strong>

                      </div>

                      <div class="coverage-row__status">
                        <span></span>
                        {area.status}
                      </div>

                      <ArrowUpRight
                        size={18}
                        strokeWidth={1.6}
                      />

                    </a>
                  ))
                }

              </div>

            </div>

          </div>

        </section>


        <!-- ===================================================
             MATERIALS
        ==================================================== -->

        <section class="material">

          <div class="page-width">

            <div class="material__head">

              <div>
                <span class="section-label">
                  07 / MATERIAL
                </span>

                <h2>
                  Kenali
                  <span>materialnya.</span>
                </h2>
              </div>

              <div>
                <p>
                  Setiap material memiliki karakter dan kebutuhan
                  penanganan yang berbeda. Kenali kategorinya
                  sebelum melihat konteks lainnya.
                </p>

                <a
                  href={siteHref("/waste")}
                  class="inline-link"
                >
                  Lihat semua kategori
                  <ArrowRight
                    size={16}
                    strokeWidth={1.7}
                  />
                </a>
              </div>

            </div>


            <div class="material__list">

              {
                materials.map((material) => (
                  <a
                    href={siteHref("/waste")}
                    class="material-row"
                  >

                    <div class="material-row__number">
                      {material.no}
                    </div>

                    <div class="material-row__code">
                      {material.code}
                    </div>

                    <div class="material-row__name">
                      <strong>
                        {material.name}
                      </strong>

                      <p>
                        {material.detail}
                      </p>
                    </div>

                    <ArrowUpRight
                      size={19}
                      strokeWidth={1.6}
                    />

                  </a>
                ))
              }

            </div>

          </div>

        </section>


        <!-- ===================================================
             ABOUT
        ==================================================== -->

        <section
          class="about"
          id="tentang"
        >

          <div class="page-width">

            <div class="about__header">

              <div>
                <span class="section-label">
                  08 / ABOUT
                </span>

                <h2>
                  Dibangun
                  <span>untuk digunakan.</span>
                </h2>
              </div>

              <div class="about__badge">
                <span></span>
                PUBLIC INFORMATION
              </div>

            </div>


            <div class="about__grid">

              <div class="about__statement">

                <span class="about__statement-number">
                  08
                </span>

                <p>
                  BINSIGHT mengutamakan informasi
                  yang jelas, relevan, dan dapat
                  dipahami oleh publik.
                </p>

              </div>


              <div class="principle-list">

                {
                  principles.map((principle) => (
                    <article class="principle">

                      <span class="principle__number">
                        {principle.no}
                      </span>

                      <div>

                        <h3>
                          {principle.title}
                        </h3>

                        <p>
                          {principle.text}
                        </p>

                      </div>

                      <ArrowUpRight
                        size={16}
                        strokeWidth={1.5}
                      />

                    </article>
                  ))
                }

              </div>

            </div>

          </div>

        </section>


        <!-- ===================================================
             FINAL CTA
        ==================================================== -->

        <section class="final">

          <div class="page-width final__inner">

            <div class="final__top">
              <span>
                09 / BINSIGHT
              </span>

              <span>
                BADUNG WASTE INTELLIGENCE
              </span>
            </div>


            <div class="final__main">

              <div>

                <p>
                  MULAI DARI INFORMASI YANG
                  INGIN ANDA KETAHUI.
                </p>

                <h2>
                  Kenali.
                  <span>Pahami.</span>
                  Jaga Badung.
                </h2>

              </div>


              <a
                href={siteHref("/map")}
                class="final__button"
              >
                Jelajahi BINSIGHT
                <ArrowUpRight
                  size={19}
                  strokeWidth={1.7}
                />
              </a>

            </div>

          </div>

        </section>

      </main>


      <!-- =====================================================
           FOOTER
      ====================================================== -->

      <footer class="footer">

        <div class="page-width footer__grid">

          <div class="footer__identity">

            <a
              href={siteHref("/")}
              class="brand brand--footer"
            >
              <span
                class="brand__mark"
                aria-hidden="true"
              >
                <i></i>
                <i></i>
                <i></i>
                <i></i>
              </span>

              <span class="brand__text">
                BINSIGHT
              </span>
            </a>

            <p>
