  <script>
    const trigger =
      document.querySelector<HTMLElement>(
        "[data-menu-trigger]"
      );

    const panel =
      document.querySelector<HTMLElement>(
        "[data-mobile-panel]"
      );

    const openIcon =
      trigger?.querySelector<SVGElement>(
        "[data-menu-open]"
      );

    const closeIcon =
      trigger?.querySelector<SVGElement>(
        "[data-menu-close]"
      );


    const setMenu = (open: boolean) => {
      if (!trigger || !panel) return;

      trigger.setAttribute(
        "aria-expanded",
        String(open)
      );

      trigger.setAttribute(
        "aria-label",
        open
          ? "Tutup menu"
          : "Buka menu"
      );

      panel.hidden = !open;


      if (open) {

        openIcon?.setAttribute(
          "hidden",
          ""
        );

        closeIcon?.removeAttribute(
          "hidden"
        );

        if (openIcon) {
          openIcon.style.display =
            "none";
        }

        if (closeIcon) {
          closeIcon.style.display =
            "block";
        }

      } else {

        openIcon?.removeAttribute(
          "hidden"
        );

        closeIcon?.setAttribute(
          "hidden",
          ""
        );

        if (openIcon) {
          openIcon.style.display =
            "block";
        }

        if (closeIcon) {
          closeIcon.style.display =
            "none";
        }

      }

      document.body.classList.toggle(
        "menu-open",
        open
      );
    };


    if (openIcon) {
      openIcon.style.display =
        "block";
    }

    if (closeIcon) {
      closeIcon.style.display =
        "none";
    }


    trigger?.addEventListener(
      "click",
      () => {
        const open =
          trigger.getAttribute(
            "aria-expanded"
          ) === "true";

        setMenu(!open);
      }
    );


    panel
      ?.querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener(
          "click",
          () => setMenu(false)
        );
      });


    window.addEventListener(
      "resize",
      () => {
        if (
          window.innerWidth > 980
        ) {
          setMenu(false);
        }
      }
    );


    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          setMenu(false);
        }
      }
    );
  </script>


