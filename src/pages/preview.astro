        margin: 0;
        font-family:
          Sora,
          Inter,
          sans-serif;
        font-size: clamp(42px, 5.5vw, 78px);
        font-weight: 900;
        line-height: 0.84;
        letter-spacing: -0.08em;
        text-transform: uppercase;
