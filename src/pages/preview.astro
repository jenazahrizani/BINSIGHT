                </div>

                <div class="interface__grid"></div>

                <div class="interface__shape interface__shape--one"></div>
                <div class="interface__shape interface__shape--two"></div>

                <div class="interface__cross interface__cross--one">
                  <span></span>
                  <i></i>
                </div>

                <div class="interface__cross interface__cross--two">
                  <span></span>
                  <i></i>
                </div>

                <div class="interface__cross interface__cross--three">
                  <span></span>
                  <i></i>
                </div>

                <div class="interface__center">

                  <div class="interface__center-ring">
                    <span></span>
                  </div>

                  <small>REGION</small>

                  <strong>
                    BADUNG
                  </strong>

                  <span>
                    BALI / INDONESIA
                  </span>

                </div>

                <div class="interface__legend">
                  <div>
                    <i></i>
                    <span>AREA</span>
                  </div>

                  <div>
                    <i></i>
                    <span>CONTEXT</span>
                  </div>

                  <div>
                    <i></i>
                    <span>NETWORK</span>
                  </div>
                </div>

              </div>

              <div class="interface__bottom">

                <div>
                  <small>COORDINATES</small>
