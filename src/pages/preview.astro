---
import {
  ArrowUpRight,
  Building2,
  ChartColumn,
  ChevronRight,
  Map,
  Menu,
  Recycle,
  ShieldCheck,
  TriangleAlert,
  X,
} from "@lucide/astro";

const BASE_URL = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

function siteHref(path: string): string {
  if (!path) return `${BASE_URL}/`;

  if (/^(?:https?:|mailto:|tel:|#|data:|javascript:)/i.test(path)) {
    return path;
  }

  const normalized = path.startsWith("/") ? path : `/${path}`;

  if (
    BASE_URL &&
    (normalized === BASE_URL || normalized.startsWith(`${BASE_URL}/`))
  ) {
    return normalized;
  }

  if (normalized === "/") return `${BASE_URL}/`;

  return `${BASE_URL}${normalized}`;
}

const services = [
  {
    number: "01",
    title: "Peta Persampahan",
    description:
      "Menampilkan informasi persampahan berdasarkan wilayah dan lokasi agar kondisi lapangan dapat dipahami secara lebih kontekstual.",
    href: "/map",
    icon: Map,
  },
  {
    number: "02",
    title: "Data & Informasi",
    description:
      "Menyusun informasi yang tercatat di BINSIGHT menjadi konteks yang lebih mudah dibaca oleh masyarakat dan pemangku kepentingan.",
    href: "/dashboard",
    icon: ChartColumn,
  },
  {
    number: "03",
    title: "Jaringan Organisasi",
    description:
      "Mempertemukan informasi tentang organisasi, komunitas, dan pihak yang bergerak dalam pengelolaan persampahan.",
    href: "/organizations",
    icon: Building2,
  },
  {
    number: "04",
    title: "Edukasi & Laporan",
    description:
      "Membantu masyarakat mengenali jenis sampah sekaligus menyampaikan kondisi persampahan yang perlu diperhatikan.",
    href: "/waste",
    icon: Recycle,
  },
];

const principles = [
  {
    number: "01",
    title: "Kontekstual",
    text: "Informasi tidak berdiri sendiri. Lokasi, organisasi, material, dan laporan ditempatkan dalam konteks yang saling terhubung.",
  },
  {
    number: "02",
    title: "Terbuka",
    text: "BINSIGHT dirancang sebagai sumber informasi publik yang mudah dijelajahi dan dipahami.",
  },
  {
    number: "03",
    title: "Bertanggung Jawab",
    text: "Data ditampilkan dengan hati-hati tanpa menambahkan statistik publik yang belum tervalidasi.",
  },
];

const wasteCategories = [
  "Organik",
  "Anorganik",
  "Bahan Berbahaya",
  "Elektronik",
  "Residu",
];

const organizationExamples = [
  { name: "Organisasi Contoh A", type: "Komunitas", location: "Badung", verified: true },
  { name: "Organisasi Contoh B", type: "Swasta", location: "Mengwi", verified: true },
  { name: "Organisasi Contoh C", type: "Pendidikan", location: "Abiansemal", verified: false },
];

const footerLinks = [
  { label: "Peta", href: "/map" },
  { label: "Data", href: "/dashboard" },
  { label: "Organisasi", href: "/organizations" },
  { label: "Jenis Sampah", href: "/waste" },
  { label: "Laporan", href: "/reports" },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="BINSIGHT — Badung Waste Intelligence. Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
    />
    <meta name="theme-color" content="#f5f6ef" />
    <title>BINSIGHT — Badung Waste Intelligence</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="site">
      <header class="site-header" id="top">
        <div class="container site-header__inner">
          <a class="brand" href={siteHref("/")} aria-label="BINSIGHT — Beranda">
            <span class="brand__mark" aria-hidden="true">B</span>
            <span class="brand__text">
              <strong>BINSIGHT</strong>
              <small>BADUNG WASTE INTELLIGENCE</small>
            </span>
          </a>

          <nav class="desktop-nav" aria-label="Navigasi utama">
            <a class="desktop-nav__link is-active" href={siteHref("/")}>Beranda</a>
            <a class="desktop-nav__link" href={siteHref("/map")}>Peta</a>
            <a class="desktop-nav__link" href={siteHref("/dashboard")}>Data</a>
            <a class="desktop-nav__link" href={siteHref("/organizations")}>Organisasi</a>
            <a class="desktop-nav__link" href={siteHref("/company")}>Tentang</a>
          </nav>

          <div class="site-header__actions">
            <a class="header-cta" href={siteHref("/reports/create")}>
              <span>Laporkan Kondisi</span>
              <ArrowUpRight size={15} stroke-width={2} aria-hidden="true" />
            </a>

            <button
              class="mobile-menu-toggle"
              type="button"
              aria-label="Buka menu"
              aria-expanded="false"
              data-menu-trigger
            >
              <Menu size={20} stroke-width={2} data-menu-open />
              <X size={20} stroke-width={2} data-menu-close hidden />
            </button>
          </div>
        </div>

        <div class="mobile-panel" data-mobile-panel hidden>
          <nav class="container mobile-panel__nav" aria-label="Navigasi mobile">
            <a href={siteHref("/")}>Beranda</a>
            <a href={siteHref("/map")}>Peta</a>
            <a href={siteHref("/dashboard")}>Data</a>
            <a href={siteHref("/organizations")}>Organisasi</a>
            <a href={siteHref("/company")}>Tentang BINSIGHT</a>
            <a class="mobile-panel__cta" href={siteHref("/reports/create")}>
              Buat Laporan
              <ArrowUpRight size={15} stroke-width={2} aria-hidden="true" />
            </a>
          </nav>
        </div>
      </header>

      <main>
        <section class="hero">
          <div class="container hero__grid">
            <div class="hero__content">
              <p class="eyebrow">
                <span class="eyebrow__line" aria-hidden="true"></span>
                BADUNG WASTE INTELLIGENCE
              </p>

              <h1>
                Kenali.
                <span>Pahami.</span>
                <em>Jaga Badung.</em>
              </h1>

              <p class="hero__lead">
                BINSIGHT adalah platform informasi persampahan Kabupaten Badung
                yang menghubungkan <strong>peta, data, organisasi, edukasi,</strong>
                dan <strong>laporan masyarakat</strong> dalam satu tempat.
              </p>

              <div class="hero__actions">
                <a class="button button--primary" href={siteHref("/map")}>
                  Jelajahi BINSIGHT
                  <ArrowUpRight size={17} stroke-width={2} aria-hidden="true" />
                </a>
                <a class="button button--secondary" href={siteHref("/company")}>
                  Tentang Platform
                </a>
              </div>

              <div class="hero__note">
                <span class="status-dot" aria-hidden="true"></span>
                <span>PLATFORM INFORMASI PUBLIK · KABUPATEN BADUNG</span>
              </div>
            </div>

            <aside class="hero-card" aria-label="Ringkasan BINSIGHT">
              <div class="hero-card__top">
                <span>01</span>
                <span>OVERVIEW</span>
              </div>

              <div class="hero-card__visual">
                <div class="visual-grid" aria-hidden="true"></div>
                <div class="visual-circle visual-circle--one" aria-hidden="true"></div>
                <div class="visual-circle visual-circle--two" aria-hidden="true"></div>

                <div class="visual-pin visual-pin--one"><span></span>KUTA</div>
                <div class="visual-pin visual-pin--two"><span></span>MENGWI</div>
                <div class="visual-pin visual-pin--three"><span></span>ABIANSEMAL</div>

                <div class="visual-label">
                  <small>CONTEXT</small>
                  <strong>BADUNG</strong>
                </div>
              </div>

              <div class="hero-card__bottom">
                <div>
                  <span class="meta-label">MODEL</span>
                  <strong>MAP + DATA + NETWORK</strong>
                </div>
                <span class="hero-card__arrow" aria-hidden="true">
                  <ArrowUpRight size={18} stroke-width={1.8} />
                </span>
              </div>
            </aside>
          </div>
        </section>

        <section class="intro section">
          <div class="container intro__grid">
            <div>
              <p class="section-label">01 / TENTANG BINSIGHT</p>
              <h2>Satu platform untuk membaca ekosistem persampahan.</h2>
            </div>

            <div class="intro__copy">
              <p>
                Persampahan bukan hanya soal lokasi pembuangan. Ada material,
                pengelola, proses, kebiasaan, dan kondisi lingkungan yang saling
                terhubung.
              </p>
              <p>
                BINSIGHT menyederhanakan hubungan tersebut menjadi pengalaman
                digital yang lebih jelas: masyarakat dapat menemukan informasi,
                memahami konteks, dan ikut menyampaikan kondisi di sekitarnya.
              </p>
              <a class="text-link" href={siteHref("/company")}>
                Kenali BINSIGHT lebih jauh
                <ChevronRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>

        <section class="services section section--soft">
          <div class="container">
            <div class="section-head">
              <div>
                <p class="section-label">02 / LAYANAN INFORMASI</p>
                <h2>Yang bisa dilakukan di BINSIGHT</h2>
              </div>
              <p class="section-head__intro">
                Setiap bagian dirancang untuk membantu pengguna melihat isu
                persampahan dari sudut yang berbeda, tetapi tetap dalam satu konteks.
              </p>
            </div>

            <div class="service-grid">
              {services.map((service) => {
                const Icon = service.icon;
                return (
                  <a class="service-card" href={siteHref(service.href)}>
                    <div class="service-card__head">
                      <span class="service-card__number">{service.number}</span>
                      <span class="service-card__icon">
                        <Icon size={23} stroke-width={1.8} aria-hidden="true" />
                      </span>
                    </div>

                    <div class="service-card__content">
                      <h3>{service.title}</h3>
                      <p>{service.description}</p>
                    </div>

                    <span class="service-card__link">
                      Pelajari
                      <ArrowUpRight size={15} stroke-width={2} aria-hidden="true" />
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>

        <section class="statement section section--dark">
          <div class="container statement__grid">
            <div>
              <p class="section-label section-label--light">03 / CARA KERJA</p>
              <h2>
                Informasi terhubung.
                <span>Konteks menjadi kekuatan.</span>
              </h2>
            </div>

            <div class="statement__formula">
              <div class="formula-row"><span>01</span><strong>MAP</strong><small>LOKASI</small></div>
              <div class="formula-row"><span>02</span><strong>DATA</strong><small>INFORMASI</small></div>
              <div class="formula-row"><span>03</span><strong>NETWORK</strong><small>ORGANISASI</small></div>
              <div class="formula-row"><span>04</span><strong>EDUCATION</strong><small>MATERIAL</small></div>
              <div class="formula-row"><span>05</span><strong>REPORT</strong><small>PARTISIPASI</small></div>
            </div>
          </div>
        </section>

        <section class="principles section">
          <div class="container">
            <div class="section-head section-head--compact">
              <div>
                <p class="section-label">04 / PRINSIP</p>
                <h2>Dibangun untuk informasi yang mudah dipercaya.</h2>
              </div>
            </div>

            <div class="principle-grid">
              {principles.map((item) => (
                <article class="principle-card">
                  <span class="principle-card__number">{item.number}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="network section section--soft">
          <div class="container">
            <div class="section-head">
              <div>
                <p class="section-label">05 / EKOSISTEM</p>
                <h2>Siapa yang bergerak di dalam ekosistem?</h2>
              </div>
              <div class="section-head__side">
                <p>
                  BINSIGHT menyediakan ruang informasi untuk mengenali pihak yang
                  bergerak di bidang persampahan dan lingkungan.
                </p>
                <a class="text-link" href={siteHref("/organizations")}>
                  Lihat organisasi
                  <ChevronRight size={16} stroke-width={2} aria-hidden="true" />
                </a>
              </div>
            </div>

            <div class="organization-list">
              {organizationExamples.map((organization, index) => (
                <a
                  class="organization-row"
                  href={siteHref("/organizations")}
                  aria-label={`Lihat ${organization.name}`}
                >
                  <span class="organization-row__index">{String(index + 1).padStart(2, "0")}</span>
                  <span class="organization-row__main">
                    <strong>{organization.name}</strong>
                    <small>{organization.type}</small>
                  </span>
                  <span class="organization-row__location">{organization.location}</span>
                  <span class:list={["verification", organization.verified && "is-verified"]}>
                    <ShieldCheck size={15} stroke-width={1.8} aria-hidden="true" />
                    {organization.verified ? "TERVERIFIKASI" : "CONTOH"}
                  </span>
                  <ArrowUpRight class="organization-row__arrow" size={18} stroke-width={1.8} aria-hidden="true" />
                </a>
              ))}
            </div>

            <p class="preview-note">
              Data organisasi di atas adalah contoh visual untuk kebutuhan preview.
              Data publik aktual dapat dihubungkan kembali ke sumber data project.
            </p>
          </div>
        </section>

        <section class="materials section">
          <div class="container materials__grid">
            <div class="materials__intro">
              <p class="section-label">06 / PENGETAHUAN MATERIAL</p>
              <h2>Kenali materialnya.</h2>
              <p>
                Mengenal kategori sampah membantu pengguna memahami bahwa setiap
                material memiliki karakteristik dan kebutuhan pengelolaan yang berbeda.
              </p>
              <a class="button button--secondary materials__button" href={siteHref("/waste")}>
                <span>Lihat Jenis Sampah</span>
                <span class="button__icon" aria-hidden="true">
                  <ArrowUpRight size={16} stroke-width={2} />
                </span>
              </a>
            </div>

            <div class="material-list" aria-label="Kategori sampah">
              {wasteCategories.map((category, index) => (
                <a class="material-item" href={siteHref("/waste")}>
                  <span class="material-item__index">{String(index + 1).padStart(2, "0")}</span>
                  <span class="material-item__name">{category}</span>
                  <span class="material-item__icon" aria-hidden="true">
                    <ArrowUpRight size={17} stroke-width={1.8} />
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="report-cta">
          <div class="container report-cta__inner">
            <div>
              <p class="section-label section-label--light">07 / PARTISIPASI</p>
              <h2>Melihat masalah?<br /><span>Masukkan ke sistem.</span></h2>
            </div>

            <div class="report-cta__copy">
              <p>
                Bantu memperkaya informasi persampahan dengan menyampaikan kondisi
                yang Anda temukan di lingkungan sekitar.
              </p>
              <a class="button button--primary button--light" href={siteHref("/reports/create")}>
                Buat Laporan
                <ArrowUpRight size={17} stroke-width={2} aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="container">
          <div class="footer__top">
            <div class="footer__brand">
              <a class="brand brand--footer" href={siteHref("/")}>
                <span class="brand__mark" aria-hidden="true">B</span>
                <span class="brand__text">
                  <strong>BINSIGHT</strong>
                  <small>BADUNG WASTE INTELLIGENCE</small>
                </span>
              </a>
              <p>
                Platform informasi persampahan Kabupaten Badung untuk menemukan,
                memahami, dan melaporkan kondisi persampahan.
              </p>
            </div>

            <div class="footer__columns">
              <div>
                <p class="footer__label">EKSPLORE</p>
                <nav aria-label="Eksplorasi">
                  {footerLinks.map((link) => (
                    <a href={siteHref(link.href)}>
                      {link.label}
                      <ArrowUpRight size={13} stroke-width={1.8} aria-hidden="true" />
                    </a>
                  ))}
                </nav>
              </div>

              <div>
                <p class="footer__label">KONTAK / PLATFORM</p>
                <div class="footer__meta">
                  <span>BADUNG, BALI</span>
                  <span>PUBLIC INFORMATION PLATFORM</span>
                  <span>© {currentYear} BINSIGHT</span>
                </div>
              </div>
            </div>
          </div>

          <div class="footer__bottom">
            <span>BINSIGHT / BADUNG WASTE INTELLIGENCE</span>
            <span>MAP · DATA · NETWORK · EDUCATION · REPORT</span>
          </div>
        </div>
      </footer>

      <a
        class="floating-report"
        href={siteHref("/reports/create")}
        aria-label="Buat laporan kondisi persampahan"
      >
        <span class="floating-report__icon" aria-hidden="true">
          <TriangleAlert size={20} stroke-width={2.2} />
        </span>
        <span class="floating-report__content">
          <small>LAPORAN MASYARAKAT</small>
          <strong>Buat Laporan</strong>
        </span>
        <span class="floating-report__arrow" aria-hidden="true">
          <ArrowUpRight size={17} stroke-width={2.2} />
        </span>
      </a>
    </div>
  </body>

  <script>
    const trigger = document.querySelector<HTMLElement>("[data-menu-trigger]");
    const panel = document.querySelector<HTMLElement>("[data-mobile-panel]");
    const openIcon = trigger?.querySelector<SVGElement>("[data-menu-open]");
    const closeIcon = trigger?.querySelector<SVGElement>("[data-menu-close]");

    const setMenu = (open: boolean) => {
      if (!trigger || !panel) return;

      trigger.setAttribute("aria-expanded", String(open));
      trigger.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
      panel.hidden = !open;

      if (open) {
        openIcon?.setAttribute("hidden", "");
        closeIcon?.removeAttribute("hidden");
        if (openIcon) openIcon.style.display = "none";
        if (closeIcon) closeIcon.style.display = "block";
      } else {
        openIcon?.removeAttribute("hidden");
        closeIcon?.setAttribute("hidden", "");
        if (openIcon) openIcon.style.display = "block";
        if (closeIcon) closeIcon.style.display = "none";
      }

      document.body.classList.toggle("menu-open", open);
    };

    // Ensure a single menu icon is visible on first render.
    if (openIcon) openIcon.style.display = "block";
    if (closeIcon) closeIcon.style.display = "none";

    trigger?.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      setMenu(!isOpen);
    });

    panel?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 1020) setMenu(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenu(false);
    });
  </script>

  <style>
    :global(:root) {
      color-scheme: light;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
      background: #f5f6ef;
    }

    :global(body) {
      min-width: 320px;
      margin: 0;
      background: #f5f6ef;
      color: #171a16;
    }

    :global(body.menu-open) {
      overflow: hidden;
    }

    :global(a) {
      color: inherit;
      text-decoration: none;
    }

    :global(button),
    :global(a) {
      -webkit-tap-highlight-color: transparent;
    }

    .site {
      --ink: #171a16;
      --ink-soft: #4e554d;
      --muted: #737a71;
      --line: #d8dbd2;
      --paper: #f5f6ef;
      --paper-alt: #eceee7;
      --white: #ffffff;
      --accent: #cbdc35;
      --accent-dark: #707f10;
      --deep: #20251f;
      --max: 1240px;
      width: 100%;
      overflow: clip;
      background: var(--paper);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    .container {
      width: min(var(--max), calc(100% - 48px));
      margin: 0 auto;
    }

    /* Header */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      border-bottom: 1px solid rgba(23, 26, 22, 0.1);
      background: rgba(245, 246, 239, 0.96);
      backdrop-filter: blur(14px);
    }

    .site-header__inner {
      min-height: 78px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 32px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      width: fit-content;
    }

    .brand__mark {
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      flex: 0 0 38px;
      background: var(--ink);
      color: var(--accent);
      font-family: Sora, Inter, sans-serif;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -0.08em;
    }

    .brand__text {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .brand__text strong {
      font-family: Sora, Inter, sans-serif;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: -0.045em;
    }

    .brand__text small {
      color: var(--muted);
      font-family: "DM Mono", monospace;
      font-size: 7px;
      font-weight: 600;
      letter-spacing: 0.1em;
    }

    .desktop-nav {
      display: flex;
      align-items: stretch;
      gap: 2px;
      height: 78px;
    }

    .desktop-nav__link {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 78px;
      padding: 0 11px;
      color: #5d645b;
      font-size: 12px;
      font-weight: 600;
      transition: color 160ms ease;
    }

    .desktop-nav__link::after {
      position: absolute;
      right: 11px;
      bottom: 16px;
      left: 11px;
      height: 2px;
      content: "";
      background: var(--ink);
      transform: scaleX(0);
      transform-origin: center;
      transition: transform 160ms ease;
    }

    .desktop-nav__link:hover,
    .desktop-nav__link.is-active {
      color: var(--ink);
    }

    .desktop-nav__link:hover::after,
    .desktop-nav__link.is-active::after {
      transform: scaleX(1);
    }

    .site-header__actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 40px;
      padding: 0 14px;
      background: var(--ink);
      color: var(--white);
      font-size: 10px;
      font-weight: 700;
      transition: background 160ms ease, transform 160ms ease;
    }

    .header-cta:hover {
      background: #30372e;
      transform: translateY(-1px);
    }

    .mobile-menu-toggle {
      display: none;
      width: 42px;
      height: 42px;
      padding: 0;
      place-items: center;
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--ink);
      cursor: pointer;
    }

    .mobile-menu-toggle svg {
      display: block;
    }

    .mobile-menu-toggle svg[hidden] {
      display: none !important;
    }

    .mobile-panel {
      border-top: 1px solid var(--line);
      background: var(--paper);
    }

    .mobile-panel__nav {
      display: grid;
      gap: 0;
      padding-top: 8px;
      padding-bottom: 16px;
    }

    .mobile-panel__nav > a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 50px;
      border-bottom: 1px solid var(--line);
      font-size: 14px;
      font-weight: 600;
    }

    .mobile-panel__nav .mobile-panel__cta {
      justify-content: center;
      gap: 7px;
      margin-top: 12px;
      border: 0;
      background: var(--ink);
      color: var(--white);
    }

    /* Hero */
    .hero {
      border-bottom: 1px solid var(--line);
      background:
        radial-gradient(circle at 88% 20%, rgba(203, 220, 53, 0.17), transparent 25%),
        linear-gradient(180deg, #f8f9f4 0%, #f2f3ed 100%);
    }

    .hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.04fr) minmax(360px, 0.8fr);
      align-items: center;
      gap: 72px;
      min-height: 730px;
      padding-top: 64px;
      padding-bottom: 72px;
    }

    .hero__content {
      min-width: 0;
    }

    .eyebrow,
    .section-label,
    .meta-label,
    .footer__label {
      margin: 0;
      font-family: "DM Mono", monospace;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.12em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--muted);
    }

    .eyebrow__line {
      width: 30px;
      height: 1px;
      background: var(--ink);
    }

    .hero h1 {
      max-width: 730px;
      margin: 26px 0 0;
      font-family: Sora, Inter, sans-serif;
      font-size: clamp(66px, 7.8vw, 118px);
      font-weight: 800;
      line-height: 0.9;
      letter-spacing: -0.085em;
      text-transform: uppercase;
    }

    .hero h1 span,
    .hero h1 em {
      display: block;
    }

    .hero h1 span {
      margin-left: 5%;
    }

    .hero h1 em {
      margin-left: 1%;
      color: var(--accent-dark);
      font-style: normal;
    }

    .hero__lead {
      max-width: 610px;
      margin: 32px 0 0;
      color: var(--ink-soft);
      font-size: 15px;
      line-height: 1.8;
    }

    .hero__lead strong {
      color: var(--ink);
      font-weight: 700;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      padding: 0 17px;
      border: 1px solid var(--ink);
      font-size: 11px;
      font-weight: 700;
      transition: transform 160ms ease, background 160ms ease, color 160ms ease;
    }

    .button:hover {
      transform: translateY(-2px);
    }

    .button--primary {
      background: var(--ink);
      color: var(--white);
    }

    .button--primary:hover {
      background: #31392f;
    }

    .button--secondary {
      background: transparent;
      color: var(--ink);
    }

    .button--secondary:hover {
      background: var(--white);
    }

    .button--light {
      background: var(--white);
      border-color: var(--white);
      color: var(--ink);
    }

    .hero__note {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 40px;
      color: #7d847a;
      font-family: "DM Mono", monospace;
      font-size: 8px;
      font-weight: 500;
      letter-spacing: 0.08em;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      flex: 0 0 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: inset 0 0 0 2px var(--ink);
    }

    .hero-card {
      min-width: 0;
      overflow: hidden;
      border: 1px solid #cbd0c6;
      background: var(--white);
      box-shadow: 0 20px 55px rgba(23, 26, 22, 0.08);
    }

    .hero-card__top,
    .hero-card__bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0 18px;
      font-family: "DM Mono", monospace;
      font-size: 8px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-card__top {
      min-height: 54px;
      border-bottom: 1px solid var(--line);
      color: var(--muted);
    }

    .hero-card__bottom {
      align-items: center;
      min-height: 98px;
      padding: 18px 18px 20px;
      border-top: 1px solid var(--line);
    }

    .hero-card__bottom > div {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }

    .hero-card__bottom strong {
      display: block;
      max-width: 100%;
      font-family: Inter, sans-serif;
      font-size: 12px;
      font-weight: 700;
      line-height: 1.45;
      letter-spacing: 0;
    }

    .hero-card__arrow {
      display: grid;
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
      place-items: center;
      border: 1px solid var(--line);
    }

    .hero-card__visual {
      position: relative;
      min-height: 420px;
      overflow: hidden;
      background: linear-gradient(120deg, #dce65f 0%, #cbdc35 100%);
    }

    .visual-grid {
      position: absolute;
      inset: 0;
      opacity: 0.32;
      background-image:
        linear-gradient(rgba(23, 26, 22, 0.12) 1px, transparent 1px),
        linear-gradient(90deg, rgba(23, 26, 22, 0.12) 1px, transparent 1px);
      background-size: 42px 42px;
    }

    .visual-circle {
      position: absolute;
      border: 1px solid rgba(23, 26, 22, 0.28);
      border-radius: 50%;
    }

    .visual-circle--one {
      width: 72%;
      aspect-ratio: 1;
      top: 10%;
      left: 14%;
    }

    .visual-circle--two {
      width: 46%;
      aspect-ratio: 1;
      top: 23%;
      left: 27%;
    }

    .visual-pin {
      position: absolute;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 8px;
      background: var(--ink);
      color: var(--white);
      font-family: "DM Mono", monospace;
      font-size: 8px;
      font-weight: 600;
      letter-spacing: 0.08em;
    }

    .visual-pin span {
      width: 6px;
      height: 6px;
      flex: 0 0 6px;
      border: 1px solid var(--white);
      border-radius: 50%;
      background: var(--accent);
    }

    .visual-pin--one { top: 23%; left: 19%; }
    .visual-pin--two { top: 46%; right: 14%; }
    .visual-pin--three { right: 21%; bottom: 20%; }

    .visual-label {
      position: absolute;
      right: 10%;
      bottom: 9%;
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding: 13px 15px;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(23, 26, 22, 0.15);
    }

    .visual-label small {
      font-family: "DM Mono", monospace;
      font-size: 8px;
      font-weight: 600;
      letter-spacing: 0.1em;
    }

    .visual-label strong {
      font-family: Sora, Inter, sans-serif;
      font-size: 28px;
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.06em;
    }

    /* Shared sections */
    .section {
      padding: 104px 0;
      border-bottom: 1px solid var(--line);
    }

    .section--soft {
      background: var(--paper-alt);
    }

    .section--dark {
      background: var(--deep);
      color: var(--white);
      border-bottom-color: #31372f;
    }

    .section-label {
      color: #727a70;
    }

    .section-label--light {
      color: #a8b0a3;
    }

    .section h2 {
      max-width: 910px;
      margin: 17px 0 0;
      font-family: Sora, Inter, sans-serif;
      font-size: clamp(46px, 5.8vw, 82px);
      font-weight: 800;
      line-height: 0.96;
      letter-spacing: -0.075em;
      text-transform: uppercase;
    }

    .section-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 56px;
      align-items: end;
      margin-bottom: 48px;
    }

    .section-head--compact {
      grid-template-columns: 1fr;
    }

    .section-head__intro,
    .section-head__side p {
      max-width: 360px;
      margin: 0;
      color: var(--ink-soft);
      font-size: 13px;
      line-height: 1.75;
    }

    /* Intro */
    .intro__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.62fr);
      gap: 88px;
      align-items: start;
    }

    .intro__copy {
      padding-top: 42px;
    }

    .intro__copy p {
      margin: 0 0 20px;
      color: var(--ink-soft);
      font-size: 15px;
      line-height: 1.85;
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 5px;
      padding-bottom: 5px;
      border-bottom: 1px solid var(--ink);
      font-size: 11px;
      font-weight: 700;
      transition: gap 160ms ease;
    }

    .text-link:hover {
      gap: 11px;
    }

    /* Services */
    .service-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .service-card {
      position: relative;
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 286px;
      padding: 26px 26px 22px;
      border: 1px solid #cfd3c9;
      background: var(--white);
      transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    }

    .service-card:hover {
      transform: translateY(-4px);
      border-color: #aeb4a8;
      box-shadow: 0 16px 36px rgba(23, 26, 22, 0.07);
    }

    .service-card__head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }

    .service-card__number {
      color: #7c837a;
      font-family: "DM Mono", monospace;
      font-size: 9px;
      font-weight: 600;
    }

    .service-card__icon {
      display: grid;
      width: 54px;
      height: 54px;
      flex: 0 0 54px;
      place-items: center;
      border: 1px solid var(--ink);
      background: var(--accent);
      color: var(--ink);
    }

    .service-card__content {
      margin-top: auto;
      padding-top: 44px;
      padding-right: 55px;
    }

    .service-card__content h3 {
      margin: 0;
      font-family: Sora, Inter, sans-serif;
      font-size: 25px;
      font-weight: 800;
      line-height: 1.08;
      letter-spacing: -0.045em;
      text-transform: uppercase;
    }

    .service-card__content p {
      margin: 12px 0 0;
      color: var(--ink-soft);
      font-size: 12px;
      line-height: 1.72;
    }

    .service-card__link {
      position: absolute;
      right: 20px;
      bottom: 18px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #626a61;
      font-family: "DM Mono", monospace;
      font-size: 8px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* Statement */
    .statement__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
      gap: 90px;
      align-items: start;
    }

    .statement h2 span {
      display: block;
      color: var(--accent);
    }

    .statement__formula {
      border-top: 1px solid #3a4038;
    }

    .formula-row {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr) auto;
      align-items: center;
      gap: 16px;
      min-height: 62px;
      border-bottom: 1px solid #3a4038;
    }

    .formula-row > span,
    .formula-row small {
      color: #8f9890;
      font-family: "DM Mono", monospace;
      font-size: 8px;
    }

    .formula-row strong {
      color: var(--white);
      font-family: Sora, Inter, sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.04em;
    }

    .formula-row small {
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* Principles */
    .principle-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--line);
    }

    .principle-card {
      min-width: 0;
      min-height: 250px;
      padding: 26px 28px 22px 0;
      border-right: 1px solid var(--line);
    }

    .principle-card + .principle-card {
      padding-left: 28px;
    }

    .principle-card:last-child {
      padding-right: 0;
      border-right: 0;
    }

    .principle-card__number {
      color: #70776e;
      font-family: "DM Mono", monospace;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.08em;
    }

    .principle-card h3 {
      margin: 52px 0 0;
      font-family: Sora, Inter, sans-serif;
      font-size: 23px;
      font-weight: 800;
      letter-spacing: -0.045em;
      text-transform: uppercase;
    }

    .principle-card p {
      max-width: 330px;
      margin: 11px 0 0;
      color: var(--ink-soft);
      font-size: 12px;
      line-height: 1.72;
    }

    /* Organization */
    .section-head__side {
      align-self: end;
    }

    .section-head__side .text-link {
      margin-top: 15px;
    }

    .organization-list {
      border-top: 1px solid var(--ink);
    }

    .organization-row {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr) 130px 150px 22px;
      gap: 16px;
      align-items: center;
      min-width: 0;
      min-height: 84px;
      border-bottom: 1px solid var(--line);
      transition: background 160ms ease, padding 160ms ease;
    }

    .organization-row:hover {
      padding-left: 10px;
      padding-right: 10px;
      background: var(--white);
    }

    .organization-row__index {
      color: #7c8279;
      font-family: "DM Mono", monospace;
      font-size: 8px;
    }

    .organization-row__main {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .organization-row__main strong {
      overflow: hidden;
      font-family: Sora, Inter, sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.04em;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .organization-row__main small,
    .organization-row__location,
    .verification {
      color: #71786f;
      font-family: "DM Mono", monospace;
      font-size: 7px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .verification {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      min-height: 28px;
      padding: 0 7px;
      border: 1px solid var(--line);
      white-space: nowrap;
    }

    .verification.is-verified {
      color: #5e6f00;
      border-color: #aab86a;
      background: rgba(203, 220, 53, 0.2);
    }

    .organization-row__arrow {
      color: #7a8177;
      transition: transform 160ms ease, color 160ms ease;
    }

    .organization-row:hover .organization-row__arrow {
      color: var(--ink);
      transform: translate(2px, -2px);
    }

    .preview-note {
      margin: 16px 0 0;
      color: #858b83;
      font-size: 10px;
      line-height: 1.6;
    }

    /* Materials */
    .materials__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
      gap: clamp(56px, 7vw, 104px);
      align-items: start;
    }

    .materials__intro {
      padding-top: 2px;
    }

    .materials__intro h2 {
      max-width: 520px;
    }

    .materials__intro p:not(.section-label) {
      max-width: 470px;
      margin: 26px 0 32px;
      color: var(--ink-soft);
      font-size: 14px;
      line-height: 1.85;
    }

    .materials__button {
      width: fit-content;
      min-width: 190px;
      gap: 14px;
      padding: 0 14px 0 17px;
    }

    .button__icon {
      display: grid;
      width: 30px;
      height: 30px;
      flex: 0 0 30px;
      place-items: center;
      border: 1px solid var(--line);
      background: var(--white);
    }

    .material-list {
      display: grid;
      gap: 10px;
      padding-top: 2px;
    }

    .material-item {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr) 40px;
      align-items: center;
      gap: 18px;
      min-height: 82px;
      padding: 0 16px 0 18px;
      border: 1px solid var(--line);
      background: var(--white);
      transition:
        transform 160ms ease,
        border-color 160ms ease,
        background 160ms ease,
        box-shadow 160ms ease;
    }

    .material-item:hover {
      border-color: #aeb5a6;
      background: #fbfbf7;
      box-shadow: 0 12px 26px rgba(23, 26, 22, 0.06);
      transform: translateX(4px);
    }

    .material-item__index {
      display: inline-grid;
      width: 32px;
      height: 32px;
      place-items: center;
      color: var(--ink-soft);
      background: var(--paper-alt);
      border: 1px solid var(--line);
      font-family: "DM Mono", monospace;
      font-size: 8px;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .material-item__name {
      min-width: 0;
      color: var(--ink);
      font-family: Sora, Inter, sans-serif;
      font-size: clamp(17px, 2vw, 21px);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.15;
    }

    .material-item__icon {
      display: grid;
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      place-items: center;
      justify-self: end;
      border: 1px solid var(--line);
      color: var(--ink);
      background: var(--paper);
      transition:
        background 160ms ease,
        border-color 160ms ease,
        transform 160ms ease;
    }

    .material-item:hover .material-item__icon {
      border-color: var(--ink);
      background: var(--accent);
      transform: translate(1px, -1px);
    }

    .button svg,
    .material-item svg,
    .service-card svg,
    .organization-row svg,
    .floating-report svg {
      display: block;
      flex: 0 0 auto;
    }

    /* Report CTA */
    .report-cta {
      background: var(--deep);
      color: var(--white);
      border-top: 1px solid #333a32;
      border-bottom: 1px solid #333a32;
    }

    .report-cta__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, 0.62fr);
      align-items: center;
      gap: 88px;
      min-height: 460px;
      padding-top: 72px;
      padding-bottom: 72px;
    }

    .report-cta h2 {
      margin: 17px 0 0;
      font-family: Sora, Inter, sans-serif;
      font-size: clamp(52px, 6.8vw, 96px);
      font-weight: 800;
      line-height: 0.92;
      letter-spacing: -0.08em;
      text-transform: uppercase;
    }

    .report-cta h2 span {
      color: var(--accent);
    }

    .report-cta__copy {
      max-width: 440px;
    }

    .report-cta__copy p {
      margin: 0 0 24px;
      color: #c3c9c0;
      font-size: 14px;
      line-height: 1.8;
    }

    /* Footer */
    .footer {
      background: #eef0e9;
    }

    .footer__top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(350px, 0.78fr);
      gap: 76px;
      padding: 70px 0 58px;
    }

    .footer__brand p {
      max-width: 450px;
      margin: 22px 0 0;
      color: var(--ink-soft);
      font-size: 12px;
      line-height: 1.8;
    }

    .footer__columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 46px;
    }

    .footer__label {
      margin-bottom: 14px;
      color: #858c83;
    }

    .footer__columns nav {
      display: grid;
      gap: 7px;
    }

    .footer__columns nav a {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      width: fit-content;
      font-size: 11px;
      font-weight: 600;
    }

    .footer__columns nav a:hover {
      color: #647000;
    }

    .footer__meta {
      display: grid;
      gap: 9px;
      color: #666d65;
      font-family: "DM Mono", monospace;
      font-size: 8px;
      line-height: 1.6;
      letter-spacing: 0.06em;
    }

    .footer__bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      min-height: 56px;
      border-top: 1px solid var(--line);
      color: #7e857c;
      font-family: "DM Mono", monospace;
