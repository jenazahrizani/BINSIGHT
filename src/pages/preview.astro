      @media (max-width: 560px) {
        .navbar__container {
          width: min(
            calc(100% - 24px),
            680px
          );
          min-height: 70px;
        }

        .navbar__brand-name {
          font-size: 0.96rem;
        }

        .navbar__brand-tagline {
          font-size: 0.5rem;
        }

        .navbar__mobile-report,
        .navbar__menu-toggle {
          width: 39px;
          height: 39px;
        }

        .navbar__mobile-menu {
          top: 74px;
        }

        .navbar__mobile-inner {
          width: min(
            calc(100% - 24px),
            680px
          );
          padding-bottom: 28px;
        }

        .navbar__mobile-footer {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .navbar,
        .navbar *,
        .navbar::before,
        .navbar::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
