                data-menu-open
                size={21}
                strokeWidth={1.8}
              />

              <X
                data-menu-close
                size={21}
                strokeWidth={1.8}
              />
            </button>

          </div>

        </div>

        <div
          class="mobile-nav"
          id="mobile-nav"
        >
          <div class="page-width mobile-nav__inner">

            <div class="mobile-nav__top">
              <span>MAIN MENU</span>
              <span>01 — 06</span>
            </div>

            <a href={siteHref("/")}>
              <small>01</small>
              <span>Beranda</span>
              <ArrowRight size={16} />
            </a>

            <a href={siteHref("/map")}>
              <small>02</small>
              <span>Peta</span>
              <ArrowRight size={16} />
            </a>

            <a href={siteHref("/dashboard")}>
              <small>03</small>
              <span>Data</span>
              <ArrowRight size={16} />
            </a>

            <a href={siteHref("/organizations")}>
              <small>04</small>
              <span>Organisasi</span>
              <ArrowRight size={16} />
            </a>

            <a href={siteHref("/waste")}>
              <small>05</small>
              <span>Material</span>
              <ArrowRight size={16} />
            </a>

            <a href="#tentang">
              <small>06</small>
              <span>Tentang</span>
              <ArrowRight size={16} />
            </a>

          </div>
        </div>
      </header>


      <main>

        <!-- ===================================================
             HERO
        ==================================================== -->

        <section class="hero">

          <div class="page-width hero__top">
            <div>
              <span>BADUNG WASTE INTELLIGENCE</span>
            </div>

            <div>
              <span>PUBLIC INFORMATION PLATFORM</span>
            </div>
          </div>


          <div class="page-width hero__grid">

            <div class="hero__main">

              <div class="hero__index">
                <span>01</span>
                <span>OVERVIEW</span>
              </div>

              <h1>
                Kenali
                <span>persampahan</span>
                Badung.
              </h1>

              <p class="hero__intro">
