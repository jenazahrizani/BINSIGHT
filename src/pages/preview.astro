      @media (prefers-reduced-motion: reduce) {
        .organization-card,
        .organization-card__logo,
        .organization-card__footer svg,
        .organization-card__external {
          transition: none;
        }
      }

      /* ==========================================================================
         SINGLE-FILE PREVIEW — WASTECARD
         ========================================================================== */

      .waste-card {
        position: relative;
        display: flex;
        min-height: 260px;
        flex-direction: column;
        color: var(--ink);
        background: var(--white);
        border: 3px solid var(--ink);
        border-radius: 0;
        box-shadow: 8px 8px 0 var(--ink);
        text-decoration: none;
        overflow: hidden;
        transition:
          transform 120ms steps(2, end),
          box-shadow 120ms steps(2, end),
          background 120ms linear;
      }

      .waste-card:hover {
        background: var(--acid);
        transform: translate(-4px, -4px);
        box-shadow: 12px 12px 0 var(--warning);
      }

      .waste-card:focus-visible {
        outline: 4px solid var(--acid);
        outline-offset: 5px;
      }

      .waste-card__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.8rem 1rem;
        border-bottom: 3px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .waste-card__icon {
        display: grid;
        width: 58px;
        height: 58px;
        margin: 1.2rem 1rem 0.9rem;
        place-items: center;
        color: var(--acid);
        background: var(--ink);
        border: 3px solid var(--ink);
        box-shadow: 6px 6px 0 var(--warning);
      }

      .waste-card h3 {
        margin: 0 1rem 0.65rem;
        font-family:
          Sora,
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        text-transform: uppercase;
      }

      .waste-card p {
        margin: 0 1rem 1rem;
        color: #4f534c;
        font-size: 0.92rem;
        line-height: 1.65;
      }

      .waste-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: auto;
        padding: 0.9rem 1rem;
        border-top: 3px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .waste-item {
        min-width: 0;
      }

      .waste-item__index {
        display: inline-flex;
        margin-bottom: 0.75rem;
        padding: 4px 6px;
        color: var(--acid);
        background: var(--ink);
        border: 2px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .waste-item__accent {
        width: 44px;
        height: 4px;
        margin-bottom: 0.9rem;
        background: var(--warning);
      }

      /* ==========================================================================
         ROOT
         ========================================================================== */

      html {
        background: #090a08;
      }

      body {
        margin: 0;
        background: #090a08;
      }

      button,
      a {
        font: inherit;
      }

      ::selection {
        color: #090a08;
        background: #dfff00;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
