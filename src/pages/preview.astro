                      </div>

                      <div class="service-card__link">
                        <span>BUKA AREA</span>

                        <ChevronRight
                          size={17}
                          strokeWidth={1.8}
                        />
                      </div>

                    </a>
                  );
                })
              }

            </div>

          </div>
        </section>


        <!-- =======================================================
             FLOW
        ======================================================== -->

        <section class="flow section">
          <div class="container">

            <div class="flow-box">

              <div class="flow-box__intro">

                <div class="section-heading__label">
                  <span class="section-number section-number--light">
                    03
                  </span>

                  <span class="section-kicker section-kicker--light">
                    CARA KERJA
                  </span>
                </div>

                <h2>
                  Dari informasi
                  <br />
                  menjadi konteks.
                </h2>

                <p>
                  BINSIGHT tidak hanya menampilkan informasi. Platform ini
                  menyusunnya berdasarkan hubungan antara lokasi, data,
                  manusia, dan material.
                </p>

              </div>


              <div class="flow-list">

                <div class="flow-item">

                  <div class="flow-item__number">
                    01
                  </div>

                  <div class="flow-item__content">
                    <span>TEMUKAN</span>

                    <h3>
                      Lokasi & informasi
                    </h3>

                    <p>
                      Mulai dari tempat dan informasi yang tersedia.
                    </p>
                  </div>

                  <Map
                    size={25}
                    strokeWidth={1.7}
                  />

                </div>


                <div class="flow-item">

                  <div class="flow-item__number">
                    02
                  </div>

                  <div class="flow-item__content">
                    <span>PAHAMI</span>

                    <h3>
                      Data & material
                    </h3>

                    <p>
                      Pelajari konteks yang berada di balik informasi.
                    </p>
                  </div>

                  <ChartColumn
                    size={25}
                    strokeWidth={1.7}
                  />

                </div>


                <div class="flow-item">

                  <div class="flow-item__number">
                    03
                  </div>

                  <div class="flow-item__content">
                    <span>TERHUBUNG</span>

                    <h3>
                      Organisasi & jaringan
                    </h3>

                    <p>
                      Kenali pihak yang membentuk ekosistem persampahan.
                    </p>
                  </div>

                  <Building2
                    size={25}
                    strokeWidth={1.7}
                  />

                </div>

              </div>

            </div>

          </div>
        </section>


        <!-- =======================================================
             PRINCIPLES
        ======================================================== -->

        <section
          class="principles section"
          id="about"
        >
          <div class="container">

            <div class="section-heading">

              <div class="section-heading__label">
                <span class="section-number">04</span>
                <span class="section-kicker">PRINSIP</span>
              </div>

              <div class="section-heading__content">

                <h2>
                  Dibangun untuk
                  <span>dipercaya.</span>
                </h2>

                <p>
                  Struktur informasi BINSIGHT dirancang agar tetap
                  sederhana, terbuka, dan bertanggung jawab dalam
                  menyajikan informasi publik.
                </p>

              </div>

            </div>


            <div class="principle-grid">

              {
                principles.map((principle) => (
                  <article class="principle-card">

                    <div class="principle-card__number">
                      {principle.number}
                    </div>

                    <div class="principle-card__main">
                      <h3>
                        {principle.title}
                      </h3>

                      <p>
                        {principle.description}
                      </p>
                    </div>

                    <span class="principle-card__check">
                      <Check
                        size={17}
                        strokeWidth={2.2}
                      />
                    </span>

                  </article>
                ))
              }

            </div>

          </div>
        </section>


        <!-- =======================================================
             ECOSYSTEM
        ======================================================== -->

        <section class="ecosystem section">
          <div class="container">

            <div class="section-heading">

              <div class="section-heading__label">
                <span class="section-number">05</span>
                <span class="section-kicker">EKOSISTEM</span>
              </div>

              <div class="section-heading__content">

                <h2>
                  Informasi tumbuh
                  <span>bersama konteks.</span>
                </h2>

                <p>
                  Direktori membantu pengguna melihat pihak dan wilayah
                  yang berhubungan dengan ekosistem persampahan Badung.
                </p>

              </div>

            </div>


            <div class="directory">

              <div class="directory__header">
                <div>NO.</div>
                <div>NAMA</div>
                <div>TIPE</div>
                <div>AREA</div>
                <div>STATUS</div>
              </div>


              {
                organizations.map((organization) => (
                  <a
                    href={siteHref("/organizations")}
                    class="directory__row"
                  >

                    <span class="directory__number">
                      {organization.number}
                    </span>

                    <strong>
                      {organization.name}
                    </strong>

                    <span>
                      {organization.type}
                    </span>

                    <span>
                      {organization.area}
                    </span>

                    <span class="directory__status">
                      <ShieldCheck
                        size={15}
                        strokeWidth={1.8}
                      />

                      {organization.status}
                    </span>

                  </a>
                ))
              }


              <a
                href={siteHref("/organizations")}
                class="directory__footer"
              >
                <span>
                  LIHAT SELURUH ORGANISASI
                </span>

                <ArrowRight
                  size={17}
                  strokeWidth={1.8}
                />
              </a>

            </div>

          </div>
        </section>


        <!-- =======================================================
             MATERIALS
        ======================================================== -->

        <section class="materials section">
          <div class="container">

            <div class="materials-layout">

              <div class="materials-intro">

                <div class="section-heading__label">
                  <span class="section-number">06</span>
                  <span class="section-kicker">MATERIAL</span>
                </div>

                <h2>
                  Kenali
                  <span>materialnya.</span>
                </h2>

                <p>
                  Setiap jenis sampah memiliki karakter yang berbeda.
                  Memahami material menjadi langkah awal untuk memahami
                  cara penanganannya.
                </p>

                <a
                  href={siteHref("/waste")}
                  class="text-link"
                >
                  <span>Pelajari semua material</span>

                  <ArrowRight
                    size={17}
                    strokeWidth={1.8}
                  />
                </a>

              </div>


              <div class="materials-list">

                {
                  materials.map((material) => (
                    <a
                      href={siteHref("/waste")}
                      class="material-row"
                    >

                      <span class="material-row__number">
                        {material.number}
                      </span>

                      <span class="material-row__name">
                        {material.name}
                      </span>

                      <span class="material-row__code">
                        {material.code}
                      </span>

                      <ChevronRight
                        class="material-row__arrow"
                        size={18}
                        strokeWidth={1.8}
                      />

                    </a>
                  ))
                }

              </div>

            </div>

          </div>
        </section>


        <!-- =======================================================
             CLOSING
        ======================================================== -->

        <section class="closing">
          <div class="container">

            <div class="closing__inner">

              <div class="closing__label">
                <span>07</span>
                <span>BINSIGHT</span>
              </div>

              <div class="closing__content">

                <h2>
                  Kenali.
                  <br />
                  Pahami.
                  <br />
                  <strong>Jaga Badung.</strong>
                </h2>

                <p>
                  Satu ruang untuk melihat informasi persampahan secara
                  lebih jelas, terstruktur, dan kontekstual.
                </p>

              </div>

              <a
                href={siteHref("/map")}
                class="closing__button"
              >
                <span>Mulai menjelajah</span>

                <ArrowUpRight
                  size={20}
                  strokeWidth={1.8}
                />
              </a>

            </div>

          </div>
        </section>

      </main>


      <!-- =========================================================
           FOOTER
      ========================================================== -->

      <footer class="footer">

        <div class="container footer__top">

          <div class="footer__brand">

            <a
              href={siteHref("/")}
              class="brand brand--footer"
            >
              <span class="brand__mark" aria-hidden="true">
                <span></span>
                <span></span>
              </span>

              <span class="brand__copy">
                <strong>BINSIGHT</strong>
                <small>BADUNG WASTE INTELLIGENCE</small>
              </span>
            </a>

            <p>
              Platform informasi persampahan Kabupaten Badung.
            </p>

          </div>


          <div class="footer__columns">

            <div>
              <span class="footer__heading">
                PLATFORM
              </span>

              <a href={siteHref("/map")}>
                Peta
              </a>

              <a href={siteHref("/dashboard")}>
                Data
              </a>

              <a href={siteHref("/organizations")}>
                Organisasi
              </a>

              <a href={siteHref("/waste")}>
                Jenis Sampah
              </a>
            </div>


            <div>
              <span class="footer__heading">
                INFORMASI
              </span>

              <a href="#about">
                Tentang BINSIGHT
              </a>

              <a href={siteHref("/map")}>
                Eksplorasi
              </a>
            </div>

          </div>

        </div>


        <div class="container footer__bottom">

          <span>
            © {currentYear} BINSIGHT
          </span>

          <span>
            BADUNG WASTE INTELLIGENCE
          </span>

          <span>
            PUBLIC INFORMATION PLATFORM
          </span>

        </div>

      </footer>


      <!-- =========================================================
           ONLY REPORT ACTION
      ========================================================== -->

      <a
        href={siteHref("/reports/create")}
        class="floating-report"
        aria-label="Buat laporan masyarakat"
      >

        <span class="floating-report__icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>

        <span class="floating-report__copy">
          <small>LAPORAN MASYARAKAT</small>
          <strong>Buat Laporan</strong>
        </span>

        <ArrowUpRight
          size={18}
          strokeWidth={2}
        />

      </a>

    </div>


    <!-- ===========================================================
         MOBILE MENU SCRIPT
    ============================================================ -->

    <script>
      const menuTrigger =
        document.querySelector<HTMLButtonElement>(".menu-trigger");

      const mobileMenu =
        document.querySelector<HTMLElement>(".mobile-menu");

      const menuOpen =
        document.querySelector<SVGElement>("[data-menu-open]");

      const menuClose =
        document.querySelector<SVGElement>("[data-menu-close]");

      const setMenu = (open: boolean) => {
        if (!menuTrigger || !mobileMenu) return;

        menuTrigger.setAttribute(
          "aria-expanded",
          String(open)
        );

        menuTrigger.setAttribute(
          "aria-label",
          open ? "Tutup menu" : "Buka menu"
        );

        mobileMenu.classList.toggle(
          "is-open",
          open
        );

        if (menuOpen instanceof HTMLElement) {
          menuOpen.style.display = open
            ? "none"
            : "block";
        }

        if (menuClose instanceof HTMLElement) {
          menuClose.style.display = open
            ? "block"
            : "none";
        }
      };

      setMenu(false);

      menuTrigger?.addEventListener("click", () => {
        const currentlyOpen =
          menuTrigger.getAttribute("aria-expanded") === "true";

        setMenu(!currentlyOpen);
      });

      document
        .querySelectorAll<HTMLAnchorElement>(".mobile-menu a")
        .forEach((link) => {
          link.addEventListener("click", () => {
            setMenu(false);
          });
        });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 900) {
          setMenu(false);
        }
      });
    </script>


    <style>
      :root {
        --green-950: #09241d;
        --green-900: #0d2f25;
        --green-800: #154739;
        --green-700: #1f5b49;

        --green-100: #e4eee9;
        --green-50: #f1f6f3;

        --ink: #14201c;
        --muted: #62716b;
        --line: #d8e0dc;
        --line-dark: rgba(255, 255, 255, 0.16);

        --paper: #ffffff;
        --surface: #f6f8f6;
        --accent: #d6e94a;

        --max: 1240px;
      }


      /* =========================================================
         RESET
      ========================================================== */

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "Inter", sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      img,
      svg {
        max-width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      .site {
        min-height: 100vh;
        overflow: clip;
      }

      .container {
        width: min(
          calc(100% - 48px),
          var(--max)
        );

        margin: 0 auto;
      }


      /* =========================================================
         HEADER
      ========================================================== */

      .header {
        position: sticky;
        top: 0;
        z-index: 100;

        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(12px);

        border-bottom: 1px solid var(--line);
      }

      .header__inner {
        min-height: 76px;

        display: grid;
        grid-template-columns: 1fr auto 1fr;

        align-items: center;

        gap: 32px;
      }

      .brand {
        display: inline-flex;
        align-items: center;

        gap: 12px;

        width: max-content;
      }

      .brand__mark {
        width: 32px;
        height: 32px;

        display: grid;

        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr);

        gap: 3px;
      }

      .brand__mark span {
        display: block;
        background: var(--green-900);
      }

      .brand__mark span:last-child {
        background: var(--accent);
      }

      .brand__copy {
        display: grid;
        gap: 2px;
      }

      .brand__copy strong {
        font-size: 16px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.02em;
      }

      .brand__copy small {
        color: var(--muted);
        font-family: "DM Mono", monospace;
        font-size: 8px;
        line-height: 1.2;
        letter-spacing: 0.08em;
      }

      .desktop-nav {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .desktop-nav a {
        position: relative;

        color: #3c4a45;

        font-size: 13px;
        font-weight: 600;

        transition: color 180ms ease;
      }

      .desktop-nav a::after {
        content: "";

        position: absolute;

        left: 0;
        right: 0;
        bottom: -28px;

        height: 2px;

        background: var(--green-900);

        transform: scaleX(0);
        transform-origin: center;

        transition: transform 180ms ease;
      }

      .desktop-nav a:hover {
        color: var(--green-900);
      }

      .desktop-nav a:hover::after {
        transform: scaleX(1);
      }

      .header__right {
        justify-self: end;

        display: flex;
        align-items: center;

        gap: 8px;
      }

      .header-search {
        min-height: 38px;

        padding: 0 13px;

        display: inline-flex;
        align-items: center;

        gap: 8px;

        border: 1px solid var(--line);

        color: var(--green-900);

        font-family: "DM Mono", monospace;
        font-size: 9px;
        letter-spacing: 0.08em;

        transition:
          background 180ms ease,
          border-color 180ms ease;
      }

      .header-search:hover {
        background: var(--green-50);
        border-color: #b9c7c1;
      }

      .menu-trigger {
        width: 38px;
        height: 38px;

        display: none;

        align-items: center;
        justify-content: center;

        border: 1px solid var(--line);

        background: white;
        color: var(--green-900);

        cursor: pointer;
      }

      .menu-trigger [data-menu-close] {
        display: none;
      }

      .mobile-menu {
        display: none;

        border-top: 1px solid var(--line);
      }

      .mobile-menu__inner {
        width: min(
          calc(100% - 48px),
          var(--max)
        );

        margin: 0 auto;

        padding: 8px 0 22px;
      }

      .mobile-menu a {
        min-height: 50px;

        display: flex;
        align-items: center;

        border-bottom: 1px solid var(--line);

        font-size: 15px;
        font-weight: 600;
      }


      /* =========================================================
         HERO
      ========================================================== */

      .hero {
        background: var(--green-900);
        color: white;
      }

      .hero__inner {
        min-height: 690px;

        padding-top: 86px;
        padding-bottom: 0;

        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .hero__eyebrow {
        display: flex;
        align-items: center;

        gap: 12px;

        margin-bottom: 34px;
      }

      .hero__eyebrow-line {
        width: 42px;
        height: 2px;

        background: var(--accent);
      }

      .hero__eyebrow small {
        color: rgba(255, 255, 255, 0.55);

        font-family: "DM Mono", monospace;

        font-size: 9px;

        line-height: 1.2;

        letter-spacing: 0.1em;
      }

      .hero h1 {
        max-width: 1000px;

        margin: 0;

        font-size: clamp(
          58px,
          8vw,
          108px
        );

        line-height: 0.94;

        letter-spacing: -0.065em;

        font-weight: 600;
      }

      .hero h1 strong {
        display: block;

        color: var(--accent);

        font-weight: 700;
      }

      .hero__bottom {
        margin-top: 52px;

        display: grid;

        grid-template-columns:
          minmax(0, 600px)
          auto;

        align-items: end;

        justify-content: space-between;

        gap: 60px;
      }

      .hero__bottom p {
        max-width: 600px;

        margin: 0;

        color: rgba(255, 255, 255, 0.68);

        font-size: 17px;
        line-height: 1.72;
      }

      .hero__actions {
        display: flex;
        align-items: center;

        gap: 10px;

        flex-wrap: wrap;
      }

      .button {
        min-height: 50px;

        padding: 0 18px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 10px;

        border: 1px solid transparent;

        font-size: 13px;
        font-weight: 700;

        transition:
          background 180ms ease,
          border-color 180ms ease,
          color 180ms ease;
      }

      .button--primary {
        background: var(--accent);
        color: var(--green-950);
      }

      .button--primary:hover {
        background: #e4f25e;
      }

      .button--secondary {
        border-color: rgba(255, 255, 255, 0.24);

        color: white;
      }

      .button--secondary:hover {
        border-color: rgba(255, 255, 255, 0.48);

        background: rgba(255, 255, 255, 0.05);
      }

      .hero__meta {
        margin-top: 78px;

        min-height: 84px;

        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        border-top:
          1px solid
          rgba(255, 255, 255, 0.16);
      }

      .hero__meta > div {
        padding: 20px 24px;

        display: flex;
        flex-direction: column;

        justify-content: center;

        gap: 7px;

        border-right:
          1px solid
          rgba(255, 255, 255, 0.16);
      }

      .hero__meta > div:first-child {
        padding-left: 0;
      }

      .hero__meta > div:last-child {
        border-right: 0;
      }

      .hero__meta span {
        color: rgba(255, 255, 255, 0.38);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.1em;
      }

      .hero__meta strong {
        color: rgba(255, 255, 255, 0.82);

        font-size: 12px;

        font-weight: 600;

        letter-spacing: 0.01em;
      }


      /* =========================================================
         INTRO
      ========================================================== */

      .intro-strip {
        background: white;

        border-bottom:
          1px solid
          var(--line);
      }

      .intro-strip__grid {
        min-height: 150px;

        display: grid;

        grid-template-columns:
          180px
          minmax(0, 1fr)
          250px;

        align-items: center;
      }

      .intro-strip__label {
        align-self: stretch;

        display: flex;

        flex-direction: column;

        justify-content: center;

        gap: 7px;

        border-right:
          1px solid
          var(--line);

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 9px;

        letter-spacing: 0.08em;
      }

      .intro-strip__label span:last-child {
        color: var(--green-900);
      }

      .intro-strip__text {
        padding:
          30px
          48px;
      }

      .intro-strip__text p {
        max-width: 670px;

        margin: 0;

        font-size: 20px;

        line-height: 1.58;

        letter-spacing: -0.018em;
      }

      .intro-strip__aside {
        height: 100%;

        padding-left: 26px;

        display: flex;
        flex-direction: column;

        justify-content: center;

        gap: 9px;

        border-left:
          1px solid
          var(--line);
      }

      .intro-strip__aside span,
      .intro-strip__aside strong {
        font-family: "DM Mono", monospace;

        font-size: 9px;

        letter-spacing: 0.08em;
      }

      .intro-strip__aside span {
        color: var(--muted);
      }

      .intro-strip__aside strong {
        max-width: 180px;

        color: var(--green-900);

        font-weight: 500;

        line-height: 1.55;
      }


      /* =========================================================
         SECTION HEADING
      ========================================================== */

      .section {
        padding: 120px 0;
      }

      .section-heading {
        display: grid;

        grid-template-columns:
          180px
          minmax(0, 1fr);

        column-gap: 34px;

        align-items: start;

        margin-bottom: 60px;
      }

      .section-heading__label {
        display: flex;
        align-items: center;

        gap: 10px;

        padding-top: 8px;
      }

      .section-number {
        color: var(--green-900);

        font-family: "DM Mono", monospace;

        font-size: 11px;
      }

      .section-kicker {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 9px;

        letter-spacing: 0.1em;
      }

      .section-heading__content h2 {
        max-width: 780px;

        margin: 0;

        font-size: clamp(
          44px,
          5vw,
          72px
        );

        line-height: 0.98;

        letter-spacing: -0.055em;

        font-weight: 600;
      }

      .section-heading__content h2 span {
        display: block;

        color: var(--green-800);
      }

      .section-heading__content > p {
        max-width: 600px;

        margin: 25px 0 0;

        color: var(--muted);

        font-size: 16px;

        line-height: 1.75;
      }


      /* =========================================================
         SERVICES
      ========================================================== */

      .service-grid {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        border-top:
          1px solid
          var(--line);

        border-left:
          1px solid
          var(--line);
      }

      .service-card {
        min-height: 390px;

        padding: 28px;

        position: relative;

        display: flex;

        flex-direction: column;

        border-right:
          1px solid
          var(--line);

        border-bottom:
          1px solid
          var(--line);

        transition:
          background 180ms ease;
      }

      .service-card:hover {
        background: var(--green-50);
      }

      .service-card__header {
        display: flex;

        justify-content: space-between;

        align-items: center;

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 10px;
      }

      .service-card__icon {
        width: 56px;
        height: 56px;

        margin-top: auto;
        margin-bottom: 32px;

        display: grid;
        place-items: center;

        border: 1px solid var(--line);

        background: white;

        color: var(--green-900);
      }

      .service-card__body h3 {
        margin: 0;

        font-size: 28px;

        line-height: 1.12;

        letter-spacing: -0.03em;

        font-weight: 700;
      }

      .service-card__body p {
        max-width: 520px;

        margin: 14px 0 0;

        color: var(--muted);

        font-size: 15px;

        line-height: 1.7;
      }

      .service-card__link {
        margin-top: 28px;

        display: flex;

        align-items: center;

        gap: 8px;

        color: var(--green-900);

        font-family: "DM Mono", monospace;

        font-size: 9px;

        letter-spacing: 0.08em;
      }


      /* =========================================================
         FLOW
      ========================================================== */

      .flow {
        background: var(--surface);
      }

      .flow-box {
        display: grid;

        grid-template-columns:
          minmax(0, 0.86fr)
          minmax(0, 1.14fr);

        background: var(--green-900);

        color: white;
      }

      .flow-box__intro {
        padding: 58px;

        border-right:
          1px solid
          var(--line-dark);
      }

      .section-number--light {
        color: var(--accent);
      }

      .section-kicker--light {
        color: rgba(255, 255, 255, 0.5);
      }

      .flow-box__intro h2 {
        margin: 38px 0 20px;

        font-size: clamp(
          40px,
          4vw,
          60px
        );

        line-height: 1;

        letter-spacing: -0.05em;

        font-weight: 600;
      }

      .flow-box__intro p {
        max-width: 450px;

        margin: 0;

        color: rgba(255, 255, 255, 0.68);

        font-size: 15px;

        line-height: 1.75;
      }

      .flow-list {
        display: flex;

        flex-direction: column;
      }

      .flow-item {
        min-height: 170px;

        padding: 28px 30px;

        display: grid;

        grid-template-columns:
          54px
          minmax(0, 1fr)
          auto;

        align-items: center;

        gap: 24px;

        border-bottom:
          1px solid
          var(--line-dark);
      }

      .flow-item:last-child {
        border-bottom: 0;
      }

      .flow-item__number {
        width: 48px;
        height: 48px;

        display: grid;
        place-items: center;

        border: 1px solid
          rgba(255, 255, 255, 0.18);

        color: var(--accent);

        font-family: "DM Mono", monospace;

        font-size: 10px;
      }

      .flow-item__content {
        display: grid;

        gap: 6px;
      }

      .flow-item__content > span {
        color: rgba(255, 255, 255, 0.45);

        font-family: "DM Mono", monospace;

        font-size: 9px;

        letter-spacing: 0.08em;
      }

      .flow-item__content h3 {
        margin: 0;

        font-size: 22px;

        line-height: 1.2;

        letter-spacing: -0.025em;
      }

      .flow-item__content p {
        margin: 3px 0 0;

        color: rgba(255, 255, 255, 0.58);

        font-size: 13px;

        line-height: 1.5;
      }

      .flow-item > svg {
        color: rgba(255, 255, 255, 0.5);
      }


      /* =========================================================
         PRINCIPLES
      ========================================================== */

      .principle-grid {
        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        border-top:
          1px solid
          var(--line);

        border-left:
          1px solid
          var(--line);
      }

      .principle-card {
        min-height: 300px;

        position: relative;

        padding: 30px;

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        border-right:
          1px solid
          var(--line);

        border-bottom:
          1px solid
          var(--line);
      }

      .principle-card__number {
        color: var(--green-700);

        font-family: "DM Mono", monospace;

        font-size: 10px;
      }

      .principle-card__main {
        padding-top: 40px;
      }

      .principle-card h3 {
        margin: 0;

        font-size: 29px;

        letter-spacing: -0.035em;
      }

      .principle-card p {
        max-width: 330px;

        margin: 14px 0 0;

        color: var(--muted);

        font-size: 15px;

        line-height: 1.7;
      }

      .principle-card__check {
        position: absolute;

        top: 28px;
        right: 28px;

        width: 32px;
        height: 32px;

        display: grid;
        place-items: center;

        background: var(--green-50);

        color: var(--green-900);
      }


      /* =========================================================
         DIRECTORY
      ========================================================== */

      .directory {
        border-top:
          1px solid
          var(--line);

        border-left:
          1px solid
          var(--line);
      }

      .directory__header,
      .directory__row {
        display: grid;

        grid-template-columns:
          72px
          minmax(180px, 1.2fr)
          minmax(120px, 0.7fr)
          minmax(160px, 1fr)
          180px;

        align-items: center;
      }

      .directory__header {
        min-height: 50px;

        background: var(--green-900);

        color: rgba(255, 255, 255, 0.58);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.08em;
      }

      .directory__header > div,
      .directory__row > span,
      .directory__row > strong {
        min-width: 0;
        padding: 0 18px;
      }

      .directory__row {
        min-height: 82px;

        border-right:
          1px solid
          var(--line);

        border-bottom:
          1px solid
          var(--line);

        transition:
          background 180ms ease;
      }

      .directory__row:hover {
        background: var(--green-50);
      }

      .directory__number {
        color: var(--green-700);

        font-family: "DM Mono", monospace;

        font-size: 10px;
      }

      .directory__row strong {
        font-size: 16px;
        font-weight: 700;
      }

      .directory__row > span:not(.directory__number):not(.directory__status) {
        color: var(--muted);

        font-size: 13px;
      }

      .directory__status {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        color: var(--green-700);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.03em;
      }

      .directory__footer {
        min-height: 62px;

        padding: 0 18px;

        display: flex;

        align-items: center;

        justify-content: flex-end;

        gap: 10px;

        border-right:
          1px solid
          var(--line);

        color: var(--green-900);

        font-family: "DM Mono", monospace;

        font-size: 9px;

        letter-spacing: 0.08em;
      }

      .directory__footer:hover {
        background: var(--green-50);
      }


      /* =========================================================
         MATERIALS
      ========================================================== */

      .materials {
        background: var(--surface);
      }

      .materials-layout {
        display: grid;

        grid-template-columns:
          minmax(0, 0.84fr)
          minmax(0, 1.16fr);

        gap: 100px;

        align-items: start;
      }

      .materials-intro h2 {
        margin: 34px 0 0;

        font-size: clamp(
          44px,
          5vw,
          68px
        );

        line-height: 0.98;

        letter-spacing: -0.055em;

        font-weight: 600;
      }

      .materials-intro h2 span {
        display: block;

        color: var(--green-800);
      }

      .materials-intro p {
        max-width: 470px;

        margin: 26px 0 0;

        color: var(--muted);

        font-size: 16px;

        line-height: 1.75;
      }

      .text-link {
        margin-top: 32px;

        display: inline-flex;

        align-items: center;

        gap: 9px;

        color: var(--green-900);

        font-size: 13px;

        font-weight: 700;
      }

      .text-link:hover {
        text-decoration: underline;

        text-underline-offset: 4px;
      }

      .materials-list {
        border-top:
          1px solid
          var(--line);

        border-left:
          1px solid
          var(--line);
      }

      .material-row {
        min-height: 88px;

        display: grid;

        grid-template-columns:
          70px
          minmax(0, 1fr)
          70px
          30px;

        align-items: center;

        gap: 16px;

        padding: 0 20px;

        border-right:
          1px solid
          var(--line);

        border-bottom:
          1px solid
          var(--line);

        background: white;

        transition:
          background 180ms ease;
      }

      .material-row:hover {
        background: var(--green-50);
      }

      .material-row__number,
      .material-row__code {
        font-family: "DM Mono", monospace;

        font-size: 9px;
      }

      .material-row__number {
        color: var(--muted);
      }

      .material-row__name {
        font-size: 17px;

        font-weight: 700;
      }

      .material-row__code {
        color: var(--green-700);

        text-align: right;
      }

      .material-row__arrow {
        color: var(--muted);
      }


      /* =========================================================
         CLOSING
      ========================================================== */

      .closing {
        padding: 120px 0;

        background: var(--green-100);
      }

      .closing__inner {
        display: grid;

        grid-template-columns:
          160px
          minmax(0, 1fr)
          auto;

        gap: 50px;

        align-items: end;
      }

      .closing__label {
        display: grid;

        gap: 7px;

        color: var(--green-800);

        font-family: "DM Mono", monospace;

        font-size: 9px;

        letter-spacing: 0.08em;
      }

      .closing__content h2 {
        margin: 0;

        font-size: clamp(
          55px,
          7vw,
          96px
        );

        line-height: 0.94;

        letter-spacing: -0.06em;

        font-weight: 600;
      }

      .closing__content h2 strong {
        color: var(--green-900);
      }

      .closing__content p {
        max-width: 550px;

        margin: 26px 0 0;

        color: var(--muted);

        font-size: 16px;

        line-height: 1.7;
      }

      .closing__button {
        min-height: 52px;

        padding: 0 18px;

        display: inline-flex;

        align-items: center;

        gap: 10px;

        background: var(--green-900);

        color: white;

        font-size: 13px;

        font-weight: 700;

        white-space: nowrap;

        transition:
          background 180ms ease;
      }

      .closing__button:hover {
        background: var(--green-800);
      }


      /* =========================================================
         FOOTER
      ========================================================== */

      .footer {
        background: var(--green-950);

        color: white;
      }

      .footer__top {
        padding-top: 70px;
        padding-bottom: 70px;

        display: grid;

        grid-template-columns:
          minmax(0, 1.2fr)
          minmax(300px, 0.8fr);

        gap: 80px;
      }

      .brand--footer .brand__copy strong {
        color: white;
      }

      .brand--footer .brand__copy small {
        color: rgba(255, 255, 255, 0.42);
      }

      .brand--footer .brand__mark span {
        background: white;
      }

      .brand--footer .brand__mark span:last-child {
        background: var(--accent);
      }

      .footer__brand p {
        max-width: 400px;

        margin: 26px 0 0;

        color: rgba(255, 255, 255, 0.52);

        font-size: 14px;

        line-height: 1.65;
      }

      .footer__columns {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 40px;
      }

      .footer__columns > div {
        display: flex;

        flex-direction: column;

        align-items: flex-start;
      }

      .footer__heading {
        margin-bottom: 17px;

        color: rgba(255, 255, 255, 0.38);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.1em;
      }

      .footer__columns a {
        margin-bottom: 12px;

        color: rgba(255, 255, 255, 0.74);

        font-size: 13px;
      }

      .footer__columns a:hover {
        color: white;
      }

      .footer__bottom {
        min-height: 62px;

        display: grid;

        grid-template-columns:
          1fr
          1fr
          1fr;

        align-items: center;

        gap: 20px;

        border-top:
          1px solid
          rgba(255, 255, 255, 0.1);

        color: rgba(255, 255, 255, 0.36);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.06em;
      }

      .footer__bottom span:nth-child(2) {
        text-align: center;
      }

