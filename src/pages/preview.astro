      /* ==========================================================================
         BINSIGHT // BRUTALIST FOOTER
         ========================================================================== */

      .footer {
        --acid: #dfff00;
        --acid-soft: #efff70;
        --ink: #090a08;
        --ink-2: #11130f;
        --ink-3: #1b1f18;
        --paper: #f2f0e6;
        --paper-2: #e4e1d4;
        --white: #fffef8;
        --muted: #8e948b;
        --line: rgba(255, 254, 248, 0.18);
        --orange: #ff6a00;

        position: relative;
        isolation: isolate;
        margin-top: 0;
        overflow: hidden;
        color: var(--white);
        background: var(--ink);
        border-top: 8px solid var(--acid);
      }

      .footer::before {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        content: "";
        background-image:
          linear-gradient(
            rgba(255, 255, 255, 0.045) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.045) 1px,
            transparent 1px
          );
        background-size: 24px 24px;
        opacity: 0.45;
      }

      .footer::after {
        position: absolute;
        top: -110px;
        right: -90px;
        z-index: -1;
        width: 420px;
        height: 320px;
        content: "";
        background: var(--acid);
        clip-path: polygon(
          0 16%,
          78% 0,
          100% 72%,
          28% 100%
        );
        opacity: 0.08;
        pointer-events: none;
      }

      .footer__main,
      .footer__platform,
      .footer__contact {
        position: relative;
      }

      .footer__main {
        border-top: 0;
      }

      .footer__container {
        width: min(1320px, calc(100% - 40px));
        margin-inline: auto;
      }

      .footer__top {
        display: grid;
        grid-template-columns:
          minmax(280px, 1.1fr)
          minmax(0, 1fr);
        gap: 70px;
        padding: 74px 0 56px;
      }

      .footer__identity {
        min-width: 0;
      }

      .footer__brand {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        color: var(--white);
        text-decoration: none;
      }

      .footer__brand-mark {
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        background: var(--acid);
        border: 3px solid var(--white);
        box-shadow: 7px 7px 0 var(--orange);
      }

      .footer__brand-mark img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .footer__brand-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .footer__brand-name {
        color: var(--white);
        font-family:
          Sora,
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
        font-size: 1.3rem;
        font-weight: 900;
        line-height: 0.95;
        letter-spacing: -0.04em;
      }

      .footer__brand-tagline {
        margin-top: 7px;
        color: var(--acid);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.62rem;
        font-weight: 900;
        line-height: 1.2;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .footer__description {
        max-width: 530px;
        margin: 28px 0 20px;
        padding-left: 16px;
        color: #c7cbc2;
        border-left: 7px solid var(--acid);
        font-size: 0.92rem;
        font-weight: 500;
        line-height: 1.75;
      }

      .footer__location {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 7px 9px;
        color: var(--ink);
        background: var(--acid);
        border: 2px solid var(--ink);
        box-shadow: 4px 4px 0 var(--white);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.62rem;
        font-weight: 900;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .footer__location svg {
        flex-shrink: 0;
        color: var(--ink);
      }

      .footer__socials {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
      }

      .footer__social {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        color: var(--white);
        background: transparent;
        border: 2px solid var(--white);
        border-radius: 0;
        text-decoration: none;
        transition:
          transform 120ms steps(2, end),
          color 120ms linear,
          background 120ms linear,
          box-shadow 120ms steps(2, end);
      }

      .footer__social:hover {
        color: var(--ink);
        background: var(--acid);
        border-color: var(--ink);
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--orange);
      }

      .footer__columns {
        display: grid;
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .footer__column {
        min-width: 0;
      }

      .footer__heading {
        display: inline-block;
        margin: 0 0 18px;
        padding: 6px 8px;
        color: var(--ink);
        background: var(--acid);
        border: 2px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.62rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .footer__links {
        display: grid;
        gap: 4px;
        border-top: 2px solid var(--white);
      }

      .footer__link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 42px;
        padding: 7px 0;
        color: #b7beb5;
        border-bottom: 1px solid var(--line);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.4;
        text-decoration: none;
        transition:
          color 120ms linear,
          transform 120ms steps(2, end),
          padding 120ms steps(2, end);
      }

      .footer__link svg {
        flex: 0 0 auto;
        color: var(--acid);
        opacity: 0.75;
        transform: translate(-3px, 3px);
        transition:
          opacity 120ms linear,
          transform 120ms steps(2, end);
      }

      .footer__link:hover {
        color: var(--white);
        padding-left: 6px;
      }

      .footer__link:hover svg {
        opacity: 1;
        transform: translate(0, 0);
      }

      .footer__platform {
        padding: 38px 0 34px;
        border-top: 4px solid var(--white);
        border-bottom: 4px solid var(--white);
        background: var(--ink-2);
      }

      .footer__platform-header {
        display: grid;
        grid-template-columns:
          minmax(0, 1fr) auto;
        align-items: end;
        gap: 28px;
      }

      .footer__eyebrow {
        display: inline-block;
        margin: 0 0 14px;
        padding: 6px 8px;
        color: var(--ink);
        background: var(--acid);
        border: 2px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.58rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .footer__platform-title {
        max-width: 760px;
        margin: 0;
        color: var(--white);
        font-family:
          Sora,
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
        font-size: clamp(34px, 4.2vw, 62px);
        font-weight: 900;
        line-height: 0.9;
        letter-spacing: -0.07em;
        text-transform: uppercase;
      }

      .footer__platform-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 50px;
        padding: 0 16px;
        color: var(--ink);
        background: var(--acid);
        border: 3px solid var(--ink);
        box-shadow: 7px 7px 0 var(--white);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.05em;
        text-decoration: none;
        text-transform: uppercase;
        transition:
          transform 120ms steps(2, end),
          box-shadow 120ms steps(2, end),
          background 120ms linear;
      }

      .footer__platform-link:hover {
        background: var(--acid-soft);
        transform: translate(-3px, -3px);
        box-shadow: 10px 10px 0 var(--orange);
      }

      .footer__feature-grid {
        display: grid;
        grid-template-columns:
          repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-top: 28px;
      }

      .footer__feature {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        min-width: 0;
        padding: 16px;
        color: inherit;
        background: var(--ink-3);
        border: 3px solid var(--white);
        border-radius: 0;
        text-decoration: none;
        box-shadow: 5px 5px 0 var(--acid);
        transition:
          transform 120ms steps(2, end),
          box-shadow 120ms steps(2, end),
          background 120ms linear;
      }

      .footer__feature:hover {
        background: #22261e;
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0 var(--orange);
      }

      .footer__feature-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        color: var(--ink);
        background: var(--acid);
        border: 2px solid var(--ink);
        border-radius: 0;
      }

      .footer__feature-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .footer__feature-content strong {
        color: var(--white);
        font-family:
          Sora,
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
        font-size: 0.78rem;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -0.03em;
        text-transform: uppercase;
      }

      .footer__feature-content small {
        color: #aab0a7;
        font-size: 0.68rem;
        font-weight: 500;
        line-height: 1.55;
      }

      .footer__contact {
        display: grid;
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
        gap: 10px;
        padding: 26px 0;
      }

      .footer__contact-item {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
        padding: 13px;
        background: var(--ink-2);
        border: 2px solid var(--white);
      }

      .footer__contact-icon {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        color: var(--ink);
        background: var(--acid);
        border: 2px solid var(--ink);
        border-radius: 0;
      }

      .footer__contact-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
      }

      .footer__contact-label {
        color: var(--acid);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.56rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .footer__contact-copy > a,
      .footer__contact-copy > span:last-child {
        overflow: hidden;
        color: #d0d5cd;
        font-size: 0.7rem;
        font-weight: 650;
        line-height: 1.4;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .footer__contact-copy > a {
        text-decoration: none;
        transition: color 120ms linear;
      }

      .footer__contact-copy > a:hover {
        color: var(--acid);
      }

      .footer__bottom {
        border-top: 4px solid var(--acid);
        background: var(--ink);
      }

      .footer__bottom-inner {
        min-height: 60px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 18px;
      }

      .footer__copyright,
      .footer__version {
        margin: 0;
        color: #848b82;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.58rem;
        font-weight: 800;
        line-height: 1.5;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .footer__copyright strong {
        color: var(--white);
        font-weight: 900;
      }

      .footer__bottom-links {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.58rem;
        font-weight: 900;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .footer__bottom-links a {
        color: var(--white);
        text-decoration: none;
        transition: color 120ms linear;
      }

      .footer__bottom-links a:hover {
        color: var(--acid);
      }

      .footer__bottom-separator {
        color: var(--orange);
      }

      .footer__version {
        text-align: right;
        color: var(--acid);
      }

      @media (max-width: 1100px) {
        .footer__top {
          grid-template-columns: 1fr;
          gap: 46px;
        }

        .footer__feature-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 900px) {
        .footer__container {
          width: min(
            1320px,
            calc(100% - 32px)
          );
        }

        .footer__top {
          padding: 58px 0 44px;
        }

        .footer__columns {
          grid-template-columns:
            repeat(3, minmax(0, 1fr));
        }

        .footer__contact {
          grid-template-columns: 1fr;
        }

        .footer__bottom-inner {
          grid-template-columns: 1fr auto;
          padding-block: 14px;
        }

        .footer__bottom-links {
          grid-column: 1 / -1;
          justify-content: flex-start;
          padding-top: 10px;
          border-top: 1px solid var(--line);
        }

        .footer__version {
          text-align: right;
        }
      }

      @media (max-width: 620px) {
        .footer__container {
          width: min(
            1320px,
            calc(100% - 24px)
          );
        }

        .footer__top {
          padding: 48px 0 36px;
        }

        .footer__columns {
          grid-template-columns: 1fr 1fr;
          gap: 28px 18px;
        }

        .footer__columns
          .footer__column:last-child {
          grid-column: 1 / -1;
        }

        .footer__platform {
          padding: 28px 0;
        }

        .footer__platform-header {
          grid-template-columns: 1fr;
          align-items: start;
          gap: 18px;
        }

        .footer__platform-link {
          width: fit-content;
        }

        .footer__feature-grid {
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .footer__contact {
          padding: 20px 0;
        }

        .footer__bottom-inner {
          min-height: 0;
          grid-template-columns: 1fr;
          gap: 10px;
          padding-block: 18px;
        }

        .footer__bottom-links {
          grid-column: auto;
          justify-content: flex-start;
        }

        .footer__version {
          text-align: left;
        }
      }

      @media (max-width: 420px) {
        .footer__columns {
          grid-template-columns: 1fr;
        }

        .footer__columns
          .footer__column:last-child {
          grid-column: auto;
        }

        .footer__brand-mark {
          width: 48px;
          height: 48px;
        }

        .footer__brand-name {
          font-size: 1.12rem;
        }

        .footer__platform-title {
          font-size: clamp(
            30px,
            11vw,
            46px
          );
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .footer,
        .footer * {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }

      /* ==========================================================================
         BINSIGHT // ORGANIZATION CARD
         ========================================================================== */

      .organization-card {
        --acid: #dfff00;
        --acid-soft: #efff70;
        --ink: #090a08;
        --ink-2: #11130f;
        --paper: #f2f0e6;
        --paper-2: #e4e1d4;
        --paper-3: #cfcabd;
        --white: #fffef8;
        --muted: #6c7068;
        --warning: #ff6a00;

        position: relative;
        height: 100%;
        overflow: visible;
        color: var(--ink);
        background: var(--white);
        border: 3px solid var(--ink);
        border-radius: 0;
        box-shadow: 8px 8px 0 var(--ink);
        transition:
          transform 120ms steps(2, end),
          box-shadow 120ms steps(2, end),
          background 120ms linear;
      }

      .organization-card:hover {
        background: var(--acid);
        border-color: var(--ink);
        box-shadow: 12px 12px 0 var(--warning);
        transform: translate(-4px, -4px);
      }

      .organization-card:focus-within {
        outline: 4px solid var(--acid);
        outline-offset: 5px;
      }

      .organization-card--featured {
        box-shadow: 10px 10px 0 var(--warning);
      }

      .organization-card--featured::before {
        position: absolute;
        top: -10px;
        right: 16px;
        z-index: 3;
        width: 54px;
        height: 10px;
        content: "";
        background: var(--acid);
        border: 3px solid var(--ink);
        border-bottom: 0;
      }

      .organization-card__link {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        color: inherit;
        text-decoration: none;
      }

      .organization-card__media {
        position: relative;
        display: grid;
        min-height: 11rem;
        place-items: center;
        padding: 1.5rem;
        overflow: hidden;
        background:
          linear-gradient(
            rgba(255, 255, 255, 0.05) 2px,
            transparent 2px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.05) 2px,
            transparent 2px
          ),
          var(--ink-2);
        background-size: 28px 28px;
        border-bottom: 3px solid var(--ink);
      }

      .organization-card__media::before {
        position: absolute;
        inset: 12px;
        content: "";
        pointer-events: none;
        border: 2px solid rgba(223, 255, 0, 0.45);
        transform: rotate(-2deg);
      }

      .organization-card:hover
        .organization-card__media {
        background:
          linear-gradient(
            rgba(9, 10, 8, 0.07) 2px,
            transparent 2px
          ),
          linear-gradient(
            90deg,
            rgba(9, 10, 8, 0.07) 2px,
