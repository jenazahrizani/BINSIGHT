---
import {
  ArrowRight,
  ArrowUpRight,
  Building2,
  ChartColumn,
  FileText,
  Map,
  Menu,
  Recycle,
  ShieldCheck,
  X,
} from "@lucide/astro";

const BASE_URL = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

const siteHref = (path: string) => {
  if (
    path.startsWith("http://") ||
    path.startsWith("https://") ||
    path.startsWith("mailto:") ||
    path.startsWith("tel:") ||
    path.startsWith("#") ||
    path.startsWith("data:") ||
    path.startsWith("javascript:")
  ) {
    return path;
  }

  if (path === "/") {
    return `${BASE_URL}/`;
  }

  return `${BASE_URL}${path.startsWith("/") ? path : `/${path}`}`;
};

const services = [
  {
    no: "01",
    title: "Peta Persampahan",
    short: "PETA",
    text: "Jelajahi informasi persampahan berdasarkan lokasi dan wilayah di Kabupaten Badung.",
    href: "/map",
    icon: Map,
  },
  {
    no: "02",
    title: "Data & Informasi",
    short: "DATA",
    text: "Temukan informasi dalam bentuk yang lebih terstruktur, ringkas, dan mudah dibaca.",
    href: "/dashboard",
    icon: ChartColumn,
  },
  {
    no: "03",
    title: "Jaringan Organisasi",
    short: "NETWORK",
    text: "Kenali organisasi dan pihak yang membentuk ekosistem persampahan Badung.",
    href: "/organizations",
    icon: Building2,
  },
  {
    no: "04",
    title: "Material & Edukasi",
    short: "MATERIAL",
    text: "Pelajari kategori material dan pahami karakter penanganannya.",
    href: "/waste",
    icon: Recycle,
  },
];

const areas = [
  {
    no: "01",
    name: "Kabupaten Badung",
    type: "KABUPATEN",
    detail: "Wilayah utama",
    status: "TERSEDIA",
  },
  {
    no: "02",
    name: "Mengwi",
    type: "KECAMATAN",
    detail: "Area contoh",
    status: "CONTOH",
  },
  {
    no: "03",
    name: "Abiansemal",
    type: "KECAMATAN",
    detail: "Area contoh",
    status: "CONTOH",
  },
];

const materials = [
  {
    no: "01",
    code: "ORG",
    name: "Organik",
    description: "Material yang berasal dari sisa makhluk hidup.",
  },
  {
    no: "02",
    code: "ANR",
    name: "Anorganik",
    description: "Material non-organik dengan karakter yang beragam.",
  },
  {
    no: "03",
    code: "B3",
    name: "Bahan Berbahaya",
    description: "Material yang memerlukan perhatian dan penanganan khusus.",
  },
  {
    no: "04",
    code: "ELK",
    name: "Elektronik",
    description: "Perangkat dan komponen elektronik yang sudah tidak digunakan.",
  },
  {
    no: "05",
    code: "RES",
    name: "Residu",
    description: "Material tersisa yang tidak masuk kategori lainnya.",
  },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>BINSIGHT — Badung Waste Intelligence</title>

    <meta
      name="description"
      content="Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
    />

    <meta
      name="theme-color"
      content="#f5f6f1"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="site">

      <!-- =====================================================
           HEADER
      ====================================================== -->

      <header class="header">
        <div class="page-width header__inner">

          <a
            href={siteHref("/")}
            class="brand"
            aria-label="BINSIGHT"
          >
            <span
              class="brand__mark"
              aria-hidden="true"
            >
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </span>

            <span class="brand__name">
              BINSIGHT
            </span>
          </a>

          <nav
            class="desktop-nav"
            aria-label="Navigasi utama"
          >
            <a
              href={siteHref("/")}
              class="desktop-nav__active"
            >
              Beranda
            </a>

            <a href={siteHref("/map")}>
              Peta
            </a>

            <a href={siteHref("/dashboard")}>
              Data
            </a>

            <a href={siteHref("/organizations")}>
              Organisasi
            </a>

            <a href={siteHref("/waste")}>
              Material
            </a>

            <a href="#tentang">
              Tentang
            </a>
          </nav>

          <div class="header__actions">

            <span class="header__region">
              BADUNG / BALI
            </span>

            <a
              class="header__report"
              href={siteHref("/reports/create")}
            >
              Laporan
              <ArrowUpRight
                size={15}
                strokeWidth={1.8}
              />
            </a>

            <button
              type="button"
              class="menu-button"
              aria-label="Buka menu"
              aria-expanded="false"
              aria-controls="mobile-nav"
            >
              <Menu
                data-menu-open
                size={21}
                strokeWidth={1.8}
              />

              <X
                data-menu-close
                size={21}
                strokeWidth={1.8}
              />
            </button>

          </div>

        </div>

        <div
          class="mobile-nav"
          id="mobile-nav"
        >
          <div class="page-width mobile-nav__inner">

            <div class="mobile-nav__label">
              MENU
            </div>

            <a href={siteHref("/")}>
              <span>01</span>
              Beranda
            </a>

            <a href={siteHref("/map")}>
              <span>02</span>
              Peta
            </a>

            <a href={siteHref("/dashboard")}>
              <span>03</span>
              Data
            </a>

            <a href={siteHref("/organizations")}>
              <span>04</span>
              Organisasi
            </a>

            <a href={siteHref("/waste")}>
              <span>05</span>
              Material
            </a>

            <a href="#tentang">
              <span>06</span>
              Tentang
            </a>

          </div>
        </div>
      </header>


      <main>

        <!-- ===================================================
             HERO
        ==================================================== -->

        <section class="hero">
          <div class="page-width">

            <div class="hero__topline">
              <span>PUBLIC INFORMATION PLATFORM</span>
              <span>DENPASAR REGION / 2026</span>
            </div>

            <div class="hero__grid">

              <div class="hero__copy">

                <div class="hero__index">
                  <span>01</span>
                  <span>INTRODUCTION</span>
                </div>

                <p class="hero__eyebrow">
                  BADUNG WASTE INTELLIGENCE
                </p>

                <h1>
                  Memahami
                  <span>persampahan</span>
                  dimulai dari
                  <strong>konteks.</strong>
                </h1>

                <p class="hero__description">
                  BINSIGHT adalah ruang informasi publik yang
                  menghubungkan lokasi, data, organisasi, material,
                  edukasi, dan laporan persampahan Kabupaten Badung.
                </p>

                <div class="hero__buttons">

                  <a
                    class="button button--primary"
                    href={siteHref("/map")}
                  >
                    Jelajahi peta
                    <ArrowRight
                      size={17}
                      strokeWidth={1.8}
                    />
                  </a>

                  <a
                    class="button button--secondary"
                    href={siteHref("/dashboard")}
                  >
                    Buka data
                    <ArrowUpRight
                      size={17}
                      strokeWidth={1.8}
                    />
                  </a>

                </div>

              </div>


              <div
                class="hero__visual"
                aria-label="Visual konteks wilayah BINSIGHT"
              >

                <div class="visual__header">
                  <span>FIELD VIEW</span>
                  <span>01 / 04</span>
                </div>

                <div class="visual__canvas">

                  <div class="map-grid"></div>

                  <div class="map-shape map-shape--a"></div>
                  <div class="map-shape map-shape--b"></div>
                  <div class="map-shape map-shape--c"></div>

                  <div class="map-route"></div>

                  <div class="map-point map-point--one">
                    <i></i>
                    <span>01</span>
                  </div>

                  <div class="map-point map-point--two">
                    <i></i>
                    <span>02</span>
                  </div>

                  <div class="map-point map-point--three">
                    <i></i>
                    <span>03</span>
                  </div>

                  <div class="visual__center">
                    <small>REGION</small>
                    <strong>BADUNG</strong>
                    <span>BALI</span>
                  </div>

                  <div class="visual__compass">
                    <span>N</span>
                    <span>+</span>
                    <span>E</span>
                  </div>

                </div>

                <div class="visual__footer">

                  <div>
                    <span class="mono-label">CONTEXT</span>
                    <strong>MAP / DATA / PEOPLE</strong>
                  </div>

                  <span class="status-dot"></span>

                </div>

              </div>

            </div>

            <div class="hero__rail">

              <div class="hero__rail-item">
                <span>01</span>
                <small>LOCATION</small>
              </div>

              <div class="hero__rail-item">
                <span>02</span>
                <small>INFORMATION</small>
              </div>

              <div class="hero__rail-item">
                <span>03</span>
                <small>NETWORK</small>
              </div>

              <div class="hero__rail-item">
                <span>04</span>
                <small>REPORT</small>
              </div>

            </div>

          </div>
        </section>


        <!-- ===================================================
             INTRO STRIP
        ==================================================== -->

        <section class="signal">
          <div class="page-width signal__grid">

            <div class="signal__intro">
              <span class="section-kicker">
                02 / WHY BINSIGHT
              </span>

              <h2>
                Satu isu.
                <span>Banyak konteks.</span>
              </h2>
            </div>

            <div class="signal__cards">

              <article class="signal-card">
                <span>01</span>

                <div>
                  <strong>
                    Lokasi
                  </strong>

                  <p>
                    Informasi lebih bermakna ketika
                    ditempatkan pada ruang yang tepat.
                  </p>
                </div>
              </article>

              <article class="signal-card">
                <span>02</span>

                <div>
                  <strong>
                    Data
                  </strong>

                  <p>
                    Informasi disusun agar lebih mudah
                    dibaca, ditemukan, dan dibandingkan.
                  </p>
                </div>
              </article>

              <article class="signal-card">
                <span>03</span>

                <div>
                  <strong>
                    Manusia
                  </strong>

                  <p>
                    Organisasi dan masyarakat merupakan
                    bagian dari ekosistem persampahan.
                  </p>
                </div>
              </article>

            </div>

          </div>
        </section>


        <!-- ===================================================
             SERVICES
        ==================================================== -->

        <section class="explore">
          <div class="page-width">

            <div class="section-header">

              <div>
                <span class="section-kicker">
                  03 / EXPLORE
                </span>

                <h2>
                  Empat ruang
                  <span>untuk dijelajahi.</span>
                </h2>
              </div>

              <p>
                BINSIGHT dirancang untuk membantu pengguna
                berpindah dari satu konteks informasi ke konteks
                lainnya tanpa kehilangan gambaran besarnya.
              </p>

            </div>


            <div class="service-grid">

              {
                services.map((service) => {
                  const Icon = service.icon;

                  return (
                    <a
                      href={siteHref(service.href)}
                      class={`service-card service-card--${service.no}`}
                    >

                      <div class="service-card__top">
                        <span>{service.no}</span>

                        <span class="service-card__type">
                          {service.short}
                        </span>
                      </div>

                      <div class="service-card__icon">
                        <Icon
                          size={27}
                          strokeWidth={1.6}
                        />
                      </div>

                      <div class="service-card__body">

                        <h3>
                          {service.title}
                        </h3>

                        <p>
                          {service.text}
                        </p>

                      </div>

                      <div class="service-card__bottom">
                        <span>
                          BUKA MODUL
                        </span>

                        <ArrowUpRight
                          size={18}
                          strokeWidth={1.6}
                        />
                      </div>

                    </a>
                  );
                })
              }

            </div>

          </div>
        </section>


        <!-- ===================================================
             CONTEXT
        ==================================================== -->

        <section class="context">
          <div class="page-width context__grid">

            <div class="context__side">

              <span class="section-kicker section-kicker--light">
                04 / THE CONTEXT
              </span>

              <span class="context__side-number">
                04
              </span>

              <div class="context__side-line"></div>

              <small>
                BADUNG<br />
                BALI<br />
                INDONESIA
              </small>

            </div>


            <div class="context__content">

              <div class="context__heading">
                <p class="context__lead">
                  Persampahan bukan persoalan yang berdiri sendiri.
                </p>

                <h2>
                  Ia bergerak
                  <span>di antara tempat,</span>
                  manusia,
                  <span>dan material.</span>
                </h2>
              </div>

              <div class="context__bottom">

                <p>
                  Karena itu, BINSIGHT tidak hanya menyajikan
                  satu jenis informasi. Platform ini menyusun
                  berbagai konteks agar pengguna dapat melihat
                  hubungan di antara informasi yang tersedia.
                </p>

                <div class="context__formula">
                  <span>LOCATION</span>
                  <i>+</i>
                  <span>DATA</span>
                  <i>+</i>
                  <span>NETWORK</span>
                  <i>+</i>
                  <span>MATERIAL</span>
                </div>

              </div>

            </div>

          </div>
        </section>


        <!-- ===================================================
             METHOD
        ==================================================== -->

        <section class="method">
          <div class="page-width">

            <div class="method__header">

              <div>
                <span class="section-kicker">
                  05 / HOW IT WORKS
                </span>

                <h2>
                  Dari pertanyaan
                  <span>menjadi pemahaman.</span>
                </h2>
              </div>

              <p>
                Pengalaman BINSIGHT dibuat sesederhana mungkin:
                temukan informasi, pahami konteksnya, lalu
                hubungkan dengan informasi lainnya.
              </p>

            </div>


            <div class="timeline">

              <article class="timeline__item">

                <div class="timeline__index">
                  01
                </div>

                <div class="timeline__marker">
                  <span></span>
                </div>

                <div class="timeline__copy">
                  <small>LANGKAH PERTAMA</small>

                  <h3>
                    Temukan
                  </h3>

                  <p>
                    Mulai dari lokasi, wilayah, data,
                    organisasi, atau kategori material
                    yang ingin Anda ketahui.
                  </p>
                </div>

              </article>


              <article class="timeline__item">

                <div class="timeline__index">
                  02
                </div>

                <div class="timeline__marker">
                  <span></span>
                </div>

                <div class="timeline__copy">
                  <small>LANGKAH KEDUA</small>

                  <h3>
                    Pahami
                  </h3>

                  <p>
                    Baca informasi yang tersedia dan
                    lihat konteks yang berada di baliknya.
                  </p>
                </div>

              </article>


              <article class="timeline__item">

                <div class="timeline__index">
                  03
                </div>

                <div class="timeline__marker">
                  <span></span>
                </div>

                <div class="timeline__copy">
                  <small>LANGKAH KETIGA</small>

                  <h3>
                    Hubungkan
                  </h3>

                  <p>
                    Kaitkan informasi dengan wilayah,
                    material, organisasi, dan pengalaman
                    masyarakat.
                  </p>
                </div>

              </article>

            </div>

          </div>
        </section>


        <!-- ===================================================
             AREAS
        ==================================================== -->

        <section class="areas">
          <div class="page-width">

            <div class="areas__header">

              <div>
                <span class="section-kicker">
                  06 / COVERAGE
                </span>

                <h2>
                  Badung
                  <span>dalam konteks.</span>
                </h2>
              </div>

              <p>
                Jelajahi informasi berdasarkan wilayah untuk
                mendapatkan gambaran yang lebih dekat dengan
                kondisi lokal.
              </p>

            </div>


            <div class="areas__list">

              {
                areas.map((area) => (
                  <a
                    class="area-card"
                    href={siteHref("/map")}
                  >

                    <div class="area-card__number">
                      {area.no}
                    </div>

                    <div class="area-card__main">

                      <span>
                        {area.type}
                      </span>

                      <h3>
                        {area.name}
                      </h3>

                      <p>
                        {area.detail}
                      </p>

                    </div>

                    <div class="area-card__status">
                      <span>
                        {area.status}
                      </span>

                      <ArrowUpRight
                        size={18}
                        strokeWidth={1.6}
                      />
                    </div>

                  </a>
                ))
              }

            </div>

          </div>
        </section>


        <!-- ===================================================
             MATERIALS
        ==================================================== -->

        <section class="materials">
          <div class="page-width">

            <div class="materials__header">

              <div class="materials__title">
                <span class="section-kicker">
                  07 / MATERIAL
                </span>

                <h2>
                  Setiap material
                  <span>punya konteksnya.</span>
                </h2>
              </div>

              <div class="materials__description">

                <p>
                  Mengenal kategori material membantu memahami
                  bahwa setiap jenis sampah memiliki karakter
                  dan kebutuhan penanganan yang berbeda.
                </p>

                <a
                  href={siteHref("/waste")}
                  class="text-link"
                >
                  Lihat seluruh kategori
                  <ArrowRight
                    size={16}
                    strokeWidth={1.8}
                  />
                </a>

              </div>

            </div>


            <div class="material-list">

              {
                materials.map((material) => (
                  <a
                    class="material-item"
                    href={siteHref("/waste")}
                  >

                    <div class="material-item__no">
                      {material.no}
                    </div>

                    <div class="material-item__code">
                      {material.code}
                    </div>

                    <div class="material-item__main">
                      <h3>
                        {material.name}
                      </h3>

                      <p>
                        {material.description}
                      </p>
                    </div>

                    <div class="material-item__arrow">
                      <ArrowUpRight
                        size={19}
                        strokeWidth={1.6}
                      />
                    </div>

                  </a>
                ))
              }

            </div>

          </div>
        </section>


        <!-- ===================================================
             ABOUT / PRINCIPLES
        ==================================================== -->

        <section
          class="about"
          id="tentang"
        >
          <div class="page-width">

            <div class="about__header">

              <div>
                <span class="section-kicker">
                  08 / ABOUT BINSIGHT
                </span>

                <h2>
                  Dibuat untuk
                  <span>informasi publik.</span>
                </h2>
              </div>

              <div class="about__badge">
                <ShieldCheck
                  size={19}
                  strokeWidth={1.7}
                />

                <span>
                  PUBLIC INFORMATION
                </span>
              </div>

            </div>


            <div class="about__grid">

              <div class="about__statement">

                <p class="about__number">
                  01
                </p>

                <blockquote>
                  “Informasi yang baik bukan hanya
                  mudah ditemukan, tetapi juga
                  mudah dipahami.”
                </blockquote>

              </div>


              <div class="about__principles">

                <article>
                  <span>01</span>

                  <div>
                    <h3>
                      Kontekstual
                    </h3>

                    <p>
                      Informasi ditempatkan bersama
                      lokasi dan konteks yang relevan.
                    </p>
                  </div>
                </article>

                <article>
                  <span>02</span>

                  <div>
                    <h3>
                      Terbuka
                    </h3>

                    <p>
                      Informasi publik disusun agar
                      mudah ditemukan dan dipahami.
                    </p>
                  </div>
                </article>

                <article>
                  <span>03</span>

                  <div>
                    <h3>
                      Bertanggung jawab
                    </h3>

                    <p>
                      Penyajian memperhatikan sumber,
                      konteks, dan cara penggunaannya.
                    </p>
                  </div>
                </article>

              </div>

            </div>

          </div>
        </section>


        <!-- ===================================================
             CTA
        ==================================================== -->

        <section class="cta">
          <div class="page-width cta__inner">

            <div class="cta__label">
              <span>09</span>
              <span>BINSIGHT / NEXT</span>
            </div>

            <div class="cta__content">

              <div>
                <p>
                  Mulai dari apa yang
                  ingin Anda ketahui.
                </p>

                <h2>
                  Kenali.
                  <span>Pahami.</span>
                  Jaga Badung.
                </h2>
              </div>

              <a
                class="cta__button"
                href={siteHref("/map")}
              >
                Jelajahi BINSIGHT
                <ArrowUpRight
                  size={20}
                  strokeWidth={1.7}
                />
              </a>

            </div>

          </div>
        </section>

      </main>


      <!-- =====================================================
           FOOTER
      ====================================================== -->

      <footer class="footer">

        <div class="page-width footer__top">

          <div class="footer__identity">

            <a
              href={siteHref("/")}
              class="brand brand--footer"
            >
              <span
                class="brand__mark"
                aria-hidden="true"
              >
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </span>

              <span class="brand__name">
                BINSIGHT
              </span>
            </a>

            <p>
              Badung Waste Intelligence.
              Platform informasi publik
              persampahan Kabupaten Badung.
            </p>

          </div>


          <div class="footer__column">

            <span>
              PLATFORM
            </span>

            <a href={siteHref("/map")}>
              Peta
            </a>

            <a href={siteHref("/dashboard")}>
              Data
            </a>

            <a href={siteHref("/organizations")}>
              Organisasi
            </a>

            <a href={siteHref("/waste")}>
              Material
            </a>

          </div>


          <div class="footer__column">

            <span>
              INFORMASI
            </span>

            <a href="#tentang">
              Tentang BINSIGHT
            </a>

            <a href={siteHref("/reports/create")}>
              Laporan masyarakat
            </a>

            <a href={siteHref("/map")}>
              Eksplorasi
            </a>

          </div>

        </div>


