          14px;
      }


      .hero-panel__header strong {

        font-size:
          20px;
      }


      .hero-panel__intro {

        padding:
          18px
          14px;
      }


      .hero-panel__intro p {

        font-size:
          12px;
      }


      .hero-panel__item {

        min-height:
          69px;

        padding:
          0
          14px;
      }


      .hero-panel__item:hover {

        padding-left:
          17px;

        padding-right:
          11px;
      }


      .hero-panel__footer {

        min-height:
          45px;

        padding:
