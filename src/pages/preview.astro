      .report-box__button {
        min-width: 190px;
        align-self: center;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 18px;
        color: var(--ink);
        background: var(--acid);
        border: 3px solid var(--white);
        box-shadow: 8px 8px 0 var(--warning);
        font-size: 10px;
        font-weight: 900;
        text-decoration: none;
        text-transform: uppercase;
        transition:
          transform 120ms steps(2, end),
