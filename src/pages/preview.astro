    }

    .service-row__main p {
      max-width: 640px;

      margin: 0;

      color: #6c6862;

      font-size: 11px;

      line-height: 1.7;
    }

    .service-row__action {
      display: flex;

      align-items: center;

      justify-content: flex-end;

      gap: 8px;

      color: #7c7771;

      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      letter-spacing: 0.08em;

      text-transform: uppercase;
    }

    .service-row__action > div {
      display: grid;

      width: 38px;
      height: 38px;

      place-items: center;

      border:
        1px solid
        var(--line);

      border-radius: 50%;

      background:
        var(--paper);

      transition:
        background 160ms ease,
        transform 160ms ease;
    }

    .service-row:hover
      .service-row__action > div {
      background:
        var(--blue);

      color: #fff;

      transform:
        translate(
          2px,
          -2px
        );
    }


    /* =========================
       FLOW
    ========================== */

    .flow {
      padding:
        116px 0;

      border-bottom:
        1px solid
        #292e3e;

      background:
        var(--dark);

      color: #fff;
    }

    .flow__header {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        330px;

      gap: 60px;

      margin-top: 52px;

      margin-bottom: 64px;
    }

    .flow h2 {
      max-width: 750px;

      margin-top: 13px;

      font-size:
        clamp(
          54px,
          6vw,
          89px
        );

      line-height: 0.91;
    }

    .flow h2 span {
      color:
        var(--yellow);

      font-style: italic;
    }

    .flow__header > p {
      margin: 0;

      align-self: end;

      color: #abb0bc;

      font-size: 13px;

      line-height: 1.8;
    }

    .flow-line {
      display: grid;

      grid-template-columns:
        1fr
        50px
        1fr
        50px
        1fr
        50px
        1fr;

      align-items: center;

      border-top:
        1px solid
        #353b4e;

      border-bottom:
        1px solid
        #353b4e;
    }

    .flow-step {
      position: relative;

      min-width: 0;

      padding:
        34px 20px
        38px 0;
    }

    .flow-step:not(:first-child) {
      padding-left: 20px;
    }

    .flow-step__number {
      position: absolute;

      top: 16px;
      right: 0;

      color: #697084;

      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;
    }

    .flow-step__circle {
      display: grid;

      width: 46px;
      height: 46px;

      place-items: center;

      margin-bottom: 18px;

      border:
        1px solid
        #454b5c;

      border-radius: 50%;

      color:
        var(--yellow);
    }

    .flow-step small {
      display: block;

      color: #858c9f;

      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      letter-spacing: 0.1em;
    }

    .flow-step strong {
      display: block;

      margin-top: 5px;

      color: #fff;

      font-size: 19px;

      font-weight: 800;

      letter-spacing: -0.04em;
    }

    .flow-step p {
      max-width: 170px;

      margin:
        7px 0 0;

      color: #9198a8;

      font-size: 10px;

      line-height: 1.6;
    }

    .flow-arrow {
      display: grid;

      place-items: center;

      color: #687186;
    }


    /* =========================
       PRINCIPLES
    ========================== */

    .principles {
      padding:
        120px 0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--paper);
    }

    .principles__headline {
      max-width: 800px;

      margin-top: 50px;
    }

    .principles__headline h2 {
      margin-top: 13px;
    }

    .principles__headline h2 em {
      display: block;
    }

    .principles__grid {
      display: grid;

      grid-template-columns:
        repeat(
          3,
          minmax(0, 1fr)
        );

      gap: 12px;

      margin-top: 62px;
    }

    .principle {
      min-height: 305px;

      padding:
        22px
        22px
        26px;

      border:
        1px solid
        var(--line);

      border-radius: 20px;

      background:
        var(--bg);

      transition:
        transform 180ms ease,
        background 180ms ease;
    }

    .principle:nth-child(2) {
      transform:
        translateY(
          26px
        );
    }

    .principle:hover {
      transform:
        translateY(
          -4px
        );

      background:
        #e8efff;
    }

    .principle:nth-child(2):hover {
      transform:
        translateY(
          21px
        );
    }

    .principle__top {
      display: flex;

      align-items: center;

      justify-content: space-between;

      color: #8a857e;
    }

    .principle__top span {
      font-family:
        "DM Mono",
        monospace;

      font-size: 8px;
    }

    .principle h3 {
      margin:
        74px 0 0;

      font-size: 26px;
      font-weight: 800;

      letter-spacing: -0.05em;
    }

    .principle p {
      max-width: 320px;

      margin:
        12px 0 0;

      color: #69655f;

      font-size: 12px;

      line-height: 1.75;
    }


    /* =========================
       NETWORK
    ========================== */

    .network {
      padding:
        120px 0;

      border-bottom:
        1px solid
        var(--line);

      background:
        #e9e4db;
    }

    .network__header {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        340px;

      gap: 70px;

      margin-top: 52px;

      margin-bottom: 54px;
    }

    .network h2 {
      margin-top: 12px;
    }

    .network h2 em {
      display: block;
    }

    .network__side {
      align-self: end;
    }

    .network__side p {
      margin: 0;

      color: #67635d;

      font-size: 13px;

      line-height: 1.8;
    }

    .network__side .arrow-link {
      margin-top: 16px;
    }

    .directory {
      border-top:
        1px solid
        var(--ink);
    }

    .directory__head,
    .directory__row {
      display: grid;

      grid-template-columns:
        55px
        minmax(0, 1.2fr)
        150px
        120px
        150px
        24px;

      gap: 16px;

      align-items: center;
    }

    .directory__head {
      min-height: 44px;

      color: #858077;

      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      letter-spacing: 0.08em;

      text-transform: uppercase;
    }

    .directory__row {
      min-height: 88px;

      border-top:
        1px solid
        rgba(
          23,
          24,
          27,
          0.13
        );

      transition:
        background 160ms ease,
        padding 160ms ease;
    }

    .directory__row:hover {
      padding-left: 12px;
      padding-right: 12px;

      border-radius: 16px;

      background:
        var(--paper);
    }

    .directory__index {
      color: #918b82;

      font-family:
        "DM Mono",
        monospace;

      font-size: 8px;
    }

    .directory__name {
      min-width: 0;

      display: flex;

      flex-direction: column;

      gap: 4px;
    }

    .directory__name strong {
      overflow: hidden;

      text-overflow: ellipsis;

      white-space: nowrap;

      font-size: 15px;

      font-weight: 800;

      letter-spacing: -0.035em;
    }

    .directory__name small,
    .directory__type,
    .directory__area,
    .directory__status {
      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      letter-spacing: 0.06em;

      text-transform: uppercase;
    }

    .directory__name small,
    .directory__type,
    .directory__area {
      color: #7e7972;
    }

    .directory__status {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 5px;

      min-height: 28px;

      padding: 0 7px;

      border:
        1px solid
        #cdc7bc;

      border-radius: 999px;

      color: #817c75;

      white-space: nowrap;
    }

    .directory__status.is-verified {
      border-color:
        #9eb4ff;

      background:
        #dfe6ff;

      color:
        #304fca;
    }

    .directory__arrow {
      color: #8c867e;

      transition:
        transform 160ms ease;
    }

    .directory__row:hover
      .directory__arrow {
      transform:
        translate(
          2px,
          -2px
        );
    }

    .data-note {
      margin:
        15px 0 0;

      color: #8f8a82;

      font-size: 9px;

      line-height: 1.6;
    }


    /* =========================
       MATERIALS
    ========================== */

    .materials {
      padding:
        120px 0;

      border-bottom:
        1px solid
        var(--line);

      background:
        var(--paper);
    }

    .materials__layout {
      display: grid;

      grid-template-columns:
        minmax(320px, 0.72fr)
        minmax(0, 1fr);

      gap: 90px;

      margin-top: 54px;
    }

    .materials__intro {
      padding-top: 10px;
    }

    .materials h2 {
      margin-top: 12px;
    }

    .materials h2 em {
      display: block;
    }

    .materials__intro
      > p:not(.mini-label) {
      max-width: 420px;

      margin:
        26px 0 30px;

      color: #69655f;

      font-size: 13px;

      line-height: 1.8;
    }

    .material-button {
      display: inline-flex;

      align-items: center;

      gap: 9px;

      min-height: 45px;

      padding: 0 15px;

      border-radius: 999px;

      background:
        var(--ink);

      color: #fff;

      font-size: 10px;

      font-weight: 800;
    }

    .material-cloud {
      position: relative;

      min-height: 490px;
    }

    .material-chip {
      position: absolute;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      min-width: 190px;

      min-height: 150px;

      padding:
        16px 18px;

      border:
        1px solid
        rgba(
          23,
          24,
          27,
          0.1
        );

      border-radius: 22px;

      box-shadow:
        0 20px 35px
        rgba(
          24,
          25,
          29,
          0.07
        );

      transition:
        transform 180ms ease,
        box-shadow 180ms ease;
    }

    .material-chip:hover {
      transform:
        translateY(
          -7px
        )
        rotate(
          0deg
        ) !important;

      box-shadow:
        0 26px 44px
        rgba(
          24,
          25,
          29,
          0.12
        );
    }

    .material-chip span {
      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      opacity: 0.65;
    }

    .material-chip strong {
      margin-top: auto;

      font-size: 22px;

      font-weight: 800;

      letter-spacing: -0.05em;
    }

    .material-chip small {
      margin-top: 3px;

      font-family:
        "DM Mono",
        monospace;

      font-size: 6px;

      letter-spacing: 0.08em;

      opacity: 0.65;
    }

    .material-chip svg {
      position: absolute;

      top: 16px;
      right: 16px;
    }

    .material-chip--1 {
      top: 20px;
      left: 8%;

      background:
        #dfe7ff;

      color:
        #223fbd;

      transform:
        rotate(
          -6deg
        );
    }

    .material-chip--2 {
      top: 0;
      right: 2%;

      background:
        #ffd9ce;

      color:
        #9f3720;

      transform:
        rotate(
          5deg
        );
    }

    .material-chip--3 {
      top: 175px;
      left: 34%;

      background:
        #f6de8d;

      color:
        #7d5f0b;

      transform:
        rotate(
          2deg
        );
    }

    .material-chip--4 {
      right: 12%;
      bottom: 12px;

      background:
        #d9f0e2;

      color:
        #276246;

      transform:
        rotate(
          -4deg
        );
    }

    .material-chip--5 {
      bottom: 0;
      left: 2%;

      background:
        #ddd9d1;

      color:
        #55514b;

      transform:
        rotate(
          6deg
        );
    }


    /* =========================
       CONTEXT INDEX
    ========================== */

    .context-index {
      padding:
        120px 0;

      border-bottom:
        1px solid
        var(--line);

      background:
        #f0ebe3;
    }

    .context-index__header {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        340px;

      gap: 70px;

      align-items: end;

      margin-top: 52px;

      margin-bottom: 58px;
    }

    .context-index h2 {
      margin-top: 12px;
    }

    .context-index h2 em {
      display: block;
    }

    .context-index__header > p {
      margin: 0;

      color: #6b6760;

      font-size: 13px;

      line-height: 1.8;
    }

    .context-grid {
      display: grid;

      grid-template-columns:
        repeat(
          4,
          minmax(0, 1fr)
        );

      gap: 12px;
    }

    .context-card {
      display: flex;

      flex-direction: column;

      min-height: 265px;

      padding:
        20px;

      border:
        1px solid
        #d5cec3;

      border-radius: 20px;

      background:
        rgba(
          255,
          253,
          248,
          0.75
        );

      transition:
        transform 180ms ease,
        background 180ms ease,
        box-shadow 180ms ease;
    }

    .context-card:nth-child(2) {
      transform:
        translateY(
          22px
        );
    }

    .context-card:nth-child(4) {
      transform:
        translateY(
          10px
        );
    }

    .context-card:hover {
      transform:
        translateY(
          -5px
        );

      background:
        #fff;

      box-shadow:
        0 18px 35px
        rgba(
          31,
          32,
          35,
          0.07
        );
    }

    .context-card:nth-child(2):hover {
      transform:
        translateY(
          17px
        );
    }

    .context-card:nth-child(4):hover {
      transform:
        translateY(
          5px
        );
    }

    .context-card__top {
      display: flex;

      align-items: center;

      justify-content: space-between;

      color: #8c867e;
    }

    .context-card__top span {
      font-family:
        "DM Mono",
        monospace;

      font-size: 8px;
    }

    .context-card > small {
      margin-top: 70px;

      color: #8d877f;

      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      letter-spacing: 0.1em;
    }

    .context-card h3 {
      margin:
        7px 0 0;

      font-family:
        "DM Serif Display",
        Georgia,
        serif;

      font-size: 31px;

      font-weight: 400;

      letter-spacing: -0.04em;
    }

    .context-card p {
      max-width: 220px;

      margin:
        9px 0 0;

      color: #6b6760;

      font-size: 11px;

      line-height: 1.7;
    }


    /* =========================
       FOOTER
    ========================== */

    .footer {
      background:
        #ece7de;
    }

    .footer__top {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        minmax(360px, 0.75fr);

      gap: 100px;

      padding:
        75px 0 60px;
    }

    .footer__brand p {
      max-width: 430px;

      margin:
        20px 0 0;

      color: #6b6760;

      font-size: 12px;

      line-height: 1.8;
    }

    .footer__nav {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 45px;
    }

    .footer__nav > div {
      display: flex;

      flex-direction: column;

      align-items: flex-start;

      gap: 8px;
    }

    .footer__nav small {
      margin-bottom: 9px;

      color: #928d85;

      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      letter-spacing: 0.09em;
    }

    .footer__nav a {
      display: inline-flex;

      align-items: center;

      gap: 7px;

      font-size: 11px;

      font-weight: 700;
    }

    .footer__nav a:hover {
      color:
        var(--blue);
    }

    .footer__nav span {
      color: #706b64;

      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      letter-spacing: 0.05em;
    }

    .footer__bottom {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      min-height: 58px;

      border-top:
        1px solid
        var(--line);

      color: #817b73;

      font-family:
        "DM Mono",
        monospace;

      font-size: 7px;

      font-weight: 600;

      letter-spacing: 0.08em;
    }


    /* =========================
       FLOATING REPORT
    ========================== */

    .floating-report {
      position: fixed;

      right: 22px;
      bottom: 22px;

      z-index: 120;

      display: inline-flex;

      align-items: center;

      gap: 10px;

      min-height: 64px;

      padding:
        8px 9px 8px 10px;

      border:
        1px solid
        #b44b32;

      border-radius: 18px;

      background:
        var(--orange);

      color: #fff;

      box-shadow:
        0 15px 34px
        rgba(
          31,
          32,
          35,
          0.2
        );

      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        background 180ms ease;
    }

    .floating-report:hover {
      transform:
        translateY(
          -4px
        );

      background:
        #f25837;

      box-shadow:
        0 20px 40px
        rgba(
          31,
          32,
          35,
          0.25
        );
    }

    .floating-report__icon {
      display: grid;

      width: 44px;
      height: 44px;

      place-items: center;

      border-radius: 14px;

      background:
        rgba(
          23,
          24,
          27,
          0.92
        );

      color:
        var(--yellow);
    }

    .floating-report__label {
      display: flex;

      flex-direction: column;

      min-width: 96px;

      gap: 3px;
    }

    .floating-report__label small {
      color:
        rgba(
          255,
          255,
          255,
          0.68
        );

      font-family:
        "DM Mono",
        monospace;

      font-size: 6px;

      letter-spacing: 0.09em;
    }

    .floating-report__label strong {
      color: #fff;

      font-size: 11px;

      font-weight: 800;
    }

    .floating-report__arrow {
      display: grid;

      width: 32px;
      height: 32px;

      place-items: center;

      border-radius: 50%;

      background:
        rgba(
          255,
          255,
          255,
          0.18
        );
    }


    /* =========================
       ACCESSIBILITY
    ========================== */

    :global(a:focus-visible),
    :global(button:focus-visible) {
      outline:
        3px solid
        rgba(
          39,
          84,
          255,
          0.42
        );

      outline-offset: 4px;
    }


    /* =========================
       TABLET
    ========================== */

    @media (max-width: 1050px) {

      .desktop-nav {
        display: none;
      }

      .header__inner {
        grid-template-columns:
          1fr auto;

        gap: 10px;
      }

      .menu-trigger {
        display: grid;
      }

      .hero__lower {
        grid-template-columns: 1fr;

        gap: 40px;
      }

      .hero__signal {
        max-width: 680px;
      }

      .services__intro,
      .flow__header,
      .network__header,
      .materials__layout,
      .context-index__header,
      .footer__top {
        grid-template-columns: 1fr;

        gap: 42px;
      }

      .directory__head,
      .directory__row {
        grid-template-columns:
          48px
          minmax(0, 1fr)
          120px
          110px
          135px
          20px;
      }

      .flow-line {
        grid-template-columns:
          1fr
          35px
          1fr
          35px
          1fr
          35px
          1fr;
      }

      .context-grid {
        grid-template-columns:
          repeat(
            2,
            minmax(0, 1fr)
          );
      }

    }


    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 700px) {

      .shell {
        width:
          min(
            var(--max),
            calc(100% - 30px)
          );
      }

      .header__inner {
        min-height: 70px;
      }

      .brand__symbol {
        width: 37px;
        height: 37px;

        border-radius: 11px;
      }

      .brand__copy strong {
        font-size: 14px;
      }

      .brand__copy small {
        display: none;
      }

      .header-search {
        display: none;
      }

      .header__actions {
        gap: 6px;
      }


      /* Hero */

      .hero__inner {
        min-height: auto;

        grid-template-columns: 1fr;
      }

      .hero__side-label {
        display: none;
      }

      .hero__content {
        padding:
          55px 0 60px;
      }

      .hero h1 {
        margin-top: 23px;

        font-size:
          clamp(
            58px,
            18vw,
            92px
          );

        line-height: 0.86;
      }

      .hero h1 em {
        margin-left: 7%;
      }

      .hero h1 strong {
        margin-left: 2%;
      }

      .hero__lower {
        margin-top: 52px;
      }

      .hero__buttons {
        flex-direction: column;
      }

      .button {
        width: 100%;
      }

      .signal-main {
        min-height: 250px;
      }

      .signal-title strong {
        font-size: 29px;
      }


      /* Sections */

      .section-marker {
        font-size: 7px;
      }

      .intro,
      .services,
      .principles,
      .network,
      .materials,
      .context-index {
        padding:
          78px 0;
      }

      .intro__grid {
        grid-template-columns: 1fr;

        gap: 40px;

        margin-top: 40px;
      }

      .intro__headline {
        padding-left: 52px;
      }

      .intro h2,
      .services h2,
      .principles h2,
