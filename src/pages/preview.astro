      .report-box__button:hover {
        transform: translate(-4px, -4px);
        box-shadow: 13px 13px 0 var(--warning);
      }

      .report-box__button:focus-visible {
        outline: 4px solid var(--acid);
        outline-offset: 4px;
      }

      /* ==========================================================================
         EMPTY STATE
         ========================================================================== */

      .empty-state {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px;
        border: 3px solid var(--ink);
        background: var(--white);
        box-shadow: 7px 7px 0 var(--ink);
      }

      .empty-state__icon {
        width: 54px;
        height: 54px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        background: var(--acid);
        border: 3px solid var(--ink);
      }

      .empty-state h3 {
        margin: 0;
        font-family:
          Sora,
          Inter,
          sans-serif;
        font-size: 20px;
        font-weight: 900;
        text-transform: uppercase;
      }

      .empty-state p {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.6;
      }

      /* ==========================================================================
         TABLET
         ========================================================================== */

      @media (max-width: 1050px) {
        .hero__inner {
          grid-template-columns:
            minmax(0, 1fr)
            minmax(360px, 0.82fr);
          gap: 34px;
        }

        .hero__title {
          font-size: clamp(74px, 10vw, 126px);
        }

        .discovery-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
        }

        .discovery-card:nth-child(2n) {
          transform: translateY(0);
        }

        .organization-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
        }

        .waste-grid {
          grid-template-columns:
            repeat(3, minmax(0, 1fr));
        }

        .map-cta__inner {
          grid-template-columns: 1fr;
        }

        .map-cta__visual {
          min-height: 400px;
          transform: translate(0, 12px);
        }
      }

      @media (max-width: 900px) {
        .hero {
          min-height: auto;
        }

        .hero__inner {
          grid-template-columns: 1fr;
          min-height: auto;
          padding: 48px 0 82px;
        }

        .hero__right {
          min-height: 520px;
        }

        .section-head {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .pillar-card:nth-child(2),
        .pillar-card:nth-child(3),
        .pillar-card:nth-child(4) {
          transform: none;
        }

        .pillar-card:hover,
        .pillar-card:nth-child(2):hover,
        .pillar-card:nth-child(3):hover,
        .pillar-card:nth-child(4):hover {
          transform: translateX(5px)
            translateY(-4px);
        }
      }

      /* ==========================================================================
         MOBILE
         ========================================================================== */

      @media (max-width: 640px) {
        .home-container {
          width: calc(100% - 24px);
        }

        .hero {
          border-bottom-width: 7px;
        }

        .hero__inner {
          padding-top: 34px;
          padding-bottom: 68px;
        }

        .eyebrow {
          width: fit-content;
          max-width: 100%;
          box-shadow: 5px 5px 0 var(--white);
          line-height: 1.3;
        }

        .eyebrow__line {
          display: none;
        }

        .hero__title {
          margin-top: 34px;
          font-size: clamp(56px, 17vw, 96px);
          line-height: 0.8;
        }

        .hero__title--outline {
          -webkit-text-stroke-width: 2px;
          text-stroke-width: 2px;
          transform: translateX(2.5vw);
        }

        .hero__accent {
          width: 110px;
          height: 11px;
          margin-top: 28px;
          box-shadow: 8px 8px 0 var(--warning);
        }

        .hero__description {
          margin-top: 26px;
          padding-left: 12px;
          border-left-width: 6px;
          font-size: 13px;
        }

        .hero__actions,
        .map-cta__actions {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .hero__metrics {
          overflow-x: auto;
          border-width: 2px;
          scrollbar-width: none;
        }

        .hero__metrics::-webkit-scrollbar {
          display: none;
        }

        .metric {
          min-width: 118px;
          padding: 13px 14px;
        }

        .metric strong {
          font-size: 28px;
        }

        .metric span {
          font-size: 7px;
        }

        .hero__right {
          min-height: 380px;
        }

        .map-window {
          box-shadow: 12px 12px 0 var(--warning);
        }

        .map-window__top,
        .map-window__bottom {
          padding-inline: 11px;
        }

        .map-window__body {
          min-height: 280px;
        }

        .map-window__bottom strong {
          font-size: 20px;
        }

        .floating-label--top {
          right: -3px;
        }

        .floating-label--bottom {
          left: -3px;
          bottom: 18px;
        }

        .hero__footer {
          display: none;
        }

        .section {
          padding: 78px 0;
        }

        .section-head {
          margin-bottom: 34px;
        }

        .section-head h2 {
          font-size: clamp(42px, 12vw, 68px);
        }

        .discovery-grid,
        .organization-grid,
        .waste-grid {
          grid-template-columns: 1fr;
        }

        .discovery-card {
          min-height: 300px;
        }

        .discovery-card:nth-child(2n) {
          transform: none;
        }

        .discovery-card:nth-child(2n):hover,
        .discovery-card:hover {
          transform: translate(4px, -4px);
        }

        .system-bar__inner {
          min-height: auto;
          flex-direction: column;
          align-items: flex-start;
          padding: 16px 0;
        }

        .system-bar__formula {
          justify-content: flex-start;
          line-height: 1.8;
        }

        .pillar-card {
          grid-template-columns:
            40px 48px minmax(0, 1fr) 32px;
          gap: 9px;
          padding: 13px;
        }

        .pillar-card__number,
        .pillar-card__icon {
          width: 48px;
          min-height: 54px;
          height: 54px;
        }

        .pillar-card__body h3 {
          font-size: 24px;
        }

        .pillar-card__body p {
          font-size: 10px;
        }

        .map-cta {
          padding: 78px 0;
        }

        .map-cta__content {
          padding: 36px 22px;
          box-shadow: 10px 10px 0 var(--warning);
        }

        .map-cta__content h2 {
          font-size: clamp(54px, 15vw, 84px);
        }

        .map-cta__visual {
          min-height: 300px;
          transform: translate(0, 10px);
        }

        .map-cta__marker {
          width: 44px;
          height: 44px;
        }

        .report-section {
          padding: 72px 0 88px;
        }

        .report-box {
          flex-direction: column;
          padding: 20px;
          box-shadow: 10px 10px 0 var(--acid);
        }

        .report-box__content {
          flex-direction: column;
          gap: 18px;
        }

        .report-box h2 {
          font-size: clamp(40px, 10.5vw, 60px);
        }

        .report-box__button {
          width: 100%;
        }

        .empty-state {
          flex-direction: column;
          align-items: flex-start;
        }
      }

      /* ==========================================================================
         SMALL MOBILE
         ========================================================================== */

      @media (max-width: 430px) {
        .home-container {
          width: calc(100% - 16px);
        }

        .hero__title {
          font-size: 18vw;
        }

        .hero__right {
          min-height: 340px;
        }

        .map-window__body {
          min-height: 250px;
        }

        .floating-label--top {
          right: -1px;
        }

        .floating-label--bottom {
          left: -1px;
        }

        .map-coordinates {
          right: 10px;
          bottom: 10px;
        }

        .pillar-card {
          grid-template-columns:
            34px 44px minmax(0, 1fr);
          position: relative;
        }

        .pillar-card__number,
        .pillar-card__icon {
          width: auto;
          min-height: 48px;
          height: 48px;
        }

        .pillar-card__arrow {
          position: absolute;
          right: 10px;
          top: 10px;
        }

        .pillar-card__body {
          padding-right: 18px;
        }
      }

      /* ==========================================================================
         REDUCED MOTION
         ========================================================================== */

      @media (prefers-reduced-motion: reduce) {
        .home *,
        .home *::before,
        .home *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }

      /* ==========================================================================
         BINSIGHT NAVBAR
         ========================================================================== */

      .navbar {
        --acid: #dfff00;
        --acid-soft: #efff70;
        --ink: #090a08;
        --ink-2: #11130f;
        --ink-3: #1b1f18;
        --paper: #f2f0e6;
        --white: #fffef8;
        --muted: #6c7068;
        --warning: #ff6a00;

        position: sticky;
        top: 0;
        z-index: 900;
        width: 100%;
        color: var(--white);
        background: var(--ink);
        border-bottom: 4px solid var(--acid);
        box-shadow: 0 8px 0 rgba(0, 0, 0, 0.16);
        transition:
          transform 180ms steps(2, end),
          background-color 160ms linear,
          box-shadow 160ms linear,
          border-color 160ms linear;
        isolation: isolate;
      }

      .navbar::before {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        content: "";
        opacity: 0.18;
        background:
          linear-gradient(
            rgba(255, 255, 255, 0.08) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.08) 1px,
            transparent 1px
          );
        background-size: 24px 24px;
      }

      .navbar--scrolled {
        background: rgba(9, 10, 8, 0.98);
        border-color: var(--acid);
        box-shadow:
          0 10px 0 rgba(255, 106, 0, 0.18);
      }

      .navbar--scroll-down {
        transform: translateY(-100%);
      }

      .navbar--mobile-open {
        transform: translateY(0);
      }

      .navbar__container {
        width: min(1320px, calc(100% - 40px));
        min-height: 76px;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .navbar__brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
        flex-shrink: 0;
        color: var(--white);
        text-decoration: none;
      }

      .navbar__brand-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        line-height: 1;
      }

      .navbar__brand-name {
        color: var(--acid);
        font-family:
          Sora,
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
        font-size: 1.08rem;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .navbar__brand-tagline {
        margin-top: 5px;
        color: #c7c9c0;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.55rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .navbar__desktop {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex: 1;
        min-width: 0;
        gap: 24px;
      }

      .navbar__links {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-inline: auto;
      }

      .navbar__link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 12px;
        color: #d9dbd3;
        background: transparent;
        border: 2px solid transparent;
        border-radius: 0;
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 0.66rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
        cursor: pointer;
        transition:
          color 120ms linear,
          background-color 120ms linear,
          border-color 120ms linear,
          transform 120ms steps(2, end),
          box-shadow 120ms steps(2, end);
      }

      .navbar__link:hover {
        color: var(--ink);
        background: var(--acid);
        border-color: var(--white);
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--warning);
      }

      .navbar__link--active {
        color: var(--ink);
        background: var(--acid);
        border-color: var(--white);
        box-shadow: 4px 4px 0 var(--warning);
      }

      .navbar__link--active::after {
        content: none;
      }

      .navbar__link:focus-visible,
      .navbar__report-button:focus-visible,
      .navbar__menu-toggle:focus-visible,
      .navbar__mobile-report:focus-visible,
      .navbar__dropdown-item:focus-visible,
      .navbar__mobile-link:focus-visible,
      .navbar__mobile-report-button:focus-visible {
        outline: 3px solid var(--acid);
        outline-offset: 3px;
