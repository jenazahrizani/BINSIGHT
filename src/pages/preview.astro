---
import {
  ArrowRight,
  ArrowUpRight,
  Building2,
  ChartColumn,
  FileText,
  Map,
  Menu,
  Recycle,
  X,
} from "@lucide/astro";

const BASE_URL = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

const siteHref = (path: string) => {
  if (
    path.startsWith("http://") ||
    path.startsWith("https://") ||
    path.startsWith("mailto:") ||
    path.startsWith("tel:") ||
    path.startsWith("#") ||
    path.startsWith("data:") ||
    path.startsWith("javascript:")
  ) {
    return path;
  }

  if (path === "/") {
    return `${BASE_URL}/`;
  }

  return `${BASE_URL}${path.startsWith("/") ? path : `/${path}`}`;
};

const services = [
  {
    no: "01",
    title: "Peta",
    label: "SPATIAL",
    text: "Lihat persampahan berdasarkan lokasi dan wilayah di Kabupaten Badung.",
    href: "/map",
    icon: Map,
  },
  {
    no: "02",
    title: "Data",
    label: "INSIGHT",
    text: "Temukan informasi persampahan dalam satu ruang yang mudah dipahami.",
    href: "/dashboard",
    icon: ChartColumn,
  },
  {
    no: "03",
    title: "Organisasi",
    label: "NETWORK",
    text: "Kenali pihak dan jaringan yang membentuk ekosistem persampahan.",
    href: "/organizations",
    icon: Building2,
  },
  {
    no: "04",
    title: "Material",
    label: "MATERIAL",
    text: "Pahami kategori material dan karakter dasar dari setiap jenis sampah.",
    href: "/waste",
    icon: Recycle,
  },
];

const areas = [
  {
    no: "01",
    name: "Badung",
    type: "KABUPATEN",
    status: "TERSEDIA",
  },
  {
    no: "02",
    name: "Mengwi",
    type: "KECAMATAN",
    status: "CONTOH",
  },
  {
    no: "03",
    name: "Abiansemal",
    type: "KECAMATAN",
    status: "CONTOH",
  },
];

const materials = [
  {
    no: "01",
    name: "Organik",
    code: "ORG",
    detail: "Sisa makanan, tumbuhan, dan material organik.",
  },
  {
    no: "02",
    name: "Anorganik",
    code: "ANR",
    detail: "Material non-organik dengan berbagai karakter.",
  },
  {
    no: "03",
    name: "Bahan Berbahaya",
    code: "B3",
    detail: "Material yang membutuhkan perhatian khusus.",
  },
  {
    no: "04",
    name: "Elektronik",
    code: "ELK",
    detail: "Perangkat dan komponen elektronik bekas.",
  },
  {
    no: "05",
    name: "Residu",
    code: "RES",
    detail: "Material sisa yang tidak masuk kategori lain.",
  },
];

const principles = [
  {
    no: "01",
    title: "Kontekstual",
    text: "Informasi ditempatkan bersama lokasi dan konteks yang relevan.",
  },
  {
    no: "02",
    title: "Terbuka",
    text: "Informasi publik disusun agar mudah ditemukan dan dipahami.",
  },
  {
    no: "03",
    title: "Bertanggung jawab",
    text: "Penyajian informasi memperhatikan sumber, konteks, dan penggunaannya.",
  },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>BINSIGHT — Badung Waste Intelligence</title>

    <meta
      name="description"
      content="Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
    />

    <meta
      name="theme-color"
      content="#f4f5ef"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="site">

      <!-- =====================================================
           HEADER
      ====================================================== -->

      <header class="header">
        <div class="page-width header__inner">

          <a
            href={siteHref("/")}
            class="brand"
            aria-label="BINSIGHT"
          >
            <span
              class="brand__mark"
              aria-hidden="true"
            >
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </span>

            <span class="brand__text">
              BINSIGHT
            </span>
          </a>

          <nav
            class="desktop-nav"
            aria-label="Navigasi utama"
          >
            <a
              href={siteHref("/")}
              class="is-active"
            >
              Beranda
            </a>

            <a href={siteHref("/map")}>
              Peta
            </a>

            <a href={siteHref("/dashboard")}>
              Data
            </a>

            <a href={siteHref("/organizations")}>
              Organisasi
            </a>

            <a href={siteHref("/waste")}>
              Material
            </a>
          </nav>

          <div class="header__right">

            <span class="header__location">
              BADUNG / BALI
            </span>

            <a
              href={siteHref("/reports/create")}
              class="header__action"
            >
              Laporan
              <ArrowUpRight
                size={15}
                strokeWidth={1.8}
              />
            </a>

            <button
              type="button"
              class="menu-button"
              aria-label="Buka menu"
              aria-expanded="false"
              aria-controls="mobile-nav"
            >
