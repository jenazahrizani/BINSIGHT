        color: var(--ink);
      }

      .organization-card__location {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1rem;
        padding-top: 0.8rem;
        color: var(--ink);
        border-top: 2px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.06em;
        text-transform: uppercase;
