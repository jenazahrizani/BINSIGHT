---
import {
  ArrowDownRight,
  ArrowRight,
  ArrowUpRight,
  Building2,
  ChartColumn,
  FileText,
  Map,
  Menu,
  Recycle,
  Search,
  ShieldCheck,
  TriangleAlert,
  X,
} from "@lucide/astro";

const BASE_URL = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

function siteHref(path: string): string {
  if (!path) return `${BASE_URL}/`;

  if (/^(?:https?:|mailto:|tel:|#|data:|javascript:)/i.test(path)) {
    return path;
  }

  const normalized = path.startsWith("/") ? path : `/${path}`;

  if (
    BASE_URL &&
    (normalized === BASE_URL ||
      normalized.startsWith(`${BASE_URL}/`))
  ) {
    return normalized;
  }

  if (normalized === "/") {
    return `${BASE_URL}/`;
  }

  return `${BASE_URL}${normalized}`;
}

const services = [
  {
    number: "01",
    title: "Peta Persampahan",
    description:
      "Melihat informasi persampahan berdasarkan wilayah dan lokasi untuk memahami kondisi secara lebih kontekstual.",
    detail: "LOCATION / CONTEXT",
    href: "/map",
    icon: Map,
  },
  {
    number: "02",
    title: "Data & Informasi",
    description:
      "Membaca informasi yang tersedia di BINSIGHT dalam bentuk yang lebih terstruktur dan mudah dipahami.",
    detail: "DATA / INSIGHT",
    href: "/dashboard",
    icon: ChartColumn,
  },
  {
    number: "03",
    title: "Jaringan Organisasi",
    description:
      "Menemukan organisasi, komunitas, pendidikan, dan pihak lain yang bergerak dalam isu persampahan.",
    detail: "PEOPLE / NETWORK",
    href: "/organizations",
    icon: Building2,
  },
  {
    number: "04",
    title: "Edukasi & Pengetahuan",
    description:
      "Mengenali kategori material dan memahami bahwa setiap jenis sampah memiliki karakteristik pengelolaan yang berbeda.",
    detail: "MATERIAL / EDUCATION",
    href: "/waste",
    icon: Recycle,
  },
];

const principles = [
  {
    number: "01",
    title: "Kontekstual",
    text: "Informasi dilihat bersama lokasi, material, organisasi, dan kondisi lingkungan.",
  },
  {
    number: "02",
    title: "Terbuka",
    text: "Platform dirancang agar informasi publik mudah ditemukan, dibaca, dan dijelajahi.",
  },
  {
    number: "03",
    title: "Bertanggung Jawab",
    text: "Informasi ditampilkan secara hati-hati tanpa menambahkan data publik yang belum tervalidasi.",
  },
];

const wasteCategories = [
  {
    number: "01",
    label: "Organik",
    type: "BIOLOGICAL MATERIAL",
  },
  {
    number: "02",
    label: "Anorganik",
    type: "RECYCLABLE MATERIAL",
  },
  {
    number: "03",
    label: "Bahan Berbahaya",
    type: "SPECIAL HANDLING",
  },
  {
    number: "04",
    label: "Elektronik",
    type: "ELECTRONIC MATERIAL",
  },
  {
    number: "05",
    label: "Residu",
    type: "FINAL MATERIAL",
  },
];

const organizations = [
  {
    name: "Organisasi Contoh A",
    type: "Komunitas",
    area: "Badung",
    verified: true,
  },
  {
    name: "Organisasi Contoh B",
    type: "Swasta",
    area: "Mengwi",
    verified: true,
  },
  {
    name: "Organisasi Contoh C",
    type: "Pendidikan",
    area: "Abiansemal",
    verified: false,
  },
];

const contextItems = [
  {
    number: "01",
    label: "PLACE",
    title: "Lokasi",
    text: "Kondisi dilihat berdasarkan ruang dan wilayah.",
    href: "/map",
  },
  {
    number: "02",
    label: "DATA",
    title: "Informasi",
    text: "Catatan dan informasi disusun menjadi konteks.",
    href: "/dashboard",
  },
  {
    number: "03",
    label: "PEOPLE",
    title: "Organisasi",
    text: "Ekosistem pengelola dapat ditemukan dan dikenali.",
    href: "/organizations",
  },
  {
    number: "04",
    label: "MATERIAL",
    title: "Pengetahuan",
    text: "Jenis material dipahami sebelum menentukan penanganan.",
    href: "/waste",
  },
];

const footerLinks = [
  { label: "Peta", href: "/map" },
  { label: "Data", href: "/dashboard" },
  { label: "Organisasi", href: "/organizations" },
  { label: "Jenis Sampah", href: "/waste" },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="BINSIGHT — Badung Waste Intelligence. Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
    />

    <meta
      name="theme-color"
      content="#f4efe8"
    />

    <title>
      BINSIGHT — Badung Waste Intelligence
    </title>

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500;600&family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="site">

      <!-- =========================
           HEADER
      ========================== -->

      <header
        class="header"
        id="top"
      >
        <div class="shell header__inner">

          <a
            class="brand"
            href={siteHref("/")}
            aria-label="BINSIGHT Beranda"
          >
            <span
              class="brand__symbol"
              aria-hidden="true"
            >
              B
            </span>

            <span class="brand__copy">
              <strong>BINSIGHT</strong>

              <small>
                BADUNG WASTE INTELLIGENCE
              </small>
            </span>
          </a>

          <nav
            class="desktop-nav"
            aria-label="Navigasi utama"
          >
            <a
              class="desktop-nav__item is-active"
              href={siteHref("/")}
            >
              Beranda
            </a>

            <a
              class="desktop-nav__item"
              href={siteHref("/map")}
            >
              Peta
            </a>

            <a
              class="desktop-nav__item"
              href={siteHref("/dashboard")}
            >
              Data
            </a>

            <a
              class="desktop-nav__item"
              href={siteHref("/organizations")}
            >
              Organisasi
            </a>

            <a
              class="desktop-nav__item"
              href={siteHref("/company")}
            >
              Tentang
            </a>
          </nav>

          <div class="header__actions">

            <a
              class="header-search"
              href={siteHref("/search")}
              aria-label="Cari BINSIGHT"
            >
              <Search
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>

            <button
              class="menu-trigger"
              type="button"
              aria-label="Buka menu"
              aria-expanded="false"
              data-menu-trigger
            >
              <Menu
                size={21}
                stroke-width={2}
                data-menu-open
              />

              <X
                size={21}
                stroke-width={2}
                data-menu-close
                hidden
              />
            </button>

          </div>
        </div>

        <div
          class="mobile-panel"
          data-mobile-panel
          hidden
        >
          <div class="shell mobile-panel__inner">

            <div class="mobile-panel__intro">
              <small>
                NAVIGATION / BINSIGHT
              </small>

              <span>
                BADUNG WASTE INTELLIGENCE
              </span>
            </div>

            <nav
              class="mobile-nav"
              aria-label="Navigasi mobile"
            >
              <a href={siteHref("/")}>
                <span>01</span>
                <strong>Beranda</strong>
              </a>

              <a href={siteHref("/map")}>
                <span>02</span>
                <strong>Peta</strong>
              </a>

              <a href={siteHref("/dashboard")}>
                <span>03</span>
                <strong>Data</strong>
              </a>

              <a href={siteHref("/organizations")}>
                <span>04</span>
                <strong>Organisasi</strong>
              </a>

              <a href={siteHref("/company")}>
                <span>05</span>
                <strong>Tentang</strong>
              </a>
            </nav>

          </div>
        </div>
      </header>


      <main>

        <!-- =========================
             HERO
        ========================== -->

        <section class="hero">
          <div class="shell hero__inner">

            <aside class="hero__side-label">
              <span>01</span>

              <span>
                PUBLIC PLATFORM
              </span>

              <span>
                BADUNG / BALI
              </span>
            </aside>

            <div class="hero__content">

              <p class="hero__eyebrow">
                <span aria-hidden="true"></span>
                BADUNG WASTE INTELLIGENCE
              </p>

              <h1>
                Membaca
                <em>Badung</em>
                lewat
                <strong>informasi.</strong>
              </h1>

              <div class="hero__lower">

                <div class="hero__description">

                  <p>
                    BINSIGHT menghubungkan informasi
                    persampahan Kabupaten Badung dalam
                    satu ruang digital — dari lokasi,
                    data, organisasi, material,
                    sampai laporan masyarakat.
                  </p>

                  <div class="hero__buttons">

                    <a
                      class="button button--blue"
                      href={siteHref("/map")}
                    >
                      Jelajahi BINSIGHT

                      <ArrowUpRight
                        size={17}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </a>

                    <a
                      class="button button--line"
                      href={siteHref("/company")}
                    >
                      Tentang platform
                    </a>

                  </div>

                </div>


                <div
                  class="hero__signal"
                  aria-label="Ringkasan sistem BINSIGHT"
                >

                  <div class="signal-head">
                    <span>
                      PLATFORM SIGNAL
                    </span>

                    <span>
                      LIVE
                    </span>
                  </div>

                  <div class="signal-main">

                    <div class="signal-title">
                      <span>BADUNG</span>

                      <strong>
                        CONTEXT
                      </strong>
                    </div>

                    <div
                      class="signal-bars"
                      aria-hidden="true"
                    >
                      <span style="--size: 76%;"></span>
                      <span style="--size: 51%;"></span>
                      <span style="--size: 84%;"></span>
                      <span style="--size: 63%;"></span>
                      <span style="--size: 91%;"></span>
                      <span style="--size: 44%;"></span>
                      <span style="--size: 68%;"></span>
                      <span style="--size: 58%;"></span>
                      <span style="--size: 82%;"></span>
                      <span style="--size: 72%;"></span>
                    </div>

                    <div class="signal-axis">
                      <span>PLACE</span>
                      <span>DATA</span>
                      <span>PEOPLE</span>
                    </div>

                  </div>

                  <div class="signal-foot">

                    <span>
                      INFORMATION SYSTEM
                    </span>

                    <strong>
                      ACTIVE
                    </strong>

                  </div>

                </div>

              </div>
            </div>

          </div>
        </section>


        <!-- =========================
             INTRO
        ========================== -->

        <section class="intro">
          <div class="shell">

            <div class="section-marker">
              <span>02</span>
              <span>ABOUT THE PLATFORM</span>
            </div>

            <div class="intro__grid">

              <div class="intro__headline">

                <span class="big-number">
                  01
                </span>

                <h2>
                  Sampah adalah
                  <em>konteks.</em>
                </h2>

              </div>

              <div class="intro__copy">

                <p class="lead">
                  Persampahan tidak berdiri sebagai
                  satu masalah yang terpisah.
                </p>

                <p>
                  Ada material, lokasi, pengelola,
                  kebiasaan, proses, dan kondisi
                  lingkungan yang semuanya
                  saling berhubungan.
                </p>

                <p>
                  BINSIGHT menyatukan hubungan tersebut
                  menjadi informasi yang lebih mudah
                  ditemukan dan dipahami.
                </p>

                <a
                  class="arrow-link"
                  href={siteHref("/company")}
                >
                  Kenali BINSIGHT

                  <span>
                    <ArrowUpRight
                      size={15}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </span>
                </a>

              </div>

            </div>

          </div>
        </section>


        <!-- =========================
             SERVICES
        ========================== -->

        <section class="services">
          <div class="shell">

            <div class="section-marker">
              <span>03</span>
              <span>EXPLORE</span>
            </div>

            <div class="services__intro">

              <div>

                <p class="mini-label">
                  WHAT YOU CAN EXPLORE
                </p>

                <h2>
                  Empat pintu.
                  <em>Satu ekosistem.</em>
                </h2>

              </div>

              <p>
                Setiap bagian memberikan sudut pandang
                yang berbeda tanpa memisahkan
                hubungan antar informasi.
              </p>

            </div>

            <div class="service-list">

              {services.map((service) => {
                const Icon = service.icon;

                return (
                  <a
                    class="service-row"
                    href={siteHref(service.href)}
                  >

                    <div class="service-row__number">
                      {service.number}
                    </div>

                    <div class="service-row__icon">
                      <Icon
                        size={22}
                        stroke-width={1.8}
                        aria-hidden="true"
                      />
                    </div>

                    <div class="service-row__main">

                      <small>
                        {service.detail}
                      </small>

                      <h3>
                        {service.title}
                      </h3>

                      <p>
                        {service.description}
                      </p>

                    </div>

                    <div class="service-row__action">

                      <span>
                        Explore
                      </span>

                      <div>
                        <ArrowUpRight
                          size={18}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </div>

                    </div>

                  </a>
                );
              })}

            </div>

          </div>
        </section>


        <!-- =========================
             FLOW
        ========================== -->

        <section class="flow">
          <div class="shell">

            <div class="section-marker section-marker--light">
              <span>04</span>
              <span>HOW IT CONNECTS</span>
            </div>

            <div class="flow__header">

              <div>

                <p class="mini-label mini-label--light">
                  INFORMATION FLOW
                </p>

                <h2>
                  Lihat.
                  <span>Pahami.</span>
                  Bertindak.
                </h2>

              </div>

              <p>
                Informasi di BINSIGHT dibangun sebagai
                rangkaian konteks, bukan sekadar
                kumpulan halaman.
              </p>

            </div>

            <div class="flow-line">

              <div class="flow-step">

                <span class="flow-step__number">
                  01
                </span>

                <div class="flow-step__circle">
                  <Map
                    size={21}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>

                <small>PLACE</small>

                <strong>
                  Lokasi
                </strong>

                <p>
                  Di mana kondisi ditemukan?
                </p>

              </div>

              <div
                class="flow-arrow"
                aria-hidden="true"
              >
                <ArrowRight
                  size={20}
                  stroke-width={1.8}
                />
              </div>

              <div class="flow-step">

                <span class="flow-step__number">
                  02
                </span>

                <div class="flow-step__circle">
                  <ChartColumn
                    size={21}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>

                <small>DATA</small>

                <strong>
                  Informasi
                </strong>

                <p>
                  Apa yang tercatat?
                </p>

              </div>

              <div
                class="flow-arrow"
                aria-hidden="true"
              >
                <ArrowRight
                  size={20}
                  stroke-width={1.8}
                />
              </div>

              <div class="flow-step">

                <span class="flow-step__number">
                  03
                </span>

                <div class="flow-step__circle">
                  <Building2
                    size={21}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>

                <small>NETWORK</small>

                <strong>
                  Orang
                </strong>

                <p>
                  Siapa yang bergerak?
                </p>

              </div>

              <div
                class="flow-arrow"
                aria-hidden="true"
              >
                <ArrowRight
                  size={20}
                  stroke-width={1.8}
                />
              </div>

              <div class="flow-step">

                <span class="flow-step__number">
                  04
                </span>

                <div class="flow-step__circle">
                  <FileText
                    size={21}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>

                <small>ACTION</small>

                <strong>
                  Laporan
                </strong>

                <p>
                  Apa yang bisa disampaikan?
                </p>

              </div>

            </div>

          </div>
        </section>


        <!-- =========================
             PRINCIPLES
        ========================== -->

        <section class="principles">
          <div class="shell">

            <div class="section-marker">
              <span>05</span>
              <span>PRINCIPLES</span>
            </div>

            <div class="principles__headline">

              <p class="mini-label">
                DESIGNING FOR TRUST
              </p>

              <h2>
                Informasi publik
                <em>harus terasa jelas.</em>
              </h2>

            </div>

            <div class="principles__grid">

              {principles.map((item) => (
                <article class="principle">

                  <div class="principle__top">

                    <span>
                      {item.number}
                    </span>

                    <ArrowDownRight
                      size={17}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />

                  </div>

                  <h3>
                    {item.title}
                  </h3>

                  <p>
                    {item.text}
                  </p>

                </article>
              ))}

            </div>

          </div>
        </section>


        <!-- =========================
             NETWORK
        ========================== -->

        <section class="network">
          <div class="shell">

            <div class="section-marker">
              <span>06</span>
              <span>NETWORK</span>
            </div>

            <div class="network__header">

              <div>

                <p class="mini-label">
                  ECOSYSTEM DIRECTORY
                </p>

                <h2>
                  Siapa yang
                  <em>bergerak?</em>
                </h2>

              </div>

              <div class="network__side">

                <p>
                  Kenali organisasi dan pihak yang
                  terlibat dalam pengelolaan
                  persampahan dan lingkungan.
                </p>

                <a
                  class="arrow-link"
                  href={siteHref("/organizations")}
                >
                  Lihat semua organisasi

                  <span>
                    <ArrowUpRight
                      size={15}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </span>
                </a>

              </div>

            </div>


            <div class="directory">

              <div class="directory__head">

                <span>INDEX</span>
                <span>ORGANIZATION</span>
                <span>TYPE</span>
                <span>AREA</span>
                <span>STATUS</span>
                <span></span>

              </div>


              {organizations.map((organization, index) => (
                <a
                  class="directory__row"
                  href={siteHref("/organizations")}
                >

                  <span class="directory__index">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="directory__name">

                    <strong>
                      {organization.name}
                    </strong>

                    <small>
                      PUBLIC ORGANIZATION
                    </small>

                  </span>

                  <span class="directory__type">
                    {organization.type}
                  </span>

                  <span class="directory__area">
                    {organization.area}
                  </span>

                  <span
                    class:list={[
                      "directory__status",
                      organization.verified &&
                        "is-verified",
                    ]}
                  >

                    <ShieldCheck
                      size={14}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />

                    {organization.verified
                      ? "TERVERIFIKASI"
                      : "CONTOH"}

                  </span>

                  <ArrowUpRight
                    class="directory__arrow"
                    size={18}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />

                </a>
              ))}

            </div>

            <p class="data-note">
              Data organisasi di atas merupakan
              contoh visual untuk kebutuhan preview.
            </p>

          </div>
        </section>


        <!-- =========================
             MATERIALS
        ========================== -->

        <section class="materials">
          <div class="shell">

            <div class="section-marker">
              <span>07</span>
              <span>MATERIAL KNOWLEDGE</span>
            </div>

            <div class="materials__layout">

              <div class="materials__intro">

                <p class="mini-label">
                  MATERIAL LIBRARY
                </p>

                <h2>
                  Kenali apa yang
                  <em>kita buang.</em>
                </h2>

                <p>
                  Setiap material memiliki
                  karakteristik dan kebutuhan
                  pengelolaan yang berbeda.
                </p>

                <a
                  class="material-button"
                  href={siteHref("/waste")}
                >
                  Lihat jenis sampah

                  <ArrowUpRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

              </div>

              <div
                class="material-cloud"
                aria-label="Kategori sampah"
              >

                {wasteCategories.map((category, index) => (
                  <a
                    class:list={[
                      "material-chip",
                      `material-chip--${index + 1}`,
                    ]}
                    href={siteHref("/waste")}
                  >

                    <span>
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <strong>
                      {category.label}
                    </strong>

                    <small>
                      {category.type}
                    </small>

                    <ArrowUpRight
                      size={17}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />

                  </a>
                ))}

              </div>

            </div>

          </div>
        </section>


        <!-- =========================
             CONTEXT INDEX
             Penutup non-CTA
        ========================== -->

        <section class="context-index">
          <div class="shell">

            <div class="section-marker">
              <span>08</span>
              <span>CONTEXT INDEX</span>
            </div>

            <div class="context-index__header">

              <div>

                <p class="mini-label">
                  BINSIGHT SYSTEM
                </p>

                <h2>
                  Empat konteks.
                  <em>Satu pandangan.</em>
                </h2>

              </div>

              <p>
                BINSIGHT mempertemukan tempat,
                informasi, manusia, dan material
                agar isu persampahan dapat dilihat
                secara lebih utuh.
              </p>

            </div>


            <div class="context-grid">

              {contextItems.map((item) => (
                <a
                  class="context-card"
                  href={siteHref(item.href)}
                >

                  <div class="context-card__top">

                    <span>
                      {item.number}
                    </span>

                    <ArrowUpRight
                      size={18}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />

                  </div>

                  <small>
