---
import {
  ArrowRight,
  ArrowUpRight,
  Building2,
  ChartColumn,
  ChevronRight,
  CircleCheck,
  FileText,
  Map,
  Menu,
  Recycle,
  Search,
  ShieldCheck,
  X,
} from "@lucide/astro";

const BASE_URL = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

const siteHref = (path: string) => {
  if (
    path.startsWith("http://") ||
    path.startsWith("https://") ||
    path.startsWith("mailto:") ||
    path.startsWith("tel:") ||
    path.startsWith("#") ||
    path.startsWith("data:") ||
    path.startsWith("javascript:")
  ) {
    return path;
  }

  if (path === "/") return `${BASE_URL}/`;

  return `${BASE_URL}${path.startsWith("/") ? path : `/${path}`}`;
};

const services = [
  {
    number: "01",
    title: "Peta",
    description:
      "Lihat informasi persampahan berdasarkan lokasi dan wilayah di Kabupaten Badung.",
    href: "/map",
    icon: Map,
  },
  {
    number: "02",
    title: "Data",
    description:
      "Temukan informasi dan data persampahan dalam tampilan yang sederhana.",
    href: "/dashboard",
    icon: ChartColumn,
  },
  {
    number: "03",
    title: "Organisasi",
    description:
      "Kenali organisasi dan jaringan yang terkait dengan ekosistem persampahan.",
    href: "/organizations",
    icon: Building2,
  },
  {
    number: "04",
    title: "Material",
    description:
      "Pelajari berbagai jenis material sampah dan karakteristik dasarnya.",
    href: "/waste",
    icon: Recycle,
  },
];

const areas = [
  {
    number: "01",
    name: "Badung",
    description:
      "Informasi tingkat Kabupaten Badung.",
    status: "TERSEDIA",
  },
  {
    number: "02",
    name: "Mengwi",
    description:
      "Informasi wilayah Kecamatan Mengwi.",
    status: "CONTOH",
  },
  {
    number: "03",
    name: "Abiansemal",
    description:
      "Informasi wilayah Kecamatan Abiansemal.",
    status: "CONTOH",
  },
];

const materials = [
  {
    name: "Organik",
    description: "Material yang berasal dari sumber hayati.",
    code: "ORG",
  },
  {
    name: "Anorganik",
    description: "Material seperti plastik, kaca, dan logam.",
    code: "ANR",
  },
  {
    name: "Bahan Berbahaya",
    description: "Material yang membutuhkan perhatian khusus.",
    code: "B3",
  },
  {
    name: "Elektronik",
    description: "Perangkat dan komponen elektronik bekas.",
    code: "ELK",
  },
  {
    name: "Residu",
    description: "Material yang tidak termasuk kategori lainnya.",
    code: "RES",
  },
];

const steps = [
  {
    number: "01",
    title: "Temukan",
    description:
      "Cari informasi berdasarkan lokasi, kategori, atau area yang ingin diketahui.",
    icon: Search,
  },
  {
    number: "02",
    title: "Pahami",
    description:
      "Baca informasi secara lebih lengkap untuk memahami konteks yang tersedia.",
    icon: FileText,
  },
  {
    number: "03",
    title: "Hubungkan",
    description:
      "Gunakan informasi yang tersedia untuk melihat hubungan antarwilayah dan organisasi.",
    icon: Building2,
  },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>BINSIGHT — Badung Waste Intelligence</title>

    <meta
      name="description"
      content="Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
    />

    <meta name="theme-color" content="#f4f7f8" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="page">

      <!-- =====================================================
           HEADER
      ====================================================== -->

      <header class="site-header">
        <div class="shell site-header__inner">

          <a
            href={siteHref("/")}
            class="logo"
            aria-label="BINSIGHT"
          >
            <span class="logo__shape">
              <span></span>
              <span></span>
              <span></span>
            </span>

            <span class="logo__text">
              <strong>BINSIGHT</strong>
              <small>BADUNG WASTE INTELLIGENCE</small>
            </span>
          </a>

          <nav
            class="navigation"
            aria-label="Navigasi utama"
          >
            <a
              class="navigation__link navigation__link--active"
              href={siteHref("/")}
            >
              Beranda
            </a>

            <a
              class="navigation__link"
              href={siteHref("/map")}
            >
              Peta
            </a>

            <a
              class="navigation__link"
              href={siteHref("/dashboard")}
            >
              Data
            </a>

            <a
              class="navigation__link"
              href={siteHref("/organizations")}
            >
              Organisasi
            </a>

            <a
              class="navigation__link"
              href="#tentang"
            >
              Tentang
            </a>
          </nav>

          <div class="site-header__actions">

            <a
              class="search-button"
              href={siteHref("/dashboard")}
              aria-label="Buka data"
            >
              <Search
                size={18}
                strokeWidth={2}
              />
              <span>Cari informasi</span>
            </a>

            <button
              type="button"
              class="mobile-menu-button"
              aria-expanded="false"
              aria-controls="mobile-navigation"
              aria-label="Buka menu"
            >
              <Menu
                data-menu-open
                size={21}
              />

              <X
                data-menu-close
                size={21}
              />
            </button>

          </div>

        </div>

        <div
          class="mobile-navigation"
          id="mobile-navigation"
        >
          <div class="shell mobile-navigation__inner">

            <a href={siteHref("/")}>
              Beranda
            </a>

            <a href={siteHref("/map")}>
              Peta
            </a>

            <a href={siteHref("/dashboard")}>
              Data
            </a>

            <a href={siteHref("/organizations")}>
              Organisasi
            </a>

            <a href="#tentang">
              Tentang
            </a>

          </div>
        </div>
      </header>


      <main>

        <!-- ===================================================
             HERO
        ==================================================== -->

        <section class="hero">
          <div class="shell hero__inner">

            <div class="hero__content">

              <div class="hero__tag">
                <span class="hero__tag-dot"></span>
                PLATFORM INFORMASI PUBLIK
              </div>

              <h1>
                Kenali kondisi
                <span>persampahan</span>
                di Badung.
              </h1>

              <p class="hero__lead">
                BINSIGHT menghadirkan informasi persampahan Kabupaten
                Badung dalam satu platform yang mudah ditemukan,
                dipahami, dan digunakan.
              </p>

              <div class="hero__buttons">

                <a
                  class="primary-button"
                  href={siteHref("/map")}
                >
                  Mulai menjelajah
                  <ArrowRight
                    size={18}
                  />
                </a>

                <a
                  class="secondary-button"
                  href={siteHref("/dashboard")}
                >
                  Lihat informasi
                  <ArrowUpRight
                    size={17}
                  />
                </a>

              </div>

            </div>


            <div class="hero__directory">

              <div class="hero__directory-head">
                <div>
                  <span>EXPLORE BINSIGHT</span>
                  <strong>Pilih informasi yang ingin Anda lihat.</strong>
                </div>

                <div class="hero__directory-status">
                  <span></span>
                  AKTIF
                </div>
              </div>


              <div class="hero__directory-list">

                {
                  services.map((service) => {
                    const Icon = service.icon;

                    return (
                      <a
                        href={siteHref(service.href)}
                        class="hero-service"
                      >
                        <span class="hero-service__number">
                          {service.number}
                        </span>

                        <span class="hero-service__icon">
                          <Icon
                            size={19}
                            strokeWidth={2}
                          />
                        </span>

                        <span class="hero-service__copy">
                          <strong>{service.title}</strong>
                          <small>
                            {service.description}
                          </small>
                        </span>

                        <ChevronRight
                          size={19}
                          class="hero-service__arrow"
                        />
                      </a>
                    );
                  })
                }

              </div>

            </div>

          </div>
        </section>


        <!-- ===================================================
             INTRO
        ==================================================== -->

        <section class="statement">
          <div class="shell statement__inner">

            <div class="statement__label">
              <span>01</span>
              <span>TENTANG PLATFORM</span>
            </div>

            <div class="statement__copy">
              <h2>
                Satu tempat untuk
                <span>memahami persampahan.</span>
              </h2>

              <p>
                Informasi persampahan sering tersebar di berbagai tempat.
                BINSIGHT menyatukannya ke dalam pengalaman digital yang
                lebih sederhana agar masyarakat dapat memahami konteks
                persampahan dengan lebih mudah.
              </p>
            </div>

          </div>
        </section>


        <!-- ===================================================
             SERVICES
        ==================================================== -->

        <section class="services">
          <div class="shell">

            <div class="section-intro">
              <div class="section-intro__label">
                <span>02</span>
                <small>YANG DAPAT ANDA LAKUKAN</small>
              </div>

              <div>
                <h2>
                  Cari. Baca.
                  <span>Pahami.</span>
                </h2>

                <p>
                  Gunakan area utama BINSIGHT untuk menemukan jenis
                  informasi yang Anda perlukan.
                </p>
              </div>
            </div>


            <div class="service-cards">

              {
                services.map((service) => {
                  const Icon = service.icon;

                  return (
                    <a
                      href={siteHref(service.href)}
                      class="service-card"
                    >

                      <div class="service-card__top">
                        <span>
                          {service.number}
                        </span>

                        <div class="service-card__icon">
                          <Icon
                            size={24}
                            strokeWidth={2}
                          />
                        </div>
                      </div>

                      <div class="service-card__content">
                        <h3>
                          {service.title}
                        </h3>

                        <p>
                          {service.description}
                        </p>
                      </div>

                      <div class="service-card__bottom">
                        <span>
                          Buka
                        </span>

                        <ArrowUpRight
                          size={18}
                        />
                      </div>

                    </a>
                  );
                })
              }

            </div>

          </div>
        </section>


        <!-- ===================================================
             HOW IT WORKS
        ==================================================== -->

        <section class="how-it-works">
          <div class="shell">

            <div class="how-it-works__header">

              <div class="how-it-works__title">
                <span>03</span>

                <div>
                  <small>CARA MENGGUNAKAN</small>

                  <h2>
                    Dari pertanyaan
                    <span>menjadi pemahaman.</span>
                  </h2>
                </div>
              </div>

              <p>
                BINSIGHT dirancang agar pengguna dapat bergerak dari
                informasi dasar menuju konteks yang lebih lengkap
                tanpa proses yang rumit.
              </p>

            </div>


            <div class="steps">

              {
                steps.map((step, index) => {
                  const Icon = step.icon;

                  return (
                    <article class="step">

                      <div class="step__number">
                        {step.number}
                      </div>

                      <div class="step__icon">
                        <Icon
                          size={23}
                          strokeWidth={2}
                        />
                      </div>

                      <h3>
                        {step.title}
                      </h3>

                      <p>
                        {step.description}
                      </p>

                      {
                        index < steps.length - 1 && (
                          <div class="step__connector"></div>
                        )
                      }

                    </article>
                  );
                })
              }

            </div>

          </div>
        </section>


        <!-- ===================================================
             COVERAGE
        ==================================================== -->

        <section class="coverage">
          <div class="shell">

            <div class="coverage__header">

              <div>
                <span class="number-label">
                  04
                </span>

                <small>
                  CAKUPAN INFORMASI
                </small>

                <h2>
                  Melihat Badung
                  <span>dari dekat.</span>
                </h2>
              </div>

              <p>
                Jelajahi informasi berdasarkan wilayah untuk melihat
                konteks persampahan yang lebih dekat dengan lokasi Anda.
              </p>

            </div>


            <div class="area-list">

              {
                areas.map((area) => (
                  <a
                    href={siteHref("/map")}
                    class="area-card"
                  >

                    <div class="area-card__top">
                      <span>{area.number}</span>

                      <span class="area-card__status">
                        <CircleCheck
                          size={14}
                        />
                        {area.status}
                      </span>
                    </div>

                    <div class="area-card__body">
                      <h3>
                        {area.name}
                      </h3>

                      <p>
                        {area.description}
                      </p>
                    </div>

                    <div class="area-card__action">
                      <span>
                        Lihat wilayah
                      </span>

                      <ArrowRight
                        size={17}
                      />
                    </div>

                  </a>
                ))
              }

            </div>

          </div>
        </section>


        <!-- ===================================================
             MATERIALS
        ==================================================== -->

        <section class="materials">
          <div class="shell materials__inner">

            <div class="materials__intro">

              <div class="section-intro__label">
                <span>05</span>
                <small>PENGETAHUAN MATERIAL</small>
              </div>

              <h2>
                Kenali
                <span>materialnya.</span>
              </h2>

              <p>
                Mengenal kategori sampah membantu pengguna memahami
                bahwa setiap material memiliki karakter dan kebutuhan
                penanganan yang berbeda.
              </p>

              <a
                href={siteHref("/waste")}
                class="inline-link"
              >
                Pelajari semua kategori
                <ArrowRight
                  size={17}
                />
              </a>

            </div>


            <div class="material-list">

              {
                materials.map((material) => (
                  <a
                    href={siteHref("/waste")}
                    class="material-card"
                  >

                    <div class="material-card__code">
                      {material.code}
                    </div>

                    <div class="material-card__content">
                      <h3>
                        {material.name}
                      </h3>

                      <p>
                        {material.description}
                      </p>
                    </div>

                    <ChevronRight
                      size={19}
                      class="material-card__arrow"
                    />

                  </a>
                ))
              }

            </div>

          </div>
        </section>


        <!-- ===================================================
             TRUST
        ==================================================== -->

        <section
          class="trust"
          id="tentang"
        >
          <div class="shell trust__inner">

            <div class="trust__heading">

              <span>06</span>

              <div>
                <small>
                  PRINSIP BINSIGHT
                </small>

                <h2>
                  Informasi yang
                  <span>jelas dan bertanggung jawab.</span>
                </h2>
              </div>

            </div>


            <div class="trust__items">

              <div class="trust-card">

                <div class="trust-card__icon">
                  <Map
                    size={22}
                  />
                </div>

                <h3>
                  Berbasis konteks
                </h3>

                <p>
                  Informasi tidak berdiri sendiri, tetapi ditempatkan
                  berdasarkan lokasi dan konteks yang relevan.
                </p>

              </div>


              <div class="trust-card">

                <div class="trust-card__icon">
                  <ShieldCheck
                    size={22}
                  />
                </div>

                <h3>
                  Terstruktur
                </h3>

                <p>
                  Informasi disusun secara teratur agar lebih mudah
                  ditemukan, dibaca, dan dipahami.
                </p>

              </div>


              <div class="trust-card">

                <div class="trust-card__icon">
                  <CircleCheck
                    size={22}
                  />
                </div>

                <h3>
                  Bertanggung jawab
                </h3>

                <p>
                  BINSIGHT mengedepankan penyajian informasi publik
                  yang jelas dan dapat digunakan secara tepat.
                </p>

              </div>

            </div>

          </div>
        </section>


        <!-- ===================================================
             FINAL CTA
        ==================================================== -->

        <section class="final-section">
          <div class="shell final-section__inner">

            <div class="final-section__copy">

              <small>
                BINSIGHT
              </small>

              <h2>
                Kenali.
                <span>Pahami.</span>
                Jaga Badung.
              </h2>

              <p>
                Mulai dari informasi yang paling Anda butuhkan.
              </p>

            </div>

            <a
              href={siteHref("/map")}
              class="final-button"
            >
              Jelajahi BINSIGHT
              <ArrowUpRight
                size={20}
              />
            </a>

          </div>
        </section>

      </main>


      <!-- =====================================================
           FOOTER
      ====================================================== -->

      <footer class="footer">

        <div class="shell footer__main">

          <div class="footer__identity">

            <a
              href={siteHref("/")}
              class="logo logo--footer"
            >

              <span class="logo__shape">
                <span></span>
                <span></span>
                <span></span>
              </span>

              <span class="logo__text">
                <strong>BINSIGHT</strong>
                <small>BADUNG WASTE INTELLIGENCE</small>
              </span>

            </a>

            <p>
              Platform informasi persampahan Kabupaten Badung.
            </p>

          </div>


          <div class="footer__links">

            <div>
              <small>JELAJAHI</small>

              <a href={siteHref("/map")}>
                Peta
              </a>

              <a href={siteHref("/dashboard")}>
                Data
              </a>

              <a href={siteHref("/organizations")}>
                Organisasi
              </a>

              <a href={siteHref("/waste")}>
                Material
              </a>
            </div>


            <div>
              <small>TENTANG</small>

              <a href="#tentang">
                BINSIGHT
              </a>

              <a href={siteHref("/map")}>
                Eksplorasi
              </a>
            </div>

          </div>

        </div>


        <div class="shell footer__bottom">

          <span>
            © {currentYear} BINSIGHT
          </span>

          <span>
            BADUNG WASTE INTELLIGENCE
          </span>

          <span>
            PUBLIC INFORMATION PLATFORM
          </span>

        </div>

      </footer>


      <!-- =====================================================
           ONLY REPORT ACTION
      ====================================================== -->

      <a
        href={siteHref("/reports/create")}
        class="floating-report"
        aria-label="Buat laporan masyarakat"
      >

        <span class="floating-report__mark">
          <FileText
            size={19}
            strokeWidth={2}
          />
        </span>

        <span class="floating-report__text">
          <small>
            LAPORAN MASYARAKAT
          </small>

          <strong>
            Buat laporan
          </strong>
        </span>

        <ArrowUpRight
          size={18}
        />

      </a>

    </div>


    <script>
      const menuButton =
        document.querySelector<HTMLButtonElement>(
          ".mobile-menu-button"
        );

      const mobileNavigation =
        document.querySelector<HTMLElement>(
          ".mobile-navigation"
        );

      const menuOpen =
        document.querySelector<SVGElement>(
          "[data-menu-open]"
        );

      const menuClose =
        document.querySelector<SVGElement>(
          "[data-menu-close]"
        );

      const toggleMenu = (open: boolean) => {
        if (!menuButton || !mobileNavigation) {
          return;
        }

        menuButton.setAttribute(
          "aria-expanded",
          String(open)
        );

        menuButton.setAttribute(
          "aria-label",
          open ? "Tutup menu" : "Buka menu"
        );

        mobileNavigation.classList.toggle(
          "mobile-navigation--open",
          open
        );

        if (menuOpen instanceof HTMLElement) {
          menuOpen.style.display = open
            ? "none"
            : "block";
        }

        if (menuClose instanceof HTMLElement) {
          menuClose.style.display = open
            ? "block"
            : "none";
        }
      };

      toggleMenu(false);

      menuButton?.addEventListener(
        "click",
        () => {
          const current =
            menuButton.getAttribute(
              "aria-expanded"
            ) === "true";

          toggleMenu(!current);
        }
      );

      document
        .querySelectorAll<HTMLAnchorElement>(
          ".mobile-navigation a"
        )
        .forEach((link) => {
          link.addEventListener(
            "click",
            () => toggleMenu(false)
          );
        });

      window.addEventListener(
        "resize",
        () => {
          if (window.innerWidth > 900) {
            toggleMenu(false);
          }
        }
      );
    </script>


    <style>
      :root {
        --bg: #f4f7f8;
        --white: #ffffff;

        --ink: #101828;
        --ink-soft: #273444;
        --muted: #687585;

        --blue: #2563eb;
        --blue-dark: #1747b8;
        --blue-soft: #eaf1ff;

        --mint: #dff4ea;
        --mint-dark: #24735a;

        --line: #e1e7ec;

        --dark: #101827;
        --dark-soft: #182335;

        --radius-sm: 12px;
        --radius-md: 18px;
        --radius-lg: 26px;

        --shell: 1240px;
      }


      /* =====================================================
         RESET
      ====================================================== */

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;

        background: var(--bg);
        color: var(--ink);

        font-family: "Manrope", sans-serif;

        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      svg {
        flex-shrink: 0;
      }

      .page {
        min-height: 100vh;
        overflow: clip;
      }

      .shell {
        width: min(
          calc(100% - 48px),
          var(--shell)
        );

        margin-inline: auto;
      }


      /* =====================================================
         HEADER
      ====================================================== */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;

        background: rgba(
          255,
          255,
          255,
          0.88
        );

        backdrop-filter: blur(18px);

        border-bottom:
          1px solid
          rgba(225, 231, 236, 0.9);
      }

      .site-header__inner {
        min-height: 76px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 32px;
      }

      .logo {
        display: inline-flex;
        align-items: center;

        gap: 11px;
        flex-shrink: 0;
      }

      .logo__shape {
        width: 34px;
        height: 34px;

        display: grid;

        grid-template-columns:
          repeat(2, 1fr);

        grid-template-rows:
          repeat(2, 1fr);

        gap: 3px;
      }

      .logo__shape span {
        display: block;

        background: var(--ink);

        border-radius: 2px;
      }

      .logo__shape span:nth-child(2) {
        background: var(--blue);
      }

      .logo__shape span:nth-child(3) {
        background: var(--mint-dark);
      }

      .logo__text {
        display: grid;
        gap: 3px;
      }

      .logo__text strong {
        font-size: 16px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      .logo__text small {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 7px;
        line-height: 1.2;

        letter-spacing: 0.07em;
      }

      .navigation {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .navigation__link {
        position: relative;

        color: #596575;

        font-size: 13px;
        font-weight: 600;

        transition:
          color 160ms ease;
      }

      .navigation__link:hover,
      .navigation__link--active {
        color: var(--ink);
      }

      .navigation__link--active::after {
        content: "";

        position: absolute;

        left: 50%;
        bottom: -12px;

        width: 5px;
        height: 5px;

        border-radius: 50%;

        background: var(--blue);

        transform: translateX(-50%);
      }

      .site-header__actions {
        display: flex;
        align-items: center;

        gap: 9px;
      }

      .search-button {
        min-height: 40px;

        padding: 0 13px;

        display: inline-flex;
        align-items: center;

        gap: 8px;

        border:
          1px solid
          var(--line);

        border-radius:
          var(--radius-sm);

        background: white;

        color: var(--ink-soft);

        font-size: 11px;
        font-weight: 600;

        transition:
          border-color 160ms ease,
          background 160ms ease;
      }

      .search-button:hover {
        border-color: #c8d2dc;
        background: #fafcfd;
      }

      .mobile-menu-button {
        width: 40px;
        height: 40px;

        display: none;

        align-items: center;
        justify-content: center;

        border:
          1px solid
          var(--line);

        border-radius:
          var(--radius-sm);

        background: white;
        color: var(--ink);

        cursor: pointer;
      }

      .mobile-menu-button [data-menu-close] {
        display: none;
      }

      .mobile-navigation {
        display: none;

        border-top:
          1px solid
          var(--line);
      }

      .mobile-navigation__inner {
        padding: 8px 0 18px;
      }

      .mobile-navigation a {
        min-height: 51px;

        display: flex;
        align-items: center;

        border-bottom:
          1px solid
          var(--line);

        color: var(--ink);

        font-size: 14px;
        font-weight: 700;
      }


      /* =====================================================
         HERO
      ====================================================== */

      .hero {
        padding: 42px 0 60px;
      }

      .hero__inner {
        min-height: 660px;

        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          minmax(390px, 0.78fr);

        gap: 54px;

        align-items: center;

        padding: 76px;

        border-radius:
          var(--radius-lg);

        background:
          linear-gradient(
            145deg,
            #ffffff 0%,
            #f8fbff 58%,
            #edf5ff 100%
          );

        box-shadow:
          0 18px 55px
          rgba(22, 40, 69, 0.07);

        border:
          1px solid
          rgba(225, 231, 236, 0.8);
      }

      .hero__content {
        max-width: 700px;
      }

      .hero__tag {
        display: inline-flex;
        align-items: center;

        gap: 9px;

        margin-bottom: 28px;

        color: #526071;

        font-family: "DM Mono", monospace;

        font-size: 9px;

        letter-spacing: 0.08em;
      }

      .hero__tag-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: var(--blue);
      }

      .hero h1 {
        margin: 0;

        max-width: 740px;

        font-size: clamp(
          54px,
          7vw,
          94px
        );

        line-height: 0.98;

        letter-spacing: -0.065em;

        font-weight: 700;
      }

      .hero h1 span {
        display: block;
        color: var(--blue);
      }

      .hero__lead {
        max-width: 640px;

        margin: 32px 0 0;

        color: var(--muted);

        font-size: 17px;

        line-height: 1.75;
      }

      .hero__buttons {
        margin-top: 36px;

        display: flex;

        align-items: center;

        gap: 10px;

        flex-wrap: wrap;
      }

      .primary-button,
      .secondary-button {
        min-height: 52px;

        padding: 0 18px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 10px;

        border-radius:
          var(--radius-sm);

        font-size: 12px;
        font-weight: 800;

        transition:
          background 160ms ease,
          border-color 160ms ease,
          color 160ms ease;
      }

      .primary-button {
        background: var(--blue);
        color: white;
      }

      .primary-button:hover {
        background: var(--blue-dark);
      }

      .secondary-button {
        border:
          1px solid
          var(--line);

        background: white;

        color: var(--ink);
      }

      .secondary-button:hover {
        border-color: #c5d0dc;
        background: #f9fbfd;
      }

      .hero__directory {
        width: 100%;

        border-radius:
          var(--radius-md);

        background: var(--dark);

        color: white;

        box-shadow:
          0 20px 48px
          rgba(16, 24, 39, 0.13);
      }

      .hero__directory-head {
        min-height: 105px;

        padding: 23px 23px 18px;

        display: flex;

        justify-content: space-between;
        align-items: flex-start;

        gap: 20px;

        border-bottom:
          1px solid
          rgba(255, 255, 255, 0.1);
      }

      .hero__directory-head > div:first-child {
        display: grid;
        gap: 7px;
      }

      .hero__directory-head span {
        color: rgba(
          255,
          255,
          255,
          0.4
        );

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.08em;
      }

      .hero__directory-head strong {
        max-width: 280px;

        color: white;

        font-size: 14px;

        line-height: 1.45;

        font-weight: 700;
      }

      .hero__directory-status {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        color: #9ce0c2 !important;

        font-family: "DM Mono", monospace;

        font-size: 8px !important;
      }

      .hero__directory-status span {
        width: 6px;
        height: 6px;

        border-radius: 50%;

        background: #71d3a5;
      }

      .hero__directory-list {
        padding: 10px;
      }

      .hero-service {
        min-height: 92px;

        padding: 14px;

        display: grid;

        grid-template-columns:
          32px
          44px
          minmax(0, 1fr)
          22px;

        align-items: center;

        gap: 12px;

        border-radius:
          var(--radius-sm);

        transition:
          background 160ms ease;
      }

      .hero-service:hover {
        background:
          rgba(255, 255, 255, 0.06);
      }

      .hero-service__number {
        color: rgba(
          255,
          255,
          255,
          0.3
        );

        font-family: "DM Mono", monospace;

        font-size: 9px;
      }

      .hero-service__icon {
        width: 44px;
        height: 44px;

        display: grid;
        place-items: center;

        border-radius:
          11px;

        background:
          rgba(255, 255, 255, 0.08);

        color: #9bbcff;
      }

      .hero-service__copy {
        min-width: 0;

        display: grid;
        gap: 4px;
      }

      .hero-service__copy strong {
        color: white;

        font-size: 14px;
        font-weight: 700;
      }

      .hero-service__copy small {
        max-width: 280px;

        overflow: hidden;

        color: rgba(
          255,
          255,
          255,
          0.46
        );

        font-size: 10px;

        line-height: 1.45;

        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
      }

      .hero-service__arrow {
        color: rgba(
          255,
          255,
          255,
          0.35
        );
      }


      /* =====================================================
         STATEMENT
      ====================================================== */

      .statement {
        padding: 55px 0 110px;
      }

      .statement__inner {
        display: grid;

        grid-template-columns:
          180px
          minmax(0, 850px);

        gap: 60px;
      }

      .statement__label {
        padding-top: 8px;

        display: flex;
        flex-direction: column;

        gap: 8px;
      }

      .statement__label span:first-child {
        color: var(--blue);

        font-family: "DM Mono", monospace;

        font-size: 10px;
      }

      .statement__label span:last-child {
        color: #8994a2;

        font-family: "DM Mono", monospace;

        font-size: 8px;

        line-height: 1.4;

        letter-spacing: 0.08em;
      }

      .statement__copy h2 {
        max-width: 860px;

        margin: 0;

        font-size: clamp(
          42px,
          5vw,
          66px
        );

        line-height: 1.02;

        letter-spacing: -0.055em;

        font-weight: 700;
      }

      .statement__copy h2 span {
        display: block;
        color: var(--blue);
      }

      .statement__copy p {
        max-width: 680px;

        margin: 28px 0 0;

        color: var(--muted);

        font-size: 16px;

        line-height: 1.75;
      }


      /* =====================================================
         SERVICES
      ====================================================== */

      .services {
        padding: 105px 0;

        background: white;
      }

      .section-intro {
        display: grid;

        grid-template-columns:
          180px
          minmax(0, 1fr);

        gap: 60px;

        margin-bottom: 56px;
      }

      .section-intro__label {
        display: flex;

        align-items: flex-start;

        gap: 10px;
      }

      .section-intro__label span {
        color: var(--blue);

        font-family: "DM Mono", monospace;

        font-size: 10px;
      }

      .section-intro__label small {
        color: #8994a2;

        font-family: "DM Mono", monospace;

        font-size: 8px;

        line-height: 1.45;

        letter-spacing: 0.08em;
      }

      .section-intro h2 {
        margin: 0;

        font-size: clamp(
          42px,
          5vw,
          66px
        );

        line-height: 1;

        letter-spacing: -0.055em;

        font-weight: 700;
      }

      .section-intro h2 span {
        color: var(--blue);
      }

      .section-intro p {
        max-width: 610px;

        margin: 23px 0 0;

        color: var(--muted);

        font-size: 15px;

        line-height: 1.7;
      }

      .service-cards {
        display: grid;

        grid-template-columns:
          repeat(4, minmax(0, 1fr));

        gap: 14px;
      }

      .service-card {
        min-height: 370px;

        padding: 23px;

        display: flex;
        flex-direction: column;

        border:
          1px solid
          var(--line);

        border-radius:
          var(--radius-md);

        background: white;

        transition:
          transform 180ms ease,
          border-color 180ms ease,
          box-shadow 180ms ease;
      }

      .service-card:hover {
        transform: translateY(-4px);

        border-color:
          #cbd6e1;

        box-shadow:
          0 18px 34px
          rgba(30, 55, 88, 0.08);
      }

      .service-card__top {
        display: flex;

        align-items: center;
        justify-content: space-between;
      }

      .service-card__top > span {
        color: #9ba7b4;

        font-family: "DM Mono", monospace;

        font-size: 9px;
      }

      .service-card__icon {
        width: 47px;
        height: 47px;

        display: grid;
        place-items: center;

        border-radius:
          12px;

        background: var(--blue-soft);

        color: var(--blue);
      }

      .service-card__content {
        margin-top: auto;
      }

      .service-card__content h3 {
        margin: 0;

        font-size: 25px;

        line-height: 1.1;

        letter-spacing: -0.035em;

        font-weight: 700;
      }

      .service-card__content p {
        margin: 14px 0 0;

        color: var(--muted);

        font-size: 13px;

        line-height: 1.7;
      }

      .service-card__bottom {
        margin-top: 28px;

        padding-top: 17px;

        display: flex;

        align-items: center;
        justify-content: space-between;

        border-top:
          1px solid
          var(--line);

        color: var(--blue);

        font-size: 11px;

        font-weight: 800;
      }


      /* =====================================================
         HOW IT WORKS
      ====================================================== */

      .how-it-works {
        padding: 110px 0;

        background: var(--dark);

        color: white;
      }

      .how-it-works__header {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          390px;

        gap: 70px;

        align-items: end;

        margin-bottom: 70px;
      }

      .how-it-works__title {
        display: flex;

        align-items: flex-start;

        gap: 15px;
      }

      .how-it-works__title > span {
        padding-top: 6px;

        color: #91abda;

        font-family: "DM Mono", monospace;

        font-size: 10px;
      }

      .how-it-works__title small {
        color: rgba(
          255,
          255,
          255,
          0.42
        );

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.08em;
      }

      .how-it-works h2 {
        margin: 20px 0 0;

        font-size: clamp(
          42px,
          5vw,
          67px
        );

        line-height: 1;

        letter-spacing: -0.06em;

        font-weight: 700;
      }

      .how-it-works h2 span {
        display: block;
        color: #80a9ff;
      }

      .how-it-works__header > p {
        margin: 0;

        color: rgba(
          255,
          255,
          255,
          0.57
        );

        font-size: 15px;

        line-height: 1.75;
      }

      .steps {
        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 14px;
      }

      .step {
        position: relative;

        min-height: 305px;

        padding: 27px;

        border-radius:
          var(--radius-md);

        background:
          var(--dark-soft);

        border:
          1px solid
          rgba(255, 255, 255, 0.08);
      }

      .step__number {
        color: rgba(
          255,
          255,
          255,
          0.3
        );

        font-family: "DM Mono", monospace;

        font-size: 9px;
      }

      .step__icon {
        width: 48px;
        height: 48px;

        margin-top: 45px;

        display: grid;
        place-items: center;

        border-radius:
          12px;

        background:
          rgba(128, 169, 255, 0.12);

        color: #8bb0ff;
      }

      .step h3 {
        margin: 28px 0 0;

        font-size: 23px;

        letter-spacing: -0.03em;
      }

      .step p {
        max-width: 340px;

        margin: 11px 0 0;

        color: rgba(
          255,
          255,
          255,
          0.5
        );

        font-size: 13px;

        line-height: 1.7;
      }

      .step__connector {
        position: absolute;

        top: 50%;
        right: -26px;

        width: 38px;
        height: 1px;

        background:
          rgba(255, 255, 255, 0.12);
      }


      /* =====================================================
         COVERAGE
      ====================================================== */

      .coverage {
        padding: 110px 0;

        background: var(--bg);
      }

      .coverage__header {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          420px;

        gap: 70px;

        align-items: end;

        margin-bottom: 55px;
      }

      .number-label {
        color: var(--blue);

        font-family: "DM Mono", monospace;

        font-size: 10px;
      }

      .coverage__header small {
        margin-left: 10px;

        color: #8994a2;

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.08em;
      }

      .coverage__header h2 {
        max-width: 760px;

        margin: 25px 0 0;

        font-size: clamp(
          42px,
          5vw,
          67px
        );

        line-height: 1;

        letter-spacing: -0.055em;

        font-weight: 700;
      }

      .coverage__header h2 span {
        display: block;
        color: var(--blue);
      }

      .coverage__header > p {
        margin: 0;

        color: var(--muted);

        font-size: 15px;

        line-height: 1.75;
      }

      .area-list {
        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 14px;
      }

      .area-card {
        min-height: 310px;

        padding: 26px;

        display: flex;
        flex-direction: column;

        border-radius:
          var(--radius-md);

        background: white;

        border:
          1px solid
          var(--line);

        transition:
          transform 180ms ease,
          box-shadow 180ms ease,
          border-color 180ms ease;
      }

      .area-card:hover {
        transform: translateY(-4px);

        border-color:
          #cbd6e1;

        box-shadow:
          0 18px 36px
          rgba(30, 55, 88, 0.07);
      }

      .area-card__top {
        display: flex;

        align-items: center;
        justify-content: space-between;
      }

      .area-card__top > span:first-child {
        color: #9ba7b4;

        font-family: "DM Mono", monospace;

        font-size: 9px;
      }

      .area-card__status {
        display: inline-flex;

        align-items: center;

        gap: 5px;

        color: var(--mint-dark);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.05em;
      }

      .area-card__body {
        margin-top: auto;
      }

      .area-card__body h3 {
        margin: 0;

        font-size: 31px;

        line-height: 1.05;

        letter-spacing: -0.045em;
      }

      .area-card__body p {
        margin: 13px 0 0;

        color: var(--muted);

        font-size: 13px;

        line-height: 1.65;
      }

      .area-card__action {
        margin-top: 26px;

        padding-top: 16px;

        display: flex;

        align-items: center;
        justify-content: space-between;

        border-top:
          1px solid
          var(--line);

        color: var(--blue);

        font-size: 11px;

        font-weight: 800;
      }


      /* =====================================================
         MATERIALS
      ====================================================== */

      .materials {
        padding: 110px 0;

        background: white;
      }

      .materials__inner {
        display: grid;

        grid-template-columns:
          minmax(0, 0.83fr)
          minmax(0, 1.17fr);

        gap: 100px;

        align-items: start;
      }

      .materials__intro h2 {
        margin: 27px 0 0;

        font-size: clamp(
          42px,
          5vw,
          67px
        );

        line-height: 1;

        letter-spacing: -0.055em;

        font-weight: 700;
      }

      .materials__intro h2 span {
        display: block;
        color: var(--blue);
      }

      .materials__intro > p {
        max-width: 460px;

        margin: 23px 0 0;

        color: var(--muted);

        font-size: 15px;

        line-height: 1.75;
      }

      .inline-link {
        margin-top: 28px;

        display: inline-flex;

        align-items: center;

        gap: 8px;

        color: var(--blue);

        font-size: 12px;

        font-weight: 800;
      }

      .inline-link:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      .material-list {
        display: flex;

        flex-direction: column;

        gap: 9px;
      }

      .material-card {
        min-height: 103px;

        padding: 16px 18px;

        display: grid;

        grid-template-columns:
          60px
          minmax(0, 1fr)
          24px;

        align-items: center;

        gap: 18px;

        border:
          1px solid
          var(--line);

        border-radius:
          var(--radius-md);

        background: var(--bg);

        transition:
          background 160ms ease,
          border-color 160ms ease;
      }

      .material-card:hover {
        background: #eef4ff;

        border-color: #c9d7f0;
      }

      .material-card__code {
        width: 50px;
        height: 50px;

        display: grid;
        place-items: center;

        border-radius:
          13px;

        background: white;

        color: var(--blue);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        box-shadow:
          0 3px 12px
          rgba(21, 39, 63, 0.05);
      }

      .material-card__content {
        min-width: 0;
      }

      .material-card__content h3 {
        margin: 0;

        font-size: 16px;

        line-height: 1.2;

        font-weight: 800;
      }

      .material-card__content p {
        max-width: 520px;

        margin: 6px 0 0;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.5;
      }

      .material-card__arrow {
        color: #97a3b0;
      }


      /* =====================================================
         TRUST
      ====================================================== */

      .trust {
        padding: 110px 0;

        background: var(--mint);
      }

      .trust__inner {
        display: grid;

        grid-template-columns:
          minmax(0, 0.92fr)
          minmax(0, 1.08fr);

        gap: 80px;

        align-items: start;
      }

      .trust__heading {
        display: flex;

        gap: 15px;
      }

      .trust__heading > span {
        color: var(--mint-dark);

        font-family: "DM Mono", monospace;

        font-size: 10px;

        padding-top: 6px;
      }

      .trust__heading small {
        color: #56816f;

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.08em;
      }

      .trust__heading h2 {
        max-width: 610px;

        margin: 22px 0 0;

        font-size: clamp(
          42px,
          5vw,
          64px
        );

        line-height: 1;

        letter-spacing: -0.055em;

        font-weight: 700;
      }

      .trust__heading h2 span {
        display: block;

        color: #207158;
      }

      .trust__items {
        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 10px;
