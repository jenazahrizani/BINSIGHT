/* ==========================================================================
   BINSIGHT — SINGLE-FILE PREVIEW
   GitHub Pages /DeployBinsight safe
   ========================================================================== */

const BASE_URL = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

function siteHref(path: string): string {
  if (!path) {
    return `${BASE_URL}/`;
  }

  /*
   * External / special URLs must not receive the GitHub Pages base.
   */
  if (
    /^(?:https?:|mailto:|tel:|#|data:|javascript:)/i.test(path)
  ) {
    return path;
  }

  const normalizedPath =
    path.startsWith("/") ? path : `/${path}`;

  /*
   * Prevent accidental double-prefix:
   * /DeployBinsight/DeployBinsight/...
   */
  if (
    normalizedPath === BASE_URL ||
    normalizedPath.startsWith(`${BASE_URL}/`)
  ) {
    return normalizedPath;
  }

  /*
   * Root homepage.
   */
  if (normalizedPath === "/") {
    return `${BASE_URL}/`;
  }

  return `${BASE_URL}${normalizedPath}`;
}

function stripBase(path: string): string {
  if (
    BASE_URL &&
    (path === BASE_URL ||
      path.startsWith(`${BASE_URL}/`))
  ) {
    return path.slice(BASE_URL.length) || "/";
  }

  return path;
}

const pathname = stripBase(Astro.url.pathname);

const primaryLinks = [
