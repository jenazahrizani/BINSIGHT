        font-weight: 500;
        line-height: 1.35;
      }

      .navbar__dropdown-item:hover
        .navbar__dropdown-item-copy
        small,
      .navbar__dropdown-item--active
        .navbar__dropdown-item-copy
        small {
        color: #30322d;
      }

      .navbar__actions {
        display: flex;
        align-items: center;
        flex-shrink: 0;
      }

      .navbar__report-button {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 15px;
        color: var(--ink);
        background: var(--acid);
        border: 3px solid var(--ink);
        border-radius: 0;
        box-shadow: 6px 6px 0 var(--white);
        font-family:
          "DM Mono",
