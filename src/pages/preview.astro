    <!-- ====================================================================
         NAVBAR CONTROLLER
         ==================================================================== -->

    <script>
      (() => {
        const initNavbar = () => {
          const navbar =
            document.querySelector<HTMLElement>(
              "[data-navbar]",
            );

          if (!navbar) {
            return;
          }

          if (
            navbar.dataset.navbarInitialized ===
            "true"
          ) {
            return;
          }

          navbar.dataset.navbarInitialized =
            "true";

          const toggle =
            navbar.querySelector<HTMLButtonElement>(
              "[data-navbar-toggle]",
            );

          const mobileMenu =
            navbar.querySelector<HTMLElement>(
              "[data-navbar-mobile]",
            );

          const dropdown =
            navbar.querySelector<HTMLElement>(
              "[data-navbar-dropdown]",
            );

          const dropdownTrigger =
            navbar.querySelector<HTMLButtonElement>(
              "[data-navbar-dropdown-trigger]",
            );

          const dropdownMenu =
            navbar.querySelector<HTMLElement>(
              "[data-navbar-dropdown-menu]",
            );

          const openMobileMenu = () => {
            if (
              !toggle ||
              !mobileMenu
            ) {
              return;
            }

            toggle.setAttribute(
              "aria-expanded",
              "true",
            );

            toggle.setAttribute(
              "aria-label",
              "Tutup menu navigasi",
            );

            mobileMenu.setAttribute(
              "aria-hidden",
              "false",
            );

            navbar.classList.add(
              "navbar--mobile-open",
            );

            document.documentElement.classList.add(
              "navbar-scroll-locked",
            );

            document.body.classList.add(
              "navbar-scroll-locked",
            );
          };

          const closeMobileMenu = () => {
            if (
              !toggle ||
              !mobileMenu
            ) {
              return;
            }

            toggle.setAttribute(
              "aria-expanded",
              "false",
            );

            toggle.setAttribute(
              "aria-label",
              "Buka menu navigasi",
            );

            mobileMenu.setAttribute(
              "aria-hidden",
              "true",
            );

            navbar.classList.remove(
              "navbar--mobile-open",
            );

            document.documentElement.classList.remove(
              "navbar-scroll-locked",
            );

            document.body.classList.remove(
              "navbar-scroll-locked",
            );
          };

          const openDropdown = () => {
            if (
              !dropdown ||
              !dropdownTrigger ||
              !dropdownMenu
            ) {
              return;
            }

            dropdown.classList.add(
              "navbar__dropdown--open",
            );

            dropdownTrigger.setAttribute(
              "aria-expanded",
              "true",
            );

            dropdownMenu.setAttribute(
              "aria-hidden",
              "false",
            );
          };

          const closeDropdown = () => {
            if (
              !dropdown ||
              !dropdownTrigger ||
              !dropdownMenu
            ) {
              return;
            }

            dropdown.classList.remove(
              "navbar__dropdown--open",
            );

            dropdownTrigger.setAttribute(
              "aria-expanded",
              "false",
            );

            dropdownMenu.setAttribute(
              "aria-hidden",
              "true",
            );
          };

          const toggleDropdown = () => {
            if (!dropdown) {
              return;
            }

            const isOpen =
              dropdown.classList.contains(
                "navbar__dropdown--open",
              );

            if (isOpen) {
              closeDropdown();
            } else {
              openDropdown();
            }
          };

          toggle?.addEventListener(
            "click",
            () => {
              const expanded =
                toggle.getAttribute(
                  "aria-expanded",
                ) === "true";

              if (expanded) {
                closeMobileMenu();
              } else {
                openMobileMenu();
              }
            },
          );

          dropdownTrigger?.addEventListener(
            "click",
            toggleDropdown,
          );

          dropdownTrigger?.addEventListener(
            "keydown",
            (event) => {
              if (
                event.key ===
                "ArrowDown"
              ) {
                event.preventDefault();

                openDropdown();

                const firstItem =
                  dropdownMenu?.querySelector<HTMLElement>(
                    '[role="menuitem"]',
                  );

                firstItem?.focus();
              }

              if (
                event.key ===
                "Escape"
              ) {
                event.preventDefault();

                closeDropdown();

                dropdownTrigger.focus();
              }
            },
          );

          dropdownMenu?.addEventListener(
            "keydown",
            (event) => {
              const items =
                Array.from(
                  dropdownMenu.querySelectorAll<HTMLElement>(
                    '[role="menuitem"]',
                  ),
                );

              if (!items.length) {
                return;
              }

              const currentIndex =
                items.indexOf(
                  document.activeElement as HTMLElement,
                );

              if (
                event.key ===
                "ArrowDown"
              ) {
                event.preventDefault();

                const nextIndex =
                  currentIndex <
                  items.length - 1
                    ? currentIndex + 1
                    : 0;

                items[nextIndex]?.focus();
              }

              if (
                event.key ===
                "ArrowUp"
              ) {
                event.preventDefault();

                const previousIndex =
                  currentIndex > 0
                    ? currentIndex - 1
                    : items.length - 1;

                items[
                  previousIndex
                ]?.focus();
              }

              if (
                event.key ===
                "Escape"
              ) {
                event.preventDefault();

                closeDropdown();

                dropdownTrigger?.focus();
              }

              if (
                event.key ===
                "Tab"
              ) {
                closeDropdown();
              }
            },
          );

          document.addEventListener(
            "click",
            (event) => {
              const target =
                event.target;

              if (
                !(target instanceof Node)
              ) {
                return;
              }

              if (
                dropdown &&
                !dropdown.contains(
                  target,
                )
              ) {
                closeDropdown();
              }

              if (
                navbar &&
                !navbar.contains(
                  target,
                )
              ) {
                closeMobileMenu();
              }
            },
          );

          document.addEventListener(
            "keydown",
            (event) => {
              if (
                event.key !==
                "Escape"
              ) {
                return;
              }

              closeDropdown();
              closeMobileMenu();
            },
          );

          mobileMenu
            ?.querySelectorAll("a")
            .forEach((link) => {
              link.addEventListener(
                "click",
                () => {
                  closeMobileMenu();
                },
              );
            });

          window.addEventListener(
            "resize",
            () => {
              if (
                window.innerWidth >
                900
              ) {
                closeMobileMenu();
              }
            },
          );

          let lastScrollY =
            window.scrollY;

          window.addEventListener(
            "scroll",
            () => {
              const currentScrollY =
                window.scrollY;

              if (
                currentScrollY >
                12
              ) {
                navbar.classList.add(
                  "navbar--scrolled",
                );
              } else {
                navbar.classList.remove(
                  "navbar--scrolled",
                );
              }

              if (
                currentScrollY >
                  lastScrollY &&
                currentScrollY >
                  120 &&
                !navbar.classList.contains(
                  "navbar--mobile-open",
                )
              ) {
                navbar.classList.add(
                  "navbar--scroll-down",
                );
              } else {
                navbar.classList.remove(
                  "navbar--scroll-down",
                );
              }

              lastScrollY =
                currentScrollY;
            },
            {
              passive: true,
            },
          );
        };

        initNavbar();

        document.addEventListener(
          "astro:after-swap",
          initNavbar,
        );
      })();
    </script>
