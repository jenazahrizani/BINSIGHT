---
import {
  ArrowRight,
  ArrowUpRight,
  Building2,
  ChartColumn,
  Check,
  ChevronRight,
  Map,
  Menu,
  Recycle,
  Search,
  ShieldCheck,
  X,
} from "@lucide/astro";

const BASE_URL = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

const siteHref = (path: string) => {
  if (
    path.startsWith("http://") ||
    path.startsWith("https://") ||
    path.startsWith("mailto:") ||
    path.startsWith("tel:") ||
    path.startsWith("#") ||
    path.startsWith("data:") ||
    path.startsWith("javascript:")
  ) {
    return path;
  }

  if (path === "/") return `${BASE_URL}/`;

  return `${BASE_URL}${path.startsWith("/") ? path : `/${path}`}`;
};

const services = [
  {
    number: "01",
    title: "Peta Persampahan",
    description:
      "Temukan informasi lokasi dan konteks persampahan Badung melalui tampilan peta yang terstruktur.",
    href: "/map",
    icon: Map,
  },
  {
    number: "02",
    title: "Data & Informasi",
    description:
      "Baca informasi persampahan dalam satu ruang yang lebih jelas, ringkas, dan mudah dipahami.",
    href: "/dashboard",
    icon: ChartColumn,
  },
  {
    number: "03",
    title: "Organisasi",
    description:
      "Kenali jaringan organisasi dan pihak yang berhubungan dengan ekosistem persampahan.",
    href: "/organizations",
    icon: Building2,
  },
  {
    number: "04",
    title: "Pengetahuan Material",
    description:
      "Pahami karakter berbagai jenis sampah agar keputusan pengelolaan material lebih tepat.",
    href: "/waste",
    icon: Recycle,
  },
];

const principles = [
  {
    number: "01",
    title: "Kontekstual",
    description:
      "Informasi ditempatkan dalam konteks lokasi, material, dan organisasi agar lebih mudah dipahami.",
  },
  {
    number: "02",
    title: "Terbuka",
    description:
      "Informasi publik disajikan dengan struktur yang sederhana sehingga dapat digunakan oleh lebih banyak orang.",
  },
  {
    number: "03",
    title: "Bertanggung Jawab",
    description:
      "Data dan informasi ditampilkan dengan perhatian pada sumber, konteks, dan penggunaan yang tepat.",
  },
];

const organizations = [
  {
    number: "01",
    name: "Badung",
    type: "Wilayah",
    area: "Kabupaten Badung",
    status: "TERVERIFIKASI",
  },
  {
    number: "02",
    name: "Mengwi",
    type: "Wilayah",
    area: "Kabupaten Badung",
    status: "CONTOH",
  },
  {
    number: "03",
    name: "Abiansemal",
    type: "Wilayah",
    area: "Kabupaten Badung",
    status: "CONTOH",
  },
];

const materials = [
  {
    number: "01",
    name: "Organik",
    code: "ORG",
  },
  {
    number: "02",
    name: "Anorganik",
    code: "ANR",
  },
  {
    number: "03",
    name: "Bahan Berbahaya",
    code: "B3",
  },
  {
    number: "04",
    name: "Elektronik",
    code: "ELK",
  },
  {
    number: "05",
    name: "Residu",
    code: "RES",
  },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>BINSIGHT — Badung Waste Intelligence</title>

    <meta
      name="description"
      content="Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
    />

    <meta name="theme-color" content="#0d2f25" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="site">

      <!-- =========================================================
           HEADER
      ========================================================== -->

      <header class="header">
        <div class="container header__inner">

          <a
            href={siteHref("/")}
            class="brand"
            aria-label="BINSIGHT Beranda"
          >
            <span class="brand__mark" aria-hidden="true">
              <span></span>
              <span></span>
            </span>

            <span class="brand__copy">
              <strong>BINSIGHT</strong>
              <small>BADUNG WASTE INTELLIGENCE</small>
            </span>
          </a>

          <nav class="desktop-nav" aria-label="Navigasi utama">
            <a href={siteHref("/")}>Beranda</a>
            <a href={siteHref("/map")}>Peta</a>
            <a href={siteHref("/dashboard")}>Data</a>
            <a href={siteHref("/organizations")}>Organisasi</a>
            <a href="#about">Tentang</a>
          </nav>

          <div class="header__right">

            <a
              href={siteHref("/dashboard")}
              class="header-search"
              aria-label="Buka data"
            >
              <Search size={17} strokeWidth={2} />
              <span>DATA</span>
            </a>

            <button
              class="menu-trigger"
              type="button"
              aria-expanded="false"
              aria-controls="mobile-menu"
              aria-label="Buka menu"
            >
              <Menu data-menu-open size={21} strokeWidth={2} />
              <X data-menu-close size={21} strokeWidth={2} />
            </button>

          </div>
        </div>

        <div class="mobile-menu" id="mobile-menu">
          <div class="mobile-menu__inner">
            <a href={siteHref("/")}>Beranda</a>
            <a href={siteHref("/map")}>Peta</a>
            <a href={siteHref("/dashboard")}>Data</a>
            <a href={siteHref("/organizations")}>Organisasi</a>
            <a href="#about">Tentang</a>
          </div>
        </div>
      </header>


      <main>

        <!-- =======================================================
             HERO
        ======================================================== -->

        <section class="hero">
          <div class="container hero__inner">

            <div class="hero__eyebrow">
              <span class="hero__eyebrow-line"></span>

              <small>
                BADUNG WASTE INTELLIGENCE
              </small>
            </div>

            <h1>
              Informasi
              <strong>persampahan</strong>
              Badung dalam satu ruang.
            </h1>

            <div class="hero__bottom">

              <p>
                BINSIGHT membantu masyarakat menemukan, memahami, dan
                menghubungkan informasi persampahan melalui peta, data,
                organisasi, dan pengetahuan material yang tersedia dalam
                satu platform.
              </p>

              <div class="hero__actions">

                <a
                  href={siteHref("/map")}
                  class="button button--primary"
                >
                  Jelajahi Peta
                  <ArrowRight size={18} strokeWidth={2} />
                </a>

                <a
                  href={siteHref("/dashboard")}
                  class="button button--secondary"
                >
                  Lihat Data
                  <ArrowUpRight size={17} strokeWidth={2} />
                </a>

              </div>
            </div>

            <div class="hero__meta">

              <div>
                <span>PLATFORM</span>
                <strong>BINSIGHT</strong>
              </div>

              <div>
                <span>WILAYAH</span>
                <strong>KABUPATEN BADUNG</strong>
              </div>

              <div>
                <span>FUNGSI</span>
                <strong>INFORMASI PUBLIK</strong>
              </div>

            </div>

          </div>
        </section>


        <!-- =======================================================
             INTRO
        ======================================================== -->

        <section class="intro-strip">
          <div class="container intro-strip__grid">

            <div class="intro-strip__label">
              <span>PLATFORM</span>
              <span>01</span>
            </div>

            <div class="intro-strip__text">
              <p>
                Persampahan adalah persoalan ruang, material, manusia,
                dan informasi. BINSIGHT mempertemukan semuanya agar
                konteksnya dapat dilihat dengan lebih jelas.
              </p>
            </div>

            <div class="intro-strip__aside">
              <span>BADUNG, BALI</span>
              <strong>PUBLIC INFORMATION PLATFORM</strong>
            </div>

          </div>
        </section>


        <!-- =======================================================
             SERVICES
        ======================================================== -->

        <section class="services section">
          <div class="container">

            <div class="section-heading">

              <div class="section-heading__label">
                <span class="section-number">02</span>
                <span class="section-kicker">LAYANAN UTAMA</span>
              </div>

              <div class="section-heading__content">
                <h2>
                  Semua yang
                  <span>perlu diketahui.</span>
                </h2>

                <p>
                  Empat area utama yang membentuk pengalaman BINSIGHT.
                  Setiap area memiliki fungsi yang berbeda dan saling
                  melengkapi.
                </p>
              </div>

            </div>


            <div class="service-grid">

              {
                services.map((service) => {
                  const Icon = service.icon;

                  return (
                    <a
                      href={siteHref(service.href)}
                      class="service-card"
                    >

                      <div class="service-card__header">
                        <span>{service.number}</span>

                        <ArrowUpRight
                          size={21}
                          strokeWidth={1.8}
                        />
                      </div>

                      <div class="service-card__icon">
                        <Icon
                          size={29}
                          strokeWidth={1.8}
                        />
                      </div>

                      <div class="service-card__body">

                        <h3>
                          {service.title}
                        </h3>

                        <p>
                          {service.description}
