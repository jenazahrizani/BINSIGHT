        line-height: 0.8;

        letter-spacing: -0.1em;
      }

      .context__side-line {
        width: 44px;
        height: 2px;

        margin-top: 20px;

        background: var(--blue);
      }

      .context__side > small {
        margin-top: 16px;

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        line-height: 1.9;

        letter-spacing: 0.09em;
      }

      .context__content {
        max-width: 860px;
      }

      .context__lead {
        margin: 0 0 22px;

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.08em;

        text-transform: uppercase;
      }

      .context__heading h2 {
        max-width: 840px;

        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          48px,
          5.7vw,
          79px
        );

        line-height: 0.94;

        letter-spacing: -0.075em;

        font-weight: 600;
      }

      .context__heading h2 span {
        color: var(--blue);
      }

      .context__bottom {
        margin-top: 70px;

        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          250px;

        gap: 70px;

        align-items: end;
      }

      .context__bottom > p {
        max-width: 570px;

        margin: 0;

        color: var(--ink-soft);

        font-size: 14px;

        line-height: 1.85;
      }

      .context__formula {
        padding-top: 17px;

        display: flex;

        flex-wrap: wrap;

        gap: 7px 9px;

        border-top:
          1px solid
          var(--ink);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        line-height: 1.6;

        letter-spacing: 0.06em;
      }

      .context__formula i {
        color: var(--blue);

        font-style: normal;
      }


      /* =====================================================
         METHOD
      ====================================================== */

      .method {
        padding: 125px 0;

        background: var(--surface);
      }

      .method__header {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          380px;

        gap: 80px;

        align-items: end;
      }

      .method__header h2 {
        max-width: 680px;

        margin: 20px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          48px,
          5.4vw,
          75px
        );

        line-height: 0.94;

        letter-spacing: -0.07em;

        font-weight: 600;
      }

      .method__header h2 span {
        display: block;

        color: var(--blue);
      }

      .method__header > p {
        margin: 0;

        color: var(--ink-soft);

        font-size: 14px;

        line-height: 1.8;
      }

      .timeline {
        position: relative;

        margin-top: 85px;

        border-top:
          1px solid
          var(--ink);
      }

      .timeline::before {
        content: "";

        position: absolute;

        left: 0;
        right: 0;

        top: 45px;

        height: 1px;

        background: var(--line);
      }

      .timeline__item {
        position: relative;

        display: grid;

        grid-template-columns:
          90px
          60px
          minmax(0, 1fr);

        gap: 18px;

        min-height: 330px;

        padding-top: 22px;

        border-right:
          1px solid
          var(--line);
      }

      .timeline {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);
      }

      .timeline__item:last-child {
        border-right: 0;
      }

      .timeline__index {
        padding-left: 2px;

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .timeline__marker {
        position: relative;

        z-index: 2;

        width: 38px;
        height: 38px;

        margin-top: -8px;

        display: grid;

        place-items: center;

        background: var(--surface);

        border:
          1px solid
          var(--ink);

        border-radius: 50%;
      }

      .timeline__marker span {
        width: 9px;
        height: 9px;

        border-radius: 50%;

        background: var(--lime);
      }

      .timeline__copy {
        padding:
          48px
          30px
          30px
          0;
      }

      .timeline__copy small {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.08em;
      }

      .timeline__copy h3 {
        margin: 17px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: 34px;

        line-height: 1;

        letter-spacing: -0.05em;

        font-weight: 600;
      }

      .timeline__copy p {
        max-width: 260px;

        margin: 14px 0 0;

        color: var(--ink-soft);

        font-size: 12px;

        line-height: 1.8;
      }


      /* =====================================================
         AREAS
      ====================================================== */

      .areas {
        padding: 120px 0;

        background: var(--bg);
      }

      .areas__header {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          350px;

        gap: 80px;

        align-items: end;

        margin-bottom: 55px;
      }

      .areas__header h2 {
        margin: 19px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          48px,
          5.5vw,
          76px
        );

        line-height: 0.94;

        letter-spacing: -0.07em;

        font-weight: 600;
      }

      .areas__header h2 span {
        color: var(--blue);
      }

      .areas__header p {
        margin: 0;

        color: var(--ink-soft);

        font-size: 14px;

        line-height: 1.8;
      }

      .areas__list {
        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 10px;
      }

      .area-card {
        min-height: 325px;

        padding: 22px;

        display: flex;

        flex-direction: column;

        border:
          1px solid
          var(--line);

        background: var(--surface);

        transition:
          transform 170ms ease,
          border-color 170ms ease;
      }

      .area-card:hover {
        transform: translateY(-4px);

        border-color: var(--ink);
      }

      .area-card__number {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .area-card__main {
        margin-top: auto;
      }

      .area-card__main > span {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.08em;
      }

      .area-card__main h3 {
        margin: 11px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: 30px;

        line-height: 0.98;

        letter-spacing: -0.05em;

        font-weight: 600;
      }

      .area-card__main p {
        margin: 11px 0 0;

        color: var(--muted);

        font-size: 11px;
      }

      .area-card__status {
        margin-top: 28px;

        padding-top: 14px;

        display: flex;

        align-items: center;
        justify-content: space-between;

        border-top:
          1px solid
          var(--line);
      }

      .area-card__status span {
        color: var(--navy);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.08em;
      }


      /* =====================================================
         MATERIALS
      ====================================================== */

      .materials {
        padding: 120px 0;

        background: var(--bg-soft);

        border-top:
          1px solid
          var(--line);

        border-bottom:
          1px solid
          var(--line);
      }

      .materials__header {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          350px;

        gap: 80px;

        align-items: end;

        margin-bottom: 58px;
      }

      .materials__title h2 {
        max-width: 720px;

        margin: 19px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          48px,
          5.3vw,
          74px
        );

        line-height: 0.94;

        letter-spacing: -0.07em;

        font-weight: 600;
      }

      .materials__title h2 span {
        display: block;

        color: var(--blue);
      }

      .materials__description > p {
        margin: 0;

        color: var(--ink-soft);

        font-size: 14px;

        line-height: 1.8;
      }

      .text-link {
        margin-top: 22px;

        display: inline-flex;

        align-items: center;

        gap: 8px;

        color: var(--ink);

        font-size: 10px;

        font-weight: 700;
      }

      .text-link:hover {
        text-decoration: underline;

        text-underline-offset: 4px;
      }

      .material-list {
        border-top:
          1px solid
          var(--ink);
      }

      .material-item {
        min-height: 105px;

        display: grid;

        grid-template-columns:
          70px
          80px
          minmax(0, 1fr)
          40px;

        gap: 18px;

        align-items: center;

        border-bottom:
          1px solid
          rgba(16,24,32,0.14);

        transition:
          background 160ms ease,
          padding 160ms ease;
      }

      .material-item:hover {
        padding-inline: 14px;

        background: var(--surface);
      }

      .material-item__no {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .material-item__code {
        color: var(--blue);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.08em;
      }

      .material-item__main h3 {
        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: 22px;

        line-height: 1;

        letter-spacing: -0.035em;

        font-weight: 600;
      }

      .material-item__main p {
        margin: 7px 0 0;

        color: var(--muted);

        font-size: 11px;
      }

      .material-item__arrow {
        justify-self: end;
      }


      /* =====================================================
         ABOUT
      ====================================================== */

      .about {
        padding: 125px 0;

        background: var(--surface);
      }

      .about__header {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 50px;

        margin-bottom: 65px;
      }

      .about__header h2 {
        max-width: 680px;

        margin: 19px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          48px,
          5.3vw,
          74px
        );

        line-height: 0.94;

        letter-spacing: -0.07em;

        font-weight: 600;
      }

      .about__header h2 span {
        display: block;

        color: var(--blue);
      }

      .about__badge {
        min-height: 42px;

        padding: 0 13px;

        display: inline-flex;

        align-items: center;

        gap: 9px;

        border:
          1px solid
          var(--line);

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        white-space: nowrap;
      }

      .about__grid {
        display: grid;

        grid-template-columns:
          0.9fr
          1.1fr;

        gap: 90px;
      }

      .about__statement {
        padding:
          28px
          30px
          38px;

        background: var(--navy);

        color: white;
      }

      .about__number {
        margin: 0;

        color:
          rgba(255,255,255,0.37);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .about__statement blockquote {
        max-width: 450px;

        margin: 120px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          28px,
          3.1vw,
          43px
        );

        line-height: 1.02;

        letter-spacing: -0.045em;

        font-weight: 500;
      }

      .about__principles {
        border-top:
          1px solid
          var(--ink);
      }

      .about__principles article {
        min-height: 132px;

        display: grid;

        grid-template-columns: 45px 1fr;

        gap: 24px;

        padding: 22px 0;

        border-bottom:
          1px solid
          var(--line);
      }

      .about__principles article > span {
        color: var(--blue);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .about__principles h3 {
        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: 24px;

        line-height: 1;

        letter-spacing: -0.035em;

        font-weight: 600;
      }

      .about__principles p {
        max-width: 450px;

        margin: 9px 0 0;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.75;
      }


      /* =====================================================
         CTA
      ====================================================== */

      .cta {
        background: var(--lime);
      }

      .cta__inner {
        min-height: 490px;

        padding:
          30px
          0
          48px;

        display: flex;

        flex-direction: column;

        justify-content: space-between;
      }

      .cta__label {
        display: flex;

        align-items: center;
        justify-content: space-between;

        color: rgba(16,24,32,0.5);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        letter-spacing: 0.08em;
      }

      .cta__content {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 50px;
      }

      .cta__content p {
        max-width: 330px;

        margin: 0 0 20px;

        color: rgba(16,24,32,0.62);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        line-height: 1.6;

        text-transform: uppercase;

        letter-spacing: 0.08em;
      }

      .cta__content h2 {
        max-width: 850px;

        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          58px,
          7vw,
          98px
        );

        line-height: 0.88;

        letter-spacing: -0.08em;

        font-weight: 600;
      }

      .cta__content h2 span {
        color: var(--blue);
      }

      .cta__button {
        min-height: 55px;

        padding: 0 19px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 10px;

        flex-shrink: 0;

        background: var(--ink);

        color: white;

        font-size: 10px;

        font-weight: 700;

        transition:
          background 160ms ease,
          transform 160ms ease;
      }

      .cta__button:hover {
        background: var(--navy);

        transform: translateY(-2px);
      }


      /* =====================================================
         FOOTER
      ====================================================== */

      .footer {
        background: var(--ink);

        color: white;
      }

      .footer__top {
        padding:
          74px
          0
          70px;

        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          170px
          190px;

        gap: 70px;
      }

      .brand--footer .brand__name {
        color: white;
      }

      .brand--footer .brand__mark span:nth-child(1),
      .brand--footer .brand__mark span:nth-child(4) {
        background: white;
      }

      .footer__identity p {
        max-width: 330px;

        margin: 22px 0 0;

        color:
          rgba(255,255,255,0.43);

        font-size: 12px;

        line-height: 1.75;
      }

      .footer__column {
        display: flex;

        flex-direction: column;

        align-items: flex-start;
      }

      .footer__column > span {
        margin-bottom: 18px;

        color:
          rgba(255,255,255,0.3);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.09em;
      }

      .footer__column a {
        margin-bottom: 11px;

        color:
          rgba(255,255,255,0.66);

        font-size: 11px;

        transition:
          color 160ms ease;
      }

      .footer__column a:hover {
        color: var(--lime);
      }

      .footer__bottom {
        min-height: 62px;

        display: grid;

        grid-template-columns:
          1fr
          1fr
          1fr;

        align-items: center;

        border-top:
          1px solid
          rgba(255,255,255,0.1);

        color:
          rgba(255,255,255,0.28);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.06em;
      }

      .footer__bottom span:nth-child(2) {
        text-align: center;
      }

      .footer__bottom span:last-child {
        text-align: right;
      }


      /* =====================================================
         FLOATING REPORT
      ====================================================== */

      .floating-report {
        position: fixed;

        right: 22px;
        bottom: 20px;

        z-index: 900;

        min-height: 58px;

        padding:
          7px
          10px
          7px
          7px;

        display: inline-flex;

        align-items: center;

        gap: 10px;

        background: var(--lime);

        color: var(--ink);

        box-shadow:
          0 14px 30px
          rgba(0,0,0,0.14);

        transition:
          transform 160ms ease,
          box-shadow 160ms ease;
      }

      .floating-report:hover {
        transform: translateY(-3px);

        box-shadow:
          0 18px 34px
          rgba(0,0,0,0.17);
      }

      .floating-report__icon {
        width: 37px;
        height: 37px;

        display: grid;

        place-items: center;

        background: var(--ink);

        color: var(--lime);
      }

      .floating-report__copy {
        display: grid;

        gap: 4px;
      }

      .floating-report__copy small {
        color:
          rgba(16,24,32,0.52);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.07em;
      }

      .floating-report__copy strong {
        font-size: 10px;

        font-weight: 800;
      }


      /* =====================================================
         1100
      ====================================================== */

      @media (max-width: 1100px) {

        .desktop-nav {
          gap: 18px;
        }

        .hero__grid {
          grid-template-columns:
            minmax(0, 1fr)
            minmax(330px, 0.76fr);

          gap: 45px;
        }

        .hero h1 {
          font-size: clamp(
            55px,
            7vw,
            82px
          );
        }

        .signal__grid {
          gap: 50px;
        }

        .section-header,
        .method__header,
        .areas__header,
        .materials__header {
          grid-template-columns:
            minmax(0, 1fr)
            310px;

          gap: 45px;
        }

        .context__grid {
          grid-template-columns:
            130px
            minmax(0, 1fr);

          gap: 45px;
        }

      }


      /* =====================================================
         860
      ====================================================== */

      @media (max-width: 860px) {

        .page-width {
          width: min(
            calc(100% - 36px),
            var(--page)
          );
        }

        .desktop-nav,
        .header__report {
          display: none;
        }

        .header__region {
          display: none;
        }

        .header__actions {
          margin-left: auto;
        }

        .menu-button {
          display: inline-flex;
        }

        .mobile-nav.mobile-nav--open {
          display: block;
        }

        .hero__grid {
          min-height: auto;

          grid-template-columns: 1fr;

          gap: 0;
        }

        .hero__copy {
          padding:
            72px
            0
            64px;
        }

        .hero__visual {
          margin-bottom: 0;
        }

        .hero__rail {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .hero__rail-item:nth-child(2) {
          border-right: 0;
        }

        .hero__rail-item:nth-child(-n + 2) {
          border-bottom:
            1px solid
            var(--line);
        }

        .signal__grid {
          grid-template-columns: 1fr;

          gap: 48px;
        }

        .signal__cards {
          grid-template-columns: 1fr;
        }

        .signal-card {
          min-height: 180px;

          border-right: 0;

          border-bottom:
            1px solid
            rgba(255,255,255,0.13);
        }

        .signal-card:last-child {
          border-bottom: 0;
        }

        .section-header,
        .method__header,
        .areas__header,
        .materials__header {
          grid-template-columns: 1fr;

          gap: 28px;
        }

        .service-grid {
          grid-template-columns: 1fr;
        }

        .service-card,
        .service-card--01,
        .service-card--03,
        .service-card--04 {
          min-height: 330px;
        }

        .context__grid {
          grid-template-columns: 1fr;

          gap: 35px;
        }

        .context__side {
          min-height: auto;
        }

        .context__side-number {
          margin-top: 25px;

          font-size: 92px;
        }

        .context__bottom {
          grid-template-columns: 1fr;

          gap: 38px;

          margin-top: 52px;
        }

        .timeline {
          grid-template-columns: 1fr;
        }

        .timeline::before {
          display: none;
        }

        .timeline__item {
          min-height: auto;

          padding-bottom: 40px;

          border-right: 0;

          border-bottom:
            1px solid
            var(--line);

          grid-template-columns:
            70px
            60px
            minmax(0, 1fr);
        }

        .timeline__item:last-child {
          border-bottom: 0;
        }

        .timeline__copy {
          padding:
            45px
            20px
            20px
            0;
        }

        .areas__list {
          grid-template-columns: 1fr;
        }

        .area-card {
          min-height: 270px;
        }

        .about__header {
          align-items: flex-start;

          flex-direction: column;
        }

        .about__grid {
          grid-template-columns: 1fr;

          gap: 45px;
        }

        .about__statement {
          min-height: 370px;
        }

        .footer__top {
          grid-template-columns:
            1fr
            1fr;

          gap: 45px;
        }

        .footer__identity {
          grid-column: 1 / -1;
        }

        .cta__content {
          flex-direction: column;

          align-items: flex-start;

          gap: 35px;
        }

      }


      /* =====================================================
         620
      ====================================================== */

      @media (max-width: 620px) {

        .page-width {
          width: calc(100% - 26px);
        }

        .hero__topline {
          font-size: 6px;
        }

        .hero__topline span:last-child {
          display: none;
        }

        .hero__copy {
          padding:
            58px
            0
            52px;
        }

        .hero h1 {
          font-size: clamp(
            46px,
            13vw,
            66px
          );
        }

        .hero__description {
          margin-top: 29px;

          font-size: 13px;
        }

        .hero__buttons {
          flex-direction: column;

          align-items: stretch;
        }

        .button {
          width: 100%;
        }

        .visual__canvas {
