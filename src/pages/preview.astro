---
import {
  ArrowDown,
  ArrowRight,
  ArrowUpRight,
  Building2,
  ChartColumn,
  FileText,
  Map,
  Menu,
  Recycle,
  Search,
  ShieldCheck,
  TriangleAlert,
  X,
} from "@lucide/astro";

const BASE_URL = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

function siteHref(path: string): string {
  if (!path) return `${BASE_URL}/`;

  if (/^(?:https?:|mailto:|tel:|#|data:|javascript:)/i.test(path)) {
    return path;
  }

  const normalized = path.startsWith("/")
    ? path
    : `/${path}`;

  if (
    BASE_URL &&
    (
      normalized === BASE_URL ||
      normalized.startsWith(`${BASE_URL}/`)
    )
  ) {
    return normalized;
  }

  if (normalized === "/") {
    return `${BASE_URL}/`;
  }

  return `${BASE_URL}${normalized}`;
}

