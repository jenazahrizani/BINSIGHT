        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.55rem;
        color: var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .organization-card__waste-title svg {
        color: var(--warning);
      }

      .organization-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
      }

      .organization-card__tag {
        padding: 5px 7px;
        color: var(--ink);
        background: var(--white);
        border: 2px solid var(--ink);
        border-radius: 0;
        font-size: 9px;
        font-weight: 800;
        line-height: 1.1;
      }

      .organization-card__tag--muted {
        color: var(--acid);
        background: var(--ink);
      }

      .organization-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-top: auto;
        padding-top: 1rem;
        color: var(--ink);
        border-top: 3px solid var(--ink);
        font-family:
          "DM Mono",
          "SFMono-Regular",
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
