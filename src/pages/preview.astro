      .navbar__dropdown {
        position: relative;
      }

      .navbar__dropdown-trigger {
        padding-inline: 12px;
      }

      .navbar__dropdown-icon {
        flex-shrink: 0;
        transition:
          transform 120ms steps(2, end);
      }

      .navbar__dropdown--open
        .navbar__dropdown-icon {
        transform: rotate(180deg);
      }

      .navbar__dropdown-menu {
        position: absolute;
        top: calc(100% + 12px);
        left: 50%;
        width: 350px;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translate(-50%, -6px);
        background: var(--ink-2);
        border: 3px solid var(--white);
        border-radius: 0;
        box-shadow: 9px 9px 0 var(--warning);
