      .organization-card:hover
        .organization-card__logo {
        color: var(--ink);
        background: var(--white);
        transform: rotate(3deg) scale(1.04);
      }

      .organization-card__logo img {
        display: block;
        width: 100%;
        height: 100%;
        padding: 0.75rem;
        object-fit: contain;
        background: var(--white);
