        color: var(--blue);
      }

      .module-card__content {
        margin-top: 22px;
      }

      .module-card__content h3 {
        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: 29px;

        line-height: 1;

        letter-spacing: -0.05em;

        font-weight: 600;
      }

      .module-card__content p {
        max-width: 470px;

        margin: 11px 0 0;

        color: var(--ink-soft);

        font-size: 12px;

        line-height: 1.75;
      }

      .module-card__footer {
        margin-top: 29px;

        padding-top: 14px;

        border-top:
          1px solid
          var(--line);

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.08em;
      }


      /* =====================================================
         DARK SECTION
      ====================================================== */

      .dark-section {
        padding: 105px 0;

        background: var(--dark);

        color: white;
      }

      .dark-section__top {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        padding-bottom: 26px;

        border-bottom:
          1px solid
          rgba(255,255,255,0.12);
      }

      .dark-section__meta {
        display: flex;

        align-items: center;

        gap: 11px;
      }

      .dark-section__meta span {
        width: 26px;
        height: 26px;

        display: grid;

        place-items: center;

        border:
          1px solid
          rgba(255,255,255,0.35);

        border-radius: 50%;

        color: var(--lime);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .dark-section__meta small,
      .dark-section__label {
        color:
          rgba(255,255,255,0.38);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.09em;
      }

      .dark-section__headline {
        padding:
          76px
          0
          66px;
      }

      .dark-section__headline p {
        max-width: 420px;

        margin: 0 0 30px;

        color:
          rgba(255,255,255,0.5);

        font-family: "DM Mono", monospace;

        font-size: 8px;

        line-height: 1.7;

        letter-spacing: 0.08em;

        text-transform: uppercase;
      }

      .dark-section__headline h2 {
        max-width: 1050px;

        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          48px,
          6.8vw,
          95px
        );

        line-height: 0.88;

        letter-spacing: -0.08em;

        font-weight: 600;
      }

      .dark-section__headline h2 span {
        color: var(--lime);
      }

      .dark-section__bottom {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 40px;

        padding-top: 23px;

        border-top:
          1px solid
          rgba(255,255,255,0.12);
      }

      .dark-section__bottom p {
        max-width: 510px;

        margin: 0;

        color:
          rgba(255,255,255,0.53);

        font-size: 13px;

        line-height: 1.8;
      }

      .dark-section__link {
        min-height: 46px;

        padding: 0 14px;

        display: inline-flex;

        align-items: center;

        gap: 9px;

        background: white;

        color: var(--ink);

        font-size: 10px;

        font-weight: 700;
      }


      /* =====================================================
         METHOD
      ====================================================== */

      .method {
        padding: 120px 0;

        background: var(--surface);
      }

      .method__header {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          340px;

        gap: 80px;

        align-items: end;
      }

      .method__header h2 {
        max-width: 690px;

        margin: 18px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          48px,
          5.4vw,
          76px
        );

        line-height: 0.94;

        letter-spacing: -0.07em;

        font-weight: 600;
      }

      .method__header h2 span {
        display: block;

        color: var(--blue);
      }

      .method__header > p {
        margin: 0;

        color: var(--ink-soft);

        font-size: 13px;

        line-height: 1.8;
      }

      .method__grid {
        margin-top: 78px;

        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        border-top:
          1px solid
          var(--ink);
      }

      .method-card {
        min-height: 305px;

        display: grid;

        grid-template-columns:
          48px
          44px
          minmax(0, 1fr);

        gap: 15px;

        padding-top: 22px;

        border-right:
          1px solid
          var(--line);
      }

      .method-card:last-child {
        border-right: 0;
      }

      .method-card__number {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .method-card__marker {
        position: relative;

        width: 35px;
        height: 35px;

        display: grid;

        place-items: center;

        border:
          1px solid
          var(--ink);

        border-radius: 50%;
      }

      .method-card__marker span {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: var(--lime);
      }

      .method-card__body {
        padding:
          42px
          30px
          30px
          0;
      }

      .method-card__body small {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.08em;
      }

      .method-card__body h3 {
        margin: 15px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: 32px;

        line-height: 1;

        letter-spacing: -0.05em;

        font-weight: 600;
      }

      .method-card__body p {
        max-width: 270px;

        margin: 13px 0 0;

        color: var(--ink-soft);

        font-size: 12px;

        line-height: 1.8;
      }


      /* =====================================================
         COVERAGE
      ====================================================== */

      .coverage {
        padding: 120px 0;

        background: var(--bg);
      }

      .coverage__head {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          340px;

        gap: 80px;

        align-items: end;

        margin-bottom: 55px;
      }

      .coverage__head h2 {
        max-width: 680px;

        margin: 18px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          48px,
          5.5vw,
          77px
        );

        line-height: 0.94;

        letter-spacing: -0.07em;

        font-weight: 600;
      }

      .coverage__head h2 span {
        color: var(--blue);
      }

      .coverage__head > p {
        margin: 0;

        color: var(--ink-soft);

        font-size: 13px;

        line-height: 1.8;
      }

      .coverage__body {
        display: grid;

        grid-template-columns:
          1.05fr
          0.95fr;

        gap: 12px;
      }

      .coverage__map {
        position: relative;

        min-height: 470px;

        overflow: hidden;

        background: var(--dark);

        color: white;
      }

      .coverage__map-grid {
        position: absolute;

        inset: 0;

        opacity: 0.25;

        background-image:
          linear-gradient(
            rgba(255,255,255,0.06) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255,255,255,0.06) 1px,
            transparent 1px
          );

        background-size: 35px 35px;
      }

      .coverage__outline {
        position: absolute;

        border:
          1px solid
          rgba(214,244,95,0.28);

        background:
          rgba(214,244,95,0.03);

        transform: rotate(-17deg);
      }

      .coverage__outline--one {
        width: 290px;
        height: 330px;

        left: 90px;
        top: 66px;

        border-radius:
          56% 44% 58% 42%;
      }

      .coverage__outline--two {
        width: 190px;
        height: 220px;

        right: 85px;
        top: 105px;

        border-radius:
          40% 60% 45% 55%;

        transform:
          rotate(18deg);
      }

      .coverage__outline--three {
        width: 150px;
        height: 170px;

        left: 245px;
        bottom: 36px;

        border-radius:
          60% 40% 53% 47%;

        transform:
          rotate(31deg);
      }

      .coverage__label {
        position: absolute;

        z-index: 3;

        display: flex;

        align-items: center;

        gap: 8px;

        color:
          rgba(255,255,255,0.6);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.08em;
      }

      .coverage__label span {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: var(--lime);
      }

      .coverage__label--badung {
        top: 26%;
        left: 31%;
      }

      .coverage__label--mengwi {
        right: 23%;
        top: 48%;
      }

      .coverage__label--abiansemal {
        left: 46%;
        bottom: 19%;
      }

      .coverage__center {
        position: absolute;

        left: 50%;
        top: 50%;

        transform:
          translate(-50%, -50%);

        display: flex;

        align-items: center;

        flex-direction: column;

        text-align: center;
      }

      .coverage__center small {
        color:
          rgba(255,255,255,0.38);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.1em;
      }

      .coverage__center strong {
        margin-top: 8px;

        font-family: "Space Grotesk", sans-serif;

        font-size: 38px;

        line-height: 0.95;

        letter-spacing: -0.06em;
      }

      .coverage__center span {
        margin-top: 8px;

        color: var(--lime);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.07em;
      }

      .coverage__list {
        border-top:
          1px solid
          var(--ink);

        border-bottom:
          1px solid
          var(--line);

        background: var(--surface);
      }

      .coverage-row {
        min-height: 156px;

        padding-inline: 20px;

        display: grid;

        grid-template-columns:
          48px
          minmax(0, 1fr)
          100px
          22px;

        gap: 16px;

        align-items: center;

        border-bottom:
          1px solid
          var(--line);

        transition:
          background 160ms ease;
      }

      .coverage-row:last-child {
        border-bottom: 0;
      }

      .coverage-row:hover {
        background: var(--bg);
      }

      .coverage-row__number {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .coverage-row__name small {
        display: block;

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.08em;
      }

      .coverage-row__name strong {
        display: block;

        margin-top: 10px;

        font-family: "Space Grotesk", sans-serif;

        font-size: 23px;

        line-height: 1;

        letter-spacing: -0.04em;

        font-weight: 600;
      }

      .coverage-row__status {
        display: flex;

        align-items: center;

        gap: 7px;

        color: var(--dark);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.07em;
      }

      .coverage-row__status span {
        width: 6px;
        height: 6px;

        display: block;

        border-radius: 50%;

        background: var(--lime);

        border:
          1px solid
          rgba(0,0,0,0.12);
      }

      .coverage-row svg {
        justify-self: end;

        color: var(--blue);
      }


      /* =====================================================
         MATERIAL
      ====================================================== */

      .material {
        padding: 120px 0;

        background: var(--bg-soft);

        border-top:
          1px solid
          var(--line);
      }

      .material__head {
        margin-bottom: 57px;

        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          350px;

        gap: 80px;

        align-items: end;
      }

      .material__head h2 {
        max-width: 680px;

        margin: 18px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          49px,
          5.5vw,
          76px
        );

        line-height: 0.94;

        letter-spacing: -0.07em;

        font-weight: 600;
      }

      .material__head h2 span {
        display: block;

        color: var(--blue);
      }

      .material__head > div:last-child > p {
        margin: 0;

        color: var(--ink-soft);

        font-size: 13px;

        line-height: 1.8;
      }

      .inline-link {
        margin-top: 22px;

        display: inline-flex;

        align-items: center;

        gap: 8px;

        font-size: 10px;

        font-weight: 700;
      }

      .inline-link:hover {
        text-decoration: underline;

        text-underline-offset: 4px;
      }

      .material__list {
        border-top:
          1px solid
          var(--ink);
      }

      .material-row {
        min-height: 103px;

        display: grid;

        grid-template-columns:
          55px
          70px
          minmax(0, 1fr)
          22px;

        gap: 18px;

        align-items: center;

        border-bottom:
          1px solid
          rgba(19,23,25,0.15);

        transition:
          background 160ms ease,
          padding 160ms ease;
      }

      .material-row:hover {
        padding-inline: 12px;

        background: var(--surface);
      }

      .material-row__number {
        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .material-row__code {
        color: var(--blue);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.08em;
      }

      .material-row__name strong {
        font-family: "Space Grotesk", sans-serif;

        font-size: 21px;

        line-height: 1;

        letter-spacing: -0.035em;

        font-weight: 600;
      }

      .material-row__name p {
        margin: 7px 0 0;

        color: var(--muted);

        font-size: 10px;
      }

      .material-row svg {
        justify-self: end;

        color: var(--blue);
      }


      /* =====================================================
         ABOUT
      ====================================================== */

      .about {
        padding: 120px 0;

        background: var(--surface);
      }

      .about__header {
        margin-bottom: 58px;

        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 40px;
      }

      .about__header h2 {
        max-width: 690px;

        margin: 18px 0 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          49px,
          5.5vw,
          76px
        );

        line-height: 0.94;

        letter-spacing: -0.07em;

        font-weight: 600;
      }

      .about__header h2 span {
        display: block;

        color: var(--blue);
      }

      .about__badge {
        min-height: 40px;

        padding-inline: 12px;

        display: inline-flex;

        align-items: center;

        gap: 8px;

        border:
          1px solid
          var(--line);

        color: var(--muted);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.08em;

        white-space: nowrap;
      }

      .about__badge span {
        width: 6px;
        height: 6px;

        display: block;

        border-radius: 50%;

        background: var(--lime);
      }

      .about__grid {
        display: grid;

        grid-template-columns:
          0.8fr
          1.2fr;

        gap: 12px;
      }

      .about__statement {
        min-height: 420px;

        padding: 24px;

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        background: var(--dark);

        color: white;
      }

      .about__statement-number {
        color:
          rgba(255,255,255,0.34);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .about__statement p {
        max-width: 400px;

        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          27px,
          3vw,
          42px
        );

        line-height: 1.02;

        letter-spacing: -0.04em;

        font-weight: 500;
      }

      .principle-list {
        border-top:
          1px solid
          var(--ink);

        background: var(--surface);
      }

      .principle {
        min-height: 140px;

        padding: 20px;

        display: grid;

        grid-template-columns:
          45px
          minmax(0, 1fr)
          20px;

        gap: 18px;

        align-items: start;

        border-bottom:
          1px solid
          var(--line);
      }

      .principle:last-child {
        border-bottom: 0;
      }

      .principle__number {
        color: var(--blue);

        font-family: "DM Mono", monospace;

        font-size: 8px;
      }

      .principle h3 {
        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: 23px;

        line-height: 1;

        letter-spacing: -0.035em;

        font-weight: 600;
      }

      .principle p {
        max-width: 470px;

        margin: 9px 0 0;

        color: var(--muted);

        font-size: 11px;

        line-height: 1.75;
      }

      .principle > svg {
        justify-self: end;

        color: var(--blue);
      }


      /* =====================================================
         FINAL
      ====================================================== */

      .final {
        background: var(--lime);
      }

      .final__inner {
        min-height: 465px;

        padding:
          30px
          0
          45px;

        display: flex;

        flex-direction: column;

        justify-content: space-between;
      }

      .final__top {
        display: flex;

        align-items: center;
        justify-content: space-between;

        color:
          rgba(19,23,25,0.48);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.09em;
      }

      .final__main {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 50px;
      }

      .final__main p {
        margin: 0 0 18px;

        color:
          rgba(19,23,25,0.52);

        font-family: "DM Mono", monospace;

        font-size: 7px;

        letter-spacing: 0.08em;
      }

      .final__main h2 {
        max-width: 900px;

        margin: 0;

        font-family: "Space Grotesk", sans-serif;

        font-size: clamp(
          58px,
          7vw,
          98px
        );

        line-height: 0.87;

        letter-spacing: -0.08em;

        font-weight: 600;
      }

      .final__main h2 span {
        color: var(--blue);
      }

      .final__button {
        min-height: 54px;

        padding-inline: 18px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 10px;

        flex-shrink: 0;

        background: var(--ink);

        color: white;

        font-size: 10px;

        font-weight: 700;

        transition:
          background 160ms ease,
          transform 160ms ease;
      }

      .final__button:hover {
        background: var(--dark);

        transform: translateY(-2px);
      }


      /* =====================================================
         FOOTER
      ====================================================== */

      .footer {
        background: var(--ink);

        color: white;
      }

      .footer__grid {
        padding:
          72px
          0
          68px;

        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          170px
          190px;

        gap: 70px;
      }

      .brand--footer .brand__text {
        color: white;
      }

      .brand--footer .brand__mark i:nth-child(1),
      .brand--footer .brand__mark i:nth-child(4) {
        background: white;
      }

      .footer__identity p {
        max-width: 330px;

        margin: 21px 0 0;

        color:
          rgba(255,255,255,0.42);

        font-size: 11px;

        line-height: 1.8;
      }

      .footer__column {
        display: flex;

        flex-direction: column;

        align-items: flex-start;
      }

      .footer__column > span {
        margin-bottom: 17px;

        color:
          rgba(255,255,255,0.27);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.09em;
      }

      .footer__column a {
        margin-bottom: 11px;

        color:
          rgba(255,255,255,0.63);

        font-size: 10px;

        transition:
          color 160ms ease;
      }

      .footer__column a:hover {
        color: var(--lime);
      }

      .footer__bottom {
        min-height: 63px;

        display: grid;

        grid-template-columns:
          1fr
          1fr
          1fr;

        align-items: center;

        border-top:
          1px solid
          rgba(255,255,255,0.1);

        color:
          rgba(255,255,255,0.28);

        font-family: "DM Mono", monospace;

        font-size: 6px;

        letter-spacing: 0.06em;
      }

      .footer__bottom span:nth-child(2) {
        text-align: center;
      }

      .footer__bottom span:last-child {
        text-align: right;
      }


      /* =====================================================
         FLOATING REPORT
      ====================================================== */

      .floating-report {
        position: fixed;

        right: 21px;
        bottom: 20px;

        z-index: 400;

        min-height: 58px;

        padding:
          7px
          10px
          7px
          7px;

        display: inline-flex;

        align-items: center;

        gap: 9px;

        background: var(--lime);

        color: var(--ink);

        box-shadow:
          0 15px 30px
          rgba(0,0,0,0.14);

        transition:
          transform 160ms ease,
          box-shadow 160ms ease;
      }

      .floating-report:hover {
        transform: translateY(-3px);

        box-shadow:
          0 19px 35px
          rgba(0,0,0,0.17);
      }

      .floating-report__icon {
        width: 37px;
        height: 37px;

        display: grid;

        place-items: center;

        background: var(--ink);

        color: var(--lime);
      }

      .floating-report__text {
        display: grid;

        gap: 3px;
      }

      .floating-report__text small {
        color:
          rgba(19,23,25,0.52);

        font-family: "DM Mono", monospace;

        font-size: 5px;

        letter-spacing: 0.07em;
      }

      .floating-report__text strong {
        font-size: 10px;

        font-weight: 800;
      }


      /* =====================================================
         1100
      ====================================================== */

      @media (max-width: 1100px) {

        .desktop-nav {
          gap: 18px;
        }

        .hero__grid {
          grid-template-columns:
            minmax(0, 1fr)
