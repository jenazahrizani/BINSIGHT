function getOrganizationTypeLabel(type: string): string {
  switch (type) {
    case "government":
      return "Pemerintah";
    case "community":
      return "Komunitas";
    case "private":
      return "Swasta";
    case "social-enterprise":
      return "Social Enterprise";
    case "cooperative":
      return "Koperasi";
    case "educational":
      return "Pendidikan";
    case "nonprofit":
      return "Nirlaba";
    default:
      return "Lainnya";
  }
}
