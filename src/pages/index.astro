---
/**
 * ============================================================================
 * BINSIGHT — HOME PAGE
 * ============================================================================
 * Badung Waste Intelligence
 *
 * Production-ready public homepage
 *
 * Principles:
 * - Editorial environmental intelligence aesthetic
 * - Strong typography
 * - Dark / lime visual system
 * - Responsive from desktop to small mobile
 * - Accessible interactive elements
 * - No fabricated statistics
 * - No direct Firebase fetching
 * - Existing local organization data
 * - Existing waste categories
 * - Existing reusable cards
 * ============================================================================
 */

import {
  ArrowRight,
  ChartColumn,
  ChevronUp,
  FileText,
  Layers,
  Map,
  Recycle,
  Search,
  ShieldCheck,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import OrganizationCard from "@components/organization/OrganizationCard.astro";
import WasteCard from "@components/waste/WasteCard.astro";

import {
  getFeaturedOrganizations,
  getPublicOrganizations,
} from "@lib/data/organizations";

import { WASTE_CATEGORY } from "@lib/constants/waste";

/* ==========================================================================
   LOCAL DATA
   ========================================================================== */

const allOrganizations = getPublicOrganizations();
const featuredOrganizations = getFeaturedOrganizations();

const totalOrganizations = allOrganizations.length;

const wasteCategories = [
  {
    name: "Organik",
    slug: WASTE_CATEGORY.ORGANIC,
    description:
      "Material yang berasal dari sumber organik dan memiliki karakteristik yang dapat dikelola secara biologis.",
  },
  {
    name: "Anorganik",
    slug: WASTE_CATEGORY.INORGANIC,
    description:
      "Material non-organik yang dapat dipilah untuk mendukung pemanfaatan dan pengelolaan material.",
  },
  {
    name: "Bahan Berbahaya",
    slug: WASTE_CATEGORY.HAZARDOUS,
    description:
      "Material yang memerlukan perhatian dan penanganan khusus berdasarkan karakteristiknya.",
  },
  {
    name: "Elektronik",
    slug: WASTE_CATEGORY.ELECTRONIC,
    description:
      "Peralatan atau material elektronik yang memerlukan pengelolaan sesuai karakteristiknya.",
  },
  {
    name: "Residu",
    slug: WASTE_CATEGORY.RESIDUAL,
    description:
      "Material sisa yang tidak termasuk dalam alur pemanfaatan utama dan memerlukan pengelolaan lanjutan.",
  },
];

const navigationCards = [
  {
    index: "01",
    kicker: "EXPLORE",
    title: "Jelajahi Peta",
    description:
      "Temukan lokasi, organisasi, dan informasi persampahan dalam konteks wilayah Kabupaten Badung.",
    href: "/map",
    icon: "map",
  },
  {
    index: "02",
    kicker: "INTELLIGENCE",
    title: "Lihat Data",
    description:
      "Pahami ekosistem persampahan melalui informasi dan entitas yang tercatat di BINSIGHT.",
    href: "/dashboard",
    icon: "data",
  },
  {
    index: "03",
    kicker: "NETWORK",
    title: "Kenali Pengelola",
    description:
      "Temukan organisasi yang bergerak dalam pengelolaan dan edukasi persampahan.",
    href: "/organizations",
    icon: "network",
  },
  {
    index: "04",
    kicker: "CIVIC INPUT",
    title: "Buat Laporan",
    description:
      "Sampaikan kondisi persampahan atau lingkungan yang perlu diperhatikan.",
    href: "/reports/create",
    icon: "report",
  },
];

const pillars = [
  {
    number: "01",
    eyebrow: "LOCATIONAL INTELLIGENCE",
    title: "Peta",
    description:
      "Lihat ekosistem persampahan berdasarkan wilayah, lokasi, organisasi, dan hubungan antar-entitas.",
    href: "/map",
    icon: "map",
  },
  {
    number: "02",
    eyebrow: "PUBLIC DATA",
    title: "Data",
    description:
      "Pahami entitas dan informasi yang tercatat tanpa menambahkan klaim volume yang tidak tervalidasi.",
    href: "/dashboard",
    icon: "data",
  },
  {
    number: "03",
    eyebrow: "MATERIAL KNOWLEDGE",
    title: "Edukasi",
    description:
      "Kenali kategori, karakteristik, dan proses pengelolaan material secara kontekstual.",
    href: "/waste",
    icon: "waste",
  },
  {
    number: "04",
    eyebrow: "CIVIC REPORTING",
    title: "Laporan",
    description:
      "Sampaikan kondisi persampahan dan lingkungan yang perlu diperhatikan untuk ditinjau.",
    href: "/reports/create",
    icon: "report",
  },
];
---

<PublicLayout
  title="BINSIGHT — Badung Waste Intelligence"
  description="Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
>
  <main class="home">

    <!-- ================================================================== -->
    <!-- HERO                                                               -->
    <!-- ================================================================== -->

    <section class="hero" aria-labelledby="hero-title">

      <div class="hero__grid" aria-hidden="true"></div>

      <div class="hero__glow hero__glow--one" aria-hidden="true"></div>
      <div class="hero__glow hero__glow--two" aria-hidden="true"></div>

      <div class="home-container hero__inner">

        <!-- HERO COPY -->

        <div class="hero__left">

          <div class="eyebrow">
            <span class="eyebrow__dot" aria-hidden="true"></span>

            <span>BADUNG WASTE INTELLIGENCE</span>

            <span class="eyebrow__line" aria-hidden="true"></span>

            <span>PUBLIC DATA PLATFORM</span>
          </div>

          <h1 id="hero-title" class="hero__title">
            <span>Kenali.</span>
            <span class="hero__title--outline">Pahami.</span>
            <span class="hero__title--lime">Jaga Badung.</span>
          </h1>

          <div class="hero__accent" aria-hidden="true"></div>

          <p class="hero__description">
            BINSIGHT menghubungkan
            <strong>peta, data, organisasi, edukasi, dan laporan masyarakat</strong>
            dalam satu ekosistem informasi persampahan Kabupaten Badung.
          </p>

          <div class="hero__actions">
            <a
              href="/map"
              class="button button--lime"
              aria-label="Jelajahi peta BINSIGHT"
            >
              <Map
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>Jelajahi peta</span>

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>

            <a
              href="/dashboard"
              class="button button--ghost"
              aria-label="Lihat data BINSIGHT"
            >
              <ChartColumn
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>Lihat data</span>
            </a>
          </div>

          <!-- HERO METRICS -->

          <div class="hero__metrics" aria-label="Ringkasan BINSIGHT">

            <div class="metric">
              <strong>{totalOrganizations}</strong>

              <span>
                ORGANISASI<br />
                TERCATAT
              </span>
            </div>

            <div class="metric__separator" aria-hidden="true"></div>

            <div class="metric">
              <strong>{wasteCategories.length}</strong>

              <span>
                KATEGORI<br />
                MATERIAL
              </span>
            </div>

            <div class="metric__separator" aria-hidden="true"></div>

            <div class="metric">
              <strong>01</strong>

              <span>
                EKOSISTEM<br />
                PUBLIK
              </span>
            </div>

          </div>

        </div>

        <!-- HERO MAP -->

        <div class="hero__right">

          <div class="map-window">

            <div class="map-window__top">

              <div class="map-window__title">
                <span class="live-dot" aria-hidden="true"></span>
                <span>BINSIGHT MAP</span>
              </div>

              <span>BADUNG / BALI</span>
            </div>

            <div
              class="map-window__body"
              role="img"
              aria-label="Visualisasi abstrak wilayah Badung dengan titik lokasi BINSIGHT"
            >
              <div class="map-lines"></div>

              <div class="map-shape map-shape--a"></div>
              <div class="map-shape map-shape--b"></div>
              <div class="map-shape map-shape--c"></div>

              <div class="map-road map-road--a"></div>
              <div class="map-road map-road--b"></div>
              <div class="map-road map-road--c"></div>
              <div class="map-road map-road--d"></div>

              <div class="map-node map-node--1">
                <span></span>
              </div>

              <div class="map-node map-node--2">
                <span></span>
              </div>

              <div class="map-node map-node--3">
                <span></span>
              </div>

              <div class="map-node map-node--4">
                <span></span>
              </div>

              <div class="map-node map-node--5">
                <span></span>
              </div>

              <span class="map-place map-place--1">KUTA</span>
              <span class="map-place map-place--2">MENGWI</span>
              <span class="map-place map-place--3">ABIANSEMAL</span>

              <div class="map-compass">
                <ChevronUp
                  size={14}
                  stroke-width={2}
                  aria-hidden="true"
                />
                <span>N</span>
              </div>

              <div class="map-coordinates">
                BADUNG<br />
                -8.5069 / 115.2625
              </div>
            </div>

            <div class="map-window__bottom">

              <div class="map-window__stat">
                <span>ORGANIZATIONS</span>
                <strong>{totalOrganizations}</strong>
              </div>

              <div class="map-index">
                <Layers
                  size={15}
                  stroke-width={1.8}
                  aria-hidden="true"
                />

                <span>INDEX</span>
              </div>

            </div>

          </div>

          <div
            class="floating-label floating-label--top"
            aria-hidden="true"
          >
            <span></span>
            DATA CONNECTED
          </div>

          <div
            class="floating-label floating-label--bottom"
            aria-hidden="true"
          >
            <small>BADUNG</small>
            <strong>01</strong>
          </div>

        </div>

      </div>

      <!-- HERO FOOTER -->

      <div class="hero__footer">
        <div class="home-container hero__footer-inner">

          <span>PUBLIC ENVIRONMENTAL INTELLIGENCE</span>

          <div aria-label="Alur BINSIGHT">
            <span>DISCOVER</span>
            <b>→</b>
            <span>UNDERSTAND</span>
            <b>→</b>
            <span>REPORT</span>
          </div>

          <span>BINSIGHT / 01</span>

        </div>
      </div>

    </section>

    <!-- ================================================================== -->
    <!-- DISCOVERY                                                           -->
    <!-- ================================================================== -->

    <section
      class="section section--paper"
      aria-labelledby="discovery-title"
    >
      <div class="home-container">

        <div class="section-head">

          <div>
            <span class="section-kicker">01 / START HERE</span>

            <h2 id="discovery-title">
              Satu sistem.
              <br />
              Banyak cara melihat Badung.
            </h2>
          </div>

          <div class="section-side">

            <div
              class="section-side__line"
              aria-hidden="true"
            ></div>

            <p>
              BINSIGHT menyatukan konteks lokasi, entitas, material,
              organisasi, dan laporan menjadi satu pengalaman informasi publik.
            </p>

          </div>

        </div>

        <div class="discovery-grid">

          {
            navigationCards.map((card) => (
              <a
                href={card.href}
                class="discovery-card"
                aria-label={`${card.title} — ${card.description}`}
              >

                <div class="discovery-card__top">
                  <span>{card.index}</span>
                  <span>{card.kicker}</span>
                </div>

                <div class="discovery-card__middle">
                  {card.icon === "map" && (
                    <Map
                      size={25}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />
                  )}

                  {card.icon === "data" && (
                    <ChartColumn
                      size={25}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />
                  )}

                  {card.icon === "network" && (
                    <ShieldCheck
                      size={25}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />
                  )}

                  {card.icon === "report" && (
                    <FileText
                      size={25}
                      stroke-width={1.8}
                      aria-hidden="true"
                    />
                  )}
                </div>

                <div class="discovery-card__content">
                  <h3>{card.title}</h3>

                  <p>{card.description}</p>
                </div>

                <div class="discovery-card__bottom">
                  <span>OPEN MODULE</span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

              </a>
            ))
          }

        </div>

      </div>
    </section>

    <!-- ================================================================== -->
    <!-- SYSTEM BAR                                                          -->
    <!-- ================================================================== -->

    <section class="system-bar" aria-label="BINSIGHT system">
      <div class="home-container system-bar__inner">

        <div class="system-bar__brand">
          <span aria-hidden="true"></span>
          BINSIGHT SYSTEM
        </div>

        <div class="system-bar__formula">
          <span>MAP</span>
          <b>+</b>
          <span>DATA</span>
          <b>+</b>
          <span>NETWORK</span>
          <b>+</b>
          <span>EDUCATION</span>
          <b>+</b>
          <span>REPORT</span>
          <b>=</b>
          <strong>CONTEXT</strong>
        </div>

      </div>
    </section>

    <!-- ================================================================== -->
    <!-- ECOSYSTEM                                                           -->
    <!-- ================================================================== -->

    <section
      class="section section--black"
      aria-labelledby="ecosystem-title"
    >
      <div class="home-container">

        <div class="section-head section-head--dark">

          <div>
            <span class="section-kicker section-kicker--lime">
              02 / THE ECOSYSTEM
            </span>

            <h2 id="ecosystem-title">
              Informasi terhubung.
              <br />
              Konteks menjadi kekuatan.
            </h2>
          </div>

          <div class="section-side">

            <div
              class="section-side__line section-side__line--lime"
              aria-hidden="true"
            ></div>

            <p>
              Empat pilar BINSIGHT bekerja sebagai satu jaringan informasi
              yang saling melengkapi.
            </p>

          </div>

        </div>

        <div class="pillar-grid">

          {
            pillars.map((pillar) => (
              <a
                href={pillar.href}
                class="pillar-card"
                aria-label={`${pillar.title} — ${pillar.description}`}
              >

                <div class="pillar-card__number">
                  {pillar.number}
                </div>

                <div class="pillar-card__icon">
                  {pillar.icon === "map" && (
                    <Map
                      size={25}
                      stroke-width={1.7}
                      aria-hidden="true"
                    />
                  )}

                  {pillar.icon === "data" && (
                    <ChartColumn
                      size={25}
                      stroke-width={1.7}
                      aria-hidden="true"
                    />
                  )}

                  {pillar.icon === "waste" && (
                    <Recycle
                      size={25}
                      stroke-width={1.7}
                      aria-hidden="true"
                    />
                  )}

                  {pillar.icon === "report" && (
                    <FileText
                      size={25}
                      stroke-width={1.7}
                      aria-hidden="true"
                    />
                  )}
                </div>

                <div class="pillar-card__body">

                  <span>{pillar.eyebrow}</span>

                  <h3>{pillar.title}</h3>

                  <p>{pillar.description}</p>

                </div>

                <div class="pillar-card__arrow">
                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

              </a>
            ))
          }

        </div>

      </div>
    </section>

    <!-- ================================================================== -->
    <!-- ORGANIZATIONS                                                       -->
    <!-- ================================================================== -->

    <section
      class="section section--paper"
      aria-labelledby="network-title"
    >
      <div class="home-container">

        <div class="section-head">

          <div>
            <span class="section-kicker">03 / NETWORK</span>

            <h2 id="network-title">
              Siapa yang bergerak
              <br />
              di dalam ekosistem?
            </h2>
          </div>

          <div class="section-side">

            <div
              class="section-side__line"
              aria-hidden="true"
            ></div>

            <p>
              Organisasi publik yang telah tercatat dan ditampilkan
              dalam ekosistem BINSIGHT.
            </p>

            <a
              href="/organizations"
              class="section-link"
            >
              <span>Lihat semua</span>

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>

          </div>

        </div>

        {
          featuredOrganizations.length > 0 ? (
            <div class="organization-grid">
              {featuredOrganizations.slice(0, 3).map((organization) => (
                <OrganizationCard
                  organization={organization}
                  featured={organization.isFeatured}
                />
              ))}
            </div>
          ) : (
            <div class="empty-state">

              <div class="empty-state__icon">
                <ShieldCheck
                  size={24}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <div>
                <h3>Belum ada organisasi unggulan</h3>

                <p>
                  Organisasi publik yang telah diverifikasi
                  akan ditampilkan di sini.
                </p>
              </div>

            </div>
          )
        }

      </div>
    </section>

    <!-- ================================================================== -->
    <!-- MATERIAL                                                            -->
    <!-- ================================================================== -->

    <section
      class="section section--sand"
      aria-labelledby="material-title"
    >
      <div class="home-container">

        <div class="section-head">

          <div>
            <span class="section-kicker">04 / MATERIAL</span>

            <h2 id="material-title">
              Kenali materialnya.
            </h2>
          </div>

          <div class="section-side">

            <div
              class="section-side__line"
              aria-hidden="true"
            ></div>

            <p>
              Setiap material memiliki karakteristik dan kebutuhan
              pengelolaan yang berbeda.
            </p>

            <a
              href="/waste"
              class="section-link"
            >
              <span>Jelajahi semua</span>

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>

          </div>

        </div>

        <div class="waste-grid">

          {
            wasteCategories.map((category, index) => (
              <div class="waste-item">

                <div class="waste-item__index">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div
                  class="waste-item__accent"
                  aria-hidden="true"
                ></div>

                <WasteCard
                  waste={{
                    id: category.slug,
                    slug: category.slug,
                    name: category.name,
                    description: category.description,
                    category: category.name,
                    characteristics: [],
                  }}
                  href={`/waste?category=${encodeURIComponent(category.slug)}`}
                  compact
                  showCharacteristics={false}
                />

              </div>
            ))
          }

        </div>

      </div>
    </section>

    <!-- ================================================================== -->
    <!-- MAP CTA                                                             -->
    <!-- ================================================================== -->

    <section
      class="map-cta"
      aria-labelledby="map-cta-title"
    >

      <div class="home-container map-cta__inner">

        <div class="map-cta__content">

          <span class="section-kicker section-kicker--lime">
            05 / START WITH LOCATION
          </span>

          <h2 id="map-cta-title">
            Badung
            <br />
            ada di peta.
          </h2>

          <p>
            Gunakan peta sebagai pintu masuk untuk menemukan lokasi,
            area, organisasi, dan informasi persampahan yang
            saling berkaitan.
          </p>

          <div class="map-cta__actions">

            <a
              href="/map"
              class="button button--lime"
            >
              <Map
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>Buka peta</span>

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>

            <a
              href="/map"
              class="button button--ghost"
            >
              <Search
                size={15}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>Cari lokasi</span>
            </a>

          </div>

        </div>

        <div
          class="map-cta__visual"
          aria-hidden="true"
        >

          <div class="map-cta__grid"></div>

          <div class="map-cta__orbit map-cta__orbit--1"></div>
          <div class="map-cta__orbit map-cta__orbit--2"></div>
          <div class="map-cta__orbit map-cta__orbit--3"></div>

          <div class="map-cta__route map-cta__route--1"></div>
          <div class="map-cta__route map-cta__route--2"></div>
          <div class="map-cta__route map-cta__route--3"></div>

          <div class="map-cta__marker map-cta__marker--1">
            <Map size={14} stroke-width={2} />
          </div>

          <div class="map-cta__marker map-cta__marker--2">
            <Recycle size={14} stroke-width={2} />
          </div>

          <div class="map-cta__marker map-cta__marker--3">
            <FileText size={14} stroke-width={2} />
          </div>

          <div class="map-cta__coordinates">
            08°32'S
            <br />
            115°10'E
          </div>

        </div>

      </div>

    </section>

    <!-- ================================================================== -->
    <!-- REPORT                                                              -->
    <!-- ================================================================== -->

    <section
      class="report-section"
      aria-labelledby="report-title"
    >

      <div class="home-container">

        <div class="report-box">

          <div class="report-box__content">

            <div class="report-box__icon">
              <FileText
                size={25}
                stroke-width={1.8}
                aria-hidden="true"
              />
            </div>

            <div>

              <span class="section-kicker">
                06 / CIVIC INPUT
              </span>

              <h2 id="report-title">
                Melihat masalah?
                <br />
                Masukkan ke sistem.
              </h2>

              <p>
                Laporkan kondisi persampahan atau lingkungan yang
                perlu diperhatikan agar dapat ditinjau dan dicatat
                dalam ekosistem informasi.
              </p>

            </div>

          </div>

          <a
            href="/reports/create"
            class="report-box__button"
          >
            <span>Buat laporan</span>

            <ArrowRight
              size={19}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>

        </div>

      </div>

    </section>

  </main>
</PublicLayout>

<style>
  /* ==========================================================================
     BINSIGHT // BRUTALIST SYSTEM
     Hard edges. Loud hierarchy. Zero decoration for decoration's sake.
     ========================================================================== */

  .home {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --line: #090a08;
    --warning: #ff6a00;

    width: 100%;
    min-width: 0;
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .home *,
  .home *::before,
  .home *::after {
    box-sizing: border-box;
  }

  .home a {
    -webkit-tap-highlight-color: transparent;
  }

  .home-container {
    width: min(1320px, calc(100% - 40px));
    margin: 0 auto;
  }

  /* ==========================================================================
     GLOBAL BRUTALIST TEXTURE
     ========================================================================== */

  .hero,
  .section--black,
  .map-cta {
    isolation: isolate;
  }

  .hero::before,
  .section--black::before,
  .map-cta::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: "";
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.045) 1px,
        transparent 1px
      );
    background-size: 24px 24px;
    opacity: 0.32;
  }

  .section--paper {
    position: relative;
    background:
      repeating-linear-gradient(
        135deg,
        rgba(9, 10, 8, 0.025) 0 1px,
        transparent 1px 9px
      ),
      var(--paper);
  }

  .section--sand {
    position: relative;
    background:
      repeating-linear-gradient(
        0deg,
        rgba(9, 10, 8, 0.03) 0 1px,
        transparent 1px 7px
      ),
      var(--paper-2);
  }

  .section--black {
    position: relative;
    background: var(--ink);
    color: var(--white);
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .hero {
    position: relative;
    min-height: 860px;
    overflow: hidden;
    color: var(--white);
    background: var(--ink);
    border-bottom: 10px solid var(--acid);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    pointer-events: none;
    background:
      linear-gradient(
        rgba(255, 255, 255, 0.09) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.09) 2px,
        transparent 2px
      );
    background-size: 72px 72px;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 6%,
      black 94%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 6%,
      black 94%,
      transparent
    );
  }

  .hero__glow {
    position: absolute;
    pointer-events: none;
    border-radius: 0;
    filter: none;
  }

  .hero__glow--one {
    width: 420px;
    height: 420px;
    top: -120px;
    right: -70px;
    background: var(--acid);
    opacity: 0.92;
    clip-path: polygon(0 12%, 84% 0, 100% 76%, 30% 100%);
    mix-blend-mode: screen;
  }

  .hero__glow--two {
    width: 360px;
    height: 260px;
    bottom: -160px;
    left: 12%;
    background: var(--warning);
    opacity: 0.5;
    transform: rotate(-7deg);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(440px, 0.9fr);
    align-items: center;
    gap: 48px;
    min-height: 805px;
    padding: 60px 0 84px;
  }

  .hero__left {
    min-width: 0;
  }

  /* ==========================================================================
     EYEBROW
     ========================================================================== */

  .eyebrow {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 10px;
    color: var(--ink);
    background: var(--acid);
    border: 3px solid var(--ink);
    box-shadow: 8px 8px 0 var(--white);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow__dot {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--warning);
    box-shadow: none;
  }

  .eyebrow__line {
    width: 26px;
    height: 2px;
    background: var(--ink);
  }

  /* ==========================================================================
     HERO TITLE
     ========================================================================== */

  .hero__title {
    display: flex;
    flex-direction: column;
    margin: 42px 0 0;
    color: var(--white);
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(86px, 10.8vw, 168px);
    font-weight: 900;
    line-height: 0.76;
    letter-spacing: -0.095em;
    text-transform: uppercase;
  }

  .hero__title span {
    display: block;
    width: max-content;
    max-width: 100%;
  }

  .hero__title--outline {
    color: transparent;
    -webkit-text-stroke: 3px var(--white);
    text-stroke: 3px var(--white);
    transform: translateX(4vw);
  }

  .hero__title--lime {
    color: var(--acid);
    transform: translateX(-1vw);
  }

  .hero__accent {
    width: 160px;
    height: 15px;
    margin-top: 38px;
    background: var(--acid);
    border: 3px solid var(--white);
    box-shadow: 12px 12px 0 var(--warning);
  }

  .hero__description {
    max-width: 650px;
    margin: 34px 0 0;
    padding-left: 18px;
    color: #deded5;
    border-left: 8px solid var(--acid);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.7;
  }

  .hero__description strong {
    color: var(--acid);
    font-weight: 900;
  }

  /* ==========================================================================
     BUTTONS
     ========================================================================== */

  .hero__actions,
  .map-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .button {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 18px;
    border: 3px solid currentColor;
    border-radius: 0;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.035em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .button:hover {
    transform: translate(-4px, -4px);
  }

  .button:focus-visible {
    outline: 4px solid var(--acid);
    outline-offset: 4px;
  }

  .button--lime {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--ink);
    box-shadow: 8px 8px 0 var(--white);
  }

  .button--lime:hover {
    background: var(--acid-soft);
    box-shadow: 12px 12px 0 var(--warning);
  }

  .button--ghost {
    color: var(--white);
    background: transparent;
    border-color: var(--white);
    box-shadow: 8px 8px 0 rgba(255, 255, 255, 0.18);
  }

  .button--ghost:hover {
    color: var(--ink);
    background: var(--white);
    border-color: var(--white);
    box-shadow: 12px 12px 0 var(--acid);
  }

  /* ==========================================================================
     HERO METRICS
     ========================================================================== */

  .hero__metrics {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-top: 58px;
    border: 3px solid var(--white);
    background: var(--ink-2);
  }

  .metric {
    min-width: 150px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    justify-content: center;
    padding: 16px 20px;
  }

  .metric strong {
    color: var(--acid);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 38px;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .metric span {
    color: var(--white);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.08em;
  }

  .metric__separator {
    width: 3px;
    flex: 0 0 3px;
    background: var(--white);
  }

  /* ==========================================================================
     HERO MAP
     ========================================================================== */

  .hero__right {
    position: relative;
    min-width: 0;
    min-height: 580px;
  }

  .map-window {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 4px solid var(--white);
    border-radius: 0;
    background: var(--acid);
    box-shadow: 18px 18px 0 var(--warning);
    transform: rotate(1.3deg);
  }

  .map-window__top {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 0 17px;
    color: var(--ink);
    background: var(--acid);
    border-bottom: 4px solid var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .map-window__title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }

  .live-dot {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--warning);
    box-shadow: none;
  }

  .map-window__body {
    position: relative;
    min-height: 452px;
    overflow: hidden;
    background: #22281d;
  }

  .map-lines {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        rgba(223, 255, 0, 0.11) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(223, 255, 0, 0.11) 2px,
        transparent 2px
      );
    background-size: 30px 30px;
  }

  .map-shape {
    position: absolute;
    border: 3px solid var(--acid);
    border-radius: 0;
    background: rgba(223, 255, 0, 0.03);
    box-shadow: none;
  }

  .map-shape--a {
    left: 8%;
    top: 16%;
    width: 64%;
    height: 35%;
    clip-path: polygon(
      9% 16%,
      30% 0,
      70% 7%,
      96% 31%,
      84% 82%,
      48% 100%,
      16% 89%,
      0 51%
    );
    transform: rotate(7deg);
  }

  .map-shape--b {
    right: -4%;
    bottom: 8%;
    width: 68%;
    height: 43%;
    clip-path: polygon(
      0 30%,
      24% 2%,
      70% 0,
      100% 26%,
      88% 76%,
      57% 100%,
      18% 82%
    );
    transform: rotate(-6deg);
  }

  .map-shape--c {
    right: 9%;
    top: 8%;
    width: 22%;
    height: 22%;
    border: 0;
    background: var(--warning);
    clip-path: polygon(50% 0, 100% 28%, 84% 100%, 9% 76%, 0 34%);
  }

  .map-road {
    position: absolute;
    height: 3px;
    background: var(--acid);
    transform-origin: left center;
  }

  .map-road--a {
    left: -4%;
    top: 55%;
    width: 110%;
    transform: rotate(-12deg);
  }

  .map-road--b {
    left: -2%;
    top: 73%;
    width: 104%;
    transform: rotate(16deg);
  }

  .map-road--c {
    left: 14%;
    top: 31%;
    width: 84%;
    transform: rotate(61deg);
  }

  .map-road--d {
    left: 18%;
    top: 46%;
    width: 68%;
    transform: rotate(-48deg);
  }

  .map-node {
    position: absolute;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 3px solid var(--ink);
    border-radius: 0;
    background: var(--acid);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .map-node span {
    width: 10px;
    height: 10px;
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--warning);
    box-shadow: none;
  }

  .map-node--1 {
    left: 27%;
    top: 25%;
  }

  .map-node--2 {
    right: 27%;
    top: 35%;
  }

  .map-node--3 {
    right: 17%;
    bottom: 22%;
  }

  .map-node--4 {
    left: 20%;
    bottom: 18%;
  }

  .map-node--5 {
    left: 49%;
    top: 59%;
  }

  .map-place {
    position: absolute;
    color: var(--acid);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.12em;
    background: var(--ink);
    padding: 3px 5px;
  }

  .map-place--1 {
    left: 29%;
    top: 34%;
  }

  .map-place--2 {
    left: 56%;
    bottom: 32%;
  }

  .map-place--3 {
    right: 12%;
    top: 47%;
  }

  .map-compass {
    position: absolute;
    top: 18px;
    right: 18px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--acid);
    background: var(--ink);
    padding: 5px 7px;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
  }

  .map-coordinates {
    position: absolute;
    right: 18px;
    bottom: 18px;
    color: var(--acid);
    background: var(--ink);
    padding: 6px 8px;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    line-height: 1.55;
    text-align: right;
  }

  .map-window__bottom {
    min-height: 66px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 17px;
    color: var(--white);
    background: var(--ink);
    border-top: 4px solid var(--ink);
  }

  .map-window__stat {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }

  .map-window__bottom span {
    color: var(--white);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .map-window__bottom strong {
    color: var(--acid);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 26px;
    font-weight: 900;
  }

  .map-index {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--acid);
    white-space: nowrap;
    font-weight: 900;
  }

  .floating-label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    color: var(--ink);
    background: var(--white);
    border: 3px solid var(--ink);
    box-shadow: 7px 7px 0 var(--warning);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .floating-label--top {
    top: -18px;
    right: -15px;
    transform: rotate(2deg);
  }

  .floating-label--top span {
    width: 8px;
    height: 8px;
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--acid);
  }

  .floating-label--bottom {
    left: -18px;
    bottom: 32px;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 11px 13px;
    transform: rotate(-2deg);
  }

  .floating-label--bottom small {
    color: var(--muted);
    font-size: 7px;
  }

  .floating-label--bottom strong {
    color: var(--ink);
    font-family: Sora, Inter, sans-serif;
    font-size: 21px;
    font-weight: 900;
  }

  /* ==========================================================================
     HERO FOOTER
     ========================================================================== */

  .hero__footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    border-top: 4px solid var(--white);
    background: var(--ink);
  }

  .hero__footer-inner {
    min-height: 54px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    color: var(--white);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .hero__footer-inner > :last-child {
    text-align: right;
  }

  .hero__footer-inner > div {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--acid);
  }

  .hero__footer-inner b {
    color: var(--warning);
  }

  /* ==========================================================================
     SECTION FRAME
     ========================================================================== */

  .section {
    padding: 120px 0;
    border-bottom: 4px solid var(--ink);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.42fr);
    align-items: end;
    gap: 70px;
    margin-bottom: 54px;
  }

  .section-head h2 {
    max-width: 900px;
    margin: 0;
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(48px, 6.6vw, 94px);
    font-weight: 900;
    line-height: 0.87;
    letter-spacing: -0.085em;
    text-transform: uppercase;
  }

  .section-head--dark h2 {
    color: var(--white);
  }

  .section-kicker {
    display: inline-block;
    margin-bottom: 18px;
    padding: 6px 8px;
    color: var(--white);
    background: var(--ink);
    border: 2px solid var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .section-kicker--lime {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--acid);
  }

  .section-side {
    padding-bottom: 0;
  }

  .section-side__line {
    width: 100%;
    height: 8px;
    margin-bottom: 18px;
    background: var(--ink);
  }

  .section-side__line--lime {
    background: var(--acid);
  }

  .section-side p {
    max-width: 500px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .section-head--dark .section-side p {
    color: #c3c4ba;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    padding: 8px 10px;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    font-size: 10px;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }

  .section-link:hover {
    gap: 12px;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--warning);
  }

  .section-link:focus-visible {
    outline: 3px solid var(--acid);
    outline-offset: 4px;
  }

  /* ==========================================================================
     DISCOVERY
     ========================================================================== */

  .discovery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .discovery-card {
    position: relative;
    min-height: 350px;
    display: flex;
    flex-direction: column;
    padding: 18px;
    color: var(--ink);
    background: var(--white);
    border: 4px solid var(--ink);
    border-radius: 0;
    box-shadow: 9px 9px 0 var(--ink);
    text-decoration: none;
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .discovery-card:nth-child(2n) {
    transform: translateY(18px);
  }

  .discovery-card:nth-child(2n):hover {
    transform: translate(5px, 13px);
  }

  .discovery-card:hover {
    transform: translate(5px, -5px);
    background: var(--acid);
    box-shadow: 13px 13px 0 var(--warning);
  }

  .discovery-card:focus-visible {
    outline: 4px solid var(--acid);
    outline-offset: 5px;
  }

  .discovery-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .discovery-card__middle {
    width: 62px;
    height: 62px;
    display: grid;
    place-items: center;
    margin-top: 54px;
    color: var(--acid);
    background: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 0;
    transform: rotate(-4deg);
  }

  .discovery-card:hover .discovery-card__middle {
    color: var(--ink);
    background: var(--white);
    transform: rotate(5deg) scale(1.08);
  }

  .discovery-card__content {
    margin-top: auto;
    padding-top: 28px;
  }

  .discovery-card__content h3 {
    margin: 0;
    font-family: Sora, Inter, sans-serif;
    font-size: 28px;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .discovery-card__content p {
    margin: 13px 0 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.65;
  }

  .discovery-card:hover .discovery-card__content p {
    color: var(--ink);
  }

  .discovery-card__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 24px;
    padding-top: 12px;
    border-top: 3px solid var(--ink);
    color: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
