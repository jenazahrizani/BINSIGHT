---
/**
 * ============================================================================
 * BINSIGHT — HOME PAGE
 * ============================================================================
 * Badung Waste Intelligence
 *
 * Homepage publik utama.
 *
 * Alur:
 * Discover → Understand → Report
 *
 * Pilar:
 * MAP → DATA → EDUCATION → REPORT
 *
 * Catatan:
 * - Tidak menggunakan data tonase / kilogram fiktif.
 * - Tidak melakukan Firebase fetch langsung.
 * - Menggunakan dataset lokal sebagai sumber tampilan awal.
 * ============================================================================
 */

import {
  ArrowRight,
  BarChart3,
  FileText,
  Map,
  Recycle,
  Search,
  ShieldCheck,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import OrganizationCard from "@components/organization/OrganizationCard.astro";
import WasteCard from "@components/waste/WasteCard.astro";

import {
  getFeaturedOrganizations,
  getPublicOrganizations,
} from "@lib/data/organizations";

import {
  WASTE_CATEGORY,
} from "@lib/constants/waste";

const allOrganizations =
  getPublicOrganizations();

const featuredOrganizations =
  getFeaturedOrganizations();

const totalOrganizations =
  allOrganizations.length;

const organizationCount =
  Math.max(
    featuredOrganizations.length,
    1,
  );

const wasteCategories = [
  {
    name: "Organik",
    slug: WASTE_CATEGORY.ORGANIC,
    description:
      "Material yang berasal dari sumber organik dan memiliki karakteristik yang dapat dikelola secara biologis.",
    icon: "organic" as const,
  },
  {
    name: "Anorganik",
    slug: WASTE_CATEGORY.INORGANIC,
    description:
      "Material non-organik yang dapat dipilah untuk mendukung pemanfaatan dan pengelolaan material.",
    icon: "inorganic" as const,
  },
  {
    name: "Bahan Berbahaya",
    slug: WASTE_CATEGORY.HAZARDOUS,
    description:
      "Material yang memerlukan perhatian dan penanganan khusus berdasarkan karakteristiknya.",
    icon: "hazardous" as const,
  },
  {
    name: "Elektronik",
    slug: WASTE_CATEGORY.ELECTRONIC,
    description:
      "Peralatan atau material elektronik yang memerlukan pengelolaan sesuai karakteristiknya.",
    icon: "electronic" as const,
  },
  {
    name: "Residu",
    slug: WASTE_CATEGORY.RESIDUAL,
    description:
      "Material sisa yang tidak termasuk dalam alur pemanfaatan utama dan memerlukan pengelolaan lanjutan.",
    icon: "residual" as const,
  },
];

const navigationCards = [
  {
    title: "Jelajahi Peta",
    description:
      "Temukan lokasi, organisasi, dan informasi persampahan dalam konteks wilayah Kabupaten Badung.",
    href: "/map",
    icon: Map,
  },
  {
    title: "Lihat Data",
    description:
      "Pahami ekosistem persampahan melalui informasi dan entitas yang tercatat di BINSIGHT.",
    href: "/dashboard",
    icon: BarChart3,
  },
  {
    title: "Kenali Pengelola",
    description:
      "Temukan organisasi yang bergerak dalam pengelolaan dan edukasi persampahan.",
    href: "/organizations",
    icon: ShieldCheck,
  },
  {
    title: "Buat Laporan",
    description:
      "Sampaikan kondisi persampahan atau lingkungan yang perlu diperhatikan.",
    href: "/reports/create",
    icon: FileText,
  },
];
---

<PublicLayout
  title="BINSIGHT — Badung Waste Intelligence"
  description="Platform informasi persampahan Kabupaten Badung untuk menemukan, memahami, dan melaporkan kondisi persampahan."
>
  <main class="home">
    <!-- ================================================================== -->
    <!-- HERO                                                               -->
    <!-- ================================================================== -->

    <section class="hero">
      <div class="hero__glow hero__glow--one" aria-hidden="true"></div>
      <div class="hero__glow hero__glow--two" aria-hidden="true"></div>

      <div class="container hero__inner">
        <div class="hero__content">
          <div class="hero__eyebrow">
            <span class="hero__eyebrow-dot"></span>
            Badung Waste Intelligence
          </div>

          <h1>
            Kenali.
            <span> Pahami.</span>
            <br />
            Jaga Badung.
          </h1>

          <p class="hero__description">
            BINSIGHT adalah platform informasi persampahan
            Kabupaten Badung yang menghubungkan peta, data,
            organisasi pengelola, edukasi, dan laporan masyarakat
            dalam satu ekosistem informasi.
          </p>

          <div class="hero__actions">
            <a
              href="/map"
              class="button button--primary"
            >
              <Map
                size={18}
                stroke-width="1.9"
                aria-hidden="true"
              />
              <span>Jelajahi peta</span>
              <ArrowRight
                size={16}
                stroke-width="1.9"
                aria-hidden="true"
              />
            </a>

            <a
              href="/reports/create"
              class="button button--secondary"
            >
              <FileText
                size={17}
                stroke-width="1.9"
                aria-hidden="true"
              />
              <span>Buat laporan</span>
            </a>
          </div>

          <div class="hero__trust">
            <ShieldCheck
              size={16}
              stroke-width="1.8"
              aria-hidden="true"
            />

            <span>
              Informasi publik yang dikembangkan
              dengan prinsip verifikasi dan transparansi.
            </span>
          </div>
        </div>

        <div class="hero__visual" aria-hidden="true">
          <div class="hero-map">
            <div class="hero-map__grid"></div>

            <div class="hero-map__shape hero-map__shape--one"></div>
            <div class="hero-map__shape hero-map__shape--two"></div>
            <div class="hero-map__shape hero-map__shape--three"></div>

            <div class="hero-map__road hero-map__road--one"></div>
            <div class="hero-map__road hero-map__road--two"></div>
            <div class="hero-map__road hero-map__road--three"></div>

            <div class="hero-map__marker hero-map__marker--one">
              <span></span>
            </div>

            <div class="hero-map__marker hero-map__marker--two">
              <span></span>
            </div>

            <div class="hero-map__marker hero-map__marker--three">
              <span></span>
            </div>

            <div class="hero-map__marker hero-map__marker--four">
              <span></span>
            </div>

            <div class="hero-map__panel hero-map__panel--top">
              <Map
                size={15}
                stroke-width="1.8"
              />
              <span>Badung</span>
            </div>

            <div class="hero-map__panel hero-map__panel--bottom">
              <div class="hero-map__panel-value">
                {totalOrganizations}
              </div>
              <div class="hero-map__panel-label">
                organisasi publik
              </div>
            </div>

            <div class="hero-map__compass">
              N
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- QUICK DISCOVERY                                                    -->
    <!-- ================================================================== -->

    <section class="section section--discovery">
      <div class="container">
        <div class="section-heading section-heading--center">
          <span class="section-heading__eyebrow">
            Mulai dari sini
          </span>

          <h2>
            Satu platform untuk memahami
            ekosistem persampahan
          </h2>

          <p>
            Mulai dari lokasi dan organisasi hingga data,
            edukasi, dan laporan masyarakat.
          </p>
        </div>

        <div class="discovery-grid">
          {navigationCards.map((item) => {
            const Icon = item.icon;

            return (
              <a
                href={item.href}
                class="discovery-card"
              >
                <div class="discovery-card__icon">
                  <Icon
                    size={22}
                    stroke-width="1.8"
                    aria-hidden="true"
                  />
                </div>

                <div class="discovery-card__content">
                  <h3>
                    {item.title}
                  </h3>

                  <p>
                    {item.description}
                  </p>
                </div>

                <ArrowRight
                  class="discovery-card__arrow"
                  size={17}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- PLATFORM PILLARS                                                   -->
    <!-- ================================================================== -->

    <section class="section section--pillars">
      <div class="container">
        <div class="pillars">
          <div class="pillars__intro">
            <span class="section-heading__eyebrow">
              Ekosistem BINSIGHT
            </span>

            <h2>
              Informasi yang terhubung,
              bukan data yang berdiri sendiri.
            </h2>

            <p>
              BINSIGHT menghubungkan lokasi, organisasi,
              kategori sampah, dan laporan agar masyarakat
              dapat melihat konteks persampahan secara lebih utuh.
            </p>

            <a
              href="/dashboard"
              class="text-link"
            >
              Lihat data BINSIGHT
              <ArrowRight
                size={16}
                stroke-width="1.8"
                aria-hidden="true"
              />
            </a>
          </div>

          <div class="pillars__items">
            <article class="pillar">
              <div class="pillar__number">
                01
              </div>

              <div class="pillar__icon">
                <Map
                  size={21}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
              </div>

              <h3>Peta</h3>

              <p>
                Lihat ekosistem persampahan berdasarkan
                wilayah dan lokasi.
              </p>
            </article>

            <article class="pillar">
              <div class="pillar__number">
                02
              </div>

              <div class="pillar__icon">
                <BarChart3
                  size={21}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
              </div>

              <h3>Data</h3>

              <p>
                Pahami entitas dan informasi yang tercatat
                tanpa klaim volume yang tidak tervalidasi.
              </p>
            </article>

            <article class="pillar">
              <div class="pillar__number">
                03
              </div>

              <div class="pillar__icon">
                <Recycle
                  size={21}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
              </div>

              <h3>Edukasi</h3>

              <p>
                Kenali kategori, karakteristik, dan proses
                pengelolaan material.
              </p>
            </article>

            <article class="pillar">
              <div class="pillar__number">
                04
              </div>

              <div class="pillar__icon">
                <FileText
                  size={21}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
              </div>

              <h3>Laporan</h3>

              <p>
                Sampaikan kondisi persampahan yang perlu
                diperhatikan dan ditinjau.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- ORGANIZATIONS                                                      -->
    <!-- ================================================================== -->

    <section class="section">
      <div class="container">
        <div class="section-heading-row">
          <div class="section-heading">
            <span class="section-heading__eyebrow">
              Organisasi
            </span>

            <h2>
              Kenali para pengelola
            </h2>

            <p>
              Temukan organisasi yang telah tercatat dan
              terverifikasi dalam ekosistem BINSIGHT.
            </p>
          </div>

          <a
            href="/organizations"
            class="section-link"
          >
            Lihat semua
            <ArrowRight
              size={16}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </a>
        </div>

        {featuredOrganizations.length > 0 ? (
          <div class="organization-grid">
            {featuredOrganizations
              .slice(0, 3)
              .map((organization) => (
                <OrganizationCard
                  organization={organization}
                  featured={organization.isFeatured}
                />
              ))}
          </div>
        ) : (
          <div class="empty-block">
            <div class="empty-block__icon">
              <ShieldCheck
                size={23}
                stroke-width="1.8"
                aria-hidden="true"
              />
            </div>

            <div>
              <h3>
                Belum ada organisasi unggulan
              </h3>

              <p>
                Organisasi publik yang telah diverifikasi
                akan ditampilkan di sini.
              </p>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- WASTE CATEGORIES                                                    -->
    <!-- ================================================================== -->

    <section class="section section--soft">
      <div class="container">
        <div class="section-heading-row">
          <div class="section-heading">
            <span class="section-heading__eyebrow">
              Kenali material
            </span>

            <h2>
              Jelajahi kategori sampah
            </h2>

            <p>
              Pahami perbedaan karakteristik material dan
              bagaimana pengelolaannya dapat dilakukan.
            </p>
          </div>

          <a
            href="/waste"
            class="section-link"
          >
            Jelajahi semua
            <ArrowRight
              size={16}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </a>
        </div>

        <div class="waste-grid">
          {wasteCategories.map((category) => (
            <WasteCard
              waste={{
                id: category.slug,
                slug: category.slug,
                name: category.name,
                description: category.description,
                category: category.name,
                characteristics: [],
              }}
              href={`/waste?category=${encodeURIComponent(category.slug)}`}
              compact
              showCharacteristics={false}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- SEARCH / MAP CTA                                                    -->
    <!-- ================================================================== -->

    <section class="section section--map-cta">
      <div class="container">
        <div class="map-cta">
          <div class="map-cta__content">
            <span class="section-heading__eyebrow">
              Berbasis lokasi
            </span>

            <h2>
              Mulai dari peta Badung
            </h2>

            <p>
              Peta menjadi pintu masuk utama untuk menemukan
              lokasi, area, organisasi, dan informasi persampahan
              yang saling berkaitan.
            </p>

            <div class="map-cta__actions">
              <a
                href="/map"
                class="button button--light"
              >
                <Map
                  size={18}
                  stroke-width="1.9"
                  aria-hidden="true"
                />
                Buka peta
                <ArrowRight
                  size={16}
                  stroke-width="1.9"
                  aria-hidden="true"
                />
              </a>

              <a
                href="/map"
                class="map-cta__secondary"
              >
                <Search
                  size={16}
                  stroke-width="1.8"
                  aria-hidden="true"
                />
                Cari lokasi
              </a>
            </div>
          </div>

          <div
            class="map-cta__graphic"
            aria-hidden="true"
          >
            <div class="map-cta__grid"></div>

            <div class="map-cta__circle map-cta__circle--one"></div>
            <div class="map-cta__circle map-cta__circle--two"></div>
            <div class="map-cta__circle map-cta__circle--three"></div>

            <div class="map-cta__line map-cta__line--one"></div>
            <div class="map-cta__line map-cta__line--two"></div>

            <div class="map-cta__pin map-cta__pin--one">
              <Map
                size={15}
                stroke-width="2"
              />
            </div>

            <div class="map-cta__pin map-cta__pin--two">
              <Recycle
                size={14}
                stroke-width="2"
              />
            </div>

            <div class="map-cta__pin map-cta__pin--three">
              <FileText
                size={14}
                stroke-width="2"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- REPORT CTA                                                         -->
    <!-- ================================================================== -->

    <section class="section section--report">
      <div class="container">
        <div class="report-cta">
          <div class="report-cta__icon">
            <FileText
              size={25}
              stroke-width="1.8"
              aria-hidden="true"
            />
          </div>

          <div class="report-cta__content">
            <span class="section-heading__eyebrow">
              Berkontribusi
            </span>

            <h2>
              Temukan kondisi yang perlu diperhatikan?
            </h2>

            <p>
              Laporkan kondisi persampahan atau lingkungan
              melalui BINSIGHT agar dapat ditinjau dan
              dicatat dalam ekosistem informasi.
            </p>
          </div>

          <a
            href="/reports/create"
            class="button button--primary"
          >
            Buat laporan
            <ArrowRight
              size={16}
              stroke-width="1.9"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  .home {
    overflow: hidden;
  }

  .container {
    width: min(
      1180px,
      calc(100% - 2rem)
    );
    margin-inline: auto;
  }

  .section {
    padding: 5rem 0;
  }

  .section--soft {
    background: var(--color-background);
  }

  /* ========================================================================
     BUTTONS
     ======================================================================== */

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.8rem;
    padding: 0.72rem 1rem;
    border-radius: 0.7rem;
    font-size: 0.8rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button--primary {
    border: 1px solid var(--color-primary);
    background: var(--color-primary);
    color: #fff;
  }

  .button--primary:hover {
    border-color: var(--color-primary-dark);
    background: var(--color-primary-dark);
    box-shadow: var(--shadow-md);
  }

  .button--secondary {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .button--secondary:hover {
    border-color: var(--color-primary-light);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .button--light {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: #fff;
    color: var(--color-primary-dark);
  }

  .button--light:hover {
    box-shadow: var(--shadow-md);
  }

  /* ========================================================================
     HERO
     ======================================================================== */

  .hero {
    position: relative;
    min-height: 43rem;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 78% 18%,
        rgba(132, 204, 22, 0.14),
        transparent 30%
      ),
      linear-gradient(
        135deg,
        #f8fafc 0%,
        #ffffff 58%,
        #f0fdf4 100%
      );
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
  }

  .hero__glow--one {
    top: 5rem;
    right: 5%;
    width: 19rem;
    height: 19rem;
    border: 1px solid rgba(22, 101, 52, 0.05);
  }

  .hero__glow--two {
    right: 19%;
    bottom: -7rem;
    width: 15rem;
    height: 15rem;
    border: 1px solid rgba(132, 204, 22, 0.07);
  }

  .hero__inner {
    position: relative;
    display: grid;
    min-height: 43rem;
    grid-template-columns:
      minmax(0, 1.03fr)
      minmax(0, 0.97fr);
    align-items: center;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .hero__content {
    position: relative;
    z-index: 2;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--color-primary-light);
    border-radius: 999px;
    background: rgba(220, 252, 231, 0.65);
    color: var(--color-primary-dark);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__eyebrow-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow:
      0 0 0 4px
      rgba(132, 204, 22, 0.12);
  }

  .hero h1 {
    max-width: 720px;
    margin: 0;
    color: var(--color-text);
    font-size: clamp(
      2.7rem,
      6vw,
      5rem
    );
    font-weight: 850;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    color: var(--color-primary);
  }

  .hero__description {
    max-width: 680px;
    margin: 1.5rem 0 0;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.7rem;
  }

  .hero__trust {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 610px;
    margin-top: 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.73rem;
    line-height: 1.5;
  }

  .hero__trust svg {
    flex: 0 0 auto;
    color: var(--color-primary);
  }

  /* ========================================================================
     HERO MAP
     ======================================================================== */

  .hero__visual {
    position: relative;
    min-height: 34rem;
  }

  .hero-map {
    position: absolute;
    inset: 1rem 0 1rem 1rem;
    overflow: hidden;
    border: 1px solid rgba(22, 101, 52, 0.1);
    border-radius: 2rem;
    background:
      radial-gradient(
        circle at 30% 24%,
        rgba(132, 204, 22, 0.16),
        transparent 24%
      ),
      linear-gradient(
        145deg,
        #ecfdf5,
        #dcfce7 58%,
        #f7fee7
      );
    box-shadow:
      0 30px 80px
      rgba(15, 23, 42, 0.12);
  }

  .hero-map__grid,
  .map-cta__grid {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image:
      linear-gradient(
        rgba(22, 101, 52, 0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(22, 101, 52, 0.08) 1px,
        transparent 1px
      );
    background-size: 2rem 2rem;
  }

  .hero-map__shape {
    position: absolute;
    border: 1px solid rgba(22, 101, 52, 0.16);
    background: rgba(255, 255, 255, 0.25);
    transform: rotate(
      18deg
    );
  }

  .hero-map__shape--one {
    top: 15%;
    left: 10%;
    width: 52%;
    height: 38%;
    border-radius:
      42% 58% 62% 38%
      / 34% 36% 64% 66%;
  }

  .hero-map__shape--two {
    right: -4%;
    bottom: 14%;
    width: 58%;
    height: 42%;
    border-radius:
      58% 42% 37% 63%
      / 45% 57% 43% 55%;
  }

  .hero-map__shape--three {
    top: 6%;
    right: 9%;
    width: 23%;
    height: 22%;
    border-radius: 50%;
