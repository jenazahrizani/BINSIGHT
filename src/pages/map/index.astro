      var(--warning);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.06em;

    text-transform: uppercase;

    cursor: pointer;
