---
import {
  ArrowRight,
  Building2,
  Map,
  MapPin,
  Recycle,
  Search,
  SlidersHorizontal,
  TriangleAlert,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import MapFilter from "@components/map/MapFilter.astro";
import WasteMap from "@components/map/WasteMap.astro";

import {
  getAreas,
  type Area,
  type WasteLocation,
} from "@lib/data/locations";

import {
  getPublicOrganizations,
  type Organization,
} from "@lib/data/organizations";

import * as locationModule from "@lib/data/locations";

/* ==========================================================================
   TYPES
   ========================================================================== */

type LocationDataModule = {
  getLocations?: unknown;
  getPublicLocations?: unknown;
  getActiveLocations?: unknown;

  locations?: unknown;
  wasteLocations?: unknown;
  WASTE_LOCATIONS?: unknown;
  LOCATIONS?: unknown;
};

/* ==========================================================================
   AREAS
   ========================================================================== */

const areas: Area[] = getAreas();

const activeAreas: Area[] = areas.filter(
  (area) => area.status === "active",
);

/* ==========================================================================
   LOCATIONS
   ========================================================================== */

const resolvedLocationModule =
  locationModule as unknown as LocationDataModule;

function normalizeLocations(
  value: unknown,
): WasteLocation[] | null {
  if (!Array.isArray(value)) {
    return null;
  }

  return value as WasteLocation[];
}

function tryLocationGetter(
  getter: unknown,
): WasteLocation[] | null {
  if (typeof getter !== "function") {
    return null;
  }

  try {
    const result =
      (getter as () => unknown)();

    return normalizeLocations(result);
  } catch (error) {
    console.warn(
      "[BINSIGHT] Location getter failed:",
      error,
    );

    return null;
  }
}

function resolveLocations(): WasteLocation[] {
  const getterCandidates: unknown[] = [
    resolvedLocationModule.getLocations,
    resolvedLocationModule.getPublicLocations,
    resolvedLocationModule.getActiveLocations,
  ];

  for (const getter of getterCandidates) {
    const locations =
      tryLocationGetter(getter);

    if (locations) {
      return locations;
    }
  }

  const collectionCandidates: unknown[] = [
    resolvedLocationModule.locations,
    resolvedLocationModule.wasteLocations,
    resolvedLocationModule.WASTE_LOCATIONS,
    resolvedLocationModule.LOCATIONS,
  ];

  for (const collection of collectionCandidates) {
    const locations =
      normalizeLocations(collection);

    if (locations) {
      return [...locations];
    }
  }

  console.warn(
    "[BINSIGHT] No usable location data export was found.",
  );

  return [];
}

const allLocations: WasteLocation[] =
  resolveLocations();

const activeLocations: WasteLocation[] =
  allLocations.filter(
    (location) =>
      location &&
      location.status === "active",
  );

/* ==========================================================================
   ORGANIZATIONS
   ========================================================================== */

const organizations: Organization[] =
  getPublicOrganizations();

/* ==========================================================================
   LOCATION / AREA SUMMARY
   ========================================================================== */

const locationsByArea: Record<string, number> = {};

for (const location of activeLocations) {
  if (!location.areaId) {
    continue;
  }

  locationsByArea[location.areaId] =
    (locationsByArea[location.areaId] ?? 0) + 1;
}

const areaSummaries = activeAreas
  .map((area) => ({
    area,
    count: locationsByArea[area.id] ?? 0,
  }))
  .sort(
    (first, second) =>
      second.count - first.count,
  );

/* ==========================================================================
   LOCATION TYPE SUMMARY
   ========================================================================== */

const locationTypeLabels: Record<string, string> = {
  "collection-point":
    "Titik Pengumpulan",

  "recycling-center":
    "Pusat Daur Ulang",

  "waste-bank":
    "Bank Sampah",

  "processing-facility":
    "Fasilitas Pengolahan",

  "drop-point":
    "Drop Point",

  other:
    "Lokasi Lainnya",
};

const locationTypeCounts: Record<string, number> =
  {};

for (const location of activeLocations) {
  if (!location.type) {
    continue;
  }

  locationTypeCounts[location.type] =
    (locationTypeCounts[location.type] ?? 0) + 1;
}

const locationTypeSummary = Object.entries(
  locationTypeCounts,
)
  .map(([type, count]) => ({
    type,
    label:
      locationTypeLabels[type] ?? type,
    count,
  }))
  .sort(
    (first, second) =>
      second.count - first.count,
  );

/* ==========================================================================
   METRICS
   ========================================================================== */

const organizationCount =
  organizations.length;

const areaCount =
  activeAreas.length;

const locationCount =
  activeLocations.length;

const locationTypeCount =
  locationTypeSummary.length;

/* ==========================================================================
   PAGE META
   ========================================================================== */

const pageTitle =
  "Peta Persampahan Kabupaten Badung";

const pageDescription =
  "Eksplorasi lokasi pengelolaan sampah, area, dan organisasi terverifikasi di Kabupaten Badung.";
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
>
  <main class="map-page">

    <!-- =====================================================================
         HERO
         ================================================================== -->

    <section
      class="map-hero"
      aria-labelledby="map-hero-title"
    >
      <div class="map-hero__main">

        <div class="map-label">
          <Map
            size={15}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            BINSIGHT · MAP
          </span>
        </div>

        <h1 id="map-hero-title">
          Temukan ekosistem pengelolaan sampah
          di Kabupaten Badung
        </h1>

        <p class="map-hero__description">
          Jelajahi titik pengelolaan sampah berdasarkan
          lokasi, area, dan tipe fasilitas yang tersedia
          di Kabupaten Badung.
        </p>

        <div class="map-hero__actions">

          <a
            href="#explore-map"
            class="button button--primary"
            aria-label="Eksplorasi peta BINSIGHT"
          >
            <MapPin
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Eksplorasi peta
            </span>

            <ArrowRight
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>

          <a
            href="/reports/create"
            class="button button--secondary"
            aria-label="Buat laporan"
          >
            <TriangleAlert
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Buat laporan
            </span>
          </a>

        </div>
      </div>


      <!-- HERO METRICS -->

      <div
        class="map-hero__stats"
        aria-label="Ringkasan data peta"
      >

        <div class="hero-stat">

          <span class="hero-stat__icon">
            <MapPin
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <div>
            <strong>
              {locationCount}
            </strong>

            <span>
              Lokasi aktif
            </span>
          </div>

        </div>


        <div class="hero-stat">

          <span class="hero-stat__icon">
            <Building2
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <div>
            <strong>
              {organizationCount}
            </strong>

            <span>
              Organisasi
            </span>
          </div>

        </div>


        <div class="hero-stat">

          <span class="hero-stat__icon">
            <Map
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <div>
            <strong>
              {areaCount}
            </strong>

            <span>
              Area aktif
            </span>
          </div>

        </div>

      </div>
    </section>


    <!-- =====================================================================
         EXPLORER
         ================================================================== -->

    <section
      id="explore-map"
      class="content-section explorer-section"
      aria-labelledby="explorer-title"
    >

      <div class="section-header">

        <div class="section-header__content">

          <span class="section-kicker">
            Eksplorasi
          </span>

          <h2 id="explorer-title">
            Peta lokasi pengelolaan
          </h2>

          <p>
            Cari dan jelajahi lokasi pengelolaan sampah
            yang tersedia di Kabupaten Badung.
          </p>

        </div>

        <div
          class="section-counter"
          aria-label={`${locationCount} lokasi aktif`}
        >
          <strong>
            {locationCount}
          </strong>

          <span>
            lokasi aktif
          </span>
        </div>

      </div>


      <!-- SEARCH -->

      <div class="map-toolbar">

        <label
          class="search-box"
          for="map-search-input"
        >

          <Search
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />

          <input
            id="map-search-input"
            type="search"
            placeholder="Cari lokasi, alamat, atau area..."
            autocomplete="off"
          />

        </label>


        <button
          type="button"
          class="filter-button"
          id="map-filter-toggle"
          aria-expanded="false"
          aria-controls="map-filter-panel"
        >

          <SlidersHorizontal
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Filter area
          </span>

        </button>

      </div>


      <!-- FILTER -->

      <div
        id="map-filter-panel"
        class="filter-panel"
        aria-hidden="true"
      >

        <div class="filter-panel__header">

          <div>

            <span class="section-kicker section-kicker--dark">
              Wilayah
            </span>

            <h3>
              Pilih kecamatan / area
            </h3>

          </div>

          <span class="filter-panel__count">
            {areaCount} area aktif
          </span>

        </div>

        <MapFilter
          areas={activeAreas}
        />

      </div>


      <!-- MAP -->

      <div class="map-shell">

        <!-- SIDEBAR -->

        <aside
          class="map-sidebar"
          aria-label="Informasi peta"
        >

          <!-- COVERAGE -->

          <div class="info-card info-card--dark">

            <div class="info-card__header">

              <div>

                <span class="info-card__eyebrow">
                  Cakupan
                </span>

                <strong>
                  Kabupaten Badung
                </strong>

              </div>

              <Map
                size={19}
                stroke-width={1.9}
                aria-hidden="true"
              />

            </div>

            <div class="stats-list">

              <div class="stats-row">

                <span>
                  Lokasi aktif
                </span>

                <strong>
                  {locationCount}
                </strong>

              </div>

              <div class="stats-row">

                <span>
                  Area aktif
                </span>

                <strong>
                  {areaCount}
                </strong>

              </div>

              <div class="stats-row">

                <span>
                  Jenis lokasi
                </span>

                <strong>
                  {locationTypeCount}
                </strong>

              </div>

            </div>

          </div>


          <!-- HOW TO -->

          <div class="info-card">

            <div class="info-card__title">

              <SlidersHorizontal
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>
                Cara menggunakan peta
              </span>

            </div>

            <ol class="usage-list">

              <li>

                <span>
                  01
                </span>

                <p>
                  Pilih area untuk mempersempit
                  lokasi yang ditampilkan.
                </p>

              </li>

              <li>

                <span>
                  02
                </span>

                <p>
                  Gunakan pencarian untuk menemukan
                  lokasi tertentu.
                </p>

              </li>

              <li>

                <span>
                  03
                </span>

                <p>
                  Buka detail lokasi untuk mengetahui
                  pengelolaan dan organisasi terkait.
                </p>

              </li>

            </ol>

          </div>


          <!-- REPORT -->

          <a
            href="/reports/create"
            class="report-card"
          >

            <span class="report-card__icon">

              <TriangleAlert
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />

            </span>

            <span class="report-card__content">

              <strong>
                Temukan masalah?
              </strong>

              <small>
                Kirim laporan dari lapangan.
              </small>

            </span>

            <ArrowRight
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

          </a>

        </aside>


        <!-- MAP FRAME -->

        <div class="map-frame">

          {
            activeLocations.length > 0 ? (
              <div class="map-frame__inner">
                <WasteMap
                  locations={activeLocations}
                />
              </div>
            ) : (
              <div class="map-empty">

                <div class="map-empty__icon">

                  <MapPin
                    size={28}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />

                </div>

                <span class="map-empty__label">
                  Data lokasi
                </span>

                <h3>
                  Belum tersedia
                </h3>

                <p>
                  Belum ada lokasi pengelolaan sampah
                  aktif yang dapat ditampilkan pada peta.
                </p>

                <a
                  href="/reports/create"
                  class="button button--primary"
                >
                  Tambahkan informasi
                </a>

              </div>
            )
          }

        </div>

      </div>

    </section>


    <!-- =====================================================================
         AREAS
         ================================================================== -->

    <section
      class="content-section"
      aria-labelledby="areas-title"
    >

      <div class="section-header">

        <div class="section-header__content">

          <span class="section-kicker">
            Area
          </span>

          <h2 id="areas-title">
            Jelajahi berdasarkan wilayah
          </h2>

          <p>
            Pilih area untuk melihat lokasi pengelolaan
            yang tersedia di dalamnya.
          </p>

        </div>

        <a
          href="/map"
          class="text-action"
        >

          <span>
            Lihat peta utama
          </span>

          <ArrowRight
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

        </a>

      </div>


      {
        areaSummaries.length > 0 ? (
          <div class="area-grid">

            {areaSummaries.map(
              ({ area, count }, index) => (
                <a
                  class="area-card"
                  href={`/map/${area.slug}`}
                  data-area-card
                  aria-label={`${area.name}, ${count} lokasi aktif`}
                >

                  <span class="area-card__index">
                    {String(index + 1).padStart(
                      2,
                      "0",
                    )}
                  </span>

                  <div class="area-card__body">

                    <strong>
                      {area.name}
                    </strong>

                    <span>
                      {count} lokasi aktif
                    </span>

                  </div>

                  <span class="area-card__arrow">

                    <ArrowRight
                      size={16}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                  </span>

                </a>
              ),
            )}

          </div>
        ) : (
          <div class="empty-panel">

            <Map
              size={26}
              stroke-width={1.8}
              aria-hidden="true"
            />

            <h3>
              Belum ada area aktif
            </h3>

            <p>
              Belum terdapat area aktif yang dapat
              ditampilkan pada peta.
            </p>

          </div>
        )
      }

    </section>


    <!-- =====================================================================
         TYPES
         ================================================================== -->

    {
      locationTypeSummary.length > 0 && (
        <section
          class="content-section"
          aria-labelledby="types-title"
        >

          <div class="section-header section-header--single">

            <div class="section-header__content">

              <span class="section-kicker">
                Jenis lokasi
              </span>

              <h2 id="types-title">
                Distribusi titik pengelolaan
              </h2>

              <p>
                Ringkasan tipe lokasi yang saat ini
                tercatat aktif.
              </p>

            </div>

          </div>


          <div class="type-grid">

            {locationTypeSummary.map(
              ({ label, count, type }) => {

                const percentage =
                  locationCount > 0
                    ? Math.round(
                        (count / locationCount) * 100,
                      )
                    : 0;

                const barWidth =
                  percentage > 0
                    ? Math.max(
                        percentage,
                        8,
                      )
                    : 0;

                return (
                  <article
                    class="type-card"
                    data-location-card
                  >

                    <div class="type-card__top">

                      <div class="type-card__icon">

                        <Recycle
                          size={18}
                          stroke-width={2}
                          aria-hidden="true"
                        />

                      </div>

                      <div class="type-card__title">

                        <strong>
                          {label}
                        </strong>

                        <span>
                          {count} lokasi
                        </span>

                      </div>

                      <span class="type-card__percentage">
                        {percentage}%
                      </span>

                    </div>


                    <div
                      class="type-card__bar"
                      aria-hidden="true"
                    >
                      <span
                        style={`width:${barWidth}%`}
                      />
                    </div>


                    <div class="type-card__footer">

                      <span>
                        {type}
                      </span>

                      <span>
                        {percentage}% dari lokasi aktif
                      </span>

                    </div>

                  </article>
                );
              },
            )}

          </div>

        </section>
      )
    }


    <!-- =====================================================================
         CTA
         ================================================================== -->

    <section
      class="map-cta"
      aria-labelledby="map-cta-title"
    >

      <div class="map-cta__mark">

        <TriangleAlert
          size={22}
          stroke-width={2}
          aria-hidden="true"
        />

      </div>


      <div class="map-cta__content">

        <span class="map-cta__eyebrow">
          Kontribusi masyarakat
        </span>

        <h2 id="map-cta-title">
          Tidak menemukan informasi yang kamu cari?
        </h2>

        <p>
          Bantu BINSIGHT memperkaya data persampahan
          dengan memberikan informasi atau membuat
          laporan dari lapangan.
        </p>

      </div>


      <a
        href="/reports/create"
        class="map-cta__button"
      >

        <span>
          Buat laporan
        </span>

        <ArrowRight
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />

      </a>

    </section>

  </main>
</PublicLayout>


<script>
  /* ==========================================================================
     SEARCH
     ========================================================================== */

  const searchInput =
    document.querySelector<HTMLInputElement>(
      "#map-search-input",
    );

  const searchableElements =
    document.querySelectorAll<HTMLElement>(
      "[data-map-location], [data-location-card], [data-area-card]",
    );

  searchInput?.addEventListener(
    "input",
    () => {
      const query =
        searchInput.value
          .trim()
          .toLowerCase();

      searchableElements.forEach(
        (element) => {
          const content =
            element.textContent
              ?.toLowerCase() ?? "";

          const matches =
            query.length === 0 ||
            content.includes(query);

          element.hidden =
            !matches;
        },
      );
    },
  );


  /* ==========================================================================
     FILTER TOGGLE
     ========================================================================== */

  const filterToggle =
    document.querySelector<HTMLButtonElement>(
      "#map-filter-toggle",
    );

  const filterPanel =
    document.querySelector<HTMLElement>(
      "#map-filter-panel",
    );

  filterToggle?.addEventListener(
    "click",
    () => {
      if (!filterPanel) {
        return;
      }

      const isExpanded =
        filterToggle.getAttribute(
          "aria-expanded",
        ) === "true";

      const nextState =
        !isExpanded;

      filterToggle.setAttribute(
        "aria-expanded",
        String(nextState),
      );

      filterPanel.toggleAttribute(
        "data-open",
        nextState,
      );

      filterPanel.setAttribute(
        "aria-hidden",
        String(!nextState),
      );
    },
  );
</script>


<style>
  /* ==========================================================================
     BINSIGHT MAP
     Fully explicit contrast system
     ========================================================================== */

  .map-page,
  .map-page *,
  .map-page *::before,
  .map-page *::after {
    box-sizing: border-box;
  }

  .map-page {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;

    --white: #fffef8;
    --muted: #6c7068;

    --warning: #ff6a00;

    width: 100%;
    min-width: 0;
    padding-bottom: 110px;

    color: var(--ink);
    background:
      repeating-linear-gradient(
        135deg,
        rgba(9, 10, 8, 0.025) 0 1px,
        transparent 1px 9px
      ),
      var(--paper);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .map-page > * {
    width: min(1320px, calc(100% - 40px));
    margin-inline: auto;
  }

  .map-page img,
  .map-page svg {
    max-width: 100%;
  }

  .map-page input,
  .map-page button {
    font: inherit;
  }

  .map-page a,
  .map-page button {
    -webkit-tap-highlight-color: transparent;
  }

  .map-page h1,
  .map-page h2,
  .map-page h3,
  .map-page p {
    overflow-wrap: anywhere;
  }

  .map-page a {
    color: inherit;
  }


  /* ==========================================================================
     LABELS
     ========================================================================== */

  .map-label,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    width: fit-content;
    min-height: 28px;

    padding: 6px 9px;

    color: var(--ink);
    background: var(--acid);

    border: 3px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-label svg,
  .section-kicker svg {
    color: var(--ink);
    flex: 0 0 auto;
  }

  .section-kicker {
    min-height: 27px;
    padding: 5px 8px;
  }

  .section-kicker--dark {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--ink);
  }


  /* ==========================================================================
     BUTTONS
     ========================================================================== */

  .button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 9px;

    min-height: 52px;
    padding: 0 18px;

    border: 3px solid currentColor;
    border-radius: 0;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 9px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.07em;

    text-decoration: none;
    text-transform: uppercase;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .button svg {
    flex: 0 0 auto;
  }

  .button--primary {
    color: var(--ink);
    background: var(--acid);

    border-color: var(--ink);

    box-shadow: 7px 7px 0 var(--warning);
  }

  .button--primary:hover {
    color: var(--ink);
    background: var(--acid-soft);

    transform: translate(-3px, -3px);

    box-shadow: 10px 10px 0 var(--warning);
  }

  .button--secondary {
    color: var(--white);
    background: transparent;

    border-color: var(--white);

    box-shadow: 7px 7px 0 rgba(255, 255, 255, 0.14);
  }

  .button--secondary:hover {
    color: var(--ink);

    background: var(--white);

    border-color: var(--white);

    transform: translate(-3px, -3px);

    box-shadow: 10px 10px 0 var(--acid);
  }


  /* ==========================================================================
     HERO
     ========================================================================== */

  .map-hero {
    position: relative;

    display: grid;

    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(310px, 0.42fr);

    margin-top: 24px;

    color: var(--white);
    background: var(--ink);

    border: 4px solid var(--ink);

    box-shadow: 14px 14px 0 var(--warning);

    overflow: hidden;
    isolation: isolate;
  }

  .map-hero::before {
    position: absolute;

    inset: 0;

    z-index: -1;

    content: "";

    background:
      linear-gradient(
        rgba(255, 255, 255, 0.055) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.055) 2px,
        transparent 2px
      );

    background-size: 28px 28px;

    opacity: 0.45;

    pointer-events: none;
  }

  .map-hero::after {
    position: absolute;

    right: -60px;
    top: -80px;

    width: 260px;
    height: 260px;

    content: "";

    background: var(--acid);

    opacity: 0.9;

    clip-path:
      polygon(
        0 15%,
        82% 0,
        100% 72%,
        35% 100%
      );

    mix-blend-mode: screen;

    pointer-events: none;
  }

  .map-hero__main {
    position: relative;

    min-width: 0;

    padding:
      clamp(
        42px,
        5vw,
        70px
      );
  }

  .map-hero h1 {
    position: relative;

    z-index: 2;

    max-width: 900px;

    margin: 30px 0 0;
    padding-top: 2px;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(
        48px,
        6.4vw,
        90px
      );

    font-weight: 900;

    line-height: 0.85;

    letter-spacing: -0.09em;

    text-transform: uppercase;
  }

  .map-hero__description {
    position: relative;

    z-index: 2;

    max-width: 650px;

    margin: 36px 0 0;
    padding: 5px 0 5px 17px;

    color: #d6d8cf !important;

    background: transparent;

    border-left: 7px solid var(--acid);

    font-size: 13px;
    font-weight: 500;
    line-height: 1.78;
  }

  .map-hero__description strong {
    color: var(--acid);
  }

  .map-hero__actions {
    position: relative;

    z-index: 2;

    display: flex;

    flex-wrap: wrap;

    gap: 12px;

    margin-top: 34px;
  }

  .map-hero__stats {
    display: flex;

    flex-direction: column;

    color: var(--ink);

    background: var(--acid);

    border-left: 4px solid var(--ink);
  }

  .hero-stat {
    display: grid;

    grid-template-columns:
      48px
      minmax(0, 1fr);

    align-items: center;

    gap: 13px;

    flex: 1;

    padding: 25px;

    color: var(--ink);

    background: var(--acid);

    border-bottom: 3px solid var(--ink);
  }

  .hero-stat:last-child {
    border-bottom: 0;
  }

  .hero-stat__icon {
    display: grid;

    width: 48px;
    height: 48px;

    place-items: center;

    color: var(--acid);

    background: var(--ink);

    border: 3px solid var(--ink);
  }

  .hero-stat__icon svg {
    color: var(--acid);
  }

  .hero-stat > div {
    display: grid;

    gap: 6px;

    min-width: 0;
  }

  .hero-stat strong {
    color: var(--ink) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 36px;

    font-weight: 900;

    line-height: 0.9;

    letter-spacing: -0.065em;
  }

  .hero-stat > div > span {
    color: #31382f !important;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    line-height: 1.35;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  /* ==========================================================================
     SECTIONS
     ========================================================================== */

  .content-section {
    position: relative;

    margin-top: 112px;

    color: var(--ink);
  }

  .section-header {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: end;

    gap: 34px;

    margin-bottom: 32px;
  }

  .section-header--single {
    display: block;
  }

  .section-header__content {
    min-width: 0;
  }

  .section-header h2 {
    max-width: 900px;

    margin: 19px 0 0;
    padding-top: 2px;

    color: var(--ink) !important;

    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(
        44px,
        5.7vw,
        78px
      );

    font-weight: 900;

    line-height: 0.86;

    letter-spacing: -0.085em;

    text-transform: uppercase;
  }

  .section-header p {
    max-width: 620px;

    margin: 19px 0 0;

    color: var(--muted) !important;

    font-size: 12px;

    line-height: 1.75;
  }

  .section-counter {
    display: inline-flex;

    align-items: baseline;

    gap: 9px;

    flex: 0 0 auto;

    padding: 10px 12px;

    color: var(--acid) !important;

    background: var(--ink) !important;

    border: 3px solid var(--ink);

    box-shadow: 5px 5px 0 var(--warning);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .section-counter strong {
    color: var(--acid) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 24px;

    line-height: 1;

    letter-spacing: -0.05em;
  }

  .section-counter span {
    color: var(--white) !important;
  }


  /* ==========================================================================
     TOOLBAR
     ========================================================================== */

  .map-toolbar {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    gap: 12px;

    margin-bottom: 18px;
  }

  .search-box {
    display: flex;

    align-items: center;

    gap: 11px;

    min-width: 0;

    min-height: 58px;

    padding: 0 16px;

    color: var(--warning);

    background: var(--white);

    border: 3px solid var(--ink);

    box-shadow: 6px 6px 0 var(--ink);

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }

  .search-box > svg {
    flex: 0 0 auto;
    color: var(--warning);
  }

  .search-box:focus-within {
    transform: translate(-3px, -3px);

    box-shadow: 9px 9px 0 var(--acid);
  }

  .search-box input {
    width: 100%;

    min-width: 0;

    padding: 0;

    color: var(--ink) !important;

    background: transparent;

    border: 0;

    outline: 0;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 10px;

    font-weight: 700;
  }

  .search-box input::placeholder {
    color: #777d74 !important;
    opacity: 1;
  }

  .filter-button {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-width: 150px;

    min-height: 58px;

    padding: 0 17px;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 3px solid var(--ink);

    box-shadow: 6px 6px 0 var(--warning);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.06em;

    text-transform: uppercase;

    cursor: pointer;
  }

  .filter-button svg {
    color: var(--ink) !important;
  }

  .filter-button:hover {
    color: var(--ink) !important;

    background: var(--acid-soft) !important;

    transform: translate(-3px, -3px);

    box-shadow: 9px 9px 0 var(--ink);
  }

  .filter-button[aria-expanded="true"] {
    color: var(--acid) !important;

    background: var(--ink) !important;

    border-color: var(--ink);

    box-shadow: 6px 6px 0 var(--warning);
  }

  .filter-button[aria-expanded="true"] svg {
    color: var(--acid) !important;
  }


  /* ==========================================================================
     FILTER PANEL
     ========================================================================== */

  .filter-panel {
    display: none;

    margin-bottom: 20px;

    padding: 22px;

    color: var(--white);

    background: var(--ink);

    border: 3px solid var(--ink);

    box-shadow: 8px 8px 0 var(--warning);
  }

  .filter-panel[data-open] {
    display: block;
  }

  .filter-panel__header {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 20px;
  }

  .filter-panel__header h3 {
    margin: 13px 0 0;
    padding-top: 2px;

    color: var(--white) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 25px;

    font-weight: 900;

    line-height: 0.94;

    letter-spacing: -0.06em;

    text-transform: uppercase;
  }

  .filter-panel__count {
    flex: 0 0 auto;

    padding: 7px 9px;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 2px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }


  /* ==========================================================================
     MAP SHELL
     ========================================================================== */

  .map-shell {
    display: grid;

    grid-template-columns:
      286px
      minmax(0, 1fr);

    gap: 18px;

    align-items: start;
  }

  .map-sidebar {
    display: flex;

    flex-direction: column;

    gap: 15px;

    min-width: 0;
  }


  /* ==========================================================================
     INFO CARDS
     ========================================================================== */

  .info-card {
    min-width: 0;

    padding: 19px;

    color: var(--ink);

    background: var(--white);

    border: 3px solid var(--ink);

    box-shadow: 6px 6px 0 var(--ink);
  }

  .info-card--dark {
    color: var(--white);

    background: var(--ink);

    border-color: var(--ink);

    box-shadow: 7px 7px 0 var(--acid);
  }

  .info-card__header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 12px;
  }

  .info-card__header > div {
    min-width: 0;
  }

  .info-card__eyebrow {
    display: block;

    color: #9ca199 !important;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .info-card__header strong {
    display: block;

    margin-top: 8px;

    color: var(--white) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 18px;

    font-weight: 900;

    line-height: 0.95;

    letter-spacing: -0.05em;

    text-transform: uppercase;
  }

  .info-card__header > svg {
    flex: 0 0 auto;

    color: var(--acid) !important;
  }

  .stats-list {
    margin-top: 18px;

    border-top: 3px solid rgba(255, 255, 255, 0.17);
  }

  .stats-row {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;

    padding: 12px 0;

    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stats-row span {
    color: #9ea79c !important;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  .stats-row strong {
    color: var(--acid) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 24px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: -0.06em;
  }

  .info-card__title {
    display: flex;

    align-items: center;

    gap: 8px;

    padding-bottom: 12px;

    color: var(--ink) !important;

    border-bottom: 3px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .info-card__title svg {
    color: var(--warning) !important;
  }

  .info-card:not(.info-card--dark) .info-card__title span {
    color: var(--ink) !important;
  }


  /* ==========================================================================
     USAGE LIST
     ========================================================================== */

  .usage-list {
    display: grid;

    gap: 0;

    margin: 0;

    padding: 0;

    list-style: none;
  }

  .usage-list li {
    display: grid;

    grid-template-columns:
      36px
      minmax(0, 1fr);

    align-items: start;

    gap: 11px;

    padding: 14px 0;

    border-bottom: 2px solid var(--paper-3);
  }

  .usage-list li:last-child {
    border-bottom: 0;

    padding-bottom: 0;
  }

  .usage-list li > span {
    display: grid;

    width: 36px;

    height: 36px;

    place-items: center;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 2px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 900;
  }

  .usage-list p {
    margin: 5px 0 0;

    color: var(--muted) !important;

    font-size: 10px;

    line-height: 1.6;
  }


  /* ==========================================================================
     REPORT CARD
     ========================================================================== */

  .report-card {
    display: grid;

    grid-template-columns:
      42px
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 11px;

    min-width: 0;

    padding: 15px;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 3px solid var(--ink);

    box-shadow: 6px 6px 0 var(--warning);

    text-decoration: none;
  }

  .report-card:hover {
    color: var(--ink) !important;

    background: var(--acid-soft) !important;

    transform: translate(-3px, -3px);

    box-shadow: 9px 9px 0 var(--ink);
  }

  .report-card__icon {
    display: grid;

    width: 42px;
    height: 42px;

    place-items: center;

    color: var(--ink) !important;

    background: var(--white) !important;

    border: 2px solid var(--ink);
  }

  .report-card__icon svg {
    color: var(--ink) !important;
  }

  .report-card__content {
    display: grid;

    gap: 5px;

    min-width: 0;
  }

  .report-card__content strong {
    color: var(--ink) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 10px;

    font-weight: 900;

    line-height: 1;

    text-transform: uppercase;
  }

  .report-card__content small {
    color: #51574d !important;

    font-size: 8px;

    line-height: 1.5;
  }

  .report-card > svg {
    flex: 0 0 auto;

    color: var(--ink) !important;
  }


  /* ==========================================================================
     MAP FRAME
     ========================================================================== */

  .map-frame {
    position: relative;

    width: 100%;

    min-width: 0;

    height: 650px;

    overflow: hidden;

    background: #253021;

    border: 4px solid var(--ink);

    box-shadow: 9px 9px 0 var(--warning);
  }

  .map-frame__inner {
    position: absolute;

    inset: 0;

    min-width: 0;
  }

  .map-frame__inner > * {
    width: 100% !important;

    max-width: 100% !important;

    height: 100% !important;
  }

  .map-frame iframe,
  .map-frame canvas,
  .map-frame .leaflet-container,
  .map-frame .maplibregl-map {
    display: block;

    width: 100% !important;

    height: 100% !important;
  }


  /* ==========================================================================
     EMPTY MAP
     ========================================================================== */

  .map-empty {
    display: flex;

    align-items: center;

    justify-content: center;

    flex-direction: column;

    width: 100%;

    height: 100%;

    padding: 30px;

    color: var(--white);

    background:
      linear-gradient(
        rgba(223, 255, 0, 0.09) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(223, 255, 0, 0.09) 2px,
        transparent 2px
      ),
      #253021;

    background-size: 28px 28px;

    text-align: center;
  }

  .map-empty__icon {
    display: grid;

    width: 72px;

    height: 72px;

    place-items: center;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 3px solid var(--ink);

    box-shadow: 7px 7px 0 var(--warning);
  }

  .map-empty__icon svg {
    color: var(--ink) !important;
  }

  .map-empty__label {
    display: block;

    margin-top: 20px;

    color: var(--acid) !important;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  .map-empty h3 {
    margin: 10px 0 0;

    color: var(--white) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 28px;

    font-weight: 900;

    line-height: 0.95;

    letter-spacing: -0.055em;

    text-transform: uppercase;
  }

  .map-empty p {
    max-width: 470px;

    margin: 13px 0 23px;

    color: #d2d5cb !important;

    font-size: 10px;

    line-height: 1.7;
  }


  /* ==========================================================================
     AREA CARDS
     ========================================================================== */

  .area-grid {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 15px;
  }

  .area-card {
    position: relative;

    display: grid;

    grid-template-columns:
      42px
      minmax(0, 1fr)
      32px;

    align-items: center;

    gap: 13px;

    min-width: 0;

    min-height: 96px;

    padding: 15px;

    color: var(--ink) !important;

    background: var(--white) !important;

    border: 3px solid var(--ink);

    box-shadow: 7px 7px 0 var(--ink);

    text-decoration: none;
  }

  .area-card:hover {
    color: var(--ink) !important;

    background: var(--acid) !important;

    transform: translate(-4px, -4px);

    box-shadow: 11px 11px 0 var(--warning);
  }

  .area-card__index {
    display: grid;

    width: 42px;

    height: 42px;

    place-items: center;

    color: var(--acid) !important;

    background: var(--ink) !important;

    border: 2px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 900;
  }

  .area-card__body {
    min-width: 0;

    display: grid;

    gap: 6px;
  }

  .area-card__body strong {
    display: block;

    overflow: hidden;

    color: var(--ink) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 14px;

    font-weight: 900;

    line-height: 1.02;

    letter-spacing: -0.04em;

    text-overflow: ellipsis;

    text-transform: uppercase;

    white-space: nowrap;
  }

  .area-card__body span {
    color: #667066 !important;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  .area-card__arrow {
    position: relative;

    z-index: 2;

    display: grid;

    width: 32px;

    height: 32px;

    place-items: center;

    color: var(--ink) !important;

    background: transparent;

    border: 2px solid var(--ink);
  }

  .area-card__arrow svg {
    color: var(--ink) !important;
  }


  /* ==========================================================================
     TYPE CARDS
     ========================================================================== */

  .type-grid {
    display: grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap: 15px;
  }

  .type-card {
    min-width: 0;

    padding: 19px;

    color: var(--white) !important;

    background: var(--ink) !important;

    border: 3px solid var(--ink);

    box-shadow: 7px 7px 0 var(--acid);
  }

  .type-card__top {
    display: grid;

    grid-template-columns:
      48px
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 12px;
  }

  .type-card__icon {
    display: grid;

    width: 48px;

    height: 48px;

    place-items: center;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 2px solid var(--ink);
  }

  .type-card__icon svg {
    color: var(--ink) !important;
  }

  .type-card__title {
    min-width: 0;

    display: grid;

    gap: 6px;
  }

  .type-card__title strong {
    color: var(--white) !important;

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 13px;

    font-weight: 900;

    line-height: 1.05;

    letter-spacing: -0.035em;

    text-transform: uppercase;
  }

  .type-card__title span {
    color: #a1a99f !important;

    font-family:
      "DM Mono",
