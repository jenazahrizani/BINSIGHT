---
import {
  ArrowRight,
  Building2,
  Map,
  MapPin,
  Recycle,
  SlidersHorizontal,
  TriangleAlert,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

import MapFilter from "@components/map/MapFilter.astro";
import WasteMap from "@components/map/WasteMap.astro";

import {
  getAreas,
  type Area,
  type WasteLocation,
} from "@lib/data/locations";

import {
  getPublicOrganizations,
  type Organization,
} from "@lib/data/organizations";

import * as locationModule from "@lib/data/locations";

/* ==========================================================================
   TYPES
   ========================================================================== */

type LocationDataModule = {
  getLocations?: unknown;
  getPublicLocations?: unknown;
  getActiveLocations?: unknown;

  locations?: unknown;
  wasteLocations?: unknown;
  WASTE_LOCATIONS?: unknown;
  LOCATIONS?: unknown;
};

/* ==========================================================================
   AREAS
   ========================================================================== */

const areas: Area[] = getAreas();

const activeAreas: Area[] = areas.filter(
  (area) => area.status === "active",
);

/* ==========================================================================
   LOCATIONS
   ========================================================================== */

const resolvedLocationModule =
  locationModule as unknown as LocationDataModule;

function normalizeLocations(
  value: unknown,
): WasteLocation[] | null {
  if (!Array.isArray(value)) {
    return null;
  }

  return value as WasteLocation[];
}

function tryLocationGetter(
  getter: unknown,
): WasteLocation[] | null {
  if (typeof getter !== "function") {
    return null;
  }

  try {
    const result =
      (getter as () => unknown)();

    return normalizeLocations(result);
  } catch (error) {
    console.warn(
      "[BINSIGHT] Location getter failed:",
      error,
    );

    return null;
  }
}

function resolveLocations(): WasteLocation[] {
  const getterCandidates: unknown[] = [
    resolvedLocationModule.getLocations,
    resolvedLocationModule.getPublicLocations,
    resolvedLocationModule.getActiveLocations,
  ];

  for (const getter of getterCandidates) {
    const locations =
      tryLocationGetter(getter);

    if (locations) {
      return locations;
    }
  }

  const collectionCandidates: unknown[] = [
    resolvedLocationModule.locations,
    resolvedLocationModule.wasteLocations,
    resolvedLocationModule.WASTE_LOCATIONS,
    resolvedLocationModule.LOCATIONS,
  ];

  for (const collection of collectionCandidates) {
    const locations =
      normalizeLocations(collection);

    if (locations) {
      return [...locations];
    }
  }

  console.warn(
    "[BINSIGHT] No usable location data export was found.",
  );

  return [];
}

const allLocations: WasteLocation[] =
  resolveLocations();

const activeLocations: WasteLocation[] =
  allLocations.filter(
    (location) =>
      location &&
      location.status === "active",
  );

/* ==========================================================================
   ORGANIZATIONS
   ========================================================================== */

const organizations: Organization[] =
  getPublicOrganizations();

/* ==========================================================================
   LOCATION / AREA SUMMARY
   ========================================================================== */

const locationsByArea: Record<
  string,
  number
> = {};

for (const location of activeLocations) {
  if (!location.areaId) {
    continue;
  }

  locationsByArea[location.areaId] =
    (locationsByArea[location.areaId] ?? 0) + 1;
}

const areaSummaries = activeAreas
  .map((area) => ({
    area,
    count:
      locationsByArea[area.id] ?? 0,
  }))
  .sort(
    (first, second) =>
      second.count - first.count,
  );

/* ==========================================================================
   LOCATION TYPE SUMMARY
   ========================================================================== */

const locationTypeLabels: Record<
  string,
  string
> = {
  "collection-point":
    "Titik Pengumpulan",

  "recycling-center":
    "Pusat Daur Ulang",

  "waste-bank":
    "Bank Sampah",

  "processing-facility":
    "Fasilitas Pengolahan",

  "drop-point":
    "Drop Point",

  other:
    "Lokasi Lainnya",
};

const locationTypeCounts: Record<
  string,
  number
> = {};

for (const location of activeLocations) {
  if (!location.type) {
    continue;
  }

  locationTypeCounts[location.type] =
    (locationTypeCounts[location.type] ?? 0) + 1;
}

const locationTypeSummary =
  Object.entries(
    locationTypeCounts,
  )
    .map(([type, count]) => ({
      type,

      label:
        locationTypeLabels[type] ??
        type,

      count,
    }))
    .sort(
      (first, second) =>
        second.count - first.count,
    );

/* ==========================================================================
   METRICS
   ========================================================================== */

const organizationCount =
  organizations.length;

const areaCount =
  activeAreas.length;

const locationCount =
  activeLocations.length;

const locationTypeCount =
  locationTypeSummary.length;

/* ==========================================================================
   PAGE META
   ========================================================================== */

const pageTitle =
  "Peta Persampahan Kabupaten Badung";

const pageDescription =
  "Eksplorasi lokasi pengelolaan sampah, area, dan organisasi terverifikasi di Kabupaten Badung.";
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
>
  <main class="map-page">

    <!-- =====================================================================
         HERO
         ================================================================== -->

    <section
      class="map-hero"
      aria-labelledby="map-hero-title"
    >
      <div class="map-hero__main">

        <div class="map-label">
          <Map
            size={15}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            BINSIGHT · MAP
          </span>
        </div>

        <h1 id="map-hero-title">
          Temukan ekosistem pengelolaan sampah
          di Kabupaten Badung
        </h1>

        <p class="map-hero__description">
          Jelajahi titik pengelolaan sampah berdasarkan
          lokasi, area, dan tipe fasilitas yang tersedia
          di Kabupaten Badung.
        </p>

        <div class="map-hero__actions">

          <a
            href="#explore-map"
            class="button button--primary"
            aria-label="Eksplorasi peta BINSIGHT"
          >
            <MapPin
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Eksplorasi peta
            </span>

            <ArrowRight
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>

          <a
            href="/reports/create"
            class="button button--secondary"
            aria-label="Buat laporan"
          >
            <TriangleAlert
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Buat laporan
            </span>
          </a>

        </div>

      </div>

      <!-- HERO METRICS -->

      <div
        class="map-hero__stats"
        aria-label="Ringkasan data peta"
      >

        <div class="hero-stat">

          <span class="hero-stat__icon">
            <MapPin
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <div>
            <strong>
              {locationCount}
            </strong>

            <span>
              Lokasi aktif
            </span>
          </div>

        </div>

        <div class="hero-stat">

          <span class="hero-stat__icon">
            <Building2
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <div>
            <strong>
              {organizationCount}
            </strong>

            <span>
              Organisasi
            </span>
          </div>

        </div>

        <div class="hero-stat">

          <span class="hero-stat__icon">
            <Map
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />
          </span>

          <div>
            <strong>
              {areaCount}
            </strong>

            <span>
              Area aktif
            </span>
          </div>

        </div>

      </div>
    </section>

    <!-- =====================================================================
         EXPLORER
         ================================================================== -->

    <section
      id="explore-map"
      class="content-section explorer-section"
      aria-labelledby="explorer-title"
    >

      <div class="section-header">

        <div class="section-header__content">

          <span class="section-kicker">
            Eksplorasi
          </span>

          <h2 id="explorer-title">
            Peta lokasi pengelolaan
          </h2>

          <p>
            Cari dan jelajahi lokasi pengelolaan sampah
            yang tersedia di Kabupaten Badung.
          </p>

        </div>

        <div
          class="section-counter"
          aria-label={`${locationCount} lokasi aktif`}
        >
          <strong>
            {locationCount}
          </strong>

          <span>
            lokasi aktif
          </span>
        </div>

      </div>

      <!-- FILTER TOOLBAR -->

      <div class="map-toolbar">

        <button
          type="button"
          class="filter-button"
          id="map-filter-toggle"
          aria-expanded="false"
          aria-controls="map-filter-panel"
        >
          <SlidersHorizontal
            size={15}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>
            Filter area
          </span>
        </button>

      </div>

      <!-- FILTER -->

      <div
        id="map-filter-panel"
        class="filter-panel"
        aria-hidden="true"
      >

        <div class="filter-panel__header">

          <div>

            <span class="section-kicker section-kicker--dark">
              Wilayah
            </span>

            <h3>
              Pilih kecamatan / area
            </h3>

          </div>

          <span class="filter-panel__count">
            {areaCount} area aktif
          </span>

        </div>

        <MapFilter
          areas={activeAreas}
        />

      </div>

      <!-- MAP -->

      <div class="map-shell">

        <aside
          class="map-sidebar"
          aria-label="Informasi peta"
        >

          <!-- COVERAGE -->

          <div class="info-card info-card--dark">

            <div class="info-card__header">

              <div>
                <span class="info-card__eyebrow">
                  Cakupan
                </span>

                <strong>
                  Kabupaten Badung
                </strong>
              </div>

              <Map
                size={19}
                stroke-width={1.9}
                aria-hidden="true"
              />

            </div>

            <div class="stats-list">

              <div class="stats-row">
                <span>
                  Lokasi aktif
                </span>

                <strong>
                  {locationCount}
                </strong>
              </div>

              <div class="stats-row">
                <span>
                  Area aktif
                </span>

                <strong>
                  {areaCount}
                </strong>
              </div>

              <div class="stats-row">
                <span>
                  Jenis lokasi
                </span>

                <strong>
                  {locationTypeCount}
                </strong>
              </div>

            </div>

          </div>

          <!-- HOW TO -->

          <div class="info-card">

            <div class="info-card__title">

              <SlidersHorizontal
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>
                Cara menggunakan peta
              </span>

            </div>

            <ol class="usage-list">

              <li>

                <span>01</span>

                <p>
                  Pilih area untuk mempersempit
                  lokasi yang ditampilkan.
                </p>

              </li>

              <li>

                <span>02</span>

                <p>
                  Gunakan pencarian untuk menemukan
                  lokasi tertentu.
                </p>

              </li>

              <li>

                <span>03</span>

                <p>
                  Buka detail lokasi untuk mengetahui
                  pengelolaan dan organisasi terkait.
                </p>

              </li>

            </ol>

          </div>

          <!-- REPORT -->

          <a
            href="/reports/create"
            class="report-card"
          >

            <span class="report-card__icon">
              <TriangleAlert
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </span>

            <span class="report-card__content">

              <strong>
                Temukan masalah?
              </strong>

              <small>
                Kirim laporan dari lapangan.
              </small>

            </span>

            <ArrowRight
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />

          </a>

        </aside>

        <!-- MAP FRAME -->

        <div class="map-frame">

          {
            activeLocations.length > 0 ? (
              <div class="map-frame__inner">
                <WasteMap
                  locations={activeLocations}
                />
              </div>
            ) : (
              <div class="map-empty">

                <div class="map-empty__icon">
                  <MapPin
                    size={28}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>

                <span class="map-empty__label">
                  Data lokasi
                </span>

                <h3>
                  Belum tersedia
                </h3>

                <p>
                  Belum ada lokasi pengelolaan sampah
                  aktif yang dapat ditampilkan pada peta.
                </p>

                <a
                  href="/reports/create"
                  class="button button--primary"
                >
                  Tambahkan informasi
                </a>

              </div>
            )
          }

        </div>

      </div>

    </section>

    <!-- =====================================================================
         AREAS
         ================================================================== -->

    <section
      class="content-section"
      aria-labelledby="areas-title"
    >

      <div class="section-header">

        <div class="section-header__content">

          <span class="section-kicker">
            Area
          </span>

          <h2 id="areas-title">
            Jelajahi berdasarkan wilayah
          </h2>

          <p>
            Pilih area untuk melihat lokasi pengelolaan
            yang tersedia di dalamnya.
          </p>

        </div>

        <a
          href="/map"
          class="text-action"
        >
          <span>
            Lihat peta utama
          </span>

          <ArrowRight
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />
        </a>

      </div>

      {
        areaSummaries.length > 0 ? (
          <div class="area-grid">

            {areaSummaries.map(
              ({ area, count }, index) => (
                <a
                  class="area-card"
                  href={`/map/${area.slug}`}
                  data-area-card
                  aria-label={`${area.name}, ${count} lokasi aktif`}
                >

                  <span class="area-card__index">
                    {String(index + 1).padStart(
                      2,
                      "0",
                    )}
                  </span>

                  <div class="area-card__body">

                    <strong>
                      {area.name}
                    </strong>

                    <span>
                      {count} lokasi aktif
                    </span>

                  </div>

                  <span class="area-card__arrow">
                    <ArrowRight
                      size={16}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </span>

                </a>
              ),
            )}

          </div>
        ) : (
          <div class="empty-panel">

            <Map
              size={26}
              stroke-width={1.8}
              aria-hidden="true"
            />

            <h3>
              Belum ada area aktif
            </h3>

            <p>
              Belum terdapat area aktif yang dapat
              ditampilkan pada peta.
            </p>

          </div>
        )
      }

    </section>

    <!-- =====================================================================
         TYPES
         ================================================================== -->

    {
      locationTypeSummary.length > 0 && (
        <section
          class="content-section"
          aria-labelledby="types-title"
        >

          <div
            class="section-header section-header--single"
          >

            <div class="section-header__content">

              <span class="section-kicker">
                Jenis lokasi
              </span>

              <h2 id="types-title">
                Distribusi titik pengelolaan
              </h2>

              <p>
                Ringkasan tipe lokasi yang saat ini
                tercatat aktif.
              </p>

            </div>

          </div>

          <div class="type-grid">

            {locationTypeSummary.map(
              ({
                label,
                count,
                type,
              }) => {
                const percentage =
                  locationCount > 0
                    ? Math.round(
                        (count /
                          locationCount) *
                          100,
                      )
                    : 0;

                const barWidth =
                  percentage > 0
                    ? Math.max(
                        percentage,
                        8,
                      )
                    : 0;

                return (
                  <article
                    class="type-card"
                    data-location-card
                  >

                    <div class="type-card__top">

                      <div class="type-card__icon">
                        <Recycle
                          size={18}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </div>

                      <div class="type-card__title">

                        <strong>
                          {label}
                        </strong>

                        <span>
                          {count} lokasi
                        </span>

                      </div>

                      <span class="type-card__percentage">
                        {percentage}%
                      </span>

                    </div>

                    <div
                      class="type-card__bar"
                      aria-hidden="true"
                    >
                      <span
                        style={`width:${barWidth}%`}
                      />
                    </div>

                    <div class="type-card__footer">

                      <span>
                        {type}
                      </span>

                      <span>
                        {percentage}% dari lokasi aktif
                      </span>

                    </div>

                  </article>
                );
              },
            )}

          </div>

        </section>
      )
    }

    <!-- =====================================================================
         CTA
         ================================================================== -->

    <section
      class="map-cta"
      aria-labelledby="map-cta-title"
    >

      <div class="map-cta__mark">
        <TriangleAlert
          size={22}
          stroke-width={2}
          aria-hidden="true"
        />
      </div>

      <div class="map-cta__content">

        <span class="map-cta__eyebrow">
          Kontribusi masyarakat
        </span>

        <h2 id="map-cta-title">
          Tidak menemukan informasi yang kamu cari?
        </h2>

        <p>
          Bantu BINSIGHT memperkaya data persampahan
          dengan memberikan informasi atau membuat
          laporan dari lapangan.
        </p>

      </div>

      <a
        href="/reports/create"
        class="map-cta__button"
      >
        <span>
          Buat laporan
        </span>

        <ArrowRight
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />
      </a>

    </section>

  </main>
</PublicLayout>

<script>
  /* ==========================================================================
     FILTER TOGGLE
     ========================================================================== */

  const initializeMapFilterToggle =
    () => {
      const filterToggle =
        document.querySelector<HTMLButtonElement>(
          "#map-filter-toggle",
        );

      const filterPanel =
        document.querySelector<HTMLElement>(
          "#map-filter-panel",
        );

      if (
        !filterToggle ||
        !filterPanel
      ) {
        return;
      }

      /*
       * Prevent duplicate listeners
       * during Astro page transitions.
       */
      if (
        filterToggle.dataset.initialized ===
        "true"
      ) {
        return;
      }

      filterToggle.dataset.initialized =
        "true";

      const openFilterPanel = () => {
        filterToggle.setAttribute(
          "aria-expanded",
          "true",
        );

        filterPanel.toggleAttribute(
          "data-open",
          true,
        );

        filterPanel.setAttribute(
          "aria-hidden",
          "false",
        );
      };

      const closeFilterPanel = () => {
        filterToggle.setAttribute(
          "aria-expanded",
          "false",
        );

        filterPanel.removeAttribute(
          "data-open",
        );

        filterPanel.setAttribute(
          "aria-hidden",
          "true",
        );
      };

      filterToggle.addEventListener(
        "click",
        (event) => {
          event.preventDefault();

          const isExpanded =
            filterToggle.getAttribute(
              "aria-expanded",
            ) === "true";

          if (isExpanded) {
            closeFilterPanel();
          } else {
            openFilterPanel();
          }
        },
      );
    };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeMapFilterToggle,
      {
        once: true,
      },
    );
  } else {
    initializeMapFilterToggle();
  }

  document.addEventListener(
    "astro:page-load",
    initializeMapFilterToggle,
  );
</script>

<style>
  /* ==========================================================================
     BINSIGHT MAP
     ========================================================================== */

  .map-page,
  .map-page *,
  .map-page *::before,
  .map-page *::after {
    box-sizing: border-box;
  }

  .map-page {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;

    --white: #fffef8;
    --muted: #6c7068;

    --warning: #ff6a00;

    width: 100%;
    min-width: 0;

    padding-bottom: 110px;

    color: var(--ink);

    background:
      repeating-linear-gradient(
        135deg,
        rgba(9, 10, 8, 0.025) 0 1px,
        transparent 1px 9px
      ),
      var(--paper);

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .map-page > * {
    width: min(
      1320px,
      calc(100% - 40px)
    );

    margin-inline: auto;
  }

  .map-page h1,
  .map-page h2,
  .map-page h3,
  .map-page p {
    overflow-wrap: anywhere;
  }

  .map-page a {
    color: inherit;
  }

  .map-page button,
  .map-page input {
    font: inherit;
  }

  .map-page svg {
    flex: 0 0 auto;
  }

  /* ==========================================================================
     LABELS
     ========================================================================== */

  .map-page .map-label {
    display: inline-flex;

    align-items: center;
    gap: 8px;

    width: fit-content;

    min-height: 30px;

    padding: 7px 10px;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 3px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;
    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .map-page .map-label span {
    color: var(--ink) !important;
  }

  .map-page .map-label svg {
    color: var(--ink) !important;
    stroke: var(--ink) !important;
  }

  .map-page .section-kicker {
    display: inline-flex;

    align-items: center;
    gap: 8px;

    width: fit-content;

    min-height: 27px;

    padding: 6px 9px;

    color: var(--ink) !important;

    background: var(--acid) !important;

    border: 3px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;
    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .map-page .section-kicker span {
    color: var(--ink) !important;
  }

  /* ==========================================================================
     BUTTONS
     ========================================================================== */

  .map-page .button {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    min-height: 52px;

    padding: 0 18px;

    border: 3px solid currentColor;

    border-radius: 0;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 9px;

    font-weight: 900;

    line-height: 1;

    letter-spacing: 0.07em;

    text-decoration: none;

    text-transform: uppercase;
  }

  .map-page a.button.button--primary {
    color: var(--ink) !important;

    background: var(--acid) !important;

