  /* ==========================================================================
     SECTION COMMON
     ========================================================================== */

  .map-section,
  .overview-section,
  .distribution-section,
  .organizations-section {
    padding:
      5rem 0;

    border-bottom:
      1px solid var(--line);
  }

  .section-heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    gap:
      2rem;

    align-items:
      end;

    margin-bottom:
      2rem;
  }

  .section-heading--stacked {
    grid-template-columns:
      minmax(0, 1fr);
  }

  .section-heading > div {
    min-width: 0;
  }

  .section-kicker {
    display: block;

    margin-bottom:
      0.5rem;

    color:
      var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.58rem;

    font-weight:
      700;

    letter-spacing:
      0.09em;
  }

  .section-heading h2 {
    margin: 0;

    color:
      var(--ink);

    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;

    font-size:
      clamp(
        2rem,
        4vw,
        3.2rem
      );

    font-weight:
      900;

    line-height:
      0.96;

    letter-spacing:
      -0.055em;

