---
import {
  ArrowLeft,
  Building2,
  MapPin,
  Recycle,
  Route,
  Search,
  TriangleAlert,
} from "@lucide/astro";

import MapFilter from "@components/map/MapFilter.astro";
import WasteMap from "@components/map/WasteMap.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import PublicLayout from "@layouts/PublicLayout.astro";

import {
  getAreas,
  type Area,
  type WasteLocation,
} from "@lib/data/locations";

import {
  getPublicOrganizations,
  type Organization,
} from "@lib/data/organizations";

import {
  getReports,
  type Report,
} from "@lib/data/reports";

import * as locationData from "@lib/data/locations";

const { area: areaSlug } = Astro.params;

/* ============================================================================
   AREA
   ========================================================================== */

const areas: Area[] = getAreas();

const activeAreas = areas.filter(
  (item) => item.status === "active",
);

const area = activeAreas.find(
  (item) => item.slug === areaSlug,
);

if (!area) {
  return Astro.redirect("/map");
}

/* ============================================================================
   LOCATION COMPATIBILITY
   ========================================================================== */

type LocationModuleCompatibility = {
  getLocations?: () => WasteLocation[];
  getPublicLocations?: () => WasteLocation[];
  getActiveLocations?: () => WasteLocation[];

  locations?: readonly WasteLocation[];
  wasteLocations?: readonly WasteLocation[];
  WASTE_LOCATIONS?: readonly WasteLocation[];
  LOCATIONS?: readonly WasteLocation[];
};

const compatibleLocationModule =
  locationData as unknown as LocationModuleCompatibility;

function getLocationCandidates(): WasteLocation[] {
  const getterCandidates = [
    compatibleLocationModule.getLocations,
    compatibleLocationModule.getPublicLocations,
    compatibleLocationModule.getActiveLocations,
  ];

  for (const getter of getterCandidates) {
    if (typeof getter !== "function") {
      continue;
    }

    const value = getter();

    if (Array.isArray(value)) {
      return value;
    }
  }

  const arrayCandidates = [
    compatibleLocationModule.locations,
    compatibleLocationModule.wasteLocations,
    compatibleLocationModule.WASTE_LOCATIONS,
    compatibleLocationModule.LOCATIONS,
  ];

  for (const value of arrayCandidates) {
    if (Array.isArray(value)) {
      return [...value];
    }
  }

  return [];
}

const allLocations = getLocationCandidates();

/* ============================================================================
   ORGANIZATIONS
   ========================================================================== */

const organizations: Organization[] =
  getPublicOrganizations();

const areaOrganizations =
  organizations.filter((organization) => {
    if (!organization.isPublic) {
      return false;
    }

    if (organization.status !== "verified") {
      return false;
    }

    return (
      organization.location?.area === area.name
    );
  });

/* ============================================================================
   LOCATIONS
   ========================================================================== */

const areaLocations: WasteLocation[] =
  allLocations.filter(
    (location) =>
      location.status === "active" &&
      location.areaId === area.id,
  );

/* ============================================================================
   REPORTS
   ========================================================================== */

const reports: Report[] = getReports();

const areaReports = reports.filter(
  (report) =>
    report.location.areaId === area.id &&
    report.status !== "rejected",
);

/* ============================================================================
   LOCATION TYPES
   ========================================================================== */

const locationTypeLabels: Record<string, string> = {
  "collection-point": "Titik Pengumpulan",
  "recycling-center": "Pusat Daur Ulang",
  "waste-bank": "Bank Sampah",
  "processing-facility": "Fasilitas Pengolahan",
  "drop-point": "Drop Point",
  other: "Lokasi Lainnya",
};

const locationTypeCounts: Record<string, number> = {};

for (const location of areaLocations) {
  locationTypeCounts[location.type] =
    (locationTypeCounts[location.type] ?? 0) + 1;
}

const topLocationTypes = Object.entries(
  locationTypeCounts,
)
  .sort(
    (firstEntry, secondEntry) =>
      secondEntry[1] - firstEntry[1],
  )
  .slice(0, 5);

/* ============================================================================
   PAGE META
   ========================================================================== */

const breadcrumbItems = [
  {
    label: "Beranda",
    href: "/",
  },
  {
    label: "Peta",
    href: "/map",
  },
  {
    label: area.name,
  },
];

const pageTitle =
  `Peta Pengelolaan Sampah ${area.name}`;

const pageDescription =
  area.description ||
  `Jelajahi lokasi pengelolaan sampah dan informasi lingkungan di ${area.name}, Kabupaten Badung.`;
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
>
  <PageHeader
    title={pageTitle}
    description={pageDescription}
    breadcrumbs={breadcrumbItems}
    icon="map"
    eyebrow="BINSIGHT · AREA"
    tone="green"
  />

  <main class="area-page">
    <!-- =====================================================================
         AREA HERO
         ================================================================== -->

    <section
      class="area-hero"
      aria-labelledby="area-title"
    >
      <div class="area-hero__content">
        <a
          href="/map"
          class="back-link"
        >
          <ArrowLeft
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>Kembali ke Peta Badung</span>
        </a>

        <div class="area-label">
          <MapPin
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>Kecamatan / Area</span>
        </div>

        <h1 id="area-title">
          {area.name}
        </h1>

        <p class="area-hero__description">
          {area.description ||
            `Jelajahi ekosistem pengelolaan sampah yang tercatat di ${area.name}.`}
        </p>

        <div
          class="area-stats"
          aria-label="Ringkasan area"
        >
          <div class="area-stat">
            <span class="area-stat__icon">
              <MapPin
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </span>

            <span class="area-stat__content">
              <strong>
                {areaLocations.length}
              </strong>

              <small>Lokasi aktif</small>
            </span>
          </div>

          <div class="area-stat">
            <span class="area-stat__icon">
              <Building2
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </span>

            <span class="area-stat__content">
              <strong>
                {areaOrganizations.length}
              </strong>

              <small>Organisasi</small>
            </span>
          </div>

          <div class="area-stat">
            <span class="area-stat__icon">
              <TriangleAlert
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </span>

            <span class="area-stat__content">
              <strong>
                {areaReports.length}
              </strong>

              <small>Laporan</small>
            </span>
          </div>
        </div>
      </div>

      <div
        class="area-hero__visual"
        aria-hidden="true"
      >
        <div class="visual-grid"></div>

        <div class="visual-ring visual-ring--outer"></div>
        <div class="visual-ring visual-ring--middle"></div>
        <div class="visual-ring visual-ring--inner"></div>

        <div class="visual-cross visual-cross--one"></div>
        <div class="visual-cross visual-cross--two"></div>

        <div class="visual-marker">
          <MapPin
            size={32}
            stroke-width={1.7}
          />
        </div>

        <div class="visual-dot visual-dot--one"></div>
        <div class="visual-dot visual-dot--two"></div>
        <div class="visual-dot visual-dot--three"></div>
      </div>
    </section>

    <!-- =====================================================================
         MAP
         ================================================================== -->

    <section
      class="map-section"
      aria-labelledby="map-section-title"
    >
      <div class="section-heading">
        <div class="section-heading__content">
          <span class="section-eyebrow">
            Peta area
          </span>

          <h2 id="map-section-title">
            Eksplorasi {area.name}
          </h2>

          <p>
            Lihat titik pengelolaan sampah aktif yang
            tersedia di area ini.
          </p>
        </div>

        <a
          href={`/reports/create?area=${encodeURIComponent(area.slug)}`}
          class="section-action"
        >
          <TriangleAlert
            size={17}
            stroke-width={2}
            aria-hidden="true"
          />

          <span>Laporkan masalah</span>
        </a>
      </div>

      <div class="map-toolbar">
        <label
          class="search-box"
          for="area-location-search"
        >
          <Search
            size={18}
            stroke-width={2}
            aria-hidden="true"
          />

          <input
            id="area-location-search"
            type="search"
            placeholder={`Cari lokasi di ${area.name}...`}
            autocomplete="off"
          />
        </label>

        <div
          class="map-count"
          aria-label={`${areaLocations.length} lokasi aktif`}
        >
          <strong>
            {areaLocations.length}
          </strong>

          <span>lokasi aktif</span>
        </div>
      </div>

      <div class="map-layout">
        <aside
          class="map-sidebar"
          aria-label="Filter dan informasi area"
        >
          <div class="filter-card">
            <div class="filter-card__header">
              <div>
                <span class="filter-card__eyebrow">
                  Wilayah
                </span>

                <strong>
                  Area Badung
                </strong>
              </div>

              <MapPin
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <MapFilter areas={activeAreas} />
          </div>

          <div class="sidebar-note">
            <div class="sidebar-note__icon">
              <Route
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="sidebar-note__body">
              <strong>
                Jelajahi area lain
              </strong>

              <p>
                Bandingkan data lokasi antar area di
                Kabupaten Badung.
              </p>
            </div>

            <a href="/map">
              <span>Lihat semua area</span>

              <ArrowLeft
                size={15}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </div>
        </aside>

        <div class="map-container">
          {
            areaLocations.length > 0 ? (
              <WasteMap
                locations={areaLocations}
              />
            ) : (
              <div class="map-empty">
                <div class="map-empty__icon">
                  <MapPin
                    size={28}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>

                <h3>
                  Belum ada lokasi di area ini
                </h3>

                <p>
                  Belum terdapat lokasi pengelolaan
                  sampah aktif yang tersedia untuk
                  ditampilkan pada area{" "}
                  {area.name}.
                </p>

                <a href="/reports/create">
                  Laporkan informasi
                </a>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- =====================================================================
         OVERVIEW
         ================================================================== -->

    <section
      class="overview-section"
      aria-labelledby="overview-title"
    >
      <div class="section-heading section-heading--compact">
        <div class="section-heading__content">
          <span class="section-eyebrow">
            Ringkasan
          </span>

          <h2 id="overview-title">
            Data {area.name}
          </h2>

          <p>
            Ikhtisar informasi yang tercatat pada
            BINSIGHT untuk area ini.
          </p>
        </div>
      </div>

      <div class="overview-grid">
        <article class="overview-card">
          <div class="overview-card__top">
            <div class="overview-card__icon">
              <MapPin
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <span>
              01
            </span>
          </div>

          <span class="overview-card__label">
            Lokasi aktif
          </span>

          <strong>
            {areaLocations.length}
          </strong>

          <p>
            Titik pengelolaan sampah yang saat ini
            tercatat aktif.
          </p>
        </article>

        <article class="overview-card">
          <div class="overview-card__top">
            <div class="overview-card__icon">
              <Building2
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <span>
              02
            </span>
          </div>

          <span class="overview-card__label">
            Organisasi
          </span>

          <strong>
            {areaOrganizations.length}
          </strong>

          <p>
            Organisasi terverifikasi yang tersedia
            pada area ini.
          </p>
        </article>

        <article class="overview-card">
          <div class="overview-card__top">
            <div class="overview-card__icon">
              <TriangleAlert
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <span>
              03
            </span>
          </div>

          <span class="overview-card__label">
            Laporan
          </span>

          <strong>
            {areaReports.length}
          </strong>

          <p>
            Laporan yang terkait dengan lokasi pada
            area ini.
          </p>
        </article>
      </div>
    </section>

    <!-- =====================================================================
         DISTRIBUTION
         ================================================================== -->

    {
      topLocationTypes.length > 0 && (
        <section
          class="distribution-section"
          aria-labelledby="distribution-title"
        >
          <div class="section-heading section-heading--compact">
            <div class="section-heading__content">
              <span class="section-eyebrow">
                Distribusi
              </span>

              <h2 id="distribution-title">
                Jenis lokasi pengelolaan
              </h2>

              <p>
                Distribusi berdasarkan tipe lokasi yang
                tercatat di area ini.
              </p>
            </div>
          </div>

          <div class="distribution-grid">
            {topLocationTypes.map(
              ([type, count], index) => {
                const percentage =
                  areaLocations.length > 0
                    ? Math.round(
                        (count /
                          areaLocations.length) *
                          100,
                      )
                    : 0;

                const width =
                  count > 0
                    ? Math.max(
                        percentage,
                        8,
                      )
                    : 0;

                return (
                  <article class="distribution-card">
                    <div class="distribution-card__number">
                      {String(index + 1).padStart(
                        2,
                        "0",
                      )}
                    </div>

                    <div class="distribution-card__main">
                      <div class="distribution-card__top">
                        <div class="distribution-card__icon">
                          <Recycle
                            size={19}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        </div>

                        <div class="distribution-card__text">
                          <strong>
                            {locationTypeLabels[
                              type
                            ] ?? type}
                          </strong>

                          <span>
                            {count} lokasi
                          </span>
                        </div>
                      </div>

                      <div
                        class="distribution-bar"
                        aria-hidden="true"
                      >
                        <span
                          style={`width:${width}%`}
                        ></span>
                      </div>

                      <small>
                        {percentage}% dari seluruh
                        lokasi
                      </small>
                    </div>
                  </article>
                );
              },
            )}
          </div>
        </section>
      )
    }

    <!-- =====================================================================
         ORGANIZATIONS
         ================================================================== -->

    <section
      class="organizations-section"
      aria-labelledby="organizations-title"
    >
      <div class="section-heading">
        <div class="section-heading__content">
          <span class="section-eyebrow">
            Organisasi
          </span>

          <h2 id="organizations-title">
            Organisasi terverifikasi
          </h2>

          <p>
            Organisasi yang tercatat berada di{" "}
            {area.name}.
          </p>
        </div>

        <a
          href="/organizations"
          class="section-action section-action--secondary"
        >
          <span>Lihat semua</span>

          <ArrowLeft
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />
        </a>
      </div>

      {
        areaOrganizations.length > 0 ? (
          <div class="organization-grid">
            {areaOrganizations
              .slice(0, 6)
              .map((organization) => (
                <a
                  class="organization-card"
                  href={`/organizations/${organization.slug}`}
                >
                  <div class="organization-card__icon">
                    <Building2
                      size={20}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="organization-card__body">
                    <strong>
                      {organization.name}
                    </strong>

                    <span>
                      {organization.location?.address ||
                        organization.location?.area ||
                        area.name}
                    </span>
                  </div>

                  <ArrowLeft
                    class="organization-card__arrow"
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>
              ))}
          </div>
        ) : (
          <div class="empty-panel">
            <Building2
              size={26}
              stroke-width={1.8}
              aria-hidden="true"
            />

            <h3>
              Belum ada organisasi terverifikasi
            </h3>

            <p>
              Belum ada organisasi terverifikasi yang
              tercatat untuk area ini.
            </p>
          </div>
        )
      }
    </section>

    <!-- =====================================================================
         CTA
         ================================================================== -->

    <section
      class="area-cta"
      aria-labelledby="area-cta-title"
    >
      <div class="area-cta__icon">
        <TriangleAlert
          size={23}
          stroke-width={2}
          aria-hidden="true"
        />
      </div>

      <div class="area-cta__content">
        <span>
          Kontribusi masyarakat
        </span>

        <h2 id="area-cta-title">
          Punya informasi tentang area ini?
        </h2>

        <p>
          Bantu memperkaya BINSIGHT dengan melaporkan
          lokasi atau masalah persampahan yang kamu
          temukan.
        </p>
      </div>

      <a
        href={`/reports/create?area=${encodeURIComponent(area.slug)}`}
        class="area-cta__button"
      >
        <span>Buat laporan</span>

        <ArrowLeft
          size={17}
          stroke-width={2}
          aria-hidden="true"
        />
      </a>
    </section>
  </main>
</PublicLayout>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>(
      "#area-location-search",
    );

  if (searchInput) {
    searchInput.addEventListener(
      "input",
      () => {
        const query =
          searchInput.value.trim().toLowerCase();

        const locationElements =
          document.querySelectorAll<HTMLElement>(
            "[data-map-location], [data-location-card]",
          );

        locationElements.forEach((element) => {
          const text =
            element.textContent?.toLowerCase() ?? "";

          element.hidden =
            query.length > 0 &&
            !text.includes(query);
        });
      },
    );
  }
</script>

<style>
  /* ==========================================================================
     BINSIGHT // AREA PAGE
     Editorial environmental intelligence
     Brutalist / hard-edge interface
     ========================================================================== */

  .area-page,
  .area-page *,
  .area-page *::before,
  .area-page *::after {
    box-sizing: border-box;
  }

  .area-page {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;

    --white: #fffef8;
    --muted: #6c7068;

    --warning: #ff6a00;

    width: min(
      1320px,
      calc(100% - 40px)
    );

    margin-inline: auto;

    padding-bottom: 110px;

    color: var(--ink);

    overflow: visible;
  }

  .area-page img,
  .area-page svg {
    max-width: 100%;
  }

  .area-page input,
  .area-page button {
    font: inherit;
  }

  .area-page section {
    position: relative;
    min-width: 0;
  }

  .area-page h1,
  .area-page h2,
  .area-page h3,
  .area-page p {
    overflow-wrap: anywhere;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .area-hero {
    display: grid;

    grid-template-columns:
      minmax(0, 1.3fr)
      minmax(310px, 0.7fr);

    min-width: 0;

    margin-top: 34px;

    overflow: hidden;

    background: var(--ink);

    border: 4px solid var(--white);

    box-shadow:
      15px 15px 0 var(--warning);
  }

  .area-hero__content {
    position: relative;
    z-index: 1;

    min-width: 0;

    padding: clamp(
      32px,
      5vw,
      56px
    );

    color: var(--white);

    background:
      linear-gradient(
        rgba(255, 255, 255, 0.045) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.045) 2px,
        transparent 2px
      ),
      var(--ink);

    background-size: 30px 30px;
  }

  .back-link {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    min-height: 36px;

    padding-inline: 9px;

    color: var(--ink);

    background: var(--acid);

    border: 2px solid var(--ink);

    box-shadow:
      4px 4px 0 var(--white);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.06em;

    text-decoration: none;

    text-transform: uppercase;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }

  .back-link:hover {
    transform:
      translate(-2px, -2px);

    box-shadow:
      6px 6px 0 var(--warning);
  }

  .area-label {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-top: 28px;

    padding: 6px 8px;

    color: var(--ink);

    background: var(--acid);

    border: 2px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.09em;

    text-transform: uppercase;
  }

  .area-hero h1 {
    max-width: 850px;

    margin: 20px 0 0;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(
        48px,
        6.5vw,
        90px
      );

    font-weight: 900;

    line-height: 0.86;

    letter-spacing: -0.085em;

    text-transform: uppercase;
  }

  .area-hero__description {
    max-width: 720px;

    margin: 28px 0 0;

    padding-left: 15px;

    color: #d1d4cb;

    border-left:
      7px solid var(--acid);

    font-size: 13px;

    line-height: 1.75;
  }

  .area-stats {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 10px;

    max-width: 780px;

    margin-top: 30px;
  }

  .area-stat {
    display: grid;

    grid-template-columns:
      42px minmax(0, 1fr);

    align-items: center;

    gap: 10px;

    min-width: 0;

    padding: 12px;

    color: var(--white);

    background:
      rgba(255, 255, 255, 0.045);

    border: 2px solid
      rgba(255, 255, 255, 0.25);
  }

  .area-stat__icon {
    display: grid;

    width: 42px;
    height: 42px;

    place-items: center;

    color: var(--ink);

    background: var(--acid);

    border: 2px solid var(--ink);

    transform: rotate(-3deg);
  }

  .area-stat__content {
    min-width: 0;

    display: grid;

    gap: 4px;
  }

  .area-stat__content strong {
    color: var(--white);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 25px;
    font-weight: 900;

    line-height: 0.9;

    letter-spacing: -0.05em;
  }

  .area-stat__content small {
    color: #bfc2b9;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 900;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  /* ==========================================================================
     HERO VISUAL
     ========================================================================== */

  .area-hero__visual {
    position: relative;

    min-width: 0;
    min-height: 340px;

    overflow: hidden;

    background:
      linear-gradient(
        rgba(223, 255, 0, 0.07) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(223, 255, 0, 0.07) 2px,
        transparent 2px
      ),
      #20271b;

    background-size: 28px 28px;

    border-left:
      4px solid var(--white);
  }

  .visual-grid {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        transparent 49.5%,
        rgba(223, 255, 0, 0.2) 50%,
        transparent 50.5%
      ),
      linear-gradient(
        transparent 49.5%,
        rgba(223, 255, 0, 0.2) 50%,
        transparent 50.5%
      );

    background-size:
      90px 90px;

    opacity: 0.45;
  }

  .visual-ring {
    position: absolute;

    border:
      2px solid rgba(
        223,
        255,
        0,
        0.24
      );

    border-radius: 50%;

    transform:
      translate(-50%, -50%);
  }

  .visual-ring--outer {
    top: 50%;
    left: 50%;

    width: 280px;
    height: 280px;
  }

  .visual-ring--middle {
    top: 50%;
    left: 50%;

    width: 190px;
    height: 190px;
  }

  .visual-ring--inner {
    top: 50%;
    left: 50%;

    width: 110px;
    height: 110px;

    border-color:
      rgba(255, 255, 255, 0.3);
  }

  .visual-marker {
    position: absolute;

    top: 50%;
    left: 50%;

    display: grid;

    width: 76px;
    height: 76px;

    place-items: center;

    color: var(--ink);

    background: var(--acid);

    border: 3px solid var(--ink);

    box-shadow:
      8px 8px 0 var(--warning);

    transform:
      translate(-50%, -50%) rotate(-3deg);
  }

  .visual-dot {
    position: absolute;

    width: 9px;
    height: 9px;

    background: var(--acid);

    border: 2px solid var(--ink);

    box-shadow:
      0 0 0 5px
      rgba(223, 255, 0, 0.12);
  }

  .visual-dot--one {
    top: 22%;
    left: 22%;
  }

  .visual-dot--two {
    top: 28%;
    right: 19%;
  }

  .visual-dot--three {
    right: 25%;
    bottom: 20%;
  }

  .visual-cross {
    position: absolute;

    width: 22px;
    height: 22px;
  }

  .visual-cross::before,
  .visual-cross::after {
    position: absolute;

    content: "";

    background: var(--warning);
  }

  .visual-cross::before {
    top: 10px;
    left: 0;

    width: 22px;
    height: 2px;
  }

  .visual-cross::after {
    top: 0;
    left: 10px;

    width: 2px;
    height: 22px;
  }

  .visual-cross--one {
    top: 16%;
    right: 16%;
  }

  .visual-cross--two {
    bottom: 16%;
    left: 17%;
  }

  /* ==========================================================================
     SECTION HEADINGS
     ========================================================================== */

  .map-section,
  .overview-section,
  .distribution-section,
  .organizations-section {
    margin-top: 118px;
  }

  .section-heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: end;

    gap: 30px;

    margin-bottom: 28px;
  }

  .section-heading--compact {
    grid-template-columns:
      minmax(0, 1fr);
  }

  .section-heading__content {
    min-width: 0;
  }

  .section-eyebrow {
    padding: 6px 8px;

    color: var(--ink);

    background: var(--acid);

    border: 2px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.09em;

    text-transform: uppercase;
  }

  .section-heading h2 {
    max-width: 850px;

    margin: 16px 0 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(
        40px,
        4.8vw,
        70px
      );

    font-weight: 900;

    line-height: 0.88;

    letter-spacing: -0.08em;

    text-transform: uppercase;
  }

  .section-heading p {
    max-width: 650px;

    margin: 13px 0 0;

    color: var(--muted);

    font-size: 13px;

    line-height: 1.7;
  }

  .section-action {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    min-height: 48px;

    padding-inline: 14px;

    color: var(--ink);

    background: var(--acid);

    border: 3px solid var(--ink);

    box-shadow:
      6px 6px 0 var(--warning);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.06em;

    text-decoration: none;

    text-transform: uppercase;

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }

  .section-action:hover {
    transform:
      translate(-3px, -3px);

    box-shadow:
      9px 9px 0 var(--ink);
  }

  .section-action--secondary {
    color: var(--acid);

    background: var(--ink);

    border-color: var(--ink);

    box-shadow:
      6px 6px 0 var(--warning);
  }

  .section-action--secondary:hover {
    color: var(--ink);

    background: var(--acid);
  }

  /* ==========================================================================
     MAP TOOLBAR
     ========================================================================== */

  .map-toolbar {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: stretch;

    gap: 12px;

    margin-bottom: 16px;
  }

  .search-box {
    display: flex;

    align-items: center;

    width: 100%;
    min-width: 0;
    min-height: 56px;

    gap: 11px;

    padding-inline: 15px;

    color: var(--ink);

    background: var(--white);

    border: 3px solid var(--ink);

    box-shadow:
      6px 6px 0 var(--ink);

    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }

  .search-box:focus-within {
    box-shadow:
      8px 8px 0 var(--warning);

    transform:
      translate(-2px, -2px);
  }

  .search-box svg {
    flex: 0 0 auto;

    color: var(--warning);
  }

  .search-box input {
    width: 100%;
    min-width: 0;

    padding: 0;

    border: 0;
    outline: 0;

    background: transparent;

    color: var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 10px;
    font-weight: 700;
  }

  .search-box input::placeholder {
    color: var(--muted);
  }

  .map-count {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-width: 150px;

    padding: 0 14px;

    color: var(--acid);

    background: var(--ink);

    border: 3px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .map-count strong {
    color: var(--acid);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 23px;

    line-height: 1;

    letter-spacing: -0.05em;
  }

  /* ==========================================================================
     MAP LAYOUT
     ========================================================================== */

  .map-layout {
    display: grid;

    grid-template-columns:
      minmax(240px, 300px)
      minmax(0, 1fr);

    gap: 20px;

    width: 100%;
    min-width: 0;

    align-items: start;
  }

  .map-sidebar {
    display: flex;
    flex-direction: column;

    gap: 14px;

    min-width: 0;
  }

  /* ==========================================================================
     FILTER CARD
     ========================================================================== */

  .filter-card {
    min-width: 0;

    padding: 17px;

    color: var(--white);

    background: var(--ink);

    border: 3px solid var(--white);

    box-shadow:
      7px 7px 0 var(--warning);
  }

  .filter-card__header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 12px;

    margin-bottom: 16px;
  }

  .filter-card__header > div {
    min-width: 0;
  }

  .filter-card__eyebrow {
    display: block;

    color: #aeb1a8;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 900;

    letter-spacing: 0.09em;

    text-transform: uppercase;
  }

  .filter-card__header strong {
    display: block;

    margin-top: 5px;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 18px;
    font-weight: 900;

    line-height: 0.95;

    letter-spacing: -0.05em;

    text-transform: uppercase;
  }

  .filter-card__header > svg {
    flex: 0 0 auto;

    color: var(--acid);
  }

  /* ==========================================================================
     SIDEBAR NOTE
     ========================================================================== */

  .sidebar-note {
    display: grid;

    grid-template-columns:
      42px minmax(0, 1fr);

    gap: 10px;

    min-width: 0;

    padding: 16px;

    color: var(--ink);

    background: var(--white);

    border: 3px solid var(--ink);

    box-shadow:
      6px 6px 0 var(--ink);
  }

  .sidebar-note__icon {
    display: grid;

    width: 42px;
    height: 42px;

    place-items: center;

    color: var(--ink);

    background: var(--acid);

    border: 2px solid var(--ink);
  }

  .sidebar-note__body {
    min-width: 0;
  }

  .sidebar-note strong {
    display: block;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 11px;
    font-weight: 900;

    line-height: 1.05;

    text-transform: uppercase;
  }

  .sidebar-note p {
    margin: 5px 0 0;

    color: var(--muted);

    font-size: 9px;

    line-height: 1.6;
  }

  .sidebar-note a {
    grid-column: 1 / -1;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 8px;

    margin-top: 4px;

    padding-top: 12px;

    color: var(--ink);

    border-top:
      2px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.05em;

    text-decoration: none;

    text-transform: uppercase;
  }

  .sidebar-note a svg {
    transform:
      rotate(180deg);
  }

  .sidebar-note a:hover {
    color: var(--warning);
  }

  /* ==========================================================================
     MAP CONTAINER
     ========================================================================== */

  .map-container {
    position: relative;

    width: 100%;
    min-width: 0;

    height: 660px;

    overflow: hidden;

    background: #22281d;

    border: 4px solid var(--white);

    box-shadow:
      12px 12px 0 var(--warning);
  }

  .map-container > * {
    width: 100%;
    max-width: 100%;
  }

  .map-container iframe,
  .map-container canvas,
  .map-container .leaflet-container,
  .map-container .maplibregl-map {
    display: block;

    width: 100% !important;
    height: 100% !important;
  }

  /* ==========================================================================
     MAP EMPTY
     ========================================================================== */

  .map-empty {
    position: relative;

    display: flex;

    min-height: 100%;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    padding: 34px;

    color: var(--white);

    background:
      linear-gradient(
        rgba(223, 255, 0, 0.08) 2px,
        transparent 2px
      ),
      linear-gradient(
        90deg,
        rgba(223, 255, 0, 0.08) 2px,
        transparent 2px
      ),
      #22281d;

    background-size: 32px 32px;

    text-align: center;
  }

  .map-empty::before {
    position: absolute;

    inset: 8%;

    content: "";

    border: 3px solid var(--acid);

    opacity: 0.3;

    clip-path: polygon(
      4% 20%,
      22% 6%,
      68% 10%,
      94% 30%,
      82% 76%,
      52% 96%,
      16% 84%
    );
  }

  .map-empty__icon {
    position: relative;
    z-index: 1;

    display: grid;

    width: 72px;
    height: 72px;

    place-items: center;

    margin-bottom: 18px;

    color: var(--ink);

    background: var(--acid);

    border: 3px solid var(--ink);

    box-shadow:
      7px 7px 0 var(--warning);
  }

  .map-empty h3 {
    position: relative;
    z-index: 1;

    margin: 0;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 22px;
    font-weight: 900;

    line-height: 0.95;

    letter-spacing: -0.05em;

    text-transform: uppercase;
  }

  .map-empty p {
    position: relative;
    z-index: 1;

    max-width: 500px;

    margin: 11px 0 20px;

    color: #c7c9c1;

    font-size: 11px;

    line-height: 1.7;
  }

  .map-empty a {
    position: relative;
    z-index: 1;

    display: inline-flex;

    align-items: center;

    min-height: 46px;

    padding-inline: 15px;

    color: var(--ink);

    background: var(--acid);

    border: 3px solid var(--ink);

    box-shadow:
      7px 7px 0 var(--warning);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.06em;

    text-decoration: none;

    text-transform: uppercase;
  }

  /* ==========================================================================
     OVERVIEW
     ========================================================================== */

  .overview-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 14px;
  }

  .overview-card {
    position: relative;

    min-width: 0;

    padding: 18px;

    background: var(--white);

    border: 3px solid var(--ink);

    box-shadow:
      6px 6px 0 var(--ink);
  }

  .overview-card__top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;
  }

  .overview-card__top > span {
    color: var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.08em;
  }

  .overview-card__icon {
    display: grid;

    width: 44px;
    height: 44px;

    place-items: center;

    color: var(--acid);

    background: var(--ink);

    border: 2px solid var(--ink);

    transform: rotate(-3deg);
  }

  .overview-card__label {
    display: block;

    margin-top: 20px;

    color: var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  .overview-card > strong {
    display: block;

    margin-top: 5px;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 42px;
    font-weight: 900;

    line-height: 0.9;

    letter-spacing: -0.07em;
  }

  .overview-card p {
    margin: 13px 0 0;

    color: var(--muted);

    font-size: 10px;

    line-height: 1.65;
  }

  /* ==========================================================================
     DISTRIBUTION
     ========================================================================== */

  .distribution-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 14px;
  }

  .distribution-card {
    display: grid;

    grid-template-columns:
      42px minmax(0, 1fr);

    gap: 12px;

    min-width: 0;

    padding: 16px;

    color: var(--white);

    background: var(--ink);

    border: 3px solid var(--white);

    box-shadow:
      6px 6px 0 var(--ink);
  }

  .distribution-card__number {
    display: grid;

    width: 42px;
    height: 42px;

    place-items: center;

    color: var(--ink);

    background: var(--acid);

    border: 2px solid var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;
  }

  .distribution-card__main {
    min-width: 0;
  }

  .distribution-card__top {
    display: flex;

    align-items: center;

    gap: 11px;

    min-width: 0;
  }

  .distribution-card__icon {
    display: grid;

    width: 38px;
    height: 38px;

    place-items: center;

    flex: 0 0 38px;

    color: var(--ink);

    background: var(--acid);

    border: 2px solid var(--ink);
  }

  .distribution-card__text {
    min-width: 0;

    display: grid;

    gap: 4px;
  }

  .distribution-card__text strong {
    overflow-wrap: anywhere;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 12px;
    font-weight: 900;

    line-height: 1;

    letter-spacing: -0.03em;

    text-transform: uppercase;
  }

  .distribution-card__text span {
    color: #aeb1a8;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 900;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .distribution-bar {
    height: 8px;

    margin-top: 14px;

    overflow: hidden;

    background: var(--ink-3);

    border: 2px solid var(--white);
  }

  .distribution-bar span {
    display: block;

    height: 100%;

    background: var(--acid);
  }

  .distribution-card small {
    display: block;

    margin-top: 8px;

    color: #bfc2b9;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  /* ==========================================================================
     ORGANIZATIONS
     ========================================================================== */

  .organization-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 14px;
  }

  .organization-card {
    display: grid;

    grid-template-columns:
      44px minmax(0, 1fr) 28px;

    align-items: center;

    gap: 12px;

    min-width: 0;

    padding: 14px;

    color: var(--ink);

    background: var(--white);

    border: 3px solid var(--ink);

    box-shadow:
      6px 6px 0 var(--ink);

    text-decoration: none;

    transition:
      transform 120ms steps(2, end),
      background 120ms linear,
      box-shadow 120ms steps(2, end);
  }

  .organization-card:hover {
    background: var(--acid);

    box-shadow:
      9px 9px 0 var(--warning);

    transform:
      translate(-3px, -3px);
  }

  .organization-card__icon {
    display: grid;

    width: 44px;
    height: 44px;

    place-items: center;

    color: var(--acid);

    background: var(--ink);

    border: 2px solid var(--ink);
  }

  .organization-card__body {
    min-width: 0;

    display: grid;

    gap: 4px;
  }

  .organization-card__body strong {
    overflow: hidden;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 11px;
    font-weight: 900;

    line-height: 1.05;

    text-overflow: ellipsis;

    text-transform: uppercase;

    white-space: nowrap;
  }

  .organization-card__body span {
    overflow: hidden;

    color: var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 900;

    letter-spacing: 0.05em;

    text-overflow: ellipsis;

    text-transform: uppercase;

    white-space: nowrap;
  }

  .organization-card__arrow {
    justify-self: end;

    color: var(--ink);

    transform:
      rotate(180deg);

    transition:
      transform 120ms steps(2, end);
  }

  .organization-card:hover
    .organization-card__arrow {
    transform:
      rotate(180deg)
      translateX(4px);
  }

  /* ==========================================================================
     EMPTY
     ========================================================================== */

  .empty-panel {
    display: grid;

    place-items: center;

    padding: 54px 24px;

    color: var(--muted);

    background: var(--paper-2);

    border: 3px solid var(--ink);

    box-shadow:
      7px 7px 0 var(--ink);

    text-align: center;
  }

  .empty-panel h3 {
    margin: 14px 0 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      sans-serif;

    font-size: 19px;

    font-weight: 900;

    line-height: 0.95;

    letter-spacing: -0.04em;

    text-transform: uppercase;
  }

  .empty-panel p {
    max-width: 520px;

    margin: 9px 0 0;

    color: var(--muted);

    font-size: 10px;

    line-height: 1.6;
  }

  /* ==========================================================================
     CTA
     ========================================================================== */

  .area-cta {
    display: grid;

    grid-template-columns:
      auto minmax(0, 1fr)
      auto;

