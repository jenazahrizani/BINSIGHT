  /* ==========================================================================
     DISTRIBUTION
     ========================================================================== */

  .distribution-section {
    background:
      var(--paper);
  }

  .distribution-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(
          0,
          1fr
        )
      );

    gap:
      0.8rem;
  }

  .distribution-card {
    display:
      grid;

    grid-template-columns:
      2.5rem
      minmax(
        0,
        1fr
      );

    gap:
      0.7rem;

    min-width:
      0;

    padding:
      0.9rem;

    border:
      3px solid
