    gap:
      0.55rem;

    padding-bottom:
      0.15rem;
  }

  .section-heading__meta span {
    color:
      var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.52rem;

    font-weight:
      700;

    letter-spacing:
      0.06em;
  }

  .section-heading__meta strong {
    color:
      var(--ink);

    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;

    font-size:
      1.15rem;

    font-weight:
      900;
