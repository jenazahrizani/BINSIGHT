---
/**
 * ============================================================================
 * BINSIGHT — AREA MAP DETAIL
 * ============================================================================
 * Badung Waste Intelligence
 *
 * Halaman detail area pada direktori peta publik.
 *
 * Prinsip:
 * - Tidak membuat data baru.
 * - Hanya menggunakan area aktif dari data layer.
 * - Lokasi hanya menampilkan data aktif pada area terkait.
 * - Organisasi hanya publik + terverifikasi.
 * - Filter/search berjalan terhadap data yang sudah dirender.
 * ============================================================================
 */

import {
  ArrowLeft,
  ArrowRight,
  Building2,
  MapPin,
  Recycle,
  Route,
  Search,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import MapFilter from "@components/map/MapFilter.astro";
import WasteMap from "@components/map/WasteMap.astro";
import PublicLayout from "@layouts/PublicLayout.astro";

import {
  getAreas,
  type Area,
  type WasteLocation,
} from "@lib/data/locations";

import {
  getPublicOrganizations,
  type Organization,
} from "@lib/data/organizations";

import {
  getReports,
  type Report,
} from "@lib/data/reports";

import * as locationData from "@lib/data/locations";

/* ============================================================================
   STATIC ROUTES
   ========================================================================== */

export function getStaticPaths() {
  const activeAreas = getAreas().filter(
    (item) => item.status === "active",
  );

  return activeAreas.map((area) => ({
    params: {
      area: area.slug,
    },
    props: {
      area,
    },
  }));
}

/* ============================================================================
   AREA
   ========================================================================== */

const { area } = Astro.props as {
  area: Area;
};

/* ============================================================================
   ACTIVE AREAS
   ========================================================================== */

const activeAreas = getAreas().filter(
  (item) => item.status === "active",
);

/* ============================================================================
   LOCATION COMPATIBILITY
   ========================================================================== */

type LocationModuleCompatibility = {
  getLocations?: () => WasteLocation[];
  getPublicLocations?: () => WasteLocation[];
  getActiveLocations?: () => WasteLocation[];
  locations?: readonly WasteLocation[];
  wasteLocations?: readonly WasteLocation[];
  WASTE_LOCATIONS?: readonly WasteLocation[];
  LOCATIONS?: readonly WasteLocation[];
};

const compatibleLocationModule =
  locationData as unknown as LocationModuleCompatibility;

function getLocationCandidates(): WasteLocation[] {
  const getterCandidates = [
    compatibleLocationModule.getLocations,
    compatibleLocationModule.getPublicLocations,
    compatibleLocationModule.getActiveLocations,
  ];

  for (const getter of getterCandidates) {
    if (typeof getter !== "function") {
      continue;
    }

    const value = getter();

    if (Array.isArray(value)) {
      return value;
    }
  }

  const arrayCandidates = [
    compatibleLocationModule.locations,
    compatibleLocationModule.wasteLocations,
    compatibleLocationModule.WASTE_LOCATIONS,
    compatibleLocationModule.LOCATIONS,
  ];

  for (const value of arrayCandidates) {
    if (Array.isArray(value)) {
      return [...value];
    }
  }

  return [];
}

const allLocations = getLocationCandidates();

/* ============================================================================
   ORGANIZATIONS
   ========================================================================== */

const organizations: Organization[] =
  getPublicOrganizations();

const areaOrganizations =
  organizations.filter((organization) => {
    return (
      organization.isPublic === true &&
      organization.status === "verified" &&
      organization.location?.area === area.name
    );
  });

/* ============================================================================
   LOCATIONS
   ========================================================================== */

const areaLocations: WasteLocation[] =
  allLocations.filter(
    (location) =>
      location.status === "active" &&
      location.areaId === area.id,
  );

/* ============================================================================
   REPORTS
   ========================================================================== */

const reports: Report[] = getReports();

const areaReports = reports.filter(
  (report) =>
    report.location.areaId === area.id &&
    report.status !== "rejected",
);

/* ============================================================================
   LOCATION TYPES
   ========================================================================== */

const locationTypeLabels: Record<string, string> = {
  "collection-point": "Titik Pengumpulan",
  "recycling-center": "Pusat Daur Ulang",
  "waste-bank": "Bank Sampah",
  "processing-facility": "Fasilitas Pengolahan",
  "drop-point": "Drop Point",
  other: "Lokasi Lainnya",
};

const locationTypeCounts: Record<string, number> = {};

for (const location of areaLocations) {
  locationTypeCounts[location.type] =
    (locationTypeCounts[location.type] ?? 0) + 1;
}

const topLocationTypes = Object.entries(
  locationTypeCounts,
)
  .sort(
    (firstEntry, secondEntry) =>
      secondEntry[1] - firstEntry[1],
  )
  .slice(0, 5);

/* ============================================================================
   META
   ========================================================================== */

const pageTitle =
  `Peta Pengelolaan Sampah ${area.name}`;

const pageDescription =
  area.description ||
  `Jelajahi lokasi pengelolaan sampah dan informasi lingkungan di ${area.name}, Kabupaten Badung.`;

const breadcrumbs = [
  {
    label: "Beranda",
    href: "/",
  },
  {
    label: "Peta",
    href: "/map",
  },
  {
    label: area.name,
  },
];
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
>
  <main
    class="area-page"
    data-area-page
  >
    <!-- =====================================================================
         HERO
         ================================================================== -->

    <section class="area-hero">
      <div class="area-container">
        <div class="area-hero__grid">
          <div class="area-hero__content">
            <div class="area-kicker">
              <span
                class="area-kicker__dot"
                aria-hidden="true"
              ></span>

              BINSIGHT / PETA AREA
            </div>

            <nav
              class="area-breadcrumbs"
              aria-label="Breadcrumb"
            >
              <a href="/">Beranda</a>
              <span>/</span>
              <a href="/map">Peta</a>
              <span>/</span>
              <strong>{area.name}</strong>
            </nav>

            <h1>
              {area.name}
            </h1>

            <p>
              {area.description ||
                `Jelajahi lokasi pengelolaan sampah dan informasi lingkungan yang tercatat di ${area.name}.`}
            </p>

            <div class="area-hero__actions">
              <a
                href="#area-map"
                class="area-button area-button--primary"
              >
                <MapPin
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />

                <span>
                  Eksplorasi area
                </span>

                <ArrowRight
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a
                href="/map"
                class="area-button area-button--secondary"
              >
                <ArrowLeft
                  size={17}
                  stroke-width={2}
                  aria-hidden="true"
                />

                <span>
                  Semua area
                </span>
              </a>
            </div>
          </div>

          <aside
            class="area-hero__aside"
            aria-label="Ringkasan area"
          >
            <div class="area-hero__aside-top">
              <span>
                AREA STATUS
              </span>

              <ShieldCheck
                size={21}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <strong>
              Area aktif
              di BINSIGHT.
            </strong>

            <p>
              Ringkasan berikut menggunakan data lokasi,
              organisasi publik, dan laporan yang terkait
              langsung dengan area ini.
            </p>

            <div class="area-hero__stats">
              <div class="hero-stat">
                <span>
                  LOKASI
                </span>

                <strong>
                  {areaLocations.length}
                </strong>
              </div>

              <div class="hero-stat">
                <span>
                  ORGANISASI
                </span>

                <strong>
                  {areaOrganizations.length}
                </strong>
              </div>

              <div class="hero-stat">
                <span>
                  LAPORAN
                </span>

                <strong>
                  {areaReports.length}
                </strong>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         MAP
         ================================================================== -->

    <section
      id="area-map"
      class="map-section"
      aria-labelledby="area-map-title"
    >
      <div class="area-container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">
              01 / PETA
            </span>

            <h2 id="area-map-title">
              Eksplorasi {area.name}.
            </h2>

            <p>
              Lihat titik pengelolaan sampah aktif yang
              tercatat pada area ini dan gunakan pencarian
              untuk menemukan lokasi tertentu.
            </p>
          </div>

          <div class="section-heading__meta">
            <span>
              ACTIVE LOCATIONS
            </span>

            <strong>
              {areaLocations.length}
            </strong>
          </div>
        </div>

        <div class="map-tools">
          <label
            class="search-field"
            for="area-location-search"
          >
            <Search
              size={18}
              stroke-width={2}
              aria-hidden="true"
            />

            <input
              id="area-location-search"
              type="search"
              placeholder={`Cari lokasi di ${area.name}...`}
              autocomplete="off"
              aria-controls="area-map-location-list"
            />
          </label>

          <a
            href={`/reports/create?area=${encodeURIComponent(area.slug)}`}
            class="map-report-button"
          >
            <TriangleAlert
              size={17}
              stroke-width={2}
              aria-hidden="true"
            />

            <span>
              Laporkan masalah
            </span>
          </a>
        </div>

        <div class="map-workspace">
          <aside
            class="map-sidebar"
            aria-label="Kontrol area"
          >
            <div class="filter-card">
              <div class="filter-card__head">
                <div>
                  <span>
                    WILAYAH
                  </span>

                  <strong>
                    Kabupaten Badung
                  </strong>
                </div>

                <MapPin
                  size={18}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div class="filter-card__body">
                <MapFilter areas={activeAreas} />
              </div>
            </div>

            <div class="map-info-card">
              <div class="map-info-card__icon">
                <Route
                  size={18}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <span>
                  AREA NAVIGATION
                </span>

                <strong>
                  Bandingkan wilayah.
                </strong>

                <p>
                  Pindah ke area lain untuk melihat
                  lokasi pengelolaan sampah dalam
                  konteks wilayah yang berbeda.
                </p>
              </div>

              <a href="/map">
                <span>
                  Lihat semua area
                </span>

                <ArrowRight
                  size={14}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
            </div>
          </aside>

          <div class="map-frame">
            <div
              class="map-frame__surface"
              id="area-map-location-list"
            >
              {
                areaLocations.length > 0 ? (
                  <WasteMap
                    locations={areaLocations}
                  />
                ) : (
                  <div class="map-empty">
                    <div class="map-empty__icon">
                      <MapPin
                        size={28}
                        stroke-width={1.8}
                        aria-hidden="true"
                      />
                    </div>

                    <span class="map-empty__eyebrow">
                      NO ACTIVE LOCATION
                    </span>

                    <h3>
                      Belum ada lokasi aktif.
                    </h3>

                    <p>
                      Belum terdapat lokasi pengelolaan
                      sampah aktif yang tersedia untuk
                      ditampilkan di {area.name}.
                    </p>

                    <a href="/reports/create">
                      Laporkan informasi
                    </a>
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         OVERVIEW
         ================================================================== -->

    <section
      class="overview-section"
      aria-labelledby="overview-title"
    >
      <div class="area-container">
        <div class="section-heading section-heading--stacked">
          <div>
            <span class="section-kicker">
              02 / RINGKASAN
            </span>

            <h2 id="overview-title">
              Data area.
            </h2>

            <p>
              Snapshot sederhana dari data yang tersedia
              untuk {area.name}.
            </p>
          </div>
        </div>

        <div class="overview-grid">
          <article class="overview-card">
            <div class="overview-card__head">
              <span>
                01
              </span>

              <div class="overview-card__icon">
                <MapPin
                  size={20}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>
            </div>

            <span class="overview-card__label">
              LOKASI AKTIF
            </span>

            <strong>
              {areaLocations.length}
            </strong>

            <p>
              Titik pengelolaan sampah aktif yang
              tercatat di area ini.
            </p>
          </article>

          <article class="overview-card">
            <div class="overview-card__head">
              <span>
                02
              </span>

              <div class="overview-card__icon">
                <Building2
                  size={20}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>
            </div>

            <span class="overview-card__label">
              ORGANISASI
            </span>

            <strong>
              {areaOrganizations.length}
            </strong>

            <p>
              Organisasi publik dan terverifikasi yang
              terkait dengan area ini.
            </p>
          </article>

          <article class="overview-card">
            <div class="overview-card__head">
              <span>
                03
              </span>

              <div class="overview-card__icon">
                <TriangleAlert
                  size={20}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>
            </div>

            <span class="overview-card__label">
              LAPORAN
            </span>

            <strong>
              {areaReports.length}
            </strong>

            <p>
              Laporan yang terkait dengan lokasi pada
              area ini.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         DISTRIBUTION
         ================================================================== -->

    {
      topLocationTypes.length > 0 && (
        <section
          class="distribution-section"
          aria-labelledby="distribution-title"
        >
          <div class="area-container">
            <div class="section-heading section-heading--stacked">
              <div>
                <span class="section-kicker">
                  03 / DISTRIBUSI
                </span>

                <h2 id="distribution-title">
                  Jenis lokasi.
                </h2>

                <p>
                  Komposisi lokasi aktif berdasarkan tipe
                  pengelolaan yang tersedia di area ini.
                </p>
              </div>
            </div>

            <div class="distribution-grid">
              {topLocationTypes.map(
                ([type, count], index) => {
                  const percentage =
                    areaLocations.length > 0
                      ? Math.round(
                          (count /
                            areaLocations.length) *
                            100,
                        )
                      : 0;

                  return (
                    <article class="distribution-card">
                      <div class="distribution-card__index">
                        {String(index + 1).padStart(
                          2,
                          "0",
                        )}
                      </div>

                      <div class="distribution-card__main">
                        <div class="distribution-card__top">
                          <div class="distribution-card__icon">
                            <Recycle
                              size={19}
                              stroke-width={2}
                              aria-hidden="true"
                            />
                          </div>

                          <div>
                            <h3>
                              {locationTypeLabels[
                                type
                              ] ?? type}
                            </h3>

                            <span>
                              {count} lokasi
                            </span>
                          </div>
                        </div>

                        <div
                          class="distribution-bar"
                          aria-hidden="true"
                        >
                          <span
                            style={`width:${Math.min(
                              100,
                              Math.max(
                                percentage,
                                4,
                              ),
                            )}%`}
                          ></span>
                        </div>

                        <small>
                          {percentage}% dari seluruh
                          lokasi aktif
                        </small>
                      </div>
                    </article>
                  );
                },
              )}
            </div>
          </div>
        </section>
      )
    }

    <!-- =====================================================================
         ORGANIZATIONS
         ================================================================== -->

    <section
      class="organizations-section"
      aria-labelledby="organizations-title"
    >
      <div class="area-container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">
              04 / ORGANISASI
            </span>

            <h2 id="organizations-title">
              Organisasi terverifikasi.
            </h2>

            <p>
              Organisasi publik dan terverifikasi yang
              tercatat pada {area.name}.
            </p>
          </div>

          <a
            href="/organizations"
            class="section-heading__action"
          >
            <span>
              Lihat semua
            </span>

            <ArrowRight
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>
        </div>

        {
          areaOrganizations.length > 0 ? (
            <div class="organization-grid">
              {areaOrganizations
                .slice(0, 6)
                .map((organization) => (
                  <a
                    href={`/organizations/${organization.slug}`}
                    class="organization-card"
                  >
                    <div class="organization-card__icon">
                      <Building2
                        size={20}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>

                    <div class="organization-card__body">
                      <h3>
                        {organization.name}
                      </h3>

                      <span>
                        {organization.location?.address ||
                          organization.location?.area ||
                          area.name}
                      </span>
                    </div>

                    <ArrowRight
                      class="organization-card__arrow"
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </a>
                ))}
            </div>
          ) : (
            <div class="empty-state">
              <div class="empty-state__icon">
                <Building2
                  size={27}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="empty-state__eyebrow">
                EMPTY DIRECTORY
              </span>

              <h3>
                Belum ada organisasi.
              </h3>

              <p>
                Belum ada organisasi publik dan
                terverifikasi yang tercatat pada area ini.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <!-- =====================================================================
         CTA
         ================================================================== -->

    <section class="area-cta">
      <div class="area-container">
        <div class="area-cta__inner">
          <div class="area-cta__icon">
            <TriangleAlert
              size={23}
              stroke-width={2}
              aria-hidden="true"
            />
          </div>

          <div class="area-cta__content">
            <span>
              KONTRIBUSI PUBLIK
            </span>

            <h2>
              Punya informasi tentang area ini?
            </h2>

            <p>
              Bantu memperkaya BINSIGHT dengan melaporkan
              lokasi atau masalah persampahan yang kamu
              temukan di {area.name}.
            </p>
          </div>

          <a
            href={`/reports/create?area=${encodeURIComponent(area.slug)}`}
            class="area-cta__button"
          >
            <span>
              Buat laporan
            </span>

            <ArrowRight
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<script>
  const initializeAreaPage = () => {
    const page =
      document.querySelector<HTMLElement>(
        "[data-area-page]",
      );

    if (
      !page ||
      page.dataset.initialized === "true"
    ) {
      return;
    }

    page.dataset.initialized = "true";

    const searchInput =
      page.querySelector<HTMLInputElement>(
        "#area-location-search",
      );

    if (!searchInput) {
      return;
    }

    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(
          /[\u0300-\u036f]/g,
          "",
        )
        .toLowerCase()
        .replace(/\s+/g, " ")
        .trim();

    const applySearch = () => {
      const query = normalize(
        searchInput.value,
      );

      const elements =
        Array.from(
          page.querySelectorAll<HTMLElement>(
            "[data-map-location], [data-location-card]",
          ),
        );

      if (elements.length === 0) {
        return;
      }

      elements.forEach((element) => {
        const text = normalize(
          element.textContent ?? "",
        );

        element.hidden =
          Boolean(query) &&
          !text.includes(query);
      });
    };

    searchInput.addEventListener(
      "input",
      applySearch,
    );
  };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeAreaPage,
      { once: true },
    );
  } else {
    initializeAreaPage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeAreaPage,
  );
</script>

<style>
  /* ==========================================================================
     TOKENS
     ========================================================================== */

  .area-page {
    --acid: #dfff00;
    --acid-soft: #efff70;

    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;

    --paper: #f2f0e6;
    --paper-2: #e4e1d4;

    --white: #fffef8;
    --muted: #6c7068;

    --warning: #ff6a00;

    --line: rgba(9, 10, 8, 0.18);
    --line-dark: rgba(
      255,
      254,
      248,
      0.18
    );

    --container: 1320px;

    width: 100%;

    overflow: clip;

    background: var(--paper);
    color: var(--ink);
  }

  .area-container {
    width: min(
      var(--container),
      calc(100% - 40px)
    );

    margin-inline: auto;
  }

  .area-page a {
    -webkit-tap-highlight-color: transparent;
  }

  .area-page a:focus-visible,
  .area-page button:focus-visible,
  .area-page input:focus-visible {
    outline:
      3px solid var(--warning);

    outline-offset:
      4px;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .area-hero {
    position: relative;

    overflow: hidden;

    border-bottom:
      4px solid var(--ink);

    background:
      linear-gradient(
        115deg,
        var(--paper) 0%,
        var(--paper) 68%,
        var(--acid-soft) 68%,
        var(--acid-soft) 100%
      );
  }

  .area-hero::before {
    position: absolute;

    top: 0;
    right: 18%;

    width: 1px;
    height: 100%;

    background:
      rgba(9, 10, 8, 0.08);

    content: "";
  }

  .area-hero::after {
    position: absolute;

    right: -8rem;
    bottom: -13rem;

    width: 30rem;
    height: 30rem;

    border:
      3px solid rgba(
        9,
        10,
        8,
        0.08
      );

    border-radius: 50%;

    content: "";

    pointer-events: none;
  }

  .area-hero__grid {
    position: relative;
    z-index: 1;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      325px;

    gap: 4rem;

    align-items: end;

    min-height: 545px;

    padding:
      5rem 0
      4rem;
  }

  .area-hero__content {
    max-width: 900px;
    min-width: 0;
  }

  .area-kicker {
    display: inline-flex;

    align-items: center;

    gap: 0.55rem;

    width: fit-content;

    margin-bottom: 1rem;

    padding:
      0.48rem
      0.7rem;

    border:
      2px solid var(--ink);

    background: var(--ink);

