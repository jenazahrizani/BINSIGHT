  .map-report-button {
    display: inline-flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      0.45rem;

    min-height:
      3.15rem;

    padding:
      0 0.85rem;

    border:
      2px solid
      var(--ink);

    background:
      var(--white);

    color:
      var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.59rem;

    font-weight:
      700;

    letter-spacing:
      0.04em;

    text-transform:
      uppercase;

    text-decoration:
      none;

    white-space:
      nowrap;
  }

  .map-report-button:hover {
    background:
      var(--acid);

    box-shadow:
      4px 4px 0
      var(--ink);
  }

  /* ==========================================================================
     MAP WORKSPACE
     ========================================================================== */

  .map-workspace {
    display: grid;

    grid-template-columns:
      285px
      minmax(0, 1fr);

    gap:
      1rem;

    width:
      100%;

    min-width:
      0;

    align-items:
      start;
  }

  .map-sidebar {
    display: grid;

    gap:
      0.8rem;

    min-width:
      0;
  }

  /* ==========================================================================
     FILTER
     ========================================================================== */

  .filter-card {
    min-width:
      0;

    padding:
      1rem;

    border:
      3px solid
      var(--ink);

    background:
      var(--ink);

    color:
      var(--white);

    box-shadow:
      6px 6px 0
      var(--warning);
  }

  .filter-card__head {
    display: flex;

    align-items:
      flex-start;

    justify-content:
      space-between;

    gap:
      0.8rem;

    padding-bottom:
      0.85rem;

    margin-bottom:
      0.85rem;

    border-bottom:
      1px solid
      var(--line-dark);
  }

  .filter-card__head > div {
    min-width:
      0;
  }

  .filter-card__head span {
    display:
      block;

    color:
      rgba(
        255,
        254,
        248,
        0.46
      );

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.49rem;

    font-weight:
      700;

    letter-spacing:
      0.08em;
  }

  .filter-card__head strong {
    display:
      block;

    margin-top:
      0.3rem;

    color:
      var(--white);

    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;

    font-size:
      0.95rem;

    font-weight:
      900;

    line-height:
      1.05;

    text-transform:
      uppercase;
  }

  .filter-card__head > svg {
    color:
      var(--acid);
  }

  .filter-card__body {
    min-width:
      0;
  }

  /* ==========================================================================
     INFO CARD
     ========================================================================== */

  .map-info-card {
    display: grid;

    grid-template-columns:
      2.65rem
      minmax(0, 1fr);

    gap:
      0.7rem;

    min-width:
      0;

    padding:
      0.9rem;

    border:
      2px solid
      var(--ink);

    background:
      var(--white);

    color:
      var(--ink);
  }

  .map-info-card__icon {
    display: grid;

    width:
      2.65rem;

    height:
      2.65rem;

    place-items:
      center;

    border:
      2px solid
      var(--ink);

    background:
      var(--acid);
  }

  .map-info-card > div:nth-child(2) {
    min-width:
      0;
  }

  .map-info-card > div:nth-child(2) > span {
    display:
      block;

    color:
      var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.46rem;

    font-weight:
      700;

    letter-spacing:
      0.08em;
  }

  .map-info-card strong {
    display:
      block;

    margin-top:
      0.25rem;

    color:
      var(--ink);

    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;

    font-size:
      0.76rem;

    font-weight:
      900;

    line-height:
      1.05;

    text-transform:
      uppercase;
  }

  .map-info-card p {
    margin:
      0.35rem 0 0;

    color:
      var(--muted);

    font-size:
      0.59rem;

    line-height:
      1.6;
  }

  .map-info-card > a {
    grid-column:
      1 / -1;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      0.5rem;

    margin-top:
      0.15rem;

    padding-top:
      0.7rem;

    border-top:
      1px solid
      var(--line);

    color:
      var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.49rem;

    font-weight:
      700;

    text-transform:
      uppercase;

    text-decoration:
      none;
  }

  .map-info-card > a:hover {
    color:
      var(--warning);
  }

  /* ==========================================================================
     MAP FRAME
     ========================================================================== */

  .map-frame {
    position:
      relative;

    width:
      100%;

    min-width:
      0;

    height:
      640px;

    overflow:
      hidden;

    border:
      3px solid
      var(--ink);

    background:
      #22281d;

    box-shadow:
      7px 7px 0
      var(--warning);
  }

  .map-frame__surface {
    position:
      relative;

    width:
      100%;

    height:
      100%;

    min-width:
      0;

    overflow:
      hidden;

    background:
      #22281d;
  }

  /*
   * Map libraries create global-ish DOM internally. Astro scoped selectors
   * therefore need :global() to reliably contain them.
   */

  .map-frame__surface :global(.leaflet-container),
  .map-frame__surface :global(.maplibregl-map) {
    position:
      absolute !important;

    inset:
      0 !important;

    width:
      100% !important;

    height:
      100% !important;

    max-width:
      none !important;
  }

  .map-frame__surface :global(canvas) {
    display:
      block;

    width:
      100% !important;

    height:
      100% !important;
  }

  .map-frame__surface :global(iframe) {
    display:
      block;

    width:
      100% !important;

    height:
      100% !important;

    border:
      0;
  }

  /* ==========================================================================
     EMPTY MAP
     ========================================================================== */

  .map-empty {
    display:
      grid;

    justify-items:
      center;

    align-content:
      center;

    min-height:
      100%;

    padding:
      3rem 1.5rem;

    text-align:
      center;

    background:
      linear-gradient(
        rgba(
          223,
          255,
          0,
          0.05
        ) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(
          223,
          255,
          0,
          0.05
        ) 1px,
        transparent 1px
      ),
      #22281d;

    background-size:
      32px 32px;

    color:
      var(--white);
  }

  .map-empty__icon {
    display:
      grid;

    width:
      4rem;

    height:
      4rem;

    place-items:
      center;

    margin-bottom:
      1rem;

    border:
      2px solid
      var(--ink);

    background:
      var(--acid);

    color:
      var(--ink);
  }

  .map-empty__eyebrow {
    margin-bottom:
      0.35rem;

