    margin:
      0.6rem 0 1.1rem;

    color:
      rgba(
        255,
        254,
        248,
        0.65
      );

    font-size:
      0.68rem;

    line-height:
      1.65;
  }

  .map-empty a {
    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    min-height:
      2.5rem;

    padding:
      0 0.8rem;

    border:
      2px solid
      var(--ink);

    background:
      var(--acid);

    color:
      var(--ink);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.52rem;

    font-weight:
      700;

    text-decoration:
      none;

    text-transform:
      uppercase;
  }

  .map-empty a:hover {
    background:
      var(--warning);

    color:
      var(--white);
  }

  /* ==========================================================================
     OVERVIEW
     ========================================================================== */

  .overview-section {
    background:
      var(--paper);
  }

  .overview-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        3,
        minmax(
          0,
          1fr
        )
      );

    gap:
      0.9rem;
  }

  .overview-card {
    min-width:
      0;

    padding:
      1rem;

    border:
      3px solid
      var(--ink);

    background:
      var(--white);

    box-shadow:
      5px 5px 0
      var(--ink);
  }

  .overview-card__head {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      0.7rem;
  }

  .overview-card__head > span {
    color:
      var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.48rem;

    font-weight:
      700;

    letter-spacing:
      0.06em;
  }

  .overview-card__icon {
    display:
      grid;

    width:
      2.75rem;

    height:
      2.75rem;

    place-items:
      center;

    border:
      2px solid
      var(--ink);

    background:
      var(--ink);

    color:
      var(--acid);
  }

  .overview-card__label {
    display:
      block;

    margin-top:
      1.2rem;

    color:
      var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.5rem;

    font-weight:
      700;

    letter-spacing:
      0.07em;

    text-transform:
      uppercase;
  }

  .overview-card > strong {
    display:
      block;

    margin-top:
      0.25rem;

    color:
      var(--ink);

    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;

    font-size:
      2.8rem;

    font-weight:
      900;

    line-height:
      0.9;

    letter-spacing:
      -0.07em;
  }

  .overview-card p {
    margin:
      0.7rem 0 0;

    color:
      var(--muted);

    font-size:
      0.64rem;

    line-height:
      1.6;
