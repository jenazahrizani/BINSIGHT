  .hero-stat span {
    display: block;

    color:
      rgba(
        255,
        254,
        248,
        0.4
      );

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.45rem;

    font-weight:
      700;

    letter-spacing:
      0.06em;
  }

  .hero-stat strong {
    display: block;

    margin-top:
      0.2rem;

    color:
      var(--acid);

    font-family:
      "Sora",
      "Inter",
      system-ui,
      sans-serif;

    font-size:
      1.35rem;

    font-weight:
      900;

    line-height:
