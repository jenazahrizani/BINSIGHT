</style>

<script>
// @ts-nocheck

  const form =
    document.querySelector(
      "[data-profile-form]",
    );

  const successPanel =
    document.querySelector(
      "[data-save-success]",
    );

  const editProfileButton =
    document.querySelector(
      "[data-edit-profile]",
    );

  const saveButton =
    document.querySelector(
      "[data-save-button]",
    );

  const saveLabel =
    document.querySelector(
      "[data-save-label]",
    );

  const saveMessage =
    document.querySelector(
      "[data-save-message]",
    );

  const descriptionField =
    document.querySelector(
      "[name='description']",
    );

  const descriptionCounter =
    document.querySelector(
      "[data-description-counter]",
    );

  function setFieldError(
    fieldName,
    message,
  ) {
    const field =
      form?.querySelector(
        `[name="${fieldName}"]`,
      );

    const error =
      form?.querySelector(
        `[data-field-error="${fieldName}"]`,
      );

    if (
      field instanceof HTMLElement
    ) {
      field.setAttribute(
        "aria-invalid",
        "true",
      );
    }

    if (
      error instanceof HTMLElement
    ) {
      error.textContent =
        message;

      error.hidden = false;
    }
  }

  function clearFieldError(
    fieldName,
  ) {
    const field =
      form?.querySelector(
        `[name="${fieldName}"]`,
      );

    const error =
      form?.querySelector(
        `[data-field-error="${fieldName}"]`,
      );

    if (
      field instanceof HTMLElement
    ) {
      field.removeAttribute(
        "aria-invalid",
      );
    }

    if (
      error instanceof HTMLElement
    ) {
      error.textContent = "";
      error.hidden = true;
    }
  }

  function clearAllErrors() {
    [
      "organizationName",
      "organizationType",
      "area",
      "address",
      "description",
    ].forEach(
      (fieldName) => {
        clearFieldError(
          fieldName,
        );
      },
    );
  }

  function updateDescriptionCounter() {
    if (
      !(descriptionField instanceof HTMLTextAreaElement) ||
      !(descriptionCounter instanceof HTMLElement)
    ) {
      return;
    }

    descriptionCounter.textContent =
      `${descriptionField.value.length} / 1500`;
  }

  function validateProfileForm() {
    if (
      !(form instanceof HTMLFormElement)
    ) {
      return false;
    }

    clearAllErrors();

    const organizationName =
      form.elements.namedItem(
        "organizationName",
      );

    const organizationType =
      form.elements.namedItem(
        "organizationType",
      );

    const area =
      form.elements.namedItem(
        "area",
      );

    const address =
      form.elements.namedItem(
        "address",
      );

    const description =
      form.elements.namedItem(
        "description",
      );

    let valid = true;

    if (
      !(
        organizationName instanceof
        HTMLInputElement
      ) ||
      organizationName.value.trim().length < 2
    ) {
      setFieldError(
        "organizationName",
        "Nama organisasi minimal 2 karakter.",
      );

      valid = false;
    }

    if (
      !(
        organizationType instanceof
        HTMLSelectElement
      ) ||
      organizationType.value === ""
    ) {
      setFieldError(
        "organizationType",
        "Silakan pilih jenis organisasi.",
      );

      valid = false;
    }

    if (
      !(area instanceof HTMLSelectElement) ||
      area.value === ""
    ) {
      setFieldError(
        "area",
        "Silakan pilih area atau kecamatan.",
      );

      valid = false;
    }

    if (
      !(address instanceof HTMLInputElement) ||
      address.value.trim().length < 5
    ) {
      setFieldError(
        "address",
        "Alamat organisasi perlu diisi.",
      );

      valid = false;
    }

    if (
      description instanceof HTMLTextAreaElement &&
      description.value.trim().length > 0 &&
      description.value.trim().length < 20
    ) {
      setFieldError(
        "description",
        "Deskripsi yang diisi minimal 20 karakter.",
      );

      valid = false;
    }

    if (!valid) {
      const firstInvalid =
        form.querySelector(
          "[aria-invalid='true']",
        );

      if (
        firstInvalid instanceof HTMLElement
      ) {
        firstInvalid.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        firstInvalid.focus();
      }
    }

    return valid;
  }

  function buildProfilePayload() {
    if (
      !(form instanceof HTMLFormElement)
    ) {
      return null;
    }

    const formData =
      new FormData(form);

    const latitudeRaw =
      String(
        formData.get(
          "latitude",
        ) ?? "",
      ).trim();

    const longitudeRaw =
      String(
        formData.get(
          "longitude",
        ) ?? "",
      ).trim();

    const latitude =
      latitudeRaw !== ""
        ? Number(latitudeRaw)
        : undefined;

    const longitude =
      longitudeRaw !== ""
        ? Number(longitudeRaw)
        : undefined;

    return {
      name:
        String(
          formData.get(
            "organizationName",
          ) ?? "",
        ).trim(),

      type:
        String(
          formData.get(
            "organizationType",
          ) ?? "",
        ),

      description:
        String(
          formData.get(
            "description",
          ) ?? "",
        ).trim(),

      location: {
        area:
          String(
            formData.get(
              "area",
            ) ?? "",
          ),

        address:
          String(
            formData.get(
              "address",
            ) ?? "",
          ).trim(),

        latitude:
          latitude !== undefined &&
          Number.isFinite(latitude)
            ? latitude
            : undefined,

        longitude:
          longitude !== undefined &&
          Number.isFinite(longitude)
            ? longitude
            : undefined,
      },

      contact: {
        name:
          String(
            formData.get(
              "contactName",
            ) ?? "",
          ).trim(),

        phone:
          String(
            formData.get(
              "phone",
            ) ?? "",
          ).trim(),

        email:
          String(
            formData.get(
              "email",
            ) ?? "",
          ).trim(),

        website:
          String(
            formData.get(
              "website",
            ) ?? "",
          ).trim(),
      },

      updatedAt:
        new Date().toISOString(),
    };
  }

  function showSaveMessage(
    message,
  ) {
    if (
      !(saveMessage instanceof HTMLElement)
    ) {
      return;
    }

    saveMessage.textContent =
      message;

    saveMessage.hidden = false;
  }

  function clearSaveMessage() {
    if (
      !(saveMessage instanceof HTMLElement)
    ) {
      return;
    }

    saveMessage.textContent = "";
    saveMessage.hidden = true;
  }

  async function handleSubmit(
    event,
  ) {
    event.preventDefault();

    if (
      !(form instanceof HTMLFormElement)
    ) {
      return;
    }

    clearSaveMessage();

    if (!validateProfileForm()) {
      return;
    }

    const payload =
      buildProfilePayload();

    if (!payload) {
      return;
    }

    if (
      saveButton instanceof HTMLButtonElement
    ) {
      saveButton.disabled = true;
    }

    if (
      saveLabel instanceof HTMLElement
    ) {
      saveLabel.textContent =
        "Menyiapkan...";
    }

    showSaveMessage(
      "Memeriksa informasi profil...",
    );

    await Promise.resolve();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:organization-profile-save",
        {
          detail: payload,
        },
      ),
    );

    form.hidden = true;

    if (
      successPanel instanceof HTMLElement
    ) {
      successPanel.hidden = false;

      successPanel.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }

    clearSaveMessage();
  }

  function showEditForm() {
    if (
      !(form instanceof HTMLFormElement)
    ) {
      return;
    }

    form.hidden = false;

    if (
      successPanel instanceof HTMLElement
    ) {
      successPanel.hidden = true;
    }

    if (
      saveButton instanceof HTMLButtonElement
    ) {
      saveButton.disabled = false;
    }

    if (
      saveLabel instanceof HTMLElement
    ) {
      saveLabel.textContent =
        "Simpan profil";
    }

    clearSaveMessage();

    form.scrollIntoView({
      behavior: "smooth",
      block: "start",
    });
  }

  form?.addEventListener(
    "submit",
    handleSubmit,
  );

  editProfileButton?.addEventListener(
    "click",
    showEditForm,
  );

  descriptionField?.addEventListener(
    "input",
    updateDescriptionCounter,
  );

  form?.querySelectorAll(
    "input, textarea, select",
  ).forEach(
    (field) => {
      field.addEventListener(
        "input",
        () => {
          const name =
            field.getAttribute(
              "name",
            );

          if (name) {
            clearFieldError(
              name,
            );
          }
        },
      );

      field.addEventListener(
        "change",
        () => {
          const name =
            field.getAttribute(
              "name",
            );

          if (name) {
            clearFieldError(
              name,
            );
          }
        },
      );
    },
  );

  updateDescriptionCounter();
</script>