---
import {
  ArrowLeft,
  ArrowRight,
  Building2,
  CircleCheck,
  Globe,
  Mail,
  MapPin,
  Phone,
  Save,
  ShieldCheck,
  UserRound,
} from "@lucide/astro";

import OrganizationLayout from "../../layouts/OrganizationLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
---

<OrganizationLayout
  title="Profil Organisasi"
  description="Kelola informasi profil organisasi yang ditampilkan melalui BINSIGHT."
>
  <main class="organization-profile-page">
    <PageHeader
      eyebrow="PORTAL ORGANISASI"
      title="Profil organisasi"
      description="Lengkapi informasi organisasi agar masyarakat dapat mengenali identitas, lokasi, dan peran organisasi Anda dalam ekosistem persampahan Badung."
      icon="organization"
      tone="green"
      breadcrumbs={[
        {
          label: "Beranda",
          href: "/",
        },
        {
          label: "Portal Organisasi",
          href: "/organization",
        },
        {
          label: "Profil",
          href: "/organization/profile",
        },
      ]}
    />

    <section class="profile-content">
      <div class="profile-container">
        <div class="profile-layout">
          <div class="profile-main">
            <form
              class="profile-form"
              id="organization-profile-form"
              data-profile-form
            >
              <section class="profile-card">
                <div class="profile-card__header">
                  <div>
                    <span class="profile-card__eyebrow">
                      IDENTITAS
                    </span>

                    <h2 class="profile-card__title">
                      Informasi utama organisasi
                    </h2>

                    <p class="profile-card__description">
                      Gunakan nama dan deskripsi yang jelas agar organisasi
                      mudah dikenali oleh masyarakat.
                    </p>
                  </div>

                  <div class="profile-card__icon">
                    <Building2
                      size={22}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </div>
                </div>

                <div class="profile-grid">
                  <div class="field field--full">
                    <label
                      class="field__label"
                      for="organizationName"
                    >
                      Nama organisasi
                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <p
                      class="field__hint"
                      id="organizationNameHint"
                    >
                      Nama resmi organisasi yang akan ditampilkan kepada publik.
                    </p>

                    <input
                      id="organizationName"
                      name="organizationName"
                      class="field__input"
                      type="text"
                      maxlength="160"
                      minlength="2"
                      required
                      autocomplete="organization"
                      aria-describedby="organizationNameHint organizationNameError"
                      placeholder="Contoh: Bank Sampah Lestari Badung"
                    />

                    <p
                      id="organizationNameError"
                      class="field__error"
                      data-field-error="organizationName"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="organizationType"
                    >
                      Jenis organisasi
                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="organizationType"
                      name="organizationType"
                      class="field__select"
                      required
                      aria-describedby="organizationTypeError"
                    >
                      <option value="">
                        Pilih jenis organisasi
                      </option>

                      <option value="government">
                        Pemerintah
                      </option>

                      <option value="community">
                        Komunitas
                      </option>

                      <option value="private">
                        Swasta
                      </option>

                      <option value="social-enterprise">
                        Social enterprise
                      </option>

                      <option value="cooperative">
                        Koperasi
                      </option>

                      <option value="educational">
                        Pendidikan
                      </option>

                      <option value="nonprofit">
                        Nonprofit
                      </option>

                      <option value="other">
                        Lainnya
                      </option>
                    </select>

                    <p
                      id="organizationTypeError"
                      class="field__error"
                      data-field-error="organizationType"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="organizationStatus"
                    >
                      Status profil
                    </label>

                    <div class="status-control">
                      <div class="status-control__icon">
                        <ShieldCheck
                          size={18}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </div>

                      <div>
                        <strong>
                          Menunggu verifikasi
                        </strong>

                        <span>
                          Status dapat berubah setelah peninjauan administrator.
                        </span>
                      </div>
                    </div>
                  </div>

                  <div class="field field--full">
                    <label
                      class="field__label"
                      for="description"
                    >
                      Deskripsi organisasi
                    </label>

                    <p
                      class="field__hint"
                      id="descriptionHint"
                    >
                      Jelaskan secara singkat aktivitas, peran, atau fokus
                      organisasi dalam pengelolaan persampahan.
                    </p>

                    <textarea
                      id="description"
                      name="description"
                      class="field__textarea"
                      rows="7"
                      maxlength="1500"
                      aria-describedby="descriptionHint descriptionError descriptionCounter"
                      placeholder="Contoh: Organisasi kami bergerak dalam pengumpulan dan pengelolaan material yang dapat didaur ulang dari masyarakat..."
                    ></textarea>

                    <div class="field__footer">
                      <p
                        id="descriptionError"
                        class="field__error"
                        data-field-error="description"
                        hidden
                      ></p>

                      <span
                        id="descriptionCounter"
                        class="field__counter"
                        data-description-counter
                      >
                        0 / 1500
                      </span>
                    </div>
                  </div>
                </div>
              </section>

              <section class="profile-card">
                <div class="profile-card__header">
                  <div>
                    <span class="profile-card__eyebrow">
                      LOKASI
                    </span>

                    <h2 class="profile-card__title">
                      Informasi lokasi organisasi
                    </h2>

                    <p class="profile-card__description">
                      Lokasi membantu masyarakat menemukan organisasi dan
                      menghubungkannya dengan peta BINSIGHT.
                    </p>
                  </div>

                  <div class="profile-card__icon">
                    <MapPin
                      size={22}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </div>
                </div>

                <div class="profile-grid">
                  <div class="field">
                    <label
                      class="field__label"
                      for="area"
                    >
                      Area / Kecamatan
                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="area"
                      name="area"
                      class="field__select"
                      required
                      aria-describedby="areaError"
                    >
                      <option value="">
                        Pilih area
                      </option>

                      <option value="abiansemal">
                        Abiansemal
                      </option>

                      <option value="kuta">
                        Kuta
                      </option>

                      <option value="kuta-selatan">
                        Kuta Selatan
                      </option>

                      <option value="kuta-utara">
                        Kuta Utara
                      </option>

                      <option value="mengwi">
                        Mengwi
                      </option>

                      <option value="petang">
                        Petang
                      </option>
                    </select>

                    <p
                      id="areaError"
                      class="field__error"
                      data-field-error="area"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="address"
                    >
                      Alamat
                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <input
                      id="address"
                      name="address"
                      class="field__input"
                      type="text"
                      maxlength="300"
                      minlength="5"
                      required
                      autocomplete="street-address"
                      aria-describedby="addressError"
                      placeholder="Alamat lengkap organisasi"
                    />

                    <p
                      id="addressError"
                      class="field__error"
                      data-field-error="address"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="latitude"
                    >
                      Latitude
                    </label>

                    <input
                      id="latitude"
                      name="latitude"
                      class="field__input"
                      type="number"
                      inputmode="decimal"
                      min="-90"
                      max="90"
                      step="any"
                      placeholder="-8.650000"
                      aria-describedby="coordinatesHint"
                    />
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="longitude"
                    >
                      Longitude
                    </label>

                    <input
                      id="longitude"
                      name="longitude"
                      class="field__input"
                      type="number"
                      inputmode="decimal"
                      min="-180"
                      max="180"
                      step="any"
                      placeholder="115.216667"
                      aria-describedby="coordinatesHint"
                    />
                  </div>

                  <div class="field field--full">
                    <div
                      class="coordinates-notice"
                      id="coordinatesHint"
                    >
                      <MapPin
                        size={17}
                        stroke-width={2}
                        aria-hidden="true"
                      />

                      <span>
                        Koordinat bersifat opsional. Isi hanya apabila
                        koordinat organisasi tersedia dan telah diperiksa.
                      </span>
                    </div>
                  </div>
                </div>
              </section>

              <section class="profile-card">
                <div class="profile-card__header">
                  <div>
                    <span class="profile-card__eyebrow">
                      KONTAK
                    </span>

                    <h2 class="profile-card__title">
                      Informasi yang dapat dihubungi
                    </h2>

                    <p class="profile-card__description">
                      Tambahkan saluran komunikasi yang relevan untuk
                      membantu masyarakat mengenali organisasi.
                    </p>
                  </div>

                  <div class="profile-card__icon">
                    <Phone
                      size={22}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </div>
                </div>

                <div class="profile-grid">
                  <div class="field">
                    <label
                      class="field__label"
                      for="contactName"
                    >
                      Nama kontak
                    </label>

                    <div class="field__input-wrap">
                      <UserRound
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="contactName"
                        name="contactName"
                        class="field__input field__input--with-icon"
                        type="text"
                        maxlength="120"
                        autocomplete="name"
                        placeholder="Nama narahubung"
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="phone"
                    >
                      Nomor telepon
                    </label>

                    <div class="field__input-wrap">
                      <Phone
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="phone"
                        name="phone"
                        class="field__input field__input--with-icon"
                        type="tel"
                        maxlength="40"
                        autocomplete="tel"
                        placeholder="+62 812 ..."
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="email"
                    >
                      Email
                    </label>

                    <div class="field__input-wrap">
                      <Mail
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="email"
                        name="email"
                        class="field__input field__input--with-icon"
                        type="email"
                        maxlength="160"
                        autocomplete="email"
                        placeholder="nama@organisasi.id"
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="website"
                    >
                      Website
                    </label>

                    <div class="field__input-wrap">
                      <Globe
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="website"
                        name="website"
                        class="field__input field__input--with-icon"
                        type="url"
                        maxlength="250"
                        autocomplete="url"
                        placeholder="https://..."
                      />
                    </div>
                  </div>
                </div>
              </section>

              <section class="profile-card profile-card--publish">
                <div class="publish-box">
                  <div class="publish-box__icon">
                    <CircleCheck
                      size={21}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="publish-box__content">
                    <h2>
                      Siap untuk ditinjau
                    </h2>

                    <p>
                      Setelah informasi disimpan, profil dapat ditinjau oleh
                      administrator sebelum ditampilkan sebagai informasi
                      publik.
                    </p>
                  </div>
                </div>

                <div class="form-actions">
                  <a
                    class="form-actions__back"
                    href="/organization"
                  >
                    <ArrowLeft
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>
                      Kembali
                    </span>
                  </a>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-save-button
                  >
                    <Save
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-save-label>
                      Simpan profil
                    </span>
                  </button>
                </div>

                <p
                  class="save-message"
                  data-save-message
                  hidden
                ></p>
              </section>
            </form>

            <div
              class="save-success"
              data-save-success
              hidden
            >
              <div class="save-success__icon">
                <CircleCheck
                  size={32}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                PROFIL DIPERSIAPKAN
              </span>

              <h2>
                Informasi profil berhasil disiapkan
              </h2>

              <p>
                Perubahan telah melalui pemeriksaan dasar pada browser dan
                siap diteruskan ke proses penyimpanan serta verifikasi.
              </p>

              <div class="save-success__actions">
                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  Kembali ke portal

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-profile
                >
                  Edit kembali
                </button>
              </div>
            </div>
          </div>

          <aside class="profile-sidebar">
            <div class="sidebar-card sidebar-card--status">
              <div class="sidebar-status__header">
                <div class="sidebar-status__icon">
                  <ShieldCheck
                    size={19}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

                <div>
                  <span>
                    STATUS PROFIL
                  </span>

                  <strong>
                    Menunggu verifikasi
                  </strong>
                </div>
              </div>

              <p>
                Lengkapi informasi organisasi dengan akurat agar proses
                peninjauan dapat dilakukan dengan lebih baik.
              </p>
            </div>

            <div class="sidebar-card">
              <span class="sidebar-card__eyebrow">
                CHECKLIST
              </span>

              <h2>
                Profil yang baik
              </h2>

              <div class="sidebar-check-list">
                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Nama organisasi jelas
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Deskripsi mudah dipahami
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Lokasi dapat ditemukan
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Kontak yang relevan
                  </span>
                </div>
              </div>
            </div>

            <div class="sidebar-card sidebar-card--tip">
              <div class="sidebar-tip__icon">
                <MapPin
                  size={18}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <strong>
                  Prioritaskan lokasi
                </strong>

                <p>
                  Lokasi yang akurat akan membuat organisasi lebih mudah
                  dihubungkan dengan peta dan informasi wilayah BINSIGHT.
                </p>
              </div>
            </div>

            <div class="sidebar-card sidebar-card--next">
              <span class="sidebar-card__eyebrow">
                LANGKAH BERIKUTNYA
              </span>

              <h2>
                Setelah profil selesai
              </h2>

              <a href="/organization/waste">
                Kelola sampah

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/process">
                Kelola proses

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/products">
                Kelola produk

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
</OrganizationLayout>

<style>
  .organization-profile-page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .profile-content {
    padding: var(--space-10) 0 var(--space-14);
  }

  .profile-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .profile-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      320px;
    gap: var(--space-7);
    align-items: start;
  }

  .profile-main {
    min-width: 0;
  }

  .profile-form {
    display: grid;
    gap: var(--space-5);
  }

  .profile-card {
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  .profile-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .profile-card__eyebrow,
  .sidebar-card__eyebrow,
  .profile-card__eyebrow {
    display: block;
    color: var(--color-primary-dark);
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.11em;
  }

  .profile-card__title {
    margin: var(--space-2) 0 0;
    color: var(--color-text-strong);
    font-size: 1.08rem;
    font-weight: 850;
    line-height: 1.3;
  }

  .profile-card__description {
    max-width: 680px;
    margin: 5px 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  .profile-card__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .profile-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  .field {
    min-width: 0;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field__label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: var(--space-2);
    color: var(--color-text-strong);
    font-size: var(--font-size-sm);
    font-weight: 750;
  }

  .field__required {
    color: var(--color-danger);
  }

  .field__hint {
    margin: 0 0 var(--space-2);
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
    line-height: 1.5;
  }

  .field__input,
  .field__select,
  .field__textarea {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-strong);
    font: inherit;
    font-size: var(--font-size-sm);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .field__input,
  .field__select {
    min-height: 45px;
    padding: 0 13px;
  }

  .field__textarea {
    min-height: 142px;
    padding: 12px 13px;
    resize: vertical;
    line-height: 1.65;
  }

  .field__input::placeholder,
  .field__textarea::placeholder {
    color: var(--color-text-faint);
  }

  .field__input:hover,
  .field__select:hover,
  .field__textarea:hover {
    border-color: var(--color-border-strong);
  }

  .field__input:focus,
  .field__select:focus,
  .field__textarea:focus {
    border-color: var(--color-primary);
    outline: none;
    box-shadow:
      0 0 0 3px var(--color-primary-ring);
  }

  .field__input[aria-invalid="true"],
  .field__select[aria-invalid="true"],
  .field__textarea[aria-invalid="true"] {
    border-color: var(--color-danger);
  }

  .field__input-wrap {
    position: relative;
  }

  .field__input-wrap > svg {
    position: absolute;
    top: 50%;
    left: 13px;
    z-index: 1;
    color: var(--color-text-faint);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .field__input--with-icon {
    padding-left: 40px;
  }

  .field__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .field__error {
    margin: var(--space-2) 0 0;
    color: var(--color-danger-text);
    font-size: var(--font-size-xs);
    line-height: 1.5;
  }

  .field__error[hidden] {
    display: none;
  }

  .field__counter {
    flex: 0 0 auto;
    margin-top: var(--space-2);
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
  }

  .status-control {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: 45px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-soft);
  }

  .status-control__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 31px;
    height: 31px;
    border-radius: 9px;
    background: var(--color-warning-soft);
    color: var(--color-warning-text);
  }

  .status-control strong,
  .status-control span {
    display: block;
  }

  .status-control strong {
    color: var(--color-text-strong);
    font-size: var(--font-size-xs);
  }

  .status-control span {
    margin-top: 2px;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .coordinates-notice {
    display: flex;
    align-items: flex-start;
