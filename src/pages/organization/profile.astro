---
import {
  ArrowLeft,
  ArrowRight,
  Building2,
  CircleCheck,
  Globe,
  Mail,
  MapPin,
  Phone,
  Save,
  ShieldCheck,
  UserRound,
} from "@lucide/astro";

import OrganizationLayout from "@layouts/OrganizationLayout.astro";
---

<OrganizationLayout
  title="Profil Organisasi"
  description="Kelola informasi profil organisasi yang ditampilkan melalui BINSIGHT."
>
  <main class="organization-profile-page">
    <section class="profile-content">
      <div class="profile-container">
        <!-- ============================================================
             PAGE INTRO
        ============================================================= -->
        <section class="profile-intro">
          <div class="profile-intro__main">
            <span class="profile-intro__eyebrow">
              ORGANIZATION / PROFILE
            </span>

            <h1 class="profile-intro__title">
              Lengkapi profil organisasi
            </h1>

            <p class="profile-intro__description">
              Isi informasi utama organisasi agar masyarakat dapat mengenali
              identitas, lokasi, kontak, dan peran organisasi Anda dalam
              ekosistem persampahan Badung.
            </p>
          </div>

          <div class="profile-intro__status">
            <div class="profile-intro__status-icon">
              <ShieldCheck
                size={19}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div>
              <span>STATUS PROFIL</span>
              <strong>MENUNGGU VERIFIKASI</strong>
            </div>
          </div>
        </section>

        <div class="profile-layout">
          <!-- ==========================================================
               MAIN CONTENT
          =========================================================== -->
          <div class="profile-main">
            <form
              class="profile-form"
              id="organization-profile-form"
              data-profile-form
              novalidate
            >
              <!-- ======================================================
                   IDENTITY
              ======================================================= -->
              <section class="profile-card">
                <header class="profile-card__header">
                  <div>
                    <span class="profile-card__eyebrow">
                      01 / IDENTITAS
                    </span>

                    <h2 class="profile-card__title">
                      Informasi utama organisasi
                    </h2>

                    <p class="profile-card__description">
                      Gunakan nama dan deskripsi yang jelas agar organisasi
                      mudah dikenali oleh masyarakat.
                    </p>
                  </div>

                  <div class="profile-card__icon">
                    <Building2
                      size={21}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </div>
                </header>

                <div class="profile-grid">
                  <div class="field field--full">
                    <label
                      class="field__label"
                      for="organizationName"
                    >
                      Nama organisasi
                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <p
                      class="field__hint"
                      id="organizationNameHint"
                    >
                      Nama resmi organisasi yang akan ditampilkan kepada
                      publik.
                    </p>

                    <input
                      id="organizationName"
                      name="organizationName"
                      class="field__input"
                      type="text"
                      maxlength="160"
                      minlength="2"
                      required
                      autocomplete="organization"
                      aria-describedby="organizationNameHint organizationNameError"
                      placeholder="Contoh: Bank Sampah Lestari Badung"
                    />

                    <p
                      id="organizationNameError"
                      class="field__error"
                      data-field-error="organizationName"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="organizationType"
                    >
                      Jenis organisasi
                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="organizationType"
                      name="organizationType"
                      class="field__select"
                      required
                      aria-describedby="organizationTypeError"
                    >
                      <option value="">
                        Pilih jenis organisasi
                      </option>

                      <option value="government">
                        Pemerintah
                      </option>

                      <option value="community">
                        Komunitas
                      </option>

                      <option value="private">
                        Swasta
                      </option>

                      <option value="social-enterprise">
                        Social enterprise
                      </option>

                      <option value="cooperative">
                        Koperasi
                      </option>

                      <option value="educational">
                        Pendidikan
                      </option>

                      <option value="nonprofit">
                        Nonprofit
                      </option>

                      <option value="other">
                        Lainnya
                      </option>
                    </select>

                    <p
                      id="organizationTypeError"
                      class="field__error"
                      data-field-error="organizationType"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <span class="field__label">
                      Status profil
                    </span>

                    <div class="status-control">
                      <div class="status-control__icon">
                        <ShieldCheck
                          size={17}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </div>

                      <div>
                        <strong>Menunggu verifikasi</strong>

                        <span>
                          Status dapat berubah setelah peninjauan
                          administrator.
                        </span>
                      </div>
                    </div>
                  </div>

                  <div class="field field--full">
                    <label
                      class="field__label"
                      for="description"
                    >
                      Deskripsi organisasi
                    </label>

                    <p
                      class="field__hint"
                      id="descriptionHint"
                    >
                      Jelaskan secara singkat aktivitas, peran, atau fokus
                      organisasi dalam pengelolaan persampahan.
                    </p>

                    <textarea
                      id="description"
                      name="description"
                      class="field__textarea"
                      rows="7"
                      maxlength="1500"
                      aria-describedby="descriptionHint descriptionError descriptionCounter"
                      placeholder="Contoh: Organisasi kami bergerak dalam pengumpulan dan pengelolaan material yang dapat didaur ulang dari masyarakat..."
                    ></textarea>

                    <div class="field__footer">
                      <p
                        id="descriptionError"
                        class="field__error"
                        data-field-error="description"
                        hidden
                      ></p>

                      <span
                        id="descriptionCounter"
                        class="field__counter"
                        data-description-counter
                      >
                        0 / 1500
                      </span>
                    </div>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   LOCATION
              ======================================================= -->
              <section class="profile-card">
                <header class="profile-card__header">
                  <div>
                    <span class="profile-card__eyebrow">
                      02 / LOKASI
                    </span>

                    <h2 class="profile-card__title">
                      Informasi lokasi organisasi
                    </h2>

                    <p class="profile-card__description">
                      Lokasi membantu masyarakat menemukan organisasi dan
                      menghubungkannya dengan peta BINSIGHT.
                    </p>
                  </div>

                  <div class="profile-card__icon">
                    <MapPin
                      size={21}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </div>
                </header>

                <div class="profile-grid">
                  <div class="field">
                    <label
                      class="field__label"
                      for="area"
                    >
                      Area / Kecamatan
                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="area"
                      name="area"
                      class="field__select"
                      required
                      aria-describedby="areaError"
                    >
                      <option value="">
                        Pilih area
                      </option>

                      <option value="abiansemal">
                        Abiansemal
                      </option>

                      <option value="kuta">
                        Kuta
                      </option>

                      <option value="kuta-selatan">
                        Kuta Selatan
                      </option>

                      <option value="kuta-utara">
                        Kuta Utara
                      </option>

                      <option value="mengwi">
                        Mengwi
                      </option>

                      <option value="petang">
                        Petang
                      </option>
                    </select>

                    <p
                      id="areaError"
                      class="field__error"
                      data-field-error="area"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="address"
                    >
                      Alamat
                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <input
                      id="address"
                      name="address"
                      class="field__input"
                      type="text"
                      maxlength="300"
                      minlength="5"
                      required
                      autocomplete="street-address"
                      aria-describedby="addressError"
                      placeholder="Alamat lengkap organisasi"
                    />

                    <p
                      id="addressError"
                      class="field__error"
                      data-field-error="address"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="latitude"
                    >
                      Latitude
                    </label>

                    <input
                      id="latitude"
                      name="latitude"
                      class="field__input"
                      type="number"
                      inputmode="decimal"
                      min="-90"
                      max="90"
                      step="any"
                      placeholder="-8.650000"
                      aria-describedby="coordinatesHint coordinateError"
                    />
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="longitude"
                    >
                      Longitude
                    </label>

                    <input
                      id="longitude"
                      name="longitude"
                      class="field__input"
                      type="number"
                      inputmode="decimal"
                      min="-180"
                      max="180"
                      step="any"
                      placeholder="115.216667"
                      aria-describedby="coordinatesHint coordinateError"
                    />
                  </div>

                  <div class="field field--full">
                    <div
                      class="coordinates-notice"
                      id="coordinatesHint"
                    >
                      <MapPin
                        size={17}
                        stroke-width={2}
                        aria-hidden="true"
                      />

                      <span>
                        Koordinat bersifat opsional. Isi hanya apabila
                        koordinat organisasi tersedia dan telah diperiksa.
                      </span>
                    </div>

                    <p
                      id="coordinateError"
                      class="field__error field__error--coordinate"
                      data-coordinate-error
                      hidden
                    ></p>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   CONTACT
              ======================================================= -->
              <section class="profile-card">
                <header class="profile-card__header">
                  <div>
                    <span class="profile-card__eyebrow">
                      03 / KONTAK
                    </span>

                    <h2 class="profile-card__title">
                      Informasi yang dapat dihubungi
                    </h2>

                    <p class="profile-card__description">
                      Tambahkan saluran komunikasi yang relevan untuk
                      membantu masyarakat mengenali organisasi.
                    </p>
                  </div>

                  <div class="profile-card__icon">
                    <Phone
                      size={21}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </div>
                </header>

                <div class="profile-grid">
                  <div class="field">
                    <label
                      class="field__label"
                      for="contactName"
                    >
                      Nama kontak
                    </label>

                    <div class="field__input-wrap">
                      <UserRound
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="contactName"
                        name="contactName"
                        class="field__input field__input--with-icon"
                        type="text"
                        maxlength="120"
                        autocomplete="name"
                        placeholder="Nama narahubung"
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="phone"
                    >
                      Nomor telepon
                    </label>

                    <div class="field__input-wrap">
                      <Phone
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="phone"
                        name="phone"
                        class="field__input field__input--with-icon"
                        type="tel"
                        maxlength="40"
                        autocomplete="tel"
                        placeholder="+62 812 ..."
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="email"
                    >
                      Email
                    </label>

                    <div class="field__input-wrap">
                      <Mail
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="email"
                        name="email"
                        class="field__input field__input--with-icon"
                        type="email"
                        maxlength="160"
                        autocomplete="email"
                        placeholder="nama@organisasi.id"
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="website"
                    >
                      Website
                    </label>

                    <div class="field__input-wrap">
                      <Globe
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="website"
                        name="website"
                        class="field__input field__input--with-icon"
                        type="url"
                        maxlength="250"
                        autocomplete="url"
                        placeholder="https://..."
                      />
                    </div>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   PUBLISH
              ======================================================= -->
              <section class="profile-card profile-card--publish">
                <div class="publish-box">
                  <div class="publish-box__icon">
                    <CircleCheck
                      size={21}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="publish-box__content">
                    <span class="publish-box__eyebrow">
                      READY FOR REVIEW
                    </span>

                    <h2>
                      Siap untuk ditinjau
                    </h2>

                    <p>
                      Setelah informasi disimpan, profil dapat ditinjau oleh
                      administrator sebelum ditampilkan sebagai informasi
                      publik.
                    </p>
                  </div>
                </div>

                <div class="form-actions">
                  <a
                    class="form-actions__back"
                    href="/organization"
                  >
                    <ArrowLeft
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>Kembali</span>
                  </a>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-save-button
                  >
                    <Save
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-save-label>
                      Simpan profil
                    </span>
                  </button>
                </div>

                <p
                  class="save-message"
                  data-save-message
                  hidden
                ></p>
              </section>
            </form>

            <!-- ========================================================
                 SUCCESS
            ========================================================= -->
            <div
              class="save-success"
              data-save-success
              hidden
            >
              <div class="save-success__icon">
                <CircleCheck
                  size={32}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                PROFILE READY
              </span>

              <h2>
                Informasi profil berhasil disiapkan
              </h2>

              <p>
                Pemeriksaan dasar pada browser telah selesai. Data siap
                diteruskan ke proses penyimpanan dan verifikasi.
              </p>

              <div class="save-success__actions">
                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  <span>Kembali ke portal</span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-profile
                >
                  Edit kembali
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</OrganizationLayout>

<style>
  /* ================================================================
     REMOVE ORGANIZATION WORKSPACE CHROME ON THIS PAGE
  ================================================================= */

  :global(.organization-layout__header) {
    display: none !important;
  }

  :global(.organization-layout__sidebar) {
    display: none !important;
  }

  :global(.organization-layout__mobile-topbar) {
    display: none !important;
  }

  :global(.organization-layout__main) {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    grid-column: 1 / -1 !important;
  }

  :global(.organization-layout__main-container) {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /*
   * Beberapa versi OrganizationLayout menggunakan parent grid/flex
   * yang tetap menyimpan kolom sidebar walaupun sidebar di-hide.
   * Rule :has() memastikan profile mengambil seluruh lebar workspace.
   */
  :global(.organization-layout:has(.organization-profile-page)) {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  :global(.organization-layout:has(.organization-profile-page)) .organization-layout__main {
    grid-column: 1 / -1 !important;
    width: 100% !important;
  }

  /* ================================================================
     PAGE
  ================================================================= */

  .organization-profile-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --orange: #ff6a00;
    --green: #87b800;

    width: 100%;
    min-height: 100%;
    background: var(--paper);
    color: var(--ink);
  }

  .organization-profile-page *,
  .organization-profile-page *::before,
  .organization-profile-page *::after {
    box-sizing: border-box;
  }

  .organization-profile-page a,
  .organization-profile-page button,
  .organization-profile-page input,
  .organization-profile-page select,
  .organization-profile-page textarea {
    -webkit-tap-highlight-color: transparent;
  }

  /* ================================================================
     CONTENT
  ================================================================= */

  .profile-content {
    width: 100%;
    padding: 34px 0 80px;
    border-bottom: 2px solid var(--ink);
    background:
      radial-gradient(
        circle at 92% 0%,
        rgb(223 255 0 / 9%),
        transparent 23%
      ),
      var(--paper-2);
  }

  .profile-container {
    width: min(1240px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* ================================================================
     INTRO
  ================================================================= */

  .profile-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding: 22px 0 34px;
    border-bottom: 2px solid var(--ink);
  }

  .profile-intro__main {
    min-width: 0;
  }

  .profile-intro__eyebrow,
  .profile-card__eyebrow,
  .save-success__eyebrow {
    display: block;
    color: var(--orange);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.57rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .profile-intro__title {
    max-width: 900px;
    margin: 12px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;
    font-size: clamp(2.3rem, 4.4vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.065em;
    line-height: 0.94;
    text-transform: uppercase;
  }

  .profile-intro__description {
    max-width: 720px;
    margin: 17px 0 0;
    color: #4e534b;
    font-size: 0.92rem;
    line-height: 1.72;
  }

  .profile-intro__status {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 11px;
    min-width: 245px;
    padding: 13px 15px;
    border: 2px solid var(--ink);
    background: var(--white);
    box-shadow: 5px 5px 0 var(--acid);
  }

  .profile-intro__status-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: var(--acid);
    color: var(--ink);
  }

  .profile-intro__status span,
  .profile-intro__status strong {
    display: block;
  }

  .profile-intro__status span {
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.49rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .profile-intro__status strong {
    margin-top: 4px;
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 800;
  }

  /* ================================================================
     LAYOUT
  ================================================================= */

  .profile-layout {
    display: block;
    width: 100%;
    padding-top: 24px;
  }

  .profile-main {
    width: min(100%, 1100px);
    min-width: 0;
    margin-inline: auto;
  }

  .profile-form {
    display: grid;
    gap: 16px;
  }

  /* ================================================================
     CARDS
  ================================================================= */

  .profile-card {
    overflow: hidden;
    border: 2px solid var(--ink);
    background: var(--white);
    box-shadow: 5px 5px 0 rgb(9 10 8 / 9%);
  }

  .profile-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 24px;
    border-bottom: 2px solid var(--ink);
  }

  .profile-card__title {
    margin: 8px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .profile-card__description {
    max-width: 690px;
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.77rem;
    line-height: 1.65;
  }

  .profile-card__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 43px;
    height: 43px;
    border: 2px solid var(--ink);
    background: var(--acid);
    color: var(--ink);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding: 24px;
  }

  /* ================================================================
     FIELDS
  ================================================================= */

  .field {
    min-width: 0;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field__label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 7px;
    color: var(--ink);
    font-size: 0.73rem;
    font-weight: 800;
  }

  .field__required {
    color: var(--orange);
  }

  .field__hint {
    max-width: 680px;
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 0.64rem;
    line-height: 1.5;
  }

  .field__input,
  .field__select,
  .field__textarea {
    width: 100%;
    border: 2px solid #bfc0b7;
    border-radius: 0;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 0.76rem;
    transition:
      border-color 150ms ease,
      background 150ms ease,
      box-shadow 150ms ease;
  }

  .field__input,
  .field__select {
    min-height: 46px;
    padding: 0 12px;
  }

  .field__textarea {
    min-height: 150px;
    padding: 12px;
    resize: vertical;
    line-height: 1.65;
  }

  .field__input:hover,
  .field__select:hover,
  .field__textarea:hover {
    border-color: #767a70;
  }

  .field__input:focus,
  .field__select:focus,
  .field__textarea:focus {
    border-color: var(--ink);
    outline: none;
    box-shadow: 4px 4px 0 var(--acid);
  }

  .field__input::placeholder,
  .field__textarea::placeholder {
    color: #999d93;
  }

  .field__input[aria-invalid="true"],
  .field__select[aria-invalid="true"],
  .field__textarea[aria-invalid="true"] {
    border-color: var(--orange);
    box-shadow: 3px 3px 0 rgb(255 106 0 / 15%);
  }

  .field__input-wrap {
    position: relative;
  }

  .field__input-wrap > svg {
    position: absolute;
    top: 50%;
    left: 12px;
    z-index: 1;
    color: var(--muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .field__input--with-icon {
    padding-left: 40px;
  }

  .field__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .field__error {
    margin: 7px 0 0;
    color: #b43d00;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.57rem;
    line-height: 1.5;
  }

  .field__error[hidden] {
    display: none;
  }

  .field__error--coordinate {
    padding-left: 2px;
  }

  .field__counter {
    flex: 0 0 auto;
    margin-top: 7px;
    color: #8b8e86;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.55rem;
  }

  /* ================================================================
     STATUS
  ================================================================= */

  .status-control {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-height: 46px;
    padding: 8px 10px;
    border: 2px solid #cfd1c7;
    background: var(--paper);
  }

  .status-control__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 29px;
    height: 29px;
    background: var(--acid);
    color: var(--ink);
  }

  .status-control strong,
  .status-control span {
    display: block;
  }

  .status-control strong {
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .status-control span {
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.57rem;
    line-height: 1.45;
  }

  /* ================================================================
     COORDINATES
  ================================================================= */

  .coordinates-notice {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 11px 12px;
    border: 1px solid #cdd1bf;
    background: #f8f9e9;
    color: #51563b;
    font-size: 0.63rem;
    line-height: 1.6;
  }

  .coordinates-notice svg {
    flex: 0 0 auto;
    margin-top: 1px;
    color: var(--orange);
  }

  /* ================================================================
     PUBLISH
  ================================================================= */

  .profile-card--publish {
    padding: 20px;
  }

  .publish-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px;
    border: 1px solid #cbd39d;
    background: #f7f9df;
  }

  .publish-box__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 39px;
    height: 39px;
    background: var(--ink);
    color: var(--acid);
  }

  .publish-box__eyebrow {
    display: block;
    color: var(--orange);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.51rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .publish-box__content h2 {
    margin: 4px 0 0;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .publish-box__content p {
    max-width: 650px;
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.63rem;
    line-height: 1.6;
  }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    padding-top: 17px;
    border-top: 2px solid var(--ink);
  }

  .form-actions__back,
  .form-actions__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 2px solid var(--ink);
    border-radius: 0;
    font: inherit;
    font-size: 0.64rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .form-actions__back {
    background: transparent;
    color: var(--ink);
  }

  .form-actions__back:hover {
    background: var(--white);
    box-shadow: 4px 4px 0 var(--paper-3);
  }

  .form-actions__submit {
    background: var(--ink);
    color: var(--acid);
    box-shadow: 5px 5px 0 var(--acid);
    transition:
      transform 150ms ease,
      box-shadow 150ms ease,
      background 150ms ease;
  }

  .form-actions__submit:hover {
    background: var(--ink-3);
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--acid);
  }

  .form-actions__submit:disabled {
    opacity: 0.55;
    cursor: wait;
    transform: none;
  }

  .form-actions__submit:focus-visible,
  .form-actions__back:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  .save-message {
    margin: 10px 0 0;
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.57rem;
    line-height: 1.5;
    text-align: right;
  }

  .save-message[hidden],
  .save-success[hidden] {
    display: none;
  }

  /* ================================================================
     SUCCESS
  ================================================================= */

  .save-success {
    padding: 48px 28px;
    border: 2px solid var(--ink);
    background:
      linear-gradient(
        145deg,
        var(--acid),
        var(--paper)
      );
    box-shadow: 8px 8px 0 var(--ink);
    text-align: center;
  }

  .save-success__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--acid);
  }

  .save-success__eyebrow {
    margin-top: 18px;
  }

  .save-success h2 {
    margin: 8px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .save-success p {
    max-width: 650px;
    margin: 12px auto 0;
    color: #4d533c;
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .save-success__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  /* ================================================================
     RESPONSIVE
  ================================================================= */

  @media (max-width: 760px) {
    .profile-intro {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
    }

    .profile-intro__status {
      width: 100%;
    }

    .profile-grid {
      grid-template-columns: 1fr;
    }

    .field--full {
      grid-column: auto;
    }
  }

  @media (max-width: 640px) {
    .profile-content {
      padding: 20px 0 54px;
    }

    .profile-container {
      width: min(100%, calc(100% - 28px));
    }

    .profile-intro {
      padding: 10px 0 25px;
    }

    .profile-intro__title {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .profile-intro__description {
      font-size: 0.77rem;
    }

    .profile-layout {
      padding-top: 14px;
    }

    .profile-form {
      gap: 14px;
    }

    .profile-card__header {
      padding: 18px;
    }

    .profile-card__title {
      font-size: 1rem;
    }

    .profile-card__description {
      font-size: 0.64rem;
    }

    .profile-card__icon {
      width: 38px;
      height: 38px;
    }

    .profile-grid {
      gap: 16px;
      padding: 18px;
    }

    .profile-card--publish {
      padding: 17px;
    }

    .form-actions {
      align-items: stretch;
      flex-direction: column-reverse;
    }

    .form-actions__submit,
    .form-actions__back {
      width: 100%;
    }

    .save-message {
      text-align: center;
    }

    .save-success {
      padding: 36px 18px;
      box-shadow: 5px 5px 0 var(--ink);
    }

    .save-success__actions {
      flex-direction: column;
    }

    .save-success__actions .form-actions__submit,
    .save-success__actions .form-actions__back {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field__input,
    .field__select,
    .field__textarea,
    .form-actions__submit {
      transition: none;
    }

    .form-actions__submit:hover {
      transform: none;
    }
  }
</style>

<script>
  const initializeOrganizationProfilePage = () => {
    const form =
      document.querySelector<HTMLFormElement>(
        "[data-profile-form]",
      );

    const successPanel =
      document.querySelector<HTMLElement>(
        "[data-save-success]",
      );

    const editProfileButton =
      document.querySelector<HTMLButtonElement>(
        "[data-edit-profile]",
      );

    const saveButton =
      document.querySelector<HTMLButtonElement>(
        "[data-save-button]",
      );

    const saveLabel =
      document.querySelector<HTMLElement>(
        "[data-save-label]",
      );

    const saveMessage =
      document.querySelector<HTMLElement>(
        "[data-save-message]",
      );

    const descriptionField =
      document.querySelector<HTMLTextAreaElement>(
        "[name='description']",
      );

    const descriptionCounter =
      document.querySelector<HTMLElement>(
        "[data-description-counter]",
      );

    if (
      !form ||
      form.dataset.initialized === "true"
    ) {
      return;
    }

    form.dataset.initialized = "true";

    const setFieldError = (
      fieldName: string,
      message: string,
    ) => {
      const field =
        form.querySelector<
          HTMLInputElement |
          HTMLSelectElement |
          HTMLTextAreaElement
        >(`[name="${fieldName}"]`);

      const error =
        form.querySelector<HTMLElement>(
          `[data-field-error="${fieldName}"]`,
        );

      if (field) {
        field.setAttribute(
          "aria-invalid",
          "true",
        );
      }

      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    };

    const clearFieldError = (
      fieldName: string,
    ) => {
      const field =
        form.querySelector<
          HTMLInputElement |
          HTMLSelectElement |
          HTMLTextAreaElement
        >(`[name="${fieldName}"]`);

      const error =
        form.querySelector<HTMLElement>(
          `[data-field-error="${fieldName}"]`,
        );

      if (field) {
        field.removeAttribute(
          "aria-invalid",
        );
      }

      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
    };

    const clearAllErrors = () => {
      [
        "organizationName",
        "organizationType",
        "area",
        "address",
        "description",
      ].forEach(clearFieldError);

      const coordinateError =
        form.querySelector<HTMLElement>(
          "[data-coordinate-error]",
        );

      if (coordinateError) {
        coordinateError.textContent = "";
        coordinateError.hidden = true;
      }

      const latitude =
        form.elements.namedItem(
          "latitude",
        ) as HTMLInputElement | null;

      const longitude =
        form.elements.namedItem(
          "longitude",
        ) as HTMLInputElement | null;

      latitude?.removeAttribute("aria-invalid");
      longitude?.removeAttribute("aria-invalid");
    };

    const updateDescriptionCounter = () => {
      if (
        !descriptionField ||
        !descriptionCounter
      ) {
        return;
      }

      descriptionCounter.textContent =
        `${descriptionField.value.length} / 1500`;
    };

    const showSaveMessage = (
      message: string,
    ) => {
      if (!saveMessage) {
        return;
      }

      saveMessage.textContent = message;
      saveMessage.hidden = false;
    };

    const clearSaveMessage = () => {
      if (!saveMessage) {
        return;
      }

      saveMessage.textContent = "";
      saveMessage.hidden = true;
    };

    const validateCoordinates = () => {
      const latitude =
        form.elements.namedItem(
          "latitude",
        ) as HTMLInputElement | null;

      const longitude =
        form.elements.namedItem(
          "longitude",
        ) as HTMLInputElement | null;

      const latitudeValue =
        latitude?.value.trim() ?? "";

      const longitudeValue =
        longitude?.value.trim() ?? "";

      if (
        latitudeValue === "" &&
        longitudeValue === ""
      ) {
        return true;
      }

      if (
        latitudeValue === "" ||
        longitudeValue === ""
      ) {
        return false;
      }

      const lat = Number(latitudeValue);
      const lng = Number(longitudeValue);

      return (
        Number.isFinite(lat) &&
        Number.isFinite(lng) &&
        lat >= -90 &&
        lat <= 90 &&
        lng >= -180 &&
        lng <= 180
      );
    };

    const validateProfileForm = () => {
      clearAllErrors();

      const organizationName =
        form.elements.namedItem(
          "organizationName",
        ) as HTMLInputElement | null;

      const organizationType =
        form.elements.namedItem(
          "organizationType",
        ) as HTMLSelectElement | null;

      const area =
        form.elements.namedItem(
          "area",
        ) as HTMLSelectElement | null;

      const address =
        form.elements.namedItem(
          "address",
        ) as HTMLInputElement | null;

      let valid = true;

      if (
        !organizationName ||
        organizationName.value.trim().length < 2
      ) {
        setFieldError(
          "organizationName",
          "Nama organisasi minimal 2 karakter.",
        );

        valid = false;
      }

      if (
        !organizationType ||
        organizationType.value === ""
      ) {
        setFieldError(
          "organizationType",
          "Silakan pilih jenis organisasi.",
        );

        valid = false;
      }

      if (
        !area ||
        area.value === ""
      ) {
        setFieldError(
          "area",
          "Silakan pilih area atau kecamatan.",
        );

        valid = false;
      }

      if (
        !address ||
        address.value.trim().length < 5
      ) {
        setFieldError(
          "address",
          "Alamat organisasi perlu diisi.",
        );

        valid = false;
      }

      if (
        descriptionField &&
        descriptionField.value.trim().length > 0 &&
        descriptionField.value.trim().length < 20
      ) {
        setFieldError(
          "description",
          "Deskripsi yang diisi minimal 20 karakter.",
        );

        valid = false;
      }

      if (!validateCoordinates()) {
        const latitude =
          form.elements.namedItem(
            "latitude",
          ) as HTMLInputElement | null;

        const longitude =
          form.elements.namedItem(
            "longitude",
          ) as HTMLInputElement | null;

        latitude?.setAttribute(
          "aria-invalid",
          "true",
        );

        longitude?.setAttribute(
          "aria-invalid",
          "true",
        );

        const coordinateError =
          form.querySelector<HTMLElement>(
            "[data-coordinate-error]",
          );

        if (coordinateError) {
          coordinateError.textContent =
            "Latitude dan longitude harus diisi berpasangan dan berada dalam rentang yang valid.";

          coordinateError.hidden = false;
        }

        valid = false;
      }

      if (!valid) {
        const firstInvalid =
          form.querySelector<HTMLElement>(
            "[aria-invalid='true']",
          );

        firstInvalid?.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        firstInvalid?.focus();
      }

      return valid;
    };

    const buildProfilePayload = () => {
      const formData =
        new FormData(form);

      const latitudeRaw =
        String(
          formData.get("latitude") ?? "",
        ).trim();

      const longitudeRaw =
        String(
          formData.get("longitude") ?? "",
        ).trim();

      const latitude =
        latitudeRaw !== ""
          ? Number(latitudeRaw)
          : undefined;

      const longitude =
        longitudeRaw !== ""
          ? Number(longitudeRaw)
          : undefined;

      return {
        name: String(
          formData.get("organizationName") ?? "",
        ).trim(),

        type: String(
          formData.get("organizationType") ?? "",
        ),

        description: String(
          formData.get("description") ?? "",
        ).trim(),

        location: {
          area: String(
            formData.get("area") ?? "",
          ),

          address: String(
            formData.get("address") ?? "",
          ).trim(),

          latitude:
            latitude !== undefined &&
            Number.isFinite(latitude)
              ? latitude
              : undefined,

          longitude:
            longitude !== undefined &&
            Number.isFinite(longitude)
              ? longitude
              : undefined,
        },

        contact: {
          name: String(
            formData.get("contactName") ?? "",
          ).trim(),

          phone: String(
            formData.get("phone") ?? "",
          ).trim(),

          email: String(
            formData.get("email") ?? "",
          ).trim(),

          website: String(
            formData.get("website") ?? "",
          ).trim(),
        },

        updatedAt:
          new Date().toISOString(),
      };
    };

    const handleSubmit = async (
      event: SubmitEvent,
    ) => {
      event.preventDefault();

      clearSaveMessage();

      if (!validateProfileForm()) {
        return;
      }

      const payload =
        buildProfilePayload();

      if (saveButton) {
        saveButton.disabled = true;
      }

      if (saveLabel) {
        saveLabel.textContent =
          "Menyiapkan...";
      }

      showSaveMessage(
        "Memeriksa informasi profil...",
      );

      await Promise.resolve();

      window.dispatchEvent(
        new CustomEvent(
          "binsight:organization-profile-save",
          {
            detail: payload,
          },
        ),
      );

      form.hidden = true;

      if (successPanel) {
        successPanel.hidden = false;

        successPanel.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }

      clearSaveMessage();
    };

    const showEditForm = () => {
      form.hidden = false;

      if (successPanel) {
        successPanel.hidden = true;
      }

      if (saveButton) {
        saveButton.disabled = false;
      }

      if (saveLabel) {
        saveLabel.textContent =
          "Simpan profil";
      }

      clearSaveMessage();

      form.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    };

    form.addEventListener(
      "submit",
      handleSubmit,
    );

    editProfileButton?.addEventListener(
      "click",
      showEditForm,
    );

    descriptionField?.addEventListener(
      "input",
      updateDescriptionCounter,
    );

    form
      .querySelectorAll<
        HTMLInputElement |
        HTMLTextAreaElement |
        HTMLSelectElement
      >(
        "input, textarea, select",
      )
      .forEach((field) => {
        const clearError = () => {
          const name =
            field.getAttribute(
              "name",
            );

          if (name) {
            clearFieldError(name);
          }

          if (
            name === "latitude" ||
            name === "longitude"
          ) {
            field.removeAttribute(
              "aria-invalid",
            );

            const coordinateError =
              form.querySelector<HTMLElement>(
                "[data-coordinate-error]",
              );

            if (coordinateError) {
              coordinateError.textContent = "";
              coordinateError.hidden = true;
            }
          }
        };

        field.addEventListener(
          "input",
          clearError,
        );

        field.addEventListener(
          "change",
          clearError,
        );
      });

    updateDescriptionCounter();
  };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeOrganizationProfilePage,
      { once: true },
    );
  } else {
    initializeOrganizationProfilePage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeOrganizationProfilePage,
  );
</script>