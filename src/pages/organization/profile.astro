---
import {
  ArrowLeft,
  ArrowRight,
  Building2,
  CircleCheck,
  Globe,
  Mail,
  MapPin,
  Phone,
  Save,
  ShieldCheck,
  UserRound,
} from "@lucide/astro";

import OrganizationLayout from "@layouts/OrganizationLayout.astro";
---

<OrganizationLayout
  title="Profil Organisasi"
  description="Kelola informasi profil organisasi yang ditampilkan melalui BINSIGHT."
  activeSection="profile"
  breadcrumbs={[
    {
      label: "Organisasi",
      href: "/organization",
    },
    {
      label: "Profil Organisasi",
    },
  ]}
>
  <div class="organization-profile-page">
    <section class="profile-page">
      <div class="profile-page__container">
        <!-- ============================================================
             PAGE HERO
        ============================================================= -->
        <section class="profile-hero">
          <div class="profile-hero__main">
            <p class="profile-hero__eyebrow">
              ORGANIZATION / PROFILE
            </p>

            <h1 class="profile-hero__title">
              Lengkapi profil organisasi
            </h1>

            <p class="profile-hero__description">
              Isi informasi utama organisasi agar masyarakat dapat mengenali
              identitas, lokasi, kontak, dan peran organisasi Anda dalam
              ekosistem persampahan Badung.
            </p>
          </div>

          <div class="profile-hero__status">
            <div class="profile-hero__status-icon">
              <ShieldCheck
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </div>

            <div class="profile-hero__status-copy">
              <span>STATUS PROFIL</span>
              <strong>MENUNGGU VERIFIKASI</strong>
            </div>
          </div>
        </section>

        <!-- ============================================================
             WORKSPACE CONTENT
        ============================================================= -->
        <div class="profile-workspace">
          <div class="profile-workspace__main">
            <form
              class="profile-form"
              id="organization-profile-form"
              data-profile-form
              novalidate
            >
              <!-- ======================================================
                   01 — IDENTITY
              ======================================================= -->
              <section class="profile-card">
                <header class="profile-card__header">
                  <div class="profile-card__heading">
                    <span class="profile-card__eyebrow">
                      01 / IDENTITAS
                    </span>

                    <h2 class="profile-card__title">
                      Informasi utama organisasi
                    </h2>

                    <p class="profile-card__description">
                      Gunakan nama dan deskripsi yang jelas agar organisasi
                      mudah dikenali oleh masyarakat.
                    </p>
                  </div>

                  <div
                    class="profile-card__icon"
                    aria-hidden="true"
                  >
                    <Building2
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div class="profile-grid">
                  <div class="field field--full">
                    <label
                      class="field__label"
                      for="organizationName"
                    >
                      Nama organisasi

                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <p
                      class="field__hint"
                      id="organizationNameHint"
                    >
                      Nama resmi organisasi yang akan ditampilkan kepada
                      publik.
                    </p>

                    <input
                      id="organizationName"
                      name="organizationName"
                      class="field__input"
                      type="text"
                      maxlength="160"
                      minlength="2"
                      required
                      autocomplete="organization"
                      aria-describedby="organizationNameHint organizationNameError"
                      placeholder="Contoh: Bank Sampah Lestari Badung"
                    />

                    <p
                      id="organizationNameError"
                      class="field__error"
                      data-field-error="organizationName"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="organizationType"
                    >
                      Jenis organisasi

                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="organizationType"
                      name="organizationType"
                      class="field__select"
                      required
                      aria-describedby="organizationTypeError"
                    >
                      <option value="">
                        Pilih jenis organisasi
                      </option>

                      <option value="government">
                        Pemerintah
                      </option>

                      <option value="community">
                        Komunitas
                      </option>

                      <option value="private">
                        Swasta
                      </option>

                      <option value="social-enterprise">
                        Social enterprise
                      </option>

                      <option value="cooperative">
                        Koperasi
                      </option>

                      <option value="educational">
                        Pendidikan
                      </option>

                      <option value="nonprofit">
                        Nonprofit
                      </option>

                      <option value="other">
                        Lainnya
                      </option>
                    </select>

                    <p
                      id="organizationTypeError"
                      class="field__error"
                      data-field-error="organizationType"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <span class="field__label">
                      Status profil
                    </span>

                    <div class="status-control">
                      <div class="status-control__icon">
                        <ShieldCheck
                          size={17}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </div>

                      <div class="status-control__copy">
                        <strong>
                          Menunggu verifikasi
                        </strong>

                        <span>
                          Status dapat berubah setelah peninjauan
                          administrator.
                        </span>
                      </div>
                    </div>
                  </div>

                  <div class="field field--full">
                    <label
                      class="field__label"
                      for="description"
                    >
                      Deskripsi organisasi
                    </label>

                    <p
                      class="field__hint"
                      id="descriptionHint"
                    >
                      Jelaskan secara singkat aktivitas, peran, atau fokus
                      organisasi dalam pengelolaan persampahan.
                    </p>

                    <textarea
                      id="description"
                      name="description"
                      class="field__textarea"
                      rows="7"
                      maxlength="1500"
                      aria-describedby="descriptionHint descriptionError descriptionCounter"
                      placeholder="Contoh: Organisasi kami bergerak dalam pengumpulan dan pengelolaan material yang dapat didaur ulang dari masyarakat..."
                    ></textarea>

                    <div class="field__footer">
                      <p
                        id="descriptionError"
                        class="field__error"
                        data-field-error="description"
                        hidden
                      ></p>

                      <span
                        id="descriptionCounter"
                        class="field__counter"
                        data-description-counter
                      >
                        0 / 1500
                      </span>
                    </div>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   02 — LOCATION
              ======================================================= -->
              <section class="profile-card">
                <header class="profile-card__header">
                  <div class="profile-card__heading">
                    <span class="profile-card__eyebrow">
                      02 / LOKASI
                    </span>

                    <h2 class="profile-card__title">
                      Informasi lokasi organisasi
                    </h2>

                    <p class="profile-card__description">
                      Lokasi membantu masyarakat menemukan organisasi dan
                      menghubungkannya dengan peta BINSIGHT.
                    </p>
                  </div>

                  <div
                    class="profile-card__icon"
                    aria-hidden="true"
                  >
                    <MapPin
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div class="profile-grid">
                  <div class="field">
                    <label
                      class="field__label"
                      for="area"
                    >
                      Area / Kecamatan

                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <select
                      id="area"
                      name="area"
                      class="field__select"
                      required
                      aria-describedby="areaError"
                    >
                      <option value="">
                        Pilih area
                      </option>

                      <option value="abiansemal">
                        Abiansemal
                      </option>

                      <option value="kuta">
                        Kuta
                      </option>

                      <option value="kuta-selatan">
                        Kuta Selatan
                      </option>

                      <option value="kuta-utara">
                        Kuta Utara
                      </option>

                      <option value="mengwi">
                        Mengwi
                      </option>

                      <option value="petang">
                        Petang
                      </option>
                    </select>

                    <p
                      id="areaError"
                      class="field__error"
                      data-field-error="area"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="address"
                    >
                      Alamat

                      <span
                        class="field__required"
                        aria-hidden="true"
                      >
                        *
                      </span>
                    </label>

                    <input
                      id="address"
                      name="address"
                      class="field__input"
                      type="text"
                      maxlength="300"
                      minlength="5"
                      required
                      autocomplete="street-address"
                      aria-describedby="addressError"
                      placeholder="Alamat lengkap organisasi"
                    />

                    <p
                      id="addressError"
                      class="field__error"
                      data-field-error="address"
                      hidden
                    ></p>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="latitude"
                    >
                      Latitude
                    </label>

                    <input
                      id="latitude"
                      name="latitude"
                      class="field__input"
                      type="number"
                      inputmode="decimal"
                      min="-90"
                      max="90"
                      step="any"
                      placeholder="-8.650000"
                      aria-describedby="coordinatesHint coordinateError"
                    />
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="longitude"
                    >
                      Longitude
                    </label>

                    <input
                      id="longitude"
                      name="longitude"
                      class="field__input"
                      type="number"
                      inputmode="decimal"
                      min="-180"
                      max="180"
                      step="any"
                      placeholder="115.216667"
                      aria-describedby="coordinatesHint coordinateError"
                    />
                  </div>

                  <div class="field field--full">
                    <div
                      class="coordinates-notice"
                      id="coordinatesHint"
                    >
                      <MapPin
                        size={17}
                        stroke-width={2}
                        aria-hidden="true"
                      />

                      <span>
                        Koordinat bersifat opsional. Isi hanya apabila
                        koordinat organisasi tersedia dan telah diperiksa.
                      </span>
                    </div>

                    <p
                      id="coordinateError"
                      class="field__error field__error--coordinate"
                      data-coordinate-error
                      hidden
                    ></p>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   03 — CONTACT
              ======================================================= -->
              <section class="profile-card">
                <header class="profile-card__header">
                  <div class="profile-card__heading">
                    <span class="profile-card__eyebrow">
                      03 / KONTAK
                    </span>

                    <h2 class="profile-card__title">
                      Informasi yang dapat dihubungi
                    </h2>

                    <p class="profile-card__description">
                      Tambahkan saluran komunikasi yang relevan untuk
                      membantu masyarakat mengenali organisasi.
                    </p>
                  </div>

                  <div
                    class="profile-card__icon"
                    aria-hidden="true"
                  >
                    <Phone
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div class="profile-grid">
                  <div class="field">
                    <label
                      class="field__label"
                      for="contactName"
                    >
                      Nama kontak
                    </label>

                    <div class="field__input-wrap">
                      <UserRound
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="contactName"
                        name="contactName"
                        class="field__input field__input--with-icon"
                        type="text"
                        maxlength="120"
                        autocomplete="name"
                        placeholder="Nama narahubung"
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="phone"
                    >
                      Nomor telepon
                    </label>

                    <div class="field__input-wrap">
                      <Phone
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="phone"
                        name="phone"
                        class="field__input field__input--with-icon"
                        type="tel"
                        maxlength="40"
                        autocomplete="tel"
                        placeholder="+62 812 ..."
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="email"
                    >
                      Email
                    </label>

                    <div class="field__input-wrap">
                      <Mail
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="email"
                        name="email"
                        class="field__input field__input--with-icon"
                        type="email"
                        maxlength="160"
                        autocomplete="email"
                        placeholder="nama@organisasi.id"
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label
                      class="field__label"
                      for="website"
                    >
                      Website
                    </label>

                    <div class="field__input-wrap">
                      <Globe
                        size={17}
                        stroke-width={1.9}
                        aria-hidden="true"
                      />

                      <input
                        id="website"
                        name="website"
                        class="field__input field__input--with-icon"
                        type="url"
                        maxlength="250"
                        autocomplete="url"
                        placeholder="https://..."
                      />
                    </div>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   REVIEW
              ======================================================= -->
              <section class="profile-card profile-card--publish">
                <div class="publish-box">
                  <div class="publish-box__icon">
                    <CircleCheck
                      size={21}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="publish-box__content">
                    <span class="publish-box__eyebrow">
                      READY FOR REVIEW
                    </span>

                    <h2>
                      Siap untuk ditinjau
                    </h2>

                    <p>
                      Setelah informasi disimpan, profil dapat ditinjau oleh
                      administrator sebelum ditampilkan sebagai informasi
                      publik.
                    </p>
                  </div>
                </div>

                <div class="form-actions">
                  <a
                    class="form-actions__back"
                    href="/organization"
                  >
                    <ArrowLeft
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>
                      Kembali
                    </span>
                  </a>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-save-button
                  >
                    <Save
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-save-label>
                      Simpan profil
                    </span>
                  </button>
                </div>

                <p
                  class="save-message"
                  data-save-message
                  hidden
                ></p>
              </section>
            </form>

            <!-- =========================================================
                 SUCCESS
            ========================================================== -->
            <section
              class="save-success"
              data-save-success
              hidden
              aria-live="polite"
            >
              <div class="save-success__icon">
                <CircleCheck
                  size={32}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                PROFILE READY
              </span>

              <h2>
                Informasi profil berhasil disiapkan
              </h2>

              <p>
                Pemeriksaan dasar pada browser telah selesai. Data siap
                diteruskan ke proses penyimpanan dan verifikasi.
              </p>

              <div class="save-success__actions">
                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  <span>
                    Kembali ke workspace
                  </span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-profile
                >
                  Edit kembali
                </button>
              </div>
            </section>
          </div>
        </div>
      </div>
    </section>
  </div>
</OrganizationLayout>

<style>
  /* ========================================================================
     PAGE ROOT
  ======================================================================== */

  .organization-profile-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --orange: #ff6a00;
    --green: #87b800;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    color: var(--ink);
    background: var(--paper);

    overflow-x: hidden;
  }

  .organization-profile-page *,
  .organization-profile-page *::before,
  .organization-profile-page *::after {
    box-sizing: border-box;
  }

  /* ========================================================================
     PAGE
  ======================================================================== */

  .profile-page {
    width: 100%;
    max-width: 100%;
    min-width: 0;

    padding:
      26px
      26px
      70px;

    background:
      radial-gradient(
        circle at 92% 2%,
        rgb(223 255 0 / 8%),
        transparent 23%
      ),
      var(--paper);
  }

  .profile-page__container {
    width: min(
      1240px,
      100%
    );

    margin-inline: auto;
  }

  /* ========================================================================
     HERO
  ======================================================================== */

  .profile-hero {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(240px, 300px);

    gap: 26px;

    padding: 28px;

    border:
      2px solid
      var(--ink);

    background:
      var(--ink);

    color: var(--white);

    box-shadow:
      7px 7px 0
      var(--orange);
  }

  .profile-hero__main {
    min-width: 0;
  }

  .profile-hero__eyebrow,
  .profile-card__eyebrow,
  .save-success__eyebrow,
  .publish-box__eyebrow {
    display: block;

    color:
      var(--orange);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.53rem;
    font-weight: 700;

    line-height: 1.2;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  .profile-hero__title {
    max-width: 900px;

    margin: 11px 0 0;

    color: var(--white);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size:
      clamp(
        2rem,
        4vw,
        4rem
      );

    font-weight: 800;

    letter-spacing:
      -0.065em;

    line-height: 0.94;

    text-transform: uppercase;
  }

  .profile-hero__description {
    max-width: 750px;

    margin: 17px 0 0;

    color:
      #bfc3b8;

    font-size: 0.84rem;

    line-height: 1.72;
  }

  .profile-hero__status {
    align-self: stretch;

    display: flex;
    align-items: center;

    gap: 12px;

    min-width: 0;

    padding: 16px;

    border:
      2px solid
      var(--acid);

    background:
      var(--white);

    color: var(--ink);

    box-shadow:
      5px 5px 0
      var(--acid);
  }

  .profile-hero__status-icon {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    background:
      var(--acid);

    color:
      var(--ink);
  }

  .profile-hero__status-copy {
    min-width: 0;
  }

  .profile-hero__status-copy span,
  .profile-hero__status-copy strong {
    display: block;
  }

  .profile-hero__status-copy span {
    color: var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.48rem;
    font-weight: 700;

    letter-spacing: 0.08em;
  }

  .profile-hero__status-copy strong {
    margin-top: 4px;

    color: var(--ink);

    font-size: 0.67rem;
    font-weight: 800;

    line-height: 1.25;
  }

  /* ========================================================================
     CONTENT
  ======================================================================== */

  .profile-workspace {
    width: 100%;
    min-width: 0;

    padding-top: 25px;
  }

  .profile-workspace__main {
    width: 100%;
    max-width: 1080px;

    min-width: 0;

    margin-inline: auto;
  }

  .profile-form {
    display: grid;

    gap: 15px;

    min-width: 0;
  }

  /* ========================================================================
     CARD
  ======================================================================== */

  .profile-card {
    min-width: 0;

    overflow: hidden;

    border:
      2px solid
      var(--ink);

    background:
      var(--white);

    box-shadow:
      5px 5px 0
      rgb(9 10 8 / 10%);
  }

  .profile-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 20px;

    padding:
      21px
      23px;

    border-bottom:
      2px solid
      var(--ink);
  }

  .profile-card__heading {
    min-width: 0;
  }

  .profile-card__title {
    margin: 7px 0 0;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: 1.12rem;
    font-weight: 800;

    letter-spacing:
      -0.035em;

    line-height: 1.2;
  }

  .profile-card__description {
    max-width: 700px;

    margin: 6px 0 0;

    color: var(--muted);

    font-size: 0.73rem;

    line-height: 1.65;
  }

  .profile-card__icon {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    border:
      2px solid
      var(--ink);

    background:
      var(--acid);

    color: var(--ink);
  }

  /* ========================================================================
     FORM GRID
  ======================================================================== */

  .profile-grid {
    display: grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap: 19px;

    padding: 23px;
  }

  .field {
    min-width: 0;
  }

  .field--full {
    grid-column:
      1 / -1;
  }

  /* ========================================================================
     FIELDS
  ======================================================================== */

  .field__label {
    display: inline-flex;
    align-items: center;

    gap: 4px;

    margin-bottom: 7px;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: 0.65rem;
    font-weight: 800;

    line-height: 1.3;
  }

  .field__required {
    color:
      var(--orange);
  }

  .field__hint {
    max-width: 700px;

    margin:
      0
      0
      8px;

    color:
      var(--muted);

    font-size: 0.61rem;

    line-height: 1.5;
  }

  .field__input,
  .field__select,
  .field__textarea {
    width: 100%;
    max-width: 100%;

    border:
      2px solid
      #bbbeb4;

    border-radius: 0;

    outline: none;

    color: var(--ink);

    background:
      var(--white);

    font:
      inherit;

    font-size: 0.72rem;

    transition:
      border-color 150ms ease,
      background 150ms ease,
      box-shadow 150ms ease;
  }

  .field__input,
  .field__select {
    min-height: 45px;

    padding:
      0
      11px;
  }

  .field__textarea {
    min-height: 145px;

    padding:
      11px;

    line-height: 1.65;

    resize: vertical;
  }

  .field__input:hover,
  .field__select:hover,
  .field__textarea:hover {
    border-color:
      #74786e;
  }

  .field__input:focus,
  .field__select:focus,
  .field__textarea:focus {
    border-color:
      var(--ink);

    box-shadow:
      4px 4px 0
      var(--acid);
  }

  .field__input::placeholder,
  .field__textarea::placeholder {
    color:
      #999d93;
  }

  .field__input[aria-invalid="true"],
  .field__select[aria-invalid="true"],
  .field__textarea[aria-invalid="true"] {
    border-color:
      var(--orange);

    box-shadow:
      3px 3px 0
      rgb(255 106 0 / 14%);
  }

  .field__input-wrap {
    position: relative;

    width: 100%;
  }

  .field__input-wrap > svg {
    position: absolute;

    top: 50%;
    left: 12px;

    z-index: 1;

    color: var(--muted);

    transform:
      translateY(-50%);

    pointer-events: none;
  }

  .field__input--with-icon {
    padding-left: 40px;
  }

  .field__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 10px;
  }

  .field__error {
    margin: 7px 0 0;

    color:
      #ad4300;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.54rem;

    line-height: 1.5;
  }

  .field__error[hidden] {
    display: none;
  }

  .field__error--coordinate {
    padding-left: 2px;
  }

  .field__counter {
    flex: 0 0 auto;

    margin-top: 7px;

    color:
      #8b8e86;

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.52rem;
  }

  /* ========================================================================
     STATUS CONTROL
  ======================================================================== */

  .status-control {
    display: flex;
    align-items: flex-start;

    gap: 9px;

    min-height: 45px;

    padding:
      8px
      10px;

    border:
      2px solid
      #c9cbc2;

    background:
      var(--paper);
  }

  .status-control__icon {
    width: 28px;
    height: 28px;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    background:
      var(--acid);

    color: var(--ink);
  }

  .status-control__copy {
    min-width: 0;
  }

  .status-control strong,
  .status-control span {
    display: block;
  }

  .status-control strong {
    color: var(--ink);

    font-size: 0.67rem;
    font-weight: 800;
  }

  .status-control span {
    margin-top: 3px;

    color: var(--muted);

    font-size: 0.55rem;

    line-height: 1.45;
  }

  /* ========================================================================
     COORDINATES
  ======================================================================== */

  .coordinates-notice {
    display: flex;
    align-items: flex-start;

    gap: 9px;

    padding:
      11px
      12px;

    border:
      1px solid
      #cdd2bd;

    background:
      #f6f8e4;

    color:
      #555b3e;

    font-size: 0.61rem;

    line-height: 1.6;
  }

  .coordinates-notice svg {
    flex: 0 0 auto;

    margin-top: 1px;

    color:
      var(--orange);
  }

  /* ========================================================================
     PUBLISH
  ======================================================================== */

  .profile-card--publish {
    padding: 19px;
  }

  .publish-box {
    display: flex;
    align-items: flex-start;

    gap: 11px;

    padding: 14px;

    border:
      1px solid
      #cad29d;

    background:
      #f6f8df;
  }

  .publish-box__icon {
    width: 39px;
    height: 39px;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    background:
      var(--ink);

    color:
      var(--acid);
  }

  .publish-box__content {
    min-width: 0;
  }

  .publish-box__content h2 {
    margin: 4px 0 0;

    color:
      var(--ink);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: 0.78rem;
    font-weight: 800;

    letter-spacing:
      -0.02em;
  }

  .publish-box__content p {
    max-width: 690px;

    margin: 4px 0 0;

    color:
      var(--muted);

    font-size: 0.61rem;

    line-height: 1.6;
  }

  /* ========================================================================
     ACTIONS
  ======================================================================== */

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    margin-top: 18px;
    padding-top: 17px;

    border-top:
      2px solid
      var(--ink);
  }

  .form-actions__back,
  .form-actions__submit {
    min-height: 44px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding:
      0
      14px;

    border:
      2px solid
      var(--ink);

    border-radius: 0;

    font:
      inherit;

    font-size: 0.6rem;
    font-weight: 800;

    letter-spacing: 0.01em;

    text-decoration: none;
    text-transform: uppercase;

    cursor: pointer;
  }

  .form-actions__back {
    color:
      var(--ink);

    background:
      transparent;
  }

  .form-actions__back:hover {
    background:
      var(--white);

    box-shadow:
      4px 4px 0
      var(--paper-3);
  }

  .form-actions__submit {
    color:
      var(--acid);

    background:
      var(--ink);

    box-shadow:
      5px 5px 0
      var(--acid);

    transition:
      transform 150ms ease,
      box-shadow 150ms ease,
      background 150ms ease;
  }

  .form-actions__submit:hover {
    background:
      var(--ink-3);

    transform:
      translate(
        -2px,
        -2px
      );

    box-shadow:
      7px 7px 0
      var(--acid);
  }

  .form-actions__submit:disabled {
    opacity: 0.55;

    cursor: wait;

    transform: none;

    box-shadow:
      5px 5px 0
      #afb58a;
  }

  .form-actions__back:focus-visible,
  .form-actions__submit:focus-visible {
    outline:
      3px solid
      var(--orange);

    outline-offset:
      3px;
  }

  .save-message {
    margin: 10px 0 0;

    color:
      var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.54rem;

    line-height: 1.5;

    text-align: right;
  }

  .save-message[hidden],
  .save-success[hidden] {
    display: none;
  }

  /* ========================================================================
     SUCCESS
  ======================================================================== */

  .save-success {
    padding:
      48px
      28px;

    border:
      2px solid
      var(--ink);

    background:
      linear-gradient(
        145deg,
        var(--acid),
        var(--paper)
      );

    box-shadow:
      8px 8px 0
      var(--ink);

    text-align: center;
  }

  .save-success__icon {
    width: 70px;
    height: 70px;

    display: inline-grid;
    place-items: center;

    border:
      2px solid
      var(--ink);

    background:
      var(--ink);

    color:
      var(--acid);
  }

  .save-success__eyebrow {
    margin-top: 18px;
  }

  .save-success h2 {
    max-width: 850px;

    margin: 8px auto 0;

    color:
      var(--ink);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size:
      clamp(
        1.45rem,
        3vw,
        2.25rem
      );

    font-weight: 800;

    letter-spacing:
      -0.045em;

    line-height: 1.05;

    text-transform: uppercase;
  }

  .save-success p {
    max-width: 650px;

    margin:
      12px auto 0;

    color:
      #4d533c;

    font-size: 0.72rem;

    line-height: 1.7;
  }

  .save-success__actions {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 24px;
  }

  /* ========================================================================
     RESPONSIVE
  ======================================================================== */

  @media (max-width: 900px) {
    .profile-hero {
      grid-template-columns:
        minmax(0, 1fr);
    }

    .profile-hero__status {
      width: min(100%, 360px);
    }
  }

  @media (max-width: 760px) {
    .profile-grid {
      grid-template-columns:
        1fr;
    }

    .field--full {
      grid-column:
        auto;
    }

    .profile-hero {
      padding: 22px;
    }

    .profile-hero__title {
      font-size:
        clamp(
          2rem,
          9vw,
          3rem
        );
    }

    .profile-card__header {
      padding: 19px;
    }

    .profile-grid {
      padding: 19px;
    }
  }

  @media (max-width: 640px) {
    .profile-page {
      padding:
        14px
        12px
        48px;
    }

    .profile-hero {
      padding: 18px;

      box-shadow:
        5px 5px 0
        var(--orange);
    }

    .profile-hero__description {
      font-size: 0.73rem;
    }

    .profile-hero__status {
      width: 100%;
      box-shadow:
        3px 3px 0
        var(--acid);
    }

    .profile-workspace {
      padding-top: 17px;
    }

    .profile-form {
      gap: 12px;
    }

    .profile-card__header {
      gap: 14px;
      padding: 17px;
    }

    .profile-card__title {
      font-size: 0.97rem;
    }

    .profile-card__description {
      font-size: 0.61rem;
    }

    .profile-card__icon {
      width: 37px;
      height: 37px;
    }

    .profile-grid {
      gap: 15px;
      padding: 17px;
    }

    .profile-card--publish {
      padding: 16px;
    }

    .publish-box {
      padding: 12px;
    }

    .form-actions {
      align-items: stretch;

      flex-direction: column-reverse;
    }

    .form-actions__back,
    .form-actions__submit {
      width: 100%;
    }

    .save-message {
      text-align: center;
    }

    .save-success {
      padding:
        36px
        18px;

      box-shadow:
        5px 5px 0
        var(--ink);
    }

    .save-success__actions {
      flex-direction: column;
    }

    .save-success__actions
      .form-actions__back,
    .save-success__actions
      .form-actions__submit {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field__input,
    .field__select,
    .field__textarea,
    .form-actions__submit {
      transition: none;
    }

    .form-actions__submit:hover {
      transform: none;
    }
  }
</style>

<script>
  const initializeOrganizationProfilePage =
    () => {
      const form =
        document.querySelector<HTMLFormElement>(
          "[data-profile-form]",
        );

      const successPanel =
        document.querySelector<HTMLElement>(
          "[data-save-success]",
        );

      const editProfileButton =
        document.querySelector<HTMLButtonElement>(
          "[data-edit-profile]",
        );

      const saveButton =
        document.querySelector<HTMLButtonElement>(
          "[data-save-button]",
        );

      const saveLabel =
        document.querySelector<HTMLElement>(
          "[data-save-label]",
        );

      const saveMessage =
        document.querySelector<HTMLElement>(
          "[data-save-message]",
        );

      const descriptionField =
        document.querySelector<HTMLTextAreaElement>(
          "[name='description']",
        );

      const descriptionCounter =
        document.querySelector<HTMLElement>(
          "[data-description-counter]",
        );

      if (
        !form ||
        form.dataset.initialized === "true"
      ) {
        return;
      }

      form.dataset.initialized = "true";

      const setFieldError = (
        fieldName: string,
        message: string,
      ) => {
        const field =
          form.querySelector<
            | HTMLInputElement
            | HTMLSelectElement
            | HTMLTextAreaElement
          >(
            `[name="${fieldName}"]`,
          );

        const error =
          form.querySelector<HTMLElement>(
            `[data-field-error="${fieldName}"]`,
          );

        if (field) {
          field.setAttribute(
            "aria-invalid",
            "true",
          );
        }

        if (error) {
          error.textContent = message;
          error.hidden = false;
        }
      };

      const clearFieldError = (
        fieldName: string,
      ) => {
        const field =
          form.querySelector<
            | HTMLInputElement
            | HTMLSelectElement
            | HTMLTextAreaElement
          >(
            `[name="${fieldName}"]`,
          );

        const error =
          form.querySelector<HTMLElement>(
            `[data-field-error="${fieldName}"]`,
          );

        if (field) {
          field.removeAttribute(
            "aria-invalid",
          );
        }

        if (error) {
          error.textContent = "";
          error.hidden = true;
        }
      };

      const clearAllErrors = () => {
        [
          "organizationName",
          "organizationType",
          "area",
          "address",
          "description",
        ].forEach(clearFieldError);

        const coordinateError =
          form.querySelector<HTMLElement>(
            "[data-coordinate-error]",
          );

        if (coordinateError) {
          coordinateError.textContent = "";
          coordinateError.hidden = true;
        }

        const latitude =
          form.elements.namedItem(
            "latitude",
          ) as HTMLInputElement | null;

        const longitude =
          form.elements.namedItem(
            "longitude",
          ) as HTMLInputElement | null;

        latitude?.removeAttribute(
          "aria-invalid",
        );

        longitude?.removeAttribute(
          "aria-invalid",
        );
      };

      const updateDescriptionCounter =
        () => {
          if (
            !descriptionField ||
            !descriptionCounter
          ) {
            return;
          }

          descriptionCounter.textContent =
            `${descriptionField.value.length} / 1500`;
        };

      const showSaveMessage = (
        message: string,
      ) => {
        if (!saveMessage) {
          return;
        }

        saveMessage.textContent = message;
        saveMessage.hidden = false;
      };

      const clearSaveMessage = () => {
        if (!saveMessage) {
          return;
        }

        saveMessage.textContent = "";
        saveMessage.hidden = true;
      };

      const validateCoordinates = () => {
        const latitude =
          form.elements.namedItem(
            "latitude",
          ) as HTMLInputElement | null;

        const longitude =
          form.elements.namedItem(
            "longitude",
          ) as HTMLInputElement | null;

        const latitudeValue =
          latitude?.value.trim() ?? "";

        const longitudeValue =
          longitude?.value.trim() ?? "";

        if (
          latitudeValue === "" &&
          longitudeValue === ""
        ) {
          return true;
        }

        if (
          latitudeValue === "" ||
          longitudeValue === ""
        ) {
          return false;
        }

        const lat = Number(
          latitudeValue,
        );

        const lng = Number(
          longitudeValue,
        );

        return (
          Number.isFinite(lat) &&
          Number.isFinite(lng) &&
          lat >= -90 &&
          lat <= 90 &&
          lng >= -180 &&
          lng <= 180
        );
      };

      const validateProfileForm = () => {
        clearAllErrors();

        const organizationName =
          form.elements.namedItem(
            "organizationName",
          ) as HTMLInputElement | null;

        const organizationType =
          form.elements.namedItem(
            "organizationType",
          ) as HTMLSelectElement | null;

        const area =
          form.elements.namedItem(
            "area",
          ) as HTMLSelectElement | null;

        const address =
          form.elements.namedItem(
            "address",
          ) as HTMLInputElement | null;

        let valid = true;

        if (
          !organizationName ||
          organizationName.value.trim()
            .length < 2
        ) {
          setFieldError(
            "organizationName",
            "Nama organisasi minimal 2 karakter.",
          );

          valid = false;
        }

        if (
          !organizationType ||
          organizationType.value === ""
        ) {
          setFieldError(
            "organizationType",
            "Silakan pilih jenis organisasi.",
          );

          valid = false;
        }

        if (
          !area ||
          area.value === ""
        ) {
          setFieldError(
            "area",
            "Silakan pilih area atau kecamatan.",
          );

          valid = false;
        }

        if (
          !address ||
          address.value.trim()
            .length < 5
        ) {
          setFieldError(
            "address",
            "Alamat organisasi perlu diisi.",
          );

          valid = false;
        }

        if (
          descriptionField &&
          descriptionField.value
            .trim()
            .length > 0 &&
          descriptionField.value
            .trim()
            .length < 20
        ) {
          setFieldError(
            "description",
            "Deskripsi yang diisi minimal 20 karakter.",
          );

          valid = false;
        }

        if (!validateCoordinates()) {
          const latitude =
            form.elements.namedItem(
              "latitude",
            ) as HTMLInputElement | null;

          const longitude =
            form.elements.namedItem(
              "longitude",
            ) as HTMLInputElement | null;

          latitude?.setAttribute(
            "aria-invalid",
            "true",
          );

          longitude?.setAttribute(
            "aria-invalid",
            "true",
          );

          const coordinateError =
            form.querySelector<HTMLElement>(
              "[data-coordinate-error]",
            );

          if (coordinateError) {
            coordinateError.textContent =
              "Latitude dan longitude harus diisi berpasangan dan berada dalam rentang yang valid.";

            coordinateError.hidden = false;
          }

          valid = false;
        }

        if (!valid) {
          const firstInvalid =
            form.querySelector<HTMLElement>(
              "[aria-invalid='true']",
            );

          firstInvalid?.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });

          firstInvalid?.focus();
        }

        return valid;
      };

      const buildProfilePayload = () => {
        const formData =
          new FormData(form);

        const latitudeRaw =
          String(
            formData.get("latitude") ??
              "",
          ).trim();

        const longitudeRaw =
          String(
            formData.get("longitude") ??
              "",
          ).trim();

        const latitude =
          latitudeRaw !== ""
            ? Number(latitudeRaw)
            : undefined;

        const longitude =
          longitudeRaw !== ""
            ? Number(longitudeRaw)
            : undefined;

        return {
          name: String(
            formData.get(
              "organizationName",
            ) ?? "",
          ).trim(),

          type: String(
            formData.get(
              "organizationType",
            ) ?? "",
          ),

          description: String(
            formData.get(
              "description",
            ) ?? "",
          ).trim(),

          location: {
            area: String(
              formData.get("area") ??
                "",
            ),

            address: String(
              formData.get(
                "address",
              ) ?? "",
            ).trim(),

            latitude:
              latitude !== undefined &&
              Number.isFinite(latitude)
                ? latitude
                : undefined,

            longitude:
              longitude !== undefined &&
              Number.isFinite(longitude)
                ? longitude
                : undefined,
          },

          contact: {
            name: String(
              formData.get(
                "contactName",
              ) ?? "",
            ).trim(),

            phone: String(
              formData.get("phone") ??
                "",
            ).trim(),

            email: String(
              formData.get("email") ??
                "",
            ).trim(),

            website: String(
              formData.get(
                "website",
              ) ?? "",
            ).trim(),
          },

          updatedAt:
            new Date().toISOString(),
        };
      };

      const handleSubmit = async (
        event: SubmitEvent,
      ) => {
        event.preventDefault();

        clearSaveMessage();

        if (!validateProfileForm()) {
          return;
        }

        const payload =
          buildProfilePayload();

        if (saveButton) {
          saveButton.disabled = true;
        }

        if (saveLabel) {
          saveLabel.textContent =
            "Menyiapkan...";
        }

        showSaveMessage(
          "Memeriksa informasi profil...",
        );

        await Promise.resolve();

        window.dispatchEvent(
          new CustomEvent(
            "binsight:organization-profile-save",
            {
              detail: payload,
            },
          ),
        );

        form.hidden = true;

        if (successPanel) {
          successPanel.hidden = false;

          successPanel.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }

        clearSaveMessage();
      };

      const showEditForm = () => {
        form.hidden = false;

        if (successPanel) {
          successPanel.hidden = true;
        }

        if (saveButton) {
          saveButton.disabled = false;
        }

        if (saveLabel) {
          saveLabel.textContent =
            "Simpan profil";
        }

        clearSaveMessage();

        form.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      };

      form.addEventListener(
        "submit",
        handleSubmit,
      );

      editProfileButton?.addEventListener(
        "click",
        showEditForm,
      );

      descriptionField?.addEventListener(
        "input",
        updateDescriptionCounter,
      );

      form
        .querySelectorAll<
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
        >(
          "input, textarea, select",
        )
        .forEach((field) => {
          const clearError = () => {
            const name =
              field.getAttribute(
                "name",
              );

            if (name) {
              clearFieldError(name);
            }

            if (
              name === "latitude" ||
              name === "longitude"
            ) {
              field.removeAttribute(
                "aria-invalid",
              );

              const coordinateError =
                form.querySelector<HTMLElement>(
                  "[data-coordinate-error]",
                );

              if (coordinateError) {
                coordinateError.textContent =
                  "";

                coordinateError.hidden =
                  true;
              }
            }
          };

          field.addEventListener(
            "input",
            clearError,
          );

          field.addEventListener(
            "change",
            clearError,
          );
        });

      updateDescriptionCounter();
    };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeOrganizationProfilePage,
      { once: true },
    );
  } else {
    initializeOrganizationProfilePage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeOrganizationProfilePage,
  );
</script>