---
/**
 * ============================================================================
 * BINSIGHT - ORGANIZATION PRODUCTS
 * ============================================================================
 * Products / outputs produced by an organization.
 *
 * Design baseline:
 * - BINSIGHT brutalist editorial system.
 * - OrganizationLayout owns the global Navbar and Footer.
 * - Workspace header and sidebar are hidden on this page only.
 * - No fabricated operational figures.
 * - Browser validation only.
 * - CustomEvent is emitted as the integration hook for future persistence.
 * - Client script is self-contained and does not reference frontmatter values.
 * ============================================================================
 */

import {
  ArrowLeft,
  ArrowRight,
  CircleCheck,
  ExternalLink,
  Leaf,
  Package,
  Plus,
  Save,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import OrganizationLayout from "@layouts/OrganizationLayout.astro";

const productTypes = [
  {
    id: "recycled-material",
    index: "01",
    label: "Material hasil olahan",
    description:
      "Material yang dihasilkan setelah melalui proses pengolahan atau pemilahan.",
  },
  {
    id: "reusable-product",
    index: "02",
    label: "Produk guna ulang",
    description:
      "Produk yang masih dapat digunakan kembali atau diperpanjang masa pakainya.",
  },
  {
    id: "recovered-material",
    index: "03",
    label: "Material recovery",
    description:
      "Material atau nilai yang berhasil dipulihkan dari aliran sampah.",
  },
  {
    id: "compost",
    index: "04",
    label: "Kompos",
    description:
      "Hasil pengolahan material organik melalui proses yang sesuai.",
  },
  {
    id: "other",
    index: "05",
    label: "Hasil lainnya",
    description:
      "Output pengelolaan lain yang relevan dan benar-benar dihasilkan organisasi.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Produk dan Hasil - BINSIGHT",
  description:
    "Kelola informasi produk, output, dan hasil pengelolaan sampah organisasi melalui portal organisasi BINSIGHT.",
  url: "https://binsight.id/organization/products",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT - Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<OrganizationLayout
  title="Produk dan Hasil"
  description="Kelola informasi produk dan hasil pengelolaan sampah organisasi."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="organization-products-page">

    <!-- ================================================================== -->
    <!-- INTRO -->
    <!-- ================================================================== -->

    <section
      class="products-intro"
      aria-labelledby="products-page-title"
    >
      <div class="products-container products-intro__inner">

        <div class="products-intro__main">

          <span class="products-intro__eyebrow">
            ORGANIZATION / PRODUCTS
          </span>

          <h1
            id="products-page-title"
            class="products-intro__title"
          >
            Nyatakan hasil yang benar-benar ada.
          </h1>

          <p class="products-intro__description">
            Gunakan halaman ini untuk mendokumentasikan material recovery,
            produk guna ulang, kompos, dan output lain yang memang dihasilkan
            organisasi.
          </p>

        </div>

        <div class="products-intro__actions">

          <a
            class="products-intro__back"
            href="/organization"
          >
            <ArrowLeft
              size={16}
              stroke-width={2}
              aria-hidden="true"
            />
            <span>Kembali ke portal</span>
          </a>

          <a
            class="products-intro__public"
            href="/organizations"
          >
            <ExternalLink
              size={16}
              stroke-width={1.9}
              aria-hidden="true"
            />
            <span>Lihat organisasi publik</span>
          </a>

        </div>

      </div>
    </section>

    <!-- ================================================================== -->
    <!-- CONTENT -->
    <!-- ================================================================== -->

    <section
      class="products-content"
      aria-label="Pengelolaan produk dan hasil organisasi"
    >
      <div class="products-container">

        <div class="products-layout">

          <!-- ============================================================ -->
          <!-- MAIN -->
          <!-- ============================================================ -->

          <div class="products-main">

            <form
              id="organization-products-form"
              class="products-form"
              data-products-form
              novalidate
            >

              <!-- ======================================================== -->
              <!-- 01 / OUTPUT TYPES -->
              <!-- ======================================================== -->

              <section
                class="products-card"
                aria-labelledby="product-types-title"
              >

                <header class="products-card__header">

                  <div class="products-card__heading">

                    <span class="products-card__eyebrow">
                      01 / OUTPUT TYPES
                    </span>

                    <h2
                      id="product-types-title"
                      class="products-card__title"
                    >
                      Tambahkan produk atau hasil
                    </h2>

                    <p class="products-card__description">
                      Pilih semua jenis output yang benar-benar dihasilkan
                      organisasi dari aktivitas pengelolaan material.
                    </p>

                  </div>

                  <div
                    class="products-card__icon"
                    aria-hidden="true"
                  >
                    <Package
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>

                </header>

                <div class="products-notice">

                  <div
                    class="products-notice__icon"
                    aria-hidden="true"
                  >
                    <Leaf
                      size={18}
                      stroke-width={2}
                    />
                  </div>

                  <div>
                    <strong>
                      Fokus pada hasil yang benar-benar tersedia
                    </strong>

                    <p>
                      Produk atau output sebaiknya menggambarkan kegiatan
                      nyata organisasi, bukan target atau rencana yang belum
                      terealisasi.
                    </p>
                  </div>

                </div>

                <div class="product-builder">

                  <div class="product-builder__top">

                    <div>
                      <span class="product-builder__eyebrow">
                        PRODUCT TYPES
                      </span>

                      <h3>
                        Pilih kategori hasil
                      </h3>
                    </div>

                    <span
                      class="product-builder__count"
                      data-product-count
                    >
                      0 produk
                    </span>

                  </div>

                  <div
                    class="product-type-grid"
                    data-product-type-grid
                  >
                    {
                      productTypes.map((type) => (
                        <button
                          type="button"
                          class="product-type-option"
                          data-product-type={type.id}
                          aria-pressed="false"
                        >

                          <span
                            class="product-type-option__index"
                            aria-hidden="true"
                          >
                            {type.index}
                          </span>

                          <span
                            class="product-type-option__icon"
                            aria-hidden="true"
                          >
                            <Package
                              size={18}
                              stroke-width={1.9}
                            />
                          </span>

                          <span class="product-type-option__body">

                            <strong>
                              {type.label}
                            </strong>

                            <small>
                              {type.description}
                            </small>

                          </span>

                          <span
                            class="product-type-option__action"
                            aria-hidden="true"
                          >
                            <Plus
                              size={16}
                              stroke-width={2}
                            />
                          </span>

                        </button>
                      ))
                    }
                  </div>

                  <p
                    class="field-error"
                    data-product-type-error
                    role="alert"
                    hidden
                  ></p>

                </div>

                <div class="product-list-section">

                  <div class="product-list-section__header">

                    <div>
                      <span class="product-builder__eyebrow">
                        SELECTED OUTPUT
                      </span>

                      <h3>
                        Produk terpilih
                      </h3>
                    </div>

                    <span
                      class="product-list-section__count"
                      data-selected-product-count
                    >
                      0 produk
                    </span>

                  </div>

                  <div
                    class="product-list"
                    data-product-list
                  >

                    <div
                      class="product-list-empty"
                      data-product-empty
                    >
                      <div
                        class="product-list-empty__icon"
                        aria-hidden="true"
                      >
                        <Package
                          size={22}
                          stroke-width={1.8}
                        />
                      </div>

                      <div>
                        <strong>
                          Belum ada produk yang dipilih.
                        </strong>

                        <span>
                          Pilih satu atau lebih kategori output di atas.
                        </span>
                      </div>
                    </div>

                  </div>

                </div>

              </section>

              <!-- ======================================================== -->
              <!-- 02 / DESCRIPTION -->
              <!-- ======================================================== -->

              <section
                class="products-card"
                aria-labelledby="products-description-title"
              >

                <header class="products-card__header">

                  <div class="products-card__heading">

                    <span class="products-card__eyebrow">
                      02 / DESCRIPTION
                    </span>

                    <h2
                      id="products-description-title"
                      class="products-card__title"
                    >
                      Jelaskan hasil pengelolaan
                    </h2>

                    <p class="products-card__description">
                      Berikan konteks singkat tentang output yang dihasilkan.
                    </p>

                  </div>

                  <div
                    class="products-card__icon"
                    aria-hidden="true"
                  >
                    <Leaf
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>

                </header>

                <div class="field">

                  <div class="field__label-row">

                    <label
                      class="field__label"
                      for="productsDescription"
                    >
                      Deskripsi produk
                    </label>

                    <span class="field__required">
                      REQUIRED
                    </span>

                  </div>

                  <p
                    class="field__hint"
                    id="productsDescriptionHint"
                  >
                    Jelaskan bentuk hasil, penggunaan umum, atau konteks lain
                    yang benar-benar dapat dibagikan kepada publik.
                  </p>

                  <textarea
                    id="productsDescription"
                    name="productsDescription"
                    class="field__textarea"
                    rows="8"
                    maxlength="2200"
                    required
                    placeholder="Contoh: Material yang telah dipilah dan diproses dapat diteruskan sebagai bahan baku atau produk sesuai karakteristik material."
                    aria-describedby="productsDescriptionHint productsDescriptionCounter productsDescriptionError"
                    data-products-description
                  ></textarea>

                  <div class="field__footer">

                    <p
                      id="productsDescriptionError"
                      class="field-error"
                      data-description-error
                      role="alert"
                      hidden
                    ></p>

                    <span
                      id="productsDescriptionCounter"
                      class="field__counter"
                      data-products-description-counter
                    >
                      0 / 2200
                    </span>

                  </div>

                </div>

                <div class="product-guidelines">

                  <div class="product-guideline">

                    <div
                      class="product-guideline__icon"
                      aria-hidden="true"
                    >
                      <CircleCheck
                        size={17}
                        stroke-width={2}
                      />
                    </div>

                    <div>
                      <strong>
                        Jelaskan output secara spesifik
                      </strong>

                      <span>
                        Gunakan istilah yang mudah dipahami dan sesuai dengan
                        hasil pengelolaan yang tersedia.
                      </span>
                    </div>

                  </div>

                  <div class="product-guideline">

                    <div
                      class="product-guideline__icon"
                      aria-hidden="true"
                    >
                      <ShieldCheck
                        size={17}
                        stroke-width={2}
                      />
                    </div>

                    <div>
                      <strong>
                        Hindari klaim yang belum dapat dibuktikan
                      </strong>

                      <span>
                        Jangan menampilkan kapasitas, kualitas, atau penggunaan
                        tertentu apabila belum benar-benar tersedia.
                      </span>
                    </div>

                  </div>

                </div>

              </section>

              <!-- ======================================================== -->
              <!-- 03 / REFERENCE -->
              <!-- ======================================================== -->

              <section
                class="products-card products-card--reference"
                aria-labelledby="reference-title"
              >

                <header class="products-card__header">

                  <div class="products-card__heading">

                    <span class="products-card__eyebrow">
                      03 / REFERENCE
                    </span>

                    <h2
                      id="reference-title"
                      class="products-card__title"
                    >
                      Referensi produk
                    </h2>

                    <p class="products-card__description">
                      Tambahkan URL publik sebagai referensi tambahan.
                    </p>

                  </div>

                  <div
                    class="products-card__icon"
                    aria-hidden="true"
                  >
                    <ExternalLink
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>

                </header>

                <div class="field field--reference">

                  <div class="field__label-row">

                    <label
                      class="field__label"
                      for="productWebsite"
                    >
                      URL referensi
                    </label>

                    <span class="field__optional">
                      OPTIONAL
                    </span>

                  </div>

                  <p
                    class="field__hint"
                    id="productWebsiteHint"
                  >
                    Kosongkan jika tidak ada. Jika diisi, gunakan URL publik
                    yang benar-benar dapat diakses.
                  </p>

                  <div class="field__input-wrap field__input-wrap--url">

                    <span
                      class="field__input-prefix"
                      aria-hidden="true"
                    >
                      <ExternalLink
                        size={16}
                        stroke-width={1.9}
                      />
                    </span>

                    <input
                      id="productWebsite"
                      name="productWebsite"
                      class="field__input field__input--url"
                      type="url"
                      maxlength="300"
                      autocomplete="url"
                      inputmode="url"
                      placeholder="https://contoh.com/produk"
                      aria-describedby="productWebsiteHint productWebsiteError"
                    />

                  </div>

                  <p
                    id="productWebsiteError"
                    class="field-error"
                    data-website-error
                    role="alert"
                    hidden
                  ></p>

                </div>

              </section>

              <!-- ======================================================== -->
              <!-- SAVE -->
              <!-- ======================================================== -->

              <section
                class="products-card products-card--save"
              >

                <div class="save-box">

                  <div
                    class="save-box__icon"
                    aria-hidden="true"
                  >
                    <Save
                      size={20}
                      stroke-width={2}
                    />
                  </div>

                  <div class="save-box__content">

                    <span class="save-box__eyebrow">
                      SIMULATION MODE
                    </span>

                    <h2>
                      Simulasikan penyimpanan data
                    </h2>

                    <p>
                      Tidak membutuhkan backend. Data diproses di browser
                      untuk preview interaksi halaman dan dikirim melalui
                      integration hook BINSIGHT.
                    </p>

                  </div>

                </div>

                <div class="form-actions">

                  <button
                    type="button"
                    class="form-actions__back"
                    data-reset-products
                  >
                    Reset
                  </button>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-save-products
                  >
                    <Save
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-save-label>
                      Simpan produk
                    </span>

                    <ArrowRight
                      size={16}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </button>

                </div>

                <p
                  class="save-message"
                  data-save-message
                  aria-live="polite"
                  hidden
                ></p>

              </section>

            </form>

            <!-- ========================================================== -->
            <!-- SUCCESS -->
            <!-- ========================================================== -->

            <section
              class="save-success"
              data-save-success
              hidden
              aria-labelledby="save-success-title"
            >

              <div
                class="save-success__index"
                aria-hidden="true"
              >
                04
              </div>

              <div class="save-success__icon">
                <CircleCheck
                  size={32}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                PRODUCT READY
              </span>

              <h2 id="save-success-title">
                Informasi produk berhasil dipersiapkan
              </h2>

              <p>
                Data produk dan hasil telah melalui pemeriksaan dasar pada
                browser dan siap diteruskan ke proses penyimpanan atau
                verifikasi.
              </p>

              <div class="save-success__actions">

                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  <span>Kembali ke portal</span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-products
                >
                  Edit kembali
                </button>

              </div>

            </section>

          </div>

          <!-- ============================================================ -->
          <!-- SIDEBAR -->
          <!-- ============================================================ -->

          <aside
            class="products-sidebar"
            data-products-sidebar
            aria-label="Ringkasan produk"
          >

            <section
              class="sidebar-card sidebar-card--highlight"
            >

              <div
                class="sidebar-card__icon"
                aria-hidden="true"
              >
                <Package
                  size={20}
                  stroke-width={2}
                />
              </div>

              <span class="sidebar-card__eyebrow">
                OUTPUT SUMMARY
              </span>

              <h2>
                Produk &amp; hasil
              </h2>

              <div class="summary-number">

                <strong data-sidebar-product-count>
                  0
                </strong>

                <span>
                  kategori output
                </span>

              </div>

              <div class="summary-bar">
                <span data-summary-bar></span>
              </div>

              <div class="summary-flow">

                <span>INPUT</span>

                <b aria-hidden="true">+</b>

                <span>PROCESS</span>

                <b aria-hidden="true">+</b>

                <strong>OUTPUT</strong>

              </div>

              <p>
                Pilih hanya output yang benar-benar tersedia sebagai hasil
                aktivitas pengelolaan organisasi.
              </p>

            </section>

            <section class="sidebar-card">

              <span class="sidebar-card__eyebrow">
                PRINCIPLES
              </span>

              <h2>
                Tampilkan nilai yang nyata.
              </h2>

              <div class="sidebar-check-list">

                <div class="sidebar-check">

                  <span class="sidebar-check__index">
                    01
                  </span>

                  <span>
                    Gunakan nama output yang spesifik.
                  </span>

                </div>

                <div class="sidebar-check">

                  <span class="sidebar-check__index">
                    02
                  </span>

                  <span>
                    Jelaskan hasil berdasarkan proses nyata.
                  </span>

                </div>

                <div class="sidebar-check">

                  <span class="sidebar-check__index">
                    03
                  </span>

                  <span>
                    Hindari klaim yang tidak terverifikasi.
                  </span>

                </div>

              </div>

            </section>

            <section class="sidebar-card sidebar-card--warning">

              <div
                class="sidebar-warning__icon"
                aria-hidden="true"
              >
                <TriangleAlert
                  size={18}
                  stroke-width={2}
                />
              </div>

              <div>

                <span class="sidebar-card__eyebrow">
                  VALIDATION
                </span>

                <strong>
                  Gunakan data yang benar.
                </strong>

                <p>
                  Minimal satu kategori dan deskripsi 20 karakter diperlukan.
                  URL bersifat opsional, tetapi harus valid apabila diisi.
                </p>

              </div>

            </section>

            <section class="sidebar-card sidebar-card--next">

              <span class="sidebar-card__eyebrow">
                ORGANIZATION DATA
              </span>

              <h2>
                Lengkapi informasi lain.
              </h2>

              <a href="/organization/profile">
                <span>Profil organisasi</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/waste">
                <span>Sampah dikelola</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/process">
                <span>Proses pengelolaan</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

            </section>

          </aside>

        </div>

      </div>
    </section>

  </main>
</OrganizationLayout>

<style>
  /* ==========================================================================
     ORGANIZATION LAYOUT OVERRIDE
     ========================================================================== */

  :global(.organization-layout__header) {
    display: none !important;
  }

  :global(.organization-layout__sidebar) {
    display: none !important;
  }

  :global(.organization-layout__mobile-topbar) {
    display: none !important;
  }

  :global(.organization-layout__main) {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    grid-column: 1 / -1 !important;
  }

  :global(.organization-layout__main-container) {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  :global(.organization-layout:has(.organization-products-page)) {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  :global(.organization-layout:has(.organization-products-page))
    .organization-layout__main {
    grid-column: 1 / -1 !important;
    width: 100% !important;
  }

  /* ==========================================================================
     PAGE TOKENS
     ========================================================================== */

  .organization-products-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --muted-dark: #50554d;
    --orange: #ff6a00;
    --line: #b7b8ad;
    --danger: #b43d00;

    min-height: 100%;
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .organization-products-page *,
  .organization-products-page *::before,
  .organization-products-page *::after {
    box-sizing: border-box;
  }

  .organization-products-page a,
  .organization-products-page button,
  .organization-products-page input,
  .organization-products-page textarea {
    -webkit-tap-highlight-color: transparent;
  }

  .organization-products-page
    button:focus-visible,
  .organization-products-page
    a:focus-visible,
  .organization-products-page
    input:focus-visible,
  .organization-products-page
    textarea:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 4px;
  }

  /* ==========================================================================
     CONTAINER
     ========================================================================== */

  .products-container {
    width: min(1240px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* ==========================================================================
     INTRO
     ========================================================================== */

  .products-intro {
    position: relative;
    overflow: hidden;
    color: var(--white);
    background: var(--ink);
    border-bottom: 8px solid var(--acid);
  }

  .products-intro::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(
        rgb(255 255 255 / 4%) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgb(255 255 255 / 4%) 1px,
        transparent 1px
      );
    background-size: 26px 26px;
  }

  .products-intro__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 42px;
    padding: 58px 0 62px;
  }

  .products-intro__main {
    min-width: 0;
  }

  .products-intro__eyebrow,
  .products-card__eyebrow,
  .product-builder__eyebrow,
  .save-box__eyebrow,
  .sidebar-card__eyebrow,
  .save-success__eyebrow {
    display: block;
    color: var(--orange);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .products-intro__title {
    max-width: 960px;
    margin: 15px 0 0;
    color: var(--white);
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(2.7rem, 5.5vw, 6.1rem);
    font-weight: 900;
    letter-spacing: -0.085em;
    line-height: 0.86;
    text-transform: uppercase;
  }

  .products-intro__description {
    max-width: 760px;
    margin: 22px 0 0;
    padding-left: 15px;
    color: #d8d9d0;
    border-left: 7px solid var(--acid);
    font-size: 0.86rem;
    line-height: 1.75;
  }

  .products-intro__actions {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 9px;
  }

  .products-intro__back,
  .products-intro__public {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 45px;
    padding: 0 14px;
    border: 2px solid var(--white);
    border-radius: 0;
    font-size: 0.6rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      transform 120ms steps(2, end),
      background 120ms linear,
      color 120ms linear,
      box-shadow 120ms steps(2, end);
  }

  .products-intro__back {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--ink);
    box-shadow: 6px 6px 0 var(--orange);
  }

  .products-intro__public {
    color: var(--white);
    background: transparent;
  }

  .products-intro__back:hover,
  .products-intro__public:hover {
    transform: translate(-2px, -2px);
  }

  .products-intro__back:hover {
    background: var(--acid-soft);
    box-shadow: 8px 8px 0 var(--orange);
  }

  .products-intro__public:hover {
    color: var(--ink);
    background: var(--white);
  }

  /* ==========================================================================
     CONTENT
     ========================================================================== */

  .products-content {
    padding: 34px 0 86px;
    background:
      repeating-linear-gradient(
        0deg,
        rgb(9 10 8 / 2.5%) 0 1px,
        transparent 1px 8px
      ),
      var(--paper-2);
  }

  .products-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      315px;
    align-items: start;
    gap: 22px;
  }

  .products-main {
    min-width: 0;
  }

  .products-form {
    display: grid;
    gap: 16px;
  }

  /* ==========================================================================
     CARD
     ========================================================================== */

  .products-card,
  .sidebar-card,
  .save-success {
    border: 3px solid var(--ink);
    border-radius: 0;
    background: var(--white);
    box-shadow: 7px 7px 0 rgb(9 10 8 / 10%);
  }

  .products-card {
    overflow: hidden;
  }

  .products-card[hidden],
  .save-success[hidden],
  .products-sidebar[hidden] {
    display: none !important;
  }

  .products-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 23px 24px;
    border-bottom: 3px solid var(--ink);
  }

  .products-card__heading {
    min-width: 0;
  }

  .products-card__title {
    margin: 8px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .products-card__description {
    max-width: 720px;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.68;
  }

  .products-card__icon {
    display: grid;
    width: 45px;
    height: 45px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
  }

  /* ==========================================================================
     NOTICE
     ========================================================================== */

  .products-notice {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin: 20px 24px 0;
    padding: 13px;
    border: 2px solid var(--ink);
    background: var(--acid-soft);
  }

  .products-notice__icon {
    display: grid;
    width: 33px;
    height: 33px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
  }

  .products-notice strong,
  .products-notice p {
    display: block;
  }

  .products-notice strong {
    color: var(--ink);
    font-size: 0.67rem;
    font-weight: 900;
  }

  .products-notice p {
    margin: 4px 0 0;
    color: var(--muted-dark);
    font-size: 0.59rem;
    line-height: 1.55;
  }

  /* ==========================================================================
     PRODUCT BUILDER
     ========================================================================== */

  .product-builder {
    padding: 23px 24px 0;
  }

  .product-builder__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 15px;
  }

  .product-builder h3,
  .product-list-section h3 {
    margin: 6px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .product-builder__count,
  .product-list-section__count {
    flex: 0 0 auto;
    padding: 6px 8px;
    color: var(--acid);
    background: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-type-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 17px;
  }

  .product-type-option {
    position: relative;
    display: grid;
    grid-template-columns:
      32px
      37px
      minmax(0, 1fr)
      29px;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 13px;
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--white);
    cursor: pointer;
    text-align: left;
    transition:
      transform 120ms ease,
      background 120ms linear,
      color 120ms linear,
      box-shadow 120ms ease;
  }

  .product-type-option:hover {
    background: var(--acid-soft);
    box-shadow: 6px 6px 0 var(--orange);
    transform: translate(-2px, -2px);
  }

  .product-type-option[aria-pressed="true"] {
    color: var(--ink);
    background: var(--acid);
    box-shadow: 5px 5px 0 var(--orange);
  }

  .product-type-option__index {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.54rem;
    font-weight: 900;
  }

  .product-type-option__icon {
    display: grid;
    width: 37px;
    height: 37px;
    place-items: center;
    color: var(--acid);
    border: 2px solid var(--ink);
    background: var(--ink);
  }

  .product-type-option[aria-pressed="true"]
    .product-type-option__icon {
    color: var(--ink);
    background: var(--white);
  }

  .product-type-option__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .product-type-option__body strong {
    color: currentColor;
    font-size: 0.69rem;
    font-weight: 900;
  }

  .product-type-option__body small {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.58rem;
    line-height: 1.5;
  }

  .product-type-option[aria-pressed="true"]
    .product-type-option__body small {
    color: var(--muted-dark);
  }

  .product-type-option__action {
    display: grid;
    width: 29px;
    height: 29px;
    place-items: center;
    color: var(--ink);
    border: 2px solid var(--ink);
    background: var(--white);
  }

  .product-type-option[aria-pressed="true"]
    .product-type-option__action {
    color: var(--acid);
    background: var(--ink);
  }

  /* ==========================================================================
     PRODUCT LIST
     ========================================================================== */

  .product-list-section {
    padding: 25px 24px 24px;
  }

  .product-list-section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 15px;
    padding-top: 22px;
    border-top: 3px solid var(--ink);
  }

  .product-list {
    display: grid;
    gap: 9px;
    margin-top: 16px;
  }

  .product-list-empty {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 112px;
    padding: 17px;
    color: var(--muted);
    border: 2px dashed var(--ink);
    background: var(--paper);
  }

  .product-list-empty__icon {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
  }

  .product-list-empty strong,
  .product-list-empty span {
    display: block;
  }

  .product-list-empty strong {
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 900;
  }

  .product-list-empty span {
    margin-top: 4px;
    font-size: 0.58rem;
    line-height: 1.55;
  }

  .product-item {
    display: grid;
    grid-template-columns:
      38px
      minmax(0, 1fr)
      auto;
    align-items: center;
    gap: 11px;
    padding: 12px;
    border: 2px solid var(--ink);
    background: var(--white);
  }

  .product-item__index {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.55rem;
    font-weight: 900;
  }

  .product-item__body {
    min-width: 0;
  }

  .product-item__body strong,
  .product-item__body span {
    display: block;
  }

  .product-item__body strong {
    overflow-wrap: anywhere;
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 900;
  }

  .product-item__body span {
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.58rem;
    line-height: 1.5;
  }

  .product-item__remove {
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    color: var(--ink);
    border: 2px solid var(--ink);
    background: var(--white);
    cursor: pointer;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.48rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .product-item__remove:hover {
    color: var(--white);
    background: var(--orange);
  }

  /* ==========================================================================
     FIELD
     ========================================================================== */

  .field {
    padding: 23px 24px 24px;
  }

  .field--reference {
    padding-bottom: 30px;
  }

  .field__label-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .field__label {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 900;
  }

  .field__required,
  .field__optional {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 20px;
    padding: 0 6px;
    border: 1px solid var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.44rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .field__required {
    color: var(--ink);
    background: var(--acid);
  }

  .field__optional {
    color: var(--muted-dark);
    background: var(--paper-2);
  }

  .field__hint {
    max-width: 720px;
    margin: 7px 0 10px;
    color: var(--muted);
    font-size: 0.61rem;
    line-height: 1.58;
  }

  .field__input-wrap {
    position: relative;
    display: block;
    width: 100%;
    min-height: 48px;
    margin: 0 0 4px;
  }

  .field__input-wrap--url {
    min-height: 50px;
    margin-bottom: 6px;
  }

  .field__input-prefix {
    position: absolute;
    top: 50%;
    left: 12px;
    z-index: 2;
    display: grid;
    width: 27px;
    height: 27px;
    place-items: center;
    color: var(--muted);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .field__textarea,
  .field__input {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    color: var(--ink);
    border: 2px solid var(--line);
    border-radius: 0;
    outline: none;
    background: var(--white);
    font: inherit;
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease,
      background 140ms ease;
  }

  .field__input {
    height: 48px;
    min-height: 48px;
    padding: 0 13px;
    font-size: 0.74rem;
    line-height: 1;
  }

  .field__input--url {
    height: 50px;
    min-height: 50px;
    padding-top: 0;
    padding-right: 13px;
    padding-bottom: 0;
    padding-left: 45px;
    line-height: 50px;
  }

  .field__textarea {
    min-height: 156px;
    padding: 12px;
    resize: vertical;
    font-size: 0.74rem;
    line-height: 1.65;
  }

  .field__input:hover,
  .field__textarea:hover {
    border-color: var(--muted-dark);
  }

  .field__input:focus,
  .field__textarea:focus {
    border-color: var(--ink);
    box-shadow: 4px 4px 0 var(--acid);
  }

  .field__input[aria-invalid="true"],
  .field__textarea[aria-invalid="true"] {
    border-color: var(--orange);
    box-shadow:
      4px 4px 0
      rgb(255 106 0 / 12%);
  }

  .field__input::placeholder,
  .field__textarea::placeholder {
    color: #999d93;
    opacity: 1;
  }

  .field__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .field__counter {
    flex: 0 0 auto;
    margin-top: 7px;
    color: #8b8e86;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.54rem;
  }

  .field-error {
    margin: 8px 0 0;
    color: var(--danger);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.55rem;
    line-height: 1.5;
  }

  .field-error[hidden] {
    display: none;
  }

  /* ==========================================================================
     GUIDELINES
     ========================================================================== */

  .product-guidelines {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 20px 24px 24px;
  }

  .product-guideline {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 13px;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  .product-guideline__icon {
    display: grid;
    width: 31px;
    height: 31px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
  }

  .product-guideline strong,
  .product-guideline span {
    display: block;
  }

  .product-guideline strong {
    color: var(--ink);
    font-size: 0.62rem;
    font-weight: 900;
  }

  .product-guideline span {
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.56rem;
    line-height: 1.55;
  }

  /* ==========================================================================
     SAVE
     ========================================================================== */

  .products-card--save {
    padding: 20px 24px 24px;
  }

  .save-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px;
    border: 2px solid var(--ink);
    background: var(--acid-soft);
  }

  .save-box__icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
  }

  .save-box__content h2 {
    margin: 5px 0 0;
    color: var(--ink);
    font-size: 0.76rem;
    font-weight: 900;
  }

  .save-box__content p {
    max-width: 680px;
    margin: 4px 0 0;
    color: var(--muted-dark);
    font-size: 0.59rem;
    line-height: 1.58;
  }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    padding-top: 17px;
    border-top: 3px solid var(--ink);
  }

  .form-actions__back,
  .form-actions__submit {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 14px;
    border: 2px solid var(--ink);
    border-radius: 0;
    font: inherit;
    font-size: 0.61rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .form-actions__back {
    color: var(--ink);
    background: transparent;
  }

  .form-actions__back:hover {
    color: var(--ink);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .form-actions__submit {
    color: var(--acid);
    background: var(--ink);
    box-shadow: 6px 6px 0 var(--acid);
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .form-actions__submit:hover {
    background: var(--ink-3);
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--orange);
  }

  .form-actions__submit:disabled {
    opacity: 0.58;
    cursor: wait;
    transform: none;
  }

  .save-message {
    margin: 10px 0 0;
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.54rem;
    line-height: 1.5;
    text-align: right;
  }

  .save-message[hidden] {
    display: none;
  }

  /* ==========================================================================
     SIDEBAR
     ========================================================================== */

  .products-sidebar {
    position: sticky;
    top: 22px;
    display: grid;
    gap: 13px;
  }

  .sidebar-card {
    padding: 18px;
  }

  .sidebar-card--highlight {
    background:
      linear-gradient(
        145deg,
        var(--acid),
        var(--white)
      );
  }

  .sidebar-card__icon {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    margin-bottom: 13px;
    color: var(--acid);
    background: var(--ink);
    border: 2px solid var(--ink);
  }

  .sidebar-card h2 {
    margin: 6px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .sidebar-card p {
    margin: 12px 0 0;
    color: var(--muted-dark);
    font-size: 0.6rem;
    line-height: 1.6;
  }

  .summary-number {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-top: 21px;
  }

  .summary-number strong {
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 2.45rem;
    font-weight: 900;
    letter-spacing: -0.085em;
    line-height: 0.9;
  }

  .summary-number span {
    color: var(--muted-dark);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.5rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .summary-bar {
    width: 100%;
    height: 6px;
    margin-top: 15px;
    background: var(--ink);
  }

  .summary-bar span {
    display: block;
    width: 0%;
    height: 100%;
    background: var(--orange);
    transition: width 150ms ease;
  }

  .summary-flow {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    padding: 8px;
    border: 2px solid var(--ink);
    background: var(--paper);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.46rem;
    font-weight: 900;
  }

  .summary-flow span {
    color: var(--muted-dark);
  }

  .summary-flow strong {
    padding: 3px 5px;
    color: var(--ink);
    background: var(--acid);
  }

  .summary-flow b {
    color: var(--orange);
  }

  .sidebar-check-list {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }

  .sidebar-check {
    display: grid;
    grid-template-columns:
      27px
      minmax(0, 1fr);
    gap: 8px;
    color: var(--muted-dark);
    font-size: 0.59rem;
    line-height: 1.55;
  }

  .sidebar-check__index {
    display: grid;
    width: 27px;
    height: 24px;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.48rem;
