---
/**
 * ============================================================================
 * BINSIGHT — ORGANIZATION PRODUCTS
 * ============================================================================
 * Products / outputs produced by an organization.
 *
 * Design / architecture:
 * - OrganizationLayout owns global Navbar, workspace sidebar and Footer.
 * - This page owns only the products-specific content hierarchy.
 * - BINSIGHT brutalist editorial visual system.
 * - Existing product vocabulary only.
 * - No fabricated operational figures.
 * - Browser-side validation only.
 * - CustomEvent integration hook for future persistence.
 * - Safe across Astro client-side navigation.
 * - Accessible keyboard and focus behavior.
 * ============================================================================
 */

import {
  ArrowLeft,
  ArrowRight,
  CircleCheck,
  ExternalLink,
  Leaf,
  Package,
  Plus,
  Save,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import OrganizationLayout from "@layouts/OrganizationLayout.astro";

const productTypes = [
  {
    id: "recycled-material",
    index: "01",
    label: "Material hasil olahan",
    description:
      "Material yang dihasilkan setelah melalui proses pengolahan atau pemilahan.",
  },
  {
    id: "reusable-product",
    index: "02",
    label: "Produk guna ulang",
    description:
      "Produk yang masih dapat digunakan kembali atau diperpanjang masa pakainya.",
  },
  {
    id: "recovered-material",
    index: "03",
    label: "Material recovery",
    description:
      "Material atau nilai yang berhasil dipulihkan dari aliran sampah.",
  },
  {
    id: "compost",
    index: "04",
    label: "Kompos",
    description:
      "Hasil pengolahan material organik melalui proses yang sesuai.",
  },
  {
    id: "other",
    index: "05",
    label: "Hasil lainnya",
    description:
      "Output pengelolaan lain yang relevan dan benar-benar dihasilkan organisasi.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Produk dan Hasil — BINSIGHT",
  description:
    "Kelola informasi produk, output, dan hasil pengelolaan sampah organisasi melalui workspace organisasi BINSIGHT.",
  url: "https://binsight.id/organization/products",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<OrganizationLayout
  title="Produk dan Hasil"
  description="Kelola informasi produk dan hasil pengelolaan sampah organisasi."
  activeSection="products"
  breadcrumbs={[
    {
      label: "Organisasi",
      href: "/organization",
    },
    {
      label: "Produk dan Hasil",
    },
  ]}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <div class="organization-products-page">
    <section
      class="products-page"
      aria-labelledby="products-page-title"
    >
      <div class="products-page__container">
        <!-- ============================================================
             PAGE HERO
        ============================================================= -->
        <section class="products-hero">
          <div class="products-hero__main">
            <p class="products-hero__eyebrow">
              ORGANIZATION / PRODUCTS
            </p>

            <h1
              id="products-page-title"
              class="products-hero__title"
            >
              Nyatakan hasil yang benar-benar ada.
            </h1>

            <p class="products-hero__description">
              Gunakan halaman ini untuk mendokumentasikan material recovery,
              produk guna ulang, kompos, dan output lain yang memang
              dihasilkan organisasi.
            </p>
          </div>

          <div class="products-hero__actions">
            <a
              class="products-hero__action products-hero__action--primary"
              href="/organization"
            >
              <ArrowLeft
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>
                Kembali ke workspace
              </span>
            </a>

            <a
              class="products-hero__action products-hero__action--secondary"
              href="/organizations"
            >
              <ExternalLink
                size={16}
                stroke-width={1.9}
                aria-hidden="true"
              />

              <span>
                Lihat organisasi publik
              </span>
            </a>
          </div>
        </section>

        <!-- ============================================================
             CONTENT
        ============================================================= -->
        <div class="products-layout">
          <!-- ==========================================================
               MAIN
          =========================================================== -->
          <div class="products-main">
            <form
              id="organization-products-form"
              class="products-form"
              data-products-form
              novalidate
            >
              <!-- ======================================================
                   01 / OUTPUT TYPES
              ======================================================= -->
              <section
                class="products-card"
                aria-labelledby="product-types-title"
              >
                <header class="products-card__header">
                  <div class="products-card__heading">
                    <span class="products-card__eyebrow">
                      01 / OUTPUT TYPES
                    </span>

                    <h2
                      id="product-types-title"
                      class="products-card__title"
                    >
                      Tambahkan produk atau hasil
                    </h2>

                    <p class="products-card__description">
                      Pilih semua jenis output yang benar-benar dihasilkan
                      organisasi dari aktivitas pengelolaan material.
                    </p>
                  </div>

                  <div
                    class="products-card__icon"
                    aria-hidden="true"
                  >
                    <Package
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div class="products-notice">
                  <div
                    class="products-notice__icon"
                    aria-hidden="true"
                  >
                    <Leaf
                      size={18}
                      stroke-width={2}
                    />
                  </div>

                  <div class="products-notice__copy">
                    <strong>
                      Fokus pada hasil yang benar-benar tersedia
                    </strong>

                    <p>
                      Produk atau output sebaiknya menggambarkan kegiatan
                      nyata organisasi, bukan target atau rencana yang belum
                      terealisasi.
                    </p>
                  </div>
                </div>

                <div class="product-builder">
                  <div class="product-builder__top">
                    <div>
                      <span class="product-builder__eyebrow">
                        PRODUCT TYPES
                      </span>

                      <h3>
                        Pilih kategori hasil
                      </h3>
                    </div>

                    <span
                      class="product-builder__count"
                      data-product-count
                    >
                      0 produk
                    </span>
                  </div>

                  <div
                    class="product-type-grid"
                    data-product-type-grid
                  >
                    {
                      productTypes.map(
                        (type) => (
                          <button
                            type="button"
                            class="product-type-option"
                            data-product-type={
                              type.id
                            }
                            aria-pressed="false"
                          >
                            <span
                              class="product-type-option__index"
                              aria-hidden="true"
                            >
                              {type.index}
                            </span>

                            <span
                              class="product-type-option__icon"
                              aria-hidden="true"
                            >
                              <Package
                                size={18}
                                stroke-width={1.9}
                              />
                            </span>

                            <span class="product-type-option__body">
                              <strong>
                                {type.label}
                              </strong>

                              <small>
                                {
                                  type.description
                                }
                              </small>
                            </span>

                            <span
                              class="product-type-option__action"
                              aria-hidden="true"
                            >
                              <Plus
                                size={16}
                                stroke-width={2}
                              />
                            </span>
                          </button>
                        ),
                      )
                    }
                  </div>

                  <p
                    class="field-error"
                    data-product-type-error
                    role="alert"
                    hidden
                  ></p>
                </div>

                <div class="product-list-section">
                  <div class="product-list-section__header">
                    <div>
                      <span class="product-builder__eyebrow">
                        SELECTED OUTPUT
                      </span>

                      <h3>
                        Produk terpilih
                      </h3>
                    </div>

                    <span
                      class="product-list-section__count"
                      data-selected-product-count
                    >
                      0 produk
                    </span>
                  </div>

                  <div
                    class="product-list"
                    data-product-list
                    aria-live="polite"
                  >
                    <div
                      class="product-list-empty"
                      data-product-empty
                    >
                      <div
                        class="product-list-empty__icon"
                        aria-hidden="true"
                      >
                        <Package
                          size={22}
                          stroke-width={1.8}
                        />
                      </div>

                      <div>
                        <strong>
                          Belum ada produk yang dipilih.
                        </strong>

                        <span>
                          Pilih satu atau lebih kategori output di atas.
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   02 / DESCRIPTION
              ======================================================= -->
              <section
                class="products-card"
                aria-labelledby="products-description-title"
              >
                <header class="products-card__header">
                  <div class="products-card__heading">
                    <span class="products-card__eyebrow">
                      02 / DESCRIPTION
                    </span>

                    <h2
                      id="products-description-title"
                      class="products-card__title"
                    >
                      Jelaskan hasil pengelolaan
                    </h2>

                    <p class="products-card__description">
                      Berikan konteks singkat tentang output yang dihasilkan.
                    </p>
                  </div>

                  <div
                    class="products-card__icon"
                    aria-hidden="true"
                  >
                    <Leaf
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div class="field">
                  <div class="field__label-row">
                    <label
                      class="field__label"
                      for="productsDescription"
                    >
                      Deskripsi produk
                    </label>

                    <span class="field__required">
                      REQUIRED
                    </span>
                  </div>

                  <p
                    class="field__hint"
                    id="productsDescriptionHint"
                  >
                    Jelaskan bentuk hasil, penggunaan umum, atau konteks lain
                    yang benar-benar dapat dibagikan kepada publik.
                  </p>

                  <textarea
                    id="productsDescription"
                    name="productsDescription"
                    class="field__textarea"
                    rows="8"
                    maxlength="2200"
                    required
                    placeholder="Contoh: Material yang telah dipilah dan diproses dapat diteruskan sebagai bahan baku atau produk sesuai karakteristik material."
                    aria-describedby="productsDescriptionHint productsDescriptionCounter productsDescriptionError"
                    data-products-description
                  ></textarea>

                  <div class="field__footer">
                    <p
                      id="productsDescriptionError"
                      class="field-error"
                      data-description-error
                      role="alert"
                      hidden
                    ></p>

                    <span
                      id="productsDescriptionCounter"
                      class="field__counter"
                      data-products-description-counter
                    >
                      0 / 2200
                    </span>
                  </div>
                </div>

                <div class="product-guidelines">
                  <div class="product-guideline">
                    <div
                      class="product-guideline__icon"
                      aria-hidden="true"
                    >
                      <CircleCheck
                        size={17}
                        stroke-width={2}
                      />
                    </div>

                    <div>
                      <strong>
                        Jelaskan output secara spesifik
                      </strong>

                      <span>
                        Gunakan istilah yang mudah dipahami dan sesuai dengan
                        hasil pengelolaan yang tersedia.
                      </span>
                    </div>
                  </div>

                  <div class="product-guideline">
                    <div
                      class="product-guideline__icon"
                      aria-hidden="true"
                    >
                      <ShieldCheck
                        size={17}
                        stroke-width={2}
                      />
                    </div>

                    <div>
                      <strong>
                        Hindari klaim yang belum dapat dibuktikan
                      </strong>

                      <span>
                        Jangan menampilkan kapasitas, kualitas, atau
                        penggunaan tertentu apabila belum benar-benar tersedia.
                      </span>
                    </div>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   03 / REFERENCE
              ======================================================= -->
              <section
                class="products-card products-card--reference"
                aria-labelledby="reference-title"
              >
                <header class="products-card__header">
                  <div class="products-card__heading">
                    <span class="products-card__eyebrow">
                      03 / REFERENCE
                    </span>

                    <h2
                      id="reference-title"
                      class="products-card__title"
                    >
                      Referensi produk
                    </h2>

                    <p class="products-card__description">
                      Tambahkan URL publik sebagai referensi tambahan.
                    </p>
                  </div>

                  <div
                    class="products-card__icon"
                    aria-hidden="true"
                  >
                    <ExternalLink
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div class="field field--reference">
                  <div class="field__label-row">
                    <label
                      class="field__label"
                      for="productWebsite"
                    >
                      URL referensi
                    </label>

                    <span class="field__optional">
                      OPTIONAL
                    </span>
                  </div>

                  <p
                    class="field__hint"
                    id="productWebsiteHint"
                  >
                    Kosongkan jika tidak ada. Jika diisi, gunakan URL publik
                    yang benar-benar dapat diakses.
                  </p>

                  <div class="field__input-wrap field__input-wrap--url">
                    <span
                      class="field__input-prefix"
                      aria-hidden="true"
                    >
                      <ExternalLink
                        size={16}
                        stroke-width={1.9}
                      />
                    </span>

                    <input
                      id="productWebsite"
                      name="productWebsite"
                      class="field__input field__input--url"
                      type="url"
                      maxlength="300"
                      autocomplete="url"
                      inputmode="url"
                      placeholder="https://contoh.com/produk"
                      aria-describedby="productWebsiteHint productWebsiteError"
                    />
                  </div>

                  <p
                    id="productWebsiteError"
                    class="field-error"
                    data-website-error
                    role="alert"
                    hidden
                  ></p>
                </div>
              </section>

              <!-- ======================================================
                   04 / SAVE
              ======================================================= -->
              <section class="products-card products-card--save">
                <div class="save-box">
                  <div
                    class="save-box__icon"
                    aria-hidden="true"
                  >
                    <Save
                      size={20}
                      stroke-width={2}
                    />
                  </div>

                  <div class="save-box__content">
                    <span class="save-box__eyebrow">
                      READY FOR REVIEW
                    </span>

                    <h2>
                      Simpan informasi produk
                    </h2>

                    <p>
                      Data akan melalui pemeriksaan dasar pada browser dan
                      dipersiapkan untuk proses penyimpanan atau verifikasi.
                    </p>
                  </div>
                </div>

                <div class="form-actions">
                  <button
                    type="button"
                    class="form-actions__back"
                    data-reset-products
                  >
                    Reset
                  </button>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-save-products
                  >
                    <Save
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-save-label>
                      Simpan produk
                    </span>

                    <ArrowRight
                      size={16}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </button>
                </div>

                <p
                  class="save-message"
                  data-save-message
                  aria-live="polite"
                  hidden
                ></p>
              </section>
            </form>

            <!-- ==========================================================
                 SUCCESS
            =========================================================== -->
            <section
              class="save-success"
              data-save-success
              hidden
              aria-labelledby="save-success-title"
            >
              <span
                class="save-success__index"
                aria-hidden="true"
              >
                05
              </span>

              <div class="save-success__icon">
                <CircleCheck
                  size={32}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                PRODUCT READY
              </span>

              <h2 id="save-success-title">
                Informasi produk berhasil dipersiapkan
              </h2>

              <p>
                Data produk dan hasil telah melalui pemeriksaan dasar pada
                browser dan siap diteruskan ke proses penyimpanan atau
                verifikasi.
              </p>

              <div class="save-success__actions">
                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  <span>
                    Kembali ke workspace
                  </span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-products
                >
                  Edit kembali
                </button>
              </div>
            </section>
          </div>

          <!-- ==========================================================
               PAGE CONTEXT SIDEBAR
          =========================================================== -->
          <aside
            class="products-context"
            data-products-sidebar
            aria-label="Ringkasan produk organisasi"
          >
            <section
              class="context-card context-card--highlight"
            >
              <div
                class="context-card__icon"
                aria-hidden="true"
              >
                <Package
                  size={20}
                  stroke-width={2}
                />
              </div>

              <span class="context-card__eyebrow">
                OUTPUT SUMMARY
              </span>

              <h2>
                Produk &amp; hasil
              </h2>

              <div class="summary-number">
                <strong data-sidebar-product-count>
                  0
                </strong>

                <span>
                  kategori output
                </span>
              </div>

              <div class="summary-bar">
                <span data-summary-bar></span>
              </div>

              <div class="summary-flow">
                <span>INPUT</span>

                <b aria-hidden="true">
                  +
                </b>

                <span>
                  PROCESS
                </span>

                <b aria-hidden="true">
                  +
                </b>

                <strong>
                  OUTPUT
                </strong>
              </div>

              <p>
                Pilih hanya output yang benar-benar tersedia sebagai hasil
                aktivitas pengelolaan organisasi.
              </p>
            </section>

            <section class="context-card">
              <span class="context-card__eyebrow">
                PRINCIPLES
              </span>

              <h2>
                Tampilkan nilai yang nyata.
              </h2>

              <div class="sidebar-check-list">
                <div class="sidebar-check">
                  <span class="sidebar-check__index">
                    01
                  </span>

                  <span>
                    Gunakan nama output yang spesifik.
                  </span>
                </div>

                <div class="sidebar-check">
                  <span class="sidebar-check__index">
                    02
                  </span>

                  <span>
                    Jelaskan hasil berdasarkan proses nyata.
                  </span>
                </div>

                <div class="sidebar-check">
                  <span class="sidebar-check__index">
                    03
                  </span>

                  <span>
                    Hindari klaim yang tidak terverifikasi.
                  </span>
                </div>
              </div>
            </section>

            <section class="context-card context-card--warning">
              <div
                class="context-warning__icon"
                aria-hidden="true"
              >
                <TriangleAlert
                  size={18}
                  stroke-width={2}
                />
              </div>

              <div>
                <span class="context-card__eyebrow">
                  VALIDATION
                </span>

                <strong>
                  Gunakan data yang benar.
                </strong>

                <p>
                  Minimal satu kategori dan deskripsi 20 karakter diperlukan.
                  URL bersifat opsional, tetapi harus valid apabila diisi.
                </p>
              </div>
            </section>

            <section class="context-card context-card--next">
              <span class="context-card__eyebrow">
                ORGANIZATION DATA
              </span>

              <h2>
                Lengkapi informasi lain.
              </h2>

              <a href="/organization/profile">
                <span>
                  Profil organisasi
                </span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/waste">
                <span>
                  Sampah dikelola
                </span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/process">
                <span>
                  Proses pengelolaan
                </span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
            </section>
          </aside>
        </div>
      </div>
    </section>
  </div>
</OrganizationLayout>

<style>
  /* ==========================================================================
     PAGE ROOT
     ========================================================================== */

  .organization-products-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --muted-dark: #50554d;
    --orange: #ff6a00;
    --line: #b7b8ad;
    --danger: #b43d00;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    min-height: 100%;

    color: var(--ink);
    background: var(--paper);

    overflow-x: hidden;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .organization-products-page *,
  .organization-products-page *::before,
  .organization-products-page *::after {
    box-sizing: border-box;
  }

  .organization-products-page
    a,
  .organization-products-page
    button,
  .organization-products-page
    input,
  .organization-products-page
    textarea {
    -webkit-tap-highlight-color: transparent;
  }

  .organization-products-page
    button:focus-visible,
  .organization-products-page
    a:focus-visible,
  .organization-products-page
    input:focus-visible,
  .organization-products-page
    textarea:focus-visible {
    outline:
      3px solid
      var(--orange);

    outline-offset:
      4px;
  }

  /* ==========================================================================
     CONTAINER
     ========================================================================== */

  .products-page {
    width: 100%;
    max-width: 100%;

    min-width: 0;

    padding:
      26px
      26px
      72px;

    overflow-x: hidden;

    background:
      radial-gradient(
        circle at 92% 2%,
        rgb(223 255 0 / 8%),
        transparent 23%
      ),
      var(--paper);
  }

  .products-page__container {
    width: min(
      1240px,
      100%
    );

    max-width:
      100%;

    margin-inline:
      auto;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .products-hero {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(245px, 300px);

    gap:
      26px;

    padding:
      28px;

    border:
      3px solid
      var(--ink);

    background:
      var(--ink);

    color:
      var(--white);

    box-shadow:
      7px 7px 0
      var(--orange);
  }

  .products-hero__main {
    min-width:
      0;
  }

  .products-hero__eyebrow,
  .products-card__eyebrow,
  .product-builder__eyebrow,
  .save-box__eyebrow,
  .context-card__eyebrow,
  .save-success__eyebrow {
    display:
      block;

    color:
      var(--orange);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size:
      0.54rem;

    font-weight:
      900;

    line-height:
      1.2;

    letter-spacing:
      0.1em;

    text-transform:
      uppercase;
  }

  .products-hero__title {
    max-width:
      960px;

    margin:
      12px
      0
      0;

