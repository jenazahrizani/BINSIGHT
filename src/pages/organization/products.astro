</style>

<script>
// @ts-nocheck

  const productTypeButtons =
    Array.from(
      document.querySelectorAll(
        "[data-product-type]",
      ),
    );

  const productList =
    document.querySelector(
      "[data-product-list]",
    );

  const productEmpty =
    document.querySelector(
      "[data-product-empty]",
    );

  const selectedProductCount =
    document.querySelector(
      "[data-selected-product-count]",
    );

  const sidebarProductCount =
    document.querySelector(
      "[data-sidebar-product-count]",
    );

  const productCount =
    document.querySelector(
      "[data-product-count]",
    );

  const descriptionField =
    document.querySelector(
      "[data-products-description]",
    );

  const descriptionCounter =
    document.querySelector(
      "[data-products-description-counter]",
    );

  const websiteField =
    document.querySelector(
      "[name='productWebsite']",
    );

  const saveButton =
    document.querySelector(
      "[data-save-products]",
    );

  const saveLabel =
    document.querySelector(
      "[data-save-label]",
    );

  const saveMessage =
    document.querySelector(
      "[data-save-message]",
    );

  const saveSuccess =
    document.querySelector(
      "[data-save-success]",
    );

  const editProductsButton =
    document.querySelector(
      "[data-edit-products]",
    );

  const productDefinitions = {
    "recycled-material": {
      id: "recycled-material",
      label: "Material hasil olahan",
      description:
        "Material yang dihasilkan setelah melalui proses pengolahan atau pemilahan.",
    },

    "reusable-product": {
      id: "reusable-product",
      label: "Produk guna ulang",
      description:
        "Produk yang masih dapat digunakan kembali atau diperpanjang masa pakainya.",
    },

    "recovered-material": {
      id: "recovered-material",
      label: "Material recovery",
      description:
        "Material atau nilai yang berhasil dipulihkan dari aliran sampah.",
    },

    compost: {
      id: "compost",
      label: "Kompos",
      description:
        "Hasil pengolahan material organik melalui proses yang sesuai.",
    },

    other: {
      id: "other",
      label: "Hasil lainnya",
      description:
        "Output pengelolaan lain yang relevan dan benar-benar dihasilkan organisasi.",
    },
  };

  let selectedProducts = [];

  function updateCounts() {
    const count =
      selectedProducts.length;

    if (
      selectedProductCount instanceof HTMLElement
    ) {
      selectedProductCount.textContent =
        `${count} produk`;
    }

    if (
      sidebarProductCount instanceof HTMLElement
    ) {
      sidebarProductCount.textContent =
        String(count);
    }

    if (
      productCount instanceof HTMLElement
    ) {
      productCount.textContent =
        `${count} produk`;
    }
  }

  function updateAvailableButtons() {
    productTypeButtons.forEach(
      (button) => {
        const id =
          button.getAttribute(
            "data-product-type",
          );

        const isSelected =
          id &&
          selectedProducts.includes(
            id,
          );

        button.disabled =
          Boolean(isSelected);
      },
    );
  }

  function createRemoveButton(
    productId,
    productLabel,
  ) {
    const button =
      document.createElement(
        "button",
      );

    button.type = "button";

    button.className =
      "product-item__remove";

    button.setAttribute(
      "data-remove-product",
      productId,
    );

    button.setAttribute(
      "aria-label",
      `Hapus ${productLabel}`,
    );

    button.innerHTML =
      "<span aria-hidden=\"true\">×</span>";

    return button;
  }

  function renderProducts() {
    if (
      !(productList instanceof HTMLElement)
    ) {
      return;
    }

    productList
      .querySelectorAll(
        ".product-item",
      )
      .forEach(
        (item) => {
          item.remove();
        },
      );

    if (
      selectedProducts.length === 0
    ) {
      if (
        productEmpty instanceof HTMLElement
      ) {
        productEmpty.hidden = false;
      }

      updateCounts();
      updateAvailableButtons();

      return;
    }

    if (
      productEmpty instanceof HTMLElement
    ) {
      productEmpty.hidden = true;
    }

    selectedProducts.forEach(
      (productId) => {
        const definition =
          productDefinitions[
            productId
          ];

        if (!definition) {
          return;
        }

        const item =
          document.createElement(
            "div",
          );

        item.className =
          "product-item";

        item.setAttribute(
          "data-product-item",
          productId,
        );

        const icon =
          document.createElement(
            "div",
          );

        icon.className =
          "product-item__icon";

        icon.innerHTML =
          "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M16 16.5V7.5a2.5 2.5 0 0 0-5 0v9a3.5 3.5 0 0 1-7 0V8a4 4 0 0 1 8 0v8.5a2.5 2.5 0 0 0 5 0v-7a3.5 3.5 0 0 1 7 0v8\"/></svg>";

        const body =
          document.createElement(
            "div",
          );

        body.className =
          "product-item__body";

        const title =
          document.createElement(
            "strong",
          );

        title.textContent =
          definition.label;

        const description =
          document.createElement(
            "span",
          );

        description.textContent =
          definition.description;

        body.append(
          title,
          description,
        );

        const removeButton =
          createRemoveButton(
            productId,
            definition.label,
          );

        item.append(
          icon,
          body,
          removeButton,
        );

        productList.appendChild(
          item,
        );
      },
    );

    productList
      .querySelectorAll(
        "[data-remove-product]",
      )
      .forEach(
        (button) => {
          button.addEventListener(
            "click",
            () => {
              const productId =
                button.getAttribute(
                  "data-remove-product",
                );

              if (!productId) {
                return;
              }

              selectedProducts =
                selectedProducts.filter(
                  (id) =>
                    id !== productId,
                );

              renderProducts();
            },
          );
        },
      );

    updateCounts();
    updateAvailableButtons();
  }

  function addProduct(
    productId,
  ) {
    if (
      !productId ||
      !productDefinitions[productId]
    ) {
      return;
    }

    if (
      selectedProducts.includes(
        productId,
      )
    ) {
      return;
    }

    selectedProducts.push(
      productId,
    );

    renderProducts();
  }

  function updateDescriptionCounter() {
    if (
      !(descriptionField instanceof HTMLTextAreaElement) ||
      !(descriptionCounter instanceof HTMLElement)
    ) {
      return;
    }

    descriptionCounter.textContent =
      `${descriptionField.value.length} / 2200`;
  }

  function validateProducts() {
    if (
      selectedProducts.length === 0
    ) {
      if (
        saveMessage instanceof HTMLElement
      ) {
        saveMessage.textContent =
          "Tambahkan minimal satu produk atau hasil sebelum menyimpan.";

        saveMessage.hidden = false;
      }

      if (
        productList instanceof HTMLElement
      ) {
        productList.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
      }

      return false;
    }

    if (
      descriptionField instanceof HTMLTextAreaElement
    ) {
      const description =
        descriptionField.value.trim();

      if (
        description.length > 0 &&
        description.length < 20
      ) {
        descriptionField.setAttribute(
          "aria-invalid",
          "true",
        );

        if (
          saveMessage instanceof HTMLElement
        ) {
          saveMessage.textContent =
            "Deskripsi produk yang diisi minimal 20 karakter.";

          saveMessage.hidden = false;
        }

        descriptionField.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        descriptionField.focus();

        return false;
      }

      descriptionField.removeAttribute(
        "aria-invalid",
      );
    }

    if (
      websiteField instanceof HTMLInputElement
    ) {
      const website =
        websiteField.value.trim();

      if (website !== "") {
        try {
          new URL(
            website,
          );
          websiteField.removeAttribute(
            "aria-invalid",
          );
        } catch {
          websiteField.setAttribute(
            "aria-invalid",
            "true",
          );

          if (
            saveMessage instanceof HTMLElement
          ) {
            saveMessage.textContent =
              "URL informasi tambahan tidak valid.";

            saveMessage.hidden = false;
          }

          websiteField.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });

          websiteField.focus();

          return false;
        }
      }
    }

    return true;
  }

  function buildProductsPayload() {
    return {
      products:
        selectedProducts.map(
          (productId) => {
            const definition =
              productDefinitions[
                productId
              ];

            return {
              id: productId,
              name:
                definition?.label ??
                productId,
              description:
                definition?.description ??
                "",
            };
          },
        ),

      description:
        descriptionField instanceof
        HTMLTextAreaElement
          ? descriptionField.value.trim()
          : "",

      website:
        websiteField instanceof
        HTMLInputElement
          ? websiteField.value.trim()
          : "",

      updatedAt:
        new Date().toISOString(),
    };
  }

  async function saveProducts() {
    if (!validateProducts()) {
      return;
    }

    const payload =
      buildProductsPayload();

    if (
      saveButton instanceof HTMLButtonElement
    ) {
      saveButton.disabled = true;
    }

    if (
      saveLabel instanceof HTMLElement
    ) {
      saveLabel.textContent =
        "Menyiapkan...";
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.textContent =
        "Memeriksa informasi produk...";

      saveMessage.hidden = false;
    }

    await Promise.resolve();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:organization-products-save",
        {
          detail: payload,
        },
      ),
    );

    document
      .querySelectorAll(
        ".products-card",
      )
      .forEach(
        (section) => {
          section.hidden = true;
        },
      );

    const sidebar =
      document.querySelector(
        ".products-sidebar",
      );

    if (
      sidebar instanceof HTMLElement
    ) {
      sidebar.hidden = true;
    }

    if (
      saveSuccess instanceof HTMLElement
    ) {
      saveSuccess.hidden = false;

      saveSuccess.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.hidden = true;
    }
  }

  function restoreProductsEditor() {
    document
      .querySelectorAll(
        ".products-card",
      )
      .forEach(
        (section) => {
          section.hidden = false;
        },
      );

    const sidebar =
      document.querySelector(
        ".products-sidebar",
      );

    if (
      sidebar instanceof HTMLElement
    ) {
      sidebar.hidden = false;
    }

    if (
      saveSuccess instanceof HTMLElement
    ) {
      saveSuccess.hidden = true;
    }

    if (
      saveButton instanceof HTMLButtonElement
    ) {
      saveButton.disabled = false;
    }

    if (
      saveLabel instanceof HTMLElement
    ) {
      saveLabel.textContent =
        "Simpan informasi";
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.textContent = "";
      saveMessage.hidden = true;
    }
  }

  productTypeButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        () => {
          const productId =
            button.getAttribute(
              "data-product-type",
            );

          addProduct(
            productId,
          );
        },
      );
    },
  );

  descriptionField?.addEventListener(
    "input",
    updateDescriptionCounter,
  );

  saveButton?.addEventListener(
    "click",
    saveProducts,
  );

  editProductsButton?.addEventListener(
    "click",
    restoreProductsEditor,
  );

  updateDescriptionCounter();
  renderProducts();
</script>