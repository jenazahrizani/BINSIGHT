</style>

<script>
  const initializeOrganizationProductsPage =
    () => {
      const form =
        document.querySelector<HTMLFormElement>(
          "[data-products-form]",
        );

      if (
        !form ||
        form.dataset.initialized ===
          "true"
      ) {
        return;
      }

      form.dataset.initialized =
        "true";

      const productTypeButtons =
        Array.from(
          form.querySelectorAll<HTMLButtonElement>(
            "[data-product-type]",
          ),
        );

      const productList =
        form.querySelector<HTMLElement>(
          "[data-product-list]",
        );

      const productEmpty =
        form.querySelector<HTMLElement>(
          "[data-product-empty]",
        );

      const productTypeError =
        form.querySelector<HTMLElement>(
          "[data-product-type-error]",
        );

      const selectedProductCount =
        form.querySelector<HTMLElement>(
          "[data-selected-product-count]",
        );

      const sidebarProductCount =
        document.querySelector<HTMLElement>(
          "[data-sidebar-product-count]",
        );

      const productCount =
        form.querySelector<HTMLElement>(
          "[data-product-count]",
        );

      const descriptionField =
        form.querySelector<HTMLTextAreaElement>(
          "[data-products-description]",
        );

      const descriptionCounter =
        form.querySelector<HTMLElement>(
          "[data-products-description-counter]",
        );

      const descriptionError =
        form.querySelector<HTMLElement>(
          "[data-description-error]",
        );

      const websiteField =
        form.querySelector<HTMLInputElement>(
          "[name='productWebsite']",
        );

      const websiteError =
        form.querySelector<HTMLElement>(
          "[data-website-error]",
        );

      const saveButton =
        form.querySelector<HTMLButtonElement>(
          "[data-save-products]",
        );

      const saveLabel =
        form.querySelector<HTMLElement>(
          "[data-save-label]",
        );

      const saveMessage =
        form.querySelector<HTMLElement>(
          "[data-save-message]",
        );

      const saveSuccess =
        document.querySelector<HTMLElement>(
          "[data-save-success]",
        );

      const productsSidebar =
        document.querySelector<HTMLElement>(
          "[data-products-sidebar]",
        );

      const resetButton =
        form.querySelector<HTMLButtonElement>(
          "[data-reset-products]",
        );

      const editProductsButton =
        document.querySelector<HTMLButtonElement>(
          "[data-edit-products]",
        );

      const summaryBar =
        document.querySelector<HTMLElement>(
          "[data-summary-bar]",
        );

      const productDefinitions =
        new Map<
          string,
          {
            id: string;
            index: string;
            label: string;
            description: string;
          }
        >(
          productTypeButtons.map(
            (button) => {
              const id =
                button.getAttribute(
                  "data-product-type",
                ) ?? "";

              const index =
                button.querySelector<HTMLElement>(
                  ".product-type-option__index",
                )?.textContent?.trim() ??
                "";

              const label =
                button.querySelector<HTMLElement>(
                  ".product-type-option__body strong",
                )?.textContent?.trim() ??
                "";

              const description =
                button.querySelector<HTMLElement>(
                  ".product-type-option__body small",
                )?.textContent?.trim() ??
                "";

              return [
                id,
                {
                  id,
                  index,
                  label,
                  description,
                },
              ];
            },
          ),
        );

      let selectedProducts: string[] =
        [];

      const updateCounts = () => {
        const count =
          selectedProducts.length;

        const label =
          `${count} produk`;

        if (selectedProductCount) {
          selectedProductCount.textContent =
            label;
        }

        if (sidebarProductCount) {
          sidebarProductCount.textContent =
            String(count);
        }

        if (productCount) {
          productCount.textContent =
            label;
        }

        if (summaryBar) {
          const percentage =
            productDefinitions.size >
            0
              ? (count /
                  productDefinitions.size) *
                100
              : 0;

          summaryBar.style.width =
            `${Math.min(
              percentage,
              100,
            )}%`;
        }
      };

      const clearErrors = () => {
        if (productTypeError) {
          productTypeError.textContent =
            "";

          productTypeError.hidden =
            true;
        }

        if (descriptionError) {
          descriptionError.textContent =
            "";

          descriptionError.hidden =
            true;
        }

        if (websiteError) {
          websiteError.textContent =
            "";

          websiteError.hidden =
            true;
        }

        descriptionField?.removeAttribute(
          "aria-invalid",
        );

        websiteField?.removeAttribute(
          "aria-invalid",
        );
      };

      const updateTypeButtons = () => {
        productTypeButtons.forEach(
          (button) => {
            const id =
              button.getAttribute(
                "data-product-type",
              );

            const selected =
              Boolean(
                id &&
                  selectedProducts.includes(
                    id,
                  ),
              );

            button.setAttribute(
              "aria-pressed",
              selected
                ? "true"
                : "false",
            );

            const action =
              button.querySelector<HTMLElement>(
                ".product-type-option__action",
              );

            if (action) {
              action.textContent =
                selected
                  ? "×"
                  : "+";
            }
          },
        );
      };

      const renderProducts =
        () => {
          if (!productList) {
            return;
          }

          productList
            .querySelectorAll<HTMLElement>(
              "[data-product-item]",
            )
            .forEach(
              (item) =>
                item.remove(),
            );

          if (
            selectedProducts.length ===
            0
          ) {
            if (productEmpty) {
              productEmpty.hidden =
                false;
            }

            updateCounts();
            updateTypeButtons();

            return;
          }

          if (productEmpty) {
            productEmpty.hidden =
              true;
          }

          selectedProducts.forEach(
            (productId) => {
              const definition =
                productDefinitions.get(
                  productId,
                );

              if (!definition) {
                return;
              }

              const item =
                document.createElement(
                  "div",
                );

              item.className =
                "product-item";

              item.setAttribute(
                "data-product-item",
                productId,
              );

              const index =
                document.createElement(
                  "div",
                );

              index.className =
                "product-item__index";

              index.textContent =
                definition.index;

              const body =
                document.createElement(
                  "div",
                );

              body.className =
                "product-item__body";

              const title =
                document.createElement(
                  "strong",
                );

              title.textContent =
                definition.label;

              const description =
                document.createElement(
                  "span",
                );

              description.textContent =
                definition.description;

              body.append(
                title,
                description,
              );

              const removeButton =
                document.createElement(
                  "button",
                );

              removeButton.type =
                "button";

              removeButton.className =
                "product-item__remove";

              removeButton.setAttribute(
                "aria-label",
                `Hapus ${definition.label}`,
              );

              removeButton.textContent =
                "Hapus";

              removeButton.addEventListener(
                "click",
                () => {
                  selectedProducts =
                    selectedProducts.filter(
                      (id) =>
                        id !==
                        productId,
                    );

                  clearErrors();

                  renderProducts();
                },
              );

              item.append(
                index,
                body,
                removeButton,
              );

              productList.appendChild(
                item,
              );
            },
          );

          updateCounts();
          updateTypeButtons();
        };

      const toggleProduct = (
        productId: string,
      ) => {
        if (
          !productId ||
          !productDefinitions.has(
            productId,
          )
        ) {
          return;
        }

        if (
          selectedProducts.includes(
            productId,
          )
        ) {
          selectedProducts =
            selectedProducts.filter(
              (id) =>
                id !==
                productId,
            );
        } else {
          selectedProducts = [
            ...selectedProducts,
            productId,
          ];
        }

        clearErrors();
        clearSaveMessage();
        renderProducts();
      };

      const updateDescriptionCounter =
        () => {
          if (
            !descriptionField ||
            !descriptionCounter
          ) {
            return;
          }

          descriptionCounter.textContent =
            `${descriptionField.value.length} / 2200`;
        };

      const showSaveMessage = (
        message: string,
      ) => {
        if (!saveMessage) {
          return;
        }

        saveMessage.textContent =
          message;

        saveMessage.hidden =
          false;
      };

      const clearSaveMessage = () => {
        if (!saveMessage) {
          return;
        }

        saveMessage.textContent =
          "";

        saveMessage.hidden =
          true;
      };

      const validateUrl = (
        value: string,
      ) => {
        if (!value) {
          return true;
        }

        try {
          const url =
            new URL(value);

          return (
            url.protocol ===
              "http:" ||
            url.protocol ===
              "https:"
          );
        } catch {
          return false;
        }
      };

      const validateForm = () => {
        clearErrors();

        let valid = true;

        if (
          selectedProducts.length ===
          0
        ) {
          valid = false;

          if (productTypeError) {
            productTypeError.textContent =
              "Pilih minimal satu kategori output.";

            productTypeError.hidden =
              false;
          }
        }

        const description =
          descriptionField?.value.trim() ??
          "";

        if (
          description.length <
          20
        ) {
          valid = false;

          descriptionField?.setAttribute(
            "aria-invalid",
            "true",
          );

          if (descriptionError) {
            descriptionError.textContent =
              "Deskripsi produk minimal 20 karakter.";

            descriptionError.hidden =
              false;
          }
        }

        const website =
          websiteField?.value.trim() ??
          "";

        if (
          !validateUrl(
            website,
          )
        ) {
          valid = false;

          websiteField?.setAttribute(
            "aria-invalid",
            "true",
          );

          if (websiteError) {
            websiteError.textContent =
              "URL harus berupa alamat HTTP atau HTTPS yang valid.";

            websiteError.hidden =
              false;
          }
        }

        if (!valid) {
          const firstInvalid =
            form.querySelector<HTMLElement>(
              "[aria-invalid='true']",
            );

          if (firstInvalid) {
            firstInvalid.scrollIntoView(
              {
                behavior:
                  "smooth",
                block:
                  "center",
              },
            );

            firstInvalid.focus();

            return false;
          }

          productTypeError?.scrollIntoView(
            {
              behavior:
                "smooth",
              block:
                "center",
            },
          );
        }

        return valid;
      };

      const buildPayload =
        () => ({
          products:
            selectedProducts.map(
              (productId) => {
                const definition =
                  productDefinitions.get(
                    productId,
                  );

                return {
                  id:
                    productId,

                  name:
                    definition?.label ??
                    productId,

                  type:
                    productId,
                };
              },
            ),

          description:
            descriptionField?.value.trim() ??
            "",

          website:
            websiteField?.value.trim() ??
            "",

          updatedAt:
            new Date().toISOString(),
        });

      const setEditorVisible = (
        visible: boolean,
      ) => {
        form
          .querySelectorAll<HTMLElement>(
            ".products-card",
          )
          .forEach(
            (card) => {
              card.hidden =
                !visible;
            },
          );

        if (productsSidebar) {
          productsSidebar.hidden =
            !visible;
        }

        if (saveSuccess) {
          saveSuccess.hidden =
            visible;
        }
      };

      const restoreEditor = () => {
        setEditorVisible(
          true,
        );

        if (saveButton) {
          saveButton.disabled =
            false;
        }

        if (saveLabel) {
          saveLabel.textContent =
            "Simpan produk";
        }

        clearSaveMessage();

        form.scrollIntoView({
          behavior:
            "smooth",
          block:
            "start",
        });
      };

      const handleSubmit = async (
        event: SubmitEvent,
      ) => {
        event.preventDefault();

        clearSaveMessage();

        if (!validateForm()) {
          return;
        }

        const payload =
          buildPayload();

        if (saveButton) {
          saveButton.disabled =
            true;
        }

        if (saveLabel) {
          saveLabel.textContent =
            "Menyiapkan...";
        }

        showSaveMessage(
          "Memeriksa informasi produk...",
        );

        await Promise.resolve();

        window.dispatchEvent(
          new CustomEvent(
            "binsight:organization-products-save",
            {
              detail:
                payload,
            },
          ),
        );

        setEditorVisible(
          false,
        );

        clearSaveMessage();

        saveSuccess?.scrollIntoView(
          {
            behavior:
              "smooth",
            block:
              "start",
          },
        );
      };

      const handleReset = () => {
        selectedProducts =
          [];

        if (descriptionField) {
          descriptionField.value =
            "";
        }

        if (websiteField) {
          websiteField.value =
            "";
        }

        clearErrors();
        clearSaveMessage();
        updateDescriptionCounter();
        renderProducts();
        setEditorVisible(
          true,
        );

        saveButton &&
          (saveButton.disabled =
            false);

        if (saveLabel) {
          saveLabel.textContent =
            "Simpan produk";
        }
      };

      productTypeButtons.forEach(
        (button) => {
          button.addEventListener(
            "click",
            () => {
              const id =
                button.getAttribute(
                  "data-product-type",
                );

              if (id) {
                toggleProduct(
                  id,
                );
              }
            },
          );
        },
      );

      descriptionField?.addEventListener(
        "input",
        () => {
          descriptionField.removeAttribute(
            "aria-invalid",
          );

          if (descriptionError) {
            descriptionError.textContent =
              "";

            descriptionError.hidden =
              true;
          }

          updateDescriptionCounter();
        },
      );

      websiteField?.addEventListener(
        "input",
        () => {
          websiteField.removeAttribute(
            "aria-invalid",
          );

          if (websiteError) {
            websiteError.textContent =
              "";

            websiteError.hidden =
              true;
          }
        },
      );

      form.addEventListener(
        "submit",
        handleSubmit,
      );

      resetButton?.addEventListener(
        "click",
        handleReset,
      );

      editProductsButton?.addEventListener(
        "click",
        restoreEditor,
      );

      renderProducts();
      updateDescriptionCounter();
      setEditorVisible(
        true,
      );
    };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeOrganizationProductsPage,
      { once: true },
    );
  } else {
    initializeOrganizationProductsPage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeOrganizationProductsPage,
  );
</script>