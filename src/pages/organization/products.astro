---
import {
  ArrowLeft,
  ArrowRight,
  CircleCheck,
  ExternalLink,
  Image,
  Leaf,
  Package,
  Plus,
  Save,
  ShieldCheck,
  Trash2,
  TriangleAlert,
} from "@lucide/astro";

import OrganizationLayout from "../../layouts/OrganizationLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";

const productTypes = [
  {
    id: "recycled-material",
    label: "Material hasil olahan",
    description:
      "Material yang dihasilkan setelah melalui proses pengolahan atau pemilahan.",
  },
  {
    id: "reusable-product",
    label: "Produk guna ulang",
    description:
      "Produk yang masih dapat digunakan kembali atau diperpanjang masa pakainya.",
  },
  {
    id: "recovered-material",
    label: "Material recovery",
    description:
      "Material atau nilai yang berhasil dipulihkan dari aliran sampah.",
  },
  {
    id: "compost",
    label: "Kompos",
    description:
      "Hasil pengolahan material organik melalui proses yang sesuai.",
  },
  {
    id: "other",
    label: "Hasil lainnya",
    description:
      "Output pengelolaan lain yang relevan dan benar-benar dihasilkan organisasi.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Produk & Hasil — BINSIGHT",
  description:
    "Kelola informasi produk, output, dan hasil pengelolaan sampah organisasi melalui portal organisasi BINSIGHT.",
  url: "https://binsight.id/organization/products",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<OrganizationLayout
  title="Produk & Hasil"
  description="Kelola informasi produk dan hasil pengelolaan sampah organisasi."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="organization-products-page">
    <PageHeader
      eyebrow="PORTAL ORGANISASI"
      title="Produk & hasil"
      description="Tampilkan output atau hasil nyata dari aktivitas pengelolaan organisasi agar masyarakat dapat memahami nilai yang dihasilkan dari material yang dikelola."
      icon="organization"
      tone="green"
      breadcrumbs={[
        {
          label: "Beranda",
          href: "/",
        },
        {
          label: "Portal Organisasi",
          href: "/organization",
        },
        {
          label: "Produk & Hasil",
          href: "/organization/products",
        },
      ]}
    />

    <section class="products-content">
      <div class="products-container">
        <div class="products-layout">
          <div class="products-main">
            <section class="products-card">
              <div class="products-card__header">
                <div>
                  <span class="products-card__eyebrow">
                    OUTPUT ORGANISASI
                  </span>

                  <h2 class="products-card__title">
                    Tambahkan produk atau hasil
                  </h2>

                  <p class="products-card__description">
                    Informasikan output yang memang dihasilkan oleh organisasi
                    dari aktivitas pengelolaan material.
                  </p>
                </div>

                <div class="products-card__icon">
                  <Package
                    size={22}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div class="products-notice">
                <div class="products-notice__icon">
                  <Leaf
                    size={19}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

                <div>
                  <strong>
                    Fokus pada hasil yang benar-benar tersedia
                  </strong>

                  <p>
                    Produk atau output sebaiknya menggambarkan kegiatan nyata
                    organisasi, bukan target atau rencana yang belum terealisasi.
                  </p>
                </div>
              </div>

              <div class="product-builder">
                <div class="product-builder__header">
                  <div>
                    <span class="product-builder__eyebrow">
                      JENIS OUTPUT
                    </span>

                    <h3>
                      Pilih kategori hasil
                    </h3>
                  </div>

                  <span
                    class="product-builder__count"
                    data-product-count
                  >
                    0 produk
                  </span>
                </div>

                <div
                  class="product-type-grid"
                  data-product-type-grid
                >
                  {
                    productTypes.map((type) => (
                      <button
                        type="button"
                        class="product-type-option"
                        data-product-type={type.id}
                      >
                        <span class="product-type-option__icon">
                          <Package
                            size={18}
                            stroke-width={1.9}
                            aria-hidden="true"
                          />
                        </span>

                        <span class="product-type-option__body">
                          <strong>
                            {type.label}
                          </strong>

                          <small>
                            {type.description}
                          </small>
                        </span>

                        <span class="product-type-option__arrow">
                          <Plus
                            size={16}
                            stroke-width={2}
                            aria-hidden="true"
                          />
                        </span>
                      </button>
                    ))
                  }
                </div>
              </div>

              <div class="product-list-section">
                <div class="product-list-section__header">
                  <div>
                    <span class="product-builder__eyebrow">
                      DAFTAR PRODUK
                    </span>

                    <h3>
                      Produk yang ditampilkan
                    </h3>
                  </div>

                  <span
                    class="product-list-section__count"
                    data-selected-product-count
                  >
                    0 produk
                  </span>
                </div>

                <div
                  class="product-list"
                  data-product-list
                >
                  <div
                    class="product-list-empty"
                    data-product-empty
                  >
                    <Package
                      size={26}
                      stroke-width={1.7}
                      aria-hidden="true"
                    />

                    <strong>
                      Belum ada produk
                    </strong>

                    <span>
                      Pilih jenis output di atas untuk menambahkan produk.
                    </span>
                  </div>
                </div>
              </div>
            </section>

            <section class="products-card">
              <div class="products-card__header">
                <div>
                  <span class="products-card__eyebrow">
                    INFORMASI PUBLIK
                  </span>

                  <h2 class="products-card__title">
                    Jelaskan produk atau hasil
                  </h2>

                  <p class="products-card__description">
                    Tambahkan keterangan yang membantu masyarakat memahami
                    bentuk, penggunaan, atau tujuan dari output organisasi.
                  </p>
                </div>

                <div class="products-card__icon">
                  <Image
                    size={22}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div class="field">
                <label
                  class="field__label"
                  for="productsDescription"
                >
                  Deskripsi produk & hasil
                </label>

                <p
                  class="field__hint"
                  id="productsDescriptionHint"
                >
                  Jelaskan hasil yang tersedia, karakteristik umum,
                  penggunaan, atau informasi relevan lain yang dapat
                  dibagikan kepada publik.
                </p>

                <textarea
                  id="productsDescription"
                  name="productsDescription"
                  class="field__textarea"
                  rows="8"
                  maxlength="2200"
                  placeholder="Contoh: Material yang telah dipilah dan diproses dapat diteruskan sebagai bahan baku atau produk yang sesuai dengan karakteristik material..."
                  aria-describedby="productsDescriptionHint productsDescriptionCounter"
                  data-products-description
                ></textarea>

                <div class="field__footer">
                  <span
                    class="field__counter"
                    data-products-description-counter
                  >
                    0 / 2200
                  </span>
                </div>
              </div>

              <div class="product-guidelines">
                <div class="product-guideline">
                  <div class="product-guideline__icon">
                    <CircleCheck
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>
                      Jelaskan output secara spesifik
                    </strong>

                    <span>
                      Gunakan istilah yang mudah dipahami dan sesuai dengan
                      hasil pengelolaan yang tersedia.
                    </span>
                  </div>
                </div>

                <div class="product-guideline">
                  <div class="product-guideline__icon">
                    <ShieldCheck
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>
                      Hindari klaim yang belum dapat dibuktikan
                    </strong>

                    <span>
                      Jangan menampilkan kapasitas, kualitas, atau penggunaan
                      tertentu apabila belum benar-benar tersedia.
                    </span>
                  </div>
                </div>
              </div>
            </section>

            <section class="products-card">
              <div class="products-card__header">
                <div>
                  <span class="products-card__eyebrow">
                    TAUTAN INFORMASI
                  </span>

                  <h2 class="products-card__title">
                    Referensi tambahan
                  </h2>

                  <p class="products-card__description">
                    Tambahkan halaman atau sumber publik yang membantu
                    menjelaskan produk atau hasil organisasi.
                  </p>
                </div>

                <div class="products-card__icon">
                  <ExternalLink
                    size={22}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div class="field">
                <label
                  class="field__label"
                  for="productWebsite"
                >
                  URL informasi
                </label>

                <p
                  class="field__hint"
                  id="productWebsiteHint"
                >
                  Opsional. Gunakan URL publik yang benar-benar dapat
                  diakses masyarakat.
                </p>

                <input
                  id="productWebsite"
                  name="productWebsite"
                  class="field__input"
                  type="url"
                  maxlength="300"
                  autocomplete="url"
                  placeholder="https://..."
                  aria-describedby="productWebsiteHint"
                />
              </div>
            </section>

            <section class="products-card products-card--save">
              <div class="save-box">
                <div class="save-box__icon">
                  <Save
                    size={21}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

                <div class="save-box__content">
                  <h2>
                    Simpan informasi produk
                  </h2>

                  <p>
                    Data produk, deskripsi, dan referensi akan dipersiapkan
                    untuk proses penyimpanan dan peninjauan organisasi.
                  </p>
                </div>
              </div>

              <div class="form-actions">
                <a
                  class="form-actions__back"
                  href="/organization"
                >
                  <ArrowLeft
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Kembali
                  </span>
                </a>

                <button
                  type="button"
                  class="form-actions__submit"
                  data-save-products
                >
                  <Save
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span data-save-label>
                    Simpan informasi
                  </span>
                </button>
              </div>

              <p
                class="save-message"
                data-save-message
                hidden
              ></p>
            </section>

            <div
              class="save-success"
              data-save-success
              hidden
            >
              <div class="save-success__icon">
                <CircleCheck
                  size={33}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                PRODUK DIPERSIAPKAN
              </span>

              <h2>
                Informasi produk berhasil dipersiapkan
              </h2>

              <p>
                Data produk dan hasil telah melalui pemeriksaan dasar pada
                browser dan siap diteruskan ke proses penyimpanan atau
                verifikasi.
              </p>

              <div class="save-success__actions">
                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  Kembali ke portal

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-products
                >
                  Edit kembali
                </button>
              </div>
            </div>
          </div>

          <aside class="products-sidebar">
            <div class="sidebar-card sidebar-card--highlight">
              <div class="sidebar-card__icon">
                <Package
                  size={20}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <span class="sidebar-card__eyebrow">
                RINGKASAN
              </span>

              <h2>
                Produk & hasil
              </h2>

              <div class="summary-number">
                <strong data-sidebar-product-count>
                  0
                </strong>

                <span>
                  produk tercatat
                </span>
              </div>

              <p>
                Tambahkan hanya output yang memang tersedia sebagai hasil
                aktivitas pengelolaan organisasi.
              </p>
            </div>

            <div class="sidebar-card">
              <span class="sidebar-card__eyebrow">
                PRINSIP INFORMASI
              </span>

              <h2>
                Tampilkan nilai yang nyata
              </h2>

              <div class="sidebar-check-list">
                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Produk benar-benar dihasilkan
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Deskripsi mudah dipahami
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Referensi publik dapat diverifikasi
                  </span>
                </div>
              </div>
            </div>

            <div class="sidebar-card sidebar-card--warning">
              <div class="sidebar-warning__icon">
                <TriangleAlert
                  size={18}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <strong>
                  Hindari klaim berlebihan
                </strong>

                <p>
                  Jangan menampilkan produk atau hasil yang belum benar-benar
                  tersedia atau belum dapat dibuktikan.
                </p>
              </div>
            </div>

            <div class="sidebar-card sidebar-card--next">
              <span class="sidebar-card__eyebrow">
                PORTAL ORGANISASI
              </span>

              <h2>
                Lengkapi informasi lainnya
              </h2>

              <a href="/organization/profile">
                Profil organisasi

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/waste">
                Sampah yang dikelola

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/process">
                Proses pengelolaan

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
</OrganizationLayout>

<style>
  .organization-products-page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .products-content {
    padding: var(--space-10) 0 var(--space-14);
  }

  .products-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .products-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      320px;
    gap: var(--space-7);
    align-items: start;
  }

  .products-main {
    min-width: 0;
  }

  .products-card {
    margin-bottom: var(--space-5);
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  .products-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .products-card__eyebrow,
  .product-builder__eyebrow,
  .sidebar-card__eyebrow,
  .save-success__eyebrow {
    display: block;
    color: var(--color-primary-dark);
    font-size: 0.64rem;
    font-weight: 850;
    letter-spacing: 0.11em;
  }

  .products-card__title {
    margin: var(--space-2) 0 0;
    color: var(--color-text-strong);
    font-size: 1.1rem;
    font-weight: 850;
    line-height: 1.3;
  }

  .products-card__description {
    max-width: 720px;
    margin: 5px 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.65;
  }

  .products-card__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .products-notice {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin-top: var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-primary-soft);
    border-radius: var(--radius-lg);
    background: var(--color-primary-soft);
  }

  .products-notice__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--color-surface);
    color: var(--color-primary);
  }

  .products-notice strong,
  .products-notice p {
    display: block;
  }

  .products-notice strong {
    color: var(--color-text-strong);
    font-size: var(--font-size-xs);
  }

  .products-notice p {
    margin: 3px 0 0;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .product-builder {
    margin-top: var(--space-7);
  }

  .product-builder__header,
  .product-list-section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .product-builder h3,
  .product-list-section h3 {
    margin: 4px 0 0;
    color: var(--color-text-strong);
    font-size: 0.95rem;
    font-weight: 800;
  }

  .product-builder__count,
  .product-list-section__count {
    color: var(--color-text-faint);
    font-size: 0.66rem;
    font-weight: 750;
  }

  .product-type-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .product-type-option {
    display: grid;
    grid-template-columns:
      40px
      minmax(0, 1fr)
      30px;
    gap: 10px;
    align-items: start;
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .product-type-option:hover {
    transform: translateY(-1px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-xs);
  }

  .product-type-option__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .product-type-option__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .product-type-option__body strong {
    color: var(--color-text-strong);
    font-size: var(--font-size-xs);
    font-weight: 800;
  }

  .product-type-option__body small {
    margin-top: 3px;
    color: var(--color-text-muted);
    font-size: 0.64rem;
    line-height: 1.5;
  }

  .product-type-option__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-surface-soft);
    color: var(--color-primary);
  }

  .product-list-section {
    margin-top: var(--space-8);
  }

  .product-list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .product-list-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    min-height: 190px;
    padding: var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text-faint);
    text-align: center;
  }

  .product-list-empty strong {
    margin-top: 9px;
    color: var(--color-text-strong);
    font-size: var(--font-size-sm);
  }

  .product-list-empty span {
    max-width: 350px;
    margin-top: 4px;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .product-item {
    display: grid;
    grid-template-columns:
      42px
      minmax(0, 1fr)
      auto;
    gap: 12px;
    align-items: center;
    padding: 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-soft);
  }

  .product-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .product-item__body {
    min-width: 0;
  }

  .product-item__body strong,
  .product-item__body span {
    display: block;
  }

  .product-item__body strong {
    color: var(--color-text-strong);
    font-size: var(--font-size-xs);
    font-weight: 800;
  }

  .product-item__body span {
    margin-top: 3px;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    line-height: 1.5;
  }

  .product-item__remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .product-item__remove:hover {
    border-color: var(--color-danger);
    color: var(--color-danger);
  }

  .field {
    padding-top: var(--space-6);
  }

  .field__label {
    display: inline-flex;
    margin-bottom: var(--space-2);
    color: var(--color-text-strong);
