---
import {
  ArrowRight,
  Building2,
  Check,
  ClipboardList,
  Leaf,
  Map,
  MapPin,
  Recycle,
  ShieldCheck,
  Users,
} from "@lucide/astro";

import PublicLayout from "@layouts/PublicLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Portal Organisasi — BINSIGHT",
  description:
    "Portal organisasi BINSIGHT untuk mengelola profil, informasi sampah, proses pengelolaan, dan informasi organisasi.",
  url: "https://binsight.id/organization",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<PublicLayout
  title="Portal Organisasi"
  description="Kelola informasi organisasi dan pengelolaan sampah melalui BINSIGHT."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="organization-page">
    <!-- ================================================================
         HERO
    ================================================================= -->
    <section class="organization-hero">
      <div class="organization-container">
        <div class="organization-hero__grid">
          <div class="organization-hero__content">
            <div class="organization-kicker">
              <span class="organization-kicker__line"></span>
              <span>ORGANIZATION / PORTAL</span>
            </div>

            <h1 class="organization-hero__title">
              KELOLA
              <span>IDENTITAS.</span>
              <span>KONEKSI.</span>
              <span>DAMPAK.</span>
            </h1>

            <p class="organization-hero__description">
              BINSIGHT membantu organisasi pengelola sampah menyusun
              informasi yang lebih terstruktur tentang identitas, lokasi,
              material yang dikelola, proses pengelolaan, dan informasi
              publik yang relevan.
            </p>

            <div class="organization-hero__actions">
              <a
                class="organization-button organization-button--primary"
                href="/organization/profile"
              >
                <Building2
                  size={18}
                  stroke-width={2.1}
                  aria-hidden="true"
                />

                <span>Kelola profil</span>

                <ArrowRight
                  size={17}
                  stroke-width={2.1}
                  aria-hidden="true"
                />
              </a>

              <a
                class="organization-button organization-button--secondary"
                href="/organization/waste"
              >
                <Recycle
                  size={18}
                  stroke-width={2.1}
                  aria-hidden="true"
                />

                <span>Kelola sampah</span>
              </a>
            </div>

            <div class="organization-hero__meta">
              <div>
                <span>MODULE</span>
                <strong>ORGANIZATION</strong>
              </div>

              <div>
                <span>AREA</span>
                <strong>BADUNG</strong>
              </div>

              <div>
                <span>STATUS</span>
                <strong>PUBLIC PROFILE</strong>
              </div>
            </div>
          </div>

          <div class="organization-hero__visual">
            <div class="organization-console">
              <div class="organization-console__header">
                <div class="organization-console__brand">
                  <div class="organization-console__mark">
                    <Leaf
                      size={19}
                      stroke-width={2.1}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>BINSIGHT</strong>
                    <span>ORGANIZATION PORTAL</span>
                  </div>
                </div>

                <span class="organization-console__code">
                  ORG / 001
                </span>
              </div>

              <div class="organization-console__body">
                <div class="organization-profile">
                  <div class="organization-profile__mark">
                    <Building2
                      size={22}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="organization-profile__copy">
                    <span>PROFILE LAYER</span>
                    <strong>Informasi organisasi</strong>
                    <small>Profil publik yang terstruktur</small>
                  </div>

                  <div class="organization-profile__status">
                    <Check
                      size={17}
                      stroke-width={2.5}
                      aria-hidden="true"
                    />
                  </div>
                </div>

                <div class="organization-console__grid">
                  <div class="console-stat">
                    <MapPin
                      size={17}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />

                    <span>LOKASI</span>
                    <strong>TERPETAKAN</strong>
                  </div>

                  <div class="console-stat">
                    <Recycle
                      size={17}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />

                    <span>MATERIAL</span>
                    <strong>TERCATAT</strong>
                  </div>

                  <div class="console-stat">
                    <ClipboardList
                      size={17}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />

                    <span>PROSES</span>
                    <strong>TERSTRUKTUR</strong>
                  </div>

                  <div class="console-stat">
                    <ShieldCheck
                      size={17}
                      stroke-width={1.9}
                      aria-hidden="true"
                    />

                    <span>VERIFIKASI</span>
                    <strong>READY</strong>
                  </div>
                </div>
              </div>

              <div class="organization-console__footer">
                <span>BADUNG WASTE INTELLIGENCE</span>
                <strong>BINSIGHT</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================
         MANAGEMENT
    ================================================================= -->
    <section class="organization-section organization-section--paper">
      <div class="organization-container">
        <div class="section-header section-header--split">
          <div>
            <div class="section-kicker">
              <span>01</span>
              <span>MANAGEMENT</span>
            </div>

            <h2>
              SATU PORTAL.
              <span>EMPAT LAYER INFORMASI.</span>
            </h2>
          </div>

          <p>
            Bangun profil organisasi dari identitas dasar hingga material,
            proses pengelolaan, dan hasil yang relevan untuk ditampilkan
            kepada masyarakat.
          </p>
        </div>

        <div class="management-grid">
          <a
            class="management-card management-card--featured"
            href="/organization/profile"
          >
            <div class="management-card__top">
              <span>01 / PROFILE</span>

              <div class="management-card__icon">
                <Building2
                  size={22}
                  stroke-width={1.9}
                  aria-hidden="true"
                />
              </div>
            </div>

            <div class="management-card__body">
              <h3>PROFIL</h3>

              <p>
                Atur identitas, nama organisasi, deskripsi, lokasi,
                kontak, dan informasi dasar yang membantu masyarakat
                mengenali organisasi.
              </p>
            </div>

            <span class="management-card__link">
              Kelola profil

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </span>
          </a>

          <a
            class="management-card"
            href="/organization/waste"
          >
            <div class="management-card__top">
              <span>02 / WASTE</span>

              <div class="management-card__icon">
                <Recycle
                  size={22}
                  stroke-width={1.9}
                  aria-hidden="true"
                />
              </div>
            </div>

            <div class="management-card__body">
              <h3>SAMPAH</h3>

              <p>
                Tampilkan material dan kategori sampah yang menjadi bagian
                dari aktivitas pengelolaan organisasi.
              </p>
            </div>

            <span class="management-card__link">
              Kelola sampah

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </span>
          </a>

          <a
            class="management-card"
            href="/organization/process"
          >
            <div class="management-card__top">
              <span>03 / PROCESS</span>

              <div class="management-card__icon">
                <ClipboardList
                  size={22}
                  stroke-width={1.9}
                  aria-hidden="true"
                />
              </div>
            </div>

            <div class="management-card__body">
              <h3>PROSES</h3>

              <p>
                Jelaskan tahapan pengumpulan, pemilahan, pengolahan,
                recovery, atau proses relevan lainnya.
              </p>
            </div>

            <span class="management-card__link">
              Kelola proses

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </span>
          </a>

          <a
            class="management-card"
            href="/organization/products"
          >
            <div class="management-card__top">
              <span>04 / OUTPUT</span>

              <div class="management-card__icon">
                <Leaf
                  size={22}
                  stroke-width={1.9}
                  aria-hidden="true"
                />
              </div>
            </div>

            <div class="management-card__body">
              <h3>HASIL</h3>

              <p>
                Perkenalkan hasil, output, atau produk yang relevan dengan
                aktivitas pengelolaan sampah organisasi.
              </p>
            </div>

            <span class="management-card__link">
              Kelola informasi

              <ArrowRight
                size={16}
                stroke-width={2}
                aria-hidden="true"
              />
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================================================================
         VALUE
    ================================================================= -->
    <section class="organization-section organization-section--light">
      <div class="organization-container">
        <div class="value-layout">
          <div class="value-content">
            <div class="section-kicker">
              <span>02</span>
              <span>PUBLIC VALUE</span>
            </div>

            <h2 class="value-title">
              BUKAN SEKADAR
              <span>HALAMAN PROFIL.</span>
            </h2>

            <p class="value-description">
              Profil organisasi di BINSIGHT dirancang sebagai bagian dari
              jaringan informasi yang menghubungkan organisasi, lokasi,
              material, dan proses pengelolaan.
            </p>
          </div>

          <div class="value-list">
            <article class="value-item">
              <div class="value-item__number">01</div>

              <div class="value-item__icon">
                <Map
                  size={19}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div class="value-item__content">
                <h3>LEBIH MUDAH DITEMUKAN</h3>

                <p>
                  Organisasi dapat tampil dalam konteks wilayah dan
                  informasi spasial BINSIGHT.
                </p>
              </div>
            </article>

            <article class="value-item">
              <div class="value-item__number">02</div>

              <div class="value-item__icon">
                <Recycle
                  size={19}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div class="value-item__content">
                <h3>LEBIH MUDAH DIPAHAMI</h3>

                <p>
                  Masyarakat dapat melihat material dan pendekatan
                  pengelolaan yang dijelaskan organisasi.
                </p>
              </div>
            </article>

            <article class="value-item">
              <div class="value-item__number">03</div>

              <div class="value-item__icon">
                <ShieldCheck
                  size={19}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div class="value-item__content">
                <h3>LEBIH TERPERCAYA</h3>

                <p>
                  Informasi organisasi dapat diarahkan melalui proses
                  verifikasi sebelum ditampilkan secara publik.
                </p>
              </div>
            </article>

            <article class="value-item">
              <div class="value-item__number">04</div>

              <div class="value-item__icon">
                <Users
                  size={19}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div class="value-item__content">
                <h3>LEBIH DEKAT DENGAN MASYARAKAT</h3>

                <p>
                  Informasi terbuka membantu masyarakat mengenali organisasi
                  dan perannya dalam ekosistem persampahan.
                </p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================
         VERIFICATION
    ================================================================= -->
    <section class="organization-section organization-section--dark">
      <div class="organization-container">
        <div class="trust-layout">
          <div class="trust-content">
            <div class="section-kicker section-kicker--dark">
              <span>03</span>
              <span>VERIFICATION</span>
            </div>

            <h2 class="trust-title">
              BANGUN PROFIL
              <span>YANG INFORMATIF.</span>
            </h2>

            <p class="trust-description">
              Informasi yang lengkap memberikan konteks yang lebih baik
              bagi masyarakat dan membantu proses peninjauan profil
              organisasi.
            </p>

            <a
              class="organization-button organization-button--light"
              href="/organization/profile"
            >
              <span>Lengkapi profil</span>

              <ArrowRight
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </div>

          <aside class="trust-card">
            <div class="trust-card__top">
              <div class="trust-card__icon">
                <ShieldCheck
                  size={24}
                  stroke-width={1.9}
                  aria-hidden="true"
                />
              </div>

              <span class="trust-card__code">
                PROFILE / PUBLIC
              </span>
            </div>

            <span class="trust-card__eyebrow">
              ORGANIZATION PROFILE
            </span>

            <h3>
              Informasi yang jelas menciptakan konteks yang lebih baik.
            </h3>

            <div class="trust-card__rows">
              <div>
                <span>IDENTITAS</span>
                <strong>Profil organisasi</strong>
              </div>

              <div>
                <span>LOKASI</span>
                <strong>Area & alamat</strong>
              </div>

              <div>
                <span>MATERIAL</span>
                <strong>Sampah dikelola</strong>
              </div>

              <div>
                <span>PROSES</span>
                <strong>Tahapan pengelolaan</strong>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ================================================================
         CTA
    ================================================================= -->
    <section class="organization-cta">
      <div class="organization-container">
        <div class="organization-cta__card">
          <div class="organization-cta__content">
            <div class="organization-kicker organization-kicker--dark">
              <span class="organization-kicker__line"></span>
              <span>START WITH PROFILE</span>
            </div>

            <h2>
              JADIKAN INFORMASI
              <span>ANDA BAGIAN DARI BINSIGHT.</span>
            </h2>

            <p>
              Lengkapi profil terlebih dahulu, lalu lanjutkan ke material,
              proses pengelolaan, dan informasi pendukung lainnya.
            </p>
          </div>

          <div class="organization-cta__actions">
            <a
              class="organization-button organization-button--primary"
              href="/organization/profile"
            >
              <Building2
                size={18}
                stroke-width={2}
                aria-hidden="true"
              />

              <span>Kelola profil</span>

              <ArrowRight
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>

            <a
              class="organization-button organization-button--secondary"
              href="/organization/process"
            >
              <span>Kelola proses</span>

              <ArrowRight
                size={17}
                stroke-width={2}
                aria-hidden="true"
              />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>

<style>
  .organization-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --orange: #ff6a00;

    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
  }

  .organization-page *,
  .organization-page *::before,
  .organization-page *::after {
    box-sizing: border-box;
  }

  .organization-page a {
    -webkit-tap-highlight-color: transparent;
  }

  .organization-container {
    width: min(1320px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* ================================================================
     SHARED
  ================================================================= */

  .organization-kicker,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .organization-kicker {
    color: var(--ink);
  }

  .organization-kicker__line {
    width: 30px;
    height: 3px;
    background: var(--acid);
  }

  .organization-kicker--dark {
    color: var(--ink);
  }

  .organization-kicker--dark .organization-kicker__line {
    background: var(--ink);
  }

  .section-kicker {
    color: var(--muted);
  }

  .section-kicker > span:first-child {
    color: var(--orange);
  }

  .section-kicker--dark {
    color: rgb(255 255 248 / 58%);
  }

  .section-kicker--dark > span:first-child {
    color: var(--acid);
  }

  /* ================================================================
     HERO
  ================================================================= */

  .organization-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 4px solid var(--ink);
    background:
      radial-gradient(
        circle at 83% 13%,
        rgb(223 255 0 / 14%),
        transparent 25%
      ),
      var(--paper);
  }

  .organization-hero::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 30%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(9 10 8 / 2%)
    );
    content: "";
    pointer-events: none;
  }

  .organization-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(410px, 0.95fr);
    gap: clamp(44px, 7vw, 110px);
    align-items: center;
    min-height: 720px;
    padding: 82px 0;
  }

  .organization-hero__content {
    max-width: 760px;
  }

  .organization-hero__title {
    margin: 22px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;
    font-size: clamp(3.1rem, 7vw, 6.7rem);
    font-weight: 800;
    letter-spacing: -0.075em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .organization-hero__title span {
    display: block;
  }

  .organization-hero__title span:first-of-type {
    color: var(--ink);
    text-shadow: 6px 6px 0 var(--acid);
  }

  .organization-hero__description {
    max-width: 700px;
    margin: 34px 0 0;
    color: #454a42;
    font-size: clamp(1rem, 1.6vw, 1.14rem);
    line-height: 1.74;
  }

  .organization-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .organization-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 50px;
    padding: 0 18px;
    border: 2px solid var(--ink);
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 150ms ease,
      box-shadow 150ms ease,
      background 150ms ease,
      color 150ms ease;
  }

  .organization-button:hover {
    transform: translate(-2px, -2px);
  }

  .organization-button:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  .organization-button--primary {
    background: var(--ink);
    color: var(--acid);
    box-shadow: 6px 6px 0 var(--acid);
  }

  .organization-button--primary:hover {
    background: var(--ink-3);
    box-shadow: 8px 8px 0 var(--acid);
  }

  .organization-button--secondary {
    background: transparent;
    color: var(--ink);
  }

  .organization-button--secondary:hover {
    background: var(--acid);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .organization-button--light {
    margin-top: 34px;
    border-color: var(--acid);
    background: var(--acid);
    color: var(--ink);
    box-shadow: 6px 6px 0 rgb(255 255 248 / 10%);
  }

  .organization-button--light:hover {
    background: var(--acid-soft);
    box-shadow: 8px 8px 0 rgb(255 255 248 / 10%);
  }

  .organization-hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 740px;
    margin-top: 52px;
    border-top: 2px solid var(--ink);
  }

  .organization-hero__meta > div {
    min-width: 0;
    padding: 13px 14px 0 0;
    border-right: 1px solid var(--paper-3);
  }

  .organization-hero__meta > div:not(:first-child) {
    padding-left: 14px;
  }

  .organization-hero__meta > div:last-child {
    border-right: 0;
  }

  .organization-hero__meta span,
  .organization-hero__meta strong {
    display: block;
  }

  .organization-hero__meta span {
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.53rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .organization-hero__meta strong {
    margin-top: 5px;
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.35;
  }

  /* ================================================================
     CONSOLE
  ================================================================= */

  .organization-hero__visual {
    display: flex;
    justify-content: flex-end;
  }

  .organization-console {
    width: min(100%, 550px);
    overflow: hidden;
    border: 3px solid var(--ink);
    background: var(--ink);
    box-shadow: 14px 14px 0 var(--acid);
  }

  .organization-console__header,
  .organization-console__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 18px;
  }

  .organization-console__header {
    border-bottom: 1px solid rgb(255 255 248 / 12%);
  }

  .organization-console__footer {
    border-top: 1px solid rgb(255 255 248 / 12%);
  }

  .organization-console__brand {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
  }

  .organization-console__mark {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--acid);
    color: var(--ink);
  }

  .organization-console__brand strong,
  .organization-console__brand span {
    display: block;
  }

  .organization-console__brand strong {
    color: var(--white);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
  }

  .organization-console__brand span {
    margin-top: 3px;
    color: rgb(255 255 248 / 46%);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.51rem;
