---
/**
 * ============================================================================
 * BINSIGHT — ORGANIZATION PROCESS
 * ============================================================================
 * Organization process builder.
 *
 * Principles:
 * - BINSIGHT brutalist editorial visual system.
 * - Existing process vocabulary only.
 * - No fabricated operational claims.
 * - Browser-side validation only.
 * - CustomEvent integration hook for future persistence.
 * - Safe across Astro client-side navigation.
 * - Accessible keyboard and focus behavior.
 * ============================================================================
 */

import {
  ArrowLeft,
  ArrowRight,
  CheckCircle,
  ClipboardList,
  Leaf,
  Plus,
  Recycle,
  Save,
  ShieldCheck,
  TriangleAlert,
} from "@lucide/astro";

import OrganizationLayout from "@layouts/OrganizationLayout.astro";

const processSteps = [
  {
    id: "collection",
    order: 1,
    title: "Pengumpulan",
    description:
      "Tahap pengumpulan material dari sumber atau titik yang telah ditentukan.",
  },
  {
    id: "sorting",
    order: 2,
    title: "Pemilahan",
    description:
      "Material dipisahkan berdasarkan jenis, karakteristik, atau tujuan pengelolaannya.",
  },
  {
    id: "processing",
    order: 3,
    title: "Pengolahan",
    description:
      "Material diproses menggunakan metode yang sesuai dengan karakteristiknya.",
  },
  {
    id: "recovery",
    order: 4,
    title: "Recovery",
    description:
      "Material atau nilai yang masih dapat dimanfaatkan dipulihkan dari aliran sampah.",
  },
  {
    id: "storage",
    order: 5,
    title: "Penyimpanan",
    description:
      "Material disimpan sementara sebelum diteruskan ke tahap berikutnya.",
  },
  {
    id: "treatment",
    order: 6,
    title: "Penanganan khusus",
    description:
      "Material tertentu mendapatkan penanganan tambahan sesuai karakteristiknya.",
  },
  {
    id: "disposal",
    order: 7,
    title: "Disposal",
    description:
      "Material yang tidak dapat dimanfaatkan diarahkan ke tahapan pembuangan yang sesuai.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Proses Pengelolaan — BINSIGHT",
  description:
    "Kelola informasi proses pengelolaan sampah organisasi melalui portal organisasi BINSIGHT.",
  url: "https://binsight.id/organization/process",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<OrganizationLayout
  title="Proses Pengelolaan"
  description="Kelola informasi tahapan proses pengelolaan sampah organisasi."
>
  <main class="organization-process-page">

    <!-- ================================================================== -->
    <!-- INTRO                                                              -->
    <!-- ================================================================== -->

    <section
      class="process-intro"
      aria-labelledby="process-page-title"
    >
      <div class="process-container process-intro__inner">

        <div class="process-intro__main">

          <span class="process-intro__eyebrow">
            ORGANIZATION / PROCESS
          </span>

          <h1
            id="process-page-title"
            class="process-intro__title"
          >
            Proses pengelolaan
          </h1>

          <p class="process-intro__description">
            Jelaskan tahapan pengelolaan yang benar-benar dilakukan
            organisasi agar masyarakat dapat memahami bagaimana material
            ditangani dari satu tahap ke tahap berikutnya.
          </p>

        </div>

        <div class="process-intro__status">

          <div class="process-intro__status-icon">
            <ClipboardList
              size={18}
              stroke-width={2}
              aria-hidden="true"
            />
          </div>

          <div>
            <span>PROCESS SCOPE</span>
            <strong>ALUR &amp; METODE</strong>
          </div>

        </div>

      </div>
    </section>

    <!-- ================================================================== -->
    <!-- CONTENT                                                            -->
    <!-- ================================================================== -->

    <section
      class="process-content"
      aria-label="Pengaturan proses organisasi"
    >
      <div class="process-container">

        <div class="process-layout">

          <!-- ============================================================ -->
          <!-- MAIN                                                          -->
          <!-- ============================================================ -->

          <div class="process-main">

            <form
              class="process-form"
              id="organization-process-form"
              data-process-form
              novalidate
            >

              <!-- ======================================================== -->
              <!-- BUILDER                                                    -->
              <!-- ======================================================== -->

              <section
                class="process-card"
                aria-labelledby="process-builder-title"
              >

                <header class="process-card__header">

                  <div>
                    <span class="process-card__eyebrow">
                      01 / TAHAPAN PENGELOLAAN
                    </span>

                    <h2
                      id="process-builder-title"
                      class="process-card__title"
                    >
                      Bangun alur proses organisasi
                    </h2>

                    <p class="process-card__description">
                      Pilih tahapan yang benar-benar dilakukan organisasi.
                      Urutan dapat disusun agar masyarakat mendapatkan
                      gambaran proses yang lebih jelas.
                    </p>
                  </div>

                  <div
                    class="process-card__icon"
                    aria-hidden="true"
                  >
                    <ClipboardList
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>

                </header>

                <div class="process-notice">

                  <div class="process-notice__icon">
                    <Leaf
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>
                      Gunakan alur yang mencerminkan kondisi nyata
                    </strong>

                    <span>
                      Tidak semua organisasi membutuhkan seluruh tahapan.
                      Pilih hanya proses yang memang tersedia dan dilakukan.
                    </span>
                  </div>

                </div>

                <div class="process-builder">

                  <div class="process-builder__label-row">

                    <div>
                      <span class="process-builder__eyebrow">
                        LANGKAH TERSEDIA
                      </span>

                      <h3>
                        Tahapan yang dapat dipilih
                      </h3>
                    </div>

                    <span
                      class="process-builder__count"
                      data-available-count
                    >
                      7 tahapan
                    </span>

                  </div>

                  <div
                    class="available-process-grid"
                    data-available-process-grid
                  >
                    {
                      processSteps.map((step) => (
                        <button
                          type="button"
                          class="available-process"
                          data-add-process={step.id}
                          aria-describedby={`process-${step.id}-description`}
                        >

                          <span
                            class="available-process__number"
                            aria-hidden="true"
                          >
                            {String(step.order).padStart(2, "0")}
                          </span>

                          <span class="available-process__body">

                            <strong>
                              {step.title}
                            </strong>

                            <small
                              id={`process-${step.id}-description`}
                            >
                              {step.description}
                            </small>

                          </span>

                          <span
                            class="available-process__add"
                            aria-hidden="true"
                          >
                            <Plus
                              size={16}
                              stroke-width={2}
                            />
                          </span>

                        </button>
                      ))
                    }
                  </div>

                </div>

                <!-- ====================================================== -->
                <!-- SELECTED PROCESS                                        -->
                <!-- ====================================================== -->

                <section
                  class="selected-process-section"
                  aria-labelledby="selected-process-title"
                >

                  <div
                    class="selected-process-section__header"
                  >

                    <div>
                      <span class="process-builder__eyebrow">
                        ALUR ORGANISASI
                      </span>

                      <h3 id="selected-process-title">
                        Urutan proses yang dipilih
                      </h3>
                    </div>

                    <span
                      class="selected-process-section__count"
                      data-selected-process-count
                      aria-live="polite"
                    >
                      0 langkah
                    </span>

                  </div>

                  <div
                    class="selected-process-list"
                    data-selected-process-list
                    aria-live="polite"
                  >

                    <div
                      class="selected-process-empty"
                      data-selected-process-empty
                    >
                      <ClipboardList
                        size={25}
                        stroke-width={1.7}
                        aria-hidden="true"
                      />

                      <strong>
                        Belum ada tahapan
                      </strong>

                      <span>
                        Pilih tahapan di atas untuk membangun alur
                        pengelolaan.
                      </span>
                    </div>

                  </div>

                </section>

              </section>

              <!-- ======================================================== -->
              <!-- DESCRIPTION                                                -->
              <!-- ======================================================== -->

              <section
                class="process-card"
                aria-labelledby="process-description-title"
              >

                <header class="process-card__header">

                  <div>
                    <span class="process-card__eyebrow">
                      02 / PENJELASAN PROSES
                    </span>

                    <h2
                      id="process-description-title"
                      class="process-card__title"
                    >
                      Berikan konteks tambahan
                    </h2>

                    <p class="process-card__description">
                      Jelaskan bagaimana alur tersebut dijalankan oleh
                      organisasi dan batasan proses yang perlu diketahui.
                    </p>
                  </div>

                  <div
                    class="process-card__icon"
                    aria-hidden="true"
                  >
                    <Recycle
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>

                </header>

                <div class="field">

                  <label
                    class="field__label"
                    for="processDescription"
                  >
                    Deskripsi keseluruhan proses
                  </label>

                  <p
                    class="field__hint"
                    id="processDescriptionHint"
                  >
                    Contoh: dari mana material berasal, bagaimana pemilahan
                    dilakukan, ke mana material diteruskan, dan informasi
                    penting lain yang memang dapat dipublikasikan.
                  </p>

                  <textarea
                    id="processDescription"
                    name="processDescription"
                    class="field__textarea"
                    rows="8"
                    maxlength="2200"
                    placeholder="Jelaskan alur pengelolaan organisasi secara umum..."
                    aria-describedby="processDescriptionHint processDescriptionCounter processDescriptionError"
                    data-process-description
                  ></textarea>

                  <div class="field__footer">

                    <p
                      id="processDescriptionError"
                      class="field-error"
                      data-description-error
                      role="alert"
                      hidden
                    ></p>

                    <span
                      class="field__counter"
                      id="processDescriptionCounter"
                      data-process-description-counter
                    >
                      0 / 2200
                    </span>

                  </div>

                </div>

                <div class="process-guidelines">

                  <div class="process-guideline">

                    <div class="process-guideline__icon">
                      <CheckCircle
                        size={17}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>

                    <div>
                      <strong>
                        Jelaskan dengan konkret
                      </strong>

                      <span>
                        Gunakan informasi yang membantu masyarakat memahami
                        proses tanpa membuat klaim yang berlebihan.
                      </span>
                    </div>

                  </div>

                  <div class="process-guideline">

                    <div class="process-guideline__icon">
                      <ShieldCheck
                        size={17}
                        stroke-width={2}
                        aria-hidden="true"
                      />
                    </div>

                    <div>
                      <strong>
                        Bedakan proses aktual dan rencana
                      </strong>

                      <span>
                        Tahapan yang belum berjalan sebaiknya tidak
                        ditampilkan sebagai aktivitas yang sudah dilakukan.
                      </span>
                    </div>

                  </div>

                </div>

              </section>

              <!-- ======================================================== -->
              <!-- SAVE                                                       -->
              <!-- ======================================================== -->

              <section class="process-card process-card--save">

                <div class="save-box">

                  <div class="save-box__icon">
                    <Save
                      size={20}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="save-box__content">

                    <span class="save-box__eyebrow">
                      READY FOR REVIEW
                    </span>

                    <h2>
                      Simpan alur proses
                    </h2>

                    <p>
                      Pilihan tahapan dan deskripsi proses akan dipersiapkan
                      untuk proses penyimpanan serta peninjauan organisasi.
                    </p>

                  </div>

                </div>

                <div class="form-actions">

                  <a
                    class="form-actions__back"
                    href="/organization"
                  >
                    <ArrowLeft
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>Kembali</span>
                  </a>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-save-process
                  >
                    <Save
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-save-label>
                      Simpan proses
                    </span>
                  </button>

                </div>

                <p
                  class="save-message"
                  data-save-message
                  aria-live="polite"
                  hidden
                ></p>

              </section>

            </form>

            <!-- ========================================================== -->
            <!-- SUCCESS                                                      -->
            <!-- ========================================================== -->

            <section
              class="save-success"
              data-save-success
              hidden
              aria-labelledby="save-success-title"
            >

              <span
                class="save-success__index"
                aria-hidden="true"
              >
                03
              </span>

              <div class="save-success__icon">
                <CheckCircle
                  size={32}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                PROSES DIPERSIAPKAN
              </span>

              <h2 id="save-success-title">
                Informasi proses berhasil dipersiapkan
              </h2>

              <p>
                Alur proses dan deskripsi telah melalui pemeriksaan dasar
                pada browser dan siap diteruskan ke proses penyimpanan atau
                verifikasi.
              </p>

              <div class="save-success__actions">

                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  <span>Kembali ke portal</span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-process
                >
                  Edit kembali
                </button>

              </div>

            </section>

          </div>

          <!-- ============================================================ -->
          <!-- SIDEBAR                                                       -->
          <!-- ============================================================ -->

          <aside
            class="process-sidebar"
            data-process-sidebar
            aria-label="Ringkasan dan panduan proses"
          >

            <section class="sidebar-card sidebar-card--highlight">

              <div
                class="sidebar-card__icon"
                aria-hidden="true"
              >
                <ClipboardList
                  size={20}
                  stroke-width={2}
                />
              </div>

              <span class="sidebar-card__eyebrow">
                RINGKASAN PROSES
              </span>

              <h2>
                Alur organisasi
              </h2>

              <div class="process-summary-number">

                <strong data-sidebar-step-count>
                  0
                </strong>

                <span>
                  langkah dipilih
                </span>

              </div>

              <div
                class="sidebar-mini-flow"
                data-sidebar-mini-flow
                aria-hidden="true"
              ></div>

              <p>
                Urutan proses membantu menjelaskan bagaimana material
                bergerak melalui aktivitas pengelolaan organisasi.
              </p>

            </section>

            <section class="sidebar-card">

              <span class="sidebar-card__eyebrow">
                PRINSIP DATA
              </span>

              <h2>
                Tampilkan kondisi sebenarnya
              </h2>

              <div class="sidebar-check-list">

                <div class="sidebar-check">
                  <CheckCircle
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Pilih tahapan yang benar-benar dilakukan
                  </span>
                </div>

                <div class="sidebar-check">
                  <CheckCircle
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Susun urutan proses secara logis
                  </span>
                </div>

                <div class="sidebar-check">
                  <CheckCircle
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Gunakan deskripsi yang dapat diverifikasi
                  </span>
                </div>

              </div>

            </section>

            <section class="sidebar-card sidebar-card--warning">

              <div
                class="sidebar-warning__icon"
                aria-hidden="true"
              >
                <TriangleAlert
                  size={18}
                  stroke-width={2}
                />
              </div>

              <div>

                <span class="sidebar-card__eyebrow">
                  PERHATIAN
                </span>

                <strong>
                  Hindari proses yang tidak dilakukan
                </strong>

                <p>
                  Jangan memilih tahapan hanya karena terlihat lengkap.
                  Informasi harus sesuai dengan kegiatan organisasi.
                </p>

              </div>

            </section>

            <section class="sidebar-card sidebar-card--next">

              <span class="sidebar-card__eyebrow">
                LANJUTKAN
              </span>

              <h2>
                Lengkapi informasi organisasi
              </h2>

              <a href="/organization/profile">
                <span>Kembali ke profil</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/waste">
                <span>Kelola sampah</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/products">
                <span>Kelola produk</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

            </section>

          </aside>

        </div>

      </div>
    </section>

  </main>
</OrganizationLayout>

<script
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
></script>

<style>
  /* ==========================================================================
     REMOVE ORGANIZATION WORKSPACE CHROME
     ========================================================================== */

  :global(.organization-layout__header) {
    display: none !important;
  }

  :global(.organization-layout__sidebar) {
    display: none !important;
  }

  :global(.organization-layout__mobile-topbar) {
    display: none !important;
  }

  :global(.organization-layout__main) {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    grid-column: 1 / -1 !important;
  }

  :global(.organization-layout__main-container) {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  :global(.organization-layout:has(.organization-process-page)) {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  :global(.organization-layout:has(.organization-process-page))
    .organization-layout__main {
    grid-column: 1 / -1 !important;
    width: 100% !important;
  }

  /* ==========================================================================
     PAGE
     ========================================================================== */

  .organization-process-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --muted-dark: #50554d;
    --orange: #ff6a00;
    --line: #b7b8ad;
    --danger: #b43d00;

    width: 100%;
    min-height: 100vh;
    color: var(--ink);
    background: var(--paper);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .organization-process-page *,
  .organization-process-page *::before,
  .organization-process-page *::after {
    box-sizing: border-box;
  }

  .organization-process-page a,
  .organization-process-page button,
  .organization-process-page textarea {
    -webkit-tap-highlight-color: transparent;
  }

  .process-container {
    width: min(1240px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* ==========================================================================
     INTRO
     ========================================================================== */

  .process-intro {
    position: relative;
    border-bottom: 3px solid var(--ink);
    background:
      radial-gradient(
        circle at 90% 0%,
        rgb(223 255 0 / 10%),
        transparent 23%
      ),
      repeating-linear-gradient(
        135deg,
        rgb(9 10 8 / 2.5%) 0 1px,
        transparent 1px 9px
      ),
      var(--paper);
  }

  .process-intro__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 38px;
    padding: 34px 0 38px;
  }

  .process-intro__main {
    min-width: 0;
  }

  .process-intro__eyebrow,
  .process-card__eyebrow,
  .process-builder__eyebrow,
  .sidebar-card__eyebrow,
  .save-box__eyebrow,
  .save-success__eyebrow {
    display: block;
    color: var(--orange);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.57rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .process-intro__title {
    max-width: 900px;
    margin: 12px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(2.45rem, 5vw, 5.25rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .process-intro__description {
    max-width: 720px;
    margin: 18px 0 0;
    color: #4e534b;
    font-size: 0.88rem;
    line-height: 1.72;
  }

  .process-intro__status {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 255px;
    flex: 0 0 auto;
    padding: 13px 15px;
    border: 3px solid var(--ink);
    background: var(--white);
    box-shadow: 7px 7px 0 var(--acid);
  }

  .process-intro__status-icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--ink);
    background: var(--acid);
  }

  .process-intro__status span,
  .process-intro__status strong {
    display: block;
  }

  .process-intro__status span {
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.48rem;
    font-weight: 900;
    letter-spacing: 0.09em;
  }

  .process-intro__status strong {
    margin-top: 4px;
    color: var(--ink);
    font-size: 0.67rem;
    font-weight: 900;
  }

  /* ==========================================================================
     CONTENT / LAYOUT
     ========================================================================== */

  .process-content {
    padding: 30px 0 82px;
    background:
      repeating-linear-gradient(
        0deg,
        rgb(9 10 8 / 2.6%) 0 1px,
        transparent 1px 8px
      ),
      var(--paper-2);
  }

  .process-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      315px;
    gap: 22px;
    align-items: start;
  }

  .process-main {
    min-width: 0;
  }

  .process-form {
    display: grid;
    gap: 16px;
  }

  /* ==========================================================================
     CARDS
     ========================================================================== */

