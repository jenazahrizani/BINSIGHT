</style>

<script>
  const initializeOrganizationProcessPage = () => {
    const form =
      document.querySelector<HTMLFormElement>(
        "[data-process-form]",
      );

    if (
      !form ||
      form.dataset.initialized === "true"
    ) {
      return;
    }

    form.dataset.initialized = "true";

    const availableProcessButtons =
      Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-add-process]",
        ),
      );

    const selectedProcessList =
      document.querySelector<HTMLElement>(
        "[data-selected-process-list]",
      );

    const selectedProcessEmpty =
      document.querySelector<HTMLElement>(
        "[data-selected-process-empty]",
      );

    const selectedProcessCount =
      document.querySelector<HTMLElement>(
        "[data-selected-process-count]",
      );

    const sidebarStepCount =
      document.querySelector<HTMLElement>(
        "[data-sidebar-step-count]",
      );

    const sidebarFlow =
      document.querySelector<HTMLElement>(
        "[data-sidebar-mini-flow]",
      );

    const availableCount =
      document.querySelector<HTMLElement>(
        "[data-available-count]",
      );

    const descriptionField =
      document.querySelector<HTMLTextAreaElement>(
        "[data-process-description]",
      );

    const descriptionCounter =
      document.querySelector<HTMLElement>(
        "[data-process-description-counter]",
      );

    const descriptionError =
      document.querySelector<HTMLElement>(
        "[data-description-error]",
      );

    const saveButton =
      document.querySelector<HTMLButtonElement>(
        "[data-save-process]",
      );

    const saveLabel =
      document.querySelector<HTMLElement>(
        "[data-save-label]",
      );

    const saveMessage =
      document.querySelector<HTMLElement>(
        "[data-save-message]",
      );

    const saveSuccess =
      document.querySelector<HTMLElement>(
        "[data-save-success]",
      );

    const sidebar =
      document.querySelector<HTMLElement>(
        "[data-process-sidebar]",
      );

    const editProcessButton =
      document.querySelector<HTMLButtonElement>(
        "[data-edit-process]",
      );

    const stepDefinitions = new Map(
      [
        [
          "collection",
          {
            id: "collection",
            order: 1,
            title: "Pengumpulan",
            description:
              "Tahap pengumpulan material dari sumber atau titik yang telah ditentukan.",
          },
        ],
        [
          "sorting",
          {
            id: "sorting",
            order: 2,
            title: "Pemilahan",
            description:
              "Material dipisahkan berdasarkan jenis, karakteristik, atau tujuan pengelolaannya.",
          },
        ],
        [
          "processing",
          {
            id: "processing",
            order: 3,
            title: "Pengolahan",
            description:
              "Material diproses menggunakan metode yang sesuai dengan karakteristiknya.",
          },
        ],
        [
          "recovery",
          {
            id: "recovery",
            order: 4,
            title: "Recovery",
            description:
              "Material atau nilai yang masih dapat dimanfaatkan dipulihkan dari aliran sampah.",
          },
        ],
        [
          "storage",
          {
            id: "storage",
            order: 5,
            title: "Penyimpanan",
            description:
              "Material disimpan sementara sebelum diteruskan ke tahap berikutnya.",
          },
        ],
        [
          "treatment",
          {
            id: "treatment",
            order: 6,
            title: "Penanganan khusus",
            description:
              "Material tertentu mendapatkan penanganan tambahan sesuai karakteristiknya.",
          },
        ],
        [
          "disposal",
          {
            id: "disposal",
            order: 7,
            title: "Disposal",
            description:
              "Material yang tidak dapat dimanfaatkan diarahkan ke tahapan pembuangan yang sesuai.",
          },
        ],
      ],
    );

    let selectedProcessIds: string[] = [];

    const getAvailableProcessCount = () => {
      return (
        stepDefinitions.size -
        selectedProcessIds.length
      );
    };

    const updateCounts = () => {
      const selectedCountValue =
        selectedProcessIds.length;

      const availableCountValue =
        getAvailableProcessCount();

      if (selectedProcessCount) {
        selectedProcessCount.textContent =
          `${selectedCountValue} langkah`;
      }

      if (sidebarStepCount) {
        sidebarStepCount.textContent =
          String(selectedCountValue);
      }

      if (availableCount) {
        availableCount.textContent =
          `${availableCountValue} tahapan`;
      }
    };

    const renderSidebarFlow = () => {
      if (!sidebarFlow) {
        return;
      }

      sidebarFlow.textContent = "";

      if (selectedProcessIds.length === 0) {
        return;
      }

      selectedProcessIds.forEach(
        (processId) => {
          const dot =
            document.createElement(
              "span",
            );

          dot.className =
            "sidebar-mini-flow__dot sidebar-mini-flow__dot--active";

          dot.setAttribute(
            "data-process-dot",
            processId,
          );

          sidebarFlow.appendChild(dot);
        },
      );
    };

    const updateAvailableButtons = () => {
      availableProcessButtons.forEach(
        (button) => {
          const id =
            button.getAttribute(
              "data-add-process",
            );

          const isSelected =
            id !== null &&
            selectedProcessIds.includes(id);

          button.disabled =
            isSelected;

          button.setAttribute(
            "aria-pressed",
            isSelected
              ? "true"
              : "false",
          );
        },
      );
    };

    const createActionButton = (
      action: "up" | "down" | "remove",
      label: string,
      symbol: string,
      disabled = false,
    ) => {
      const button =
        document.createElement(
          "button",
        );

      button.type = "button";
      button.className =
        "selected-process__action";

      if (action === "remove") {
        button.classList.add(
          "selected-process__action--remove",
        );
      }

      button.dataset.processAction =
        action;

      button.setAttribute(
        "aria-label",
        label,
      );

      button.textContent =
        symbol;

      button.disabled =
        disabled;

      return button;
    };

    const clearDescriptionError = () => {
      descriptionField?.removeAttribute(
        "aria-invalid",
      );

      if (descriptionError) {
        descriptionError.textContent =
          "";

        descriptionError.hidden =
          true;
      }
    };

    const clearSaveMessage = () => {
      if (!saveMessage) {
        return;
      }

      saveMessage.textContent = "";
      saveMessage.hidden = true;
    };

    const showSaveMessage = (
      message: string,
    ) => {
      if (!saveMessage) {
        return;
      }

      saveMessage.textContent =
        message;

      saveMessage.hidden =
        false;
    };

    const renderSelectedProcesses =
      () => {
        if (!selectedProcessList) {
          return;
        }

        selectedProcessList
          .querySelectorAll<HTMLElement>(
            "[data-selected-process]",
          )
          .forEach(
            (element) => {
              element.remove();
            },
          );

        if (
          selectedProcessIds.length ===
          0
        ) {
          if (selectedProcessEmpty) {
            selectedProcessEmpty.hidden =
              false;
          }

          updateCounts();
          renderSidebarFlow();
          updateAvailableButtons();

          return;
        }

        if (selectedProcessEmpty) {
          selectedProcessEmpty.hidden =
            true;
        }

        selectedProcessIds.forEach(
          (processId, index) => {
            const definition =
              stepDefinitions.get(
                processId,
              );

            if (!definition) {
              return;
            }

            const item =
              document.createElement(
                "div",
              );

            item.className =
              "selected-process";

            item.dataset.selectedProcess =
              processId;

            item.setAttribute(
              "aria-label",
              `${index + 1}. ${definition.title}`,
            );

            const number =
              document.createElement(
                "span",
              );

            number.className =
              "selected-process__number";

            number.textContent =
              String(index + 1).padStart(
                2,
                "0",
              );

            const body =
              document.createElement(
                "div",
              );

            body.className =
              "selected-process__body";

            const title =
              document.createElement(
                "strong",
              );

            title.textContent =
              definition.title;

            const description =
              document.createElement(
                "span",
              );

            description.textContent =
              definition.description;

            body.append(
              title,
              description,
            );

            const actions =
              document.createElement(
                "div",
              );

            actions.className =
              "selected-process__actions";

            const upButton =
              createActionButton(
                "up",
                `Pindahkan ${definition.title} ke atas`,
                "↑",
                index === 0,
              );

            const downButton =
              createActionButton(
                "down",
                `Pindahkan ${definition.title} ke bawah`,
                "↓",
                index ===
                  selectedProcessIds.length -
                    1,
              );

            const removeButton =
              createActionButton(
                "remove",
                `Hapus ${definition.title}`,
                "×",
              );

            actions.append(
              upButton,
              downButton,
              removeButton,
            );

            item.append(
              number,
              body,
              actions,
            );

            selectedProcessList.appendChild(
              item,
            );
          },
        );

        selectedProcessList
          .querySelectorAll<HTMLButtonElement>(
            "[data-process-action]",
          )
          .forEach((button) => {
            button.addEventListener(
              "click",
              () => {
                const parent =
                  button.closest<HTMLElement>(
                    "[data-selected-process]",
                  );

                if (!parent) {
                  return;
                }

                const processId =
                  parent.dataset
                    .selectedProcess;

                if (!processId) {
                  return;
                }

                const action =
                  button.dataset
                    .processAction;

                const index =
                  selectedProcessIds.indexOf(
                    processId,
                  );

                if (index < 0) {
                  return;
                }

                if (
                  action === "up" &&
                  index > 0
                ) {
                  const previous =
                    selectedProcessIds[
                      index - 1
                    ];

                  selectedProcessIds[
                    index - 1
                  ] = processId;

                  selectedProcessIds[
                    index
                  ] = previous;
                }

                if (
                  action === "down" &&
                  index <
                    selectedProcessIds.length -
                      1
                ) {
                  const next =
                    selectedProcessIds[
                      index + 1
                    ];

                  selectedProcessIds[
                    index + 1
                  ] = processId;

                  selectedProcessIds[
                    index
                  ] = next;
                }

                if (
                  action === "remove"
                ) {
                  selectedProcessIds =
                    selectedProcessIds.filter(
                      (value) =>
                        value !==
                        processId,
                    );
                }

                renderSelectedProcesses();
              },
            );
          });

        updateCounts();
        renderSidebarFlow();
        updateAvailableButtons();
      };

    const addProcess = (
      processId: string | null,
    ) => {
      if (
        !processId ||
        !stepDefinitions.has(
          processId,
        )
      ) {
        return;
      }

      if (
        selectedProcessIds.includes(
          processId,
        )
      ) {
        return;
      }

      selectedProcessIds.push(
        processId,
      );

      clearSaveMessage();
      renderSelectedProcesses();
    };

    const updateDescriptionCounter =
      () => {
        if (
          !descriptionField ||
          !descriptionCounter
        ) {
          return;
        }

        descriptionCounter.textContent =
          `${descriptionField.value.length} / 2200`;
      };

    const validateProcessData =
      () => {
        let valid = true;

        clearSaveMessage();
        clearDescriptionError();

        if (
          selectedProcessIds.length ===
          0
        ) {
          valid = false;

          showSaveMessage(
            "Pilih minimal satu tahapan proses sebelum menyimpan.",
          );

          selectedProcessList?.scrollIntoView(
            {
              behavior: "smooth",
              block: "center",
            },
          );

          return valid;
        }

        if (descriptionField) {
          const description =
            descriptionField.value.trim();

          if (
            description.length > 0 &&
            description.length < 20
          ) {
            valid = false;

            descriptionField.setAttribute(
              "aria-invalid",
              "true",
            );

            if (descriptionError) {
              descriptionError.textContent =
                "Deskripsi proses yang diisi minimal 20 karakter.";

              descriptionError.hidden =
                false;
            }

            descriptionField.scrollIntoView(
              {
                behavior: "smooth",
                block: "center",
              },
            );

            descriptionField.focus();

            return valid;
          }
        }

        return valid;
      };

    const buildProcessPayload = () => {
      return {
        steps:
          selectedProcessIds.map(
            (processId, index) => {
              const definition =
                stepDefinitions.get(
                  processId,
                );

              return {
                id: processId,
                name:
                  definition?.title ??
                  processId,
                description:
                  definition?.description ??
                  "",
                order: index + 1,
              };
            },
          ),

        description:
          descriptionField?.value.trim() ??
          "",

        updatedAt:
          new Date().toISOString(),
      };
    };

    const setEditorState = (
      hidden: boolean,
    ) => {
      const sections =
        Array.from(
          form.querySelectorAll<HTMLElement>(
            ".process-card",
          ),
        );

      sections.forEach(
        (section) => {
          section.hidden =
            hidden;
        },
      );

      if (sidebar) {
        sidebar.hidden =
          hidden;
      }

      if (saveSuccess) {
        saveSuccess.hidden =
          !hidden;
      }
    };

    const restoreEditor = () => {
      setEditorState(false);

      if (saveButton) {
        saveButton.disabled =
          false;
      }

      if (saveLabel) {
        saveLabel.textContent =
          "Simpan proses";
      }

      clearSaveMessage();

      descriptionField?.focus();

      form.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    };

    const handleSubmit = async (
      event: SubmitEvent,
    ) => {
      event.preventDefault();

      if (!validateProcessData()) {
        return;
      }

      const payload =
        buildProcessPayload();

      if (saveButton) {
        saveButton.disabled =
          true;
      }

      if (saveLabel) {
        saveLabel.textContent =
          "Menyiapkan...";
      }

      showSaveMessage(
        "Memeriksa informasi proses...",
      );

      await Promise.resolve();

      window.dispatchEvent(
        new CustomEvent(
          "binsight:organization-process-save",
          {
            detail: payload,
          },
        ),
      );

      setEditorState(true);
      clearSaveMessage();

      saveSuccess?.scrollIntoView(
        {
          behavior: "smooth",
          block: "start",
        },
      );
    };

    availableProcessButtons.forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            addProcess(
              button.getAttribute(
                "data-add-process",
              ),
            );
          },
        );
      },
    );

    descriptionField?.addEventListener(
      "input",
      () => {
        clearDescriptionError();
        updateDescriptionCounter();
      },
    );

    form.addEventListener(
      "submit",
      handleSubmit,
    );

    editProcessButton?.addEventListener(
      "click",
      restoreEditor,
    );

    renderSelectedProcesses();
    updateDescriptionCounter();
    updateCounts();
    updateAvailableButtons();
  };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeOrganizationProcessPage,
      { once: true },
    );
  } else {
    initializeOrganizationProcessPage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeOrganizationProcessPage,
  );
</script>
