  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */

  @media (max-width: 1050px) {
    .process-layout {
      grid-template-columns:
        minmax(0, 1fr);
    }

    .process-context {
      position:
        static;

      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

    .context-card--highlight,
    .context-card--next {
      grid-column:
        1 / -1;
    }
  }

  @media (max-width: 760px) {
    .process-hero {
      grid-template-columns:
        minmax(0, 1fr);
    }

    .process-hero__status {
      width:
        100%;
    }

    .available-process-grid {
      grid-template-columns:
        minmax(0, 1fr);
    }

    .selected-process {
      grid-template-columns:
        40px
        minmax(0, 1fr);
    }

    .selected-process__actions {
      grid-column:
        2;
    }
  }

  @media (max-width: 640px) {
    .process-page {
      padding:
        14px
        12px
        55px;
    }

    .process-hero {
      padding:
        19px;

      box-shadow:
        5px 5px 0
        var(--orange);
    }

    .process-hero__title {
      font-size:
        clamp(
          2rem,
          10vw,
          3.25rem
        );
    }

    .process-hero__description {
      font-size:
        0.74rem;
    }

    .process-layout {
      padding-top:
        18px;
    }

    .process-card__header {
      padding:
        18px;
    }

    .process-card__title {
      font-size:
        1rem;
    }

    .process-card__description {
      font-size:
        0.62rem;
    }

    .process-notice,
    .process-builder,
    .selected-process-section,
    .process-guidelines {
      margin-left:
        18px;

      margin-right:
        18px;
    }

    .field {
      padding-left:
        18px;

      padding-right:
        18px;
    }

    .process-card--save {
      padding-left:
        18px;

      padding-right:
        18px;
    }

    .form-actions {
      align-items:
        stretch;

      flex-direction:
        column-reverse;
    }

    .form-actions__submit,
    .form-actions__back {
      width:
        100%;
    }

    .save-message {
      text-align:
        center;
    }

    .process-context {
      grid-template-columns:
        minmax(0, 1fr);
    }

    .context-card--highlight,
    .context-card--next {
      grid-column:
        auto;
    }

    .save-success {
      padding:
        38px
        18px;
    }

    .save-success__actions {
      align-items:
        stretch;

      flex-direction:
        column;
    }
  }

  @media (max-width: 430px) {
    .process-page {
      padding-inline:
        8px;
    }

    .available-process {
      grid-template-columns:
        31px
        minmax(0, 1fr)
        29px;

      gap:
        8px;

      padding:
        11px;
    }

    .available-process__number {
      width:
        31px;

      height:
        31px;
    }

    .available-process__add {
      width:
        29px;

      height:
        29px;
    }

    .available-process__body
      small {
      font-size:
        0.56rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .organization-process-page
      * {
      scroll-behavior:
        auto !important;

      transition-duration:
        0.01ms !important;

      animation-duration:
        0.01ms !important;

      animation-iteration-count:
        1 !important;
    }

    .organization-process-page
      .form-actions__submit:hover,
    .organization-process-page
      .available-process:hover,
    .organization-process-page
      .selected-process__action:hover {
      transform:
        none;
    }
  }
</style>

<script>
  const initializeOrganizationProcessPage =
    () => {
      const form =
        document.querySelector<HTMLFormElement>(
          "[data-process-form]",
        );

      if (
        !form ||
        form.dataset.initialized === "true"
      ) {
        return;
      }

      form.dataset.initialized =
        "true";

      const availableProcessButtons =
        Array.from(
          document.querySelectorAll<HTMLButtonElement>(
            "[data-add-process]",
          ),
        );

      const selectedProcessList =
        document.querySelector<HTMLElement>(
          "[data-selected-process-list]",
        );

      const selectedProcessEmpty =
        document.querySelector<HTMLElement>(
          "[data-selected-process-empty]",
        );

      const selectedProcessCount =
        document.querySelector<HTMLElement>(
          "[data-selected-process-count]",
        );

      const sidebarStepCount =
        document.querySelector<HTMLElement>(
          "[data-sidebar-step-count]",
        );

      const sidebarFlow =
        document.querySelector<HTMLElement>(
          "[data-sidebar-mini-flow]",
        );

      const availableCount =
        document.querySelector<HTMLElement>(
          "[data-available-count]",
        );

      const descriptionField =
        document.querySelector<HTMLTextAreaElement>(
          "[data-process-description]",
        );

      const descriptionCounter =
        document.querySelector<HTMLElement>(
          "[data-process-description-counter]",
        );

      const descriptionError =
        document.querySelector<HTMLElement>(
          "[data-description-error]",
        );

      const saveButton =
        document.querySelector<HTMLButtonElement>(
          "[data-save-process]",
        );

      const saveLabel =
        document.querySelector<HTMLElement>(
          "[data-save-label]",
        );

      const saveMessage =
        document.querySelector<HTMLElement>(
          "[data-save-message]",
        );

      const saveSuccess =
        document.querySelector<HTMLElement>(
          "[data-save-success]",
        );

      const contextSidebar =
        document.querySelector<HTMLElement>(
          "[data-process-sidebar]",
        );

      const editProcessButton =
        document.querySelector<HTMLButtonElement>(
          "[data-edit-process]",
        );

      const stepDefinitions = new Map(
        processSteps.map((step) => [
          step.id,
          step,
        ]),
      );

      let selectedProcessIds: string[] =
        [];

      const updateCounts = () => {
        const selectedCount =
          selectedProcessIds.length;

        const availableCountValue =
          stepDefinitions.size -
          selectedCount;

        if (selectedProcessCount) {
          selectedProcessCount.textContent =
            `${selectedCount} langkah`;
        }

        if (sidebarStepCount) {
          sidebarStepCount.textContent =
            String(selectedCount);
        }

        if (availableCount) {
          availableCount.textContent =
            `${availableCountValue} tahapan`;
        }
      };

      const renderSidebarFlow = () => {
        if (!sidebarFlow) {
          return;
        }

        sidebarFlow.replaceChildren();

        selectedProcessIds.forEach(
          () => {
            const dot =
              document.createElement(
                "span",
              );

            dot.className =
              "sidebar-mini-flow__dot sidebar-mini-flow__dot--active";

            dot.setAttribute(
              "aria-hidden",
              "true",
            );

            sidebarFlow.appendChild(
              dot,
            );
          },
        );
      };

      const updateAvailableButtons =
        () => {
          availableProcessButtons.forEach(
            (button) => {
              const id =
                button.getAttribute(
                  "data-add-process",
                );

              const selected =
                id !== null &&
                selectedProcessIds.includes(
                  id,
                );

              button.disabled =
                selected;

              button.setAttribute(
                "aria-pressed",
                selected
                  ? "true"
                  : "false",
              );
            },
          );
        };

      const createActionButton = (
        action:
          | "up"
          | "down"
          | "remove",
        label: string,
        symbol: string,
        disabled = false,
      ) => {
        const button =
          document.createElement(
            "button",
          );

        button.type =
          "button";

        button.className =
          "selected-process__action";

        if (
          action ===
          "remove"
        ) {
          button.classList.add(
            "selected-process__action--remove",
          );
        }

        button.dataset.processAction =
          action;

        button.setAttribute(
          "aria-label",
          label,
        );

        button.textContent =
          symbol;

        button.disabled =
          disabled;

        return button;
      };

      const clearDescriptionError =
        () => {
          descriptionField?.removeAttribute(
            "aria-invalid",
          );

          if (descriptionError) {
            descriptionError.textContent =
              "";

            descriptionError.hidden =
              true;
          }
        };

      const clearSaveMessage =
        () => {
          if (!saveMessage) {
            return;
          }

          saveMessage.textContent =
            "";

          saveMessage.hidden =
            true;
        };

      const showSaveMessage = (
        message: string,
      ) => {
        if (!saveMessage) {
          return;
        }

        saveMessage.textContent =
          message;

        saveMessage.hidden =
          false;
      };

      const renderSelectedProcesses =
        () => {
          if (
            !selectedProcessList
          ) {
            return;
          }

          selectedProcessList
            .querySelectorAll<HTMLElement>(
              "[data-selected-process]",
            )
            .forEach(
              (element) => {
                element.remove();
              },
            );

          if (
            selectedProcessIds.length ===
            0
          ) {
            if (
              selectedProcessEmpty
            ) {
              selectedProcessEmpty.hidden =
                false;
            }

            updateCounts();
            renderSidebarFlow();
            updateAvailableButtons();

            return;
          }

          if (
            selectedProcessEmpty
          ) {
            selectedProcessEmpty.hidden =
              true;
          }

          selectedProcessIds.forEach(
            (
              processId,
              index,
            ) => {
              const definition =
                stepDefinitions.get(
                  processId,
                );

              if (!definition) {
                return;
              }

              const item =
                document.createElement(
                  "div",
                );

              item.className =
                "selected-process";

              item.dataset.selectedProcess =
                processId;

              const number =
                document.createElement(
                  "span",
                );

              number.className =
                "selected-process__number";

              number.textContent =
                String(
                  index + 1,
                ).padStart(
                  2,
                  "0",
                );

              const body =
                document.createElement(
                  "div",
                );

              body.className =
                "selected-process__body";

              const title =
                document.createElement(
                  "strong",
                );

              title.textContent =
                definition.title;

              const description =
                document.createElement(
                  "span",
                );

              description.textContent =
                definition.description;

              body.append(
                title,
                description,
              );

              const actions =
                document.createElement(
                  "div",
                );

              actions.className =
                "selected-process__actions";

              const upButton =
                createActionButton(
                  "up",
                  `Pindahkan ${definition.title} ke atas`,
                  "↑",
                  index === 0,
                );

              const downButton =
                createActionButton(
                  "down",
                  `Pindahkan ${definition.title} ke bawah`,
                  "↓",
                  index ===
                    selectedProcessIds.length -
                      1,
                );

              const removeButton =
                createActionButton(
                  "remove",
                  `Hapus ${definition.title}`,
                  "×",
                );

              actions.append(
                upButton,
                downButton,
                removeButton,
              );

              item.append(
                number,
                body,
                actions,
              );

              selectedProcessList.appendChild(
                item,
              );
            },
          );

          selectedProcessList
            .querySelectorAll<HTMLButtonElement>(
              "[data-process-action]",
            )
            .forEach(
              (button) => {
                button.addEventListener(
                  "click",
                  () => {
                    const parent =
                      button.closest<HTMLElement>(
                        "[data-selected-process]",
                      );

                    if (!parent) {
                      return;
                    }

                    const processId =
                      parent.dataset
                        .selectedProcess;

                    if (!processId) {
                      return;
                    }

                    const action =
                      button.dataset
                        .processAction;

                    const index =
                      selectedProcessIds.indexOf(
                        processId,
                      );

                    if (
                      index < 0
                    ) {
                      return;
                    }

                    if (
                      action === "up" &&
                      index > 0
                    ) {
                      [
                        selectedProcessIds[
                          index - 1
                        ],
                        selectedProcessIds[
                          index
                        ],
                      ] = [
                        selectedProcessIds[
                          index
                        ],
                        selectedProcessIds[
                          index - 1
                        ],
                      ];
                    }

                    if (
                      action === "down" &&
                      index <
                        selectedProcessIds.length -
                          1
                    ) {
                      [
                        selectedProcessIds[
                          index
                        ],
                        selectedProcessIds[
                          index + 1
                        ],
                      ] = [
                        selectedProcessIds[
                          index + 1
                        ],
                        selectedProcessIds[
                          index
                        ],
                      ];
                    }

                    if (
                      action === "remove"
                    ) {
                      selectedProcessIds =
                        selectedProcessIds.filter(
                          (value) =>
                            value !==
                            processId,
                        );
                    }

                    renderSelectedProcesses();
                  },
                );
              },
            );

          updateCounts();
          renderSidebarFlow();
          updateAvailableButtons();
        };

      const addProcess = (
        processId: string | null,
      ) => {
        if (
          !processId ||
          !stepDefinitions.has(
            processId,
          )
        ) {
          return;
        }

        if (
          selectedProcessIds.includes(
            processId,
          )
        ) {
          return;
        }

        selectedProcessIds.push(
          processId,
        );

        clearSaveMessage();
        renderSelectedProcesses();
      };

      const updateDescriptionCounter =
        () => {
          if (
            !descriptionField ||
            !descriptionCounter
          ) {
            return;
          }

          descriptionCounter.textContent =
            `${descriptionField.value.length} / 2200`;
        };

      const validateProcessData =
        () => {
          clearSaveMessage();
          clearDescriptionError();

          if (
            selectedProcessIds.length ===
            0
          ) {
            showSaveMessage(
              "Pilih minimal satu tahapan proses sebelum menyimpan.",
            );

            selectedProcessList?.scrollIntoView(
              {
                behavior:
                  "smooth",
                block: "center",
              },
            );

            return false;
          }

          if (descriptionField) {
            const description =
              descriptionField.value.trim();

            if (
              description.length >
                0 &&
              description.length <
                20
            ) {
              descriptionField.setAttribute(
                "aria-invalid",
                "true",
              );

              if (
                descriptionError
              ) {
                descriptionError.textContent =
                  "Deskripsi proses yang diisi minimal 20 karakter.";

                descriptionError.hidden =
                  false;
              }

              descriptionField.scrollIntoView(
                {
                  behavior:
                    "smooth",
                  block: "center",
                },
              );

              descriptionField.focus();

              return false;
            }
          }

          return true;
        };

      const buildProcessPayload =
        () => ({
          steps:
            selectedProcessIds.map(
              (
                processId,
                index,
              ) => {
                const definition =
                  stepDefinitions.get(
                    processId,
                  );

                return {
                  id: processId,
                  name:
                    definition?.title ??
                    processId,
                  description:
                    definition?.description ??
                    "",
                  order:
                    index + 1,
                };
              },
            ),

          description:
            descriptionField?.value.trim() ??
            "",

          updatedAt:
            new Date().toISOString(),
        });

      const setEditorState = (
        hidden: boolean,
      ) => {
        form
          .querySelectorAll<HTMLElement>(
            ".process-card",
          )
          .forEach(
            (section) => {
              section.hidden =
                hidden;
            },
          );

        if (
          contextSidebar
        ) {
          contextSidebar.hidden =
            hidden;
        }

        if (
          saveSuccess
        ) {
          saveSuccess.hidden =
            !hidden;
        }
      };

      const restoreEditor =
        () => {
          setEditorState(
            false,
          );

          if (
            saveButton
          ) {
            saveButton.disabled =
              false;
          }

          if (
            saveLabel
          ) {
            saveLabel.textContent =
              "Simpan proses";
          }

          clearSaveMessage();

          form.scrollIntoView({
            behavior:
              "smooth",
            block:
              "start",
          });

          descriptionField?.focus();
        };

      const handleSubmit = async (
        event: SubmitEvent,
      ) => {
        event.preventDefault();

        if (
          !validateProcessData()
        ) {
          return;
        }

        const payload =
          buildProcessPayload();

        if (
          saveButton
        ) {
          saveButton.disabled =
            true;
        }

        if (
          saveLabel
        ) {
          saveLabel.textContent =
            "Menyiapkan...";
        }

        showSaveMessage(
          "Memeriksa informasi proses...",
        );

        await Promise.resolve();

        window.dispatchEvent(
          new CustomEvent(
            "binsight:organization-process-save",
            {
              detail:
                payload,
            },
          ),
        );

        setEditorState(
          true,
        );

        clearSaveMessage();

        saveSuccess?.scrollIntoView(
          {
            behavior:
              "smooth",
            block:
              "start",
          },
        );
      };

      availableProcessButtons.forEach(
        (button) => {
          button.addEventListener(
            "click",
            () => {
              addProcess(
                button.getAttribute(
                  "data-add-process",
                ),
              );
            },
          );
        },
      );

      descriptionField?.addEventListener(
        "input",
        () => {
          clearDescriptionError();
          updateDescriptionCounter();
        },
      );

      form.addEventListener(
        "submit",
        handleSubmit,
      );

      editProcessButton?.addEventListener(
        "click",
        restoreEditor,
      );

      renderSelectedProcesses();
      updateDescriptionCounter();
      updateCounts();
      updateAvailableButtons();
    };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeOrganizationProcessPage,
      { once: true },
    );
  } else {
    initializeOrganizationProcessPage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeOrganizationProcessPage,
  );
</script>