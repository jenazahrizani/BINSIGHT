    border:
      2px solid
      var(--ink);
  }

  .save-success__eyebrow {
    margin-top:
      17px;
  }

  .save-success
    h2 {
    max-width:
      720px;

    margin:
      8px
      auto
      0;

    color:
      var(--ink);

    font-family:
      Sora,
