</style>

<script>
// @ts-nocheck

  const availableProcessButtons =
    Array.from(
      document.querySelectorAll(
        "[data-add-process]",
      ),
    );

  const selectedProcessList =
    document.querySelector(
      "[data-selected-process-list]",
    );

  const selectedProcessEmpty =
    document.querySelector(
      "[data-selected-process-empty]",
    );

  const selectedProcessCount =
    document.querySelector(
      "[data-selected-process-count]",
    );

  const sidebarStepCount =
    document.querySelector(
      "[data-sidebar-step-count]",
    );

  const availableCount =
    document.querySelector(
      "[data-available-count]",
    );

  const descriptionField =
    document.querySelector(
      "[data-process-description]",
    );

  const descriptionCounter =
    document.querySelector(
      "[data-process-description-counter]",
    );

  const saveButton =
    document.querySelector(
      "[data-save-process]",
    );

  const saveLabel =
    document.querySelector(
      "[data-save-label]",
    );

  const saveMessage =
    document.querySelector(
      "[data-save-message]",
    );

  const saveSuccess =
    document.querySelector(
      "[data-save-success]",
    );

  const editProcessButton =
    document.querySelector(
      "[data-edit-process]",
    );

  const stepDefinitions = {
    collection: {
      id: "collection",
      order: 1,
      title: "Pengumpulan",
      description:
        "Tahap pengumpulan material dari sumber atau titik yang telah ditentukan.",
    },

    sorting: {
      id: "sorting",
      order: 2,
      title: "Pemilahan",
      description:
        "Material dipisahkan berdasarkan jenis, karakteristik, atau tujuan pengelolaannya.",
    },

    processing: {
      id: "processing",
      order: 3,
      title: "Pengolahan",
      description:
        "Material diproses menggunakan metode yang sesuai dengan karakteristiknya.",
    },

    recovery: {
      id: "recovery",
      order: 4,
      title: "Recovery",
      description:
        "Material atau nilai yang masih dapat dimanfaatkan dipulihkan dari aliran sampah.",
    },

    storage: {
      id: "storage",
      order: 5,
      title: "Penyimpanan",
      description:
        "Material disimpan sementara sebelum diteruskan ke tahap berikutnya.",
    },

    treatment: {
      id: "treatment",
      order: 6,
      title: "Penanganan khusus",
      description:
        "Material tertentu mendapatkan penanganan tambahan sesuai karakteristiknya.",
    },

    disposal: {
      id: "disposal",
      order: 7,
      title: "Disposal",
      description:
        "Material yang tidak dapat dimanfaatkan diarahkan ke tahapan pembuangan yang sesuai.",
    },
  };

  let selectedProcessIds = [];

  function getAvailableProcessCount() {
    return Object.keys(
      stepDefinitions,
    ).length - selectedProcessIds.length;
  }

  function updateAvailableCount() {
    if (
      !(availableCount instanceof HTMLElement)
    ) {
      return;
    }

    const count =
      getAvailableProcessCount();

    availableCount.textContent =
      `${count} tahapan`;
  }

  function updateSelectedProcessCount() {
    const count =
      selectedProcessIds.length;

    if (
      selectedProcessCount instanceof HTMLElement
    ) {
      selectedProcessCount.textContent =
        `${count} langkah`;
    }

    if (
      sidebarStepCount instanceof HTMLElement
    ) {
      sidebarStepCount.textContent =
        String(count);
    }

    updateAvailableCount();
  }

  function updateAvailableButtons() {
    availableProcessButtons.forEach(
      (button) => {
        const id =
          button.getAttribute(
            "data-add-process",
          );

        const selected =
          id &&
          selectedProcessIds.includes(
            id,
          );

        button.disabled =
          Boolean(selected);
      },
    );
  }

  function createActionButton(
    action,
    label,
    icon,
  ) {
    const button =
      document.createElement(
        "button",
      );

    button.type = "button";

    button.className =
      "selected-process__action";

    button.setAttribute(
      "data-process-action",
      action,
    );

    button.setAttribute(
      "aria-label",
      label,
    );

    button.innerHTML = icon;

    return button;
  }

  function renderSelectedProcesses() {
    if (
      !(selectedProcessList instanceof HTMLElement)
    ) {
      return;
    }

    selectedProcessList
      .querySelectorAll(
        ".selected-process",
      )
      .forEach(
        (element) => {
          element.remove();
        },
      );

    if (
      selectedProcessIds.length === 0
    ) {
      if (
        selectedProcessEmpty instanceof HTMLElement
      ) {
        selectedProcessEmpty.hidden =
          false;
      }

      updateSelectedProcessCount();
      updateAvailableButtons();

      return;
    }

    if (
      selectedProcessEmpty instanceof HTMLElement
    ) {
      selectedProcessEmpty.hidden =
        true;
    }

    selectedProcessIds.forEach(
      (
        processId,
        index,
      ) => {
        const definition =
          stepDefinitions[
            processId
          ];

        if (!definition) {
          return;
        }

        const item =
          document.createElement(
            "div",
          );

        item.className =
          "selected-process";

        item.setAttribute(
          "data-selected-process",
          processId,
        );

        const number =
          document.createElement(
            "span",
          );

        number.className =
          "selected-process__number";

        number.textContent =
          String(
            index + 1,
          ).padStart(2, "0");

        const body =
          document.createElement(
            "div",
          );

        body.className =
          "selected-process__body";

        const title =
          document.createElement(
            "strong",
          );

        title.textContent =
          definition.title;

        const description =
          document.createElement(
            "span",
          );

        description.textContent =
          definition.description;

        body.append(
          title,
          description,
        );

        const actions =
          document.createElement(
            "div",
          );

        actions.className =
          "selected-process__actions";

        const upButton =
          createActionButton(
            "up",
            `Pindahkan ${definition.title} ke atas`,
            "↑",
          );

        const downButton =
          createActionButton(
            "down",
            `Pindahkan ${definition.title} ke bawah`,
            "↓",
          );

        const removeButton =
          createActionButton(
            "remove",
            `Hapus ${definition.title}`,
            "×",
          );

        if (index === 0) {
          upButton.disabled = true;
        }

        if (
          index ===
          selectedProcessIds.length - 1
        ) {
          downButton.disabled = true;
        }

        actions.append(
          upButton,
          downButton,
          removeButton,
        );

        item.append(
          number,
          body,
          actions,
        );

        selectedProcessList.appendChild(
          item,
        );
      },
    );

    updateSelectedProcessCount();
    updateAvailableButtons();

    selectedProcessList
      .querySelectorAll(
        "[data-process-action]",
      )
      .forEach(
        (button) => {
          button.addEventListener(
            "click",
            () => {
              const parent =
                button.closest(
                  "[data-selected-process]",
                );

              if (
                !(parent instanceof HTMLElement)
              ) {
                return;
              }

              const processId =
                parent.getAttribute(
                  "data-selected-process",
                );

              if (!processId) {
                return;
              }

              const action =
                button.getAttribute(
                  "data-process-action",
                );

              const index =
                selectedProcessIds.indexOf(
                  processId,
                );

              if (index < 0) {
                return;
              }

              if (action === "up" && index > 0) {
                const previous =
                  selectedProcessIds[
                    index - 1
                  ];

                selectedProcessIds[
                  index - 1
                ] = processId;

                selectedProcessIds[
                  index
                ] = previous;
              }

              if (
                action === "down" &&
                index <
                  selectedProcessIds.length - 1
              ) {
                const next =
                  selectedProcessIds[
                    index + 1
                  ];

                selectedProcessIds[
                  index + 1
                ] = processId;

                selectedProcessIds[
                  index
                ] = next;
              }

              if (action === "remove") {
                selectedProcessIds =
                  selectedProcessIds.filter(
                    (value) =>
                      value !== processId,
                  );
              }

              renderSelectedProcesses();
            },
          );
        },
      );
  }

  function addProcess(
    processId,
  ) {
    if (
      !processId ||
      !stepDefinitions[processId]
    ) {
      return;
    }

    if (
      selectedProcessIds.includes(
        processId,
      )
    ) {
      return;
    }

    selectedProcessIds.push(
      processId,
    );

    renderSelectedProcesses();
  }

  function updateDescriptionCounter() {
    if (
      !(descriptionField instanceof HTMLTextAreaElement) ||
      !(descriptionCounter instanceof HTMLElement)
    ) {
      return;
    }

    descriptionCounter.textContent =
      `${descriptionField.value.length} / 2200`;
  }

  function validateProcessData() {
    if (
      selectedProcessIds.length === 0
    ) {
      if (
        saveMessage instanceof HTMLElement
      ) {
        saveMessage.textContent =
          "Pilih minimal satu tahapan proses sebelum menyimpan.";

        saveMessage.hidden = false;
      }

      if (
        selectedProcessList instanceof HTMLElement
      ) {
        selectedProcessList.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
      }

      return false;
    }

    if (
      descriptionField instanceof HTMLTextAreaElement
    ) {
      const description =
        descriptionField.value.trim();

      if (
        description.length > 0 &&
        description.length < 20
      ) {
        descriptionField.setAttribute(
          "aria-invalid",
          "true",
        );

        if (
          saveMessage instanceof HTMLElement
        ) {
          saveMessage.textContent =
            "Deskripsi proses yang diisi minimal 20 karakter.";

          saveMessage.hidden = false;
        }

        descriptionField.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        descriptionField.focus();

        return false;
      }

      descriptionField.removeAttribute(
        "aria-invalid",
      );
    }

    return true;
  }

  function buildProcessPayload() {
    return {
      steps:
        selectedProcessIds.map(
          (
            processId,
            index,
          ) => {
            const definition =
              stepDefinitions[
                processId
              ];

            return {
              id: processId,
              name:
                definition?.title ??
                processId,
              description:
                definition?.description ??
                "",
              order:
                index + 1,
            };
          },
        ),

      description:
        descriptionField instanceof
        HTMLTextAreaElement
          ? descriptionField.value.trim()
          : "",

      updatedAt:
        new Date().toISOString(),
    };
  }

  async function saveProcess() {
    if (!validateProcessData()) {
      return;
    }

    const payload =
      buildProcessPayload();

    if (
      saveButton instanceof HTMLButtonElement
    ) {
      saveButton.disabled = true;
    }

    if (
      saveLabel instanceof HTMLElement
    ) {
      saveLabel.textContent =
        "Menyiapkan...";
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.textContent =
        "Memeriksa informasi proses...";

      saveMessage.hidden = false;
    }

    await Promise.resolve();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:organization-process-save",
        {
          detail: payload,
        },
      ),
    );

    document
      .querySelectorAll(
        ".process-card",
      )
      .forEach(
        (section) => {
          section.hidden = true;
        },
      );

    const sidebar =
      document.querySelector(
        ".process-sidebar",
      );

    if (
      sidebar instanceof HTMLElement
    ) {
      sidebar.hidden = true;
    }

    if (
      saveSuccess instanceof HTMLElement
    ) {
      saveSuccess.hidden = false;

      saveSuccess.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.hidden = true;
    }
  }

  function restoreEditor() {
    document
      .querySelectorAll(
        ".process-card",
      )
      .forEach(
        (section) => {
          section.hidden = false;
        },
      );

    const sidebar =
      document.querySelector(
        ".process-sidebar",
      );

    if (
      sidebar instanceof HTMLElement
    ) {
      sidebar.hidden = false;
    }

    if (
      saveSuccess instanceof HTMLElement
    ) {
      saveSuccess.hidden = true;
    }

    if (
      saveButton instanceof HTMLButtonElement
    ) {
      saveButton.disabled = false;
    }

    if (
      saveLabel instanceof HTMLElement
    ) {
      saveLabel.textContent =
        "Simpan proses";
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.textContent = "";
      saveMessage.hidden = true;
    }
  }

  availableProcessButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        () => {
          const processId =
            button.getAttribute(
              "data-add-process",
            );

          addProcess(
            processId,
          );
        },
      );
    },
  );

  descriptionField?.addEventListener(
    "input",
    updateDescriptionCounter,
  );

  saveButton?.addEventListener(
    "click",
    saveProcess,
  );

  editProcessButton?.addEventListener(
    "click",
    restoreEditor,
  );

  updateDescriptionCounter();
  updateSelectedProcessCount();
  updateAvailableButtons();
</script>