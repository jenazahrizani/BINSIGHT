---
/**
 * ============================================================================
 * BINSIGHT — ORGANIZATION WASTE
 * ============================================================================
 * Manage the waste/material scope represented by an organization.
 *
 * Principles:
 * - Matches the BINSIGHT brutalist editorial system.
 * - Uses existing waste taxonomy as the single source of truth.
 * - No fabricated operational statistics.
 * - Browser validation only.
 * - Emits a CustomEvent for future persistence integration.
 * - Safe across Astro client-side navigation.
 * - Accessible keyboard/focus states.
 * ============================================================================
 */

import {
  ArrowLeft,
  ArrowRight,
  CircleCheck,
  ClipboardList,
  Leaf,
  Recycle,
  Save,
  ShieldCheck,
  TriangleAlert,
  Trash2,
} from "@lucide/astro";

import OrganizationLayout from "@layouts/OrganizationLayout.astro";

import {
  WASTE_CATEGORY,
  WASTE_MATERIALS,
  getWasteCategoryLabel,
  getWasteMaterialLabel,
} from "@lib/constants/waste";

const categories = [
  {
    id: WASTE_CATEGORY.ORGANIC,
    label: getWasteCategoryLabel(WASTE_CATEGORY.ORGANIC),
    description:
      "Material yang berasal dari sumber hayati dan dapat mengalami proses penguraian.",
  },
  {
    id: WASTE_CATEGORY.INORGANIC,
    label: getWasteCategoryLabel(WASTE_CATEGORY.INORGANIC),
    description:
      "Material non-organik yang dapat dipilah untuk digunakan kembali atau didaur ulang.",
  },
  {
    id: WASTE_CATEGORY.HAZARDOUS,
    label: getWasteCategoryLabel(WASTE_CATEGORY.HAZARDOUS),
    description:
      "Material yang memerlukan penanganan khusus karena karakteristik bahayanya.",
  },
  {
    id: WASTE_CATEGORY.ELECTRONIC,
    label: getWasteCategoryLabel(WASTE_CATEGORY.ELECTRONIC),
    description:
      "Peralatan dan komponen elektronik yang sudah tidak digunakan.",
  },
  {
    id: WASTE_CATEGORY.RESIDUAL,
    label: getWasteCategoryLabel(WASTE_CATEGORY.RESIDUAL),
    description:
      "Material sisa yang tidak dapat dimanfaatkan melalui pengelolaan yang tersedia.",
  },
];

const materials = WASTE_MATERIALS.map((material) => ({
  id: material.id,
  label: getWasteMaterialLabel(material.id),
  category: material.category,
  description: material.description,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Sampah yang Dikelola — BINSIGHT",
  description:
    "Kelola informasi material dan kategori sampah yang ditangani oleh organisasi melalui portal organisasi BINSIGHT.",
  url: "https://binsight.id/organization/waste",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<OrganizationLayout
  title="Sampah yang Dikelola"
  description="Kelola informasi material dan kategori sampah yang ditangani organisasi."
>
  <main class="organization-waste-page">

    <!-- ================================================================== -->
    <!-- INTRO                                                              -->
    <!-- ================================================================== -->

    <section class="waste-intro" aria-labelledby="waste-page-title">
      <div class="waste-container waste-intro__inner">

        <div class="waste-intro__main">
          <span class="waste-intro__eyebrow">
            ORGANIZATION / WASTE
          </span>

          <h1 id="waste-page-title" class="waste-intro__title">
            Sampah yang dikelola
          </h1>

          <p class="waste-intro__description">
            Tampilkan material persampahan yang benar-benar ditangani
            organisasi agar masyarakat dapat memahami cakupan pengelolaan
            dan peran organisasi secara lebih jelas.
          </p>
        </div>

        <div class="waste-intro__status">
          <div class="waste-intro__status-icon">
            <Recycle
              size={18}
              stroke-width={2}
              aria-hidden="true"
            />
          </div>

          <div>
            <span>DATA SCOPE</span>
            <strong>MATERIAL &amp; PENGELOLAAN</strong>
          </div>
        </div>

      </div>
    </section>

    <!-- ================================================================== -->
    <!-- CONTENT                                                            -->
    <!-- ================================================================== -->

    <section class="waste-content" aria-label="Pengaturan sampah organisasi">
      <div class="waste-container">

        <div class="waste-layout">

          <!-- ============================================================ -->
          <!-- MAIN                                                          -->
          <!-- ============================================================ -->

          <div class="waste-main">

            <form
              class="waste-form"
              id="organization-waste-form"
              data-waste-form
              novalidate
            >

              <!-- ======================================================== -->
              <!-- MATERIAL SELECTION                                        -->
              <!-- ======================================================== -->

              <section class="waste-card" aria-labelledby="materials-title">

                <header class="waste-card__header">
                  <div>
                    <span class="waste-card__eyebrow">
                      01 / MATERIAL YANG DIKELOLA
                    </span>

                    <h2 id="materials-title" class="waste-card__title">
                      Pilih material yang relevan
                    </h2>

                    <p class="waste-card__description">
                      Pilih semua material yang benar-benar diterima,
                      ditangani, atau dikelola oleh organisasi. Jangan
                      memperluas cakupan melebihi aktivitas yang tersedia.
                    </p>
                  </div>

                  <div class="waste-card__icon" aria-hidden="true">
                    <Recycle
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div
                  class="selected-summary"
                  aria-live="polite"
                >
                  <div class="selected-summary__icon" aria-hidden="true">
                    <CircleCheck
                      size={18}
                      stroke-width={2}
                    />
                  </div>

                  <div>
                    <span>MATERIAL DIPILIH</span>

                    <strong data-selected-count>
                      0 material
                    </strong>
                  </div>
                </div>

                <div class="material-controls">

                  <div class="material-search">
                    <label
                      class="sr-only"
                      for="materialSearch"
                    >
                      Cari material
                    </label>

                    <input
                      id="materialSearch"
                      class="material-search__input"
                      type="search"
                      placeholder="Cari material..."
                      autocomplete="off"
                      data-material-search
                    />

                    <span
                      class="material-search__shortcut"
                      aria-hidden="true"
                    >
                      /
                    </span>
                  </div>

                  <div
                    class="category-filter"
                    role="tablist"
                    aria-label="Filter kategori sampah"
                  >
                    <button
                      type="button"
                      role="tab"
                      class="category-filter__button category-filter__button--active"
                      data-category-filter="all"
                      aria-selected="true"
                      tabindex="0"
                    >
                      Semua
                    </button>

                    {
                      categories.map((category) => (
                        <button
                          type="button"
                          role="tab"
                          class="category-filter__button"
                          data-category-filter={category.id}
                          aria-selected="false"
                          tabindex="-1"
                        >
                          {category.label}
                        </button>
                      ))
                    }
                  </div>

                </div>

                <div
                  class="material-grid"
                  data-material-grid
                  aria-label="Daftar material"
                >
                  {
                    materials.map((material) => (
                      <label
                        class="material-option"
                        data-material-option
                        data-material-id={material.id}
                        data-material-category={material.category}
                        data-material-label={material.label.toLowerCase()}
                      >
                        <input
                          type="checkbox"
                          name="materials"
                          value={material.id}
                          data-material-checkbox
                        />

                        <span
                          class="material-option__check"
                          aria-hidden="true"
                        >
                          <CircleCheck
                            size={15}
                            stroke-width={2}
                          />
                        </span>

                        <span class="material-option__body">
                          <strong>{material.label}</strong>

                          <small>{material.description}</small>
                        </span>

                        <span
                          class="material-option__category"
                          aria-hidden="true"
                        >
                          {
                            categories.find(
                              (category) =>
                                category.id === material.category,
                            )?.label ?? "MATERIAL"
                          }
                        </span>
                      </label>
                    ))
                  }
                </div>

                <div
                  class="material-empty"
                  data-material-empty
                  hidden
                >
                  <Trash2
                    size={21}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />

                  <div>
                    <strong>Material tidak ditemukan</strong>

                    <span>
                      Coba gunakan kata pencarian atau kategori yang berbeda.
                    </span>
                  </div>
                </div>

                <p
                  class="field-error material-error"
                  data-material-error
                  hidden
                  role="alert"
                ></p>

              </section>

              <!-- ======================================================== -->
              <!-- MANAGEMENT DESCRIPTION                                    -->
              <!-- ======================================================== -->

              <section
                class="waste-card"
                aria-labelledby="management-title"
              >

                <header class="waste-card__header">
                  <div>
                    <span class="waste-card__eyebrow">
                      02 / INFORMASI PENGELOLAAN
                    </span>

                    <h2 id="management-title" class="waste-card__title">
                      Jelaskan cakupan pengelolaan
                    </h2>

                    <p class="waste-card__description">
                      Tambahkan konteks singkat agar masyarakat tidak hanya
                      mengetahui materialnya, tetapi juga memahami bagaimana
                      organisasi menangani material tersebut.
                    </p>
                  </div>

                  <div class="waste-card__icon" aria-hidden="true">
                    <ClipboardList
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div class="field">

                  <label
                    class="field__label"
                    for="managementDescription"
                  >
                    Deskripsi pengelolaan
                  </label>

                  <p
                    class="field__hint"
                    id="managementDescriptionHint"
                  >
                    Jelaskan secara umum aktivitas pengelolaan material,
                    misalnya pemilahan, pengumpulan, pengolahan, recovery,
                    atau proses lain yang memang dilakukan organisasi.
                  </p>

                  <textarea
                    id="managementDescription"
                    name="managementDescription"
                    class="field__textarea"
                    rows="7"
                    maxlength="1800"
                    aria-describedby="managementDescriptionHint managementDescriptionCounter managementDescriptionError"
                    placeholder="Contoh: Organisasi menerima material terpilah dari masyarakat, melakukan pemeriksaan awal, kemudian memproses material sesuai karakteristiknya..."
                    data-management-description
                  ></textarea>

                  <div class="field__footer">
                    <p
                      id="managementDescriptionError"
                      class="field-error"
                      data-description-error
                      hidden
                      role="alert"
                    ></p>

                    <span
                      id="managementDescriptionCounter"
                      class="field__counter"
                      data-management-description-counter
                    >
                      0 / 1800
                    </span>
                  </div>

                </div>

                <div class="management-notice">
                  <div class="management-notice__icon">
                    <ShieldCheck
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </div>

                  <div>
                    <strong>
                      Gunakan informasi yang benar-benar dilakukan
                    </strong>

                    <span>
                      Hindari menampilkan proses, fasilitas, atau kemampuan
                      pengelolaan yang belum tersedia di organisasi.
                    </span>
                  </div>
                </div>

              </section>

              <!-- ======================================================== -->
              <!-- CATEGORY SUMMARY                                          -->
              <!-- ======================================================== -->

              <section
                class="waste-card"
                aria-labelledby="category-summary-title"
              >

                <header class="waste-card__header">
                  <div>
                    <span class="waste-card__eyebrow">
                      03 / KATEGORI UTAMA
                    </span>

                    <h2
                      id="category-summary-title"
                      class="waste-card__title"
                    >
                      Ringkasan kategori yang ditangani
                    </h2>

                    <p class="waste-card__description">
                      Ringkasan ini terbentuk dari material yang Anda pilih,
                      sehingga informasi kategori tetap konsisten dengan data
                      material.
                    </p>
                  </div>

                  <div class="waste-card__icon" aria-hidden="true">
                    <Leaf
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div
                  class="category-summary-grid"
                  data-category-summary
                >
                  {
                    categories.map((category, index) => (
                      <div
                        class="category-summary"
                        data-summary-category={category.id}
                      >
                        <div class="category-summary__top">
                          <span
                            class="category-summary__number"
                            aria-hidden="true"
                          >
                            {String(index + 1).padStart(2, "0")}
                          </span>

                          <span class="category-summary__label">
                            {category.label}
                          </span>
                        </div>

                        <strong
                          data-summary-count={category.id}
                        >
                          0 material
                        </strong>

                        <p>{category.description}</p>
                      </div>
                    ))
                  }
                </div>

              </section>

              <!-- ======================================================== -->
              <!-- SAVE                                                       -->
              <!-- ======================================================== -->

              <section class="waste-card waste-card--save">

                <div class="save-box">
                  <div class="save-box__icon" aria-hidden="true">
                    <Save
                      size={20}
                      stroke-width={2}
                    />
                  </div>

                  <div class="save-box__content">
                    <span class="save-box__eyebrow">
                      READY FOR REVIEW
                    </span>

                    <h2>
                      Simpan informasi sampah
                    </h2>

                    <p>
                      Data material dan deskripsi akan dipersiapkan untuk
                      proses penyimpanan dan peninjauan organisasi.
                    </p>
                  </div>
                </div>

                <div class="form-actions">

                  <a
                    class="form-actions__back"
                    href="/organization"
                  >
                    <ArrowLeft
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>Kembali</span>
                  </a>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-save-waste
                  >
                    <Save
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-save-label>
                      Simpan informasi
                    </span>
                  </button>

                </div>

                <p
                  class="save-message"
                  data-save-message
                  aria-live="polite"
                  hidden
                ></p>

              </section>

            </form>

            <!-- ========================================================== -->
            <!-- SUCCESS STATE                                               -->
            <!-- ========================================================== -->

            <section
              class="save-success"
              data-save-success
              hidden
              aria-labelledby="save-success-title"
            >
              <div
                class="save-success__index"
                aria-hidden="true"
              >
                04
              </div>

              <div class="save-success__icon">
                <CircleCheck
                  size={32}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                INFORMASI DIPERSIAPKAN
              </span>

              <h2 id="save-success-title">
                Data sampah berhasil dipersiapkan
              </h2>

              <p>
                Informasi material dan cakupan pengelolaan telah melewati
                pemeriksaan dasar pada browser dan siap diteruskan ke proses
                penyimpanan atau verifikasi.
              </p>

              <div class="save-success__actions">

                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  <span>Kembali ke portal</span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-waste
                >
                  Edit kembali
                </button>

              </div>
            </section>

          </div>

          <!-- ============================================================ -->
          <!-- SIDEBAR                                                       -->
          <!-- ============================================================ -->

          <aside
            class="waste-sidebar"
            aria-label="Ringkasan dan panduan"
            data-waste-sidebar
          >

            <section class="sidebar-card sidebar-card--highlight">

              <div class="sidebar-card__icon" aria-hidden="true">
                <Recycle
                  size={20}
                  stroke-width={2}
                />
              </div>

              <span class="sidebar-card__eyebrow">
                RINGKASAN
              </span>

              <h2>
                Cakupan sampah organisasi
              </h2>

              <div class="summary-number">
                <strong data-sidebar-count>0</strong>

                <span>material dipilih</span>
              </div>

              <div class="summary-rule" aria-hidden="true"></div>

              <p>
                Pilih material yang benar-benar diterima, ditangani, atau
                dikelola oleh organisasi.
              </p>

            </section>

            <section class="sidebar-card">

              <span class="sidebar-card__eyebrow">
                PRINSIP DATA
              </span>

              <h2>
                Jadilah spesifik
              </h2>

              <div class="sidebar-check-list">

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Pilih material yang benar-benar ditangani
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Jelaskan cakupan pengelolaan secara wajar
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Hindari klaim yang belum diverifikasi
                  </span>
                </div>

              </div>

            </section>

            <section class="sidebar-card sidebar-card--warning">

              <div class="sidebar-warning__icon" aria-hidden="true">
                <TriangleAlert
                  size={18}
                  stroke-width={2}
                />
              </div>

              <div>
                <span class="sidebar-card__eyebrow">
                  PERHATIAN
                </span>

                <strong>
                  Jangan memperluas klaim
                </strong>

                <p>
                  Material yang dipilih sebaiknya mencerminkan aktivitas
                  pengelolaan organisasi saat ini.
                </p>
              </div>

            </section>

            <section class="sidebar-card sidebar-card--next">

              <span class="sidebar-card__eyebrow">
                LANJUTKAN
              </span>

              <h2>
                Lengkapi informasi organisasi
              </h2>

              <a href="/organization/process">
                <span>Kelola proses</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/products">
                <span>Kelola produk</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/profile">
                <span>Kembali ke profil</span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

            </section>

          </aside>

        </div>

      </div>
    </section>

  </main>
</OrganizationLayout>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  /* ==========================================================================
     REMOVE ORGANIZATION WORKSPACE CHROME
     ========================================================================== */

  :global(.organization-layout__header) {
    display: none !important;
  }

  :global(.organization-layout__sidebar) {
    display: none !important;
  }

  :global(.organization-layout__mobile-topbar) {
    display: none !important;
  }

  :global(.organization-layout__main) {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    grid-column: 1 / -1 !important;
  }

  :global(.organization-layout__main-container) {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  :global(.organization-layout:has(.organization-waste-page)) {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  :global(.organization-layout:has(.organization-waste-page))
    .organization-layout__main {
    grid-column: 1 / -1 !important;
    width: 100% !important;
  }

  /* ==========================================================================
     PAGE
     ========================================================================== */

  .organization-waste-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --muted-dark: #50554d;
    --orange: #ff6a00;
    --line: #b7b8ad;
    --danger: #b43d00;

    width: 100%;
    min-height: 100vh;
    color: var(--ink);
    background: var(--paper);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .organization-waste-page *,
  .organization-waste-page *::before,
  .organization-waste-page *::after {
    box-sizing: border-box;
  }

  .organization-waste-page a,
  .organization-waste-page button,
  .organization-waste-page input,
  .organization-waste-page textarea {
    -webkit-tap-highlight-color: transparent;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .waste-container {
    width: min(1240px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* ==========================================================================
     INTRO
     ========================================================================== */

  .waste-intro {
    position: relative;
    border-bottom: 3px solid var(--ink);
    background:
      radial-gradient(
        circle at 90% 0%,
        rgb(223 255 0 / 10%),
        transparent 23%
      ),
      repeating-linear-gradient(
        135deg,
        rgb(9 10 8 / 2.5%) 0 1px,
        transparent 1px 9px
      ),
      var(--paper);
  }

  .waste-intro__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 38px;
    padding: 34px 0 38px;
  }

  .waste-intro__main {
    min-width: 0;
  }

  .waste-intro__eyebrow,
  .waste-card__eyebrow,
  .sidebar-card__eyebrow,
  .save-box__eyebrow,
  .save-success__eyebrow {
    display: block;
    color: var(--orange);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.57rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .waste-intro__title {
    max-width: 900px;
    margin: 12px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(2.45rem, 5vw, 5.25rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .waste-intro__description {
    max-width: 720px;
    margin: 18px 0 0;
    color: #4e534b;
    font-size: 0.88rem;
    line-height: 1.72;
  }

  .waste-intro__status {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 255px;
    flex: 0 0 auto;
    padding: 13px 15px;
    border: 3px solid var(--ink);
    background: var(--white);
    box-shadow: 7px 7px 0 var(--acid);
  }

  .waste-intro__status-icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--ink);
    background: var(--acid);
  }

  .waste-intro__status span,
  .waste-intro__status strong {
    display: block;
  }

  .waste-intro__status span {
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.48rem;
    font-weight: 900;
    letter-spacing: 0.09em;
  }

  .waste-intro__status strong {
    margin-top: 4px;
    color: var(--ink);
    font-size: 0.67rem;
    font-weight: 900;
  }

  /* ==========================================================================
     CONTENT / LAYOUT
     ========================================================================== */

  .waste-content {
    padding: 30px 0 82px;
    background:
      repeating-linear-gradient(
        0deg,
        rgb(9 10 8 / 2.6%) 0 1px,
        transparent 1px 8px
      ),
      var(--paper-2);
  }

  .waste-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      315px;
    gap: 22px;
    align-items: start;
  }

  .waste-main {
    min-width: 0;
  }

  .waste-form {
    display: grid;
    gap: 16px;
  }

  /* ==========================================================================
     CARDS
     ========================================================================== */

  .waste-card,
  .sidebar-card,
  .save-success {
    position: relative;
    border: 3px solid var(--ink);
    border-radius: 0;
    background: var(--white);
    box-shadow: 7px 7px 0 rgb(9 10 8 / 10%);
  }

  .waste-card {
    overflow: hidden;
  }

  .waste-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 24px;
    border-bottom: 3px solid var(--ink);
  }

  .waste-card__title {
    margin: 8px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .waste-card__description {
    max-width: 720px;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.68;
  }

  .waste-card__icon {
    display: grid;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--ink);
    background: var(--acid);
    border: 2px solid var(--ink);
  }

  /* ==========================================================================
     SELECTED SUMMARY
     ========================================================================== */

  .selected-summary {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 20px 24px 0;
    padding: 12px 14px;
    border: 2px solid var(--ink);
    background: var(--acid-soft);
  }

  .selected-summary__icon {
    display: grid;
    width: 36px;
    height: 36px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
  }

  .selected-summary span,
  .selected-summary strong {
    display: block;
  }

  .selected-summary span {
    color: var(--muted-dark);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.51rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .selected-summary strong {
    margin-top: 3px;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 900;
  }

  /* ==========================================================================
     MATERIAL CONTROLS
     ========================================================================== */

  .material-controls {
    padding: 20px 24px 0;
  }

  .material-search {
    position: relative;
  }

  .material-search__input {
    width: 100%;
    min-height: 45px;
    padding: 0 42px 0 13px;
    border: 2px solid var(--line);
    border-radius: 0;
    outline: none;
    color: var(--ink);
    background: var(--white);
    font: inherit;
    font-size: 0.75rem;
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease,
      background 140ms ease;
  }

  .material-search__input::placeholder {
    color: #969990;
  }

  .material-search__input:hover {
    border-color: var(--muted-dark);
  }

  .material-search__input:focus {
    border-color: var(--ink);
    box-shadow: 4px 4px 0 var(--acid);
    background: #fff;
  }

  .material-search__shortcut {
    position: absolute;
    top: 50%;
    right: 10px;
    display: grid;
    width: 23px;
    height: 23px;
    place-items: center;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--paper);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.63rem;
    font-weight: 900;
    transform: translateY(-50%);
  }

  .category-filter {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin-top: 13px;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }

  .category-filter__button {
    flex: 0 0 auto;
    min-height: 35px;
    padding: 0 11px;
    color: var(--muted-dark);
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--white);
    cursor: pointer;
    font: inherit;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition:
      transform 120ms ease,
      background 120ms linear,
      color 120ms linear,
      box-shadow 120ms ease;
  }

  .category-filter__button:hover {
    color: var(--ink);
    background: var(--acid-soft);
    transform: translate(-1px, -1px);
  }

  .category-filter__button--active {
    color: var(--acid);
    background: var(--ink);
    box-shadow: 4px 4px 0 var(--acid);
  }

  /* ==========================================================================
     MATERIAL GRID
     ========================================================================== */

  .material-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 20px 24px 24px;
  }

  .material-option {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 11px;
    min-width: 0;
    padding: 15px;
    color: var(--ink);
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--white);
    cursor: pointer;
    transition:
      border-color 120ms ease,
      background 120ms ease,
      box-shadow 120ms ease,
      transform 120ms ease;
  }

  .material-option:hover {
    border-color: var(--ink);
    box-shadow: 5px 5px 0 rgb(9 10 8 / 12%);
    transform: translate(-1px, -1px);
  }

  .material-option:has(input:checked) {
    border-color: var(--ink);
    background: var(--acid-soft);
    box-shadow: 5px 5px 0 var(--acid);
  }

  .material-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .material-option__check {
    display: grid;
    width: 27px;
    height: 27px;
    flex: 0 0 auto;
    place-items: center;
    margin-top: 1px;
    color: transparent;
    border: 2px solid var(--ink);
    background: var(--white);
  }

  .material-option input:checked + .material-option__check {
    color: var(--ink);
    background: var(--acid);
  }

  .material-option input:focus-visible + .material-option__check {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  .material-option__body {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
  }

  .material-option__body strong {
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 900;
  }

  .material-option__body small {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.63rem;
    line-height: 1.55;
  }

  .material-option__category {
    align-self: flex-start;
    flex: 0 0 auto;
    padding: 4px 5px;
    color: var(--ink);
    border: 1px solid var(--ink);
    background: var(--paper);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.45rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .material-empty {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-height: 130px;
    margin: 20px 24px 24px;
    padding: 20px;
    color: var(--muted);
    border: 2px dashed var(--ink);
    background: var(--paper);
  }

  .material-empty[hidden] {
    display: none;
  }

  .material-empty > svg {
    flex: 0 0 auto;
    color: var(--orange);
  }

  .material-empty strong,
  .material-empty span {
    display: block;
  }

  .material-empty strong {
    color: var(--ink);
    font-size: 0.73rem;
    font-weight: 900;
  }

  .material-empty span {
    margin-top: 4px;
    font-size: 0.62rem;
    line-height: 1.55;
  }

  /* ==========================================================================
     FIELD
     ========================================================================== */

  .field {
    padding: 22px 24px 0;
  }

  .field__label {
    display: inline-flex;
    margin-bottom: 7px;
    color: var(--ink);
    font-size: 0.73rem;
    font-weight: 900;
  }

  .field__hint {
    max-width: 710px;
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 0.63rem;
    line-height: 1.58;
  }

  .field__textarea {
    width: 100%;
    min-height: 155px;
    padding: 12px;
    resize: vertical;
    color: var(--ink);
    border: 2px solid var(--line);
    border-radius: 0;
    outline: none;
    background: var(--white);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1.65;
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease;
  }

  .field__textarea:hover {
    border-color: var(--muted-dark);
  }

  .field__textarea:focus {
    border-color: var(--ink);
    box-shadow: 4px 4px 0 var(--acid);
  }

  .field__textarea[aria-invalid="true"] {
    border-color: var(--orange);
    box-shadow: 4px 4px 0 rgb(255 106 0 / 13%);
  }

  .field__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .field__counter {
    flex: 0 0 auto;
    margin-top: 7px;
    color: #8b8e86;
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.54rem;
  }

  .field-error {
    margin: 7px 0 0;
    color: var(--danger);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.55rem;
    line-height: 1.5;
  }

  .field-error[hidden] {
    display: none;
  }

  .material-error {
    margin:
      0 24px 24px;
  }

  .field__footer .field-error {
    margin-left: 0;
    margin-right: 0;
  }

  /* ==========================================================================
     MANAGEMENT NOTICE
     ========================================================================== */

  .management-notice {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin: 18px 24px 24px;
    padding: 13px;
    border: 2px solid var(--ink);
    background: var(--acid-soft);
  }

  .management-notice__icon {
    display: grid;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
  }

  .management-notice strong,
  .management-notice span {
    display: block;
  }

  .management-notice strong {
    color: var(--ink);
    font-size: 0.65rem;
    font-weight: 900;
  }

  .management-notice span {
    margin-top: 4px;
    color: var(--muted-dark);
    font-size: 0.58rem;
    line-height: 1.55;
  }

  /* ==========================================================================
     CATEGORY SUMMARY
     ========================================================================== */

  .category-summary-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 20px 24px 24px;
  }

  .category-summary {
    padding: 14px;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  .category-summary__top {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .category-summary__number {
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.52rem;
    font-weight: 900;
  }

  .category-summary__label {
    color: var(--muted-dark);
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .category-summary strong {
    display: block;
    margin-top: 10px;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .category-summary p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.59rem;
    line-height: 1.55;
  }

  /* ==========================================================================
     SAVE
     ========================================================================== */

  .waste-card--save {
    padding: 20px 24px 24px;
  }

  .save-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px;
    border: 2px solid var(--ink);
    background: var(--acid-soft);
  }

  .save-box__icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
  }

  .save-box__content h2 {
    margin: 5px 0 0;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .save-box__content p {
    max-width: 670px;
    margin: 4px 0 0;
    color: var(--muted-dark);
    font-size: 0.61rem;
    line-height: 1.6;
  }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    padding-top: 17px;
    border-top: 3px solid var(--ink);
  }

  .form-actions__back,
  .form-actions__submit {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 14px;
    border: 2px solid var(--ink);
    border-radius: 0;
    font: inherit;
    font-size: 0.61rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .form-actions__back {
    color: var(--ink);
    background: transparent;
  }

  .form-actions__back:hover {
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .form-actions__submit {
    color: var(--acid);
    background: var(--ink);
    box-shadow: 6px 6px 0 var(--acid);
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end),
      background 120ms linear;
  }

  .form-actions__submit:hover {
    background: var(--ink-3);
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--orange);
  }

  .form-actions__submit:disabled {
    opacity: 0.55;
    cursor: wait;
    transform: none;
  }

  .form-actions__submit:focus-visible,
  .form-actions__back:focus-visible,
  .category-filter__button:focus-visible,
  .material-search__input:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  .save-message {
    margin: 11px 0 0;
    color: var(--muted);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.54rem;
    line-height: 1.5;
    text-align: right;
  }

  .save-message[hidden] {
    display: none;
  }

  /* ==========================================================================
     SIDEBAR
     ========================================================================== */

  .waste-sidebar {
    position: sticky;
    top: 24px;
    display: grid;
    gap: 13px;
  }

  .sidebar-card {
    padding: 18px;
    box-shadow: 6px 6px 0 rgb(9 10 8 / 9%);
  }

  .sidebar-card--highlight {
    background:
      linear-gradient(
        145deg,
        var(--acid),
        var(--white)
      );
  }

  .sidebar-card__icon {
    display: grid;
    width: 39px;
    height: 39px;
    place-items: center;
    margin-bottom: 13px;
    border: 2px solid var(--ink);
    color: var(--acid);
    background: var(--ink);
  }

  .sidebar-card h2 {
    margin: 6px 0 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .sidebar-card > p {
    margin: 12px 0 0;
    color: var(--muted-dark);
    font-size: 0.62rem;
    line-height: 1.6;
  }

  .summary-number {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-top: 22px;
  }

  .summary-number strong {
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: 2.35rem;
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.9;
  }

  .summary-number span {
    color: var(--muted-dark);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.51rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .summary-rule {
    width: 100%;
    height: 5px;
    margin-top: 15px;
    background: var(--ink);
  }

  .sidebar-check-list {
    display: grid;
    gap: 11px;
    margin-top: 18px;
  }

  .sidebar-check {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: var(--muted-dark);
    font-size: 0.61rem;
    line-height: 1.55;
  }

  .sidebar-check svg {
    flex: 0 0 auto;
    margin-top: 1px;
    color: var(--orange);
  }

  .sidebar-card--warning {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--paper);
  }

  .sidebar-warning__icon {
    display: grid;
    width: 37px;
    height: 37px;
    flex: 0 0 auto;
    place-items: center;
    color: var(--ink);
    background: var(--orange);
    border: 2px solid var(--ink);
  }

  .sidebar-card--warning strong {
    display: block;
    margin-top: 5px;
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 900;
  }

  .sidebar-card--warning p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.58rem;
    line-height: 1.55;
  }

  .sidebar-card--next {
    color: var(--white);
    background: var(--ink);
  }

  .sidebar-card--next h2 {
    color: var(--white);
  }

  .sidebar-card--next .sidebar-card__eyebrow {
    color: var(--acid);
  }

  .sidebar-card--next a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
    padding-top: 10px;
    color: var(--acid);
    border-top: 2px solid rgb(255 255 255 / 18%);
    font-size: 0.6rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .sidebar-card--next a:hover {
    color: var(--white);
  }

  /* ==========================================================================
     SUCCESS
     ========================================================================== */

  .save-success {
    overflow: hidden;
    padding: 46px 28px;
    text-align: center;
    background:
      linear-gradient(
        145deg,
        var(--acid),
        var(--paper)
      );
    box-shadow: 8px 8px 0 var(--ink);
  }

  .save-success[hidden] {
    display: none;
  }

  .save-success__index {
    position: absolute;
    top: 16px;
    right: 18px;
    color: var(--orange);
    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;
    font-size: 0.62rem;
    font-weight: 900;
  }

  .save-success__icon {
    display: inline-grid;
    width: 68px;
    height: 68px;
    place-items: center;
    color: var(--acid);
    background: var(--ink);
    border: 2px solid var(--ink);
  }

  .save-success__eyebrow {
    margin-top: 17px;
  }

  .save-success h2 {
    max-width: 720px;
    margin: 8px auto 0;
    color: var(--ink);
    font-family:
      Sora,
      Inter,
      sans-serif;
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .save-success p {
    max-width: 660px;
    margin: 13px auto 0;
    color: #4d533c;
    font-size: 0.68rem;
    line-height: 1.68;
  }

  .save-success__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */

  @media (max-width: 1050px) {
    .waste-layout {
      grid-template-columns: 1fr;
    }

    .waste-sidebar {
      position: static;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .sidebar-card--highlight,
    .sidebar-card--next {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .waste-intro__inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 22px;
      padding: 26px 0 30px;
    }

    .waste-intro__status {
      width: 100%;
    }

    .material-grid,
    .category-summary-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .waste-container {
      width: calc(100% - 24px);
    }

    .waste-content {
      padding: 20px 0 58px;
    }

    .waste-intro__title {
      font-size: clamp(2.05rem, 11vw, 3.4rem);
    }

    .waste-intro__description {
      font-size: 0.75rem;
    }

    .waste-card__header {
      padding: 18px;
    }

    .waste-card__title {
      font-size: 1.08rem;
    }

    .waste-card__description {
      font-size: 0.63rem;
    }

    .selected-summary {
      margin-inline: 18px;
    }

    .material-controls {
      padding-inline: 18px;
    }

    .material-grid,
    .material-empty {
      margin-inline: 18px;
    }

    .field {
      padding-inline: 18px;
    }

    .management-notice {
      margin-inline: 18px;
    }

    .category-summary-grid {
      margin-inline: 18px;
    }

    .material-error {
      margin-left: 18px;
      margin-right: 18px;
    }

    .waste-card--save {
      padding-inline: 18px;
    }

    .material-option__category {
      display: none;
    }

    .form-actions {
      align-items: stretch;
      flex-direction: column-reverse;
    }

    .form-actions__submit,
    .form-actions__back {
      width: 100%;
    }

    .save-message {
      text-align: center;
    }

    .waste-sidebar {
      grid-template-columns: 1fr;
    }

    .sidebar-card--highlight,
    .sidebar-card--next {
      grid-column: auto;
    }

    .save-success {
      padding: 38px 18px;
    }

    .save-success__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (max-width: 430px) {
    .waste-container {
      width: calc(100% - 16px);
    }

    .material-option {
      padding: 13px;
    }

    .material-option__body small {
      font-size: 0.58rem;
    }

    .category-filter__button {
      min-height: 33px;
      padding-inline: 9px;
      font-size: 0.56rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .organization-waste-page * {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }

    .organization-waste-page
      .form-actions__submit:hover,
    .organization-waste-page
      .material-option:hover,
    .organization-waste-page
      .category-filter__button:hover {
      transform: none;
    }
  }
</style>

<script>
  const initializeOrganizationWastePage = () => {
    const form =
      document.querySelector<HTMLFormElement>(
        "[data-waste-form]",
      );

    if (
      !form ||
      form.dataset.initialized === "true"
    ) {
      return;
    }

    form.dataset.initialized = "true";

    const materialSearch =
      document.querySelector<HTMLInputElement>(
        "[data-material-search]",
      );

    const materialOptions = Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-material-option]",
      ),
    );

    const materialCheckboxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        "[data-material-checkbox]",
      ),
    );

    const categoryButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-category-filter]",
      ),
    );

    const materialEmpty =
      document.querySelector<HTMLElement>(
        "[data-material-empty]",
      );

    const selectedCount =
      document.querySelector<HTMLElement>(
        "[data-selected-count]",
      );

    const sidebarCount =
      document.querySelector<HTMLElement>(
        "[data-sidebar-count]",
      );

    const materialError =
      document.querySelector<HTMLElement>(
        "[data-material-error]",
      );

    const descriptionField =
      document.querySelector<HTMLTextAreaElement>(
        "[data-management-description]",
      );

    const descriptionCounter =
      document.querySelector<HTMLElement>(
        "[data-management-description-counter]",
      );

    const descriptionError =
      document.querySelector<HTMLElement>(
        "[data-description-error]",
      );

    const saveButton =
      document.querySelector<HTMLButtonElement>(
        "[data-save-waste]",
      );

    const saveLabel =
      document.querySelector<HTMLElement>(
        "[data-save-label]",
      );

    const saveMessage =
      document.querySelector<HTMLElement>(
        "[data-save-message]",
      );

    const saveSuccess =
      document.querySelector<HTMLElement>(
        "[data-save-success]",
      );

    const sidebar =
      document.querySelector<HTMLElement>(
        "[data-waste-sidebar]",
      );

    const editWasteButton =
      document.querySelector<HTMLButtonElement>(
        "[data-edit-waste]",
      );

    let activeCategory = "all";

    const getSelectedMaterials = () => {
      return materialCheckboxes
        .filter(
          (checkbox) => checkbox.checked,
        )
        .map(
          (checkbox) => checkbox.value,
        )
        .filter(Boolean);
    };

    const clearMaterialError = () => {
      if (materialError) {
        materialError.textContent = "";
        materialError.hidden = true;
      }

      materialCheckboxes.forEach(
        (checkbox) => {
          checkbox.removeAttribute(
            "aria-invalid",
          );
        },
      );
    };

    const updateSelectedCount = () => {
      const selected =
        getSelectedMaterials();

      const count =
        selected.length;

      if (selectedCount) {
        selectedCount.textContent =
          `${count} material${count === 1 ? "" : "s"}`;
      }

      if (sidebarCount) {
        sidebarCount.textContent =
          String(count);
      }

      updateCategorySummary();
    };

    const updateCategorySummary = () => {
      const summaryElements =
        Array.from(
          document.querySelectorAll<HTMLElement>(
            "[data-summary-category]",
          ),
        );

      summaryElements.forEach(
        (summaryElement) => {
          const category =
            summaryElement.getAttribute(
              "data-summary-category",
            );

          if (!category) {
            return;
          }

          const count =
            materialOptions.filter(
              (option) => {
                const optionCategory =
                  option.getAttribute(
                    "data-material-category",
                  );

                const checkbox =
                  option.querySelector<HTMLInputElement>(
                    "[data-material-checkbox]",
                  );

                return (
                  optionCategory ===
                    category &&
                  checkbox?.checked === true
                );
              },
            ).length;

          const countElement =
            summaryElement.querySelector<HTMLElement>(
              `[data-summary-count="${category}"]`,
            );

          if (countElement) {
            countElement.textContent =
              `${count} material${count === 1 ? "" : "s"}`;
          }
        },
      );
    };

    const updateMaterialVisibility = () => {
      const searchValue =
        materialSearch?.value
          .trim()
          .toLowerCase() ??
        "";

      let visibleCount = 0;

      materialOptions.forEach(
        (option) => {
          const category =
            option.getAttribute(
              "data-material-category",
            ) ?? "";

          const label =
            option.getAttribute(
              "data-material-label",
            ) ?? "";

          const matchesCategory =
            activeCategory === "all" ||
            category === activeCategory;

          const matchesSearch =
            searchValue === "" ||
            label.includes(searchValue);

          const visible =
            matchesCategory &&
            matchesSearch;

          option.hidden =
            !visible;

          if (visible) {
            visibleCount += 1;
          }
        },
      );

      if (materialEmpty) {
        materialEmpty.hidden =
          visibleCount !== 0;
      }
    };

    const updateCategoryButtons = () => {
      categoryButtons.forEach(
        (button) => {
          const category =
            button.getAttribute(
              "data-category-filter",
            );

          const active =
            category === activeCategory;

          button.classList.toggle(
            "category-filter__button--active",
            active,
          );

          button.setAttribute(
            "aria-selected",
            active
              ? "true"
              : "false",
          );

          button.tabIndex =
            active ? 0 : -1;
        },
      );
    };

    const updateDescriptionCounter =
      () => {
        if (
          !descriptionField ||
          !descriptionCounter
        ) {
          return;
        }

        descriptionCounter.textContent =
          `${descriptionField.value.length} / 1800`;
      };

    const showSaveMessage = (
      message: string,
    ) => {
      if (!saveMessage) {
        return;
      }

      saveMessage.textContent =
        message;

      saveMessage.hidden =
        false;
    };

    const clearSaveMessage = () => {
      if (!saveMessage) {
        return;
      }

      saveMessage.textContent =
        "";

      saveMessage.hidden =
        true;
    };

    const validateWasteData = () => {
      let valid = true;

      clearMaterialError();

      if (descriptionError) {
        descriptionError.textContent =
          "";

        descriptionError.hidden =
          true;
      }

      descriptionField?.removeAttribute(
        "aria-invalid",
      );

      const selected =
        getSelectedMaterials();

      if (selected.length === 0) {
        valid = false;

        if (materialError) {
          materialError.textContent =
            "Pilih minimal satu material yang benar-benar dikelola organisasi.";

          materialError.hidden =
            false;
        }

        materialCheckboxes.forEach(
          (checkbox) => {
            checkbox.setAttribute(
              "aria-invalid",
              "true",
            );
          },
        );
      }

      if (descriptionField) {
        const description =
          descriptionField.value.trim();

        if (
          description.length > 0 &&
          description.length < 20
        ) {
          valid = false;

          descriptionField.setAttribute(
            "aria-invalid",
            "true",
          );

          if (descriptionError) {
            descriptionError.textContent =
              "Deskripsi pengelolaan yang diisi minimal 20 karakter.";

            descriptionError.hidden =
              false;
          }
        }
      }

      if (!valid) {
        const firstInvalid =
          form.querySelector<HTMLElement>(
            "[aria-invalid='true']",
          );

        firstInvalid?.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        firstInvalid?.focus();
      }

      return valid;
    };

    const buildWastePayload =
      () => {
        return {
          materials:
            getSelectedMaterials(),

          managementDescription:
            descriptionField?.value.trim() ??
            "",

          updatedAt:
            new Date().toISOString(),
        };
      };

    const setEditorState = (
      hidden: boolean,
    ) => {
      const sections =
        Array.from(
          form.querySelectorAll<HTMLElement>(
            ".waste-card",
          ),
        );

      sections.forEach(
        (section) => {
          section.hidden =
            hidden;
        },
      );

      if (sidebar) {
        sidebar.hidden =
          hidden;
      }

      if (saveSuccess) {
        saveSuccess.hidden =
          !hidden;
      }
    };

    const restoreEditor = () => {
      setEditorState(false);

      if (saveButton) {
        saveButton.disabled =
          false;
      }

      if (saveLabel) {
        saveLabel.textContent =
          "Simpan informasi";
      }

      clearSaveMessage();

      form.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    };

    const handleSubmit = async (
      event: SubmitEvent,
    ) => {
      event.preventDefault();

      clearSaveMessage();

      if (!validateWasteData()) {
        return;
      }

      const payload =
        buildWastePayload();

      if (saveButton) {
        saveButton.disabled =
          true;
      }

      if (saveLabel) {
        saveLabel.textContent =
          "Menyiapkan...";
      }

      showSaveMessage(
        "Memeriksa informasi...",
      );

      await Promise.resolve();

      window.dispatchEvent(
        new CustomEvent(
          "binsight:organization-waste-save",
          {
            detail: payload,
          },
        ),
      );

      setEditorState(true);

      clearSaveMessage();

      saveSuccess?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    };

    const handleShortcut = (
      event: KeyboardEvent,
    ) => {
      if (
        event.key !== "/" ||
        document.activeElement ===
          materialSearch
      ) {
        return;
      }

      const target =
        event.target;

      if (
        target instanceof
          HTMLInputElement ||
        target instanceof
          HTMLTextAreaElement ||
        target instanceof
          HTMLSelectElement
      ) {
        return;
      }

      event.preventDefault();

      materialSearch?.focus();
    };

    const handleCategoryKeydown = (
      event: KeyboardEvent,
    ) => {
      const current =
        event.currentTarget;

      if (
        !(current instanceof
          HTMLButtonElement)
      ) {
        return;
      }

      const currentIndex =
        categoryButtons.indexOf(
          current,
        );

      if (currentIndex < 0) {
        return;
      }

      let nextIndex =
        currentIndex;

      if (
        event.key ===
        "ArrowRight"
      ) {
        nextIndex =
          (currentIndex + 1) %
          categoryButtons.length;
      } else if (
        event.key ===
        "ArrowLeft"
      ) {
        nextIndex =
          (currentIndex - 1 +
            categoryButtons.length) %
          categoryButtons.length;
      } else if (
        event.key === "Home"
      ) {
        nextIndex = 0;
      } else if (
        event.key === "End"
      ) {
        nextIndex =
          categoryButtons.length -
          1;
      } else {
        return;
      }

      event.preventDefault();

      const next =
        categoryButtons[
          nextIndex
        ];

      next?.focus();
      next?.click();
    };

    materialSearch?.addEventListener(
      "input",
      updateMaterialVisibility,
    );

    categoryButtons.forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            activeCategory =
              button.getAttribute(
                "data-category-filter",
              ) ?? "all";

            updateCategoryButtons();
            updateMaterialVisibility();
          },
        );

        button.addEventListener(
          "keydown",
          handleCategoryKeydown,
        );
      },
    );

    materialCheckboxes.forEach(
      (checkbox) => {
        checkbox.addEventListener(
          "change",
          () => {
            clearMaterialError();
            updateSelectedCount();
          },
        );
      },
    );

    descriptionField?.addEventListener(
      "input",
      () => {
        descriptionField.removeAttribute(
          "aria-invalid",
        );

        if (descriptionError) {
          descriptionError.textContent =
            "";

          descriptionError.hidden =
            true;
        }

        updateDescriptionCounter();
      },
    );

    form.addEventListener(
      "submit",
      handleSubmit,
    );

    editWasteButton?.addEventListener(
      "click",
      restoreEditor,
    );

    document.addEventListener(
      "keydown",
      handleShortcut,
    );

    updateSelectedCount();
    updateCategoryButtons();
    updateMaterialVisibility();
    updateDescriptionCounter();
  };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeOrganizationWastePage,
      { once: true },
    );
  } else {
    initializeOrganizationWastePage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeOrganizationWastePage,
  );
</script>
