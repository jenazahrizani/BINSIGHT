---
import {
  ArrowLeft,
  ArrowRight,
  CircleCheck,
  ClipboardList,
  Leaf,
  Plus,
  Recycle,
  Save,
  ShieldCheck,
  Trash2,
  TriangleAlert,
} from "@lucide/astro";

import OrganizationLayout from "../../layouts/OrganizationLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import {
  WASTE_CATEGORY,
  WASTE_MATERIALS,
  getWasteCategoryLabel,
  getWasteMaterialLabel,
} from "../../lib/constants/waste";

const categories = [
  {
    id: WASTE_CATEGORY.ORGANIC,
    label: getWasteCategoryLabel(WASTE_CATEGORY.ORGANIC),
    description:
      "Material yang berasal dari sumber hayati dan dapat mengalami proses penguraian.",
  },
  {
    id: WASTE_CATEGORY.INORGANIC,
    label: getWasteCategoryLabel(WASTE_CATEGORY.INORGANIC),
    description:
      "Material non-organik yang dapat dipilah untuk digunakan kembali atau didaur ulang.",
  },
  {
    id: WASTE_CATEGORY.HAZARDOUS,
    label: getWasteCategoryLabel(WASTE_CATEGORY.HAZARDOUS),
    description:
      "Material yang memerlukan penanganan khusus karena karakteristik bahayanya.",
  },
  {
    id: WASTE_CATEGORY.ELECTRONIC,
    label: getWasteCategoryLabel(WASTE_CATEGORY.ELECTRONIC),
    description:
      "Peralatan dan komponen elektronik yang sudah tidak digunakan.",
  },
  {
    id: WASTE_CATEGORY.RESIDUAL,
    label: getWasteCategoryLabel(WASTE_CATEGORY.RESIDUAL),
    description:
      "Material sisa yang tidak dapat dimanfaatkan melalui pengelolaan yang tersedia.",
  },
];

const materials = WASTE_MATERIALS.map((material) => ({
  id: material.id,
  label: getWasteMaterialLabel(material.id),
  category: material.category,
  description: material.description,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Sampah yang Dikelola — BINSIGHT",
  description:
    "Kelola informasi material dan kategori sampah yang ditangani oleh organisasi melalui portal organisasi BINSIGHT.",
  url: "https://binsight.id/organization/waste",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<OrganizationLayout
  title="Sampah yang Dikelola"
  description="Kelola informasi material dan kategori sampah yang ditangani organisasi."
>
  <main class="organization-waste-page">
    <PageHeader
      eyebrow="PORTAL ORGANISASI"
      title="Sampah yang dikelola"
      description="Tampilkan material persampahan yang ditangani organisasi Anda agar masyarakat dapat memahami cakupan pengelolaan dan peran organisasi secara lebih jelas."
      icon="organization"
      tone="green"
      breadcrumbs={[
        {
          label: "Beranda",
          href: "/",
        },
        {
          label: "Portal Organisasi",
          href: "/organization",
        },
        {
          label: "Sampah yang Dikelola",
          href: "/organization/waste",
        },
      ]}
    />

    <section class="waste-content">
      <div class="waste-container">
        <div class="waste-layout">
          <div class="waste-main">
            <section class="waste-card">
              <div class="waste-card__header">
                <div>
                  <span class="waste-card__eyebrow">
                    MATERIAL YANG DIKELOLA
                  </span>

                  <h2 class="waste-card__title">
                    Pilih material yang relevan
                  </h2>

                  <p class="waste-card__description">
                    Pilih semua material yang benar-benar ditangani oleh
                    organisasi. Informasi ini akan digunakan untuk membantu
                    masyarakat memahami peran organisasi.
                  </p>
                </div>

                <div class="waste-card__icon">
                  <Recycle
                    size={22}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div class="selected-summary">
                <div class="selected-summary__icon">
                  <CircleCheck
                    size={19}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

                <div>
                  <span>
                    MATERIAL DIPILIH
                  </span>

                  <strong data-selected-count>
                    0 material
                  </strong>
                </div>
              </div>

              <div class="material-controls">
                <div class="material-search">
                  <input
                    id="materialSearch"
                    class="material-search__input"
                    type="search"
                    placeholder="Cari material..."
                    autocomplete="off"
                    data-material-search
                    aria-label="Cari material"
                  />
                </div>

                <div
                  class="category-filter"
                  role="tablist"
                  aria-label="Filter kategori sampah"
                >
                  <button
                    type="button"
                    class="category-filter__button category-filter__button--active"
                    data-category-filter="all"
                    aria-selected="true"
                  >
                    Semua
                  </button>

                  {
                    categories.map((category) => (
                      <button
                        type="button"
                        class="category-filter__button"
                        data-category-filter={category.id}
                        aria-selected="false"
                      >
                        {category.label}
                      </button>
                    ))
                  }
                </div>
              </div>

              <div class="material-grid" data-material-grid>
                {
                  materials.map((material) => (
                    <label
                      class="material-option"
                      data-material-option
                      data-material-id={material.id}
                      data-material-category={material.category}
                      data-material-label={material.label.toLowerCase()}
                    >
                      <input
                        type="checkbox"
                        name="materials"
                        value={material.id}
                        data-material-checkbox
                      />

                      <span class="material-option__check">
                        <CircleCheck
                          size={15}
                          stroke-width={2}
                          aria-hidden="true"
                        />
                      </span>

                      <span class="material-option__body">
                        <strong>
                          {material.label}
                        </strong>

                        <small>
                          {material.description}
                        </small>
                      </span>
                    </label>
                  ))
                }
              </div>

              <div
                class="material-empty"
                data-material-empty
                hidden
              >
                <Trash2
                  size={22}
                  stroke-width={1.8}
                  aria-hidden="true"
                />

                <strong>
                  Material tidak ditemukan
                </strong>

                <span>
                  Coba gunakan kata pencarian atau kategori yang berbeda.
                </span>
              </div>
            </section>

            <section class="waste-card">
              <div class="waste-card__header">
                <div>
                  <span class="waste-card__eyebrow">
                    INFORMASI PENGELOLAAN
                  </span>

                  <h2 class="waste-card__title">
                    Jelaskan cakupan pengelolaan
                  </h2>

                  <p class="waste-card__description">
                    Tambahkan konteks singkat agar masyarakat tidak hanya
                    mengetahui materialnya, tetapi juga memahami bagaimana
                    organisasi menangani material tersebut.
                  </p>
                </div>

                <div class="waste-card__icon">
                  <ClipboardList
                    size={22}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div class="field">
                <label
                  class="field__label"
                  for="managementDescription"
                >
                  Deskripsi pengelolaan
                </label>

                <p
                  class="field__hint"
                  id="managementDescriptionHint"
                >
                  Jelaskan secara umum aktivitas pengelolaan material,
                  misalnya pemilahan, pengumpulan, pengolahan, recovery,
                  atau proses lain yang memang dilakukan organisasi.
                </p>

                <textarea
                  id="managementDescription"
                  name="managementDescription"
                  class="field__textarea"
                  rows="7"
                  maxlength="1800"
                  aria-describedby="managementDescriptionHint managementDescriptionCounter"
                  placeholder="Contoh: Organisasi menerima material terpilah dari masyarakat, melakukan pemeriksaan awal, kemudian memproses material sesuai karakteristiknya..."
                  data-management-description
                ></textarea>

                <div class="field__footer">
                  <span
                    class="field__counter"
                    data-management-description-counter
                  >
                    0 / 1800
                  </span>
                </div>
              </div>

              <div class="management-notice">
                <ShieldCheck
                  size={19}
                  stroke-width={2}
                  aria-hidden="true"
                />

                <div>
                  <strong>
                    Gunakan informasi yang benar-benar dilakukan
                  </strong>

                  <span>
                    Hindari menampilkan proses, fasilitas, atau kemampuan
                    pengelolaan yang belum tersedia di organisasi.
                  </span>
                </div>
              </div>
            </section>

            <section class="waste-card">
              <div class="waste-card__header">
                <div>
                  <span class="waste-card__eyebrow">
                    KATEGORI UTAMA
                  </span>

                  <h2 class="waste-card__title">
                    Ringkasan kategori yang ditangani
                  </h2>

                  <p class="waste-card__description">
                    Ringkasan ini terbentuk dari material yang Anda pilih
                    sehingga informasi kategori tetap konsisten dengan data
                    material.
                  </p>
                </div>

                <div class="waste-card__icon">
                  <Leaf
                    size={22}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div
                class="category-summary-grid"
                data-category-summary
              >
                {
                  categories.map((category) => (
                    <div
                      class="category-summary"
                      data-summary-category={category.id}
                    >
                      <div class="category-summary__top">
                        <span class="category-summary__dot"></span>

                        <span class="category-summary__label">
                          {category.label}
                        </span>
                      </div>

                      <strong
                        data-summary-count={category.id}
                      >
                        0 material
                      </strong>

                      <p>
                        {category.description}
                      </p>
                    </div>
                  ))
                }
              </div>
            </section>

            <section class="waste-card waste-card--save">
              <div class="save-box">
                <div class="save-box__icon">
                  <Save
                    size={21}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>

                <div class="save-box__content">
                  <h2>
                    Simpan informasi sampah
                  </h2>

                  <p>
                    Pilihan material dan deskripsi akan dipersiapkan untuk
                    proses penyimpanan dan peninjauan organisasi.
                  </p>
                </div>
              </div>

              <div class="form-actions">
                <a
                  class="form-actions__back"
                  href="/organization"
                >
                  <ArrowLeft
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Kembali
                  </span>
                </a>

                <button
                  type="button"
                  class="form-actions__submit"
                  data-save-waste
                >
                  <Save
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span data-save-label>
                    Simpan informasi
                  </span>
                </button>
              </div>

              <p
                class="save-message"
                data-save-message
                hidden
              ></p>
            </section>

            <div
              class="save-success"
              data-save-success
              hidden
            >
              <div class="save-success__icon">
                <CircleCheck
                  size={33}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                INFORMASI DIPERSIAPKAN
              </span>

              <h2>
                Data sampah berhasil dipersiapkan
              </h2>

              <p>
                Informasi material dan cakupan pengelolaan telah melalui
                pemeriksaan dasar pada browser dan siap diteruskan ke proses
                penyimpanan atau verifikasi.
              </p>

              <div class="save-success__actions">
                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  Kembali ke portal

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-waste
                >
                  Edit kembali
                </button>
              </div>
            </div>
          </div>

          <aside class="waste-sidebar">
            <div class="sidebar-card sidebar-card--highlight">
              <div class="sidebar-card__icon">
                <Recycle
                  size={20}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <span class="sidebar-card__eyebrow">
                RINGKASAN
              </span>

              <h2>
                Cakupan sampah organisasi
              </h2>

              <div class="summary-number">
                <strong data-sidebar-count>
                  0
                </strong>

                <span>
                  material dipilih
                </span>
              </div>

              <p>
                Pilih material yang benar-benar diterima, ditangani, atau
                dikelola oleh organisasi.
              </p>
            </div>

            <div class="sidebar-card">
              <span class="sidebar-card__eyebrow">
                PRINSIP DATA
              </span>

              <h2>
                Jadilah spesifik
              </h2>

              <div class="sidebar-check-list">
                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Pilih material yang benar-benar ditangani
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Jelaskan cakupan pengelolaan secara wajar
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Hindari klaim yang belum diverifikasi
                  </span>
                </div>
              </div>
            </div>

            <div class="sidebar-card sidebar-card--warning">
              <div class="sidebar-warning__icon">
                <TriangleAlert
                  size={18}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </div>

              <div>
                <strong>
                  Jangan memperluas klaim
                </strong>

                <p>
                  Material yang dipilih sebaiknya mencerminkan aktivitas
                  pengelolaan organisasi saat ini.
                </p>
              </div>
            </div>

            <div class="sidebar-card sidebar-card--next">
              <span class="sidebar-card__eyebrow">
                LANJUTKAN
              </span>

              <h2>
                Lengkapi informasi organisasi
              </h2>

              <a href="/organization/process">
                Kelola proses

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/products">
                Kelola produk

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/profile">
                Kembali ke profil

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
</OrganizationLayout>

<style>
  .organization-waste-page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .waste-content {
    padding: var(--space-10) 0 var(--space-14);
  }

  .waste-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .waste-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      320px;
    gap: var(--space-7);
    align-items: start;
  }

  .waste-main {
    min-width: 0;
  }

  .waste-card {
    margin-bottom: var(--space-5);
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  .waste-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .waste-card__eyebrow,
  .sidebar-card__eyebrow,
  .save-success__eyebrow {
    display: block;
    color: var(--color-primary-dark);
    font-size: 0.64rem;
    font-weight: 850;
    letter-spacing: 0.11em;
  }

  .waste-card__title {
    margin: var(--space-2) 0 0;
    color: var(--color-text-strong);
    font-size: 1.1rem;
    font-weight: 850;
    line-height: 1.3;
  }

  .waste-card__description {
    max-width: 700px;
    margin: 5px 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.65;
  }

  .waste-card__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .selected-summary {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: var(--space-6);
    padding: 12px 14px;
    border-radius: var(--radius-lg);
    background: var(--color-primary-soft);
  }

  .selected-summary__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-primary);
  }

  .selected-summary span,
  .selected-summary strong {
    display: block;
  }

  .selected-summary span {
    color: var(--color-primary-dark);
    font-size: 0.55rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  .selected-summary strong {
    margin-top: 2px;
    color: var(--color-text-strong);
    font-size: var(--font-size-sm);
  }

  .material-controls {
    padding-top: var(--space-6);
  }

  .material-search {
    margin-bottom: var(--space-4);
  }

  .material-search__input {
    width: 100%;
    min-height: 44px;
    padding: 0 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-strong);
    font: inherit;
    font-size: var(--font-size-sm);
  }

  .material-search__input::placeholder {
    color: var(--color-text-faint);
  }

  .material-search__input:focus {
    border-color: var(--color-primary);
    outline: none;
    box-shadow:
      0 0 0 3px var(--color-primary-ring);
  }

  .category-filter {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 3px;
    scrollbar-width: thin;
  }

  .category-filter__button {
    flex: 0 0 auto;
    min-height: 35px;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.71rem;
    font-weight: 750;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .category-filter__button:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text-strong);
  }

  .category-filter__button--active {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
  }

  .material-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .material-option {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 11px;
    min-width: 0;
    padding: 15px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .material-option:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-xs);
  }

  .material-option:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
    box-shadow:
      0 0 0 1px var(--color-primary);
  }

  .material-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .material-option__check {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    margin-top: 1px;
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    background: var(--color-surface);
    color: transparent;
  }

  .material-option input:checked
    + .material-option__check {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
  }

  .material-option__body {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
  }

  .material-option__body strong {
    color: var(--color-text-strong);
    font-size: var(--font-size-sm);
    font-weight: 800;
  }

  .material-option__body small {
    margin-top: 4px;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .material-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 150px;
    margin-top: var(--space-5);
    padding: var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    text-align: center;
  }

  .material-empty[hidden] {
    display: none;
  }

  .material-empty strong {
    color: var(--color-text-strong);
    font-size: var(--font-size-sm);
  }

  .material-empty span {
    font-size: var(--font-size-xs);
  }

  .field {
    min-width: 0;
    padding-top: var(--space-6);
  }

  .field__label {
    display: inline-flex;
    margin-bottom: var(--space-2);
    color: var(--color-text-strong);
    font-size: var(--font-size-sm);
    font-weight: 750;
  }

  .field__hint {
    margin: 0 0 var(--space-2);
    color: var(--color-text-faint);
    font-size: var(--font-size-xs);
    line-height: 1.55;
  }

  .field__textarea {
    width: 100%;
    min-height: 145px;
    padding: 12px 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-strong);
    font: inherit;
    font-size: var(--font-size-sm);
    line-height: 1.65;
