</style>

<script>
  const initializeOrganizationWastePage = () => {
    const form =
      document.querySelector<HTMLFormElement>(
        "[data-waste-form]",
      );

    if (
      !form ||
      form.dataset.initialized ===
        "true"
    ) {
      return;
    }

    form.dataset.initialized =
      "true";

    const materialSearch =
      document.querySelector<HTMLInputElement>(
        "[data-material-search]",
      );

    const materialOptions =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          "[data-material-option]",
        ),
      );

    const materialCheckboxes =
      Array.from(
        document.querySelectorAll<HTMLInputElement>(
          "[data-material-checkbox]",
        ),
      );

    const categoryButtons =
      Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-category-filter]",
        ),
      );

    const materialEmpty =
      document.querySelector<HTMLElement>(
        "[data-material-empty]",
      );

    const selectedCount =
      document.querySelector<HTMLElement>(
        "[data-selected-count]",
      );

    const sidebarCount =
      document.querySelector<HTMLElement>(
        "[data-sidebar-count]",
      );

    const materialError =
      document.querySelector<HTMLElement>(
        "[data-material-error]",
      );

    const descriptionField =
      document.querySelector<HTMLTextAreaElement>(
        "[data-management-description]",
      );

    const descriptionCounter =
      document.querySelector<HTMLElement>(
        "[data-management-description-counter]",
      );

    const descriptionError =
      document.querySelector<HTMLElement>(
        "[data-description-error]",
      );

    const saveButton =
      document.querySelector<HTMLButtonElement>(
        "[data-save-waste]",
      );

    const saveLabel =
      document.querySelector<HTMLElement>(
        "[data-save-label]",
      );

    const saveMessage =
      document.querySelector<HTMLElement>(
        "[data-save-message]",
      );

    const saveSuccess =
      document.querySelector<HTMLElement>(
        "[data-save-success]",
      );

    const sidebar =
      document.querySelector<HTMLElement>(
        "[data-waste-sidebar]",
      );

    const editWasteButton =
      document.querySelector<HTMLButtonElement>(
        "[data-edit-waste]",
      );

    let activeCategory =
      "all";

    const getSelectedMaterials =
      () => {
        return materialCheckboxes
          .filter(
            (checkbox) =>
              checkbox.checked,
          )
          .map(
            (checkbox) =>
              checkbox.value,
          )
          .filter(Boolean);
      };

    const clearMaterialError =
      () => {
        if (materialError) {
          materialError.textContent =
            "";

          materialError.hidden =
            true;
        }

        materialCheckboxes.forEach(
          (checkbox) => {
            checkbox.removeAttribute(
              "aria-invalid",
            );
          },
        );
      };

    const updateCategorySummary =
      () => {
        const summaryElements =
          Array.from(
            document.querySelectorAll<HTMLElement>(
              "[data-summary-category]",
            ),
          );

        summaryElements.forEach(
          (summaryElement) => {
            const category =
              summaryElement.getAttribute(
                "data-summary-category",
              );

            if (!category) {
              return;
            }

            const count =
              materialOptions.filter(
                (option) => {
                  const optionCategory =
                    option.getAttribute(
                      "data-material-category",
                    );

                  const checkbox =
                    option.querySelector<HTMLInputElement>(
                      "[data-material-checkbox]",
                    );

                  return (
                    optionCategory ===
                      category &&
                    checkbox?.checked ===
                      true
                  );
                },
              ).length;

            const countElement =
              summaryElement.querySelector<HTMLElement>(
                `[data-summary-count="${category}"]`,
              );

            if (countElement) {
              countElement.textContent =
                `${count} material${count === 1 ? "" : "s"}`;
            }

            summaryElement.classList.toggle(
              "category-summary--selected",
              count > 0,
            );
          },
        );
      };

    const updateSelectedCount =
      () => {
        const selected =
          getSelectedMaterials();

        const count =
          selected.length;

        if (selectedCount) {
          selectedCount.textContent =
            `${count} material${count === 1 ? "" : "s"}`;
        }

        if (sidebarCount) {
          sidebarCount.textContent =
            String(count);
        }

        updateCategorySummary();
      };

    const updateMaterialVisibility =
      () => {
        const searchValue =
          materialSearch?.value
            .trim()
            .toLowerCase() ?? "";

        let visibleCount =
          0;

        materialOptions.forEach(
          (option) => {
            const category =
              option.getAttribute(
                "data-material-category",
              ) ?? "";

            const label =
              option.getAttribute(
                "data-material-label",
              ) ?? "";

            const matchesCategory =
              activeCategory ===
                "all" ||
              category ===
                activeCategory;

            const matchesSearch =
              searchValue === "" ||
              label.includes(
                searchValue,
              );

            const visible =
              matchesCategory &&
              matchesSearch;

            option.hidden =
              !visible;

            if (visible) {
              visibleCount +=
                1;
            }
          },
        );

        if (materialEmpty) {
          materialEmpty.hidden =
            visibleCount !== 0;
        }
      };

    const updateCategoryButtons =
      () => {
        categoryButtons.forEach(
          (button) => {
            const category =
              button.getAttribute(
                "data-category-filter",
              );

            const active =
              category ===
              activeCategory;

            button.classList.toggle(
              "category-filter__button--active",
              active,
            );

            button.setAttribute(
              "aria-selected",
              active
                ? "true"
                : "false",
            );

            button.tabIndex =
              active ? 0 : -1;
          },
        );
      };

    const updateDescriptionCounter =
      () => {
        if (
          !descriptionField ||
          !descriptionCounter
        ) {
          return;
        }

        descriptionCounter.textContent =
          `${descriptionField.value.length} / 1800`;
      };

    const showSaveMessage = (
      message: string,
    ) => {
      if (!saveMessage) {
        return;
      }

      saveMessage.textContent =
        message;

      saveMessage.hidden =
        false;
    };

    const clearSaveMessage =
      () => {
        if (!saveMessage) {
          return;
        }

        saveMessage.textContent =
          "";

        saveMessage.hidden =
          true;
      };

    const validateWasteData =
      () => {
        let valid = true;

        clearMaterialError();

        if (descriptionError) {
          descriptionError.textContent =
            "";

          descriptionError.hidden =
            true;
        }

        descriptionField?.removeAttribute(
          "aria-invalid",
        );

        const selected =
          getSelectedMaterials();

        if (
          selected.length ===
          0
        ) {
          valid = false;

          if (materialError) {
            materialError.textContent =
              "Pilih minimal satu material yang benar-benar dikelola organisasi.";

            materialError.hidden =
              false;
          }

          materialCheckboxes.forEach(
            (checkbox) => {
              checkbox.setAttribute(
                "aria-invalid",
                "true",
              );
            },
          );
        }

        if (descriptionField) {
          const description =
            descriptionField.value.trim();

          /*
           * Optional description remains allowed.
           * When provided, it must be meaningful enough to avoid
           * extremely short context.
           */
          if (
            description.length >
              0 &&
            description.length <
              20
          ) {
            valid = false;

            descriptionField.setAttribute(
              "aria-invalid",
              "true",
            );

            if (descriptionError) {
              descriptionError.textContent =
                "Deskripsi pengelolaan yang diisi minimal 20 karakter.";

              descriptionError.hidden =
                false;
            }
          }
        }

        if (!valid) {
          const firstInvalid =
            form.querySelector<HTMLElement>(
              "[aria-invalid='true']",
            );

          if (firstInvalid) {
            firstInvalid.scrollIntoView(
              {
                behavior:
                  "smooth",
                block:
                  "center",
              },
            );

            firstInvalid.focus();
          }
        }

        return valid;
      };

    const buildWastePayload =
      () => {
        return {
          materials:
            getSelectedMaterials(),

          managementDescription:
            descriptionField?.value.trim() ??
            "",

          updatedAt:
            new Date().toISOString(),
        };
      };

    const setEditorState = (
      hidden: boolean,
    ) => {
      form
        .querySelectorAll<HTMLElement>(
          ".waste-card",
        )
        .forEach(
          (section) => {
            section.hidden =
              hidden;
          },
        );

      if (sidebar) {
        sidebar.hidden =
          hidden;
      }

      if (saveSuccess) {
        saveSuccess.hidden =
          !hidden;
      }
    };

    const restoreEditor =
      () => {
        setEditorState(
          false,
        );

        if (saveButton) {
          saveButton.disabled =
            false;
        }

        if (saveLabel) {
          saveLabel.textContent =
            "Simpan informasi";
        }

        clearSaveMessage();

        form.scrollIntoView({
          behavior:
            "smooth",
          block:
            "start",
        });
      };

    const handleSubmit =
      async (
        event: SubmitEvent,
      ) => {
        event.preventDefault();

        clearSaveMessage();

        if (
          !validateWasteData()
        ) {
          return;
        }

        const payload =
          buildWastePayload();

        if (saveButton) {
          saveButton.disabled =
            true;
        }

        if (saveLabel) {
          saveLabel.textContent =
            "Menyiapkan...";
        }

        showSaveMessage(
          "Memeriksa informasi sampah...",
        );

        await Promise.resolve();

        window.dispatchEvent(
          new CustomEvent(
            "binsight:organization-waste-save",
            {
              detail:
                payload,
            },
          ),
        );

        setEditorState(
          true,
        );

        clearSaveMessage();

        saveSuccess?.scrollIntoView(
          {
            behavior:
              "smooth",
            block:
              "start",
          },
        );
      };

    const handleShortcut =
      (
        event: KeyboardEvent,
      ) => {
        if (
          event.key !==
            "/" ||
          document.activeElement ===
            materialSearch
        ) {
          return;
        }

        const target =
          event.target;

        if (
          target instanceof
            HTMLInputElement ||
          target instanceof
            HTMLTextAreaElement ||
          target instanceof
            HTMLSelectElement
        ) {
          return;
        }

        event.preventDefault();

        materialSearch?.focus();
      };

    const handleCategoryKeydown =
      (
        event: KeyboardEvent,
      ) => {
        const current =
          event.currentTarget;

        if (
          !(
            current instanceof
            HTMLButtonElement
          )
        ) {
          return;
        }

        const currentIndex =
          categoryButtons.indexOf(
            current,
          );

        if (
          currentIndex <
          0
        ) {
          return;
        }

        let nextIndex =
          currentIndex;

        if (
          event.key ===
          "ArrowRight"
        ) {
          nextIndex =
            (currentIndex + 1) %
            categoryButtons.length;
        } else if (
          event.key ===
          "ArrowLeft"
        ) {
          nextIndex =
            (currentIndex -
              1 +
              categoryButtons.length) %
            categoryButtons.length;
        } else if (
          event.key ===
          "Home"
        ) {
          nextIndex = 0;
        } else if (
          event.key ===
          "End"
        ) {
          nextIndex =
            categoryButtons.length -
            1;
        } else {
          return;
        }

        event.preventDefault();

        const next =
          categoryButtons[
            nextIndex
          ];

        next?.focus();
        next?.click();
      };

    materialSearch?.addEventListener(
      "input",
      updateMaterialVisibility,
    );

    categoryButtons.forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            activeCategory =
              button.getAttribute(
                "data-category-filter",
              ) ??
              "all";

            updateCategoryButtons();
            updateMaterialVisibility();
          },
        );

        button.addEventListener(
          "keydown",
          handleCategoryKeydown,
        );
      },
    );

    materialCheckboxes.forEach(
      (checkbox) => {
        checkbox.addEventListener(
          "change",
          () => {
            clearMaterialError();
            updateSelectedCount();
          },
        );
      },
    );

    descriptionField?.addEventListener(
      "input",
      () => {
        descriptionField.removeAttribute(
          "aria-invalid",
        );

        if (descriptionError) {
          descriptionError.textContent =
            "";

          descriptionError.hidden =
            true;
        }

        updateDescriptionCounter();
      },
    );

    form.addEventListener(
      "submit",
      handleSubmit,
    );

    editWasteButton?.addEventListener(
      "click",
      restoreEditor,
    );

    document.addEventListener(
      "keydown",
      handleShortcut,
    );

    updateSelectedCount();
    updateCategoryButtons();
    updateMaterialVisibility();
    updateDescriptionCounter();
  };

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeOrganizationWastePage,
      { once: true },
    );
  } else {
    initializeOrganizationWastePage();
  }

  document.addEventListener(
    "astro:page-load",
    initializeOrganizationWastePage,
  );
</script>