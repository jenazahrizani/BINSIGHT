---
/**
 * ============================================================================
 * BINSIGHT — ORGANIZATION WASTE
 * ============================================================================
 * Manage the waste/material scope represented by an organization.
 *
 * Architecture:
 * - OrganizationLayout owns Navbar, workspace sidebar, main shell and Footer.
 * - This page owns only waste/material-specific content.
 *
 * Principles:
 * - BINSIGHT brutalist editorial system.
 * - Existing waste taxonomy is the single source of truth.
 * - No fabricated operational statistics.
 * - Browser-side validation only.
 * - CustomEvent integration hook for future persistence.
 * - Safe across Astro client-side navigation.
 * - Accessible keyboard and focus states.
 * ============================================================================
 */

import {
  ArrowLeft,
  ArrowRight,
  CircleCheck,
  ClipboardList,
  Leaf,
  Recycle,
  Save,
  ShieldCheck,
  TriangleAlert,
  Trash2,
} from "@lucide/astro";

import OrganizationLayout from "@layouts/OrganizationLayout.astro";

import {
  WASTE_CATEGORY,
  WASTE_MATERIALS,
  getWasteCategoryLabel,
  getWasteMaterialLabel,
} from "@lib/constants/waste";

const categories = [
  {
    id: WASTE_CATEGORY.ORGANIC,
    label: getWasteCategoryLabel(
      WASTE_CATEGORY.ORGANIC,
    ),
    description:
      "Material yang berasal dari sumber hayati dan dapat mengalami proses penguraian.",
  },
  {
    id: WASTE_CATEGORY.INORGANIC,
    label: getWasteCategoryLabel(
      WASTE_CATEGORY.INORGANIC,
    ),
    description:
      "Material non-organik yang dapat dipilah untuk digunakan kembali atau didaur ulang.",
  },
  {
    id: WASTE_CATEGORY.HAZARDOUS,
    label: getWasteCategoryLabel(
      WASTE_CATEGORY.HAZARDOUS,
    ),
    description:
      "Material yang memerlukan penanganan khusus karena karakteristik bahayanya.",
  },
  {
    id: WASTE_CATEGORY.ELECTRONIC,
    label: getWasteCategoryLabel(
      WASTE_CATEGORY.ELECTRONIC,
    ),
    description:
      "Peralatan dan komponen elektronik yang sudah tidak digunakan.",
  },
  {
    id: WASTE_CATEGORY.RESIDUAL,
    label: getWasteCategoryLabel(
      WASTE_CATEGORY.RESIDUAL,
    ),
    description:
      "Material sisa yang tidak dapat dimanfaatkan melalui pengelolaan yang tersedia.",
  },
];

const materials = WASTE_MATERIALS.map(
  (material) => ({
    id: material.id,
    label: getWasteMaterialLabel(
      material.id,
    ),
    category: material.category,
    description: material.description,
  }),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Sampah yang Dikelola — BINSIGHT",
  description:
    "Kelola informasi material dan kategori sampah yang ditangani oleh organisasi melalui workspace organisasi BINSIGHT.",
  url: "https://binsight.id/organization/waste",
  isPartOf: {
    "@type": "WebSite",
    name: "BINSIGHT — Badung Waste Intelligence",
    url: "https://binsight.id",
  },
};
---

<OrganizationLayout
  title="Sampah yang Dikelola"
  description="Kelola informasi material dan kategori sampah yang ditangani organisasi."
  activeSection="waste"
  breadcrumbs={[
    {
      label: "Organisasi",
      href: "/organization",
    },
    {
      label: "Sampah yang Dikelola",
    },
  ]}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <div class="organization-waste-page">
    <section
      class="waste-page"
      aria-labelledby="waste-page-title"
    >
      <div class="waste-page__container">
        <!-- ============================================================
             PAGE HERO
        ============================================================= -->
        <section class="waste-hero">
          <div class="waste-hero__main">
            <p class="waste-hero__eyebrow">
              ORGANIZATION / WASTE
            </p>

            <h1
              id="waste-page-title"
              class="waste-hero__title"
            >
              Sampah yang dikelola
            </h1>

            <p class="waste-hero__description">
              Tampilkan material persampahan yang benar-benar ditangani
              organisasi agar masyarakat dapat memahami cakupan pengelolaan
              dan peran organisasi secara lebih jelas.
            </p>
          </div>

          <div class="waste-hero__status">
            <div
              class="waste-hero__status-icon"
              aria-hidden="true"
            >
              <Recycle
                size={19}
                stroke-width={2}
              />
            </div>

            <div class="waste-hero__status-copy">
              <span>DATA SCOPE</span>

              <strong>
                MATERIAL &amp; PENGELOLAAN
              </strong>
            </div>
          </div>
        </section>

        <!-- ============================================================
             CONTENT
        ============================================================= -->
        <div class="waste-layout">
          <!-- ==========================================================
               MAIN
          =========================================================== -->
          <div class="waste-main">
            <form
              class="waste-form"
              id="organization-waste-form"
              data-waste-form
              novalidate
            >
              <!-- ======================================================
                   01 / MATERIAL
              ======================================================= -->
              <section
                class="waste-card"
                aria-labelledby="materials-title"
              >
                <header class="waste-card__header">
                  <div class="waste-card__heading">
                    <span class="waste-card__eyebrow">
                      01 / MATERIAL YANG DIKELOLA
                    </span>

                    <h2
                      id="materials-title"
                      class="waste-card__title"
                    >
                      Pilih material yang relevan
                    </h2>

                    <p class="waste-card__description">
                      Pilih semua material yang benar-benar diterima,
                      ditangani, atau dikelola oleh organisasi. Jangan
                      memperluas cakupan melebihi aktivitas yang tersedia.
                    </p>
                  </div>

                  <div
                    class="waste-card__icon"
                    aria-hidden="true"
                  >
                    <Recycle
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div
                  class="selected-summary"
                  aria-live="polite"
                >
                  <div
                    class="selected-summary__icon"
                    aria-hidden="true"
                  >
                    <CircleCheck
                      size={18}
                      stroke-width={2}
                    />
                  </div>

                  <div class="selected-summary__copy">
                    <span>
                      MATERIAL DIPILIH
                    </span>

                    <strong data-selected-count>
                      0 material
                    </strong>
                  </div>
                </div>

                <div class="material-controls">
                  <div class="material-search">
                    <label
                      class="sr-only"
                      for="materialSearch"
                    >
                      Cari material
                    </label>

                    <input
                      id="materialSearch"
                      class="material-search__input"
                      type="search"
                      placeholder="Cari material..."
                      autocomplete="off"
                      data-material-search
                    />

                    <span
                      class="material-search__shortcut"
                      aria-hidden="true"
                    >
                      /
                    </span>
                  </div>

                  <div
                    class="category-filter"
                    role="tablist"
                    aria-label="Filter kategori sampah"
                  >
                    <button
                      type="button"
                      role="tab"
                      class="category-filter__button category-filter__button--active"
                      data-category-filter="all"
                      aria-selected="true"
                      tabindex="0"
                    >
                      Semua
                    </button>

                    {
                      categories.map(
                        (category) => (
                          <button
                            type="button"
                            role="tab"
                            class="category-filter__button"
                            data-category-filter={
                              category.id
                            }
                            aria-selected="false"
                            tabindex="-1"
                          >
                            {
                              category.label
                            }
                          </button>
                        ),
                      )
                    }
                  </div>
                </div>

                <div
                  class="material-grid"
                  data-material-grid
                  aria-label="Daftar material"
                >
                  {
                    materials.map(
                      (material) => (
                        <label
                          class="material-option"
                          data-material-option
                          data-material-id={
                            material.id
                          }
                          data-material-category={
                            material.category
                          }
                          data-material-label={material.label.toLowerCase()}
                        >
                          <input
                            type="checkbox"
                            name="materials"
                            value={
                              material.id
                            }
                            data-material-checkbox
                          />

                          <span
                            class="material-option__check"
                            aria-hidden="true"
                          >
                            <CircleCheck
                              size={15}
                              stroke-width={2}
                            />
                          </span>

                          <span class="material-option__body">
                            <strong>
                              {material.label}
                            </strong>

                            <small>
                              {
                                material.description
                              }
                            </small>
                          </span>

                          <span
                            class="material-option__category"
                            aria-hidden="true"
                          >
                            {
                              categories.find(
                                (
                                  category,
                                ) =>
                                  category.id ===
                                  material.category,
                              )?.label ??
                              "MATERIAL"
                            }
                          </span>
                        </label>
                      ),
                    )
                  }
                </div>

                <div
                  class="material-empty"
                  data-material-empty
                  hidden
                >
                  <Trash2
                    size={21}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />

                  <div>
                    <strong>
                      Material tidak ditemukan
                    </strong>

                    <span>
                      Coba gunakan kata pencarian atau kategori yang berbeda.
                    </span>
                  </div>
                </div>

                <p
                  class="field-error material-error"
                  data-material-error
                  hidden
                  role="alert"
                ></p>
              </section>

              <!-- ======================================================
                   02 / MANAGEMENT
              ======================================================= -->
              <section
                class="waste-card"
                aria-labelledby="management-title"
              >
                <header class="waste-card__header">
                  <div class="waste-card__heading">
                    <span class="waste-card__eyebrow">
                      02 / INFORMASI PENGELOLAAN
                    </span>

                    <h2
                      id="management-title"
                      class="waste-card__title"
                    >
                      Jelaskan cakupan pengelolaan
                    </h2>

                    <p class="waste-card__description">
                      Tambahkan konteks singkat agar masyarakat tidak hanya
                      mengetahui materialnya, tetapi juga memahami bagaimana
                      organisasi menangani material tersebut.
                    </p>
                  </div>

                  <div
                    class="waste-card__icon"
                    aria-hidden="true"
                  >
                    <ClipboardList
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div class="field">
                  <label
                    class="field__label"
                    for="managementDescription"
                  >
                    Deskripsi pengelolaan
                  </label>

                  <p
                    class="field__hint"
                    id="managementDescriptionHint"
                  >
                    Jelaskan secara umum aktivitas pengelolaan material,
                    misalnya pemilahan, pengumpulan, pengolahan, recovery,
                    atau proses lain yang memang dilakukan organisasi.
                  </p>

                  <textarea
                    id="managementDescription"
                    name="managementDescription"
                    class="field__textarea"
                    rows="7"
                    maxlength="1800"
                    aria-describedby="managementDescriptionHint managementDescriptionCounter managementDescriptionError"
                    placeholder="Contoh: Organisasi menerima material terpilah dari masyarakat, melakukan pemeriksaan awal, kemudian memproses material sesuai karakteristiknya..."
                    data-management-description
                  ></textarea>

                  <div class="field__footer">
                    <p
                      id="managementDescriptionError"
                      class="field-error"
                      data-description-error
                      hidden
                      role="alert"
                    ></p>

                    <span
                      id="managementDescriptionCounter"
                      class="field__counter"
                      data-management-description-counter
                    >
                      0 / 1800
                    </span>
                  </div>
                </div>

                <div class="management-notice">
                  <div
                    class="management-notice__icon"
                    aria-hidden="true"
                  >
                    <ShieldCheck
                      size={17}
                      stroke-width={2}
                    />
                  </div>

                  <div class="management-notice__copy">
                    <strong>
                      Gunakan informasi yang benar-benar dilakukan
                    </strong>

                    <span>
                      Hindari menampilkan proses, fasilitas, atau kemampuan
                      pengelolaan yang belum tersedia di organisasi.
                    </span>
                  </div>
                </div>
              </section>

              <!-- ======================================================
                   03 / CATEGORY SUMMARY
              ======================================================= -->
              <section
                class="waste-card"
                aria-labelledby="category-summary-title"
              >
                <header class="waste-card__header">
                  <div class="waste-card__heading">
                    <span class="waste-card__eyebrow">
                      03 / KATEGORI UTAMA
                    </span>

                    <h2
                      id="category-summary-title"
                      class="waste-card__title"
                    >
                      Ringkasan kategori yang ditangani
                    </h2>

                    <p class="waste-card__description">
                      Ringkasan ini terbentuk dari material yang Anda pilih,
                      sehingga informasi kategori tetap konsisten dengan data
                      material.
                    </p>
                  </div>

                  <div
                    class="waste-card__icon"
                    aria-hidden="true"
                  >
                    <Leaf
                      size={21}
                      stroke-width={1.9}
                    />
                  </div>
                </header>

                <div
                  class="category-summary-grid"
                  data-category-summary
                >
                  {
                    categories.map(
                      (category, index) => (
                        <div
                          class="category-summary"
                          data-summary-category={
                            category.id
                          }
                        >
                          <div class="category-summary__top">
                            <span
                              class="category-summary__number"
                              aria-hidden="true"
                            >
                              {String(
                                index + 1,
                              ).padStart(
                                2,
                                "0",
                              )}
                            </span>

                            <span class="category-summary__label">
                              {
                                category.label
                              }
                            </span>
                          </div>

                          <strong
                            data-summary-count={
                              category.id
                            }
                          >
                            0 material
                          </strong>

                          <p>
                            {
                              category.description
                            }
                          </p>
                        </div>
                      ),
                    )
                  }
                </div>
              </section>

              <!-- ======================================================
                   SAVE
              ======================================================= -->
              <section class="waste-card waste-card--save">
                <div class="save-box">
                  <div
                    class="save-box__icon"
                    aria-hidden="true"
                  >
                    <Save
                      size={20}
                      stroke-width={2}
                    />
                  </div>

                  <div class="save-box__content">
                    <span class="save-box__eyebrow">
                      READY FOR REVIEW
                    </span>

                    <h2>
                      Simpan informasi sampah
                    </h2>

                    <p>
                      Data material dan deskripsi akan dipersiapkan untuk
                      proses penyimpanan dan peninjauan organisasi.
                    </p>
                  </div>
                </div>

                <div class="form-actions">
                  <a
                    class="form-actions__back"
                    href="/organization"
                  >
                    <ArrowLeft
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span>
                      Kembali
                    </span>
                  </a>

                  <button
                    type="submit"
                    class="form-actions__submit"
                    data-save-waste
                  >
                    <Save
                      size={17}
                      stroke-width={2}
                      aria-hidden="true"
                    />

                    <span data-save-label>
                      Simpan informasi
                    </span>

                    <ArrowRight
                      size={16}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </button>
                </div>

                <p
                  class="save-message"
                  data-save-message
                  aria-live="polite"
                  hidden
                ></p>
              </section>
            </form>

            <!-- ==========================================================
                 SUCCESS
            =========================================================== -->
            <section
              class="save-success"
              data-save-success
              hidden
              aria-labelledby="save-success-title"
            >
              <span
                class="save-success__index"
                aria-hidden="true"
              >
                04
              </span>

              <div class="save-success__icon">
                <CircleCheck
                  size={32}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </div>

              <span class="save-success__eyebrow">
                INFORMASI DIPERSIAPKAN
              </span>

              <h2 id="save-success-title">
                Data sampah berhasil dipersiapkan
              </h2>

              <p>
                Informasi material dan cakupan pengelolaan telah melewati
                pemeriksaan dasar pada browser dan siap diteruskan ke proses
                penyimpanan atau verifikasi.
              </p>

              <div class="save-success__actions">
                <a
                  class="form-actions__submit"
                  href="/organization"
                >
                  <span>
                    Kembali ke workspace
                  </span>

                  <ArrowRight
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </a>

                <button
                  type="button"
                  class="form-actions__back"
                  data-edit-waste
                >
                  Edit kembali
                </button>
              </div>
            </section>
          </div>

          <!-- ==========================================================
               PAGE CONTEXT SIDEBAR
          =========================================================== -->
          <aside
            class="waste-context"
            aria-label="Ringkasan dan panduan sampah organisasi"
            data-waste-sidebar
          >
            <section class="context-card context-card--highlight">
              <div
                class="context-card__icon"
                aria-hidden="true"
              >
                <Recycle
                  size={20}
                  stroke-width={2}
                />
              </div>

              <span class="context-card__eyebrow">
                RINGKASAN
              </span>

              <h2>
                Cakupan sampah organisasi
              </h2>

              <div class="summary-number">
                <strong data-sidebar-count>
                  0
                </strong>

                <span>
                  material dipilih
                </span>
              </div>

              <div
                class="summary-rule"
                aria-hidden="true"
              ></div>

              <p>
                Pilih material yang benar-benar diterima, ditangani, atau
                dikelola oleh organisasi.
              </p>
            </section>

            <section class="context-card">
              <span class="context-card__eyebrow">
                PRINSIP DATA
              </span>

              <h2>
                Jadilah spesifik
              </h2>

              <div class="sidebar-check-list">
                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Pilih material yang benar-benar ditangani
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Jelaskan cakupan pengelolaan secara wajar
                  </span>
                </div>

                <div class="sidebar-check">
                  <CircleCheck
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <span>
                    Hindari klaim yang belum diverifikasi
                  </span>
                </div>
              </div>
            </section>

            <section class="context-card context-card--warning">
              <div
                class="context-warning__icon"
                aria-hidden="true"
              >
                <TriangleAlert
                  size={18}
                  stroke-width={2}
                />
              </div>

              <div>
                <span class="context-card__eyebrow">
                  PERHATIAN
                </span>

                <strong>
                  Jangan memperluas klaim
                </strong>

                <p>
                  Material yang dipilih sebaiknya mencerminkan aktivitas
                  pengelolaan organisasi saat ini.
                </p>
              </div>
            </section>

            <section class="context-card context-card--next">
              <span class="context-card__eyebrow">
                LANJUTKAN
              </span>

              <h2>
                Lengkapi informasi organisasi
              </h2>

              <a href="/organization/process">
                <span>
                  Kelola proses
                </span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/products">
                <span>
                  Kelola produk
                </span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>

              <a href="/organization/profile">
                <span>
                  Kembali ke profil
                </span>

                <ArrowRight
                  size={16}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
            </section>
          </aside>
        </div>
      </div>
    </section>
  </div>
</OrganizationLayout>

<style>
  /* ==========================================================================
     PAGE ROOT
     ========================================================================== */

  .organization-waste-page {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --muted-dark: #50554d;
    --orange: #ff6a00;
    --line: #b7b8ad;
    --danger: #b43d00;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    min-height: 100%;

    color: var(--ink);
    background: var(--paper);

    overflow-x: hidden;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .organization-waste-page *,
  .organization-waste-page *::before,
  .organization-waste-page *::after {
    box-sizing: border-box;
  }

  .organization-waste-page
    a,
  .organization-waste-page
    button,
  .organization-waste-page
    input,
  .organization-waste-page
    textarea {
    -webkit-tap-highlight-color: transparent;
  }

  .organization-waste-page
    button:focus-visible,
  .organization-waste-page
    a:focus-visible,
  .organization-waste-page
    input:focus-visible,
  .organization-waste-page
    textarea:focus-visible {
    outline:
      3px solid
      var(--orange);

    outline-offset:
      4px;
  }

  .sr-only {
    position: absolute;

    width: 1px;
    height: 1px;

    padding: 0;
    margin: -1px;

    overflow: hidden;

    clip: rect(
      0,
      0,
      0,
      0
    );

    white-space: nowrap;

    border: 0;
  }

  /* ==========================================================================
     PAGE
     ========================================================================== */

  .waste-page {
    width: 100%;
    max-width: 100%;

    min-width: 0;

    padding:
      26px
      26px
      72px;

    overflow-x: hidden;

    background:
      radial-gradient(
        circle at 92% 2%,
        rgb(223 255 0 / 8%),
        transparent 23%
      ),
      var(--paper);
  }

  .waste-page__container {
    width:
      min(
        1240px,
        100%
      );

    max-width:
      100%;

    margin-inline:
      auto;
  }

  /* ==========================================================================
     HERO
     ========================================================================== */

  .waste-hero {
    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(245px, 300px);

    gap:
      26px;

    padding:
      28px;

    border:
      3px solid
      var(--ink);

    background:
      var(--ink);

    color:
      var(--white);

    box-shadow:
      7px 7px 0
      var(--orange);
  }

