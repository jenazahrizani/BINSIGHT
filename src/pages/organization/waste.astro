</style>

<script>
// @ts-nocheck

  const materialSearch =
    document.querySelector(
      "[data-material-search]",
    );

  const materialOptions =
    Array.from(
      document.querySelectorAll(
        "[data-material-option]",
      ),
    );

  const categoryButtons =
    Array.from(
      document.querySelectorAll(
        "[data-category-filter]",
      ),
    );

  const materialEmpty =
    document.querySelector(
      "[data-material-empty]",
    );

  const selectedCount =
    document.querySelector(
      "[data-selected-count]",
    );

  const sidebarCount =
    document.querySelector(
      "[data-sidebar-count]",
    );

  const descriptionField =
    document.querySelector(
      "[data-management-description]",
    );

  const descriptionCounter =
    document.querySelector(
      "[data-management-description-counter]",
    );

  const saveButton =
    document.querySelector(
      "[data-save-waste]",
    );

  const saveLabel =
    document.querySelector(
      "[data-save-label]",
    );

  const saveMessage =
    document.querySelector(
      "[data-save-message]",
    );

  const saveSuccess =
    document.querySelector(
      "[data-save-success]",
    );

  const editWasteButton =
    document.querySelector(
      "[data-edit-waste]",
    );

  let activeCategory = "all";

  function getSelectedMaterials() {
    return materialOptions
      .filter(
        (option) => {
          const checkbox =
            option.querySelector(
              "[data-material-checkbox]",
            );

          return (
            checkbox instanceof
              HTMLInputElement &&
            checkbox.checked
          );
        },
      )
      .map(
        (option) =>
          option.getAttribute(
            "data-material-id",
          ) ?? "",
      )
      .filter(Boolean);
  }

  function updateSelectedCount() {
    const selected =
      getSelectedMaterials();

    const count =
      selected.length;

    if (
      selectedCount instanceof HTMLElement
    ) {
      selectedCount.textContent =
        `${count} material${count === 1 ? "" : "s"}`;
    }

    if (
      sidebarCount instanceof HTMLElement
    ) {
      sidebarCount.textContent =
        String(count);
    }

    updateCategorySummary();
  }

  function updateCategorySummary() {
    const summaryElements =
      Array.from(
        document.querySelectorAll(
          "[data-summary-category]",
        ),
      );

    summaryElements.forEach(
      (summaryElement) => {
        const category =
          summaryElement.getAttribute(
            "data-summary-category",
          );

        if (!category) {
          return;
        }

        const count =
          materialOptions.filter(
            (option) => {
              const optionCategory =
                option.getAttribute(
                  "data-material-category",
                );

              const checkbox =
                option.querySelector(
                  "[data-material-checkbox]",
                );

              return (
                optionCategory === category &&
                checkbox instanceof
                  HTMLInputElement &&
                checkbox.checked
              );
            },
          ).length;

        const countElement =
          summaryElement.querySelector(
            `[data-summary-count="${category}"]`,
          );

        if (
          countElement instanceof
          HTMLElement
        ) {
          countElement.textContent =
            `${count} material${count === 1 ? "" : "s"}`;
        }
      },
    );
  }

  function updateMaterialVisibility() {
    const searchValue =
      materialSearch instanceof
      HTMLInputElement
        ? materialSearch.value
            .trim()
            .toLowerCase()
        : "";

    let visibleCount = 0;

    materialOptions.forEach(
      (option) => {
        const category =
          option.getAttribute(
            "data-material-category",
          );

        const label =
          option.getAttribute(
            "data-material-label",
          ) ?? "";

        const matchesCategory =
          activeCategory === "all" ||
          category === activeCategory;

        const matchesSearch =
          searchValue === "" ||
          label.includes(
            searchValue,
          );

        const visible =
          matchesCategory &&
          matchesSearch;

        option.hidden =
          !visible;

        if (visible) {
          visibleCount += 1;
        }
      },
    );

    if (
      materialEmpty instanceof HTMLElement
    ) {
      materialEmpty.hidden =
        visibleCount !== 0;
    }
  }

  function updateCategoryButtons() {
    categoryButtons.forEach(
      (button) => {
        const category =
          button.getAttribute(
            "data-category-filter",
          );

        const active =
          category === activeCategory;

        button.classList.toggle(
          "category-filter__button--active",
          active,
        );

        button.setAttribute(
          "aria-selected",
          active ? "true" : "false",
        );
      },
    );
  }

  function updateDescriptionCounter() {
    if (
      !(descriptionField instanceof HTMLTextAreaElement) ||
      !(descriptionCounter instanceof HTMLElement)
    ) {
      return;
    }

    descriptionCounter.textContent =
      `${descriptionField.value.length} / 1800`;
  }

  function validateWasteData() {
    const selected =
      getSelectedMaterials();

    if (selected.length === 0) {
      if (
        selectedCount instanceof HTMLElement
      ) {
        selectedCount.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
      }

      return false;
    }

    if (
      descriptionField instanceof HTMLTextAreaElement
    ) {
      const description =
        descriptionField.value.trim();

      if (
        description.length > 0 &&
        description.length < 20
      ) {
        descriptionField.setAttribute(
          "aria-invalid",
          "true",
        );

        descriptionField.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        descriptionField.focus();

        if (
          saveMessage instanceof HTMLElement
        ) {
          saveMessage.textContent =
            "Deskripsi pengelolaan yang diisi minimal 20 karakter.";

          saveMessage.hidden = false;
        }

        return false;
      }

      descriptionField.removeAttribute(
        "aria-invalid",
      );
    }

    return true;
  }

  function buildWastePayload() {
    return {
      materials:
        getSelectedMaterials(),

      managementDescription:
        descriptionField instanceof
        HTMLTextAreaElement
          ? descriptionField.value.trim()
          : "",

      updatedAt:
        new Date().toISOString(),
    };
  }

  async function saveWasteData() {
    if (!validateWasteData()) {
      return;
    }

    const payload =
      buildWastePayload();

    if (
      saveButton instanceof HTMLButtonElement
    ) {
      saveButton.disabled = true;
    }

    if (
      saveLabel instanceof HTMLElement
    ) {
      saveLabel.textContent =
        "Menyiapkan...";
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.textContent =
        "Memeriksa informasi...";
      saveMessage.hidden = false;
    }

    await Promise.resolve();

    window.dispatchEvent(
      new CustomEvent(
        "binsight:organization-waste-save",
        {
          detail: payload,
        },
      ),
    );

    const formSections =
      Array.from(
        document.querySelectorAll(
          ".waste-card",
        ),
      );

    formSections.forEach(
      (section) => {
        section.hidden = true;
      },
    );

    const sidebar =
      document.querySelector(
        ".waste-sidebar",
      );

    if (
      sidebar instanceof HTMLElement
    ) {
      sidebar.hidden = true;
    }

    if (
      saveSuccess instanceof HTMLElement
    ) {
      saveSuccess.hidden = false;

      saveSuccess.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.hidden = true;
    }
  }

  function restoreEditor() {
    const formSections =
      Array.from(
        document.querySelectorAll(
          ".waste-card",
        ),
      );

    formSections.forEach(
      (section) => {
        section.hidden = false;
      },
    );

    const sidebar =
      document.querySelector(
        ".waste-sidebar",
      );

    if (
      sidebar instanceof HTMLElement
    ) {
      sidebar.hidden = false;
    }

    if (
      saveSuccess instanceof HTMLElement
    ) {
      saveSuccess.hidden = true;
    }

    if (
      saveButton instanceof HTMLButtonElement
    ) {
      saveButton.disabled = false;
    }

    if (
      saveLabel instanceof HTMLElement
    ) {
      saveLabel.textContent =
        "Simpan informasi";
    }

    if (
      saveMessage instanceof HTMLElement
    ) {
      saveMessage.textContent = "";
      saveMessage.hidden = true;
    }
  }

  materialSearch?.addEventListener(
    "input",
    updateMaterialVisibility,
  );

  categoryButtons.forEach(
    (button) => {
      button.addEventListener(
        "click",
        () => {
          activeCategory =
            button.getAttribute(
              "data-category-filter",
            ) ?? "all";

          updateCategoryButtons();
          updateMaterialVisibility();
        },
      );
    },
  );

  materialOptions.forEach(
    (option) => {
      const checkbox =
        option.querySelector(
          "[data-material-checkbox]",
        );

      checkbox?.addEventListener(
        "change",
        updateSelectedCount,
      );
    },
  );

  descriptionField?.addEventListener(
    "input",
    updateDescriptionCounter,
  );

  saveButton?.addEventListener(
    "click",
    saveWasteData,
  );

  editWasteButton?.addEventListener(
    "click",
    restoreEditor,
  );

  updateSelectedCount();
  updateCategoryButtons();
  updateMaterialVisibility();
  updateDescriptionCounter();
</script>