---
/**
 * BINSIGHT — DASHBOARD LAYOUT
 * --------------------------------------------------------------------------
 * Layout khusus untuk halaman dashboard / data intelligence BINSIGHT.
 *
 * Responsibilities:
 * - Dashboard page metadata
 * - Accessible skip link
 * - Compact dashboard header
 * - Navigation context
 * - Main dashboard content slot
 * - Optional dashboard actions
 * - Footer
 * - Lightweight scroll progress
 *
 * Intended pages:
 * - /dashboard
 * - Future dashboard sub-pages
 *
 * Important:
 * - This is NOT the admin layout.
 * - This is NOT the organization workspace layout.
 * - No Firebase / Leaflet / business logic is initialized here.
 * --------------------------------------------------------------------------
 */

import {
  Activity,
  BarChart3,
  ChevronRight,
  LayoutDashboard,
  Map,
  Recycle,
  Building2,
  FileWarning,
  Menu,
  X,
} from "@lucide/astro";

import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: Breadcrumb[];
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title = "Dashboard Data",
  description = "Gambaran data dan insight ekosistem persampahan Kabupaten Badung.",
  breadcrumbs = [
    {
      label: "Beranda",
      href: "/",
    },
    {
      label: "Dashboard",
    },
  ],
  bodyClass = "",
  noindex = false,
} = Astro.props;

const siteUrl =
  import.meta.env.PUBLIC_SITE_URL ||
  Astro.site?.toString() ||
  "https://binsight.id";

const appName =
  import.meta.env.PUBLIC_APP_NAME ||
  "BINSIGHT";

const absoluteUrl = (
  value: string
): string => {
  if (
    value.startsWith("http://") ||
    value.startsWith("https://")
  ) {
    return value;
  }

  return new URL(
    value.startsWith("/") ? value : `/${value}`,
    siteUrl
  ).toString();
};

const canonicalUrl = absoluteUrl(
  Astro.url.pathname
);

const fullTitle =
  title.startsWith("BINSIGHT")
    ? title
    : `${title} — BINSIGHT`;

const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#166534"
    />

    <meta
      name="color-scheme"
      content="light dark"
    />

    <meta
      name="application-name"
      content={appName}
    />

    <meta
      name="robots"
      content={robotsContent}
    />

    <meta
      name="googlebot"
      content={robotsContent}
    />

    <title>{fullTitle}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />

    <link
      rel="apple-touch-icon"
      href="/images/logo.svg"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="BINSIGHT"
    />

    <meta
      property="og:locale"
      content="id_ID"
    />

    <meta
      property="og:title"
      content={fullTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:image"
      content={absoluteUrl("/images/logo.svg")}
    />

    <meta
      property="og:image:alt"
      content={fullTitle}
    />

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={fullTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={absoluteUrl("/images/logo.svg")}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        url: canonicalUrl,
        description,
        inLanguage: "id-ID",
        isPartOf: {
          "@type": "WebSite",
          name: "BINSIGHT",
          url: siteUrl,
        },
      })}
    />

    <slot name="head" />
  </head>

  <body
    class:list={[
      "dashboard-layout",
      bodyClass,
    ]}
  >
    <a
      class="dashboard-layout__skip-link"
      href="#dashboard-main-content"
    >
      Lewati ke dashboard
    </a>

    <div class="dashboard-layout__shell">
      <Navbar />

      <div class="dashboard-layout__workspace">
        <aside
          class="dashboard-layout__sidebar"
          id="dashboard-sidebar"
          aria-label="Navigasi dashboard"
          data-dashboard-sidebar
        >
          <div class="dashboard-layout__sidebar-inner">
            <div class="dashboard-layout__sidebar-heading">
              <div class="dashboard-layout__sidebar-title">
                <span class="dashboard-layout__sidebar-title-icon">
                  <LayoutDashboard
                    size={17}
                    strokeWidth={2}
                    aria-hidden="true"
                  />
                </span>

                <span>Dashboard</span>
              </div>

              <span class="dashboard-layout__sidebar-status">
                Data publik
              </span>
            </div>

            <nav
              class="dashboard-layout__nav"
              aria-label="Menu dashboard"
            >
              <a
                href="/dashboard"
                class="dashboard-layout__nav-item dashboard-layout__nav-item--active"
                aria-current="page"
              >
                <span class="dashboard-layout__nav-icon">
                  <BarChart3
                    size={17}
                    strokeWidth={1.9}
                    aria-hidden="true"
                  />
                </span>

                <span class="dashboard-layout__nav-copy">
                  <strong>Ringkasan</strong>
                  <small>Overview ekosistem</small>
                </span>
              </a>

              <a
                href="/map"
                class="dashboard-layout__nav-item"
              >
                <span class="dashboard-layout__nav-icon">
                  <Map
                    size={17}
                    strokeWidth={1.9}
                    aria-hidden="true"
                  />
                </span>

                <span class="dashboard-layout__nav-copy">
                  <strong>Peta</strong>
                  <small>Lokasi & organisasi</small>
                </span>
              </a>

              <a
                href="/organizations"
                class="dashboard-layout__nav-item"
              >
                <span class="dashboard-layout__nav-icon">
                  <Building2
                    size={17}
                    strokeWidth={1.9}
                    aria-hidden="true"
                  />
                </span>

                <span class="dashboard-layout__nav-copy">
                  <strong>Organisasi</strong>
                  <small>Pengelola persampahan</small>
                </span>
              </a>

              <a
                href="/waste"
                class="dashboard-layout__nav-item"
              >
                <span class="dashboard-layout__nav-icon">
                  <Recycle
                    size={17}
                    strokeWidth={1.9}
                    aria-hidden="true"
                  />
                </span>

                <span class="dashboard-layout__nav-copy">
                  <strong>Jenis Sampah</strong>
                  <small>Kategori & pengelolaan</small>
                </span>
              </a>

              <a
                href="/reports"
                class="dashboard-layout__nav-item"
              >
                <span class="dashboard-layout__nav-icon">
                  <FileWarning
                    size={17}
                    strokeWidth={1.9}
                    aria-hidden="true"
                  />
                </span>

                <span class="dashboard-layout__nav-copy">
                  <strong>Laporan</strong>
                  <small>Aktivitas masyarakat</small>
                </span>
              </a>
            </nav>

            <div class="dashboard-layout__sidebar-divider"></div>

            <div class="dashboard-layout__sidebar-note">
              <span class="dashboard-layout__sidebar-note-icon">
                <Activity
                  size={15}
                  strokeWidth={2}
                  aria-hidden="true"
                />
              </span>

              <div>
                <strong>Live ecosystem view</strong>
                <p>
                  Data ditampilkan berdasarkan informasi
                  yang tersedia di BINSIGHT.
                </p>
              </div>
            </div>
          </div>
        </aside>

        <div class="dashboard-layout__content">
          <header class="dashboard-layout__header">
            <div class="dashboard-layout__header-container">
              <button
                type="button"
                class="dashboard-layout__mobile-toggle"
                aria-expanded="false"
                aria-controls="dashboard-sidebar"
                aria-label="Buka navigasi dashboard"
                data-dashboard-sidebar-toggle
              >
                <Menu
                  class="dashboard-layout__mobile-menu-icon"
                  size={20}
                  strokeWidth={2}
                  aria-hidden="true"
                />

                <X
                  class="dashboard-layout__mobile-close-icon"
                  size={20}
                  strokeWidth={2}
                  aria-hidden="true"
                />
              </button>

              <div class="dashboard-layout__header-main">
                <nav
                  class="dashboard-layout__breadcrumbs"
                  aria-label="Breadcrumb dashboard"
                >
                  <ol class="dashboard-layout__breadcrumb-list">
                    {
                      breadcrumbs.map(
                        (breadcrumb, index) => {
                          const isLast =
                            index ===
                            breadcrumbs.length - 1;

                          return (
                            <li class="dashboard-layout__breadcrumb-item">
                              {
                                breadcrumb.href &&
                                !isLast ? (
                                  <a
                                    href={
                                      breadcrumb.href
                                    }
                                    class="dashboard-layout__breadcrumb-link"
                                  >
                                    {
                                      breadcrumb.label
                                    }
                                  </a>
                                ) : (
                                  <span
                                    class="dashboard-layout__breadcrumb-current"
                                    aria-current={
                                      isLast
                                        ? "page"
                                        : undefined
                                    }
                                  >
                                    {
                                      breadcrumb.label
                                    }
                                  </span>
                                )
                              }

                              {
                                !isLast && (
                                  <ChevronRight
                                    size={13}
                                    strokeWidth={1.8}
                                    aria-hidden="true"
                                  />
                                )
                              }
                            </li>
                          );
                        }
                      )
                    }
                  </ol>
                </nav>

                <div class="dashboard-layout__title-row">
                  <div>
                    <p class="dashboard-layout__eyebrow">
                      BINSIGHT DATA INTELLIGENCE
                    </p>

                    <h1 class="dashboard-layout__title">
                      {title}
                    </h1>

                    <p class="dashboard-layout__description">
                      {description}
                    </p>
                  </div>

                  <div class="dashboard-layout__header-actions">
                    <slot name="actions" />
                  </div>
                </div>
              </div>
            </div>
          </header>

          <main
            id="dashboard-main-content"
            class="dashboard-layout__main"
            tabindex="-1"
          >
            <div class="dashboard-layout__main-container">
              <slot />
            </div>
          </main>

          <Footer />
        </div>
      </div>
    </div>

    <div
      class="dashboard-layout__backdrop"
      data-dashboard-backdrop
      aria-hidden="true"
    ></div>

    <div
      class="dashboard-layout__scroll-progress"
      data-dashboard-progress
      aria-hidden="true"
    ></div>

    <script>
      const dashboardRoot =
        document.querySelector<HTMLElement>(
          ".dashboard-layout"
        );

      if (dashboardRoot) {
        const sidebar =
          dashboardRoot.querySelector<HTMLElement>(
            "[data-dashboard-sidebar]"
          );

        const sidebarToggle =
          dashboardRoot.querySelector<HTMLButtonElement>(
            "[data-dashboard-sidebar-toggle]"
          );

        const backdrop =
          dashboardRoot.querySelector<HTMLElement>(
            "[data-dashboard-backdrop]"
          );

        const progress =
          dashboardRoot.querySelector<HTMLElement>(
            "[data-dashboard-progress]"
          );

        const openSidebar = () => {
          if (!sidebar || !sidebarToggle) return;

          sidebar.classList.add(
            "dashboard-layout__sidebar--open"
          );

          dashboardRoot.classList.add(
            "dashboard-layout--sidebar-open"
          );

          sidebarToggle.setAttribute(
            "aria-expanded",
            "true"
          );

          sidebarToggle.setAttribute(
            "aria-label",
            "Tutup navigasi dashboard"
          );

          document.documentElement.classList.add(
            "dashboard-scroll-locked"
          );

          document.body.classList.add(
            "dashboard-scroll-locked"
          );
        };

        const closeSidebar = () => {
          if (!sidebar || !sidebarToggle) return;

          sidebar.classList.remove(
            "dashboard-layout__sidebar--open"
          );

          dashboardRoot.classList.remove(
            "dashboard-layout--sidebar-open"
          );

          sidebarToggle.setAttribute(
            "aria-expanded",
            "false"
          );

          sidebarToggle.setAttribute(
            "aria-label",
            "Buka navigasi dashboard"
          );

          document.documentElement.classList.remove(
            "dashboard-scroll-locked"
          );

          document.body.classList.remove(
            "dashboard-scroll-locked"
          );
        };

        sidebarToggle?.addEventListener(
          "click",
          () => {
            const isOpen =
              sidebar?.classList.contains(
                "dashboard-layout__sidebar--open"
              ) ?? false;

            if (isOpen) {
              closeSidebar();
            } else {
              openSidebar();
            }
          }
        );

        backdrop?.addEventListener(
          "click",
          closeSidebar
        );

        sidebar
          ?.querySelectorAll("a")
          .forEach((link) => {
            link.addEventListener(
              "click",
              () => {
                closeSidebar();
              }
            );
          });

        document.addEventListener(
          "keydown",
          (event) => {
            if (event.key === "Escape") {
              closeSidebar();
            }
          }
        );

        window.addEventListener(
          "resize",
          () => {
            if (window.innerWidth > 1000) {
              closeSidebar();
            }
          }
        );

        const updateProgress = () => {
          if (!progress) return;

          const documentHeight =
            document.documentElement.scrollHeight -
            window.innerHeight;

          if (documentHeight <= 0) {
            progress.style.transform =
              "scaleX(0)";

            return;
          }

          const scrollRatio =
            Math.min(
              Math.max(
                window.scrollY /
                  documentHeight,
                0
              ),
              1
            );

          progress.style.transform =
            `scaleX(${scrollRatio})`;
        };

        updateProgress();

        window.addEventListener(
          "scroll",
          updateProgress,
          { passive: true }
        );

        window.addEventListener(
          "resize",
          updateProgress,
          { passive: true }
        );
      }
    </script>
  </body>
</html>

<style>
  .dashboard-layout {
    min-height: 100vh;

    margin: 0;

    color: var(--color-text);
    background: var(--color-background);
  }

  .dashboard-layout__shell {
    min-height: 100vh;

    display: flex;
    flex-direction: column;
  }

  .dashboard-layout__workspace {
    position: relative;

    min-height: 0;
    flex: 1 1 auto;

    display: flex;
    align-items: stretch;
  }

  .dashboard-layout__sidebar {
    position: sticky;
    top: 76px;

    width: 258px;
    min-width: 258px;
    height: calc(100vh - 76px);

    align-self: flex-start;

    overflow-y: auto;

    border-right: 1px solid var(--color-border);

    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.98),
        rgba(248, 250, 252, 0.96)
      );
  }

  .dashboard-layout__sidebar-inner {
    padding: 24px 14px 28px;
  }

  .dashboard-layout__sidebar-heading {
    padding: 2px 8px 15px;
  }

  .dashboard-layout__sidebar-title {
    display: flex;
    align-items: center;
    gap: 8px;

    color: var(--color-text);

    font-size: 0.84rem;
    font-weight: 850;
  }

  .dashboard-layout__sidebar-title-icon {
    width: 30px;
    height: 30px;

    display: grid;
    place-items: center;

    border-radius: 8px;

    color: var(--color-primary-dark);
    background: var(--color-primary-light);
  }

  .dashboard-layout__sidebar-status {
    display: inline-flex;

    margin-top: 8px;

    color: var(--color-secondary);

    font-size: 0.65rem;
    font-weight: 650;
  }

  .dashboard-layout__nav {
    display: grid;
    gap: 3px;
  }

  .dashboard-layout__nav-item {
    position: relative;

    display: flex;
    align-items: center;
    gap: 10px;

    min-height: 52px;
    padding: 7px 9px;

    border: 1px solid transparent;
    border-radius: 11px;

    color: var(--color-secondary);
    background: transparent;

    text-decoration: none;

    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .dashboard-layout__nav-item:hover {
    color: var(--color-primary-dark);
    background: var(--color-primary-light);
  }

  .dashboard-layout__nav-item--active {
    color: var(--color-primary-dark);
    background: var(--color-primary-light);
    border-color: rgba(
      22,
      101,
      52,
      0.09
    );
  }

  .dashboard-layout__nav-item--active::before {
    content: "";

    position: absolute;
    top: 9px;
    bottom: 9px;
    left: -14px;

    width: 3px;

    border-radius: 0 999px 999px 0;

    background: var(--color-primary);
  }

  .dashboard-layout__nav-icon {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;
    flex-shrink: 0;

    border-radius: 9px;

    color: currentColor;
    background: rgba(
      226,
      232,
      240,
      0.55
    );
  }

  .dashboard-layout__nav-item--active
    .dashboard-layout__nav-icon {
    background: rgba(
      255,
      255,
      255,
      0.78
    );
  }

  .dashboard-layout__nav-copy {
    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .dashboard-layout__nav-copy strong {
    color: currentColor;

    font-size: 0.77rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .dashboard-layout__nav-copy small {
    color: var(--color-secondary);

    font-size: 0.64rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .dashboard-layout__sidebar-divider {
    height: 1px;

    margin: 21px 8px;

    background: var(--color-border);
  }

  .dashboard-layout__sidebar-note {
    display: flex;
    align-items: flex-start;
    gap: 9px;

    margin: 0 5px;
    padding: 11px;

    border: 1px solid rgba(
      22,
      101,
      52,
      0.08
    );
    border-radius: 11px;

    background: rgba(
      220,
      252,
      231,
      0.38
    );
  }

  .dashboard-layout__sidebar-note-icon {
    width: 29px;
    height: 29px;

    display: grid;
    place-items: center;
    flex-shrink: 0;

    border-radius: 8px;

    color: var(--color-primary-dark);
    background: rgba(
      255,
      255,
      255,
      0.85
    );
  }

  .dashboard-layout__sidebar-note strong {
    display: block;

    color: var(--color-primary-dark);

    font-size: 0.66rem;
    font-weight: 850;
    line-height: 1.3;
  }

  .dashboard-layout__sidebar-note p {
    margin: 4px 0 0;

    color: var(--color-secondary);

    font-size: 0.61rem;
    line-height: 1.55;
  }

  .dashboard-layout__content {
    min-width: 0;
    flex: 1 1 auto;

    display: flex;
    flex-direction: column;
  }

  .dashboard-layout__header {
    position: relative;
    z-index: 5;

    border-bottom: 1px solid var(--color-border);

    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.98),
        rgba(248, 250, 252, 0.96)
      );
  }

  .dashboard-layout__header-container {
    width: min(
      calc(100% - 48px),
      var(--container-xl, 1280px)
    );

    margin-inline: auto;

    padding: 22px 0 26px;
  }

  .dashboard-layout__mobile-toggle {
    display: none;
  }

  .dashboard-layout__breadcrumbs {
    margin-bottom: 15px;
  }

  .dashboard-layout__breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 3px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .dashboard-layout__breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: 3px;

    min-width: 0;

    color: var(--color-secondary);
  }

  .dashboard-layout__breadcrumb-link,
  .dashboard-layout__breadcrumb-current {
    max-width: 260px;

    overflow: hidden;

    color: inherit;

    font-size: 0.67rem;
    font-weight: 650;
    line-height: 1.35;

    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard-layout__breadcrumb-link {
    transition: color 160ms ease;
  }

  .dashboard-layout__breadcrumb-link:hover {
    color: var(--color-primary-dark);
  }

  .dashboard-layout__breadcrumb-current {
    color: var(--color-text);
    font-weight: 750;
  }

  .dashboard-layout__title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 28px;
  }

  .dashboard-layout__eyebrow {
    margin: 0 0 8px;

    color: var(--color-primary);

    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1;

    letter-spacing: 0.11em;
  }

  .dashboard-layout__title {
    margin: 0;

    color: var(--color-text);

    font-size: clamp(
      1.55rem,
      2.7vw,
      2.2rem
    );

    font-weight: 900;
    line-height: 1.08;

    letter-spacing: -0.03em;
  }

  .dashboard-layout__description {
    max-width: 720px;

    margin: 9px 0 0;

    color: var(--color-secondary);

    font-size: 0.83rem;
    font-weight: 500;
    line-height: 1.65;
  }

  .dashboard-layout__header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    flex-shrink: 0;

    gap: 8px;
  }

  .dashboard-layout__main {
    min-width: 0;
    flex: 1 1 auto;

    outline: none;
  }

  .dashboard-layout__main:focus {
    outline: none;
  }

  .dashboard-layout__main-container {
    width: min(
      calc(100% - 48px),
      var(--container-xl, 1280px)
    );

    margin-inline: auto;

    padding: 30px 0 50px;
  }

  .dashboard-layout__backdrop {
    display: none;
  }

  .dashboard-layout__skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 2200;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;
    padding: 0 15px;

    border: 1px solid var(--color-primary);
    border-radius: 9px;

    color: #ffffff;
    background: var(--color-primary);

    box-shadow: var(--shadow-lg);

    font-size: 0.8rem;
    font-weight: 800;

    text-decoration: none;

