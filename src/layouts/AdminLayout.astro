---
/**
 * BINSIGHT — ADMIN LAYOUT
 * --------------------------------------------------------------------------
 * Internal administration workspace for BINSIGHT.
 *
 * Responsibilities:
 * - Internal admin shell
 * - Admin sidebar navigation
 * - System / verification context
 * - Breadcrumbs
 * - Page title / description
 * - Header actions slot
 * - Responsive mobile navigation
 * - Footer
 * - Lightweight UI behavior
 *
 * Intended pages:
 * - /admin
 * - /admin/organizations
 * - /admin/locations
 * - /admin/waste
 * - /admin/reports
 * - /admin/users
 * - /admin/content
 *
 * Security note:
 * - This layout is UI infrastructure only.
 * - It does NOT replace authentication / authorization.
 * - Access control belongs to src/lib/auth/*
 * - Firebase Security Rules remain authoritative.
 * --------------------------------------------------------------------------
 */

import {
  Activity,
  BellRing,
  Building2,
  ChartColumn,
  ChevronRight,
  CircleCheck,
  LayoutDashboard,
  LockKeyhole,
  MapPin,
  Menu,
  Newspaper,
  Recycle,
  ShieldCheck,
  TriangleAlert,
  Users,
  X,
} from "@lucide/astro";

import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";

type AdminSection =
  | "overview"
  | "organizations"
  | "locations"
  | "waste"
  | "reports"
  | "users"
  | "content";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: Breadcrumb[];
  activeSection?: AdminSection;
  adminName?: string;
  adminInitials?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title = "Admin Dashboard",
  description = "Kelola data, verifikasi, konten, dan aktivitas platform BINSIGHT.",
  breadcrumbs = [
    {
      label: "Admin",
      href: "/admin",
    },
    {
      label: "Dashboard",
    },
  ],
  activeSection = "overview",
  adminName = "Administrator",
  adminInitials = "AD",
  bodyClass = "",
  noindex = true,
} = Astro.props;

const siteUrl =
  import.meta.env.PUBLIC_SITE_URL ||
  Astro.site?.toString() ||
  "https://binsight.id";

const appName =
  import.meta.env.PUBLIC_APP_NAME ||
  "BINSIGHT";

const absoluteUrl = (
  value: string
): string => {
  if (
    value.startsWith("http://") ||
    value.startsWith("https://")
  ) {
    return value;
  }

  return new URL(
    value.startsWith("/")
      ? value
      : `/${value}`,
    siteUrl
  ).toString();
};

const canonicalUrl = absoluteUrl(
  Astro.url.pathname
);

const fullTitle =
  title.startsWith("BINSIGHT")
    ? title
    : `${title} — BINSIGHT`;

const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow";

const navItems: Array<{
  id: AdminSection;
  label: string;
  description: string;
  href: string;
  icon: typeof LayoutDashboard;
}> = [
  {
    id: "overview",
    label: "Ringkasan",
    description: "Overview platform",
    href: "/admin",
    icon: LayoutDashboard,
  },
  {
    id: "organizations",
    label: "Organisasi",
    description: "Verifikasi & kelola",
    href: "/admin/organizations",
    icon: Building2,
  },
  {
    id: "locations",
    label: "Lokasi",
    description: "Wilayah & titik",
    href: "/admin/locations",
    icon: MapPin,
  },
  {
    id: "waste",
    label: "Sampah",
    description: "Kategori & data",
    href: "/admin/waste",
    icon: Recycle,
  },
  {
    id: "reports",
    label: "Laporan",
    description: "Tinjau & tindak lanjut",
    href: "/admin/reports",
    icon: TriangleAlert,
  },
  {
    id: "users",
    label: "Pengguna",
    description: "Akun & akses",
    href: "/admin/users",
    icon: Users,
  },
  {
    id: "content",
    label: "Konten",
    description: "Edukasi & informasi",
    href: "/admin/content",
    icon: Newspaper,
  },
];

const managementLinks = [
  {
    label: "Dashboard Publik",
    href: "/dashboard",
    icon: ChartColumn,
  },
  {
    label: "Lihat Peta",
    href: "/map",
    icon: MapPin,
  },
];

const isActive = (
  section: AdminSection
): boolean => {
  return activeSection === section;
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#0F172A"
    />

    <meta
      name="color-scheme"
      content="light dark"
    />

    <meta
      name="application-name"
      content={appName}
    />

    <meta
      name="robots"
      content={robotsContent}
    />

    <meta
      name="googlebot"
      content={robotsContent}
    />

    <title>{fullTitle}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />

    <link
      rel="apple-touch-icon"
      href="/images/logo.svg"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="BINSIGHT"
    />

    <meta
      property="og:locale"
      content="id_ID"
    />

    <meta
      property="og:title"
      content={fullTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:image"
      content={absoluteUrl("/images/logo.svg")}
    />

    <meta
      property="og:image:alt"
      content={fullTitle}
    />

    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={fullTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={absoluteUrl("/images/logo.svg")}
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        url: canonicalUrl,
        description,
        inLanguage: "id-ID",
        isPartOf: {
          "@type": "WebSite",
          name: "BINSIGHT",
          url: siteUrl,
        },
      })}
    />

    <slot name="head" />
  </head>

  <body
    class:list={[
      "admin-layout",
      bodyClass,
    ]}
  >
    <a
      class="admin-layout__skip-link"
      href="#admin-main-content"
    >
      Lewati ke konten admin
    </a>

    <div class="admin-layout__shell">
      <Navbar />

      <div class="admin-layout__workspace">
        <aside
          id="admin-sidebar"
          class="admin-layout__sidebar"
          data-admin-sidebar
          aria-label="Navigasi administrasi"
        >
          <div class="admin-layout__sidebar-inner">
            <div class="admin-layout__system-heading">
              <div class="admin-layout__system-title">
                <span class="admin-layout__system-icon">
                  <ShieldCheck
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </span>

                <span>Admin BINSIGHT</span>
              </div>

              <span class="admin-layout__system-badge">
                INTERNAL
              </span>
            </div>

            <div class="admin-layout__admin-card">
              <div
                class="admin-layout__admin-avatar"
                aria-hidden="true"
              >
                {adminInitials}
              </div>

              <div class="admin-layout__admin-copy">
                <strong>{adminName}</strong>

                <span>
                  <LockKeyhole
                    size={12}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  Administrator
                </span>
              </div>
            </div>

            <nav
              class="admin-layout__nav"
              aria-label="Menu administrasi"
            >
              <p class="admin-layout__nav-label">
                Manajemen platform
              </p>

              {
                navItems.map((item) => {
                  const active =
                    isActive(item.id);

                  return (
                    <a
                      href={item.href}
                      class:list={[
                        "admin-layout__nav-item",
                        {
                          "admin-layout__nav-item--active":
                            active,
                        },
                      ]}
                      aria-current={
                        active
                          ? "page"
                          : undefined
                      }
                    >
                      <span class="admin-layout__nav-icon">
                        <item.icon
                          size={17}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </span>

                      <span class="admin-layout__nav-copy">
                        <strong>
                          {item.label}
                        </strong>

                        <small>
                          {item.description}
                        </small>
                      </span>
                    </a>
                  );
                })
              }
            </nav>

            <div class="admin-layout__divider"></div>

            <div class="admin-layout__system-status">
              <div class="admin-layout__system-status-header">
                <span class="admin-layout__system-status-icon">
                  <Activity
                    size={14}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </span>

                <span>Status platform</span>
              </div>

              <div class="admin-layout__status-row">
                <span class="admin-layout__status-dot"></span>

                <span>Operasional</span>
              </div>

              <p>
                Status yang ditampilkan di sini bersifat
                informatif. Validasi akses tetap dilakukan
                oleh sistem autentikasi dan Firebase Rules.
              </p>
            </div>

            <div class="admin-layout__divider"></div>

            <nav
              class="admin-layout__secondary-nav"
              aria-label="Akses cepat"
            >
              <p class="admin-layout__nav-label">
                Akses cepat
              </p>

              {
                managementLinks.map(
                  (item) => (
                    <a
                      href={item.href}
                      class="admin-layout__secondary-link"
                    >
                      <span>
                        <item.icon
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </span>

                      {item.label}
                    </a>
                  )
                )
              }
            </nav>

            <div class="admin-layout__security-note">
              <span class="admin-layout__security-icon">
                <LockKeyhole
                  size={14}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </span>

              <div>
                <strong>Area terbatas</strong>

                <p>
                  Halaman admin hanya untuk pengguna
                  dengan hak akses yang sesuai.
                </p>
              </div>
            </div>
          </div>
        </aside>

        <div class="admin-layout__content">
          <header class="admin-layout__header">
            <div class="admin-layout__header-container">
              <div class="admin-layout__mobile-topbar">
                <button
                  type="button"
                  class="admin-layout__mobile-toggle"
                  data-admin-sidebar-toggle
                  aria-controls="admin-sidebar"
                  aria-expanded="false"
                  aria-label="Buka navigasi admin"
                >
                  <Menu
                    class="admin-layout__mobile-menu-icon"
                    size={20}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  <X
                    class="admin-layout__mobile-close-icon"
                    size={20}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </button>

                <div class="admin-layout__mobile-context">
                  <span>Admin BINSIGHT</span>

                  <strong>{title}</strong>
                </div>

                <div class="admin-layout__mobile-status">
                  <CircleCheck
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div class="admin-layout__header-bar">
                <nav
                  class="admin-layout__breadcrumbs"
                  aria-label="Breadcrumb admin"
                >
                  <ol class="admin-layout__breadcrumb-list">
                    {
                      breadcrumbs.map(
                        (
                          breadcrumb,
                          index
                        ) => {
                          const isLast =
                            index ===
                            breadcrumbs.length -
                              1;

                          return (
                            <li class="admin-layout__breadcrumb-item">
                              {
                                breadcrumb.href &&
                                !isLast ? (
                                  <a
                                    href={
                                      breadcrumb.href
                                    }
                                    class="admin-layout__breadcrumb-link"
                                  >
                                    {
                                      breadcrumb.label
                                    }
                                  </a>
                                ) : (
                                  <span
                                    class="admin-layout__breadcrumb-current"
                                    aria-current={
                                      isLast
                                        ? "page"
                                        : undefined
                                    }
                                  >
                                    {
                                      breadcrumb.label
                                    }
                                  </span>
                                )
                              }

                              {
                                !isLast && (
                                  <ChevronRight
                                    size={13}
                                    stroke-width={1.8}
                                    aria-hidden="true"
                                  />
                                )
                              }
                            </li>
                          );
                        }
                      )
                    }
                  </ol>
                </nav>

                <div class="admin-layout__header-system">
                  <span class="admin-layout__header-system-dot"></span>

                  <span>
                    System operational
                  </span>

                  <BellRing
                    size={16}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div class="admin-layout__title-row">
                <div class="admin-layout__heading">
                  <p class="admin-layout__eyebrow">
                    BINSIGHT ADMINISTRATION
                  </p>

                  <h1 class="admin-layout__title">
                    {title}
                  </h1>

                  <p class="admin-layout__description">
                    {description}
                  </p>
                </div>

                <div class="admin-layout__actions">
                  <slot name="actions" />
                </div>
              </div>
            </div>
          </header>

          <main
            id="admin-main-content"
            class="admin-layout__main"
            tabindex="-1"
          >
            <div class="admin-layout__main-container">
              <slot />
            </div>
          </main>

          <Footer />
        </div>
      </div>
    </div>

    <div
      class="admin-layout__backdrop"
      data-admin-backdrop
      aria-hidden="true"
    ></div>

    <div
      class="admin-layout__progress"
      data-admin-progress
      aria-hidden="true"
    ></div>

    <script>
      const adminRoot =
        document.querySelector(
          ".admin-layout"
        );

      if (adminRoot) {
        const sidebar =
          adminRoot.querySelector(
            "[data-admin-sidebar]"
          );

        const toggle =
          adminRoot.querySelector(
            "[data-admin-sidebar-toggle]"
          );

        const backdrop =
          adminRoot.querySelector(
            "[data-admin-backdrop]"
          );

        const progress =
          adminRoot.querySelector(
            "[data-admin-progress]"
          );

        const openSidebar = () => {
          if (
            !(sidebar instanceof HTMLElement) ||
            !(toggle instanceof HTMLButtonElement)
          ) {
            return;
          }

          sidebar.classList.add(
            "admin-layout__sidebar--open"
          );

          adminRoot.classList.add(
            "admin-layout--sidebar-open"
          );

          toggle.setAttribute(
            "aria-expanded",
            "true"
          );

          toggle.setAttribute(
            "aria-label",
            "Tutup navigasi admin"
          );

          document.documentElement.classList.add(
            "admin-scroll-locked"
          );

          document.body.classList.add(
            "admin-scroll-locked"
          );
        };

        const closeSidebar = () => {
          if (
            !(sidebar instanceof HTMLElement) ||
            !(toggle instanceof HTMLButtonElement)
          ) {
            return;
          }

          sidebar.classList.remove(
            "admin-layout__sidebar--open"
          );

          adminRoot.classList.remove(
            "admin-layout--sidebar-open"
          );

          toggle.setAttribute(
            "aria-expanded",
            "false"
          );

          toggle.setAttribute(
            "aria-label",
            "Buka navigasi admin"
          );

          document.documentElement.classList.remove(
            "admin-scroll-locked"
          );

          document.body.classList.remove(
            "admin-scroll-locked"
          );
        };

        if (
          toggle instanceof HTMLButtonElement
        ) {
          toggle.addEventListener(
            "click",
            () => {
              const isOpen =
                sidebar instanceof HTMLElement &&
                sidebar.classList.contains(
                  "admin-layout__sidebar--open"
                );

              if (isOpen) {
                closeSidebar();
              } else {
                openSidebar();
              }
            }
          );
        }

        if (
          backdrop instanceof HTMLElement
        ) {
          backdrop.addEventListener(
            "click",
            closeSidebar
          );
        }

        if (
          sidebar instanceof HTMLElement
        ) {
          sidebar
            .querySelectorAll("a")
            .forEach((link) => {
              link.addEventListener(
                "click",
                closeSidebar
              );
            });
        }

        document.addEventListener(
          "keydown",
          (event) => {
            if (event.key === "Escape") {
              closeSidebar();
            }
          }
        );

        window.addEventListener(
          "resize",
          () => {
            if (window.innerWidth > 1000) {
              closeSidebar();
            }
          }
        );

        const updateProgress = () => {
          if (
            !(progress instanceof HTMLElement)
          ) {
            return;
          }

          const height =
            document.documentElement
              .scrollHeight -
            window.innerHeight;

          if (height <= 0) {
            progress.style.transform =
              "scaleX(0)";

            return;
          }

          const ratio =
            Math.min(
              Math.max(
                window.scrollY / height,
                0
              ),
              1
            );

          progress.style.transform =
            `scaleX(${ratio})`;
        };

        updateProgress();

        window.addEventListener(
          "scroll",
          updateProgress,
          {
            passive: true,
          }
        );

        window.addEventListener(
          "resize",
          updateProgress,
          {
            passive: true,
          }
        );
      }
    </script>
  </body>
</html>

<style>
  .admin-layout {
    min-height: 100vh;

    margin: 0;

    color: var(--color-text);
    background: var(--color-background);
  }

  .admin-layout__shell {
    min-height: 100vh;

    display: flex;
    flex-direction: column;
  }

  .admin-layout__workspace {
    min-height: 0;
    flex: 1 1 auto;

    display: flex;
    align-items: stretch;
  }

  /* -----------------------------------------------------------------------
   * SIDEBAR
   * --------------------------------------------------------------------- */

  .admin-layout__sidebar {
    position: sticky;
    top: 76px;

    width: 286px;
    min-width: 286px;

    height: calc(100vh - 76px);

    align-self: flex-start;

    overflow-y: auto;

    border-right: 1px solid var(--color-border);

    background:
      linear-gradient(
        180deg,
        #ffffff 0%,
        #f8fafc 100%
      );
  }

  .admin-layout__sidebar-inner {
    padding: 22px 14px 28px;
  }

  .admin-layout__system-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    padding: 2px 8px 14px;
  }

  .admin-layout__system-title {
    display: flex;
    align-items: center;

    gap: 8px;

    min-width: 0;

    color: var(--color-text);

    font-size: 0.76rem;
    font-weight: 900;
  }

  .admin-layout__system-icon {
    width: 29px;
    height: 29px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 8px;

    color: #ffffff;

    background:
      linear-gradient(
        145deg,
        #1e293b,
        #0f172a
      );
  }

  .admin-layout__system-badge {
    display: inline-flex;
    align-items: center;

    min-height: 21px;

    padding: 0 7px;

    border: 1px solid #cbd5e1;
    border-radius: 999px;

    color: #475569;
    background: #f8fafc;

    font-size: 0.54rem;
    font-weight: 900;
    line-height: 1;

    letter-spacing: 0.08em;
  }

  .admin-layout__admin-card {
    display: flex;
    align-items: center;

    gap: 11px;

    margin: 0 2px 19px;
    padding: 12px;

    border: 1px solid #e2e8f0;
    border-radius: 13px;

    background:
      linear-gradient(
        145deg,
        #f8fafc,
        #ffffff
      );
  }

  .admin-layout__admin-avatar {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 11px;

    color: #ffffff;

    background:
      linear-gradient(
        145deg,
        #334155,
        #0f172a
      );

    font-size: 0.71rem;
    font-weight: 900;

    letter-spacing: 0.04em;
  }

  .admin-layout__admin-copy {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: 5px;
  }

  .admin-layout__admin-copy strong {
    overflow: hidden;

    color: var(--color-text);

    font-size: 0.77rem;
    font-weight: 850;
    line-height: 1.25;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-layout__admin-copy span {
    display: inline-flex;
    align-items: center;

    gap: 4px;

    color: #64748b;

    font-size: 0.61rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .admin-layout__nav {
    display: grid;
    gap: 3px;
  }

  .admin-layout__nav-label {
    margin: 0 9px 7px;

    color: #94a3b8;

    font-size: 0.6rem;
    font-weight: 900;
    line-height: 1;

    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .admin-layout__nav-item {
    position: relative;

    display: flex;
    align-items: center;

    gap: 10px;

    min-height: 53px;

    padding: 7px 9px;

    border: 1px solid transparent;
    border-radius: 11px;

    color: var(--color-secondary);
    background: transparent;

    text-decoration: none;

    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .admin-layout__nav-item:hover {
    color: #1e293b;
    background: #f1f5f9;

    transform: translateX(1px);
  }

  .admin-layout__nav-item--active {
    color: #0f172a;

    border-color: #e2e8f0;

    background:
      linear-gradient(
        100deg,
        #f1f5f9,
        #f8fafc
      );
  }

  .admin-layout__nav-item--active::before {
    content: "";

    position: absolute;

    top: 9px;
    bottom: 9px;
    left: -14px;

    width: 3px;

    border-radius: 0 999px 999px 0;

    background: #0f172a;
  }

  .admin-layout__nav-icon {
    width: 35px;
    height: 35px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 9px;

    color: currentColor;
    background: #f1f5f9;

    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .admin-layout__nav-item--active
    .admin-layout__nav-icon {
    color: #ffffff;
    background: #1e293b;
  }

