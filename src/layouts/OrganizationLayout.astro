---
/**
 * BINSIGHT — ORGANIZATION LAYOUT
 * --------------------------------------------------------------------------
 * Registered / verified organization workspace for BINSIGHT.
 *
 * Architecture:
 * - Global Navbar
 * - Persistent desktop sidebar
 * - Independent desktop sidebar scrolling
 * - Independent main-content scrolling
 * - Mobile sidebar drawer
 * - Page-owned main content
 * - Independent footer
 *
 * IMPORTANT:
 * - Visual / structural baseline intentionally mirrors AdminLayout.
 * - No page-level organization header is rendered by the layout.
 * - Pages own their own visual hierarchy.
 * - Main content has no wrapper/card imposed by this layout.
 * - Footer is structurally separated from workspace.
 * - Layout must never create horizontal page overflow.
 * - Desktop sidebar and main content scroll independently.
 *
 * Security note:
 * - This layout is UI infrastructure only.
 * - It does NOT replace authentication / authorization.
 * - Access control belongs to src/lib/auth/*
 * - Organization data belongs to src/lib/data/organizations.ts
 * - Firebase Security Rules remain authoritative.
 * --------------------------------------------------------------------------
 */

import {
  Activity,
  ArrowLeft,
  Building2,
  CircleCheck,
  ExternalLink,
  FileText,
  LayoutDashboard,
  LockKeyhole,
  Menu,
  PackageCheck,
  Recycle,
  Settings2,
  ShieldCheck,
  Users,
  X,
} from "@lucide/astro";

import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";

type OrganizationSection =
  | "overview"
  | "profile"
  | "waste"
  | "process"
  | "products";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: Breadcrumb[];
  activeSection?: OrganizationSection;
  organizationName?: string;
  organizationInitials?: string;
  organizationStatus?:
    | "verified"
    | "pending"
    | "unverified";
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title = "Organization Dashboard",
  description =
    "Kelola profil, material, proses, dan hasil pengelolaan organisasi di BINSIGHT.",
  breadcrumbs = [
    {
      label: "Organisasi",
      href: "/organization",
    },
    {
      label: "Dashboard",
    },
  ],
  activeSection = "overview",
  organizationName = "Organisasi Anda",
  organizationInitials = "OA",
  organizationStatus = "verified",
  bodyClass = "",
  noindex = true,
} = Astro.props;

const siteUrl =
  import.meta.env.PUBLIC_SITE_URL ||
  Astro.site?.toString() ||
  "https://binsight.id";

const appName =
  import.meta.env.PUBLIC_APP_NAME ||
  "BINSIGHT";

const absoluteUrl = (
  value: string,
): string => {
  if (
    value.startsWith("http://") ||
    value.startsWith("https://")
  ) {
    return value;
  }

  return new URL(
    value.startsWith("/")
      ? value
      : `/${value}`,
    siteUrl,
  ).toString();
};

const canonicalUrl = absoluteUrl(
  Astro.url.pathname,
);

const fullTitle =
  title.startsWith("BINSIGHT")
    ? title
    : `${title} — BINSIGHT`;

const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow";

const organizationStatusLabel =
  organizationStatus === "verified"
    ? "Terverifikasi"
    : organizationStatus === "pending"
      ? "Menunggu verifikasi"
      : "Belum terverifikasi";

const organizationStatusClass =
  organizationStatus === "verified"
    ? "organization-layout__organization-status--verified"
    : organizationStatus === "pending"
      ? "organization-layout__organization-status--pending"
      : "organization-layout__organization-status--unverified";

const navItems: Array<{
  id: OrganizationSection;
  label: string;
  description: string;
  href: string;
  icon: typeof LayoutDashboard;
}> = [
  {
    id: "overview",
    label: "Ringkasan",
    description: "Overview organisasi",
    href: "/organization",
    icon: LayoutDashboard,
  },
  {
    id: "profile",
    label: "Profil",
    description: "Identitas & informasi",
    href: "/organization/profile",
    icon: Building2,
  },
  {
    id: "waste",
    label: "Sampah Dikelola",
    description: "Kategori & material",
    href: "/organization/waste",
    icon: Recycle,
  },
  {
    id: "process",
    label: "Proses",
    description: "Alur & metode",
    href: "/organization/process",
    icon: Settings2,
  },
  {
    id: "products",
    label: "Produk / Hasil",
    description: "Hasil pengelolaan",
    href: "/organization/products",
    icon: PackageCheck,
  },
];

const managementLinks = [
  {
    label: "Halaman Publik",
    href: "/organizations",
    icon: ExternalLink,
  },
  {
    label: "Lihat Peta",
    href: "/map",
    icon: ExternalLink,
  },
];

const isActive = (
  section: OrganizationSection,
): boolean => {
  return activeSection === section;
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#090A08"
    />

    <meta
      name="color-scheme"
      content="light dark"
    />

    <meta
      name="application-name"
      content={appName}
    />

    <meta
      name="robots"
      content={robotsContent}
    />

    <meta
      name="googlebot"
      content={robotsContent}
    />

    <title>{fullTitle}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="BINSIGHT"
    />

    <meta
      property="og:locale"
      content="id_ID"
    />

    <meta
      property="og:title"
      content={fullTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:image:alt"
      content={fullTitle}
    />

    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={fullTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        url: canonicalUrl,
        description,
        inLanguage: "id-ID",
        isPartOf: {
          "@type": "WebSite",
          name: "BINSIGHT",
          url: siteUrl,
        },
      })}
    />

    <slot name="head" />
  </head>

  <body
    class:list={[
      "organization-layout",
      bodyClass,
    ]}
  >
    <a
      class="organization-layout__skip-link"
      href="#organization-main-content"
    >
      Lewati ke konten organisasi
    </a>

    <div class="organization-layout__shell">
      <Navbar />

      <!-- ============================================================
           WORKSPACE
           Sidebar + main content have independent vertical scrolling.
      ============================================================= -->
      <div class="organization-layout__workspace">
        <!-- ==========================================================
             SIDEBAR
        =========================================================== -->
        <aside
          id="organization-sidebar"
          class="organization-layout__sidebar"
          data-organization-sidebar
          aria-label="Navigasi workspace organisasi"
        >
          <div class="organization-layout__sidebar-inner">
            <div class="organization-layout__system-heading">
              <div class="organization-layout__system-title">
                <span class="organization-layout__system-icon">
                  <Building2
                    size={17}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </span>

                <span>
                  Organization BINSIGHT
                </span>
              </div>

              <span class="organization-layout__system-badge">
                WORKSPACE
              </span>
            </div>

            <div class="organization-layout__organization-card">
              <div
                class="organization-layout__organization-avatar"
                aria-hidden="true"
              >
                {organizationInitials}
              </div>

              <div class="organization-layout__organization-copy">
                <strong>
                  {organizationName}
                </strong>

                <span
                  class:list={[
                    "organization-layout__organization-status",
                    organizationStatusClass,
                  ]}
                >
                  <ShieldCheck
                    size={12}
                    stroke-width={2}
                    aria-hidden="true"
                  />

                  {organizationStatusLabel}
                </span>
              </div>
            </div>

            <nav
              class="organization-layout__nav"
              aria-label="Menu organisasi"
            >
              <p class="organization-layout__nav-label">
                Manajemen organisasi
              </p>

              {
                navItems.map((item) => {
                  const active =
                    isActive(item.id);

                  return (
                    <a
                      href={item.href}
                      class:list={[
                        "organization-layout__nav-item",
                        {
                          "organization-layout__nav-item--active":
                            active,
                        },
                      ]}
                      aria-current={
                        active
                          ? "page"
                          : undefined
                      }
                    >
                      <span class="organization-layout__nav-icon">
                        <item.icon
                          size={17}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </span>

                      <span class="organization-layout__nav-copy">
                        <strong>
                          {item.label}
                        </strong>

                        <small>
                          {item.description}
                        </small>
                      </span>
                    </a>
                  );
                })
              }
            </nav>

            <div class="organization-layout__divider"></div>

            <div class="organization-layout__verification">
              <div class="organization-layout__verification-header">
                <span class="organization-layout__verification-icon">
                  <CircleCheck
                    size={14}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                </span>

                <span>
                  Status organisasi
                </span>
              </div>

              <div class="organization-layout__verification-row">
                <span
                  class:list={[
                    "organization-layout__verification-dot",
                    organizationStatusClass,
                  ]}
                ></span>

                <span>
                  {organizationStatusLabel}
                </span>
              </div>

              <p>
                Informasi yang telah diverifikasi dapat
                ditampilkan pada ekosistem publik BINSIGHT.
              </p>
            </div>

            <div class="organization-layout__divider"></div>

            <nav
              class="organization-layout__secondary-nav"
              aria-label="Akses cepat organisasi"
            >
              <p class="organization-layout__nav-label">
                Akses cepat
              </p>

              {
                managementLinks.map(
                  (item) => (
                    <a
                      href={item.href}
                      class="organization-layout__secondary-link"
                    >
                      <span>
                        <item.icon
                          size={15}
                          stroke-width={1.9}
                          aria-hidden="true"
                        />
                      </span>

                      {item.label}
                    </a>
                  ),
                )
              }

              <a
                href="/organizations"
                class="organization-layout__secondary-link"
              >
                <span>
                  <ArrowLeft
                    size={15}
                    stroke-width={1.9}
                    aria-hidden="true"
                  />
                </span>

                Organisasi publik
              </a>
            </nav>

            <div class="organization-layout__security-note">
              <span class="organization-layout__security-icon">
                <LockKeyhole
                  size={14}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </span>

              <div>
                <strong>
                  Area organisasi
                </strong>

                <p>
                  Data workspace hanya dapat dikelola
                  oleh akun organisasi dengan hak akses
                  yang sesuai.
                </p>
              </div>
            </div>
          </div>
        </aside>

        <!-- ==========================================================
             CONTENT WORKSPACE
        =========================================================== -->
        <div class="organization-layout__content">
          <!--
            IMPORTANT:
            Tidak menggunakan page header.
            Ini hanya mobile navigation utility.
          -->
          <div class="organization-layout__mobile-bar">
            <button
              type="button"
              class="organization-layout__mobile-toggle"
              data-organization-sidebar-toggle
              aria-controls="organization-sidebar"
              aria-expanded="false"
              aria-label="Buka navigasi organisasi"
            >
              <Menu
                class="organization-layout__mobile-menu-icon"
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />

              <X
                class="organization-layout__mobile-close-icon"
                size={20}
                stroke-width={2}
                aria-hidden="true"
              />
            </button>

            <div class="organization-layout__mobile-context">
              <span>
                Organization BINSIGHT
              </span>

              <strong>
                {title}
              </strong>
            </div>

            <div
              class="organization-layout__mobile-status"
              aria-hidden="true"
            >
              <CircleCheck
                size={17}
                stroke-width={2}
              />
            </div>
          </div>

          <!-- ========================================================
               PAGE-OWNED CONTENT
          ========================================================= -->
          <main
            id="organization-main-content"
            class="organization-layout__main"
            tabindex="-1"
          >
            <div class="organization-layout__main-container">
              <slot />
            </div>
          </main>
        </div>
      </div>

      <!-- ============================================================
           INDEPENDENT FOOTER
      ============================================================= -->
      <div class="organization-layout__footer">
        <Footer />
      </div>
    </div>

    <div
      class="organization-layout__backdrop"
      data-organization-backdrop
      aria-hidden="true"
    ></div>

    <script>
      const organizationRoot =
        document.querySelector(
          ".organization-layout",
        );

      if (organizationRoot) {
        const sidebar =
          organizationRoot.querySelector(
            "[data-organization-sidebar]",
          );

        const toggle =
          organizationRoot.querySelector(
            "[data-organization-sidebar-toggle]",
          );

        const backdrop =
          organizationRoot.querySelector(
            "[data-organization-backdrop]",
          );

        const openSidebar = () => {
          if (
            !(sidebar instanceof HTMLElement) ||
            !(toggle instanceof HTMLButtonElement)
          ) {
            return;
          }

          sidebar.classList.add(
            "organization-layout__sidebar--open",
          );

          organizationRoot.classList.add(
            "organization-layout--sidebar-open",
          );

          toggle.setAttribute(
            "aria-expanded",
            "true",
          );

          toggle.setAttribute(
            "aria-label",
            "Tutup navigasi organisasi",
          );

          document.documentElement.classList.add(
            "organization-scroll-locked",
          );

          document.body.classList.add(
            "organization-scroll-locked",
          );
        };

        const closeSidebar = () => {
          if (
            !(sidebar instanceof HTMLElement) ||
            !(toggle instanceof HTMLButtonElement)
          ) {
            return;
          }

          sidebar.classList.remove(
            "organization-layout__sidebar--open",
          );

          organizationRoot.classList.remove(
            "organization-layout--sidebar-open",
          );

          toggle.setAttribute(
            "aria-expanded",
            "false",
          );

          toggle.setAttribute(
            "aria-label",
            "Buka navigasi organisasi",
          );

          document.documentElement.classList.remove(
            "organization-scroll-locked",
          );

          document.body.classList.remove(
            "organization-scroll-locked",
          );
        };

        if (
          toggle instanceof HTMLButtonElement
        ) {
          toggle.addEventListener(
            "click",
            () => {
              const isOpen =
                sidebar instanceof HTMLElement &&
                sidebar.classList.contains(
                  "organization-layout__sidebar--open",
                );

              if (isOpen) {
                closeSidebar();
              } else {
                openSidebar();
              }
            },
          );
        }

        if (
          backdrop instanceof HTMLElement
        ) {
          backdrop.addEventListener(
            "click",
            closeSidebar,
          );
        }

        if (
          sidebar instanceof HTMLElement
        ) {
          sidebar
            .querySelectorAll("a")
            .forEach((link) => {
              link.addEventListener(
                "click",
                closeSidebar,
              );
            });
        }

        document.addEventListener(
          "keydown",
          (event) => {
            if (event.key === "Escape") {
              closeSidebar();
            }
          },
        );

        window.addEventListener(
          "resize",
          () => {
            if (window.innerWidth > 1000) {
              closeSidebar();
            }
          },
        );
      }
    </script>
  </body>
</html>

<style>
  /* ================================================================
     GLOBAL BOX MODEL / OVERFLOW SAFETY
  ================================================================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    width: 100%;
    max-width: 100%;

    margin: 0;
    padding: 0;

    overflow-x: hidden;
  }

  :global(body) {
    width: 100%;
    max-width: 100%;

    margin: 0;
    padding: 0;

    overflow-x: hidden;
  }

  /* ================================================================
     ROOT
  ================================================================= */

  .organization-layout {
    --acid: #dfff00;
    --acid-soft: #efff70;
    --ink: #090a08;
    --ink-2: #11130f;
    --ink-3: #1b1f18;
    --paper: #f2f0e6;
    --paper-2: #e4e1d4;
    --paper-3: #cfcabd;
    --white: #fffef8;
    --muted: #6c7068;
    --orange: #ff6a00;
    --green: #87b800;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    min-height: 100vh;

    margin: 0;

    overflow-x: hidden;

    color: var(--ink);
    background: var(--paper);
  }

  .organization-layout__shell {
    width: 100%;
    max-width: 100%;
    min-width: 0;

    min-height: 100vh;

    display: flex;
    flex-direction: column;

    overflow-x: hidden;

    background: var(--paper);
  }

  /* ================================================================
     WORKSPACE
  ================================================================= */

  .organization-layout__workspace {
    width: 100%;
    max-width: 100%;
    min-width: 0;

    height: calc(100vh - 76px);
    min-height: 0;

    display: flex;
    align-items: stretch;

    overflow: hidden;

    background: var(--paper);
  }

  /* ================================================================
     SIDEBAR — DESKTOP INDEPENDENT SCROLL
  ================================================================= */

  .organization-layout__sidebar {
    position: relative;

    flex:
      0 0
      292px;

    width: 292px;
    max-width: 292px;
    min-width: 292px;

    height: 100%;
    min-height: 0;

    overflow-x: hidden;
    overflow-y: auto;

    overscroll-behavior: contain;

    border-right: 2px solid var(--ink);

    background:
      linear-gradient(
        180deg,
        var(--paper) 0%,
        var(--paper-2) 100%
      );

    color: var(--ink);

    scrollbar-width: thin;
    scrollbar-color:
      #aaaD9f
      transparent;
  }

  .organization-layout__sidebar::-webkit-scrollbar {
    width: 7px;
  }

  .organization-layout__sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .organization-layout__sidebar::-webkit-scrollbar-thumb {
    background: #aaaD9f;
  }

  .organization-layout__sidebar-inner {
    width: 100%;
    max-width: 100%;
    min-width: 0;

    min-height: 100%;

    display: flex;
    flex-direction: column;

    padding: 20px 14px 22px;

    overflow-x: hidden;
  }

  /* ================================================================
     SYSTEM HEADING
  ================================================================= */

  .organization-layout__system-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    min-width: 0;

    padding: 3px 8px 15px;

    border-bottom: 2px solid var(--ink);
  }

  .organization-layout__system-title {
    min-width: 0;

    display: flex;
    align-items: center;

    gap: 9px;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: 0.7rem;
    font-weight: 800;

    letter-spacing: -0.015em;

    text-transform: uppercase;
  }

  .organization-layout__system-title
    > span:last-child {
    min-width: 0;

    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .organization-layout__system-icon {
    width: 30px;
    height: 30px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border: 2px solid var(--ink);

    border-radius: 0;

    color: var(--acid);
    background: var(--ink);

    box-shadow:
      3px 3px 0 var(--orange);
  }

  .organization-layout__system-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    min-height: 22px;

    padding: 0 8px;

    border: 1px solid var(--ink);
    border-radius: 0;

    color: var(--ink);
    background: var(--acid);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.48rem;
    font-weight: 700;

    line-height: 1;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  /* ================================================================
     ORGANIZATION IDENTITY
  ================================================================= */

  .organization-layout__organization-card {
    min-width: 0;
    max-width: 100%;

    display: flex;
    align-items: center;

    gap: 11px;

    margin: 16px 2px 21px;

    padding: 12px;

    border: 2px solid var(--ink);

    border-radius: 0;

    background: var(--white);

    box-shadow:
      4px 4px 0 var(--acid);
  }

  .organization-layout__organization-avatar {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border: 2px solid var(--ink);

    border-radius: 0;

    color: var(--acid);
    background: var(--ink);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: 0.68rem;
    font-weight: 800;

    letter-spacing: 0.04em;
  }

  .organization-layout__organization-copy {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: 4px;
  }

  .organization-layout__organization-copy strong {
    min-width: 0;

    overflow: hidden;

    color: var(--ink);

    font-family:
      Sora,
      Inter,
      system-ui,
      sans-serif;

    font-size: 0.7rem;
    font-weight: 800;

    line-height: 1.25;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .organization-layout__organization-status {
    min-width: 0;

    display: inline-flex;
    align-items: center;

    gap: 5px;

    color: var(--muted);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.49rem;
    font-weight: 700;

    line-height: 1.2;

    letter-spacing: 0.04em;

    text-transform: uppercase;
  }

  .organization-layout__organization-status--verified {
    color: var(--green);
  }

  .organization-layout__organization-status--pending {
    color: var(--orange);
  }

  .organization-layout__organization-status--unverified {
    color: #b42525;
  }

  /* ================================================================
     NAVIGATION
  ================================================================= */

  .organization-layout__nav {
    min-width: 0;

    display: grid;
    gap: 5px;
  }

  .organization-layout__nav-label {
    min-width: 0;

    margin: 0 9px 8px;

    color: var(--orange);

    font-family:
      "DM Mono",
      "SFMono-Regular",
      Consolas,
      monospace;

    font-size: 0.51rem;
    font-weight: 700;

    line-height: 1;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  .organization-layout__nav-item {
    position: relative;

    min-width: 0;
    max-width: 100%;

