---
/**
 * BINSIGHT — PUBLIC LAYOUT
 * --------------------------------------------------------------------------
 * Global layout for all public-facing BINSIGHT pages.
 *
 * Responsibilities:
 * - SEO metadata
 * - Open Graph / social metadata
 * - Favicon
 * - Skip-to-content accessibility
 * - Global Navbar
 * - Main page content
 * - Global Footer
 * - Page-level body classes
 *
 * Intended pages:
 * - Home
 * - Dashboard
 * - Map
 * - Organizations
 * - Waste
 * - Reports
 * - Company
 *
 * Architecture:
 * - Pure Astro layout
 * - No framework dependency
 * - Uses global BINSIGHT styles
 * - Keeps page-specific content inside <slot />
 * --------------------------------------------------------------------------
 */

import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  bodyClass?: string;
  themeColor?: string;
}

const {
  title = "BINSIGHT — Badung Waste Intelligence",
  description = "Platform informasi, data, pemetaan, edukasi, dan pelaporan persampahan untuk Kabupaten Badung.",
  image = "/images/logo.svg",
  canonical,
  noindex = false,
  bodyClass = "",
  themeColor = "#166534",
} = Astro.props;

const siteUrl =
  import.meta.env.PUBLIC_SITE_URL ||
  Astro.site?.toString() ||
  "https://binsight.id";

const appName =
  import.meta.env.PUBLIC_APP_NAME ||
  "BINSIGHT";

const absoluteUrl = (
  value: string
): string => {
  if (
    value.startsWith("http://") ||
    value.startsWith("https://")
  ) {
    return value;
  }

  return new URL(
    value.startsWith("/") ? value : `/${value}`,
    siteUrl
  ).toString();
};

const canonicalUrl = absoluteUrl(
  canonical || Astro.url.pathname
);

const imageUrl = absoluteUrl(image);

const fullTitle =
  title === appName ||
  title.startsWith("BINSIGHT")
    ? title
    : `${title} — BINSIGHT`;

const pageDescription =
  description ||
  import.meta.env.PUBLIC_APP_DESCRIPTION ||
  "Platform Badung Waste Intelligence.";

const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow";

const currentPath = Astro.url.pathname;

const isMapPage =
  currentPath === "/map" ||
  currentPath.startsWith("/map/");

const isDashboardPage =
  currentPath === "/dashboard";

const isOrganizationPage =
  currentPath === "/organizations" ||
  currentPath.startsWith("/organizations/");

const isWastePage =
  currentPath === "/waste" ||
  currentPath.startsWith("/waste/");

const isReportsPage =
  currentPath === "/reports" ||
  currentPath.startsWith("/reports/");

const isCompanyPage =
  currentPath === "/company" ||
  currentPath.startsWith("/company/");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content={themeColor}
    />

    <meta
      name="color-scheme"
      content="light dark"
    />

    <meta
      name="format-detection"
      content="telephone=no"
    />

    <meta
      name="mobile-web-app-capable"
      content="yes"
    />

    <meta
      name="application-name"
      content={appName}
    />

    <meta
      name="robots"
      content={robotsContent}
    />

    <meta
      name="googlebot"
      content={robotsContent}
    />

    <title>{fullTitle}</title>

    <meta
      name="description"
      content={pageDescription}
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />

    <link
      rel="apple-touch-icon"
      href="/images/logo.svg"
    />

    <!-- Open Graph -->
    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="BINSIGHT"
    />

    <meta
      property="og:locale"
      content="id_ID"
    />

    <meta
      property="og:title"
      content={fullTitle}
    />

    <meta
      property="og:description"
      content={pageDescription}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:image"
      content={imageUrl}
    />

    <meta
      property="og:image:alt"
      content={fullTitle}
    />

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={fullTitle}
    />

    <meta
      name="twitter:description"
      content={pageDescription}
    />

    <meta
      name="twitter:image"
      content={imageUrl}
    />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "BINSIGHT",
        alternateName: "Badung Waste Intelligence",
        url: siteUrl,
        description: pageDescription,
        inLanguage: "id-ID",
      })}
    />

    <slot name="head" />
  </head>

  <body
    class:list={[
      "public-layout",
      bodyClass,
      {
        "public-layout--map": isMapPage,
        "public-layout--dashboard": isDashboardPage,
        "public-layout--organization": isOrganizationPage,
        "public-layout--waste": isWastePage,
        "public-layout--reports": isReportsPage,
        "public-layout--company": isCompanyPage,
      },
    ]}
  >
    <a
      class="public-layout__skip-link"
      href="#main-content"
    >
      Lewati ke konten utama
    </a>

    <div class="public-layout__shell">
      <Navbar />

      <main
        id="main-content"
        class="public-layout__main"
        tabindex="-1"
      >
        <slot />
      </main>

      <Footer />
    </div>

    <div
      class="public-layout__scroll-progress"
      data-scroll-progress
      aria-hidden="true"
    ></div>

    <script>
      /**
       * BINSIGHT Public Layout Controller
       *
       * Lightweight global behaviors only.
       * Page-specific JavaScript belongs to its respective component/page.
       */

      const scrollProgress =
        document.querySelector<HTMLElement>(
          "[data-scroll-progress]"
        );

      if (scrollProgress) {
        const updateProgress = () => {
          const documentHeight =
            document.documentElement.scrollHeight -
            window.innerHeight;

          if (documentHeight <= 0) {
            scrollProgress.style.transform =
              "scaleX(0)";
            return;
          }

          const progress =
            Math.min(
              Math.max(
                window.scrollY / documentHeight,
                0
              ),
              1
            );

          scrollProgress.style.transform =
            `scaleX(${progress})`;
        };

        updateProgress();

        window.addEventListener(
          "scroll",
          updateProgress,
          { passive: true }
        );

        window.addEventListener(
          "resize",
          updateProgress,
          { passive: true }
        );
      }

      /**
       * Prevent accidental focus rings from appearing
       * after mouse / pointer interaction while preserving
       * keyboard accessibility.
       */
      let usingKeyboard = false;

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            event.key === "Tab" ||
            event.key.startsWith("Arrow") ||
            event.key === "Enter" ||
            event.key === " "
          ) {
            usingKeyboard = true;
            document.documentElement.classList.add(
              "using-keyboard"
            );
          }
        },
        { passive: true }
      );

      document.addEventListener(
        "pointerdown",
        () => {
          usingKeyboard = false;
          document.documentElement.classList.remove(
            "using-keyboard"
          );
        },
        { passive: true }
      );
    </script>
  </body>
</html>

<style>
  .public-layout {
    min-height: 100vh;
    margin: 0;

    background: var(--color-background);
    color: var(--color-text);
  }

  .public-layout__shell {
    min-height: 100vh;

    display: flex;
    flex-direction: column;
  }

  .public-layout__main {
    flex: 1 0 auto;
    min-width: 0;

    outline: none;
  }

  .public-layout__main:focus {
    outline: none;
  }

  .public-layout__skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 2000;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;
    padding: 0 15px;

    border: 1px solid var(--color-primary);
    border-radius: 9px;

    color: #ffffff;
    background: var(--color-primary);

    box-shadow: var(--shadow-lg);

    font-size: 0.8rem;
    font-weight: 800;

    text-decoration: none;

    opacity: 0;
    pointer-events: none;
    transform: translateY(-12px);

    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .public-layout__skip-link:focus {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .public-layout__scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2100;

    width: 100%;
    height: 2px;

    transform: scaleX(0);
    transform-origin: left center;

    background: var(--color-accent);

    pointer-events: none;
  }

  .public-layout--map
    .public-layout__scroll-progress {
    background: var(--color-info);
  }

  .public-layout--reports
    .public-layout__scroll-progress {
    background: var(--color-warning);
  }

  @media (max-width: 900px) {
    .public-layout__scroll-progress {
      height: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .public-layout__skip-link,
    .public-layout__scroll-progress {
      transition: none !important;
    }
  }
</style>