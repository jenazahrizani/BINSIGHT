---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heading?: string;
  showBackLink?: boolean;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description = "BINSIGHT — Badung Waste Intelligence",
  eyebrow = "BADUNG WASTE INTELLIGENCE",
  heading = "PUBLIC DATA PLATFORM",
  showBackLink = true,
  backHref = "/",
  backLabel = "Kembali ke BINSIGHT",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#090a08"
    />

    <link
      rel="icon"
      href="/favicon.svg"
    />

    <title>
      {title} — BINSIGHT
    </title>

    <slot name="head" />
  </head>

  <body>
    <div class="auth-layout">
      <div class="auth-layout__noise" aria-hidden="true"></div>

      <header class="auth-layout__header">
        <div class="auth-layout__header-inner">
          <a
            class="auth-brand"
            href="/"
            aria-label="BINSIGHT — kembali ke beranda"
          >
            <span class="auth-brand__mark" aria-hidden="true">
              B
            </span>

            <span class="auth-brand__text">
              <strong>BINSIGHT</strong>
              <span>BADUNG WASTE INTELLIGENCE</span>
            </span>
          </a>

          {
            showBackLink ? (
              <a
                class="auth-back"
                href={backHref}
              >
                <span class="auth-back__arrow" aria-hidden="true">
                  ←
                </span>

                <span>
                  {backLabel}
                </span>
              </a>
            ) : null
          }
        </div>
      </header>

      <main class="auth-layout__main">
        <div class="auth-layout__grid">

          <section class="auth-layout__statement" aria-label="BINSIGHT">
            <div class="auth-layout__eyebrow">
              <span class="auth-layout__eyebrow-dot"></span>
              <span>{eyebrow}</span>
            </div>

            <div class="auth-layout__statement-content">
              <p class="auth-layout__kicker">
                {heading}
              </p>

              <h1>
                Kenali.
                <br />
                Pahami.
                <br />
                <span>Jaga Badung.</span>
              </h1>

              <p class="auth-layout__description">
                BINSIGHT menghubungkan peta, data, organisasi,
                edukasi, dan laporan masyarakat dalam satu
                ekosistem informasi persampahan Kabupaten Badung.
              </p>
            </div>

            <div class="auth-layout__system">
              <div class="auth-layout__system-line"></div>

              <div class="auth-layout__system-copy">
                <span>DISCOVER</span>
                <span>→</span>
                <span>UNDERSTAND</span>
                <span>→</span>
                <span>REPORT</span>
              </div>
            </div>

            <div class="auth-layout__coordinates" aria-hidden="true">
              <span>BADUNG / BALI</span>
              <span>PUBLIC ACCESS</span>
            </div>
          </section>

          <section class="auth-layout__panel">
            <div class="auth-layout__panel-top">
              <span>AUTH / ACCESS</span>
              <span class="auth-layout__panel-index">01</span>
            </div>

            <div class="auth-layout__card">
              <div class="auth-layout__card-header">
                <div class="auth-layout__card-label">
                  <span class="auth-layout__card-dot"></span>
                  <span>ACCOUNT ACCESS</span>
                </div>

                <h2>
                  {title}
                </h2>
              </div>

              <div class="auth-layout__card-content">
                <slot />
              </div>

              <div class="auth-layout__card-footer">
                <span>BINSIGHT / AUTH</span>

                <span>
                  {new Date().getFullYear()}
                </span>
              </div>
            </div>

            <div class="auth-layout__privacy">
              <span
                class="auth-layout__privacy-icon"
                aria-hidden="true"
              >
                ✓
              </span>

              <p>
                Akses akun digunakan untuk mengelola aktivitas
                yang relevan dengan ekosistem informasi BINSIGHT.
              </p>
            </div>
          </section>

        </div>
      </main>

      <footer class="auth-layout__footer">
        <div class="auth-layout__footer-inner">
          <span>
            BINSIGHT
          </span>

          <span>
            BADUNG WASTE INTELLIGENCE
          </span>

          <span>
            PLATFORM INFORMASI PERSAMPAHAN
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    min-height: 100%;
    background: #090a08;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100%;
    margin: 0;
    overflow-x: hidden;
    background: #090a08;
    color: #090a08;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(button),
  :global(input),
  :global(textarea),
  :global(select) {
    font: inherit;
  }

  :global(a) {
    color: inherit;
  }

  .auth-layout {
    --auth-ink: #090a08;
    --auth-ink-2: #11130f;
    --auth-ink-3: #1b1f18;

    --auth-acid: #dfff00;
    --auth-acid-soft: #efff70;

    --auth-paper: #f2f0e6;
    --auth-paper-2: #e4e1d4;
    --auth-paper-3: #cfcabd;

    --auth-white: #fffef8;
    --auth-muted: #6c7068;

    --auth-orange: #ff6a00;

    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: hidden;
    background: var(--auth-paper);
  }

  /* =========================================================
     SUBTLE BACKGROUND TEXTURE
     ========================================================= */

  .auth-layout__noise {
    position: fixed;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    opacity: 0.045;
    background-image:
      linear-gradient(
        90deg,
        rgba(9, 10, 8, 0.7) 1px,
        transparent 1px
      ),
      linear-gradient(
        rgba(9, 10, 8, 0.7) 1px,
        transparent 1px
      );
    background-size: 32px 32px;
  }

  /* =========================================================
     HEADER
     ========================================================= */

  .auth-layout__header {
    position: relative;
    z-index: 5;
    flex: 0 0 auto;
    background: var(--auth-ink);
    border-bottom: 2px solid var(--auth-ink);
  }

  .auth-layout__header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(
      1440px,
      calc(100% - 48px)
    );
    min-height: 76px;
    margin-inline: auto;
  }

  .auth-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--auth-white);
    text-decoration: none;
  }

  .auth-brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border: 2px solid var(--auth-acid);
    background: var(--auth-acid);
    color: var(--auth-ink);
    font-family:
      "Sora",
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1;
  }

  .auth-brand__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .auth-brand__text strong {
    color: var(--auth-white);
    font-family:
      "Sora",
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .auth-brand__text span {
    overflow: hidden;
    color: #8f958b;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.065em;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .auth-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 11px;
    border: 1px solid #34382f;
    color: #b7bcb1;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 140ms ease,
      background 140ms ease,
      border-color 140ms ease;
  }

  .auth-back:hover {
    border-color: var(--auth-acid);
    background: var(--auth-acid);
    color: var(--auth-ink);
  }

  .auth-back__arrow {
    font-size: 0.95rem;
    line-height: 1;
  }

  /* =========================================================
     MAIN
     ========================================================= */

  .auth-layout__main {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    width: 100%;
    padding: 54px 0 64px;
  }

  .auth-layout__grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.04fr)
      minmax(390px, 0.96fr);
    gap: clamp(54px, 8vw, 120px);
    align-items: center;
    width: min(
      1240px,
      calc(100% - 48px)
    );
    margin-inline: auto;
  }

  /* =========================================================
     STATEMENT
     ========================================================= */

  .auth-layout__statement {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 580px;
    padding: 10px 0;
  }

  .auth-layout__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    align-self: flex-start;
    color: var(--auth-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .auth-layout__eyebrow-dot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    background: var(--auth-acid);
    border: 1px solid var(--auth-ink);
  }

  .auth-layout__statement-content {
    margin-top: auto;
    margin-bottom: auto;
    padding-block: 48px;
  }

  .auth-layout__kicker {
    margin: 0 0 18px;
    color: var(--auth-orange);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .auth-layout__statement h1 {
    max-width: 700px;
    margin: 0;
    color: var(--auth-ink);
    font-family:
      "Sora",
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(
      3.2rem,
      6.4vw,
      6.65rem
    );
    font-weight: 900;
    line-height: 0.91;
    letter-spacing: -0.075em;
  }

  .auth-layout__statement h1 span {
    color: var(--auth-green, #87b800);
  }

  .auth-layout__description {
    max-width: 570px;
    margin: 30px 0 0;
    color: #575c54;
    font-size: clamp(
      0.85rem,
      1.2vw,
      0.98rem
    );
    line-height: 1.8;
  }

  .auth-layout__system {
    display: grid;
    gap: 10px;
    margin-top: auto;
  }

  .auth-layout__system-line {
    width: 100%;
    height: 2px;
    background: var(--auth-ink);
  }

  .auth-layout__system-copy {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--auth-ink);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.055em;
  }

  .auth-layout__system-copy span:nth-child(2),
  .auth-layout__system-copy span:nth-child(4) {
    color: var(--auth-muted);
  }

  .auth-layout__coordinates {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 38px;
    color: #898e84;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.07em;
  }

  /* =========================================================
     AUTH PANEL
     ========================================================= */

  .auth-layout__panel {
    min-width: 0;
    width: min(
      100%,
      520px
    );
    justify-self: end;
  }

  .auth-layout__panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 34px;
    padding: 0 3px 10px;
    color: var(--auth-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.075em;
  }

  .auth-layout__panel-index {
    color: var(--auth-ink);
  }

  .auth-layout__card {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--auth-ink);
    background: var(--auth-white);
    box-shadow: 9px 9px 0 var(--auth-ink);
  }

  .auth-layout__card::after {
    position: absolute;
    right: -30px;
    bottom: -30px;
    width: 100px;
    height: 100px;
    border: 2px solid rgba(9, 10, 8, 0.08);
    content: "";
    transform: rotate(45deg);
    pointer-events: none;
  }

  .auth-layout__card-header {
    padding: 27px 28px 24px;
    border-bottom: 2px solid var(--auth-ink);
    background:
      linear-gradient(
        135deg,
        var(--auth-white) 0%,
        var(--auth-paper) 100%
      );
  }

  .auth-layout__card-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--auth-muted);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.075em;
  }

  .auth-layout__card-dot {
    width: 7px;
    height: 7px;
    background: var(--auth-acid);
    border: 1px solid var(--auth-ink);
  }

  .auth-layout__card-header h2 {
    margin: 13px 0 0;
    color: var(--auth-ink);
    font-family:
      "Sora",
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(
      1.5rem,
      3vw,
      2rem
    );
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .auth-layout__card-content {
    position: relative;
    z-index: 1;
    padding: 27px 28px 30px;
  }

  .auth-layout__card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 42px;
    padding: 0 28px;
    border-top: 1px solid var(--auth-paper-3);
    color: #858a81;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.065em;
  }

  /* =========================================================
     PRIVACY
     ========================================================= */

  .auth-layout__privacy {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 18px;
    padding: 12px 13px;
    border-left: 3px solid var(--auth-acid);
    background: rgba(223, 255, 0, 0.18);
  }

  .auth-layout__privacy-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
    border: 1px solid var(--auth-ink);
    background: var(--auth-acid);
    color: var(--auth-ink);
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.58rem;
    font-weight: 900;
    line-height: 1;
  }

  .auth-layout__privacy p {
    margin: 0;
    color: #585d55;
    font-size: 0.65rem;
    line-height: 1.6;
  }

  /* =========================================================
     FOOTER
     ========================================================= */

  .auth-layout__footer {
    position: relative;
    z-index: 4;
    flex: 0 0 auto;
    background: var(--auth-ink);
    border-top: 2px solid var(--auth-ink);
  }

  .auth-layout__footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(
      1240px,
      calc(100% - 48px)
    );
    min-height: 42px;
    margin-inline: auto;
    color: #7e8479;
    font-family:
      "DM Mono",
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 0.53rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .auth-layout__footer-inner span:first-child {
    color: var(--auth-acid);
  }

  /* =========================================================
     FOCUS
     ========================================================= */

  .auth-brand:focus-visible,
  .auth-back:focus-visible {
    outline: 3px solid var(--auth-acid);
    outline-offset: 4px;
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (max-width: 1100px) {
    .auth-layout__grid {
      grid-template-columns:
        minmax(0, 0.94fr)
        minmax(370px, 1.06fr);
      gap: 48px;
    }

    .auth-layout__statement h1 {
      font-size: clamp(
        3rem,
        6.3vw,
        5rem
      );
    }

    .auth-layout__statement {
      min-height: 550px;
    }
  }

  @media (max-width: 900px) {
    .auth-layout__header-inner,
    .auth-layout__grid,
    .auth-layout__footer-inner {
      width: min(
        100%,
        calc(100% - 36px)
      );
    }

    .auth-layout__main {
      padding: 42px 0 55px;
    }

    .auth-layout__grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .auth-layout__statement {
      min-height: auto;
      padding: 0;
    }

    .auth-layout__statement-content {
      padding-block: 34px 30px;
    }

    .auth-layout__statement h1 {
      max-width: 700px;
      font-size: clamp(
        3.2rem,
        10vw,
        5.8rem
      );
    }

    .auth-layout__description {
      max-width: 680px;
    }

    .auth-layout__panel {
      width: min(
        100%,
        560px
      );
      justify-self: center;
    }
  }

  @media (max-width: 600px) {
    .auth-layout__header-inner,
    .auth-layout__grid,
    .auth-layout__footer-inner {
      width: min(
        100%,
        calc(100% - 28px)
      );
    }

    .auth-layout__header-inner {
      min-height: 68px;
      gap: 12px;
    }

    .auth-brand__mark {
      width: 38px;
      height: 38px;
    }

    .auth-brand__text strong {
      font-size: 0.85rem;
    }

    .auth-brand__text span {
      font-size: 0.5rem;
    }

    .auth-back {
      padding: 8px 9px;
      font-size: 0.56rem;
    }

    .auth-back__arrow {
      font-size: 0.86rem;
    }

    .auth-layout__main {
      padding: 30px 0 46px;
    }

    .auth-layout__grid {
      gap: 31px;
    }

    .auth-layout__statement-content {
      padding-block: 28px 25px;
    }

    .auth-layout__kicker {
      margin-bottom: 14px;
      font-size: 0.6rem;
    }

    .auth-layout__statement h1 {
      font-size: clamp(
        2.7rem,
        15vw,
        4.35rem
      );
      line-height: 0.92;
    }

    .auth-layout__description {
      margin-top: 23px;
      font-size: 0.78rem;
      line-height: 1.75;
    }

    .auth-layout__system {
      margin-top: 0;
    }

    .auth-layout__coordinates {
      margin-top: 24px;
      font-size: 0.5rem;
    }

    .auth-layout__panel {
      width: 100%;
    }

    .auth-layout__panel-top {
      padding-bottom: 8px;
      font-size: 0.55rem;
    }

    .auth-layout__card {
      box-shadow: 6px 6px 0 var(--auth-ink);
    }

    .auth-layout__card-header {
      padding: 22px 19px 20px;
    }

    .auth-layout__card-content {
      padding: 22px 19px 24px;
    }

    .auth-layout__card-footer {
      min-height: 39px;
      padding: 0 19px;
      font-size: 0.5rem;
    }

    .auth-layout__privacy {
      margin-top: 14px;
    }

    .auth-layout__footer-inner {
      justify-content: center;
      min-height: 40px;
    }

    .auth-layout__footer-inner span:nth-child(2),
    .auth-layout__footer-inner span:nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .auth-layout__header-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 10px;
    }

    .auth-back {
      align-self: stretch;
      justify-content: center;
    }

    .auth-layout__statement h1 {
      font-size: clamp(
        2.5rem,
        16vw,
        3.6rem
      );
    }

    .auth-layout__system-copy {
